    <!-- https://signals.zndx.org/sdg#AbuseIndicator -->

    <owl:Class rdf:about="https://signals.zndx.org/sdg#AbuseIndicator">
        <owl:equivalentClass>
            <owl:Class>
                <owl:intersectionOf rdf:parseType="Collection">
                    <rdf:Description rdf:about="https://www.commoncoreontologies.org/ont00000853"/>
                    <owl:Restriction>
                        <owl:onProperty rdf:resource="https://signals.zndx.org/sdg#manifestsAs"/>
                        <owl:someValuesFrom rdf:resource="https://signals.zndx.org/sdg#PhysicalManifestation"/>
                    </owl:Restriction>
                </owl:intersectionOf>
            </owl:Class>
        </owl:equivalentClass>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://signals.zndx.org/sdg#hasConfidence"/>
                <owl:someValuesFrom rdf:resource="http://www.w3.org/2001/XMLSchema#decimal"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://signals.zndx.org/sdg#hasDimensionKind"/>
                <owl:someValuesFrom rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <obo:IAO_0000115>AbuseIndicator is a DescriptiveICE that manifestsAs a PhysicalManifestation.</obo:IAO_0000115>
