    <!-- https://signals.zndx.org/sdg#YouthHealthCareSummary -->

    <owl:Class rdf:about="https://signals.zndx.org/sdg#YouthHealthCareSummary">
        <owl:equivalentClass>
            <owl:Class>
                <owl:intersectionOf rdf:parseType="Collection">
                    <rdf:Description rdf:about="https://www.commoncoreontologies.org/InformationContentEntity"/>
                    <owl:Restriction>
                        <owl:onProperty rdf:resource="https://signals.zndx.org/sdg#describesSituation"/>
                        <owl:someValuesFrom rdf:resource="https://signals.zndx.org/sdg#YouthHealthStatus"/>
                    </owl:Restriction>
                    <owl:Restriction>
                        <owl:onProperty rdf:resource="https://signals.zndx.org/sdg#formattedAs"/>
                        <owl:someValuesFrom rdf:resource="https://signals.zndx.org/sdg#EstablishedDataFormat"/>
                    </owl:Restriction>
                </owl:intersectionOf>
            </owl:Class>
        </owl:equivalentClass>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://signals.zndx.org/sdg#hasEncoding"/>
                <owl:someValuesFrom rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://signals.zndx.org/sdg#hasLabelText"/>
                <owl:someValuesFrom rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <obo:IAO_0000115>A youth health care summary is an information content entity that describes a youth health status and is formatted as an established data format.</obo:IAO_0000115>
        <rdfs:comment>A youth health care summary is an information content entity that describes a youth health status and is formatted as an established data format.</rdfs:comment>
        <rdfs:label>youth health care summary</rdfs:label>
    </owl:Class>
    


