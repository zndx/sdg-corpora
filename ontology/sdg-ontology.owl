    <!-- https://signals.zndx.org/sdg#ResidencyRequirement -->

    <owl:Class rdf:about="https://signals.zndx.org/sdg#ResidencyRequirement">
        <owl:equivalentClass>
            <owl:Class>
                <owl:intersectionOf rdf:parseType="Collection">
                    <rdf:Description rdf:about="https://www.commoncoreontologies.org/ont00000133"/>
                    <owl:Restriction>
                        <owl:onProperty rdf:resource="https://signals.zndx.org/sdg#enforcedByOffice"/>
                        <owl:someValuesFrom rdf:resource="https://signals.zndx.org/sdg#AdministrativeOffice"/>
                    </owl:Restriction>
                    <owl:Restriction>
                        <owl:onProperty rdf:resource="https://signals.zndx.org/sdg#mandatesCompletion"/>
                        <owl:someValuesFrom rdf:resource="https://signals.zndx.org/sdg#StudentAgent"/>
                    </owl:Restriction>
                </owl:intersectionOf>
            </owl:Class>
        </owl:equivalentClass>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://signals.zndx.org/sdg#hasEffectiveDate"/>
                <owl:someValuesFrom rdf:resource="http://www.w3.org/2001/XMLSchema#date"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://signals.zndx.org/sdg#hasEnforcement"/>
                <owl:someValuesFrom rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <obo:IAO_0000115>Every instance of ResidencyRequirement qualifies as a DirectiveICE, and each such instance is linked to at least one StudentAgent through the mandatesCompletion relation and to at least one AdministrativeOffice through the enforcedByOffice relation.</obo:IAO_0000115>
        <rdfs:comment>Every instance of ResidencyRequirement qualifies as a DirectiveICE, and each such instance is linked to at least one StudentAgent through the mandatesCompletion relation and to at least one AdministrativeOffice through the enforcedByOffice relation.</rdfs:comment>
        <rdfs:label>residency requirement</rdfs:label>
    </owl:Class>
    


