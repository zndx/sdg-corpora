    <!-- https://signals360.example.org/sdg#AccountAuthorizationRecord -->

    <owl:Class rdf:about="https://signals360.example.org/sdg#AccountAuthorizationRecord">
        <owl:equivalentClass>
            <owl:Class>
                <owl:intersectionOf rdf:parseType="Collection">
                    <rdf:Description rdf:about="http://www.commoncoreontologies.org/InformationContentEntity"/>
                    <owl:Restriction>
                        <owl:onProperty rdf:resource="https://signals360.example.org/sdg#assignsAdministrator"/>
                        <owl:someValuesFrom rdf:resource="https://signals360.example.org/sdg#StaffAdministrator"/>
                    </owl:Restriction>
                    <owl:Restriction>
                        <owl:onProperty rdf:resource="https://signals360.example.org/sdg#registersApplication"/>
                        <owl:someValuesFrom rdf:resource="https://signals360.example.org/sdg#SocialNetworkingApplication"/>
                    </owl:Restriction>
                </owl:intersectionOf>
            </owl:Class>
        </owl:equivalentClass>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://signals360.example.org/sdg#hasEncoding"/>
                <owl:someValuesFrom rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://signals360.example.org/sdg#hasLabelText"/>
                <owl:someValuesFrom rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <obo:IAO_0000115>An AccountAuthorizationRecord is an information content entity that registers a SocialNetworkingApplication and assigns a StaffAdministrator.</obo:IAO_0000115>
        <rdfs:comment>An AccountAuthorizationRecord is an information content entity that registers a SocialNetworkingApplication and assigns a StaffAdministrator.</rdfs:comment>
        <rdfs:label>account authorization record</rdfs:label>
    </owl:Class>
    


