    </owl:Class>
    


    <!-- https://signals.zndx.org/sdg#YoungPhysicianAmbassadorRole -->

    <owl:Class rdf:about="https://signals.zndx.org/sdg#YoungPhysicianAmbassadorRole">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/BFO_0000023"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://signals.zndx.org/sdg#realizes"/>
                <owl:someValuesFrom rdf:resource="https://signals.zndx.org/sdg#OrganizationalLeadershipRole"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://signals.zndx.org/sdg#inheres_in"/>
                <owl:qualifiedCardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">1</owl:qualifiedCardinality>
                <owl:onClass rdf:resource="https://signals.zndx.org/sdg#PhysicianMember"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <obo:IAO_0000115>A YoungPhysicianAmbassadorRole is a Role that inheres_in exactly one PhysicianMember and realizes some OrganizationalLeadershipRole.</obo:IAO_0000115>
        <rdfs:comment>A YoungPhysicianAmbassadorRole is a Role that inheres_in exactly one PhysicianMember and realizes some OrganizationalLeadershipRole.</rdfs:comment>
        <rdfs:label>young physician ambassador role</rdfs:label>
    </owl:Class>
    


    <!-- https://signals.zndx.org/sdg#YoungPhysicianEligibilityConstraint -->

    <owl:Class rdf:about="https://signals.zndx.org/sdg#YoungPhysicianEligibilityConstraint">
        <owl:equivalentClass>
            <owl:Class>
                <owl:intersectionOf rdf:parseType="Collection">
                    <rdf:Description rdf:about="https://www.commoncoreontologies.org/DescriptiveICE"/>
                    <owl:Restriction>
                        <owl:onProperty rdf:resource="https://signals.zndx.org/sdg#has_max_age_years"/>
                        <owl:someValuesFrom rdf:resource="http://www.w3.org/2001/XMLSchema#decimal"/>
                    </owl:Restriction>
                    <owl:Restriction>
                        <owl:onProperty rdf:resource="https://signals.zndx.org/sdg#has_max_practice_years"/>
                        <owl:someValuesFrom rdf:resource="http://www.w3.org/2001/XMLSchema#decimal"/>
                    </owl:Restriction>
                </owl:intersectionOf>
            </owl:Class>
        </owl:equivalentClass>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://signals.zndx.org/sdg#hasConfidence"/>
                <owl:someValuesFrom rdf:resource="http://www.w3.org/2001/XMLSchema#decimal"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://signals.zndx.org/sdg#hasDimensionKind"/>
                <owl:someValuesFrom rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <obo:IAO_0000115>A YoungPhysicianEligibilityConstraint is a DescriptiveICE that has_max_age_years some decimal and has_max_practice_years some decimal.</obo:IAO_0000115>
        <rdfs:comment>A YoungPhysicianEligibilityConstraint is a DescriptiveICE that has_max_age_years some decimal and has_max_practice_years some decimal.</rdfs:comment>
        <rdfs:label>young physician eligibility constraint</rdfs:label>
    </owl:Class>
    


    <!-- https://signals.zndx.org/sdg#YoungResearcherRole -->

    <owl:Class rdf:about="https://signals.zndx.org/sdg#YoungResearcherRole">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/BFO_0000023"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://signals.zndx.org/sdg#realizes"/>
                <owl:someValuesFrom rdf:resource="https://signals.zndx.org/sdg#ResearchActivity"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://signals.zndx.org/sdg#bearsRole"/>
                <owl:qualifiedCardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">1</owl:qualifiedCardinality>
                <owl:onClass rdf:resource="https://signals.zndx.org/sdg#IndependentContinuant"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <obo:IAO_0000115>A YoungResearcherRole is a role borne by exactly one IndependentContinuant that realizes some ResearchActivity.</obo:IAO_0000115>
        <rdfs:comment>A YoungResearcherRole is a role borne by exactly one IndependentContinuant that realizes some ResearchActivity.</rdfs:comment>
        <rdfs:label>young researcher role</rdfs:label>
