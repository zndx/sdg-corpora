y some sdg:FacultyMember, sdg:takenBy min 2 sdg:Student, sdg:contains min 2 sdg:MenuItem, sdg:servesAsPartOf exactly 1 sdg:FixedPriceMenu, sdg:prerequisiteOf some sdg:Course, sdg:fulfillsRequirement some sdg:DiplomaRequirement, sdg:coversTopic min 3 sdg:BioethicalTopic, sdg:taughtBy exactly 1 sdg:MedicalProfessional, sdg:contains min 2 sdg:AssessmentStandard, sdg:taughtBy exactly 1 sdg:Teacher, sdg:includesLab min 2 sdg:LabActivity, sdg:hasPrerequisite some sdg:Course, sdg:taughtBy max 1 sdg:CertifiedProfessional, sdg:attendedBy some sdg:CertifiedProfessional, sdg:linkedToActivity exactly 1 sdg:ProfessionalActivity

Class: sdg:DegreeRequirement
    Annotations: rdfs:label "Degree Requirement", iao:0000115 "A specific academic obligation or criterion that must be fulfilled to earn a degree or complete a track."
    SubClassOf: sdg:requirementId some xsd:string, sdg:title some xsd:string, sdg:category some sdg:CategoryKind, sdg:minCourses some xsd:integer, sdg:status some sdg:StatusKind, sdg:requiredCredits some xsd:integer, sdg:isOptional some xsd:boolean, sdg:effectiveDate some xsd:date, sdg:requiresCourse some sdg:Course, sdg:partOfProgram exactly 1 sdg:AcademicProgram, sdg:partOfDegree exactly 1 sdg:DegreeProgram

Class: sdg:AcademicProgram
    Annotations: rdfs:label "Academic Program", iao:0000115 "A structured curriculum defining the requirements for a degree, major, or specialized track."
    SubClassOf: sdg:Program, sdg:programCode some xsd:string, sdg:title some xsd:string, sdg:degreeType some xsd:string, sdg:effectiveDate some xsd:date, sdg:status some sdg:StatusKind, sdg:programName some xsd:string, sdg:standardTimeframeYears some xsd:integer, sdg:isEligibleForFederalAid some xsd:boolean, sdg:qualificationLevel some xsd:string, sdg:creditHours some xsd:integer, sdg:accreditationStatus some sdg:AccreditationStatusKind, sdg:learningOutcomes some xsd:string, sdg:degreeLevel some xsd:string, sdg:concentration some xsd:string, sdg:totalCreditHoursRequired some xsd:integer, sdg:maxAdvancedStandingCredits some xsd:integer, sdg:enrollmentMode some sdg:EnrollmentModeKind, sdg:programId some xsd:string, sdg:departmentId some xsd:string, sdg:totalCreditsRequired some xsd:integer, sdg:containsRequirement min 2 sdg:DegreeRequirement, sdg:awardedBy exactly 1 sdg:Institution, sdg:enrollsStudent some sdg:Student, sdg:offeredBy exactly 1 sdg:University, sdg:assessedBy some sdg:QualityAssuranceSystem, sdg:hasConcentration some sdg:Concentration, sdg:requiresCompetency min 3 sdg:Competency, sdg:grantsRole some sdg:ProfessionalRole, sdg:hasAdmissionCriteria exactly 1 sdg:AdmissionCriteria, sdg:offeredBy exactly 1 sdg:Department, sdg:includes min 3 sdg:Course
    HasKey: sdg:programCode

Class: sdg:CourseList
    Annotations: rdfs:label "Course List", iao:0000115 "A defined set of courses from which a student must select to satisfy a specific requirement."
    SubClassOf: cco:ont00000958, sdg:listId some xsd:string, sdg:title some xsd:string, sdg:selectionCount some xsd:integer, sdg:status some sdg:StatusKind, sdg:containsCourse min 2 sdg:Course, sdg:satisfiesRequirement exactly 1 sdg:DegreeRequirement

Class: sdg:Subfield
    Annotations: rdfs:label "Subfield", iao:0000115 "A specialized area of study within a broader academic discipline."
    SubClassOf: bfo:0000023, sdg:subfieldCode some xsd:string, sdg:title some xsd:string, sdg:discipline some xsd:string, sdg:status some sdg:StatusKind, sdg:offersCourse min 2 sdg:Course, sdg:partOfDiscipline exactly 1 sdg:AcademicProgram

Class: sdg:HealthcareProfessional
    Annotations: rdfs:label "Healthcare Professional", iao:0000115 "A person who provides medical or health-related services to patients."
    SubClassOf: sdg:HealthcareEntity, sdg:professionalId some xsd:string, sdg:fullName some xsd:string, sdg:specialty some xsd:string, sdg:clinicId some xsd:string, sdg:isPrimaryCare some xsd:boolean, sdg:employmentStatus some sdg:EmploymentStatusKind, sdg:roleDetail some sdg:RoleKind, sdg:yearsOfExperience some xsd:integer, sdg:certificationStatus some sdg:CertificationStatusKind, sdg:organizationAffiliation some xsd:string, sdg:name some sdg:NameKind, sdg:licenseNumber some xsd:string, sdg:professionalName some xsd:string, sdg:jobTitle some xsd:string, sdg:qualifications some xsd:string, sdg:treats some sdg:Patient, sdg:worksAt exactly 1 sdg:Clinic, sdg:employedBy exactly 1 sdg:Organization, sdg:performs min 2 sdg:MeasurementActivity, sdg:supervises some sdg:QualityImprovementProgram, sdg:employedBy exactly 1 sdg:HealthcareOrganization, sdg:measures min 2 sdg:ClinicalDataPoint, sdg:worksAt exactly 1 sdg:MedicalPractice, sdg:performsService min 2 sdg:ClinicalService

Class: sdg:DisclosureEvent
    Annotations: rdfs:label "Disclosure Event", iao:0000115 "An activity where a patient communicates their health status to another person."
    SubClassOf: bfo:0000015, sdg:eventId some xsd:string, sdg:disclosureDate some xsd:dateTime, sdg:method some sdg:MethodKind, sdg:isSuccessful some xsd:boolean, sdg:isNerveWracking some xsd:boolean, sdg:disclosureMethod some xsd:string, sdg:disclosureOutcome some xsd:string, sdg:involvesPatient exactly 1 sdg:Patient, sdg:involvesRecipient exactly 1 sdg:Person, sdg:isSupportedBy max 1 sdg:HealthcareProfessional, sdg:initiatedBy exactly 1 sdg:Patient, sdg:disclosedTo some sdg:Recipient

Class: sdg:Clinic
    Annotations: rdfs:label "Clinic", iao:0000115 "A healthcare facility providing medical services, including HIV status disclosure support."
    SubClassOf: bfo:0000040, sdg:clinicId some xsd:string, sdg:clinicName some xsd:string, sdg:location some xsd:string, sdg:hasWorkshops some xsd:boolean, sdg:clinicCode some xsd:string, sdg:locationCode some xsd:string, sdg:branchOf some xsd:string, sdg:address some xsd:string, sdg:city some xsd:string, sdg:state some xsd:string, sdg:hasTelehealth some xsd:boolean, sdg:employs some sdg:HealthcareProfessional, sdg:employsManager some sdg:Manager, sdg:hostsProvider some sdg:Provider, sdg:servesClient some sdg:Client, sdg:employs min 2 sdg:Provider, sdg:hosts some sdg:Program, sdg:uses exactly 1 sdg:ChartingSoftware

Class: sdg:MenuItem
    Annotations: rdfs:label "Menu Item", iao:0000115 "A distinct food or beverage product offered for sale by the catering establishment, characterized by its name, price, and composition."
    SubClassOf: sdg:DiningPackage, sdg:itemId some xsd:string, sdg:name some sdg:NameKind, sdg:price some xsd:decimal, sdg:category some sdg:CategoryKind, sdg:status some sdg:StatusKind, sdg:minimumOrderQuantity some xsd:integer, sdg:servingUnit some xsd:string, sdg:itemIdentifier some xsd:string, sdg:itemName some xsd:string, sdg:basePrice some xsd:decimal, sdg:isAvailable some xsd:boolean, sdg:description some xsd:string, sdg:isGlutenFree some xsd:boolean, sdg:isBaked some xsd:boolean, sdg:isBreaded some xsd:boolean, sdg:isGrilled some xsd:boolean, sdg:isFried some xsd:boolean, sdg:isPanSeared some xsd:boolean, sdg:menuItemId some xsd:string, sdg:isAlcoholic some xsd:boolean, sdg:isSpicy some xsd:boolean, sdg:weight some xsd:decimal, sdg:cookingTime some xsd:string, sdg:isVegetarian some xsd:boolean, sdg:isVegan some xsd:boolean, sdg:preparationMethod some xsd:string, sdg:servingSize some xsd:string, sdg:allergenInfo some xsd:string, sdg:weightGrams some xsd:integer, sdg:menuId some xsd:string, sdg:servingTime some xsd:string, sdg:isAvailableForOrder some xsd:boolean, sdg:cookingMethod some xsd:string, sdg:itemCode some xsd:string, sdg:servingStyle some xsd:string, sdg:containsIngredient some sdg:Ingredient, sdg:servedWithSide some sdg:SideDish, sdg:partOfCategory exactly 1 sdg:MenuCategory, sdg:containsIngredient min 2 sdg:FoodIngredient, sdg:servedWith max 1 sdg:SideItem, sdg:servedWithSide min 1 sdg:Salad, sdg:servedWithSide some sdg:SideItem, sdg:hasPreparationMethod max 1 sdg:PreparationMethod, sdg:belongsCategory exactly 1 sdg:MenuCategory, sdg:servedWith some sdg:SideDish, sdg:isPartOf exactly 1 sdg:Course, sdg:includesIngredient min 2 sdg:Ingredient, sdg:servedInCourse exactly 1 sdg:MenuCourse, sdg:belongsToList exactly 1 sdg:MenuSection, sdg:hasPriceOption some sdg:PriceOption, sdg:servedWith some sdg:FoodIngredient, sdg:hasSizeOption some sdg:MenuItemSize, sdg:belongsToCategory exactly 1 sdg:MenuCategory

Class: sdg:Ingredient
    Annotations: rdfs:label "Ingredient", iao:0000115 "A raw food component used in the preparation of menu items, tracked by its specific name and role in recipes."
    SubClassOf: cco:ont00000995, sdg:ingredientId some xsd:string, sdg:name some sdg:NameKind, sdg:type some sdg:TypeKind, sdg:allergenFlag some xsd:boolean, sdg:sourcingRegion some xsd:string, sdg:ingredientName some xsd:string, sdg:isOrganic some xsd:boolean, sdg:isCertified some xsd:boolean, sdg:origin some xsd:string, sdg:state some xsd:string, sdg:isLocallyGrown some xsd:boolean, sdg:isWildCaught some xsd:boolean, sdg:isAllergen some xsd:boolean, sdg:isSeasonal some xsd:boolean, sdg:allergenType some xsd:string, sdg:originRegion some xsd:string, sdg:certification some xsd:string, sdg:allergenCategory some xsd:string, sdg:form some xsd:string, sdg:isHouseMade some xsd:boolean, sdg:category some sdg:CategoryKind, sdg:usedInMenuItem some sdg:MenuItem, sdg:usedIn some sdg:Wrap, sdg:usedIn some sdg:PlatterItem, sdg:usedIn some sdg:MenuItem, sdg:isComponentOf some sdg:MenuLineItem, sdg:isComponentOf some sdg:MenuItem, sdg:isUsedIn some sdg:PreparationMethod, sdg:isUsedIn min 2 sdg:MenuItem, sdg:usedIn min 2 sdg:MenuFoodItem, sdg:usedIn min 2 sdg:Canape, sdg:usedIn some sdg:FoodItem

Class: sdg:OrderType
    Annotations: rdfs:label "Order Type", iao:0000115 "A classification of customer purchase based on volume, timing, or specific constraints, such as minimum quantity requirements."
    SubClassOf: cco:ont00000958, sdg:orderTypeId some xsd:string, sdg:name some sdg:NameKind, sdg:minimumQuantity some xsd:integer, sdg:requiresAdvanceNotice some xsd:boolean, sdg:appliesToMenuItem min 2 sdg:MenuItem, sdg:enforcedByPolicy max 1 sdg:Policy

Class: sdg:BoardSession
    Annotations: rdfs:label "Board Session", iao:0000115 "A formal public hearing or briefing conducted by the Board of Adjustment to review and decide on specific cases."
    SubClassOf: bfo:0000015, sdg:sessionDate some xsd:dateTime, sdg:startTime some xsd:dateTime, sdg:endTime some xsd:dateTime, sdg:sessionType some sdg:SessionTypeKind, sdg:panelDesignation some xsd:string, sdg:location some xsd:string, sdg:chairpersonName some xsd:string, sdg:isPrecedentSetting some xsd:boolean, sdg:hasMember min 2 sdg:BoardMember, sdg:hasStaff min 2 sdg:BoardStaff, sdg:reviewsCase some sdg:ZoningCase

Class: sdg:BoardMember
    Annotations: rdfs:label "Board Member", iao:0000115 "An individual serving as a voting member or alternate on the Board of Adjustment, holding a specific role such as Vice Chair or Regular Member."
    SubClassOf: bfo:0000023, sdg:memberId some xsd:string, sdg:fullName some xsd:string, sdg:roleDetail some sdg:RoleKind, sdg:isPresent some xsd:boolean, sdg:votingRecord some xsd:string, sdg:appointmentDate some xsd:date, sdg:termEndDate some xsd:date, sdg:isChairman some xsd:boolean, sdg:feeAmount some xsd:decimal, sdg:paymentMethod some sdg:PaymentMethodKind, sdg:roleType some sdg:RoleTypeKind, sdg:terminationDate some xsd:date, sdg:isCurrentMember some xsd:boolean, sdg:firstName some xsd:string, sdg:lastName some xsd:string, sdg:currentRole some xsd:string, sdg:isReappointment some xsd:boolean, sdg:isEmployee some xsd:boolean, sdg:appointmentYear some xsd:integer, sdg:currencyCode some xsd:string, sdg:servesOn some sdg:BoardSession, sdg:votesOn some sdg:BoardMotion, sdg:appointedAt exactly 1 sdg:AnnualGeneralMeeting, sdg:receivesFeeFrom some sdg:Resolution, sdg:servesOn exactly 1 sdg:GovernanceBoard, sdg:heldBy exactly 1 sdg:Person, sdg:holdsPosition some sdg:LeadershipPosition, sdg:servesOn exactly 1 sdg:BoardOfTrustees, sdg:holdsAppointment exactly 1 sdg:BoardAppointment, sdg:represents max 1 sdg:CountyJurisdiction, sdg:nominatedBy exactly 1 sdg:NominationCommittee, sdg:receivesFeeFrom exactly 1 sdg:FeeResolution

Class: sdg:BoardStaff
    Annotations: rdfs:label "Board Staff", iao:0000115 "An individual employed by the city to support the Board of Adjustment's administrative, legal, or technical functions during sessions."
    SubClassOf: bfo:0000023, sdg:staffId some xsd:string, sdg:fullName some xsd:string, sdg:jobTitle some xsd:string, sdg:isPresent some xsd:boolean, sdg:supports some sdg:BoardSession, sdg:providesReport some sdg:ZoningCase

Class: sdg:ZoningCase
    Annotations: rdfs:label "Zoning Case", iao:0000115 "A formal application or appeal submitted to the Board of Adjustment regarding land use, zoning regulations, or property development."
    SubClassOf: cco:ont00000995, sdg:fileNumber some xsd:string, sdg:applicationDate some xsd:dateTime, sdg:hearingDate some xsd:dateTime, sdg:propertyAddress some xsd:string, sdg:legalDescription some xsd:string, sdg:zoningDistrict some sdg:ZoningDistrictKind, sdg:requestedRelief some xsd:string, sdg:status some sdg:StatusKind, sdg:hasApplicant exactly 1 sdg:Applicant, sdg:hasRepresentative max 1 sdg:Representative, sdg:isReviewedBy some sdg:BoardSession, sdg:hasBuildingReport max 1 sdg:BuildingReport

Class: sdg:Applicant
    Annotations: rdfs:label "Applicant", iao:0000115 "An individual or entity submitting a request for a zoning exception, variance, or special use permit to the Board of Adjustment."
    SubClassOf: bfo:0000004, sdg:applicantId some xsd:string, sdg:fullName some xsd:string, sdg:contactInfo some xsd:string, sdg:representationStatus some sdg:RepresentationStatusKind, sdg:ssn some xsd:string, sdg:firstName some xsd:string, sdg:lastName some xsd:string, sdg:middleName some xsd:string, sdg:homePhone some xsd:string, sdg:cellPhone some xsd:string, sdg:streetAddress some xsd:string, sdg:city some xsd:string, sdg:state some xsd:string, sdg:zipCode some xsd:string, sdg:ageEligible some xsd:boolean, sdg:employmentEligibility some xsd:boolean, sdg:hasDriversLicense some xsd:boolean, sdg:licenseState some xsd:string, sdg:licenseNumber some xsd:string, sdg:criminalHistory some xsd:string, sdg:currentlyEmployed some xsd:boolean, sdg:previousApplicant some xsd:boolean, sdg:lastApplicationDate some xsd:date, sdg:passportNumber some xsd:string, sdg:socialSecurityNumber some xsd:string, sdg:dateOfBirth some xsd:date, sdg:placeOfBirth some xsd:string, sdg:nationality some xsd:string, sdg:currentResidence some xsd:string, sdg:residenceDuration some xsd:decimal, sdg:applicationStatus some sdg:ApplicationStatusKind, sdg:submissionDate some xsd:dateTime, sdg:submitsCase some sdg:ZoningCase, sdg:isRepresentedBy max 1 sdg:Representative, sdg:submittedApplication min 2 sdg:JobApplication, sdg:currentEmployer max 1 sdg:Organization, sdg:referredBy max 1 sdg:Person, sdg:hasEducation some sdg:Qualification, sdg:hasMembership some sdg:ProfessionalMembership, sdg:holdsInterestIn max 1 sdg:RegulatedPerson, sdg:submits min 2 sdg:AdmissionRequirement, sdg:holds min 2 sdg:Credential

Class: sdg:Representative
    Annotations: rdfs:label "Representative", iao:0000115 "An individual, such as an attorney or agent, authorized to act on behalf of an applicant in a zoning case."
    SubClassOf: bfo:0000004, sdg:representativeId some xsd:string, sdg:fullName some xsd:string, sdg:profession some xsd:string, sdg:represents some sdg:Applicant, sdg:appearsIn some sdg:BoardSession

Class: sdg:BuildingReport
    Annotations: rdfs:label "Building Report", iao:0000115 "A technical document prepared by the Building Official or relevant city department detailing the facts, regulations, and recommendations for a specific zoning case."
    SubClassOf: cco:ont00000995, sdg:reportId some xsd:string, sdg:reportDate some xsd:dateTime, sdg:preparedByDetail some xsd:string, sdg:regulationCited some xsd:string, sdg:finding some xsd:string, sdg:recommendation some xsd:string, sdg:coversCase exactly 1 sdg:ZoningCase, sdg:preparedByOfficial exactly 1 sdg:BoardStaff

Class: sdg:BoardMotion
    Annotations: rdfs:label "Board Motion", iao:0000115 "A formal proposal made by a board member during a session to take a specific action, such as approving minutes or granting a case."
    SubClassOf: bfo:0000015, sdg:motionId some xsd:string, sdg:motionText some xsd:string, sdg:proposedByDetail some xsd:string, sdg:secondedByDetail some xsd:string, sdg:outcome some sdg:OutcomeKind, sdg:voteCount some xsd:integer, sdg:madeInSession exactly 1 sdg:BoardSession, sdg:proposedByMember exactly 1 sdg:BoardMember, sdg:secondedByMember exactly 1 sdg:BoardMember, sdg:votesOn some sdg:BoardMember

Class: sdg:ResearchCommittee
    Annotations: rdfs:label "Research Committee Academic Board", iao:0000115 "A research committee academic board that governs research activities within the institution."
    SubClassOf: sdg:ResearchEntity, sdg:committeeId some xsd:string, sdg:name some sdg:NameKind, sdg:establishedDate some xsd:date, sdg:status some sdg:StatusKind, sdg:governanceStatus some xsd:string, sdg:committeeIdentifier some xsd:string, sdg:hasVicePresident exactly 1 sdg:ResearchVicePresident, sdg:hasChair exactly 1 sdg:ResearchExecutive, sdg:oversees some sdg:ResearchLaboratory

Class: sdg:ResearchVicePresident
    Annotations: rdfs:label "Vice-president of Research", iao:0000115 "A senior administrative role responsible for overseeing research activities and the research committee."
    SubClassOf: bfo:0000040, sdg:officialName some xsd:string, sdg:title some xsd:string, sdg:appointmentDate some xsd:date, sdg:status some sdg:StatusKind, sdg:oversees exactly 1 sdg:ResearchCommittee, sdg:oversees exactly 1 sdg:ScientificBureau

Class: sdg:ScientificBureau
    Annotations: rdfs:label "Scientific Bureau", iao:0000115 "A scientific bureau that supports the research committee in evaluating and managing research proposals."
    SubClassOf: bfo:0000040, sdg:bureauId some xsd:string, sdg:name some sdg:NameKind, sdg:establishedDate some xsd:date, sdg:status some sdg:StatusKind
    HasKey: sdg:bureauId

Class: sdg:DoctoralSchool
    Annotations: rdfs:label "Doctoral School", iao:0000115 "An organizational unit responsible for doctoral training, research supervision, and academic administration."
    SubClassOf: bfo:0000040, sdg:schoolId some xsd:string, sdg:name some sdg:NameKind, sdg:code some xsd:string, sdg:establishedDate some xsd:date, sdg:status some sdg:StatusKind, sdg:schoolCode some xsd:string, sdg:schoolName some xsd:string, sdg:academicFocus some xsd:string, sdg:memberLaboratoryCount some xsd:integer, sdg:jurisdictionalScope some xsd:string, sdg:hasDirector exactly 1 sdg:DoctoralSchoolDirector, sdg:hasLaboratory min 2 sdg:ResearchLaboratory, sdg:isPartOf some sdg:DoctoralCollege, sdg:hasDirector exactly 1 sdg:ResearchExecutive, sdg:comprises min 2 sdg:ResearchLaboratory

Class: sdg:DoctoralSchoolDirector
    Annotations: rdfs:label "Director of Doctoral School", iao:0000115 "An academic administrator responsible for leading a specific doctoral school."
    SubClassOf: bfo:0000040, sdg:officialName some xsd:string, sdg:title some xsd:string, sdg:appointmentDate some xsd:date, sdg:status some sdg:StatusKind, sdg:directs exactly 1 sdg:DoctoralSchool

Class: sdg:DoctoralCollege
    Annotations: rdfs:label "Doctoral College", iao:0000115 "A regional or inter-university body that groups together multiple doctoral schools."
    SubClassOf: bfo:0000040, sdg:collegeId some xsd:string, sdg:name some sdg:NameKind, sdg:establishedDate some xsd:date, sdg:status some sdg:StatusKind, sdg:collegeIdentifier some xsd:string, sdg:collegeName some xsd:string, sdg:geographicRegion some xsd:string, sdg:constituentSchoolCount some xsd:integer, sdg:hasMemberSchool min 2 sdg:DoctoralSchool, sdg:aggregates min 2 sdg:DoctoralSchool
    HasKey: sdg:collegeId

Class: sdg:ResearchLaboratory
    Annotations: rdfs:label "Research Laboratory", iao:0000115 "A research laboratory that conducts scientific research and is affiliated with a doctoral school."
    SubClassOf: sdg:ResearchEntity, sdg:labId some xsd:string, sdg:name some sdg:NameKind, sdg:establishedDate some xsd:date, sdg:status some sdg:StatusKind, sdg:researchDomain some xsd:string, sdg:laboratoryIdentifier some xsd:string, sdg:laboratoryName some xsd:string, sdg:operationalStatus some sdg:OperationalStatusKind, sdg:isAffiliatedWith min 2 sdg:DoctoralSchool, sdg:assignedTo some sdg:DoctoralSchool, sdg:supervisedBy some sdg:ResearchExecutive

Class: sdg:TechnologyTransferDepartment
    Annotations: rdfs:label "Research and Technology Transfer Department", iao:0000115 "A department responsible for managing technology transfer and commercialization of research outcomes."
    SubClassOf: bfo:0000040, sdg:departmentId some xsd:string, sdg:name some sdg:NameKind, sdg:establishedDate some xsd:date, sdg:status some sdg:StatusKind, sdg:hasAdministrativeDirector exactly 1 sdg:AdministrativeDirector, sdg:hasVicePresident exactly 1 sdg:TechnologyTransferVicePresident

Class: sdg:AdministrativeDirector
    Annotations: rdfs:label "Administrative Director", iao:0000115 "An administrative role responsible for the day-to-day management of a department."
    SubClassOf: bfo:0000040, sdg:officialName some xsd:string, sdg:title some xsd:string, sdg:appointmentDate some xsd:date, sdg:status some sdg:StatusKind, sdg:manages exactly 1 sdg:TechnologyTransferDepartment

Class: sdg:TechnologyTransferVicePresident
    Annotations: rdfs:label "Vice-President in charge of Research and Technology Transfer", iao:0000115 "A senior administrative role responsible for overseeing research and technology transfer activities."
    SubClassOf: bfo:0000040, sdg:officialName some xsd:string, sdg:title some xsd:string, sdg:appointmentDate some xsd:date, sdg:status some sdg:StatusKind, sdg:oversees exactly 1 sdg:TechnologyTransferDepartment

Class: sdg:TrainingPlan
    Annotations: rdfs:label "Training Plan", iao:0000115 "A structured regimen designed to condition a dog and its owner for a specific physical event."
    SubClassOf: sdg:planIdentifier some xsd:string, sdg:planTitle some xsd:string, sdg:targetEvent some xsd:string, sdg:durationWeeks some xsd:integer, sdg:startDate some xsd:dateTime, sdg:endDate some xsd:dateTime, sdg:status some sdg:StatusKind, sdg:designedFor exactly 1 sdg:PhysicalEvent, sdg:contains min 2 sdg:WeeklySchedule

Class: sdg:WeeklySchedule
    Annotations: rdfs:label "Weekly Schedule", iao:0000115 "A recurring set of training activities assigned to specific days of the week within a training plan."
    SubClassOf: cco:ont00000995, sdg:weekNumber some xsd:integer, sdg:planIdentifier some xsd:string, sdg:totalDistance some xsd:decimal, sdg:targetDistance some xsd:decimal, sdg:intensityLevel some xsd:string, sdg:partOf__escalated exactly 1 sdg:TrainingPlan, sdg:includes min 7 sdg:DailyActivity

Class: sdg:DailyActivity
    Annotations: rdfs:label "Daily Activity", iao:0000115 "A specific physical exercise or rest period assigned to a dog on a particular day."
    SubClassOf: sdg:ProgramActivity, sdg:activityType some sdg:ActivityTypeKind, sdg:scheduledDay some sdg:ScheduledDayKind, sdg:durationMinutes some xsd:integer, sdg:distanceKm some xsd:decimal, sdg:pace some sdg:PaceKind, sdg:isRestDay some xsd:boolean, sdg:scheduledIn exactly 1 sdg:WeeklySchedule, sdg:performedBy exactly 1 sdg:Dog, sdg:supervisedBy exactly 1 sdg:Owner

Class: sdg:Dog
    Annotations: rdfs:label "Dog", iao:0000115 "A domesticated canine participant in a training regimen."
    SubClassOf: bfo:0000002, sdg:dogIdentifier some xsd:string, sdg:breed some xsd:string, sdg:ageYears some xsd:integer, sdg:weightKg some xsd:decimal, sdg:fitnessLevel some sdg:FitnessLevelKind, sdg:healthStatus some sdg:HealthStatusKind, sdg:participatesIn__escalated min 1 sdg:TrainingPlan, sdg:performs min 2 sdg:DailyActivity

Class: sdg:Owner
    Annotations: rdfs:label "Owner", iao:0000115 "The human guardian responsible for supervising and executing the training activities with the dog."
    SubClassOf: bfo:0000002, sdg:ownerIdentifier some xsd:string, sdg:fullName some xsd:string, sdg:contactEmail some xsd:string, sdg:experienceLevel some sdg:ExperienceLevelKind, sdg:ownerId some xsd:string, sdg:ownerName some xsd:string, sdg:address some xsd:string, sdg:city some xsd:string, sdg:state some xsd:string, sdg:zipCode some xsd:string, sdg:phone some xsd:string, sdg:email some xsd:string, sdg:supervises min 2 sdg:DailyActivity, sdg:owns exactly 1 sdg:Dog, sdg:owns some sdg:Horse

Class: sdg:PhysicalEvent
    Annotations: rdfs:label "Physical Event", iao:0000115 "A scheduled public or private physical activity, such as a race or walk, that serves as the goal for a training plan."
    SubClassOf: sdg:Event, sdg:eventIdentifier some xsd:string, sdg:eventName some xsd:string, sdg:eventDate some xsd:dateTime, sdg:distanceKm some xsd:decimal, sdg:eventStatus some xsd:string, sdg:hasTrainingPlan min 1 sdg:TrainingPlan

Class: sdg:BiologicalEvent
    Annotations: rdfs:label "Biological Event", iao:0000115 "A process involving the emergence, spread, or impact of a biological agent on human health, economies, or security."
    SubClassOf: bfo:0000015, sdg:eventIdentifier some xsd:string, sdg:pathogenName some xsd:string, sdg:infectionCount some xsd:integer, sdg:mortalityCount some xsd:integer, sdg:economicLossUSD some xsd:decimal, sdg:onsetDate some xsd:dateTime, sdg:status some sdg:StatusKind, sdg:investigatedBy some sdg:JointAssessmentMechanism, sdg:triggeredBy some sdg:BioscienceAdvancement, sdg:fundedBy some sdg:CatalyticFinancingMechanism

Class: sdg:BioscienceAdvancement
    Annotations: rdfs:label "Bioscience Advancement", iao:0000115 "A technological or methodological progress in bioscience and biotechnology that enables new capabilities in reading, writing, or editing genetic material."
    SubClassOf: bfo:0000015, sdg:advancementID some xsd:string, sdg:technologyType some sdg:TechnologyTypeKind, sdg:riskLevel some sdg:RiskLevelKind, sdg:implementationDate some xsd:dateTime, sdg:dualUsePotential some xsd:boolean, sdg:technicalBarrierLevel some xsd:decimal, sdg:increasesRiskOf some sdg:BiologicalEvent, sdg:developedBy some sdg:ResearchFacility, sdg:regulatedBy some sdg:BiosecurityNorm

Class: sdg:ResearchFacility
    Annotations: rdfs:label "Research Facility", iao:0000115 "A physical or virtual location where bioscience and biotechnology research is conducted, including labs handling high-consequence pathogens."
    SubClassOf: cco:ont00000995, sdg:facilityID some xsd:string, sdg:facilityName some xsd:string, sdg:locationCountry some xsd:string, sdg:biosafetyLevel some xsd:integer, sdg:operationalStatus some sdg:OperationalStatusKind, sdg:lastInspectionDate some xsd:date, sdg:accidentRate some xsd:decimal, sdg:conductsResearchOn some sdg:BioscienceAdvancement, sdg:subjectTo some sdg:BiosecurityNorm
    HasKey: sdg:facilityID

Class: sdg:BiosecurityNorm
    Annotations: rdfs:label "Biosecurity Norm", iao:0000115 "A formal or informal rule, standard, or guideline established to prevent the deliberate abuse or accidental misuse of bioscience and biotechnology."
    SubClassOf: cco:ont00000958, sdg:normID some xsd:string, sdg:normName some xsd:string, sdg:issuingBody some xsd:string, sdg:effectiveDate some xsd:date, sdg:enforcementLevel some sdg:EnforcementLevelKind, sdg:complianceRate some xsd:decimal, sdg:regulates some sdg:ResearchFacility, sdg:mitigatesRiskOf some sdg:BiologicalEvent, sdg:supportedBy some sdg:CatalyticFinancingMechanism

Class: sdg:JointAssessmentMechanism
    Annotations: rdfs:label "Joint Assessment Mechanism", iao:0000115 "A UN-system capability for investigating high-consequence biological events of unknown origin to rapidly discern their source."
    SubClassOf: bfo:0000015, sdg:mechanismID some xsd:string, sdg:mechanismName some xsd:string, sdg:activationDate some xsd:dateTime, sdg:investigationOutcome some sdg:InvestigationOutcomeKind, sdg:resourcesAllocated some xsd:decimal, sdg:participatingAgencies some xsd:string, sdg:investigates some sdg:BiologicalEvent, sdg:fundedBy some sdg:CatalyticFinancingMechanism, sdg:operatedBy some sdg:ResearchFacility

Class: sdg:CatalyticFinancingMechanism
    Annotations: rdfs:label "Catalytic Financing Mechanism", iao:0000115 "A funding instrument designed to finance biosecurity and pandemic preparedness capacity building in countries worldwide."
    SubClassOf: cco:ont00000995, sdg:mechanismID some xsd:string, sdg:mechanismName some xsd:string, sdg:totalFundingUSD some xsd:decimal, sdg:fundingStatus some sdg:FundingStatusKind, sdg:targetCountries some xsd:string, sdg:disbursementDate some xsd:dateTime, sdg:funds some sdg:JointAssessmentMechanism, sdg:supports some sdg:BiosecurityNorm, sdg:targets some sdg:ResearchFacility
    HasKey: sdg:mechanismID

Class: sdg:ChainLubricant
    Annotations: rdfs:label "Chain Lubricant", iao:0000115 "A formulated chemical substance applied to chain drives to reduce friction, wear, and corrosion."
    SubClassOf: cco:ont00000995, sdg:lubricantId some xsd:string, sdg:chemicalFamily some xsd:string, sdg:baseName some xsd:string, sdg:viscosityGrade some xsd:string, sdg:isTacky some xsd:boolean, sdg:isSolubleMoly some xsd:boolean, sdg:isEP some xsd:boolean, sdg:isAerosol some xsd:boolean, sdg:hasOperatingCondition some sdg:OperatingCondition, sdg:hasManufacturer exactly 1 sdg:Manufacturer
    HasKey: sdg:lubricantId

Class: sdg:OperatingCondition
    Annotations: rdfs:label "Operating Condition", iao:0000115 "A specific set of environmental and mechanical parameters defining the operational context of a chain drive."
    SubClassOf: bfo:0000015, sdg:conditionId some xsd:string, sdg:temperatureMin some xsd:decimal, sdg:temperatureMax some xsd:decimal, sdg:loadLevel some xsd:string, sdg:isWet some xsd:boolean, sdg:isExposedToForeignMaterials some xsd:boolean, sdg:operatingTemperature some xsd:decimal, sdg:storageTemperature some xsd:decimal, sdg:solderingTemperature some xsd:decimal, sdg:reverseVoltage some xsd:decimal, sdg:requiresLubricant some sdg:ChainLubricant, sdg:appliesToChainDrive some sdg:ChainDrive, sdg:appliesTo exactly 1 sdg:LaserDiodeModule

Class: sdg:ChainDrive
    Annotations: rdfs:label "Chain Drive", iao:0000115 "A mechanical system transmitting power via a chain engaging with sprockets."
    SubClassOf: bfo:0000040, sdg:driveId some xsd:string, sdg:driveType some xsd:string, sdg:isCriticalOperation some xsd:boolean, sdg:installationDate some xsd:date, sdg:usesLubricant some sdg:ChainLubricant, sdg:experiencesCondition some sdg:OperatingCondition, sdg:containsSprocket min 2 sdg:Sprocket

Class: sdg:Sprocket
    Annotations: rdfs:label "Sprocket", iao:0000115 "A toothed wheel that engages with a chain to transmit rotational motion."
    SubClassOf: cco:ont00000995, sdg:sprocketId some xsd:string, sdg:toothCount some xsd:integer, sdg:pitchDiameter some xsd:decimal, sdg:material some xsd:string, sdg:partOfDrive exactly 1 sdg:ChainDrive, sdg:contactsChain exactly 1 sdg:Chain

Class: sdg:Chain
    Annotations: rdfs:label "Chain", iao:0000115 "A series of connected links used to transmit mechanical power."
    SubClassOf: cco:ont00000995, sdg:chainId some xsd:string, sdg:linkType some xsd:string, sdg:pitch some xsd:decimal, sdg:material some xsd:string, sdg:partOfDrive exactly 1 sdg:ChainDrive, sdg:engagesSprocket min 2 sdg:Sprocket

Class: sdg:Manufacturer
    Annotations: rdfs:label "Manufacturer", iao:0000115 "An organization or entity responsible for producing the lubricant."
    SubClassOf: bfo:0000004, sdg:manufacturerId some xsd:string, sdg:name some sdg:NameKind, sdg:supportPhone some xsd:string, sdg:manufacturerName some xsd:string, sdg:legalForm some xsd:string, sdg:registeredAddress some xsd:string, sdg:countryOfOrigin some xsd:string, sdg:registrationNumber some xsd:string, sdg:companyName some xsd:string, sdg:countryOfOperation some xsd:string, sdg:contractStatus some xsd:string, sdg:certificationLevel some xsd:string, sdg:contactEmail some xsd:string, sdg:legalName some xsd:string, sdg:address some xsd:string, sdg:city some xsd:string, sdg:postalCode some xsd:string, sdg:country some sdg:CountryKind, sdg:producesLubricant some sdg:ChainLubricant, sdg:produces min 2 sdg:ApprovedProduct, sdg:subjectToSurveillanceBy exactly 1 sdg:ApprovingAuthority, sdg:produces some sdg:IoTDevice, sdg:suppliesTo some sdg:DistributionChannel, sdg:manufactures min 1 sdg:TaperGage, sdg:produces min 2 sdg:ProductModel
    HasKey: sdg:manufacturerId

Class: sdg:SideItem
    Annotations: rdfs:label "Side Item", iao:0000115 "A supplementary food product included with or available alongside a primary menu item, such as chips or dressings."
    SubClassOf: cco:ont00000995, sdg:sideId some xsd:string, sdg:sideName some xsd:string, sdg:sideType some xsd:string, sdg:isIncluded some xsd:boolean, sdg:price some xsd:decimal, sdg:type some sdg:TypeKind, sdg:isAvailable some xsd:boolean, sdg:sideItemId some xsd:string, sdg:name some sdg:NameKind, sdg:includedWith some sdg:MenuItem, sdg:includedIn max 1 sdg:PartyPlatter, sdg:includedIn max 1 sdg:BoxLunch, sdg:isServedWith some sdg:MenuItem, sdg:containsIngredient min 2 sdg:Ingredient

Class: sdg:OrderLine
    Annotations: rdfs:label "Order Line", iao:0000115 "A specific line item within a catering order, recording the quantity and specific variant of a menu item requested by a customer."
    SubClassOf: cco:ont00000995, sdg:lineId some xsd:string, sdg:quantity some xsd:integer, sdg:unitPrice some xsd:decimal, sdg:lineTotal some xsd:decimal, sdg:specialInstructions some xsd:string, sdg:totalPrice some xsd:decimal, sdg:selectedSauce some xsd:string, sdg:isEpicUpgrade some xsd:boolean, sdg:referencesMenuItem exactly 1 sdg:MenuItem, sdg:partOfOrder exactly 1 sdg:CateringOrder, sdg:containsItem exactly 1 sdg:MenuFoodItem, sdg:referencesPackage max 1 sdg:CateringPackage, sdg:selectsSauce max 1 sdg:Sauce

Class: sdg:CateringOrder
    Annotations: rdfs:label "Catering Order", iao:0000115 "A formal request for food preparation and delivery, characterized by its order number, status, and fulfillment details."
    SubClassOf: cco:ont00000995, sdg:orderId some xsd:string, sdg:orderDate some xsd:dateTime, sdg:deliveryDate some xsd:dateTime, sdg:orderStatus some xsd:string, sdg:totalAmount some xsd:decimal, sdg:contactPhone some xsd:string, sdg:containsLine min 2 sdg:OrderLine

Class: sdg:TaxRegistration
    Annotations: rdfs:label "Tax Registration", iao:0000115 "A formal record of a trader's enrollment in the Goods and Services Tax (GST) regime, issued by the government upon verification of eligibility and documentation."
    SubClassOf: cco:ont00000995, sdg:registrationId some xsd:string, sdg:issueDate some xsd:date, sdg:expiryDate some xsd:date, sdg:status some sdg:StatusKind, sdg:turnoverThreshold some xsd:decimal, sdg:stateOfRegistration some xsd:string, sdg:applicationSubmissionDate some xsd:dateTime, sdg:isExempted some xsd:boolean, sdg:issuedTo exactly 1 sdg:Trader, sdg:coversState some sdg:Jurisdiction, sdg:grantsInputTaxCredit some sdg:InputTaxCredit

Class: sdg:Trader
    Annotations: rdfs:label "Trader", iao:0000115 "An individual or business entity engaged in the supply of taxable goods or services, subject to GST registration requirements based on turnover thresholds."
    SubClassOf: bfo:0000015, sdg:traderId some xsd:string, sdg:legalName some xsd:string, sdg:panNumber some xsd:string, sdg:contactEmail some xsd:string, sdg:contactMobile some xsd:string, sdg:annualAggregateTurnover some xsd:decimal, sdg:isSpecialCategoryState some xsd:boolean, sdg:registrationStatus some sdg:RegistrationStatusKind, sdg:holdsRegistration max 1 sdg:TaxRegistration, sdg:operatesIn some sdg:Jurisdiction, sdg:suppliesTo some sdg:TaxableSupply

Class: sdg:Jurisdiction
    Annotations: rdfs:label "Jurisdiction", iao:0000115 "A geographical or administrative area (State or Union Territory) where a trader makes taxable supplies and is subject to GST regulations."
    SubClassOf: sdg:LegalEntity, sdg:jurisdictionCode some xsd:string, sdg:jurisdictionName some xsd:string, sdg:jurisdictionType some xsd:string, sdg:isSpecialCategory some xsd:boolean, sdg:turnoverThreshold some xsd:decimal, sdg:countryCode some sdg:CountryCodeKind, sdg:jurisdictionId some xsd:string, sdg:name some sdg:NameKind, sdg:region some sdg:RegionKind, sdg:population some xsd:integer, sdg:gdp some xsd:decimal, sdg:regulatoryEnvironment some xsd:string, sdg:administrativeLevel some xsd:string, sdg:populationCount some xsd:integer, sdg:areaCode some xsd:string, sdg:wasteGenerationRateTonsPerCapita some xsd:decimal, sdg:stateCode some xsd:string, sdg:stateName some xsd:string, sdg:courtSystem some xsd:string, sdg:countryName some xsd:string, sdg:registrationAuthority some xsd:string, sdg:taxRate some xsd:decimal, sdg:legalFrameworkVersion some xsd:string, sdg:coversTrader some sdg:Trader, sdg:issuesRegistration some sdg:TaxRegistration, sdg:contains min 2 sdg:SME, sdg:contains min 2 sdg:BusinessOwner, sdg:contains min 2 sdg:Employee, sdg:containsPopulation some sdg:PopulationSegment, sdg:implementsPolicy some sdg:PreventivePolicy, sdg:hostsHealthService some sdg:HealthService, sdg:suppliesWasteToFacility min 2 sdg:WasteProcessingFacility, sdg:servedByGrid min 2 sdg:PowerGrid, sdg:regulates some sdg:BusinessEntity

Class: sdg:TaxableSupply
    Annotations: rdfs:label "Taxable Supply", iao:0000115 "The act of supplying goods or services that are subject to GST, excluding exempted goods or services."
    SubClassOf: bfo:0000015, sdg:supplyId some xsd:string, sdg:supplyDate some xsd:date, sdg:supplyType some xsd:string, sdg:isExempted some xsd:boolean, sdg:value some xsd:decimal, sdg:taxRate some xsd:decimal, sdg:madeBy exactly 1 sdg:Trader, sdg:receivedBy some sdg:Trader, sdg:occursIn__escalated exactly 1 sdg:Jurisdiction

Class: sdg:InputTaxCredit
    Annotations: rdfs:label "Input Tax Credit", iao:0000115 "A financial benefit allowing a registered trader to claim credit for taxes paid on inputs, reducing the overall tax liability on outputs."
    SubClassOf: cco:ont00000995, sdg:creditId some xsd:string, sdg:creditAmount some xsd:decimal, sdg:creditDate some xsd:date, sdg:status some sdg:StatusKind, sdg:linkedSupplyId some xsd:string, sdg:claimedBy exactly 1 sdg:Trader, sdg:derivedFrom exactly 1 sdg:TaxableSupply, sdg:reducesLiabilityFor exactly 1 sdg:TaxRegistration

Class: sdg:TrainingCentre
    Annotations: rdfs:label "Training Centre", iao:0000115 "A physical or virtual facility established to provide training and certification for GST practitioners or other skilled workers under government missions."
    SubClassOf: cco:ont00000995, sdg:centreId some xsd:string, sdg:centreName some xsd:string, sdg:centreType some sdg:CentreTypeKind, sdg:inaugurationDate some xsd:date, sdg:location some xsd:string, sdg:capacity some xsd:integer, sdg:operatedBy exactly 1 sdg:GovernmentAgency, sdg:supportsMission exactly 1 sdg:GovernmentMission

Class: sdg:GovernmentMission
    Annotations: rdfs:label "Government Mission", iao:0000115 "A national initiative or campaign launched by the government to promote skill development, entrepreneurship, or specific policy objectives like GST compliance."
    SubClassOf: bfo:0000015, sdg:missionId some xsd:string, sdg:missionName some xsd:string, sdg:launchDate some xsd:date, sdg:anniversaryYear some xsd:integer, sdg:objective some xsd:string, sdg:launchedBy exactly 1 sdg:GovernmentAgency, sdg:supportedBy some sdg:Company, sdg:institutesCentres some sdg:TrainingCentre

Class: sdg:GovernmentAgency
    Annotations: rdfs:label "Government Agency", iao:0000115 "A state body responsible for implementing policies, missions, and regulatory frameworks such as GST registration and skill development programs."
    SubClassOf: bfo:0000015, sdg:agencyId some xsd:string, sdg:agencyName some xsd:string, sdg:ministry some xsd:string, sdg:establishedDate some xsd:date, sdg:jurisdiction some sdg:JurisdictionKind, sdg:agencyType some sdg:AgencyTypeKind, sdg:legalAuthority some xsd:string, sdg:agencyIdentifier some xsd:string, sdg:jurisdictionLevel some sdg:JurisdictionLevelKind, sdg:serviceType some sdg:ServiceTypeKind, sdg:approvalGranted some xsd:boolean, sdg:grantReviewRole some sdg:GrantReviewRoleKind, sdg:launchesMission some sdg:GovernmentMission, sdg:operatesCentres some sdg:TrainingCentre, sdg:enforcesRegistration some sdg:TaxRegistration, sdg:executes some sdg:BailoutProgram, sdg:regulates some sdg:FinancialInstitution, sdg:implementsPolicy some sdg:PolicyDecision, sdg:overseesDomain some sdg:SystemDomain, sdg:defendantIn some sdg:LegalCase, sdg:approvesCurriculum some sdg:EducationalCurriculum, sdg:fundsProgram some sdg:CommunityProgram, sdg:reviewedBy some sdg:Person

Class: sdg:AnimalControlOfficer
    Annotations: rdfs:label "Animal Control Officer", iao:0000115 "A human agent employed by a municipal animal services department to enforce animal control ordinances, manage animal populations, and ensure public safety."
    SubClassOf: bfo:0000002, sdg:employeeId some xsd:string, sdg:fullName some xsd:string, sdg:certificationLevel some xsd:string, sdg:licenseStatus some sdg:LicenseStatusKind, sdg:onCallStatus some xsd:string, sdg:safetyCoordinatorRole some xsd:boolean, sdg:performs some sdg:VectorControlActivity, sdg:respondsTo some sdg:AnimalEmergency

Class: sdg:VectorControlActivity
    Annotations: rdfs:label "Vector Control Activity", iao:0000115 "A municipal service process involving the calibration, preparation, and spraying of residential streets to control disease-carrying organisms."
    SubClassOf: bfo:0000015, sdg:activityId some xsd:string, sdg:sprayDate some xsd:dateTime, sdg:treatedArea some xsd:string, sdg:chemicalAgent some xsd:string, sdg:calibrationStatus some xsd:string, sdg:reportStatus some sdg:ReportStatusKind, sdg:conductedBy exactly 1 sdg:AnimalControlOfficer

Class: sdg:AnimalEmergency
    Annotations: rdfs:label "Animal Emergency", iao:0000115 "An urgent, unplanned event involving animals occurring outside normal business hours that requires immediate intervention."
    SubClassOf: bfo:0000015, sdg:emergencyId some xsd:string, sdg:incidentDateTime some xsd:dateTime, sdg:severityLevel some sdg:SeverityLevelKind, sdg:location some xsd:string, sdg:resolutionStatus some sdg:ResolutionStatusKind, sdg:requiresImmobilization some xsd:boolean, sdg:respondedBy exactly 1 sdg:AnimalControlOfficer, sdg:involvesAnimal some sdg:Animal, sdg:triggers max 1 sdg:IncidentReport
    HasKey: sdg:emergencyId

Class: sdg:Animal
    Annotations: rdfs:label "Animal", iao:0000115 "A living organism under the jurisdiction of the animal services department, including pets, wildlife, or strays."
    SubClassOf: bfo:0000004, sdg:animalId some xsd:string, sdg:species some xsd:string, sdg:breed some xsd:string, sdg:weightKg some xsd:decimal, sdg:healthStatus some sdg:HealthStatusKind, sdg:microchipId some xsd:string, sdg:age some xsd:integer, sdg:weight some xsd:decimal, sdg:temperament some xsd:string, sdg:impoundStatus some sdg:ImpoundStatusKind, sdg:implicatedIn some sdg:AnimalEmergency, sdg:heldBy max 1 sdg:AnimalControlOfficer, sdg:belongsTo max 1 sdg:Owner, sdg:involvedIn some sdg:IncidentReport, sdg:subjectTo max 1 sdg:AdoptionAssessment, sdg:carries max 1 sdg:Disease

Class: sdg:SafetyMeeting
    Annotations: rdfs:label "Safety Meeting", iao:0000115 "A scheduled departmental gathering facilitated by a safety coordinator to review protocols, discuss concerns, and document attendance."
    SubClassOf: bfo:0000015, sdg:meetingId some xsd:string, sdg:meetingDate some xsd:dateTime, sdg:facilitator some xsd:string, sdg:attendanceCount some xsd:integer, sdg:notesStatus some xsd:string, sdg:concernsRaised some xsd:integer, sdg:facilitatedBy exactly 1 sdg:AnimalControlOfficer, sdg:attends min 2 sdg:AnimalControlOfficer

Class: sdg:IncidentReport
    Annotations: rdfs:label "Incident Report", iao:0000115 "A formal record documenting an accident, injury, or emergency event involving staff or animals, used for administrative and safety tracking."
    SubClassOf: sdg:Report, sdg:reportId some xsd:string, sdg:reportDate some xsd:dateTime, sdg:reportType some sdg:ReportTypeKind, sdg:injuredParty some xsd:string, sdg:description some xsd:string, sdg:reviewStatus some sdg:ReviewStatusKind, sdg:incidentType some sdg:IncidentTypeKind, sdg:reportedDate some xsd:dateTime, sdg:reportStatus some sdg:ReportStatusKind, sdg:riskLevel some sdg:RiskLevelKind, sdg:investigatorId some xsd:string, sdg:resolutionOutcome some xsd:string, sdg:location some xsd:string, sdg:severity some sdg:SeverityKind, sdg:resolutionStatus some sdg:ResolutionStatusKind, sdg:citizenComplaintId some xsd:string, sdg:documents exactly 1 sdg:AnimalEmergency, sdg:completedBy exactly 1 sdg:AnimalControlOfficer, sdg:references max 1 sdg:SafetyMeeting, sdg:concerns min 2 sdg:Student, sdg:documents min 2 sdg:HarmType, sdg:initiatedBy exactly 1 sdg:StaffRole, sdg:investigatedBy exactly 1 sdg:AnimalServicesOfficer, sdg:involves some sdg:Animal, sdg:occursIn__escalated exactly 1 sdg:GeographicZone, sdg:leadsTo max 1 sdg:Citation

Class: sdg:Microenterprise
    Annotations: rdfs:label "Microenterprise", iao:0000115 "A small-scale industrial or commercial business entity operating within the Loom sub-sector that is the target of the RECP project interventions."
    SubClassOf: bfo:0000040, sdg:identifier some xsd:string, sdg:legalName some xsd:string, sdg:clusterLocation some xsd:string, sdg:sectorType some xsd:string, sdg:registrationDate some xsd:dateTime, sdg:isDemonstrationSite some xsd:boolean, sdg:participatesIn__escalated some sdg:ProjectActivity, sdg:adopts some sdg:RECPPractice

Class: sdg:RECPPractice
    Annotations: rdfs:label "Resource-Efficient Cleaner Production Practice", iao:0000115 "A specific climate-resilient, resource-efficient, or circular economy intervention adopted by microenterprises to improve green growth."
    SubClassOf: bfo:0000040, sdg:practiceCode some xsd:string, sdg:practiceName some xsd:string, sdg:category some sdg:CategoryKind, sdg:resourceEfficiencyGain some xsd:decimal, sdg:climateResilienceScore some xsd:integer, sdg:adoptionStatus some sdg:AdoptionStatusKind, sdg:implementedBy some sdg:Microenterprise
    HasKey: sdg:practiceCode

Class: sdg:ProjectActivity
    Annotations: rdfs:label "Project Activity", iao:0000115 "A scheduled intervention, event, or process executed under the SMART sub-project to promote RECP practices among microenterprises."
    SubClassOf: sdg:ProgramActivity, sdg:activityID some xsd:string, sdg:activityType some sdg:ActivityTypeKind, sdg:startDate some xsd:dateTime, sdg:endDate some xsd:dateTime, sdg:status some sdg:StatusKind, sdg:location some xsd:string, sdg:targets min 2 sdg:Microenterprise
    HasKey: sdg:activityID

Class: sdg:HuntingRate
    Annotations: rdfs:label "Daily Hunting Rate", iao:0000115 "A recorded daily fee for a specific hunting configuration or service."
    SubClassOf: cco:ont00000995, sdg:rateId some xsd:string, sdg:rateType some xsd:string, sdg:dailyFee some xsd:decimal, sdg:currency some xsd:string, sdg:validFrom some xsd:date, sdg:validTo some xsd:date, sdg:appliesTo some sdg:HuntingPackage

Class: sdg:HuntingPackage
    Annotations: rdfs:label "Hunting Service Package", iao:0000115 "A bundled offering of hunting services, accommodations, and logistics."
    SubClassOf: sdg:Entity, sdg:packageId some xsd:string, sdg:packageName some xsd:string, sdg:totalPrice some xsd:decimal, sdg:currency some xsd:string, sdg:durationNights some xsd:integer, sdg:durationDays some xsd:integer, sdg:status some sdg:StatusKind, sdg:includesService min 2 sdg:HuntingService, sdg:includesAccommodation exactly 1 sdg:Accommodation

Class: sdg:HuntingService
    Annotations: rdfs:label "Hunting Service Component", iao:0000115 "A discrete service component within a hunting package, such as shooting, transport, or staffing."
    SubClassOf: sdg:Entity, sdg:serviceId some xsd:string, sdg:serviceName some xsd:string, sdg:serviceType some sdg:ServiceTypeKind, sdg:unitPrice some xsd:decimal, sdg:unitType some sdg:UnitTypeKind, sdg:quantity some xsd:integer, sdg:partOfPackage exactly 1 sdg:HuntingPackage, sdg:requiresLicense some sdg:HuntingLicense

Class: sdg:HuntingLicense
    Annotations: rdfs:label "Government Hunting License", iao:0000115 "A mandatory government-issued permit required for legal hunting activities."
    SubClassOf: cco:ont00000995, sdg:licenseId some xsd:string, sdg:licenseType some xsd:string, sdg:issuingAuthorityDetail some xsd:string, sdg:feeAmount some xsd:decimal, sdg:issueDate some xsd:date, sdg:expiryDate some xsd:date, sdg:status some sdg:StatusKind, sdg:requiredBy min 2 sdg:HuntingService

Class: sdg:TrophyFee
    Annotations: rdfs:label "Trophy Scoring Surcharge", iao:0000115 "An additional charge applied for trophies that meet specific scoring criteria."
    SubClassOf: cco:ont00000995, sdg:feeId some xsd:string, sdg:scoringRange some sdg:ScoringRangeKind, sdg:surchargeAmount some xsd:decimal, sdg:currency some xsd:string, sdg:appliesToTrophy some xsd:string, sdg:appliesTo some sdg:HuntingService
    HasKey: sdg:feeId

Class: sdg:Accommodation
    Annotations: rdfs:label "Hunting Accommodation", iao:0000115 "Lodging facilities provided as part of the hunting experience."
    SubClassOf: cco:ont00000995, sdg:accommodationId some xsd:string, sdg:accommodationType some sdg:AccommodationTypeKind, sdg:location some xsd:string, sdg:nightsIncluded some xsd:integer, sdg:mealPlan some sdg:MealPlanKind, sdg:includedIn exactly 1 sdg:HuntingPackage

Class: sdg:BiodieselSpecification
    Annotations: rdfs:label "Biodiesel (B100) ASTM Specification", iao:0000115 "A formal document specifying the required physical and chemical properties for B100 biodiesel fuel."
    SubClassOf: sdg:Resource, sdg:specificationId some xsd:string, sdg:standardNumber some xsd:string, sdg:publicationYear some xsd:integer, sdg:grade some sdg:GradeKind, sdg:isCritical some xsd:boolean, sdg:hasProperty min 2 sdg:BiodieselProperty

Class: sdg:BiodieselProperty
    Annotations: rdfs:label "Biodiesel Fuel Property", iao:0000115 "A measurable characteristic of B100 biodiesel fuel defined by an ASTM test method."
    SubClassOf: cco:ont00000995, sdg:propertyName some xsd:string, sdg:astmMethodNumber some xsd:string, sdg:unitOfMeasure some sdg:UnitOfMeasureKind, sdg:isCritical some xsd:boolean, sdg:definedIn exactly 1 sdg:BiodieselSpecification, sdg:hasLimit min 2 sdg:PropertyLimit

Class: sdg:PropertyLimit
    Annotations: rdfs:label "Biodiesel Property Limit", iao:0000115 "A specific threshold value for a biodiesel property, associated with a fuel grade."
    SubClassOf: cco:ont00000995, sdg:limitValue some xsd:decimal, sdg:limitType some sdg:LimitTypeKind, sdg:grade some sdg:GradeKind, sdg:appliesToProperty exactly 1 sdg:BiodieselProperty

Class: sdg:BiodieselBlend
    Annotations: rdfs:label "Biodiesel Fuel Blend", iao:0000115 "A mixture of B100 biodiesel and petroleum diesel fuel."
    SubClassOf: cco:ont00000995, sdg:blendId some xsd:string, sdg:biodieselPercentage some xsd:decimal, sdg:petroleumDieselPercentage some xsd:decimal, sdg:blendDate some xsd:dateTime, sdg:status some sdg:StatusKind, sdg:containsComponent min 2 sdg:FuelComponent

Class: sdg:FuelComponent
    Annotations: rdfs:label "Fuel Component", iao:0000115 "A constituent material used in a biodiesel blend, either B100 or petroleum diesel."
    SubClassOf: cco:ont00000995, sdg:componentId some xsd:string, sdg:componentType some xsd:string, sdg:volume some xsd:decimal, sdg:batchId some xsd:string, sdg:isPartOfBlend exactly 1 sdg:BiodieselBlend, sdg:meetsSpecification max 1 sdg:BiodieselSpecification

Class: sdg:MESAProgram
    Annotations: rdfs:label "MESA Academic Support Program", iao:0000115 "A structured academic support and enrichment program designed to increase student success and transfer rates in math-based STEM degrees at community colleges."
    SubClassOf: sdg:Program, sdg:programId some xsd:string, sdg:programName some xsd:string, sdg:hostInstitution some xsd:string, sdg:locationBuilding some xsd:string, sdg:locationRoom some xsd:string, sdg:contactPhone some xsd:string, sdg:contactFax some xsd:string, sdg:transferRate some xsd:decimal, sdg:totalStudentsServed some xsd:integer, sdg:underrepresentedPercentage some xsd:decimal, sdg:targetPopulationDetail some sdg:TargetPopulationKind, sdg:serves min 2 sdg:StudentEnrollment, sdg:offers min 2 sdg:SupportService, sdg:defines min 2 sdg:MathBasedDegree

Class: sdg:StudentEnrollment
    Annotations: rdfs:label "Student Program Enrollment Record", iao:0000115 "A record of a specific student's participation in the MESA program, tracking their academic trajectory and demographic data."
    SubClassOf: sdg:EducationalEntity, sdg:enrollmentId some xsd:string, sdg:studentId some xsd:string, sdg:major some xsd:string, sdg:ethnicity some xsd:string, sdg:transferStatus some xsd:string, sdg:targetUniversity some xsd:string, sdg:enrollmentDate some xsd:date, sdg:graduationDate some xsd:date, sdg:participatesIn__escalated exactly 1 sdg:MESAProgram, sdg:enrolledIn min 2 sdg:Course, sdg:transferredTo max 1 sdg:FourYearUniversity, sdg:programAffiliation some sdg:MESAProgram

Class: sdg:SupportService
    Annotations: rdfs:label "MESA Support Service", iao:0000115 "A specific academic, professional, or social service activity provided to MESA students to enhance their educational experience."
    SubClassOf: sdg:serviceId some xsd:string, sdg:serviceName some xsd:string, sdg:serviceType some sdg:ServiceTypeKind, sdg:description some xsd:string, sdg:frequency some sdg:FrequencyKind, sdg:isMandatory some xsd:boolean, sdg:providerName some xsd:string, sdg:startDate some xsd:dateTime, sdg:endDate some xsd:dateTime, sdg:status some sdg:StatusKind, sdg:providedBy exactly 1 sdg:MESAProgram, sdg:attendedBy min 2 sdg:StudentEnrollment, sdg:providedTo min 1 sdg:Student, sdg:facilitatedBy exactly 1 sdg:StaffMember, sdg:relatedToIncident max 1 sdg:BullyingIncident

Class: sdg:MathBasedDegree
    Annotations: rdfs:label "Math-Based Degree Definition", iao:0000115 "A classification of academic degrees that require a specific sequence of advanced mathematics or science courses."
    SubClassOf: cco:ont00000958, sdg:degreeName some xsd:string, sdg:requiresConsecutiveMath some xsd:boolean, sdg:requiresPhysicsOrChemOrBio some xsd:boolean, sdg:targetInstitution some xsd:string, sdg:requires min 2 sdg:Course, sdg:pursuedBy min 2 sdg:StudentEnrollment

Class: sdg:FourYearUniversity
    Annotations: rdfs:label "Target Transfer University", iao:0000115 "A four-year institution where MESA students transfer to complete their bachelor's degrees."
    SubClassOf: bfo:0000015, sdg:universityName some xsd:string, sdg:acceptsTransfer some xsd:boolean, sdg:location some xsd:string, sdg:receives min 2 sdg:StudentEnrollment

Class: sdg:ImmigrationStatusDeclaration
    Annotations: rdfs:label "Immigration Status Declaration", iao:0000115 "A formal record certifying the lawful presence or citizenship status of a housing applicant or household member."
    SubClassOf: sdg:Document, sdg:declarationId some xsd:string, sdg:declarationDate some xsd:date, sdg:revisionDate some xsd:date, sdg:formVersion some xsd:string, sdg:certificationStatus some sdg:CertificationStatusKind, sdg:perjuryAcknowledged some xsd:boolean, sdg:status some sdg:StatusKind, sdg:submittedBy exactly 1 sdg:HouseholdMember, sdg:coversMinor some sdg:MinorDependent

Class: sdg:HouseholdMember
    Annotations: rdfs:label "Household Member", iao:0000115 "An adult individual who is part of a housing household, serving as either the head or a non-head member."
    SubClassOf: bfo:0000004, sdg:memberId some xsd:string, sdg:fullName some xsd:string, sdg:ssn some xsd:string, sdg:roleDetail some sdg:RoleKind, sdg:age some xsd:integer, sdg:isSenior some xsd:boolean, sdg:declaresStatusIn exactly 1 sdg:ImmigrationStatusDeclaration, sdg:residesIn max 1 sdg:HousingUnit

Class: sdg:MinorDependent
    Annotations: rdfs:label "Minor Dependent", iao:0000115 "A child or dependent under the age of majority residing in the household whose immigration status is declared by an adult."
    SubClassOf: bfo:0000004, sdg:minorId some xsd:string, sdg:fullName some xsd:string, sdg:age some xsd:integer, sdg:citizenshipStatus some xsd:string, sdg:declaredIn some sdg:ImmigrationStatusDeclaration, sdg:verifiedBy exactly 1 sdg:LeasingOfficer

Class: sdg:ImmigrationDocument
    Annotations: rdfs:label "Immigration Document", iao:0000115 "A physical or digital record issued by U.S. immigration authorities (e.g., INS/USCIS) verifying legal status."
    SubClassOf: sdg:Document, sdg:documentId some xsd:string, sdg:formCode some xsd:string, sdg:issuingAgency some xsd:string, sdg:annotation some xsd:string, sdg:issueDate some xsd:date, sdg:expiryDate some xsd:date, sdg:documentType some sdg:DocumentTypeKind, sdg:supportsDeclaration some sdg:ImmigrationStatusDeclaration, sdg:attachedTo exactly 1 sdg:VerificationConsentForm

Class: sdg:VerificationConsentForm
    Annotations: rdfs:label "Verification Consent Form", iao:0000115 "A signed authorization allowing the housing authority to verify the applicant's immigration status with federal agencies."
    SubClassOf: cco:ont00000958, sdg:consentId some xsd:string, sdg:signedDate some xsd:dateTime, sdg:isSigned some xsd:boolean, sdg:verificationMethod some sdg:VerificationMethodKind, sdg:linkedToDeclaration exactly 1 sdg:ImmigrationStatusDeclaration, sdg:signedBy exactly 1 sdg:HouseholdMember

Class: sdg:LeasingOfficer
    Annotations: rdfs:label "Leasing Officer", iao:0000115 "A housing authority employee responsible for processing applications and verifying immigration documentation."
    SubClassOf: bfo:0000004, sdg:officerId some xsd:string, sdg:fullName some xsd:string, sdg:employeeId some xsd:string, sdg:department some xsd:string, sdg:verifiesDeclaration some sdg:ImmigrationStatusDeclaration, sdg:verifiesMinor some sdg:MinorDependent

Class: sdg:ApprovedProduct
    Annotations: rdfs:label "Approved Product", iao:0000115 "A manufactured item that has been formally evaluated and granted approval status against a specific standard."
    SubClassOf: cco:ont00000995, sdg:productIdentifier some xsd:string, sdg:productName some xsd:string, sdg:nominalSizeRange some xsd:string, sdg:serviceCondition some xsd:string, sdg:materialType some sdg:MaterialTypeKind, sdg:approvalStatus some sdg:ApprovalStatusKind, sdg:conformsTo exactly 1 sdg:ApprovalStandard, sdg:grantedBy exactly 1 sdg:ApprovingAuthority, sdg:manufacturedBy exactly 1 sdg:Manufacturer

Class: sdg:ApprovalStandard
    Annotations: rdfs:label "Approval Standard", iao:0000115 "A formal document or specification that defines the requirements and criteria for product approval."
    SubClassOf: cco:ont00000958, sdg:standardCode some xsd:string, sdg:standardTitle some xsd:string, sdg:publicationDate some xsd:date, sdg:issuingOrganizationDetail some xsd:string, sdg:versionNumber some xsd:string, sdg:supersedes max 1 sdg:ApprovalStandard, sdg:isSupersededBy max 1 sdg:ApprovalStandard

Class: sdg:ApprovingAuthority
    Annotations: rdfs:label "Approving Authority", iao:0000115 "An organization or individual with the formal mandate to evaluate and grant approval status to products."
    SubClassOf: bfo:0000023, sdg:authorityName some xsd:string, sdg:authorityType some xsd:string, sdg:jurisdiction some sdg:JurisdictionKind, sdg:contactAddress some xsd:string, sdg:authorizationLevel some sdg:AuthorizationLevelKind, sdg:issuesApprovalFor min 2 sdg:ApprovedProduct, sdg:enforcesStandard min 2 sdg:ApprovalStandard

Class: sdg:SurveillanceAudit
    Annotations: rdfs:label "Surveillance Audit", iao:0000115 "A periodic evaluation process conducted to verify ongoing conformity of the approved product to the standard."
    SubClassOf: sdg:Report, sdg:auditIdentifier some xsd:string, sdg:auditDate some xsd:dateTime, sdg:auditOutcome some xsd:string, sdg:auditorName some xsd:string, sdg:findingsCount some xsd:integer, sdg:nextAuditDue some xsd:date, sdg:evaluates exactly 1 sdg:ApprovedProduct, sdg:conductedBy exactly 1 sdg:ApprovingAuthority, sdg:verifiesConformityTo exactly 1 sdg:ApprovalStandard

Class: sdg:Textbook
    Annotations: rdfs:label "Educational Textbook", iao:0000115 "A published educational resource containing mathematical concepts, applications, and problem-solving processes."
    SubClassOf: sdg:Book, sdg:isbn10 some xsd:string, sdg:isbn13 some xsd:string, sdg:title some xsd:string, sdg:edition some xsd:string, sdg:publicationDate some xsd:date, sdg:publisher some xsd:string, sdg:price some xsd:decimal, sdg:instructionalPurpose some xsd:string, sdg:isbn some xsd:string, sdg:author some xsd:string, sdg:publicationYear some xsd:integer, sdg:subject some xsd:string, sdg:gradeLevel some xsd:integer, sdg:partIdentifier some xsd:string, sdg:coversConcept min 3 sdg:MathematicalConcept, sdg:usedInCourse some sdg:Course, sdg:supplements min 1 sdg:LectureSession, sdg:assignedTo exactly 1 sdg:GradeLevel, sdg:publishedBy exactly 1 sdg:Publisher

Class: sdg:ProblemSolvingProcess
    Annotations: rdfs:label "Problem Solving Process", iao:0000115 "A structured five-step method for approaching and solving mathematical problems."
    SubClassOf: bfo:0000040, sdg:processId some xsd:string, sdg:stepNumber some xsd:integer, sdg:stepDescription some xsd:string, sdg:isMandatory some xsd:boolean, sdg:partOf__escalated exactly 1 sdg:Course, sdg:appliesToConcept some sdg:MathematicalConcept

Class: sdg:DataSubject
    Annotations: rdfs:label "Data Subject", iao:0000115 "An identified or identifiable natural person whose personal data is processed by the controller."
    SubClassOf: sdg:DataEntity, sdg:subjectIdentifier some xsd:string, sdg:givenName some xsd:string, sdg:familyName some xsd:string, sdg:emailAddress some xsd:string, sdg:ipAddress some xsd:string, sdg:cookieId some xsd:string, sdg:consentGiven some xsd:boolean, sdg:contactMethod some sdg:ContactMethodKind, sdg:hasDataProcessingRecord min 2 sdg:DataProcessingRecord, sdg:hasConsentRecord min 2 sdg:ConsentRecord, sdg:providesDataTo some sdg:DataController, sdg:hasDataProcessedBy some sdg:DataProcessor

Class: sdg:DataController
    Annotations: rdfs:label "Data Controller", iao:0000115 "A natural person or legal entity that determines the purposes and means of the processing of personal data."
    SubClassOf: bfo:0000040, sdg:legalName some xsd:string, sdg:registrationNumber some xsd:string, sdg:registeredOffice some xsd:string, sdg:courtRegistry some xsd:string, sdg:websiteUrl some xsd:string, sdg:registeredAddress some xsd:string, sdg:contactEmail some xsd:string, sdg:jurisdiction some sdg:JurisdictionKind, sdg:processesDataFor min 2 sdg:DataProcessingRecord, sdg:grantsConsentOnBehalfOf min 2 sdg:ConsentRecord, sdg:employs some sdg:DataProcessor, sdg:designates exactly 1 sdg:PrivacyRepresentative

Class: sdg:DataProcessingRecord
    Annotations: rdfs:label "Data Processing Record", iao:0000115 "A specific operation or set of operations performed on personal data, such as collection, storage, or transmission."
    SubClassOf: bfo:0000015, sdg:processingPurpose some sdg:ProcessingPurposeKind, sdg:legalGround some xsd:string, sdg:dataExtent some sdg:DataExtentKind, sdg:processingPeriodStart some xsd:dateTime, sdg:processingPeriodEnd some xsd:dateTime, sdg:isObjectionAllowed some xsd:boolean, sdg:performedBy exactly 1 sdg:DataController, sdg:affectsDataSubject min 2 sdg:DataSubject, sdg:usesDataChannel min 2 sdg:CommunicationChannel

Class: sdg:CommunicationChannel
    Annotations: rdfs:label "Communication Channel", iao:0000115 "A medium through which personal data is collected or communicated, such as a website, email, or social network."
    SubClassOf: sdg:channelType some sdg:ChannelTypeKind, sdg:url some xsd:string, sdg:isActive some xsd:boolean, sdg:usedInProcessing min 2 sdg:DataProcessingRecord

Class: sdg:BusinessPartner
    Annotations: rdfs:label "Business Partner", iao:0000115 "An external entity with which the controller shares personal data for the purpose of providing customized offers."
    SubClassOf: sdg:BusinessEntity, sdg:partnerName some xsd:string, sdg:partnerType some sdg:PartnerTypeKind, sdg:dataSharingAgreementId some xsd:string, sdg:receivesDataFrom exactly 1 sdg:DataController, sdg:providesOffersTo min 2 sdg:DataSubject

Class: sdg:LateralRestraintStrap
    Annotations: rdfs:label "Lateral Restraint Strap", iao:0000115 "A manufactured metal strap used to provide lateral restraint between concrete floors and masonry walls, featuring one or two turn-down ends for anchoring."
    SubClassOf: cco:ont00000995, sdg:strapIdentifier some xsd:string, sdg:minimumLength some xsd:decimal, sdg:gauge some xsd:integer, sdg:material some xsd:string, sdg:turnDownConfiguration some xsd:string, sdg:maxSpacingAlongWall some xsd:decimal, sdg:restrains some sdg:MasonryWall, sdg:anchoredTo exactly 1 sdg:FloorAssembly, sdg:fixedBy exactly 1 sdg:FixingMethod

Class: sdg:MasonryWall
    Annotations: rdfs:label "Masonry Wall", iao:0000115 "A structural wall constructed from masonry units such as concrete blocks or bricks, serving as the restrained element in lateral restraint systems."
    SubClassOf: bfo:0000040, sdg:wallIdentifier some xsd:string, sdg:wallHeight some xsd:decimal, sdg:wallType some xsd:string, sdg:masonryUnitType some xsd:string, sdg:structuralRole some xsd:string, sdg:restrainedBy some sdg:LateralRestraintStrap, sdg:adjacentTo exactly 1 sdg:FloorAssembly

Class: sdg:FloorAssembly
    Annotations: rdfs:label "Floor Assembly", iao:0000115 "A constructed floor system, such as beam and block or precast/pre-stressed concrete planks, into which lateral restraint straps are anchored."
    SubClassOf: sdg:System, sdg:assemblyIdentifier some xsd:string, sdg:assemblyType some xsd:string, sdg:infillMaterial some xsd:string, sdg:toleranceLevel some xsd:string, sdg:floorHeight some xsd:decimal, sdg:anchors some sdg:LateralRestraintStrap, sdg:supports some sdg:MasonryWall

Class: sdg:FixingMethod
    Annotations: rdfs:label "Fixing Method", iao:0000115 "A prescribed procedure for securing lateral restraint straps to floor assemblies using screws and plastic plugs, specified by material type and spacing."
    SubClassOf: bfo:0000015, sdg:methodIdentifier some xsd:string, sdg:screwLength some xsd:decimal, sdg:screwGauge some xsd:integer, sdg:plugType some xsd:string, sdg:screwSpacing some xsd:decimal, sdg:minScrewsPerStrap some xsd:integer, sdg:appliesToMaterial some xsd:string, sdg:secures some sdg:LateralRestraintStrap, sdg:appliesTo exactly 1 sdg:FloorAssembly

Class: sdg:LicenseApplication
    Annotations: rdfs:label "License Application", iao:0000115 "A formal request submitted by a Service Provider to the Bank of Guyana for authorization to operate within the Payment System."
    SubClassOf: sdg:Document, sdg:applicationId some xsd:string, sdg:submissionDate some xsd:dateTime, sdg:status some sdg:StatusKind, sdg:regulatoryReference some xsd:string, sdg:submittedBy exactly 1 sdg:ServiceProvider, sdg:evaluatedBy exactly 1 sdg:RegulatoryAuthority, sdg:requiresFee exactly 1 sdg:FeeSchedule
    HasKey: sdg:applicationId

Class: sdg:ServiceProvider
    Annotations: rdfs:label "Service Provider", iao:0000115 "A legal entity or organization applying for and holding a license to operate as a business within the Payment System."
    SubClassOf: cco:ont00000995, sdg:legalName some xsd:string, sdg:incorporationDate some xsd:date, sdg:shareholdingStructure some xsd:string, sdg:complianceStatus some sdg:ComplianceStatusKind, sdg:submits min 1 sdg:LicenseApplication, sdg:maintains exactly 1 sdg:CustodianAccount

Class: sdg:FeeSchedule
    Annotations: rdfs:label "Fee Schedule", iao:0000115 "A structured set of monetary requirements including application, license, renewal, and capital deposit fees mandated by the regulatory framework."
    SubClassOf: cco:ont00000958, sdg:applicationFee some xsd:decimal, sdg:initialLicenseFee some xsd:decimal, sdg:annualRenewalFee some xsd:decimal, sdg:currency some xsd:string, sdg:appliesTo min 1 sdg:LicenseApplication, sdg:mandatedBy exactly 1 sdg:RegulatoryAuthority

Class: sdg:CustodianAccount
    Annotations: rdfs:label "Custodian Account", iao:0000115 "A financial account held and managed by a Commercial Bank to ensure customer funds are ring-fenced from the Service Provider's operational funds."
    SubClassOf: cco:ont00000995, sdg:accountNumber some xsd:string, sdg:minimumCapitalRequirement some xsd:decimal, sdg:assetLiquidityStatus some xsd:boolean, sdg:bankIdentifier some xsd:string, sdg:belongsTo exactly 1 sdg:ServiceProvider

Class: sdg:RegulatoryAuthority
    Annotations: rdfs:label "Regulatory Authority", iao:0000115 "The central banking institution responsible for overseeing the Payment System, issuing licenses, and enforcing compliance with the National Payments Act."
    SubClassOf: sdg:Authority, sdg:authorityName some xsd:string, sdg:websiteUrl some xsd:string, sdg:effectiveDate some xsd:date, sdg:oversightScope some xsd:string, sdg:regulatoryScope some xsd:string, sdg:authorityId some xsd:string, sdg:jurisdiction some sdg:JurisdictionKind, sdg:regulationCode some xsd:string, sdg:bulletinName some xsd:string, sdg:issues min 1 sdg:LicenseApplication, sdg:enforces min 1 sdg:ComplianceRequirement, sdg:receivesReport some sdg:FinancialReport, sdg:oversees exactly 1 sdg:Company

Class: sdg:ComplianceRequirement
    Annotations: rdfs:label "Compliance Requirement", iao:0000115 "A specific operational, financial, or legal obligation that a Service Provider must fulfill to maintain their license and operate within the Payment System."
    SubClassOf: sdg:requirementId some xsd:string, sdg:category some sdg:CategoryKind, sdg:legalReference some xsd:string, sdg:isMandatory some xsd:boolean, sdg:complianceDomain some xsd:string, sdg:appliesTo min 1 sdg:ServiceProvider, sdg:enforcedBy exactly 1 sdg:RegulatoryAuthority

Class: sdg:Shareholder
    Annotations: rdfs:label "Shareholder", iao:0000115 "A natural or legal person holding equity securities in the Industrial Holding Bulgaria PLC."
    SubClassOf: cco:ont00000995, sdg:shareholderId some xsd:string, sdg:name some sdg:NameKind, sdg:type some sdg:TypeKind, sdg:registrationDate some xsd:dateTime, sdg:contactEmail some xsd:string, sdg:shareCount some xsd:integer, sdg:identifier some xsd:string, sdg:legalName some xsd:string, sdg:shareholderType some xsd:string, sdg:isProxyHolder some xsd:boolean, sdg:shareholderName some xsd:string, sdg:ownershipPercentage some xsd:decimal, sdg:isForeignOwner some xsd:boolean, sdg:holdsSecuritiesIn exactly 1 sdg:Company, sdg:participatedInMeeting some sdg:GeneralMeeting, sdg:holds some sdg:Share, sdg:representedAt some sdg:AnnualGeneralMeeting, sdg:holdsSharesIn exactly 1 sdg:ShareCapital, sdg:nominatedBy max 1 sdg:NominationCommittee

Class: sdg:Company
    Annotations: rdfs:label "Company", iao:0000115 "The Industrial Holding Bulgaria PLC, a public limited company subject to capital markets regulation."
    SubClassOf: cco:ont00000995, sdg:companyId some xsd:string, sdg:legalName some xsd:string, sdg:registrationNumber some xsd:string, sdg:listingStatus some sdg:ListingStatusKind, sdg:fiscalYear some xsd:integer, sdg:governanceCode some xsd:string, sdg:name some sdg:NameKind, sdg:type some sdg:TypeKind, sdg:headquarters some xsd:string, sdg:ownershipStructure some xsd:string, sdg:companyName some xsd:string, sdg:foundingYear some xsd:integer, sdg:shareholderCount some xsd:integer, sdg:employeeCount some xsd:integer, sdg:filesReport min 2 sdg:FinancialReport, sdg:holdsMeeting min 1 sdg:GeneralMeeting, sdg:employsDirector exactly 1 sdg:InvestorRelationsDirector, sdg:initiatesDivestment min 2 sdg:AssetDivestment, sdg:receivesDivestment min 2 sdg:AssetDivestment, sdg:owns min 2 sdg:ForestPlantation, sdg:operates min 2 sdg:IndustrialFacility, sdg:generates some sdg:CarbonCredit

Class: sdg:FinancialReport
    Annotations: rdfs:label "Financial Report", iao:0000115 "A statutory document presenting the financial position and management activities of the company for a specific period."
    SubClassOf: sdg:reportId some xsd:string, sdg:reportType some sdg:ReportTypeKind, sdg:issuanceDate some xsd:date, sdg:fiscalPeriod some xsd:string, sdg:consolidationStatus some xsd:string, sdg:publicationUrl some xsd:string, sdg:auditorName some xsd:string, sdg:fiscalYear some xsd:integer, sdg:reportingPeriodStart some xsd:date, sdg:reportingPeriodEnd some xsd:date, sdg:status some sdg:StatusKind, sdg:preparedByStaffId some xsd:string, sdg:filedBy exactly 1 sdg:Company, sdg:disclosedTo some sdg:RegulatoryAuthority, sdg:covers some sdg:WasteProcessingFacility, sdg:preparedBy exactly 1 sdg:FinancialStaff

Class: sdg:GeneralMeeting
    Annotations: rdfs:label "General Meeting of Shareholders", iao:0000115 "A formal assembly of shareholders convened to vote on corporate governance matters and approve financial statements."
    SubClassOf: bfo:0000015, sdg:meetingId some xsd:string, sdg:meetingDate some xsd:dateTime, sdg:meetingType some sdg:MeetingTypeKind, sdg:quorumMet some xsd:boolean, sdg:agendaItems some xsd:string, sdg:minuteUrl some xsd:string, sdg:convenedBy exactly 1 sdg:Company, sdg:attendedBy min 2 sdg:Shareholder, sdg:approvesReport some sdg:FinancialReport

Class: sdg:InvestorRelationsDirector
    Annotations: rdfs:label "Investor Relations Director", iao:0000115 "A role played by an individual responsible for managing communication between the company and its investors."
    SubClassOf: bfo:0000023, sdg:directorId some xsd:string, sdg:appointmentYear some xsd:integer, sdg:reportingPeriod some xsd:date, sdg:complianceStatus some sdg:ComplianceStatusKind, sdg:servesIn exactly 1 sdg:Company, sdg:managesCommunication some sdg:Shareholder

Class: sdg:ClientRecord
    Annotations: rdfs:label "Client Record", iao:0000115 "A structured record containing personal and health information collected about a client for service provision and compliance."
    SubClassOf: sdg:Record, sdg:clientIdentifier some xsd:string, sdg:fullName some xsd:string, sdg:dateOfBirth some xsd:date, sdg:homeAddress some xsd:string, sdg:phoneNumber some xsd:string, sdg:emailAddress some xsd:string, sdg:healthHistorySummary some xsd:string, sdg:emergencyContactName some xsd:string, sdg:emergencyContactPhone some xsd:string, sdg:primaryDomain some xsd:string, sdg:hasRecord exactly 1 sdg:ClientRecord, sdg:receivesService some sdg:ServiceDelivery, sdg:providesConsent some sdg:ConsentRecord
    HasKey: sdg:phoneNumber

Class: sdg:ServiceDelivery
    Annotations: rdfs:label "Service Delivery", iao:0000115 "A process or activity through which personal care, transportation, counseling, or other support services are provided to a client."
    SubClassOf: bfo:0000015, sdg:serviceType some sdg:ServiceTypeKind, sdg:deliveryDate some xsd:dateTime, sdg:serviceStatus some sdg:ServiceStatusKind, sdg:providerStaffId some xsd:string, sdg:interactionNotes some xsd:string, sdg:deliveryId some xsd:string, sdg:startDate some xsd:dateTime, sdg:endDate some xsd:dateTime, sdg:providerType some xsd:string, sdg:qualityRating some sdg:QualityRatingKind, sdg:deliveredTo exactly 1 sdg:ClientRecord, sdg:performedBy exactly 1 sdg:StaffRecord, sdg:serves exactly 1 sdg:FamilyUnit, sdg:fulfillsNeedFrom exactly 1 sdg:NeedsAssessment

Class: sdg:StaffRecord
    Annotations: rdfs:label "Staff Record", iao:0000115 "A structured record containing personal, employment, and credential information for CCS employees."
    SubClassOf: cco:ont00000995, sdg:staffIdentifier some xsd:string, sdg:fullName some xsd:string, sdg:homeAddress some xsd:string, sdg:dateOfBirth some xsd:date, sdg:socialInsuranceNumber some xsd:string, sdg:bankAccountNumber some xsd:string, sdg:employmentStatus some sdg:EmploymentStatusKind, sdg:performanceRating some xsd:decimal, sdg:performsService some sdg:ServiceDelivery, sdg:holdsRole exactly 1 sdg:StaffRole

Class: sdg:DonorRecord
    Annotations: rdfs:label "Donor Record", iao:0000115 "A structured record containing personal information of individuals who have made donations to CCS."
    SubClassOf: sdg:Record, sdg:donorIdentifier some xsd:string, sdg:fullName some xsd:string, sdg:homeAddress some xsd:string, sdg:emailAddress some xsd:string, sdg:totalDonationAmount some xsd:decimal, sdg:taxReceiptIssued some xsd:boolean, sdg:makesDonation some sdg:DonationTransaction

Class: sdg:DonationTransaction
    Annotations: rdfs:label "Donation Transaction", iao:0000115 "A financial process representing the collection and processing of a donation from a donor."
    SubClassOf: bfo:0000015, sdg:transactionId some xsd:string, sdg:transactionDate some xsd:dateTime, sdg:amount some xsd:decimal, sdg:paymentMethod some sdg:PaymentMethodKind, sdg:taxReceiptNumber some xsd:string, sdg:fromDonor exactly 1 sdg:DonorRecord, sdg:processedBy exactly 1 sdg:StaffRecord

Class: sdg:ProtectedDisclosure
    Annotations: rdfs:label "Protected Disclosure", iao:0000115 "A report, communication, or disclosure made in good faith that evidences suspected improper conduct for the purpose of correction or during an investigation."
    SubClassOf: cco:ont00000995, sdg:disclosureId some xsd:string, sdg:disclosureDate some xsd:dateTime, sdg:disclosureMethod some xsd:string, sdg:isGoodFaith some xsd:boolean, sdg:contentSummary some xsd:string, sdg:status some sdg:StatusKind, sdg:subjectMatter some sdg:SubjectMatterKind, sdg:retaliationStatus some sdg:RetaliationStatusKind, sdg:reportedBy exactly 1 sdg:Whistleblower, sdg:allegesImproperConduct some sdg:ImproperConduct, sdg:triggersInvestigation max 1 sdg:Investigation, sdg:investigatedBy some sdg:Investigation

Class: sdg:Whistleblower
    Annotations: rdfs:label "Whistleblower", iao:0000115 "A person who makes a protected disclosure of suspected improper conduct in good faith."
    SubClassOf: bfo:0000004, sdg:whistleblowerId some xsd:string, sdg:roleDetail some sdg:RoleKind, sdg:campusAffiliation some xsd:string, sdg:isProtectedFromRetaliation some xsd:boolean, sdg:contactEmail some xsd:string, sdg:contactPhone some xsd:string, sdg:personId some xsd:string, sdg:protectionStatus some xsd:string, sdg:makesDisclosure some sdg:ProtectedDisclosure, sdg:affiliatedWith exactly 1 sdg:CollegeCampus, sdg:madeDisclosure some sdg:ProtectedDisclosure

Class: sdg:ImproperConduct
    Annotations: rdfs:label "Improper Conduct", iao:0000115 "Any action or activity that violates laws, misuses college resources, is economically wasteful, threatens safety, constitutes scientific misconduct, or is otherwise detrimental to the college."
    SubClassOf: bfo:0000015, sdg:conductId some xsd:string, sdg:conductType some xsd:string, sdg:description some xsd:string, sdg:occurrenceDate some xsd:date, sdg:severityLevel some sdg:SeverityLevelKind, sdg:isCriminal some xsd:boolean, sdg:conductDate some xsd:dateTime, sdg:isAllegedIn some sdg:ProtectedDisclosure, sdg:involvesSubject some sdg:InvestigationSubject, sdg:occursAt exactly 1 sdg:CollegeCampus, sdg:reportedIn some sdg:ProtectedDisclosure, sdg:subjectOfInvestigation some sdg:Investigation

Class: sdg:Investigation
    Annotations: rdfs:label "Investigation", iao:0000115 "A fact-finding and analysis process conducted by authorized personnel to examine allegations of improper conduct."
    SubClassOf: bfo:0000015, sdg:investigationId some xsd:string, sdg:startDate some xsd:dateTime, sdg:endDate some xsd:dateTime, sdg:status some sdg:StatusKind, sdg:findingsSummary some xsd:string, sdg:correctiveActionTaken some xsd:boolean, sdg:caseNumber some xsd:string, sdg:leadInvestigator some xsd:string, sdg:investigates exactly 1 sdg:ImproperConduct, sdg:conductedBy min 2 sdg:Investigator, sdg:focusesOnSubject some sdg:InvestigationSubject, sdg:resultsFrom exactly 1 sdg:ProtectedDisclosure, sdg:hasSubject some sdg:SocialMediaPost, sdg:approvedBy exactly 1 sdg:PersonnelRole, sdg:subjectTo some sdg:PolicyDocument, sdg:initiatedBy exactly 1 sdg:ProtectedDisclosure, sdg:examinesConduct some sdg:ImproperConduct

Class: sdg:Investigator
    Annotations: rdfs:label "Investigator", iao:0000115 "A person authorized by the college to conduct fact-finding and analysis of allegations of improper conduct."
    SubClassOf: bfo:0000004, sdg:investigatorId some xsd:string, sdg:roleDetail some sdg:RoleKind, sdg:department some xsd:string, sdg:isAuthorized some xsd:boolean, sdg:contactEmail some xsd:string, sdg:personId some xsd:string, sdg:assignedCampus some sdg:AssignedCampusKind, sdg:authorizationDate some xsd:dateTime, sdg:currentCaseLoad some xsd:integer, sdg:conductsInvestigation some sdg:Investigation, sdg:employedBy exactly 1 sdg:CollegeCampus

Class: sdg:InvestigationSubject
    Annotations: rdfs:label "Investigation Subject", iao:0000115 "A person who is the focus of an investigation into alleged improper conduct."
    SubClassOf: bfo:0000004, sdg:subjectId some xsd:string, sdg:roleDetail some sdg:RoleKind, sdg:campusAffiliation some xsd:string, sdg:isSubjectOfRetaliation some xsd:boolean, sdg:contactEmail some xsd:string, sdg:isSubjectOf exactly 1 sdg:Investigation, sdg:affiliatedWith exactly 1 sdg:CollegeCampus
    HasKey: sdg:subjectId

Class: sdg:CollegeCampus
    Annotations: rdfs:label "College Campus", iao:0000115 "A physical or administrative location of the Palmer College of Chiropractic, including Davenport, West, and Florida campuses."
    SubClassOf: bfo:0000004, sdg:campusId some xsd:string, sdg:campusName some xsd:string, sdg:legalEntity some xsd:string, sdg:address some xsd:string, sdg:isActive some xsd:boolean, sdg:hostsInvestigation some sdg:Investigation, sdg:employsInvestigator some sdg:Investigator, sdg:affiliatesWhistleblower some sdg:Whistleblower, sdg:affiliatesSubject some sdg:InvestigationSubject

Class: sdg:InterviewQuestion
    Annotations: rdfs:label "Interview Question", iao:0000115 "A specific query posed by an interviewer to assess a candidate's qualifications, competencies, or fit for a role."
    SubClassOf: cco:ont00000995, sdg:questionId some xsd:string, sdg:questionText some xsd:string, sdg:category some sdg:CategoryKind, sdg:isPanelQuestion some xsd:boolean, sdg:isBehavioral some xsd:boolean, sdg:priorityLevel some sdg:PriorityLevelKind, sdg:assessesCompetencyOf some sdg:JobRole, sdg:usedInInterviewFor some sdg:HiringProcess, sdg:hasExampleAnswer some sdg:CandidateResponse

Class: sdg:JobRole
    Annotations: rdfs:label "Job Role", iao:0000115 "A specific position or title within an organization that defines responsibilities and required skills."
    SubClassOf: sdg:Role, sdg:roleCode some xsd:string, sdg:roleTitle some sdg:RoleTitleKind, sdg:department some xsd:string, sdg:level some sdg:LevelKind, sdg:isLeadershipRole some xsd:boolean, sdg:requiredSkills some xsd:string, sdg:roleLevel some sdg:RoleLevelKind, sdg:roleId some xsd:string, sdg:title some xsd:string, sdg:isLeadership some xsd:boolean, sdg:minQualifications some xsd:string, sdg:salaryRange some xsd:string, sdg:hasInterviewQuestions min 2 sdg:InterviewQuestion, sdg:requiresCompetencies min 2 sdg:Competency, sdg:isPartOfOrganization exactly 1 sdg:Organization, sdg:filledBy min 1 sdg:Employee, sdg:belongsToMany some sdg:Department

Class: sdg:HiringProcess
    Annotations: rdfs:label "Hiring Process", iao:0000115 "The structured activity or workflow through which an organization evaluates and selects candidates for a job role."
    SubClassOf: bfo:0000015, sdg:processId some xsd:string, sdg:startDate some xsd:dateTime, sdg:endDate some xsd:dateTime, sdg:status some sdg:StatusKind, sdg:interviewFormat some sdg:InterviewFormatKind, sdg:totalCandidates some xsd:integer, sdg:evaluatesCandidatesFor exactly 1 sdg:JobRole, sdg:usesInterviewQuestions min 2 sdg:InterviewQuestion, sdg:involvesInterviewers min 2 sdg:Interviewer

Class: sdg:CandidateResponse
    Annotations: rdfs:label "Candidate Response", iao:0000115 "A recorded answer or behavioral example provided by a job candidate in response to an interview question."
    SubClassOf: cco:ont00000995, sdg:responseId some xsd:string, sdg:responseText some xsd:string, sdg:usesSTARMethod some xsd:boolean, sdg:competencyDemonstrated some xsd:string, sdg:ratingScore some xsd:decimal, sdg:submittedAt some xsd:dateTime, sdg:answersQuestion exactly 1 sdg:InterviewQuestion, sdg:evaluatedInProcess exactly 1 sdg:HiringProcess

Class: sdg:Competency
    Annotations: rdfs:label "Competency", iao:0000115 "A measurable pattern of knowledge, skills, abilities, behaviors, and other characteristics that contribute to job performance."
    SubClassOf: bfo:0000015, sdg:competencyId some xsd:string, sdg:competencyName some xsd:string, sdg:category some sdg:CategoryKind, sdg:proficiencyLevel some sdg:ProficiencyLevelKind, sdg:assessmentCriteria some xsd:string, sdg:competencyID some xsd:string, sdg:competencyTitle some xsd:string, sdg:competencyDescription some xsd:string, sdg:assessmentType some xsd:string, sdg:assessedByQuestions min 2 sdg:InterviewQuestion, sdg:requiredForRole min 2 sdg:JobRole, sdg:demonstratedByResponses min 2 sdg:CandidateResponse, sdg:requiredByProgram exactly 1 sdg:AcademicProgram, sdg:supportsRole some sdg:ProfessionalRole, sdg:demonstratedInActivity some sdg:ResearchActivity

Class: sdg:Interviewer
    Annotations: rdfs:label "Interviewer", iao:0000115 "An individual who conducts interviews to evaluate candidates for a specific job role."
    SubClassOf: bfo:0000023, sdg:interviewerId some xsd:string, sdg:interviewerName some xsd:string, sdg:department some xsd:string, sdg:roleDetail some sdg:RoleKind, sdg:yearsExperience some xsd:integer, sdg:conductsInterviewsFor min 2 sdg:HiringProcess, sdg:evaluatesCandidatesFor exactly 1 sdg:JobRole, sdg:asksQuestions min 2 sdg:InterviewQuestion

Class: sdg:HumanPerson
    Annotations: rdfs:label "Human Person", iao:0000115 "A living human individual who exists as a biological organism and social agent."
    SubClassOf: bfo:0000004, sdg:hasGivenName some xsd:string, sdg:hasFamilyName some xsd:string, sdg:hasOccupationRole some xsd:string, sdg:hasResidenceLocation some xsd:string, sdg:hasAncestralOriginLocation some xsd:string, sdg:hasBiologicalParent some sdg:HumanPerson, sdg:hasSpouse max 1 sdg:HumanPerson, sdg:hasResidenceIn some sdg:Settlement, sdg:participatedIn some sdg:CensusRegistration

Class: sdg:Settlement
    Annotations: rdfs:label "Settlement", iao:0000115 "A human habitation, town, or city where people reside and conduct civic activities."
    SubClassOf: sdg:GeographicEntity, sdg:hasSettlementName some xsd:string, sdg:hasGeographicRegion some xsd:string, sdg:hasPopulationDensity some xsd:integer, sdg:contains some sdg:Building, sdg:hostedEvent some sdg:CensusRegistration

Class: sdg:Building
    Annotations: rdfs:label "Building", iao:0000115 "A constructed physical structure providing shelter, such as a stable or dwelling."
    SubClassOf: bfo:0000040, sdg:hasBuildingType some xsd:string, sdg:hasMaterialComposition some xsd:string, sdg:hasOccupancyStatus some xsd:string, sdg:hasAnimalOccupants some xsd:boolean, sdg:buildingId some xsd:string, sdg:address some xsd:string, sdg:district some xsd:string, sdg:constructionYear some xsd:integer, sdg:lastRenovationDate some xsd:date, sdg:leaseTermYears some xsd:integer, sdg:leaseStartDate some xsd:date, sdg:leaseGrantor some xsd:string, sdg:locatedIn exactly 1 sdg:Settlement, sdg:hostedBirth some sdg:BirthEvent, sdg:locatedIn exactly 1 sdg:City, sdg:houses some sdg:EducationalOrganization, sdg:contains min 2 sdg:Room

Class: sdg:BirthEvent
    Annotations: rdfs:label "Birth Event", iao:0000115 "The biological process of a human infant coming into existence."
    SubClassOf: bfo:0000015, sdg:hasEventDate some xsd:date, sdg:hasBirthLocation some xsd:string, sdg:identifier some xsd:string, sdg:birthDate some xsd:date, sdg:locationName some xsd:string, sdg:parentFemaleName some xsd:string, sdg:parentMaleName some xsd:string, sdg:infantName some xsd:string, sdg:occurredAt exactly 1 sdg:Building, sdg:hasMother exactly 1 sdg:HumanPerson, sdg:hasFather exactly 1 sdg:HumanPerson, sdg:hasChild exactly 1 sdg:HumanPerson, sdg:occurredAt exactly 1 sdg:Location, sdg:involvesInfant exactly 1 sdg:Human, sdg:involvesMother exactly 1 sdg:Human, sdg:involvesFather exactly 1 sdg:Human

Class: sdg:CensusRegistration
    Annotations: rdfs:label "Census Registration", iao:0000115 "The administrative process of recording a person's identity and location for taxation or population tracking."
    SubClassOf: bfo:0000015, sdg:hasRegistrationDate some xsd:date, sdg:hasRegistrationLocation some xsd:string, sdg:hasMandatingAuthority some xsd:string, sdg:hasPurpose some xsd:string, sdg:registrationDate some xsd:dateTime, sdg:mandatedByDetail some xsd:string, sdg:purpose some sdg:PurposeKind, sdg:registrantName some xsd:string, sdg:mandatedBy exactly 1 sdg:GovernmentDecree, sdg:recordedPerson some sdg:HumanPerson, sdg:tookPlaceIn exactly 1 sdg:Settlement, sdg:mandatedBy exactly 1 sdg:LegislativeDecree, sdg:recordsIndividual exactly 1 sdg:Human, sdg:occurredAt exactly 1 sdg:Location

Class: sdg:GovernmentDecree
    Annotations: rdfs:label "Government Decree", iao:0000115 "An official law or command issued by a ruling authority to enforce civic compliance."
    SubClassOf: bfo:0000015, sdg:hasDecreeTitle some xsd:string, sdg:hasIssuingEmperor some xsd:string, sdg:hasEnforcementDate some xsd:date, sdg:hasLegalRequirement some xsd:string, sdg:issuedBy exactly 1 sdg:HumanPerson, sdg:caused some sdg:CensusRegistration

Class: sdg:InfantCareItem
    Annotations: rdfs:label "Infant Care Item", iao:0000115 "A physical object or material used to provide comfort, warmth, or bedding for a newborn."
    SubClassOf: cco:ont00000995, sdg:hasItemName some xsd:string, sdg:hasMaterialType some xsd:string, sdg:hasPhysicalCondition some xsd:string, sdg:itemType some sdg:ItemTypeKind, sdg:material some xsd:string, sdg:condition some sdg:ConditionKind, sdg:usedFor some sdg:BirthEvent, sdg:locatedIn exactly 1 sdg:Building, sdg:locatedIn exactly 1 sdg:Location

Class: sdg:WebSession
    Annotations: rdfs:label "Web Session", iao:0000115 "A discrete period of user interaction with the Housing Authorities' website, capturing technical and behavioral telemetry."
    SubClassOf: bfo:0000015, sdg:sessionId some xsd:string, sdg:ipAddress some xsd:string, sdg:browserType some xsd:string, sdg:domainName some xsd:string, sdg:accessTimestamp some xsd:dateTime, sdg:referringUrl some xsd:string, sdg:sessionDurationSeconds some xsd:integer, sdg:isSecure some xsd:boolean, sdg:belongsTo max 1 sdg:UserAccount, sdg:uses some sdg:CookieRecord

Class: sdg:DemographicProfile
    Annotations: rdfs:label "Demographic Profile", iao:0000115 "An anonymous, non-unique statistical record of user attributes such as age, gender, and interests."
    SubClassOf: cco:ont00000995, sdg:profileId some xsd:string, sdg:zipCode some xsd:string, sdg:ageGroup some xsd:string, sdg:gender some sdg:GenderKind, sdg:primaryInterest some xsd:string, sdg:favoriteCategory some xsd:string, sdg:isAnonymized some xsd:boolean, sdg:linkedTo exactly 1 sdg:UserAccount
    HasKey: sdg:profileId

Class: sdg:SurveyResponse
    Annotations: rdfs:label "Survey Response", iao:0000115 "A recorded user submission regarding opinions on current or potential Housing Authorities services."
    SubClassOf: cco:ont00000995, sdg:responseId some xsd:string, sdg:surveyTopic some xsd:string, sdg:ratingScore some xsd:decimal, sdg:feedbackText some xsd:string, sdg:submissionDate some xsd:dateTime, sdg:isAnonymous some xsd:boolean, sdg:surveyDate some xsd:dateTime, sdg:respondentType some xsd:string, sdg:perceptionScore some xsd:integer, sdg:integrationAssessment some xsd:string, sdg:languageBarrierPerception some xsd:boolean, sdg:respondentStatus some sdg:RespondentStatusKind, sdg:totalScore some xsd:decimal, sdg:completionStatus some sdg:CompletionStatusKind, sdg:respondentAge some xsd:integer, sdg:respondentGender some xsd:string, sdg:country some sdg:CountryKind, sdg:householdSize some xsd:integer, sdg:isSickInHousehold some xsd:boolean, sdg:submittedBy exactly 1 sdg:UserAccount, sdg:pertainsTo some sdg:ServiceOffering, sdg:collectedFrom exactly 1 sdg:Local, sdg:collectedFrom max 1 sdg:Migrant, sdg:about min 2 sdg:Migrant, sdg:recordedBy exactly 1 sdg:Researcher, sdg:addressedTo exactly 1 sdg:PolicyInstrument, sdg:recordsIdentity exactly 1 sdg:ReligiousIdentity, sdg:reportsPractice some sdg:ReligiousPractice, sdg:consults max 1 sdg:TraditionalHealer, sdg:possesses some sdg:SacredObject

Class: sdg:ServiceOffering
    Annotations: rdfs:label "Service Offering", iao:0000115 "A specific housing-related service or product provided by the Housing Authorities or its affiliates."
    SubClassOf: cco:ont00000995, sdg:serviceId some xsd:string, sdg:serviceName some xsd:string, sdg:serviceType some sdg:ServiceTypeKind, sdg:isCurrent some xsd:boolean, sdg:isPotential some xsd:boolean, sdg:evaluatedIn some sdg:SurveyResponse, sdg:deliveredVia some sdg:WebSession

Class: sdg:CookieRecord
    Annotations: rdfs:label "Cookie Record", iao:0000115 "A text file placed on a user's device to personalize online experience and track session state."
    SubClassOf: cco:ont00000995, sdg:cookieId some xsd:string, sdg:cookieName some xsd:string, sdg:contentHash some xsd:string, sdg:expirationDate some xsd:date, sdg:isEssential some xsd:boolean, sdg:readBy exactly 1 sdg:WebSession, sdg:assignedTo exactly 1 sdg:UserAccount

Class: sdg:ProductDesign
    Annotations: rdfs:label "Product Design", iao:0000115 "A designed artifact representing a conceptual or physical product, such as a digital camera or industrial object."
    SubClassOf: cco:ont00000995, sdg:designIdentifier some xsd:string, sdg:designName some xsd:string, sdg:designStatus some sdg:DesignStatusKind, sdg:creationDate some xsd:dateTime, sdg:designerRole some xsd:string, sdg:renderingComplexity some xsd:integer, sdg:createdBy exactly 1 sdg:Designer, sdg:usesSoftware some sdg:SoftwareTool, sdg:participatedIn some sdg:DesignCompetition, sdg:hasRender some sdg:PhotorealisticRender

Class: sdg:Designer
    Annotations: rdfs:label "Designer", iao:0000115 "A person or entity responsible for the conceptualization and development of product designs."
    SubClassOf: bfo:0000023, sdg:designerId some xsd:string, sdg:designerName some xsd:string, sdg:employmentStatus some sdg:EmploymentStatusKind, sdg:careerStartYear some xsd:integer, sdg:primarySkill some xsd:string, sdg:contactEmail some xsd:string, sdg:created min 2 sdg:ProductDesign, sdg:employedBy some sdg:DesignFirm, sdg:wonAwardIn some sdg:DesignCompetition

Class: sdg:SoftwareTool
    Annotations: rdfs:label "Software Tool", iao:0000115 "A digital application used for creating, modifying, or rendering 3D models and designs."
    SubClassOf: cco:ont00000995, sdg:softwareId some xsd:string, sdg:softwareName some xsd:string, sdg:softwareVersion some xsd:string, sdg:developerName some xsd:string, sdg:interfaceType some sdg:InterfaceTypeKind, sdg:learningCurve some xsd:string, sdg:toolId some xsd:string, sdg:toolName some xsd:string, sdg:version some xsd:string, sdg:licenseType some xsd:string, sdg:primaryFunctionDetail some xsd:string, sdg:developer some xsd:string, sdg:toolCategory some xsd:string, sdg:vendor some xsd:string, sdg:toolIdentifier some xsd:string, sdg:usedBy min 2 sdg:Designer, sdg:generates some sdg:ProductDesign, sdg:usedFor some sdg:MolecularDynamicsSimulation, sdg:usedFor some sdg:ProteinStructure, sdg:usedFor some sdg:SmallMolecule, sdg:usedIn min 2 sdg:Project, sdg:generates some sdg:DigitalAsset, sdg:usedInProject some sdg:AnimationProject, sdg:usedForAudio some sdg:AudioTrack

Class: sdg:DesignCompetition
    Annotations: rdfs:label "Design Competition", iao:0000115 "A formal event where designers submit works for evaluation and potential awards."
    SubClassOf: bfo:0000015, sdg:competitionId some xsd:string, sdg:competitionName some xsd:string, sdg:competitionYear some xsd:integer, sdg:organizerName some xsd:string, sdg:evaluationCriteria some xsd:string, sdg:grandPrizeAwarded some xsd:boolean, sdg:evaluated min 2 sdg:ProductDesign, sdg:organizedBy exactly 1 sdg:DesignFirm, sdg:awardedTo some sdg:Designer

Class: sdg:PhotorealisticRender
    Annotations: rdfs:label "Photorealistic Render", iao:0000115 "A high-fidelity digital image or visualization of a product design, simulating real-world lighting and materials."
    SubClassOf: cco:ont00000995, sdg:renderId some xsd:string, sdg:renderDate some xsd:dateTime, sdg:lightingSetup some xsd:string, sdg:resolution some sdg:ResolutionKind, sdg:renderTimeHours some xsd:decimal, sdg:fileSizeMB some xsd:decimal, sdg:depicts exactly 1 sdg:ProductDesign, sdg:generatedBy exactly 1 sdg:SoftwareTool, sdg:submittedTo some sdg:DesignCompetition

Class: sdg:DesignFirm
    Annotations: rdfs:label "Design Firm", iao:0000115 "An organization or business entity specializing in industrial or product design services."
    SubClassOf: bfo:0000023, sdg:firmId some xsd:string, sdg:firmName some xsd:string, sdg:foundingYear some xsd:integer, sdg:headquartersLocation some xsd:string, sdg:firmType some xsd:string, sdg:activeStatus some xsd:boolean, sdg:employed min 2 sdg:Designer, sdg:organized some sdg:DesignCompetition, sdg:mergedWith some sdg:DesignFirm

Class: sdg:NursingForum
    Annotations: rdfs:label "Nursing and Care Quality Forum", iao:0000115 "A formal governance body or committee established to oversee nursing standards, care quality, and strategic leadership within the NHS."
    SubClassOf: cco:ont00000958, sdg:forumIdentifier some xsd:string, sdg:forumName some xsd:string, sdg:establishedDate some xsd:date, sdg:status some sdg:StatusKind, sdg:jurisdiction some sdg:JurisdictionKind, sdg:currentStatus some sdg:CurrentStatusKind, sdg:governingBody some xsd:string, sdg:scopeOfInfluence some sdg:ScopeOfInfluenceKind, sdg:hasMember min 2 sdg:NursingProfessional, sdg:hasChair exactly 1 sdg:NursingProfessional, sdg:hasWorkstream min 2 sdg:QualityWorkstream, sdg:hasChair exactly 1 sdg:NursingLeader, sdg:hasWorkstreamLead min 2 sdg:NursingLeader, sdg:hasMember min 2 sdg:NursingLeader

Class: sdg:NursingProfessional
    Annotations: rdfs:label "Nursing Professional", iao:0000115 "A registered healthcare practitioner, such as a nurse, midwife, or clinical director, who holds a professional role within the NHS or related health bodies."
    SubClassOf: bfo:0000023, sdg:professionalId some xsd:string, sdg:fullName some xsd:string, sdg:registrationNumber some xsd:string, sdg:primaryQualification some xsd:string, sdg:yearsOfExperience some xsd:integer, sdg:currentRoleTitle some xsd:string, sdg:hasFellowship some xsd:boolean, sdg:holdsRoleAt some sdg:HealthTrust, sdg:servesOnForum some sdg:NursingForum, sdg:leadsWorkstream max 1 sdg:QualityWorkstream, sdg:trainedAt max 1 sdg:EducationalInstitution
    HasKey: sdg:professionalId

Class: sdg:QualityWorkstream
    Annotations: rdfs:label "Quality Improvement Workstream", iao:0000115 "A focused strategic initiative or working group within a nursing forum dedicated to specific quality, safety, or cultural objectives."
    SubClassOf: bfo:0000015, sdg:workstreamId some xsd:string, sdg:workstreamTitle some xsd:string, sdg:startDate some xsd:dateTime, sdg:targetMetric some xsd:string, sdg:status some sdg:StatusKind, sdg:scope some sdg:ScopeKind, sdg:belongsToForum exactly 1 sdg:NursingForum, sdg:ledBy exactly 1 sdg:NursingProfessional, sdg:targetsOutcome some sdg:ClinicalOutcome

Class: sdg:HealthTrust
    Annotations: rdfs:label "NHS Health Trust", iao:0000115 "A statutory NHS organization or foundation trust responsible for delivering healthcare services, governance, and patient safety in a defined region."
    SubClassOf: cco:ont00000995, sdg:trustId some xsd:string, sdg:trustName some xsd:string, sdg:trustType some sdg:TrustTypeKind, sdg:region some sdg:RegionKind, sdg:cqcRating some xsd:string, sdg:establishedYear some xsd:integer, sdg:employsProfessional min 2 sdg:NursingProfessional, sdg:conductsAudit some sdg:ClinicalOutcome, sdg:locatedInRegion exactly 1 sdg:GeographicRegion

Class: sdg:ClinicalOutcome
    Annotations: rdfs:label "Clinical Quality Outcome", iao:0000115 "A measurable health service result, such as infection rates, patient safety incidents, or quality ratings, tracked to evaluate care standards."
    SubClassOf: bfo:0000015, sdg:outcomeId some xsd:string, sdg:outcomeType some sdg:OutcomeTypeKind, sdg:measurementValue some xsd:decimal, sdg:unitOfMeasure some sdg:UnitOfMeasureKind, sdg:measurementDate some xsd:dateTime, sdg:trend some xsd:string, sdg:dataSource some xsd:string, sdg:outcomeName some xsd:string, sdg:measurementType some sdg:MeasurementTypeKind, sdg:unit some sdg:UnitKind, sdg:measuredAt exactly 1 sdg:HealthTrust, sdg:influencedBy some sdg:QualityWorkstream, sdg:recordedBy some sdg:NursingProfessional, sdg:measuredInStudy some sdg:ClinicalStudy
    HasKey: sdg:outcomeId

Class: sdg:ObservatoryFacility
    Annotations: rdfs:label "Observatory Facility", iao:0000115 "A physical site or complex housing astronomical instruments and supporting infrastructure, including land parcels and buildings."
    SubClassOf: bfo:0000040, sdg:facilityId some xsd:string, sdg:facilityName some xsd:string, sdg:location some xsd:string, sdg:landAreaAcres some xsd:decimal, sdg:landOwnershipType some xsd:string, sdg:operationalStatus some sdg:OperationalStatusKind, sdg:establishedDate some xsd:date, sdg:hostsInstrument min 1 sdg:Telescope, sdg:locatedInJurisdiction exactly 1 sdg:Country, sdg:managedBy exactly 1 sdg:ManagingOrganization

Class: sdg:Telescope
    Annotations: rdfs:label "Telescope", iao:0000115 "A ground-based optical or infrared astronomical instrument used for observation, characterized by aperture size and operational parameters."
    SubClassOf: bfo:0000040, sdg:telescopeId some xsd:string, sdg:telescopeName some xsd:string, sdg:apertureMeters some xsd:decimal, sdg:telescopeClass some xsd:string, sdg:primaryInstrument some xsd:string, sdg:observationMode some xsd:string, sdg:communityAccessPercentage some xsd:decimal, sdg:fundingConsortium some xsd:string, sdg:telescopeIdentifier some xsd:string, sdg:manufacturer some xsd:string, sdg:apertureInches some xsd:decimal, sdg:mountingType some xsd:string, sdg:yearManufactured some xsd:integer, sdg:currentLocation some xsd:string, sdg:status some sdg:StatusKind, sdg:accessories some xsd:string, sdg:sitedAt exactly 1 sdg:ObservatoryFacility, sdg:dedicatedToSurvey max 1 sdg:AstronomicalSurvey, sdg:operatedBy exactly 1 sdg:ManagingOrganization, sdg:usedInObservation some sdg:Observation, sdg:ownedBy max 1 sdg:Observer
    HasKey: sdg:telescopeId

Class: sdg:AstronomicalSurvey
    Annotations: rdfs:label "Astronomical Survey", iao:0000115 "A systematic observational campaign targeting specific astrophysical phenomena, with defined duration and resource allocation."
    SubClassOf: bfo:0000015, sdg:surveyId some xsd:string, sdg:surveyName some xsd:string, sdg:startDate some xsd:dateTime, sdg:endDate some xsd:dateTime, sdg:nightsAllocatedPerYear some xsd:integer, sdg:primaryObjective some sdg:PrimaryObjectiveKind, sdg:status some sdg:StatusKind, sdg:usesTelescope exactly 1 sdg:Telescope, sdg:fundedBy exactly 1 sdg:FundingAgency

Class: sdg:ManagingOrganization
    Annotations: rdfs:label "Managing Organization", iao:0000115 "An entity responsible for the operation, management, and oversight of an observatory facility under cooperative agreement."
    SubClassOf: sdg:Organization, sdg:orgId some xsd:string, sdg:orgName some xsd:string, sdg:orgType some sdg:OrgTypeKind, sdg:agreementStartDate some xsd:date, sdg:agreementEndDate some xsd:date, sdg:oversightLevel some sdg:OversightLevelKind, sdg:conflictOfInterestDisclosure some xsd:boolean, sdg:agreementStatus some xsd:string, sdg:managesFacility min 1 sdg:ObservatoryFacility, sdg:awardedBy exactly 1 sdg:FundingAgency, sdg:leasesLandFrom max 1 sdg:LandOwner

Class: sdg:FundingAgency
    Annotations: rdfs:label "Funding Agency", iao:0000115 "A governmental or institutional body providing financial support and oversight for astronomical research facilities."
    SubClassOf: bfo:0000004, sdg:agencyId some xsd:string, sdg:agencyName some xsd:string, sdg:agencyType some sdg:AgencyTypeKind, sdg:division some xsd:string, sdg:programCode some xsd:string, sdg:oversightResponsibility some xsd:string, sdg:website some xsd:string, sdg:foundingYear some xsd:integer, sdg:authorizationSource some xsd:string, sdg:headquartersCity some xsd:string, sdg:name some sdg:NameKind, sdg:type some sdg:TypeKind, sdg:contactInfo some xsd:string, sdg:awardsAgreementTo min 1 sdg:ManagingOrganization, sdg:sponsorsFacility min 1 sdg:ObservatoryFacility, sdg:issuesAwards some sdg:FundingAward, sdg:issues min 2 sdg:EngagementAward, sdg:oversees some sdg:ReviewPanel, sdg:fundsProject some sdg:ResearchProject

Class: sdg:LandOwner
    Annotations: rdfs:label "Land Owner", iao:0000115 "An entity holding legal title or lease rights to land parcels used for astronomical facilities."
    SubClassOf: bfo:0000004, sdg:ownerId some xsd:string, sdg:ownerName some xsd:string, sdg:ownerType some sdg:OwnerTypeKind, sdg:landAreaAcres some xsd:decimal, sdg:leaseRatePerYear some xsd:decimal, sdg:leasePurposeRestriction some xsd:string, sdg:totalLandHeld some xsd:decimal, sdg:retirementStatus some sdg:RetirementStatusKind, sdg:lastSalePrice some xsd:decimal, sdg:leasesTo max 1 sdg:ManagingOrganization, sdg:ownsParcelAt min 1 sdg:ObservatoryFacility, sdg:owns min 2 sdg:FarmlandParcel, sdg:leasesTo max 1 sdg:InstitutionalInvestor

Class: sdg:StudentAthlete
    Annotations: rdfs:label "Student Athlete", iao:0000115 "A person who is enrolled in an academic institution and participates in intercollegiate athletics."
    SubClassOf: sdg:EducationalEntity, sdg:studentId some xsd:string, sdg:fullName some xsd:string, sdg:enrollmentStatus some sdg:EnrollmentStatusKind, sdg:currentGpa some xsd:decimal, sdg:cumulativeGpa some xsd:decimal, sdg:semesterHoursEarned some xsd:integer, sdg:degreeProgram some xsd:string, sdg:majorDeclared some xsd:boolean, sdg:semesterOfEnrollment some xsd:integer, sdg:participationType some xsd:string, sdg:monitoredBy exactly 1 sdg:ComplianceCoordinator, sdg:certifiedBy exactly 1 sdg:CertifyingOfficer, sdg:reportedTo exactly 1 sdg:HeadCoach, sdg:enrolledIn exactly 1 sdg:AcademicTerm, sdg:pursuing exactly 1 sdg:DegreeProgram

Class: sdg:ComplianceCoordinator
    Annotations: rdfs:label "Compliance Coordinator", iao:0000115 "An individual responsible for monitoring student-athlete eligibility and reporting status changes."
    SubClassOf: sdg:RegulatoryComplianceConcept, sdg:employeeId some xsd:string, sdg:fullName some xsd:string, sdg:department some xsd:string, sdg:contactEmail some xsd:string, sdg:lastAuditDate some xsd:date, sdg:roleFunction some xsd:string, sdg:monitors min 2 sdg:StudentAthlete, sdg:certifies min 2 sdg:CreditHourRequirement, sdg:reportsTo exactly 1 sdg:HeadCoach

Class: sdg:CertifyingOfficer
    Annotations: rdfs:label "Certifying Officer", iao:0000115 "An individual in the Registrar's Office responsible for certifying student-athlete academic requirements."
    SubClassOf: bfo:0000040, sdg:employeeId some xsd:string, sdg:fullName some xsd:string, sdg:office some xsd:string, sdg:contactEmail some xsd:string, sdg:certifies min 2 sdg:CreditHourRequirement, sdg:notifies exactly 1 sdg:HeadCoach, sdg:notifies exactly 1 sdg:StudentAthlete

Class: sdg:HeadCoach
    Annotations: rdfs:label "Head Coach", iao:0000115 "An individual responsible for managing a sports team and ensuring compliance with eligibility rules."
    SubClassOf: bfo:0000040, sdg:employeeId some xsd:string, sdg:fullName some xsd:string, sdg:sport some xsd:string, sdg:teamName some xsd:string, sdg:contactEmail some xsd:string, sdg:manages min 2 sdg:StudentAthlete, sdg:receivesNotificationFrom exactly 1 sdg:ComplianceCoordinator, sdg:receivesNotificationFrom exactly 1 sdg:CertifyingOfficer, sdg:prohibits min 2 sdg:StudentAthlete
    HasKey: sdg:employeeId

Class: sdg:AcademicTerm
    Annotations: rdfs:label "Academic Term", iao:0000115 "A defined period of instruction within an academic year, such as a semester or quarter."
    SubClassOf: bfo:0000040, sdg:termId some xsd:string, sdg:termName some xsd:string, sdg:startDate some xsd:dateTime, sdg:endDate some xsd:dateTime, sdg:semesterHoursRequired some xsd:integer, sdg:termType some sdg:TermTypeKind, sdg:numberOfWeeks some xsd:integer, sdg:isEnrollmentRequired some xsd:boolean, sdg:contains min 2 sdg:StudentAthlete, sdg:requires exactly 1 sdg:CreditHourRequirement, sdg:hasPlannedCredits some sdg:EnrollmentPlan, sdg:triggersDisbursement some sdg:FinancialAward

Class: sdg:CreditHourRequirement
    Annotations: rdfs:label "Credit Hour Requirement", iao:0000115 "A specific academic credit threshold that must be met to maintain student-athlete eligibility."
    SubClassOf: bfo:0000040, sdg:requirementId some xsd:string, sdg:creditHoursRequired some xsd:integer, sdg:requirementType some sdg:RequirementTypeKind, sdg:deadlineDate some xsd:date, sdg:status some sdg:StatusKind, sdg:appliesTo min 2 sdg:StudentAthlete, sdg:certifiedBy exactly 1 sdg:CertifyingOfficer, sdg:monitoredBy exactly 1 sdg:ComplianceCoordinator, sdg:partOf__escalated exactly 1 sdg:AcademicTerm
    HasKey: sdg:requirementId

Class: sdg:DegreeProgram
    Annotations: rdfs:label "Degree Program", iao:0000115 "A structured course of study leading to an academic degree, with specific course requirements."
    SubClassOf: sdg:Program, sdg:programId some xsd:string, sdg:programName some xsd:string, sdg:totalCreditsRequired some xsd:integer, sdg:majorRequired some xsd:boolean, sdg:declarationDeadline some xsd:date, sdg:degreeType some xsd:string, sdg:name some sdg:NameKind, sdg:level some sdg:LevelKind, sdg:minimumGPA some xsd:decimal, sdg:upperDivisionCreditsRequired some xsd:integer, sdg:durationYears some xsd:integer, sdg:fieldOfStudy some xsd:string, sdg:programCode some xsd:string, sdg:totalRequiredCredits some xsd:integer, sdg:effectiveDate some xsd:date, sdg:status some sdg:StatusKind, sdg:pursuedBy min 2 sdg:StudentAthlete, sdg:requires min 2 sdg:CreditHourRequirement, sdg:requiresCourse min 2 sdg:Course, sdg:conferredBy exactly 1 sdg:EducationalInstitution, sdg:completedBy some sdg:Person, sdg:hasRequirement min 2 sdg:DegreeRequirement, sdg:offersConcentration some sdg:Concentration

Class: sdg:SchoolZone
    Annotations: rdfs:label "School Zone", iao:0000115 "A physical area within or associated with a public school, such as a classroom, locker room, bus, or athletic field, subject to specific privacy and security expectations."
    SubClassOf: bfo:0000004, sdg:zoneId some xsd:string, sdg:zoneType some sdg:ZoneTypeKind, sdg:privacyLevel some xsd:string, sdg:isIndoor some xsd:boolean, sdg:capacity some xsd:integer, sdg:contains some sdg:SurveillanceCamera, sdg:hosts some sdg:StudentSearchEvent

Class: sdg:StudentSearchEvent
    Annotations: rdfs:label "Student Search Event", iao:0000115 "An activity conducted by school officials to inspect a student or their belongings to maintain safety and discipline, subject to Fourth Amendment reasonableness standards."
    SubClassOf: bfo:0000015, sdg:searchId some xsd:string, sdg:timestamp some xsd:dateTime, sdg:initiatedByDetail some xsd:string, sdg:reasonablenessInception some xsd:boolean, sdg:reasonablenessScope some xsd:boolean, sdg:intrusivenessLevel some xsd:string, sdg:outcome some sdg:OutcomeKind, sdg:targets exactly 1 sdg:Student, sdg:occursIn__escalated exactly 1 sdg:SchoolZone, sdg:authorizedBy max 1 sdg:SchoolPolicy

Class: sdg:SchoolPolicy
    Annotations: rdfs:label "School Policy", iao:0000115 "A formal document or designator established by a local school board to govern security measures, search procedures, and student privacy expectations."
    SubClassOf: cco:ont00000958, sdg:policyId some xsd:string, sdg:title some xsd:string, sdg:effectiveDate some xsd:date, sdg:lastReviewed some xsd:date, sdg:approvalStatus some sdg:ApprovalStatusKind, sdg:jurisdiction some sdg:JurisdictionKind, sdg:governs some sdg:StudentSearchEvent, sdg:permits some sdg:SurveillanceCamera, sdg:amends some sdg:SchoolPolicy
    HasKey: sdg:policyId

Class: sdg:ClinicalStudy
    Annotations: rdfs:label "Clinical Study", iao:0000115 "A pragmatic clinical study designed to compare healthcare options in real-world practice settings to determine which works best for different kinds of patients."
    SubClassOf: bfo:0000015, sdg:studyId some xsd:string, sdg:title some xsd:string, sdg:status some sdg:StatusKind, sdg:startDate some xsd:dateTime, sdg:endDate some xsd:dateTime, sdg:fundingAgency some xsd:string, sdg:primaryObjective some sdg:PrimaryObjectiveKind, sdg:investigatedBy some sdg:Researcher, sdg:fundedBy exactly 1 sdg:FundingAward, sdg:focusesOnCondition min 2 sdg:MedicalCondition, sdg:comparesInterventions min 2 sdg:Intervention, sdg:measuresOutcomes min 3 sdg:ClinicalOutcome

Class: sdg:FundingAward
    Annotations: rdfs:label "Funding Award", iao:0000115 "A formal grant or award issued by PCORI to fund a specific pragmatic clinical study."
    SubClassOf: cco:ont00000995, sdg:awardId some xsd:string, sdg:awardDate some xsd:date, sdg:totalAmount some xsd:decimal, sdg:durationMonths some xsd:integer, sdg:status some sdg:StatusKind, sdg:fundsStudy exactly 1 sdg:ClinicalStudy, sdg:issuedBy exactly 1 sdg:FundingAgency

Class: sdg:MedicalCondition
    Annotations: rdfs:label "Medical Condition", iao:0000115 "A disease, disorder, or health state that is the focus of a clinical study, such as cancer or cardiovascular disease."
    SubClassOf: bfo:0000015, sdg:conditionId some xsd:string, sdg:conditionName some xsd:string, sdg:category some sdg:CategoryKind, sdg:studiedIn some sdg:ClinicalStudy

Class: sdg:Intervention
    Annotations: rdfs:label "Intervention", iao:0000115 "A healthcare option, treatment, or care approach being evaluated in a clinical study, such as a drug, surgery, or screening method."
    SubClassOf: bfo:0000015, sdg:interventionId some xsd:string, sdg:interventionName some xsd:string, sdg:type some sdg:TypeKind, sdg:dosage some xsd:string, sdg:name some sdg:NameKind, sdg:unit some sdg:UnitKind, sdg:frequency some sdg:FrequencyKind, sdg:route some xsd:string, sdg:interventionIdentifier some xsd:string, sdg:interventionType some xsd:string, sdg:startDate some xsd:dateTime, sdg:endDate some xsd:dateTime, sdg:restrictivenessLevel some xsd:string, sdg:status some sdg:StatusKind, sdg:comparedInStudy some sdg:ClinicalStudy, sdg:evaluatedIn exactly 1 sdg:ClinicalTrial, sdg:affects exactly 1 sdg:Individual, sdg:implements exactly 1 sdg:BestInterestDetermination, sdg:relatedTo exactly 1 sdg:DecisionContext

Class: sdg:PartyPlatter
    Annotations: rdfs:label "Party Platter", iao:0000115 "A pre-packaged food platter designed to serve a specific number of guests, containing a selection of sandwiches or main items."
    SubClassOf: cco:ont00000995, sdg:platterId some xsd:string, sdg:servesCount some xsd:integer, sdg:basePrice some xsd:decimal, sdg:epicPrice some xsd:decimal, sdg:status some sdg:StatusKind, sdg:lastUpdated some xsd:dateTime, sdg:contains min 2 sdg:PlatterItem, sdg:includes max 1 sdg:SideItem, sdg:includes max 1 sdg:Beverage, sdg:includes max 1 sdg:Dessert
    HasKey: sdg:platterId

Class: sdg:PlatterItem
    Annotations: rdfs:label "Platter Item", iao:0000115 "A specific food item included in a party platter, such as a sandwich or chicken dish."
    SubClassOf: sdg:DiningPackage, sdg:itemId some xsd:string, sdg:itemName some xsd:string, sdg:quantity some xsd:integer, sdg:category some sdg:CategoryKind, sdg:isCrispy some xsd:boolean, sdg:isGrilled some xsd:boolean, sdg:preparationMethod some xsd:string, sdg:partOf__escalated exactly 1 sdg:PartyPlatter, sdg:servedWith max 1 sdg:Sauce
    HasKey: sdg:itemId

Class: sdg:Beverage
    Annotations: rdfs:label "Beverage", iao:0000115 "A drink item that can be added to a platter or box lunch."
    SubClassOf: cco:ont00000995, sdg:beverageId some xsd:string, sdg:beverageName some xsd:string, sdg:price some xsd:decimal, sdg:type some sdg:TypeKind, sdg:isAvailable some xsd:boolean, sdg:beverageIdentifier some xsd:string, sdg:beverageType some sdg:BeverageTypeKind, sdg:servingTemperature some xsd:string, sdg:alcoholContent some xsd:decimal, sdg:brand some xsd:string, sdg:volume some xsd:decimal, sdg:unit some sdg:UnitKind, sdg:includedIn max 1 sdg:PartyPlatter, sdg:includedIn max 1 sdg:BoxLunch, sdg:pairedWith some sdg:MenuCourse, sdg:includedIn some sdg:DiningPackage, sdg:availableDuring some sdg:HappyHourSpecial
    HasKey: sdg:beverageId

Class: sdg:Dessert
    Annotations: rdfs:label "Dessert", iao:0000115 "A sweet item that can be added to a platter or box lunch."
    SubClassOf: sdg:DiningPackage, sdg:dessertId some xsd:string, sdg:dessertName some xsd:string, sdg:price some xsd:decimal, sdg:type some sdg:TypeKind, sdg:isAvailable some xsd:boolean, sdg:includedIn max 1 sdg:PartyPlatter, sdg:includedIn max 1 sdg:BoxLunch

Class: sdg:BoxLunch
    Annotations: rdfs:label "Box Lunch", iao:0000115 "A pre-packaged lunch box containing a wrap, a side, and optionally a dessert."
    SubClassOf: cco:ont00000995, sdg:lunchId some xsd:string, sdg:lunchName some xsd:string, sdg:price some xsd:decimal, sdg:status some sdg:StatusKind, sdg:lastUpdated some xsd:dateTime, sdg:contains exactly 1 sdg:Wrap, sdg:includes max 1 sdg:SideItem, sdg:includes max 1 sdg:Dessert

Class: sdg:Wrap
    Annotations: rdfs:label "Wrap", iao:0000115 "A sandwich variant served in a wrap, containing various fillings."
    SubClassOf: cco:ont00000995, sdg:wrapId some xsd:string, sdg:wrapName some xsd:string, sdg:price some xsd:decimal, sdg:mainIngredient some sdg:MainIngredientKind, sdg:isAvailable some xsd:boolean, sdg:includedIn max 1 sdg:BoxLunch, sdg:contains min 2 sdg:Ingredient

Class: sdg:SME
    Annotations: rdfs:label "Small and Medium-sized Enterprise", iao:0000115 "A privately held business with a small number of employees and limited amount of assets and revenues, typically meeting specific quantitative criteria defined by national governments."
    SubClassOf: cco:ont00000995, sdg:enterpriseId some xsd:string, sdg:name some sdg:NameKind, sdg:employeeCount some xsd:integer, sdg:annualRevenue some xsd:decimal, sdg:sector some sdg:SectorKind, sdg:countryOfOperation some xsd:string, sdg:isPubliclyTraded some xsd:boolean, sdg:foundingDate some xsd:date, sdg:operatesIn some sdg:MarketSector, sdg:locatedIn some sdg:Jurisdiction, sdg:employs min 2 sdg:Employee, sdg:hasOwner some sdg:BusinessOwner

Class: sdg:BusinessOwner
    Annotations: rdfs:label "Business Owner", iao:0000115 "An individual who holds an ownership stake in an enterprise and exercises control over its strategic direction."
    SubClassOf: bfo:0000023, sdg:ownerId some xsd:string, sdg:fullName some xsd:string, sdg:generation some xsd:string, sdg:age some xsd:integer, sdg:title some xsd:string, sdg:yearsOfExperience some xsd:integer, sdg:exitPlan some xsd:boolean, sdg:exitTimeframe some xsd:integer, sdg:owns some sdg:SME, sdg:residesIn some sdg:Jurisdiction, sdg:participatedIn exactly 1 sdg:Survey

Class: sdg:Employee
    Annotations: rdfs:label "Employee", iao:0000115 "An individual engaged in work for an employer in exchange for financial or other compensation."
    SubClassOf: bfo:0000023, sdg:employeeId some xsd:string, sdg:fullName some xsd:string, sdg:roleDetail some sdg:RoleKind, sdg:department some xsd:string, sdg:startDate some xsd:dateTime, sdg:terminationDate some xsd:date, sdg:isLeader some xsd:boolean, sdg:performanceRating some xsd:decimal, sdg:yearsOfService some xsd:integer, sdg:digitalLiteracyLevel some xsd:string, sdg:employeeName some xsd:string, sdg:yearsEmployed some xsd:integer, sdg:feedbackSubmitted some xsd:boolean, sdg:professionalismRating some xsd:decimal, sdg:teamworkRating some xsd:decimal, sdg:jobTitle some xsd:string, sdg:officeLocation some xsd:string, sdg:hireDate some xsd:date, sdg:isManager some xsd:boolean, sdg:firstName some xsd:string, sdg:lastName some xsd:string, sdg:employmentStatus some sdg:EmploymentStatusKind, sdg:worksFor some sdg:SME, sdg:holdsPosition some sdg:JobRole, sdg:residesIn some sdg:Jurisdiction, sdg:usesPlatform min 2 sdg:SocialMediaPlatform, sdg:initiatesCommunication min 2 sdg:InternalCommunicationEvent, sdg:receivesCommunication min 2 sdg:InternalCommunicationEvent, sdg:worksFor exactly 1 sdg:Organization, sdg:submitsFeedbackFor some sdg:WorkplaceSurvey, sdg:buildsRelationships some sdg:ClientSector, sdg:assignedToDivision exactly 1 sdg:OperatingDivision, sdg:submitsBudget max 1 sdg:BudgetSubmission, sdg:enrollsInClass min 2 sdg:InternalTrainingClass, sdg:usesSoftware min 2 sdg:ProductivityTool, sdg:holdsPosition exactly 1 sdg:Position, sdg:supervises some sdg:Employee, sdg:assignedTo exactly 1 sdg:Department

Class: sdg:MarketSector
    Annotations: rdfs:label "Market Sector", iao:0000115 "A distinct group of businesses or industries that share common characteristics, products, or services."
    SubClassOf: bfo:0000004, sdg:sectorId some xsd:string, sdg:name some sdg:NameKind, sdg:industryClassificationCode some xsd:string, sdg:growthRate some xsd:decimal, sdg:isGrowthSector some xsd:boolean, sdg:description some xsd:string, sdg:contains min 2 sdg:SME, sdg:operatesIn some sdg:Jurisdiction

Class: sdg:Survey
    Annotations: rdfs:label "Business Survey", iao:0000115 "A structured questionnaire or study designed to collect data from a specific population to gain insights into business trends and challenges."
    SubClassOf: cco:ont00000958, sdg:surveyId some xsd:string, sdg:title some xsd:string, sdg:commissionedByDetail some xsd:string, sdg:conductedByDetail some xsd:string, sdg:startDate some xsd:dateTime, sdg:endDate some xsd:dateTime, sdg:totalRespondents some xsd:integer, sdg:countriesCovered some xsd:integer, sdg:timeframe some xsd:string, sdg:surveyed min 2 sdg:BusinessOwner, sdg:commissionedBy exactly 1 sdg:Organization, sdg:conductedBy exactly 1 sdg:Organization
    HasKey: sdg:surveyId

Class: sdg:ComplianceYear
    Annotations: rdfs:label "Compliance Year", iao:0000115 "A temporal period (calendar year) during which an attorney must earn a specified number of MCLE credits to maintain compliance."
    SubClassOf: bfo:0000040, sdg:yearStart some xsd:date, sdg:yearEnd some xsd:date, sdg:creditRequirement some xsd:integer, sdg:hasComplianceReport min 1 sdg:ComplianceReport, sdg:hasDeficiencyPlan some sdg:DeficiencyPlan

Class: sdg:Attorney
    Annotations: rdfs:label "Attorney", iao:0000115 "A licensed legal practitioner subject to the MCLE Commission's jurisdiction and credit requirements."
    SubClassOf: bfo:0000004, sdg:barLicenseNumber some xsd:string, sdg:fullName some xsd:string, sdg:barStatus some sdg:BarStatusKind, sdg:submittedComplianceReport min 1 sdg:ComplianceReport, sdg:submittedDeficiencyPlan some sdg:DeficiencyPlan, sdg:incurredLateFee some sdg:LateFee

Class: sdg:ComplianceReport
    Annotations: rdfs:label "Compliance Report", iao:0000115 "A formal record submitted by an attorney certifying their earned MCLE credits for a specific compliance year."
    SubClassOf: cco:ont00000995, sdg:reportId some xsd:string, sdg:submissionDate some xsd:dateTime, sdg:creditsEarned some xsd:decimal, sdg:professionalismCourseCompleted some xsd:boolean, sdg:reportStatus some sdg:ReportStatusKind, sdg:coversComplianceYear exactly 1 sdg:ComplianceYear, sdg:submittedBy exactly 1 sdg:Attorney, sdg:triggeredLateFee some sdg:LateFee

Class: sdg:DeficiencyPlan
    Annotations: rdfs:label "Deficiency Plan", iao:0000115 "A formal plan submitted by a noncompliant attorney detailing how they will cure their credit deficiency by a specific deadline."
    SubClassOf: cco:ont00000995, sdg:planId some xsd:string, sdg:submissionDate some xsd:dateTime, sdg:completionDeadline some xsd:date, sdg:planStatus some xsd:string, sdg:goodCauseJustification some xsd:string, sdg:addressesComplianceYear exactly 1 sdg:ComplianceYear, sdg:submittedBy exactly 1 sdg:Attorney, sdg:triggeredLateFee some sdg:LateFee
    HasKey: sdg:planId

Class: sdg:LateFee
    Annotations: rdfs:label "Late Fee", iao:0000115 "A monetary penalty imposed on an attorney for failing to meet MCLE compliance, filing, or reporting deadlines."
    SubClassOf: bfo:0000015, sdg:feeId some xsd:string, sdg:feeAmount some xsd:decimal, sdg:feeType some xsd:string, sdg:impositionDate some xsd:dateTime, sdg:paymentStatus some sdg:PaymentStatusKind, sdg:chargedTo exactly 1 sdg:Attorney, sdg:associatedWithReport some sdg:ComplianceReport, sdg:associatedWithPlan some sdg:DeficiencyPlan

Class: sdg:DisciplinaryReferral
    Annotations: rdfs:label "Disciplinary Referral", iao:0000115 "A formal list or record of attorneys who have failed to comply with MCLE rules, forwarded to the Office of General Counsel for further discipline."
    SubClassOf: cco:ont00000995, sdg:referralId some xsd:string, sdg:referralDate some xsd:dateTime, sdg:referralReason some xsd:string, sdg:forwardedTo some xsd:string, sdg:includesAttorney min 2 sdg:Attorney, sdg:generatedBy exactly 1 sdg:MCLECommission

Class: sdg:MCLECommission
    Annotations: rdfs:label "MCLE Commission", iao:0000115 "The administrative body responsible for overseeing MCLE compliance, approving deficiency plans, and imposing sanctions."
    SubClassOf: bfo:0000040, sdg:commissionId some xsd:string, sdg:commissionName some xsd:string, sdg:executiveDirectorName some xsd:string, sdg:generatesReferral some sdg:DisciplinaryReferral, sdg:approvesDeficiencyPlan some sdg:DeficiencyPlan
    HasKey: sdg:commissionId

Class: sdg:LegislativeAct
    Annotations: rdfs:label "Legislative Act", iao:0000115 "A statutory or regulatory measure enacted by a legislative body that alters legal permissions or restrictions."
    SubClassOf: sdg:LegalEntity, sdg:actIdentifier some xsd:string, sdg:jurisdiction some sdg:JurisdictionKind, sdg:enactmentDate some xsd:date, sdg:status some sdg:StatusKind, sdg:targetChemicalClass some xsd:string, sdg:legalEffect some xsd:string, sdg:actNumber some xsd:string, sdg:shortTitle some xsd:string, sdg:assentDate some xsd:date, sdg:targets some sdg:ChemicalSubstance, sdg:enactedBy exactly 1 sdg:LegislativeBody, sdg:amends some sdg:LegislativeAct, sdg:issuedBy exactly 1 sdg:LegislativeBody
    HasKey: sdg:actNumber

Class: sdg:Governor
    Annotations: rdfs:label "Governor", iao:0000115 "An elected official serving as the chief executive of a US state."
    SubClassOf: bfo:0000002, sdg:governorId some xsd:string, sdg:fullName some xsd:string, sdg:state some xsd:string, sdg:termStartDate some xsd:date, sdg:termEndDate some xsd:date, sdg:priorProfession some xsd:string, sdg:commuteMode some xsd:string, sdg:residesIn exactly 1 sdg:State, sdg:usesVehicle max 1 sdg:Vehicle, sdg:commutesTo exactly 1 sdg:GovernmentOffice

Class: sdg:Vehicle
    Annotations: rdfs:label "Vehicle", iao:0000115 "A manufactured means of transport used for commuting or official duties."
    SubClassOf: sdg:vehicleId some xsd:string, sdg:make some xsd:string, sdg:model some xsd:string, sdg:year some xsd:integer, sdg:fuelType some xsd:string, sdg:emissionLevel some xsd:decimal, sdg:operationalStatus some sdg:OperationalStatusKind, sdg:makeModel some xsd:string, sdg:registrationNumber some xsd:string, sdg:ownerName some xsd:string, sdg:odometerReading some xsd:integer, sdg:inspectionStatus some sdg:InspectionStatusKind, sdg:vin some xsd:string, sdg:mileage some xsd:integer, sdg:customerName some xsd:string, sdg:vehicleModel some xsd:string, sdg:minTurningRadius some xsd:decimal, sdg:currentX some xsd:decimal, sdg:currentY some xsd:decimal, sdg:currentHeading some xsd:decimal, sdg:vehicleStatus some xsd:string, sdg:operatedBy exactly 1 sdg:Driver, sdg:usedBy some sdg:Governor, sdg:hasInspectionRecord min 2 sdg:VehicleInspectionRecord, sdg:contains min 3 sdg:InspectionItem, sdg:ownedBy exactly 1 sdg:Customer, sdg:receives some sdg:RepairJob, sdg:executes some sdg:Route, sdg:senses min 2 sdg:Obstacle, sdg:occupies exactly 1 sdg:Zone

Class: sdg:Driver
    Annotations: rdfs:label "Driver", iao:0000115 "A person or role responsible for operating a vehicle."
    SubClassOf: sdg:Entity, sdg:driverId some xsd:string, sdg:fullName some xsd:string, sdg:employer some sdg:EmployerKind, sdg:licenseNumber some xsd:string, sdg:shiftStatus some xsd:string, sdg:operates exactly 1 sdg:Vehicle

Class: sdg:DisposableProduct
    Annotations: rdfs:label "Disposable Product", iao:0000115 "A manufactured item designed for single-use or short-term disposal."
    SubClassOf: bfo:0000040, sdg:productCode some xsd:string, sdg:productName some xsd:string, sdg:materialComposition some xsd:string, sdg:shelfLife some xsd:integer, sdg:disposalMethod some sdg:DisposalMethodKind, sdg:plannedObsolescence some xsd:boolean, sdg:consumedBy some sdg:Consumer

Class: sdg:Consumer
    Annotations: rdfs:label "Consumer", iao:0000115 "An individual who purchases or uses goods and services."
    SubClassOf: sdg:Entity, sdg:consumerId some xsd:string, sdg:fullName some xsd:string, sdg:residenceState some xsd:string, sdg:lifestyleType some sdg:LifestyleTypeKind, sdg:purchases some sdg:DisposableProduct, sdg:residesIn exactly 1 sdg:State

Class: sdg:HealthIndex
    Annotations: rdfs:label "Health Index", iao:0000115 "A composite metric evaluating population well-being based on life expectancy, happiness, and resource consumption."
    SubClassOf: bfo:0000040, sdg:indexId some xsd:string, sdg:indexName some xsd:string, sdg:calculationDate some xsd:dateTime, sdg:lifeExpectancyScore some xsd:decimal, sdg:happinessScore some xsd:decimal, sdg:ecologicalFootprint some xsd:decimal, sdg:globalRank some xsd:integer, sdg:measures some sdg:State

Class: sdg:AthleticEvent
    Annotations: rdfs:label "Athletic Event", iao:0000115 "A scheduled sports competition or league activity occurring at a specific time and location."
    SubClassOf: sdg:Event, sdg:eventIdentifier some xsd:string, sdg:eventName some xsd:string, sdg:scheduledStart some xsd:dateTime, sdg:scheduledEnd some xsd:dateTime, sdg:status some sdg:StatusKind, sdg:sportType some xsd:string, sdg:heldAt exactly 1 sdg:Facility, sdg:hasParticipant__escalated min 2 sdg:Participant, sdg:hasRegistration min 2 sdg:Registration

Class: sdg:Registration
    Annotations: rdfs:label "Athletic Registration", iao:0000115 "A record of a participant's enrollment in a specific athletic event or league, including fee payment and roster details."
    SubClassOf: sdg:registrationId some xsd:string, sdg:registrationDate some xsd:dateTime, sdg:feeAmount some xsd:decimal, sdg:paymentStatus some sdg:PaymentStatusKind, sdg:rosterNumber some xsd:string, sdg:forEvent exactly 1 sdg:AthleticEvent, sdg:byParticipant exactly 1 sdg:Participant

Class: sdg:DisciplineReport
    Annotations: rdfs:label "Discipline and Injury Report", iao:0000115 "A formal record documenting participant misconduct, injuries, or disputes requiring policy intervention."
    SubClassOf: sdg:reportId some xsd:string, sdg:incidentDate some xsd:dateTime, sdg:incidentType some sdg:IncidentTypeKind, sdg:severityLevel some sdg:SeverityLevelKind, sdg:resolved some xsd:boolean, sdg:forwardedToCoordinator some xsd:boolean, sdg:concernsParticipant exactly 1 sdg:Participant, sdg:occurredAtEvent exactly 1 sdg:AthleticEvent

Class: sdg:AcademicConference
    Annotations: rdfs:label "Academic Conference", iao:0000115 "A scheduled academic event organized by a learned society to facilitate the presentation and discussion of research."
    SubClassOf: sdg:ResearchEntity, sdg:identifier some xsd:string, sdg:title some xsd:string, sdg:startDate some xsd:dateTime, sdg:endDate some xsd:dateTime, sdg:status some sdg:StatusKind, sdg:regionCode some xsd:string, sdg:locationCity some xsd:string, sdg:locationCountry some xsd:string, sdg:hostedBy exactly 1 sdg:AcademicInstitution, sdg:organizedBy exactly 1 sdg:LearnedSociety, sdg:hasSteeringCommittee exactly 1 sdg:SteeringCommittee, sdg:hasProgrammeCommittee exactly 1 sdg:ProgrammeCommittee, sdg:hasLocalOrganizationCommittee exactly 1 sdg:LocalOrganizationCommittee, sdg:organizedBy exactly 1 sdg:SteeringCommittee, sdg:includesSession min 2 sdg:AcademicSession

Class: sdg:LearnedSociety
    Annotations: rdfs:label "Learned Society", iao:0000115 "A non-profit scientific organization dedicated to promoting research and unifying theoretical and empirical approaches in a specific discipline."
    SubClassOf: bfo:0000015, sdg:identifier some xsd:string, sdg:name some sdg:NameKind, sdg:foundingYear some xsd:integer, sdg:status some sdg:StatusKind, sdg:fundingModel some sdg:FundingModelKind, sdg:organizesConference some sdg:AcademicConference

Class: sdg:SteeringCommittee
    Annotations: rdfs:label "Steering Committee", iao:0000115 "The apex administrative body responsible for the overall conduct and oversight of an academic conference."
    SubClassOf: sdg:Organization, sdg:identifier some xsd:string, sdg:roleDetail some sdg:RoleKind, sdg:responsibilityLevel some xsd:string, sdg:committeeName some xsd:string, sdg:chairsConference exactly 1 sdg:AcademicConference, sdg:hasMember min 2 sdg:AcademicResearcher, sdg:interfacesWith exactly 1 sdg:ProgrammeCommittee, sdg:interfacesWith exactly 1 sdg:LocalOrganizationCommittee, sdg:organizesEvent exactly 1 sdg:AcademicConference

Class: sdg:ProgrammeCommittee
    Annotations: rdfs:label "Programme Committee", iao:0000115 "The academic body responsible for selecting invited speakers, reviewing submitted papers, and preparing the conference schedule."
    SubClassOf: bfo:0000015, sdg:identifier some xsd:string, sdg:chairName some xsd:string, sdg:selectionDeadline some xsd:dateTime, sdg:membershipLimit some sdg:MembershipLimitKind, sdg:organizesConference exactly 1 sdg:AcademicConference, sdg:hasChair exactly 1 sdg:AcademicResearcher, sdg:selectsSpeaker some sdg:AcademicResearcher, sdg:reviewsPaper some sdg:AcademicPaper

Class: sdg:LocalOrganizationCommittee
    Annotations: rdfs:label "Local Organization Committee", iao:0000115 "The administrative body responsible for the logistical and operational tasks required to host an academic conference."
    SubClassOf: sdg:Organization, sdg:identifier some xsd:string, sdg:convenorName some xsd:string, sdg:taskCategory some xsd:string, sdg:organizesConference exactly 1 sdg:AcademicConference, sdg:hasMember min 2 sdg:AcademicResearcher, sdg:managesVenue some sdg:AcademicInstitution

Class: sdg:AcademicResearcher
    Annotations: rdfs:label "Academic Researcher", iao:0000115 "A scholar or academic professional engaged in research, teaching, and publication within a specific discipline."
    SubClassOf: bfo:0000015, sdg:identifier some xsd:string, sdg:fullName some xsd:string, sdg:affiliation some sdg:AffiliationKind, sdg:email some xsd:string, sdg:roleDetail some sdg:RoleKind, sdg:isFellow some xsd:boolean, sdg:emailAddress some xsd:string, sdg:roleAtEvent some xsd:string, sdg:affiliatedWith some sdg:AcademicInstitution, sdg:servesOn some sdg:SteeringCommittee, sdg:servesOn some sdg:ProgrammeCommittee, sdg:servesOn some sdg:LocalOrganizationCommittee, sdg:deliversLecture some sdg:AcademicLecture, sdg:submitsPaper some sdg:AcademicPaper, sdg:speaksAt some sdg:AcademicSession

Class: sdg:AcademicLecture
    Annotations: rdfs:label "Academic Lecture", iao:0000115 "A formal presentation or talk delivered by a researcher at an academic conference, often named after a distinguished figure or institution."
    SubClassOf: bfo:0000015, sdg:identifier some xsd:string, sdg:title some xsd:string, sdg:lectureType some sdg:LectureTypeKind, sdg:namedAfter some xsd:string, sdg:scheduledDate some xsd:dateTime, sdg:venueRoom some xsd:string, sdg:partOfConference exactly 1 sdg:AcademicConference, sdg:deliveredBy exactly 1 sdg:AcademicResearcher, sdg:heldAt some sdg:AcademicInstitution

Class: sdg:AcademicPaper
    Annotations: rdfs:label "Academic Paper", iao:0000115 "A scholarly manuscript submitted for review and potential presentation at an academic conference."
    SubClassOf: bfo:0000015, sdg:identifier some xsd:string, sdg:title some xsd:string, sdg:submissionDate some xsd:dateTime, sdg:status some sdg:StatusKind, sdg:isContributed some xsd:boolean, sdg:authorMembershipRequired some xsd:boolean, sdg:submittedTo exactly 1 sdg:AcademicConference, sdg:authoredBy min 1 sdg:AcademicResearcher, sdg:reviewedBy exactly 1 sdg:ProgrammeCommittee

Class: sdg:LegislativeCommittee
    Annotations: rdfs:label "Legislative Committee", iao:0000115 "A formally constituted group of legislators with defined jurisdictional authority over specific policy domains."
    SubClassOf: bfo:0000040, sdg:committeeId some xsd:string, sdg:committeeName some xsd:string, sdg:jurisdictionDescription some xsd:string, sdg:status some sdg:StatusKind, sdg:establishedDate some xsd:date, sdg:hasMember min 2 sdg:Legislator, sdg:hasJurisdictionOver min 2 sdg:PolicyDomain, sdg:holdsMeetingAt some sdg:MeetingVenue
    HasKey: sdg:committeeId

Class: sdg:Legislator
    Annotations: rdfs:label "Legislator", iao:0000115 "An elected or appointed individual serving as a member of a legislative body."
    SubClassOf: bfo:0000004, sdg:legislatorId some xsd:string, sdg:fullName some xsd:string, sdg:roleDetail some sdg:RoleKind, sdg:contactEmail some xsd:string, sdg:contactPhone some xsd:string, sdg:servesOn some sdg:LegislativeCommittee

Class: sdg:PolicyDomain
    Annotations: rdfs:label "Policy Domain", iao:0000115 "A defined area of regulatory or legislative authority, such as environmental protection or public utilities."
    SubClassOf: bfo:0000040, sdg:domainCode some xsd:string, sdg:domainName some xsd:string, sdg:regulatoryScope some xsd:string, sdg:enforcementAgency some xsd:string, sdg:governedBy some sdg:LegislativeCommittee, sdg:overlapsWith some sdg:PolicyDomain

Class: sdg:MeetingVenue
    Annotations: rdfs:label "Meeting Venue", iao:0000115 "A physical location where legislative meetings are convened."
    SubClassOf: bfo:0000002, sdg:venueId some xsd:string, sdg:venueName some xsd:string, sdg:streetAddress some xsd:string, sdg:city some xsd:string, sdg:state some xsd:string, sdg:zipCode some xsd:string, sdg:roomNumber some xsd:string, sdg:hostedMeeting some sdg:CommitteeMeeting

Class: sdg:CommitteeMeeting
    Annotations: rdfs:label "Committee Meeting", iao:0000115 "A scheduled or ad-hoc gathering of a legislative committee to conduct official business."
    SubClassOf: bfo:0000015, sdg:meetingId some xsd:string, sdg:scheduledDateTime some xsd:dateTime, sdg:durationMinutes some xsd:integer, sdg:meetingType some sdg:MeetingTypeKind, sdg:status some sdg:StatusKind, sdg:meetingDate some xsd:dateTime, sdg:startTime some xsd:dateTime, sdg:durationHours some xsd:decimal, sdg:agenda some xsd:string, sdg:convenedBy exactly 1 sdg:LegislativeCommittee, sdg:heldAt exactly 1 sdg:MeetingVenue, sdg:attendedBy min 2 sdg:Legislator, sdg:organizedBy exactly 1 sdg:Committee, sdg:heldAt exactly 1 sdg:Location, sdg:attendedBy min 2 sdg:Physician

Class: sdg:Donor
    Annotations: rdfs:label "Donor", iao:0000115 "A real, independent continuant entity representing an individual or organization providing a financial gift."
    SubClassOf: sdg:donorIdentifier some xsd:string, sdg:donorName some xsd:string, sdg:streetAddress some xsd:string, sdg:city some xsd:string, sdg:state some xsd:string, sdg:zipCode some xsd:string, sdg:emailAddress some xsd:string, sdg:isAnonymous some xsd:boolean, sdg:donorId some xsd:string, sdg:donorType some xsd:string, sdg:totalContributed some xsd:decimal, sdg:lastDonationDate some xsd:date, sdg:isMajorDonor some xsd:boolean, sdg:madeGift some sdg:Donation, sdg:contactedBy some sdg:ContactRequest, sdg:contactedAbout some sdg:ContactRequest, sdg:funds exactly 1 sdg:Organization, sdg:supports some sdg:Program, sdg:contactedBy min 2 sdg:StaffMember

Class: sdg:Honoree
    Annotations: rdfs:label "Honoree", iao:0000115 "A real, independent continuant entity representing a person being memorialized or honored by a gift."
    SubClassOf: bfo:0000040, sdg:honoreeName some xsd:string, sdg:honoreeType some sdg:HonoreeTypeKind, sdg:honoreeId some xsd:string, sdg:isMemorial some xsd:boolean, sdg:honoredBy some sdg:Donation, sdg:notifiedVia some sdg:NotificationContact

Class: sdg:ContactRecipient
    Annotations: rdfs:label "Contact Recipient", iao:0000115 "A real, independent continuant entity representing a person designated to be notified about a memorial or honor gift."
    SubClassOf: bfo:0000040, sdg:recipientName some xsd:string, sdg:streetAddress some xsd:string, sdg:city some xsd:string, sdg:state some xsd:string, sdg:zipCode some xsd:string, sdg:relationship some sdg:RelationshipKind, sdg:notifiedBy some sdg:Donation
    HasKey: sdg:zipCode

Class: sdg:ContactRequest
    Annotations: rdfs:label "Contact Request", iao:0000115 "A material entity representing a donor's expressed interest in volunteering, subscribing to a newsletter, or discussing deferred giving."
    SubClassOf: bfo:0000040, sdg:requestIdentifier some xsd:string, sdg:requestType some xsd:string, sdg:isRequested some xsd:boolean, sdg:requestId some xsd:string, sdg:discussDeferredGiving some xsd:boolean, sdg:volunteerTime some xsd:boolean, sdg:joinNewsletter some xsd:boolean, sdg:submittedBy exactly 1 sdg:Donor, sdg:requestedBy exactly 1 sdg:Donor

Class: sdg:CorporateExecutive
    Annotations: rdfs:label "Corporate Executive", iao:0000115 "A senior individual holding a strategic or operational leadership role within a corporate entity."
    SubClassOf: sdg:BusinessEntity, sdg:fullName some xsd:string, sdg:jobTitle some xsd:string, sdg:reportingLine some xsd:string, sdg:appointmentStatus some sdg:AppointmentStatusKind, sdg:primaryDomain some xsd:string, sdg:roleType some sdg:RoleTypeKind, sdg:reportsTo max 1 sdg:CorporateExecutive, sdg:previouslyEmployedAt some sdg:CorporateEntity, sdg:holdsRoleAt exactly 1 sdg:CorporateEntity

Class: sdg:Consultant
    Annotations: rdfs:label "Consultant", iao:0000115 "An external professional or firm providing specialized advisory services to a corporate entity."
    SubClassOf: cco:ont00000995, sdg:consultantName some xsd:string, sdg:serviceType some sdg:ServiceTypeKind, sdg:contactPhone some xsd:string, sdg:advisorRole some xsd:string, sdg:advises exactly 1 sdg:CorporateEntity, sdg:represents exactly 1 sdg:CorporateEntity

Class: sdg:FinancialAdvisor
    Annotations: rdfs:label "Financial Advisor", iao:0000115 "A specialized consultant providing financial, capital markets, or advisory services to a corporate entity."
    SubClassOf: sdg:FinancialEntity, sdg:advisorFirmName some xsd:string, sdg:serviceCategory some sdg:ServiceCategoryKind, sdg:contactPhone some xsd:string, sdg:advisorRepresentative some xsd:string, sdg:providesFinancialAdviceTo exactly 1 sdg:CorporateEntity, sdg:represents exactly 1 sdg:CorporateEntity

Class: sdg:CommunicationsAdvisor
    Annotations: rdfs:label "Communications Advisor", iao:0000115 "A specialized consultant providing public relations and corporate communications services to a corporate entity."
    SubClassOf: cco:ont00000995, sdg:prFirmName some xsd:string, sdg:serviceCategory some sdg:ServiceCategoryKind, sdg:contactPhone some xsd:string, sdg:prRepresentative some xsd:string, sdg:managesCommunicationsFor exactly 1 sdg:CorporateEntity, sdg:represents exactly 1 sdg:CorporateEntity

Class: sdg:Salad
    Annotations: rdfs:label "Salad", iao:0000115 "A cold dish composed of mixed ingredients, typically greens and vegetables, often served as a starter or side."
    SubClassOf: cco:ont00000995, sdg:saladId some xsd:string, sdg:name some sdg:NameKind, sdg:baseGreens some xsd:string, sdg:dressing some xsd:string, sdg:isChefSpecial some xsd:boolean, sdg:containsIngredient min 2 sdg:Ingredient, sdg:accompanies some sdg:MenuItem

Class: sdg:Pizza
    Annotations: rdfs:label "Pizza", iao:0000115 "A baked dish consisting of a flattened dough base topped with sauce, cheese, and various ingredients."
    SubClassOf: cco:ont00000995, sdg:pizzaId some xsd:string, sdg:name some sdg:NameKind, sdg:sauceType some xsd:string, sdg:crustType some xsd:string, sdg:isSpecialty some xsd:boolean, sdg:containsIngredient min 2 sdg:Ingredient

Class: sdg:Topping
    Annotations: rdfs:label "Topping", iao:0000115 "An additional ingredient added to a pizza or other dish, categorized by its pricing tier and type."
    SubClassOf: sdg:DiningPackage, sdg:toppingId some xsd:string, sdg:name some sdg:NameKind, sdg:tier some xsd:string, sdg:priceAdjustment some xsd:decimal, sdg:addedTo some sdg:Pizza

Class: sdg:ProfessionalSociety
    Annotations: rdfs:label "Professional Society", iao:0000115 "An organized association of professionals in a specific field, established to promote the interests of its members and advance the discipline."
    SubClassOf: bfo:0000040, sdg:societyIdentifier some xsd:string, sdg:societyName some xsd:string, sdg:foundingYear some xsd:integer, sdg:headquartersLocation some xsd:string, sdg:membershipCount some xsd:integer, sdg:primaryDiscipline some xsd:string, sdg:awards some sdg:AcademicAward, sdg:elects some sdg:Researcher, sdg:hosts some sdg:LeadershipPosition

Class: sdg:LeadershipPosition
    Annotations: rdfs:label "Leadership Position", iao:0000115 "A formal role within an organization or society that carries specific responsibilities, authority, and decision-making power."
    SubClassOf: bfo:0000023, sdg:positionIdentifier some xsd:string, sdg:positionTitle some xsd:string, sdg:organizationName some xsd:string, sdg:startDate some xsd:dateTime, sdg:endDate some xsd:dateTime, sdg:positionStatus some xsd:string, sdg:positionId some xsd:string, sdg:sector some sdg:SectorKind, sdg:isCurrent some xsd:boolean, sdg:heldBy exactly 1 sdg:Researcher, sdg:within exactly 1 sdg:ProfessionalSociety, sdg:heldBy exactly 1 sdg:Person, sdg:associatedWith some sdg:Organization

Class: sdg:Scripture
    Annotations: rdfs:label "Scripture", iao:0000115 "A canonical book or collection of sacred texts, such as the Bible, containing divine teachings and historical records."
    SubClassOf: sdg:Book, sdg:bookCount some xsd:integer, sdg:canonicalStatus some xsd:string, sdg:isGodBreathed some xsd:boolean, sdg:totalChapters some xsd:integer, sdg:totalVerses some xsd:integer, sdg:originalLanguage some xsd:string, sdg:isImmutable some xsd:boolean, sdg:contains min 2 sdg:Verse, sdg:partOf__escalated exactly 1 sdg:Testament

Class: sdg:Verse
    Annotations: rdfs:label "Scripture Verse", iao:0000115 "A specific textual unit within a canonical book, identified by book, chapter, and verse number."
    SubClassOf: sdg:Book, sdg:bookReference some xsd:string, sdg:chapterNumber some xsd:integer, sdg:verseNumber some xsd:integer, sdg:textContent some xsd:string, sdg:isPromise some xsd:boolean, sdg:isTeaching some xsd:boolean, sdg:isProphecy some xsd:boolean, sdg:isHistorical some xsd:boolean, sdg:textualUnitGranularity some xsd:string, sdg:partOf__escalated exactly 1 sdg:Scripture, sdg:cites some sdg:Person

Class: sdg:Testament
    Annotations: rdfs:label "Biblical Testament", iao:0000115 "A major division of the Bible, comprising the Old Testament (pre-Christian) and New Testament (post-resurrection)."
    SubClassOf: cco:ont00000958, sdg:name some sdg:NameKind, sdg:isPreChristian some xsd:boolean, sdg:isPostResurrection some xsd:boolean, sdg:containsGospels some xsd:boolean, sdg:containsLaw some xsd:boolean, sdg:containsProphecy some xsd:boolean, sdg:contains min 2 sdg:Scripture

Class: sdg:SalvationEvent
    Annotations: rdfs:label "Salvation Event", iao:0000115 "The spiritual process of being born again through faith in God's Word, resulting in eternal life."
    SubClassOf: sdg:TheologicalConcept, sdg:isInstantaneous some xsd:boolean, sdg:requiresFaith some xsd:boolean, sdg:isByGrace some xsd:boolean, sdg:isThroughWord some xsd:boolean, sdg:isIrreversible some xsd:boolean, sdg:causedBy min 2 sdg:Verse, sdg:affects min 2 sdg:Person

Class: sdg:SpiritualChange
    Annotations: rdfs:label "Spiritual Change", iao:0000115 "The transformative process in a believer's life initiated by receiving and internalizing God's Word."
    SubClassOf: bfo:0000015, sdg:isHealing some xsd:boolean, sdg:isSanctification some xsd:boolean, sdg:isEmpowerment some xsd:boolean, sdg:isOngoing some xsd:boolean, sdg:isInternal some xsd:boolean, sdg:triggeredBy min 2 sdg:Verse, sdg:affects min 2 sdg:Person

Class: sdg:EducationalOrganization
    Annotations: rdfs:label "Educational Organization", iao:0000115 "A formally established nonprofit or independent institution providing education, training, or academic programs."
    SubClassOf: sdg:Organization, sdg:organizationId some xsd:string, sdg:name some sdg:NameKind, sdg:foundingDate some xsd:date, sdg:legalStatus some sdg:LegalStatusKind, sdg:tuitionPolicy some sdg:TuitionPolicyKind, sdg:isStateSupported some xsd:boolean, sdg:occupies some sdg:Building, sdg:hasMember min 2 sdg:Person, sdg:offersProgram some sdg:EducationalProgram, sdg:receivesFundingFrom some sdg:FundingSource
    HasKey: sdg:organizationId

Class: sdg:EducationalProgram
    Annotations: rdfs:label "Educational Program", iao:0000115 "A structured academic offering such as a college, curriculum, or training module delivered by an educational organization."
    SubClassOf: sdg:Program, sdg:programId some xsd:string, sdg:programName some xsd:string, sdg:programType some sdg:ProgramTypeKind, sdg:targetAudience some sdg:TargetAudienceKind, sdg:isDraftExempt some xsd:boolean, sdg:enrollmentCount some xsd:integer, sdg:offeredBy exactly 1 sdg:EducationalOrganization, sdg:deliveredAt some sdg:Building, sdg:hasStudent min 2 sdg:Person

Class: sdg:GovernmentBody
    Annotations: rdfs:label "Government Body", iao:0000115 "A municipal, regional, or national administrative entity that grants leases, issues stipends, or enacts legislation."
    SubClassOf: bfo:0000040, sdg:bodyId some xsd:string, sdg:bodyName some xsd:string, sdg:jurisdictionLevel some sdg:JurisdictionLevelKind, sdg:headOfficial some xsd:string, sdg:countryCode some sdg:CountryCodeKind, sdg:policyStatus some sdg:PolicyStatusKind, sdg:budgetAllocation some xsd:decimal, sdg:coordinationLevel some sdg:CoordinationLevelKind, sdg:lastPolicyReview some xsd:date, sdg:grantsLeaseTo some sdg:EducationalOrganization, sdg:issuesStipendsFor some sdg:Award, sdg:enactsLegislationFor some sdg:Policy, sdg:receivesRecommendationFrom some sdg:PolicyRecommendation, sdg:funds some sdg:NutritionUnit, sdg:employs some sdg:StaffMember, sdg:coordinatesWith some sdg:FundingAgency

Class: sdg:BullyingIncident
    Annotations: rdfs:label "Bullying Incident", iao:0000115 "A repeated or intentional harmful behavior involving an imbalance of power between individuals or groups within the college community."
    SubClassOf: bfo:0000015, sdg:incidentId some xsd:string, sdg:incidentDate some xsd:dateTime, sdg:severityLevel some sdg:SeverityLevelKind, sdg:isRepeated some xsd:boolean, sdg:isCyberBullying some xsd:boolean, sdg:description some xsd:string, sdg:location some xsd:string, sdg:status some sdg:StatusKind, sdg:dateReported some xsd:date, sdg:incidentType some sdg:IncidentTypeKind, sdg:reportedBy exactly 1 sdg:Person, sdg:targetedBy exactly 1 sdg:Person, sdg:perpetratedBy some sdg:Person, sdg:classifiedAs some sdg:BullyingType, sdg:handledBy exactly 1 sdg:StaffRole, sdg:involvesVictim min 1 sdg:Student, sdg:involvesPerpetrator min 1 sdg:Student, sdg:recordedBy exactly 1 sdg:StaffMember, sdg:escalatedTo max 1 sdg:ExternalAuthority

Class: sdg:StaffRole
    Annotations: rdfs:label "Staff Role", iao:0000115 "A specific responsibility or position held by staff members within the college, such as Student Progress Leader or Headteacher."
    SubClassOf: bfo:0000023, sdg:roleId some xsd:string, sdg:roleName some xsd:string, sdg:responsibilities some xsd:string, sdg:isPolicyOwner some xsd:boolean, sdg:yearGroup some xsd:string, sdg:roleIdentifier some xsd:string, sdg:department some xsd:string, sdg:receivesServiceCharge some xsd:boolean, sdg:receivesDirectTips some xsd:boolean, sdg:roleCode some xsd:string, sdg:roleTitle some sdg:RoleTitleKind, sdg:certificationLevel some xsd:string, sdg:trainingCompletionDate some xsd:date, sdg:accessLevel some sdg:AccessLevelKind, sdg:heldBy exactly 1 sdg:Person, sdg:manages some sdg:BullyingIncident, sdg:assignedTo some sdg:ServiceCharge, sdg:servesCourse some sdg:MenuCourse, sdg:executes min 2 sdg:SafeguardingProcedure, sdg:initiates min 2 sdg:IncidentReport, sdg:assignedTo min 2 sdg:Student
    HasKey: sdg:roleId

Class: sdg:BullyingType
    Annotations: rdfs:label "Bullying Type", iao:0000115 "A specific category or form of bullying behavior, such as cyberbullying, racist bullying, or physical assault."
    SubClassOf: bfo:0000015, sdg:typeId some xsd:string, sdg:typeName some xsd:string, sdg:description some xsd:string, sdg:isCyberBullying some xsd:boolean, sdg:isPhysical some xsd:boolean, sdg:isVerbal some xsd:boolean, sdg:classifiedAs some sdg:BullyingIncident

Class: sdg:PolicyReview
    Annotations: rdfs:label "Policy Review", iao:0000115 "A scheduled or ad-hoc evaluation of the anti-bullying policy to assess its effectiveness and make necessary updates."
    SubClassOf: bfo:0000015, sdg:reviewId some xsd:string, sdg:reviewDate some xsd:dateTime, sdg:reviewStatus some sdg:ReviewStatusKind, sdg:reviewer some xsd:string, sdg:findings some xsd:string, sdg:recommendations some xsd:string, sdg:conductedBy exactly 1 sdg:Person, sdg:updates exactly 1 sdg:PolicyDocument

Class: sdg:Director
    Annotations: rdfs:label "Director", iao:0000115 "A person who serves on the board of directors of a corporate entity, holding specific roles and functions within the organization's governance structure."
    SubClassOf: bfo:0000040, sdg:directorId some xsd:string, sdg:fullName some xsd:string, sdg:roleType some sdg:RoleTypeKind, sdg:appointmentDate some xsd:date, sdg:status some sdg:StatusKind, sdg:servesOn exactly 1 sdg:Board, sdg:holdsRoleIn some sdg:BoardCommittee

Class: sdg:Board
    Annotations: rdfs:label "Board of Directors", iao:0000115 "The collective governing body of a corporate entity, composed of directors who exercise oversight and strategic decision-making authority."
    SubClassOf: bfo:0000040, sdg:boardId some xsd:string, sdg:establishmentDate some xsd:date, sdg:jurisdiction some sdg:JurisdictionKind, sdg:status some sdg:StatusKind, sdg:composedOf min 3 sdg:Director

Class: sdg:BoardCommittee
    Annotations: rdfs:label "Board Committee", iao:0000115 "A sub-group of the board of directors established to handle specific governance functions such as audit, remuneration, or nomination matters."
    SubClassOf: bfo:0000040, sdg:committeeId some xsd:string, sdg:committeeName some xsd:string, sdg:establishmentDate some xsd:date, sdg:status some sdg:StatusKind, sdg:hasChairperson max 1 sdg:Director, sdg:hasMember min 2 sdg:Director

Class: sdg:RegulatoryAdvisoryQuestion
    Annotations: rdfs:label "Regulatory Advisory Question", iao:0000115 "A formal inquiry posed by a regulatory commission to an expert advisor regarding financial modeling assumptions and regulatory methodology."
    SubClassOf: cco:ont00000958, sdg:questionId some xsd:string, sdg:questionText some xsd:string, sdg:paraphrased some xsd:boolean, sdg:askedDate some xsd:dateTime, sdg:respondedInReportParagraph some xsd:string, sdg:respondedBy exactly 1 sdg:ExpertAdvisoryReport, sdg:addressedBy some sdg:FinancialModelingAssumption
    HasKey: sdg:questionId

Class: sdg:ExpertAdvisoryReport
    Annotations: rdfs:label "Expert Advisory Report", iao:0000115 "A formal document containing expert analysis and responses to specific regulatory inquiries regarding financial and regulatory parameters."
    SubClassOf: cco:ont00000958, sdg:reportId some xsd:string, sdg:authorName some xsd:string, sdg:publicationDate some xsd:date, sdg:reportTitle some xsd:string, sdg:commissionName some xsd:string, sdg:containsResponseTo min 2 sdg:RegulatoryAdvisoryQuestion, sdg:discusses some sdg:FinancialModelingAssumption

Class: sdg:FinancialModelingAssumption
    Annotations: rdfs:label "Financial Modeling Assumption", iao:0000115 "A specific parameter, rate, or methodological choice used in financial calculations for regulatory cost of capital and risk assessment."
    SubClassOf: cco:ont00000995, sdg:assumptionId some xsd:string, sdg:assumptionType some xsd:string, sdg:parameterName some xsd:string, sdg:valueRangeLowerBound some xsd:decimal, sdg:valueRangeUpperBound some xsd:decimal, sdg:isBenchmark some xsd:boolean, sdg:status some sdg:StatusKind, sdg:usedInCalculationOf exactly 1 sdg:CostOfCapital, sdg:referencedBy some sdg:RegulatoryAdvisoryQuestion

Class: sdg:CostOfCapital
    Annotations: rdfs:label "Cost of Capital", iao:0000115 "A calculated financial metric representing the opportunity cost of funding, used to discount future cash flows or losses in regulatory contexts."
    SubClassOf: bfo:0000015, sdg:costId some xsd:string, sdg:calculationDate some xsd:dateTime, sdg:discountRate some xsd:decimal, sdg:riskFreeRate some xsd:decimal, sdg:betaEstimate some xsd:decimal, sdg:methodology some xsd:string, sdg:usesAssumption min 2 sdg:FinancialModelingAssumption, sdg:appliedTo some sdg:InvestmentProject

Class: sdg:InvestmentProject
    Annotations: rdfs:label "Investment Project", iao:0000115 "A specific infrastructure or capital investment initiative funded by a provider, subject to regulatory cost of capital calculations."
    SubClassOf: cco:ont00000995, sdg:projectId some xsd:string, sdg:providerName some xsd:string, sdg:fundingSource some sdg:FundingSourceKind, sdg:totalValue some xsd:decimal, sdg:implementationStatus some sdg:ImplementationStatusKind, sdg:riskCategory some sdg:RiskCategoryKind, sdg:fundedBy exactly 1 sdg:CostOfCapital, sdg:subjectTo some sdg:RegulatoryAdvisoryQuestion

Class: sdg:MembershipTransferRequest
    Annotations: rdfs:label "Membership Transfer Request", iao:0000115 "A record of a formal request to transfer a BPRO membership from one individual to another or to allow a departing employee to retain it."
    SubClassOf: sdg:requestId some xsd:string, sdg:submissionDate some xsd:dateTime, sdg:status some sdg:StatusKind, sdg:transferReason some xsd:string, sdg:processingDays some xsd:integer, sdg:submittedBy exactly 1 sdg:RequestSubmitter, sdg:involvesOriginalMember exactly 1 sdg:BPROMember, sdg:involvesRecipient exactly 1 sdg:BPROMember, sdg:coversPrograms min 2 sdg:BenefitProgram
    HasKey: sdg:requestId

Class: sdg:RequestSubmitter
    Annotations: rdfs:label "Request Submitter", iao:0000115 "An individual who submits the membership transfer request on behalf of the agency or member."
    SubClassOf: bfo:0000002, sdg:submitterName some xsd:string, sdg:submitterEmail some xsd:string, sdg:submitsRequest min 2 sdg:MembershipTransferRequest

Class: sdg:BPROMember
    Annotations: rdfs:label "BPRO Member", iao:0000115 "An individual who holds or held a BPRO membership, either as the original member or the recipient."
    SubClassOf: bfo:0000002, sdg:memberName some xsd:string, sdg:memberEmail some xsd:string, sdg:isFormerMember some xsd:boolean, sdg:membershipDurationMonths some xsd:integer, sdg:membershipType some sdg:MembershipTypeKind, sdg:isOriginalMemberOf max 1 sdg:MembershipTransferRequest, sdg:isRecipientOf max 1 sdg:MembershipTransferRequest

Class: sdg:BenefitProgram
    Annotations: rdfs:label "Benefit Program", iao:0000115 "A specific social service or benefit program administered by the agency, such as Medicaid or TANF."
    SubClassOf: sdg:Program, sdg:programCode some xsd:string, sdg:programName some xsd:string, sdg:programType some sdg:ProgramTypeKind, sdg:isCoveredByRequest min 2 sdg:MembershipTransferRequest

Class: sdg:AcademicAdvisor
    Annotations: rdfs:label "Academic Advisor", iao:0000115 "A faculty or staff member assigned to guide a student's academic progress."
    SubClassOf: bfo:0000004, sdg:name some sdg:NameKind, sdg:advises some sdg:Student

Class: sdg:CurriculumRequirement
    Annotations: rdfs:label "Curriculum Requirement", iao:0000115 "A specific category of coursework or proficiency required for degree completion."
    SubClassOf: sdg:EducationalEntity, sdg:name some sdg:NameKind, sdg:requiredCredits some xsd:integer, sdg:status some sdg:StatusKind, sdg:requiresCourse min 2 sdg:Course, sdg:partOfProgram exactly 1 sdg:DegreeProgram

Class: sdg:TransferCreditRecord
    Annotations: rdfs:label "Transfer Credit Record", iao:0000115 "A record of academic credits earned at another institution and applied to the current degree."
    SubClassOf: cco:ont00000995, sdg:sourceInstitution some xsd:string, sdg:creditsApplied some xsd:integer, sdg:evaluationStatus some xsd:string, sdg:appliedToStudent exactly 1 sdg:Student, sdg:satisfiesRequirement some sdg:CurriculumRequirement

Class: sdg:StudentPlacement
    Annotations: rdfs:label "Student Placement Record", iao:0000115 "A formal record of a student's admission and ongoing enrollment at the school, capturing their needs, funding status, and placement details."
    SubClassOf: sdg:EducationalEntity, sdg:placementId some xsd:string, sdg:startDate some xsd:dateTime, sdg:status some sdg:StatusKind, sdg:fundingSource some sdg:FundingSourceKind, sdg:riskAssessmentStatus some sdg:RiskAssessmentStatusKind, sdg:interviewCompleted some xsd:boolean, sdg:hasStudent exactly 1 sdg:Student, sdg:linkedToEHCP exactly 1 sdg:EducationHealthCarePlan, sdg:fundedByLEA max 1 sdg:LocalEducationAuthority, sdg:requiresTraining some sdg:StaffProfessionalDevelopment

Class: sdg:EducationHealthCarePlan
    Annotations: rdfs:label "Education Health and Care Plan", iao:0000115 "A legal document outlining the educational, health, and social care needs of a student, required for admission."
    SubClassOf: cco:ont00000958, sdg:ehcpId some xsd:string, sdg:issueDate some xsd:date, sdg:reviewDate some xsd:dateTime, sdg:status some sdg:StatusKind, sdg:fundingAgreed some xsd:boolean, sdg:issuingLEA some xsd:string, sdg:fundingStatus some sdg:FundingStatusKind, sdg:legalStatus some sdg:LegalStatusKind, sdg:belongsToStudent exactly 1 sdg:Student, sdg:issuedByLea exactly 1 sdg:LocalEducationAuthority, sdg:coversStudent exactly 1 sdg:Student

Class: sdg:LocalEducationAuthority
    Annotations: rdfs:label "Local Education Authority", iao:0000115 "A governmental body responsible for special educational needs provision and funding for students in a specific region."
    SubClassOf: sdg:Authority, sdg:leaCode some xsd:string, sdg:regionName some xsd:string, sdg:contactEmail some xsd:string, sdg:fundingStatus some sdg:FundingStatusKind, sdg:issuesEhcp some sdg:EducationHealthCarePlan, sdg:fundsPlacements some sdg:StudentPlacement, sdg:responsibilityScope some sdg:SpecialEducationalNeedsProvision

Class: sdg:HealthSafetyRiskAssessment
    Annotations: rdfs:label "Health and Safety Risk Assessment", iao:0000115 "A process to evaluate and mitigate health and safety risks associated with a student's admission and presence at the school."
    SubClassOf: bfo:0000015, sdg:assessmentId some xsd:string, sdg:assessmentDate some xsd:dateTime, sdg:riskLevel some sdg:RiskLevelKind, sdg:mitigationSteps some xsd:string, sdg:completedByDetail some xsd:string, sdg:mitigationPlan some xsd:string, sdg:status some sdg:StatusKind, sdg:assessesStudent exactly 1 sdg:Student, sdg:linkedToPlacement exactly 1 sdg:StudentPlacement, sdg:linkedToApplication exactly 1 sdg:AdmissionApplication, sdg:informsStaffTraining some sdg:StaffTrainingModule

Class: sdg:StaffProfessionalDevelopment
    Annotations: rdfs:label "Staff Professional Development Record", iao:0000115 "A record of additional training provided to staff to address specific student needs that exceed current staff capabilities."
    SubClassOf: cco:ont00000995, sdg:trainingId some xsd:string, sdg:trainingDate some xsd:date, sdg:topic some xsd:string, sdg:status some sdg:StatusKind, sdg:staffMemberId some xsd:string, sdg:triggeredByPlacement some sdg:StudentPlacement, sdg:assignedToStaff some sdg:StaffMember

Class: sdg:SmallGroupSession
    Annotations: rdfs:label "Small Group Discussion Session", iao:0000115 "A facilitated group discussion event focused on relational and spiritual development topics."
    SubClassOf: bfo:0000015, sdg:sessionId some xsd:string, sdg:sessionDate some xsd:dateTime, sdg:facilitatorName some xsd:string, sdg:topicTheme some xsd:string, sdg:discussionFormat some xsd:string, sdg:attendanceCount some xsd:integer, sdg:focusesOn some sdg:RelationalConcept, sdg:includesQuestion min 2 sdg:DiscussionQuestion

Class: sdg:RelationalConcept
    Annotations: rdfs:label "Relational Concept or Theme", iao:0000115 "A defined abstract concept or theme related to interpersonal relationships, self-care, or spiritual practice."
    SubClassOf: cco:ont00000995, sdg:conceptId some xsd:string, sdg:conceptName some xsd:string, sdg:conceptCategory some xsd:string, sdg:description some xsd:string, sdg:scriptureReference some xsd:string, sdg:discussedIn some sdg:SmallGroupSession

Class: sdg:DiscussionQuestion
    Annotations: rdfs:label "Small Group Discussion Question", iao:0000115 "A specific prompt or inquiry posed to participants during a small group session to facilitate reflection."
    SubClassOf: cco:ont00000995, sdg:questionId some xsd:string, sdg:questionText some xsd:string, sdg:questionNumber some xsd:integer, sdg:requiresPersonalReflection some xsd:boolean, sdg:referencesScripture some xsd:boolean, sdg:belongsToSession exactly 1 sdg:SmallGroupSession, sdg:targetsConcept some sdg:RelationalConcept

Class: sdg:FinancialSupportRecord
    Annotations: rdfs:label "Financial Support Record", iao:0000115 "A record of financial support needs and contributions for a specific period or initiative."
    SubClassOf: cco:ont00000958, sdg:recordId some xsd:string, sdg:recordDate some xsd:date, sdg:amountNeeded some xsd:decimal, sdg:amountGiven some xsd:decimal, sdg:fundingGap some xsd:decimal, sdg:supportStatus some xsd:string, sdg:supportsInitiative exactly 1 sdg:MarriagePrayerFocus
    HasKey: sdg:recordId

Class: sdg:MarriagePrayerFocus
    Annotations: rdfs:label "Marriage Prayer Focus", iao:0000115 "A specific spiritual intention or prayer focus directed towards strengthening marriages and relationships."
    SubClassOf: bfo:0000015, sdg:focusId some xsd:string, sdg:focusMonth some xsd:string, sdg:primaryIntention some xsd:string, sdg:targetGroup some xsd:string, sdg:communityGoal some xsd:string, sdg:hasSupportRecord some sdg:FinancialSupportRecord, sdg:promotes some sdg:GrowGroupCommunity

Class: sdg:GrowGroupCommunity
    Annotations: rdfs:label "Grow Group Community", iao:0000115 "A structured relational environment or community group designed to encourage and equip participants."
    SubClassOf: sdg:CommunityEntity, sdg:groupId some xsd:string, sdg:groupName some xsd:string, sdg:groupType some sdg:GroupTypeKind, sdg:durationWeeks some xsd:integer, sdg:costPerCouple some xsd:decimal, sdg:startDate some xsd:dateTime, sdg:registrationStatus some sdg:RegistrationStatusKind, sdg:serves some sdg:MarriagePrayerFocus, sdg:hostsSession min 2 sdg:SmallGroupSession

Class: sdg:StandardWeightOrMeasure
    Annotations: rdfs:label "Standard Weight or Measure", iao:0000115 "A physical artifact or reference sample maintained as the official standard for weight or measure, certified by the National Bureau of Standards and stored in the Governor's office."
    SubClassOf: cco:ont00000995, sdg:standardIdentifier some xsd:string, sdg:certificationDate some xsd:date, sdg:lastCertificationDate some xsd:date, sdg:nextCertificationDueDate some xsd:date, sdg:storageLocation some xsd:string, sdg:certificationStatus some sdg:CertificationStatusKind, sdg:standardType some xsd:string, sdg:isPrimaryStandard some xsd:boolean, sdg:storedIn exactly 1 sdg:SecureStorageFacility, sdg:certifiedBy exactly 1 sdg:CertificationAuthority, sdg:usedForVerificationOf some sdg:FieldStandard

Class: sdg:SecureStorageFacility
    Annotations: rdfs:label "Secure Storage Facility", iao:0000115 "A designated secure location within the Governor's office where official standards of weight and measure are kept and maintained."
    SubClassOf: bfo:0000015, sdg:facilityIdentifier some xsd:string, sdg:facilityName some xsd:string, sdg:locationDescription some xsd:string, sdg:securityLevel some sdg:SecurityLevelKind, sdg:accessControlPolicy some xsd:string, sdg:isAuthorizedForRemoval some xsd:boolean, sdg:housesStandard some sdg:StandardWeightOrMeasure, sdg:managedBy exactly 1 sdg:GovernmentOffice

Class: sdg:CertificationAuthority
    Annotations: rdfs:label "Certification Authority", iao:0000115 "The National Bureau of Standards, an organization responsible for certifying the accuracy and suitability of official standards of weight and measure."
    SubClassOf: sdg:Authority, sdg:authorityIdentifier some xsd:string, sdg:authorityName some xsd:string, sdg:certificationProtocol some xsd:string, sdg:certificationFrequency some xsd:integer, sdg:isFederalAgency some xsd:boolean, sdg:certificationScope some xsd:string, sdg:certifiesStandard some sdg:StandardWeightOrMeasure, sdg:issuesCertificationFor some sdg:StandardWeightOrMeasure

Class: sdg:FieldStandard
    Annotations: rdfs:label "Field Standard", iao:0000115 "A portable or operational standard of weight or measure used in the field, verified against the primary standards maintained in the Governor's office."
    SubClassOf: cco:ont00000995, sdg:fieldStandardIdentifier some xsd:string, sdg:verificationDate some xsd:dateTime, sdg:verificationStatus some sdg:VerificationStatusKind, sdg:usageContext some xsd:string, sdg:isPortable some xsd:boolean, sdg:lastCalibrationDate some xsd:date, sdg:verifiedBy exactly 1 sdg:StandardWeightOrMeasure

Class: sdg:GovernmentOffice
    Annotations: rdfs:label "Government Office", iao:0000115 "An official administrative office, such as the Governor's office or the Secretary of Commerce's office, responsible for housing and managing standards of weight and measure."
    SubClassOf: bfo:0000015, sdg:officeIdentifier some xsd:string, sdg:officeName some xsd:string, sdg:officeType some sdg:OfficeTypeKind, sdg:jurisdictionLevel some sdg:JurisdictionLevelKind, sdg:isResponsibleForStandards some xsd:boolean, sdg:housesStandard some sdg:StandardWeightOrMeasure, sdg:managesFacility some sdg:SecureStorageFacility, sdg:overseesFunction some sdg:WeightsAndMeasuresFunction

Class: sdg:WeightsAndMeasuresFunction
    Annotations: rdfs:label "Weights and Measures Function", iao:0000115 "The administrative and regulatory activity related to the maintenance, certification, and verification of standards of weight and measure, transferred from the Governor to the Secretary of Commerce."
    SubClassOf: bfo:0000015, sdg:functionIdentifier some xsd:string, sdg:functionName some xsd:string, sdg:functionStatus some sdg:FunctionStatusKind, sdg:transferDate some xsd:dateTime, sdg:originalResponsibleOffice some xsd:string, sdg:currentResponsibleOffice some xsd:string, sdg:managedBy exactly 1 sdg:GovernmentOffice, sdg:involvesStandard some sdg:StandardWeightOrMeasure, sdg:involvesFieldStandard some sdg:FieldStandard

Class: sdg:SchoolLibrarian
    Annotations: rdfs:label "School Librarian", iao:0000115 "A person who serves as a professional librarian within a school, providing leadership, instruction, and support for digital learning and library programs."
    SubClassOf: bfo:0000040, sdg:librarianId some xsd:string, sdg:fullName some xsd:string, sdg:employmentStatus some sdg:EmploymentStatusKind, sdg:certificationLevel some xsd:string, sdg:yearsOfExperience some xsd:integer, sdg:currentRole some xsd:string, sdg:worksAt exactly 1 sdg:School, sdg:leads some sdg:LibraryProgram, sdg:partnersWith some sdg:Educator
    HasKey: sdg:librarianId

Class: sdg:LibraryProgram
    Annotations: rdfs:label "Library Program", iao:0000115 "A structured set of activities, resources, and spaces managed by a school librarian to support student learning, inquiry, and digital literacy."
    SubClassOf: sdg:Program, sdg:programId some xsd:string, sdg:programName some xsd:string, sdg:programType some sdg:ProgramTypeKind, sdg:startDate some xsd:dateTime, sdg:endDate some xsd:dateTime, sdg:isActive some xsd:boolean, sdg:targetAudience some sdg:TargetAudienceKind, sdg:managedBy exactly 1 sdg:SchoolLibrarian, sdg:usesSpace some sdg:FlexibleSpace, sdg:integrates some sdg:DigitalResource, sdg:supportsGoal some sdg:FutureReadyGoal

Class: sdg:FlexibleSpace
    Annotations: rdfs:label "Flexible Space", iao:0000115 "A physical or virtual area within a school library designed to promote inquiry, creativity, collaboration, and community engagement through adaptable configurations."
    SubClassOf: bfo:0000040, sdg:spaceId some xsd:string, sdg:spaceName some xsd:string, sdg:spaceType some xsd:string, sdg:capacity some xsd:integer, sdg:equipmentProvided some xsd:string, sdg:isBookable some xsd:boolean, sdg:accessibilityCompliant some xsd:boolean, sdg:locatedIn exactly 1 sdg:School, sdg:supportsActivity some sdg:LibraryProgram

Class: sdg:DigitalResource
    Annotations: rdfs:label "Digital Resource", iao:0000115 "An electronic tool, content, or service used to support teaching, learning, and digital literacy within a school or district."
    SubClassOf: sdg:DataEntity, sdg:resourceId some xsd:string, sdg:resourceName some xsd:string, sdg:resourceType some sdg:ResourceTypeKind, sdg:accessLevel some sdg:AccessLevelKind, sdg:cost some xsd:decimal, sdg:lastUpdated some xsd:dateTime, sdg:isEquitable some xsd:boolean, sdg:lifecycleStatus some xsd:string, sdg:title some xsd:string, sdg:format some sdg:FormatKind, sdg:dateCreated some xsd:dateTime, sdg:dateModified some xsd:dateTime, sdg:sizeBytes some xsd:integer, sdg:status some sdg:StatusKind, sdg:usedIn some sdg:LibraryProgram, sdg:taggedWith min 2 sdg:SocialTag, sdg:indexedBy some sdg:ControlledTerm, sdg:ownedBy exactly 1 sdg:User, sdg:partOfCollection exactly 1 sdg:DigitalCollection

Class: sdg:CommunityPartnership
    Annotations: rdfs:label "Community Partnership", iao:0000115 "A formal or informal collaboration between a school library and external entities such as families, non-profits, government agencies, or public libraries to enhance learning and engagement."
    SubClassOf: bfo:0000040, sdg:partnershipId some xsd:string, sdg:partnershipName some xsd:string, sdg:partnerType some sdg:PartnerTypeKind, sdg:startDate some xsd:dateTime, sdg:endDate some xsd:dateTime, sdg:isActive some xsd:boolean, sdg:focusArea some sdg:FocusAreaKind, sdg:initiatedBy exactly 1 sdg:SchoolLibrarian, sdg:collaboratesWith exactly 1 sdg:School, sdg:providesResource some sdg:DigitalResource
    HasKey: sdg:partnershipId

Class: sdg:FutureReadyGoal
    Annotations: rdfs:label "Future Ready Goal", iao:0000115 "A strategic objective within the Future Ready Schools framework that guides the integration of digital tools, equitable access, and collaborative leadership in education."
    SubClassOf: bfo:0000040, sdg:goalId some xsd:string, sdg:goalName some xsd:string, sdg:goalCategory some xsd:string, sdg:priorityLevel some sdg:PriorityLevelKind, sdg:isMet some xsd:boolean, sdg:lastAssessed some xsd:date, sdg:pursuedBy exactly 1 sdg:School, sdg:supportedBy some sdg:LibraryProgram, sdg:measuredBy some sdg:Assessment
    HasKey: sdg:goalId

Class: sdg:Malware
    Annotations: rdfs:label "Malware", iao:0000115 "A malicious software program designed to disrupt, damage, or gain unauthorized access to computer systems."
    SubClassOf: bfo:0000040, sdg:identifier some xsd:string, sdg:name some sdg:NameKind, sdg:family some xsd:string, sdg:firstSeen some xsd:dateTime, sdg:lastSeen some xsd:dateTime, sdg:severity some sdg:SeverityKind, sdg:detectedBy some sdg:DetectionRule, sdg:associatedWith some sdg:IndicatorOfCompromise, sdg:targeted some sdg:NetworkSegment

Class: sdg:IndicatorOfCompromise
    Annotations: rdfs:label "Indicator of Compromise", iao:0000115 "An artifact, trace, or data point that indicates a potential computer intrusion or compromise."
    SubClassOf: sdg:iocId some xsd:string, sdg:type some sdg:TypeKind, sdg:value some xsd:decimal, sdg:confidence some xsd:decimal, sdg:firstObserved some xsd:dateTime, sdg:lastObserved some xsd:dateTime, sdg:status some sdg:StatusKind, sdg:associatedWith some sdg:Malware, sdg:reportedBy some sdg:Organization, sdg:partOf__escalated some sdg:ThreatIntelligenceReport

Class: sdg:ThreatIntelligenceReport
    Annotations: rdfs:label "Threat Intelligence Report", iao:0000115 "A structured document containing analysis of cyber threats, indicators, and associated malware."
    SubClassOf: sdg:SecurityAndSafetyMeasure, sdg:reportId some xsd:string, sdg:title some xsd:string, sdg:publishedDate some xsd:date, sdg:classification some sdg:ClassificationKind, sdg:author some xsd:string, sdg:status some sdg:StatusKind, sdg:documentType some sdg:DocumentTypeKind, sdg:contains min 2 sdg:IndicatorOfCompromise, sdg:analyzes some sdg:Malware, sdg:publishedBy exactly 1 sdg:Organization

Class: sdg:NetworkSegment
    Annotations: rdfs:label "Network Segment", iao:0000115 "A logical or physical subdivision of a computer network, often managed as a distinct security zone."
    SubClassOf: sdg:NetworkEntity, sdg:segmentId some xsd:string, sdg:name some sdg:NameKind, sdg:ipRange some xsd:string, sdg:securityZone some xsd:string, sdg:status some sdg:StatusKind, sdg:securityLevel some sdg:SecurityLevelKind, sdg:firewallEnabled some xsd:boolean, sdg:lastAuditDate some xsd:date, sdg:connectedDevicesCount some xsd:integer, sdg:segmentName some xsd:string, sdg:subnetMask some xsd:string, sdg:gatewayIp some xsd:string, sdg:locationType some sdg:LocationTypeKind, sdg:isolationLevel some xsd:string, sdg:targeted some sdg:Malware, sdg:monitoredBy some sdg:SecuritySystem, sdg:contains min 2 sdg:Host, sdg:hosts some sdg:AeroScopeSystem, sdg:communicatesWith some sdg:DjiServer, sdg:monitoredBy some sdg:SecurityPolicy, sdg:containsDevice min 2 sdg:NetworkDevice, sdg:securedBy exactly 1 sdg:VpnServer

Class: sdg:Host
    Annotations: rdfs:label "Host", iao:0000115 "A physical or virtual computer system connected to a network."
    SubClassOf: bfo:0000040, sdg:hostId some xsd:string, sdg:hostname some xsd:string, sdg:ipAddress some xsd:string, sdg:osType some xsd:string, sdg:status some sdg:StatusKind, sdg:partOf__escalated exactly 1 sdg:NetworkSegment, sdg:infectedBy some sdg:Malware, sdg:monitoredBy some sdg:SecuritySystem

Class: sdg:SecuritySystem
    Annotations: rdfs:label "Security System", iao:0000115 "A software or hardware component responsible for monitoring and protecting network and host security."
    SubClassOf: bfo:0000040, sdg:systemId some xsd:string, sdg:name some sdg:NameKind, sdg:type some sdg:TypeKind, sdg:version some xsd:string, sdg:status some sdg:StatusKind, sdg:monitors some sdg:NetworkSegment, sdg:monitors some sdg:Host, sdg:generates some sdg:DetectionRule

Class: sdg:DetectionRule
    Annotations: rdfs:label "Detection Rule", iao:0000115 "A set of conditions or patterns used to identify malicious activity or indicators of compromise."
    SubClassOf: bfo:0000040, sdg:ruleId some xsd:string, sdg:name some sdg:NameKind, sdg:pattern some xsd:string, sdg:severity some sdg:SeverityKind, sdg:status some sdg:StatusKind, sdg:generatedBy some sdg:SecuritySystem, sdg:detects some sdg:Malware, sdg:matches some sdg:IndicatorOfCompromise

Class: sdg:EngagementAward
    Annotations: rdfs:label "Engagement Award", iao:0000115 "A formal funding instrument issued by PCORI to support stakeholder engagement activities in patient-centered outcomes research."
    SubClassOf: cco:ont00000995, sdg:awardId some xsd:string, sdg:awardAmount some xsd:decimal, sdg:awardDate some xsd:date, sdg:awardStatus some xsd:string, sdg:fundingProgram some xsd:string, sdg:reviewOutcome some sdg:ReviewOutcomeKind, sdg:fundedBy exactly 1 sdg:FundingAgency, sdg:awardedTo exactly 1 sdg:ResearchProject, sdg:evaluatedBy some sdg:ReviewPanel
    HasKey: sdg:awardId

Class: sdg:ResearchProject
    Annotations: rdfs:label "Research Project", iao:0000115 "A structured investigation or development activity aimed at understanding how Patient-Family Advisory Councils engage with patient-centered outcomes research."
    SubClassOf: sdg:projectId some xsd:string, sdg:projectTitle some xsd:string, sdg:startDate some xsd:dateTime, sdg:endDate some xsd:dateTime, sdg:projectStatus some sdg:ProjectStatusKind, sdg:primaryObjective some sdg:PrimaryObjectiveKind, sdg:deliverableCount some xsd:integer, sdg:projectIdentifier some xsd:string, sdg:status some sdg:StatusKind, sdg:fundingAmount some xsd:decimal, sdg:fundingSource some sdg:FundingSourceKind, sdg:departmentId some xsd:string, sdg:schoolId some xsd:string, sdg:universityId some xsd:string, sdg:projectCode some xsd:string, sdg:isCompleted some xsd:boolean, sdg:methodologyType some xsd:string, sdg:fundingAgency some xsd:string, sdg:grantAmount some xsd:decimal, sdg:projectStartDate some xsd:dateTime, sdg:projectEndDate some xsd:dateTime, sdg:grantProgramName some xsd:string, sdg:title some xsd:string, sdg:fundedBy exactly 1 sdg:EngagementAward, sdg:participatedBy min 2 sdg:AdvisoryCouncil, sdg:produced some sdg:ResearchOutput, sdg:conductedBy min 2 sdg:FacultyMember, sdg:involvesStudent min 2 sdg:Student, sdg:partOfDepartment exactly 1 sdg:AcademicDepartment, sdg:conductedIn some sdg:AdministrativeRegion, sdg:fundedBy exactly 1 sdg:HealthAuthority, sdg:producesDataFor exactly 1 sdg:Pathogen, sdg:develops min 2 sdg:WastewaterTreatmentProcess, sdg:develops min 2 sdg:CatalyticMaterial, sdg:collaboratesWith min 2 sdg:ResearchInstitution, sdg:conductedBy min 2 sdg:Researcher, sdg:produces min 2 sdg:Publication, sdg:fundedBy exactly 1 sdg:FundingAgency, sdg:ledBy exactly 1 sdg:Researcher, sdg:fundedBy some sdg:ResearchOrganization, sdg:conductedAt some sdg:GeographicLocation, sdg:studies some sdg:HealthCondition, sdg:measures some sdg:Biomarker, sdg:studiesTransition some sdg:ServiceTransition, sdg:involvesCoResearcher some sdg:ServiceUser, sdg:involvesCoResearcher some sdg:Carer

Class: sdg:AdvisoryCouncil
    Annotations: rdfs:label "Patient-Family Advisory Council", iao:0000115 "A formal group within a healthcare organization established to engage patients and family members as partners in quality improvement and strategic alignment."
    SubClassOf: bfo:0000015, sdg:councilId some xsd:string, sdg:councilName some xsd:string, sdg:organizationId some xsd:string, sdg:establishmentDate some xsd:date, sdg:councilStatus some sdg:CouncilStatusKind, sdg:memberCount some xsd:integer, sdg:meetingFrequency some sdg:MeetingFrequencyKind, sdg:participatedIn some sdg:ResearchProject, sdg:advises exactly 1 sdg:HealthcareOrganization, sdg:uses some sdg:ResearchOutput

Class: sdg:HealthcareOrganization
    Annotations: rdfs:label "Healthcare Organization", iao:0000115 "An institutional entity providing healthcare services and employing structures like advisory councils to improve quality and process."
    SubClassOf: sdg:Organization, sdg:orgId some xsd:string, sdg:orgName some xsd:string, sdg:orgType some sdg:OrgTypeKind, sdg:locationCity some xsd:string, sdg:locationState some xsd:string, sdg:foundedDate some xsd:date, sdg:bedCount some xsd:integer, sdg:organizationId some xsd:string, sdg:name some sdg:NameKind, sdg:location some xsd:string, sdg:establishedDate some xsd:date, sdg:operatingMargin some xsd:decimal, sdg:isSustainable some xsd:boolean, sdg:locationCountry some xsd:string, sdg:hosts min 2 sdg:AdvisoryCouncil, sdg:receives some sdg:ResearchOutput, sdg:locatedIn exactly 1 sdg:GeographicRegion, sdg:collectsDataFrom some sdg:ElectronicHealthRecord, sdg:emplores some sdg:HealthcareProfessional, sdg:uses some sdg:AnalyticsSolution, sdg:implements some sdg:HealthcareAnalyticsSolution, sdg:employs some sdg:ClinicalDecisionSupport
    HasKey: sdg:orgId

Class: sdg:ResearchOutput
    Annotations: rdfs:label "Research Output", iao:0000115 "A tangible or intangible result of research activities, such as a tool, report, or dataset, intended to inform decision-making and practice."
    SubClassOf: cco:ont00000995, sdg:outputId some xsd:string, sdg:outputType some xsd:string, sdg:creationDate some xsd:dateTime, sdg:versionNumber some xsd:string, sdg:status some sdg:StatusKind, sdg:accessLevel some sdg:AccessLevelKind, sdg:title some xsd:string, sdg:publicationDate some xsd:date, sdg:format some sdg:FormatKind, sdg:pageCount some xsd:integer, sdg:producedBy exactly 1 sdg:ResearchProject, sdg:usedBy some sdg:AdvisoryCouncil, sdg:producedBy exactly 1 sdg:ResearchDesk, sdg:authoredBy some sdg:ProjectManager, sdg:cites some sdg:ResearchOutput

Class: sdg:ReviewPanel
    Annotations: rdfs:label "Review Panel", iao:0000115 "A group of experts convened to assess applications for funding based on established criteria and engagement goals."
    SubClassOf: bfo:0000015, sdg:panelId some xsd:string, sdg:panelName some xsd:string, sdg:reviewDate some xsd:dateTime, sdg:reviewCriteria some xsd:string, sdg:panelStatus some sdg:PanelStatusKind, sdg:memberCount some xsd:integer, sdg:evaluates some sdg:EngagementAward, sdg:convenedBy exactly 1 sdg:FundingAgency

Class: sdg:TaxRegulation
    Annotations: rdfs:label "Federal Tax Regulation", iao:0000115 "A formal document issued by the IRS that provides proposed or final rules for interpreting and applying federal tax statutes."
    SubClassOf: cco:ont00000958, sdg:regulationId some xsd:string, sdg:title some xsd:string, sdg:publicationDate some xsd:date, sdg:status some sdg:StatusKind, sdg:effectiveDate some xsd:date, sdg:hearingDate some xsd:dateTime, sdg:federalRegisterCitation some xsd:string, sdg:implements exactly 1 sdg:TaxStatute, sdg:governs some sdg:TaxDeduction

Class: sdg:TaxStatute
    Annotations: rdfs:label "Federal Tax Statute", iao:0000115 "A legislative act passed by Congress that establishes the legal framework for federal taxation."
    SubClassOf: cco:ont00000958, sdg:statuteCode some xsd:string, sdg:sectionNumber some xsd:string, sdg:enactmentDate some xsd:date, sdg:shortTitle some xsd:string, sdg:longTitle some xsd:string, sdg:amendmentStatus some xsd:string, sdg:creates some sdg:TaxDeduction, sdg:defines some sdg:DisqualifiedActivity

Class: sdg:TaxDeduction
    Annotations: rdfs:label "Pass-Through Deduction", iao:0000115 "A financial reduction in taxable income allowed under Section 199A for qualifying pass-through business income."
    SubClassOf: bfo:0000015, sdg:deductionPercentage some xsd:decimal, sdg:maxDeductionAmount some xsd:decimal, sdg:effectiveTaxRate some xsd:decimal, sdg:phaseInThreshold some xsd:decimal, sdg:phaseOutThreshold some xsd:decimal, sdg:appliesToAMT some xsd:boolean, sdg:affectsBasis some xsd:boolean, sdg:affectsNII some xsd:boolean, sdg:dependsOn exactly 1 sdg:QualifiedBusinessIncome, sdg:limitedBy some sdg:WageAssetTest, sdg:excludedFor some sdg:DisqualifiedActivity

Class: sdg:QualifiedBusinessIncome
    Annotations: rdfs:label "Qualified Business Income", iao:0000115 "The net amount of income, gain, deduction, and loss from a qualified trade or business conducted in the United States."
    SubClassOf: cco:ont00000995, sdg:incomeAmount some xsd:decimal, sdg:lossAmount some xsd:decimal, sdg:netQBI some xsd:decimal, sdg:carriedForwardLoss some xsd:decimal, sdg:sourceType some sdg:SourceTypeKind, sdg:isSSTB some xsd:boolean, sdg:calculationYear some xsd:integer, sdg:generatedBy exactly 1 sdg:TradeOrBusiness, sdg:subjectTo some sdg:WageAssetTest, sdg:reducedBy some sdg:DisqualifiedActivity

Class: sdg:TradeOrBusiness
    Annotations: rdfs:label "Trade or Business Entity", iao:0000115 "An ongoing commercial or industrial enterprise engaged in profit-seeking activities, including sole proprietorships, partnerships, and S corporations."
    SubClassOf: sdg:BusinessEntity, sdg:entityType some sdg:EntityTypeKind, sdg:employerId some xsd:string, sdg:location some xsd:string, sdg:isSSTB some xsd:boolean, sdg:totalWagesPaid some xsd:decimal, sdg:unadjustedBasisOfProperty some xsd:decimal, sdg:taxYear some xsd:integer, sdg:generates exactly 1 sdg:QualifiedBusinessIncome, sdg:subjectTo exactly 1 sdg:WageAssetTest, sdg:classifiedAs some sdg:DisqualifiedActivity

Class: sdg:WageAssetTest
    Annotations: rdfs:label "Wage and Asset Limitation Test", iao:0000115 "A calculation used to determine the allowable pass-through deduction based on the wages paid by the business and the unadjusted basis of tangible depreciable property."
    SubClassOf: bfo:0000015, sdg:wageLimit some xsd:decimal, sdg:assetLimit some xsd:decimal, sdg:combinedLimit some xsd:decimal, sdg:phaseInPercentage some xsd:decimal, sdg:isFullyApplicable some xsd:boolean, sdg:testYear some xsd:integer, sdg:evaluates exactly 1 sdg:TradeOrBusiness, sdg:limits exactly 1 sdg:TaxDeduction

Class: sdg:DisqualifiedActivity
    Annotations: rdfs:label "Specified Service Trade or Business", iao:0000115 "A trade or business involving services in fields such as health, law, accounting, or consulting that is generally excluded from the pass-through deduction."
    SubClassOf: bfo:0000023, sdg:activityCode some xsd:string, sdg:activityName some sdg:ActivityNameKind, sdg:isDeMinimis some xsd:boolean, sdg:deMinimisThreshold some xsd:decimal, sdg:antiAbuseRule some xsd:boolean, sdg:exclusionStatus some xsd:string, sdg:classifies some sdg:TradeOrBusiness, sdg:excludes exactly 1 sdg:TaxDeduction, sdg:subjectTo exactly 1 sdg:TaxRegulation

Class: sdg:AcademicProgramme
    Annotations: rdfs:label "Academic Programme", iao:0000115 "A structured educational offering that defines the curriculum, requirements, and outcomes for a specific field of study."
    SubClassOf: sdg:Program, sdg:programmeId some xsd:string, sdg:programmeName some xsd:string, sdg:degreeLevel some xsd:string, sdg:departmentId some xsd:string, sdg:startDate some xsd:dateTime, sdg:status some sdg:StatusKind, sdg:creditHours some xsd:integer, sdg:durationYears some xsd:integer, sdg:offeredBy exactly 1 sdg:AcademicDepartment, sdg:includesCourse min 2 sdg:Course

Class: sdg:AcademicSchool
    Annotations: rdfs:label "Academic School", iao:0000115 "A higher-level organizational unit within a university that groups related academic departments."
    SubClassOf: sdg:schoolId some xsd:string, sdg:schoolName some xsd:string, sdg:universityId some xsd:string, sdg:establishmentDate some xsd:date, sdg:status some sdg:StatusKind, sdg:deanId some xsd:string, sdg:contactEmail some xsd:string, sdg:contactPhone some xsd:string, sdg:containsDepartment__escalated min 2 sdg:AcademicDepartment, sdg:partOfUniversity exactly 1 sdg:University

Class: sdg:University
    Annotations: rdfs:label "University", iao:0000115 "A higher education institution established by legislative act, providing academic programs and conducting research."
    SubClassOf: bfo:0000040, sdg:universityId some xsd:string, sdg:universityName some xsd:string, sdg:legalName some xsd:string, sdg:establishmentDate some xsd:date, sdg:status some sdg:StatusKind, sdg:campusLocation some xsd:string, sdg:totalCampusAreaAcres some xsd:decimal, sdg:fundingSource some sdg:FundingSourceKind, sdg:accreditationBody some xsd:string, sdg:accreditationStatus some sdg:AccreditationStatusKind, sdg:universityCode some xsd:string, sdg:institutionName some xsd:string, sdg:country some sdg:CountryKind, sdg:establishedYear some xsd:integer, sdg:institutionType some sdg:InstitutionTypeKind, sdg:qaComplianceLevel some sdg:QaComplianceLevelKind, sdg:name some sdg:NameKind, sdg:location some xsd:string, sdg:researchOutputRank some xsd:integer, sdg:containsSchool min 2 sdg:AcademicSchool, sdg:employsFaculty min 2 sdg:FacultyMember, sdg:enrollsStudent min 2 sdg:Student, sdg:participatesIn__escalated some sdg:QualityAssuranceSystem, sdg:offers min 2 sdg:AcademicProgram, sdg:regulatedBy exactly 1 sdg:RegionalCommission, sdg:subjectTo some sdg:QualityAssuranceSystem, sdg:locatedIn exactly 1 sdg:NationalCommission, sdg:staffAttends some sdg:CapacityBuildingTraining, sdg:employs some sdg:FacultyResearcher
    HasKey: sdg:universityId

Class: sdg:FacultyMember
    Annotations: rdfs:label "Faculty Member", iao:0000115 "An individual employed by a university to teach, conduct research, and provide academic services."
    SubClassOf: sdg:Role, sdg:facultyId some xsd:string, sdg:firstName some xsd:string, sdg:lastName some xsd:string, sdg:title some xsd:string, sdg:departmentId some xsd:string, sdg:schoolId some xsd:string, sdg:universityId some xsd:string, sdg:employmentStatus some sdg:EmploymentStatusKind, sdg:hireDate some xsd:date, sdg:contactEmail some xsd:string, sdg:contactPhone some xsd:string, sdg:qualificationLevel some xsd:string, sdg:department some xsd:string, sdg:yearsOfExperience some xsd:integer, sdg:isTenured some xsd:boolean, sdg:employeeId some xsd:string, sdg:fullName some xsd:string, sdg:nativeLanguage some xsd:string, sdg:certificationType some xsd:string, sdg:credential some sdg:CredentialKind, sdg:affiliation some sdg:AffiliationKind, sdg:email some xsd:string, sdg:yearsOfService some xsd:integer, sdg:teachesCourse min 2 sdg:Course, sdg:conductsResearch min 2 sdg:ResearchProject, sdg:supervisesStudent min 2 sdg:Student, sdg:teaches some sdg:Course, sdg:advises min 2 sdg:Student, sdg:employedBy exactly 1 sdg:Institution, sdg:conducts min 2 sdg:InstructionalSession, sdg:deliversSession min 1 sdg:Session, sdg:specializesIn min 1 sdg:AcademicTopic, sdg:develops min 2 sdg:LabActivity, sdg:coordinates some sdg:TeachingAssistant

Class: sdg:DecisionAssessment
    Annotations: rdfs:label "Decision Capacity Assessment", iao:0000115 "A measurement process evaluating whether a specific individual possesses the functional capacity to make a particular decision at a specific time."
    SubClassOf: sdg:AssessmentTool, sdg:assessmentId some xsd:string, sdg:assessmentDate some xsd:dateTime, sdg:decisionTopic some xsd:string, sdg:assessorId some xsd:string, sdg:capacityStatus some sdg:CapacityStatusKind, sdg:supportProvided some xsd:string, sdg:decisionCapacityStatus some xsd:string, sdg:evaluates exactly 1 sdg:Person, sdg:assesses exactly 1 sdg:DecisionTopic, sdg:conductedBy exactly 1 sdg:Professional

Class: sdg:DecisionTopic
    Annotations: rdfs:label "Decision Subject", iao:0000115 "A specific matter or choice requiring a decision, such as medical treatment, financial management, or living arrangements."
    SubClassOf: bfo:0000003, sdg:topicId some xsd:string, sdg:categoryCode some xsd:string, sdg:urgencyLevel some xsd:string, sdg:description some xsd:string, sdg:assessedIn min 1 sdg:DecisionAssessment, sdg:resolvedBy max 1 sdg:BestInterestDetermination

Class: sdg:BestInterestDetermination
    Annotations: rdfs:label "Best Interest Determination", iao:0000115 "A formal decision-making process and resulting record where a decision is made on behalf of a person lacking capacity, strictly adhering to their best interests and least restrictive principles."
    SubClassOf: bfo:0000015, sdg:determinationId some xsd:string, sdg:decisionDate some xsd:dateTime, sdg:chosenOption some xsd:string, sdg:restrictivenessLevel some xsd:string, sdg:justificationText some xsd:string, sdg:status some sdg:StatusKind, sdg:determinationIdentifier some xsd:string, sdg:determinationDate some xsd:dateTime, sdg:leastRestrictiveOption some xsd:boolean, sdg:consultationParticipants some xsd:string, sdg:outcomeDescription some xsd:string, sdg:reviewDate some xsd:dateTime, sdg:appliesTo exactly 1 sdg:Person, sdg:addresses exactly 1 sdg:DecisionTopic, sdg:basedOnAssessment exactly 1 sdg:DecisionAssessment, sdg:madeBy exactly 1 sdg:Professional, sdg:concerns exactly 1 sdg:Individual, sdg:addresses exactly 1 sdg:DecisionContext, sdg:resultsIn min 2 sdg:Intervention, sdg:performedBy exactly 1 sdg:LegalRepresentative

Class: sdg:Professional
    Annotations: rdfs:label "Authorized Decision Maker", iao:0000115 "A qualified individual (e.g., clinician, social worker, legal guardian) authorized to conduct capacity assessments and make best interest determinations."
    SubClassOf: bfo:0000002, sdg:professionalId some xsd:string, sdg:fullName some xsd:string, sdg:licenseNumber some xsd:string, sdg:roleType some sdg:RoleTypeKind, sdg:jurisdiction some sdg:JurisdictionKind, sdg:birthDate some xsd:date, sdg:currentEmployerDetail some xsd:string, sdg:primaryExpertise some xsd:string, sdg:conducts min 1 sdg:DecisionAssessment, sdg:makes min 1 sdg:BestInterestDetermination, sdg:holdsRole some sdg:ExecutiveRole, sdg:educatedAt some sdg:EducationalInstitution, sdg:previouslyEmployedAt some sdg:Corporation

Class: sdg:FinancialInstitution
    Annotations: rdfs:label "Financial Institution", iao:0000115 "A regulated banking entity or holding company subject to federal oversight and anti-money laundering requirements."
    SubClassOf: sdg:FinancialEntity, sdg:institutionId some xsd:string, sdg:legalName some xsd:string, sdg:headquartersCity some xsd:string, sdg:headquartersCountry some xsd:string, sdg:charterType some xsd:string, sdg:fedMemberStatus some xsd:boolean, sdg:regulatoryStatus some sdg:RegulatoryStatusKind, sdg:institutionIdentifier some xsd:string, sdg:registrationStatus some sdg:RegistrationStatusKind, sdg:netCapitalUSD some xsd:decimal, sdg:totalAssetsUSD some xsd:decimal, sdg:shareholdersEquityUSD some xsd:decimal, sdg:marketCapitalizationUSD some xsd:decimal, sdg:parentCompany some xsd:string, sdg:jurisdiction some sdg:JurisdictionKind, sdg:marketValueRank some xsd:integer, sdg:establishedYear some xsd:integer, sdg:isCrossBorder some xsd:boolean, sdg:institutionName some xsd:string, sdg:headquartersLocation some xsd:string, sdg:customerCount some xsd:integer, sdg:ethicalPolicyAdopted some xsd:boolean, sdg:institutionType some sdg:InstitutionTypeKind, sdg:assetSize some xsd:decimal, sdg:currency some xsd:string, sdg:riskRating some sdg:RiskRatingKind, sdg:isSystemicallyImportant some xsd:boolean, sdg:hasSubsidiary some sdg:FinancialInstitution, sdg:subjectToRegulation some sdg:RegulatoryFramework, sdg:subjectToInvestigation some sdg:ComplianceInvestigation, sdg:holds some sdg:ClientAssetPortfolio, sdg:insuredBy some sdg:InsurancePolicy, sdg:regulatedBy some sdg:RegulatoryFramework, sdg:auditedBy some sdg:AuditReport, sdg:uses some sdg:SanctionsScreeningTool, sdg:acquired max 1 sdg:FinancialInstitution, sdg:subjectTo min 2 sdg:RegulatoryAgency, sdg:offers some sdg:InsuranceProduct, sdg:investsIn some sdg:CorporateEntity, sdg:receivesFundingFrom some sdg:BailoutProgram, sdg:isRegulatedBy some sdg:GovernmentAgency, sdg:holdsDebtFrom some sdg:EconomicCondition

Class: sdg:ComplianceInvestigation
    Annotations: rdfs:label "Compliance Investigation", iao:0000115 "A formal regulatory inquiry or audit into a financial institution's adherence to anti-money laundering and banking laws."
    SubClassOf: bfo:0000015, sdg:investigationId some xsd:string, sdg:initiationDate some xsd:dateTime, sdg:status some sdg:StatusKind, sdg:issuingAuthorityDetail some xsd:string, sdg:findingSeverity some xsd:string, sdg:penaltyAmount some xsd:decimal, sdg:targetsInstitution exactly 1 sdg:FinancialInstitution, sdg:citesPriorFinding some sdg:ComplianceInvestigation, sdg:documentsDeficiency some sdg:ComplianceDeficiency

Class: sdg:ComplianceDeficiency
    Annotations: rdfs:label "Compliance Deficiency", iao:0000115 "A documented failure or systemic weakness in a financial institution's internal controls, risk management, or reporting procedures."
    SubClassOf: sdg:RegulatoryComplianceConcept, sdg:deficiencyId some xsd:string, sdg:category some sdg:CategoryKind, sdg:description some xsd:string, sdg:discoveryDate some xsd:date, sdg:remediationStatus some xsd:string, sdg:status some sdg:StatusKind, sdg:reportedBy exactly 1 sdg:ComplianceInvestigation, sdg:affectsDivision some sdg:BankingDivision, sdg:involvesClient some sdg:HighRiskClient

Class: sdg:BankingDivision
    Annotations: rdfs:label "Banking Division", iao:0000115 "A specialized operational unit within a financial institution responsible for specific client segments or services."
    SubClassOf: cco:ont00000995, sdg:divisionCode some xsd:string, sdg:divisionName some xsd:string, sdg:oversightLevel some sdg:OversightLevelKind, sdg:complianceOfficerId some xsd:string, sdg:partOfInstitution exactly 1 sdg:FinancialInstitution, sdg:managesClient some sdg:HighRiskClient, sdg:subjectToDeficiency some sdg:ComplianceDeficiency

Class: sdg:HighRiskClient
    Annotations: rdfs:label "High-Risk Client", iao:0000115 "An individual or entity subject to enhanced scrutiny due to political exposure, wealth, or association with sanctioned jurisdictions."
    SubClassOf: bfo:0000004, sdg:clientId some xsd:string, sdg:clientType some xsd:string, sdg:riskRating some sdg:RiskRatingKind, sdg:jurisdiction some sdg:JurisdictionKind, sdg:relationshipStatus some sdg:RelationshipStatusKind, sdg:heldAtInstitution some sdg:FinancialInstitution, sdg:managedByDivision some sdg:BankingDivision, sdg:triggersReport some sdg:SuspiciousActivityReport
    HasKey: sdg:clientId

Class: sdg:SuspiciousActivityReport
    Annotations: rdfs:label "Suspicious Activity Report", iao:0000115 "A formal regulatory filing documenting transactions or behaviors that suggest potential money laundering or financial crime."
    SubClassOf: sdg:Report, sdg:sarId some xsd:string, sdg:filingDate some xsd:date, sdg:status some sdg:StatusKind, sdg:triggeringTransactionId some xsd:string, sdg:flaggingSpecialistId some xsd:string, sdg:activityType some sdg:ActivityTypeKind, sdg:sarIdentifier some xsd:string, sdg:reportDate some xsd:dateTime, sdg:reviewStatus some sdg:ReviewStatusKind, sdg:privacyComplianceCheck some xsd:boolean, sdg:reviewingAnalystID some xsd:string, sdg:concernsClient exactly 1 sdg:HighRiskClient, sdg:generatedByDivision exactly 1 sdg:BankingDivision, sdg:suppressedBy some sdg:ComplianceDeficiency, sdg:managedByUnit exactly 1 sdg:IntelligenceUnit, sdg:concernsSubject some sdg:SubjectOfInterest, sdg:derivedFromObservation some sdg:IntelligenceReport, sdg:disseminatedTo some sdg:PartnerAgency
    HasKey: sdg:sarId

Class: sdg:PublicHealthNurse
    Annotations: rdfs:label "Public Health Nurse", iao:0000115 "A person who provides public health nursing services to support safe school reopening and COVID-19 response."
    SubClassOf: bfo:0000040, sdg:nurseId some xsd:string, sdg:fullName some xsd:string, sdg:licenseNumber some xsd:string, sdg:contactPhone some xsd:string, sdg:email some xsd:string, sdg:status some sdg:StatusKind, sdg:assignedTo exactly 1 sdg:School, sdg:supports some sdg:SchoolBoard

Class: sdg:SchoolBoard
    Annotations: rdfs:label "School Board", iao:0000115 "A local education authority overseeing schools in a jurisdiction, coordinating with public health services."
    SubClassOf: bfo:0000040, sdg:boardId some xsd:string, sdg:boardName some xsd:string, sdg:jurisdiction some sdg:JurisdictionKind, sdg:contactEmail some xsd:string, sdg:contactPhone some xsd:string, sdg:programManagerName some xsd:string, sdg:programManagerPhone some xsd:string, sdg:employs some sdg:PublicHealthNurse, sdg:oversees min 2 sdg:School

Class: sdg:Outbreak
    Annotations: rdfs:label "Outbreak", iao:0000115 "A localized event of multiple COVID-19 cases within a school community requiring rapid-response support."
    SubClassOf: bfo:0000015, sdg:outbreakId some xsd:string, sdg:startDate some xsd:dateTime, sdg:endDate some xsd:dateTime, sdg:caseCount some xsd:integer, sdg:status some sdg:StatusKind, sdg:location some xsd:string, sdg:occursAt exactly 1 sdg:School, sdg:managedBy exactly 1 sdg:PublicHealthNurse

Class: sdg:IPACMeasure
    Annotations: rdfs:label "Infection Prevention and Control Measure", iao:0000115 "A specific protocol or modification implemented in a school to prevent the spread of infectious diseases."
    SubClassOf: bfo:0000015, sdg:measureId some xsd:string, sdg:measureName some xsd:string, sdg:description some xsd:string, sdg:implementationDate some xsd:dateTime, sdg:complianceStatus some sdg:ComplianceStatusKind, sdg:lastReviewedDate some xsd:date, sdg:implementedAt exactly 1 sdg:School, sdg:assessedBy exactly 1 sdg:PublicHealthNurse

Class: sdg:ProductSpecification
    Annotations: rdfs:label "Product Specification", iao:0000115 "A formal record defining the technical parameters, dimensions, and performance criteria for a construction material."
    SubClassOf: sdg:Resource, sdg:productIdentifier some xsd:string, sdg:brandName some xsd:string, sdg:documentType some sdg:DocumentTypeKind, sdg:designSulfateClass some xsd:string, sdg:jointType some xsd:string, sdg:availabilityStatus some xsd:string, sdg:specifies min 2 sdg:MaterialProperty, sdg:appliesTo min 2 sdg:ProductVariant

Class: sdg:ProductVariant
    Annotations: rdfs:label "Product Variant", iao:0000115 "A specific manufactured configuration of a product defined by its face dimensions and joint type."
    SubClassOf: cco:ont00000995, sdg:variantIdentifier some xsd:string, sdg:faceLength some xsd:integer, sdg:faceWidth some xsd:integer, sdg:unit some sdg:UnitKind, sdg:hasHandholds some xsd:boolean, sdg:definedBy exactly 1 sdg:ProductSpecification, sdg:exhibits min 2 sdg:MaterialProperty, sdg:hasDimension min 2 sdg:DimensionalSpec

Class: sdg:DimensionalSpec
    Annotations: rdfs:label "Dimensional Specification", iao:0000115 "A record of the physical size and weight parameters for a specific product variant."
    SubClassOf: cco:ont00000995, sdg:thickness some xsd:decimal, sdg:weight some xsd:decimal, sdg:weightUnit some xsd:string, sdg:densityCondition some sdg:DensityConditionKind, sdg:moistureAdjustment some xsd:decimal, sdg:appliesTo exactly 1 sdg:ProductVariant

Class: sdg:CameraDevice
    Annotations: rdfs:label "A physical digital single-lens reflex or mirrorless camera unit used for imaging", iao:0000115 "A physical digital single-lens reflex or mirrorless camera unit used for imaging"
    SubClassOf: sdg:SecuritySystemComponent, sdg:deviceIdentifier some xsd:string, sdg:manufacturer some xsd:string, sdg:modelNumber some xsd:string, sdg:sensorType some xsd:string, sdg:megapixels some xsd:decimal, sdg:lensMountType some xsd:string, sdg:isMirrorless some xsd:boolean, sdg:configuredWith exactly 1 sdg:CameraLens, sdg:configuredWith exactly 1 sdg:MemoryCard

Class: sdg:CameraLens
    Annotations: rdfs:label "An interchangeable optical lens assembly attached to a camera body", iao:0000115 "An interchangeable optical lens assembly attached to a camera body"
    SubClassOf: cco:ont00000995, sdg:lensIdentifier some xsd:string, sdg:manufacturer some xsd:string, sdg:modelNumber some xsd:string, sdg:focalLength some xsd:decimal, sdg:maxAperture some xsd:decimal, sdg:mountCompatibility some xsd:string, sdg:isPrime some xsd:boolean, sdg:attachedTo exactly 1 sdg:CameraDevice
    HasKey: sdg:modelNumber

Class: sdg:MemoryCard
    Annotations: rdfs:label "A removable solid-state storage medium for digital image data", iao:0000115 "A removable solid-state storage medium for digital image data"
    SubClassOf: cco:ont00000995, sdg:cardIdentifier some xsd:string, sdg:manufacturer some xsd:string, sdg:modelNumber some xsd:string, sdg:storageCapacity some xsd:decimal, sdg:writeSpeed some xsd:decimal, sdg:fileSystemFormat some xsd:string, sdg:isFormatted some xsd:boolean, sdg:insertedIn exactly 1 sdg:CameraDevice

Class: sdg:ImageCapture
    Annotations: rdfs:label "A single photographic exposure event recording light onto a sensor", iao:0000115 "A single photographic exposure event recording light onto a sensor"
    SubClassOf: bfo:0000015, sdg:captureIdentifier some xsd:string, sdg:timestamp some xsd:dateTime, sdg:shutterSpeed some xsd:decimal, sdg:apertureValue some xsd:decimal, sdg:isoSetting some xsd:integer, sdg:exposureMode some xsd:string, sdg:whiteBalance some xsd:string, sdg:meteringMode some xsd:string, sdg:focusMode some xsd:string, sdg:fileFormat some sdg:FileFormatKind, sdg:recordedBy exactly 1 sdg:CameraDevice, sdg:storedOn exactly 1 sdg:MemoryCard, sdg:capturedSubject some sdg:CelestialObject

Class: sdg:CelestialObject
    Annotations: rdfs:label "A natural astronomical body or feature in the night sky", iao:0000115 "A natural astronomical body or feature in the night sky"
    SubClassOf: bfo:0000004, sdg:objectIdentifier some xsd:string, sdg:commonName some xsd:string, sdg:catalogDesignation some xsd:string, sdg:objectType some xsd:string, sdg:constellation some xsd:string, sdg:rightAscension some xsd:decimal, sdg:declination some xsd:decimal, sdg:apparentMagnitude some xsd:decimal, sdg:capturedIn some sdg:ImageCapture

Class: sdg:ExposureTriangle
    Annotations: rdfs:label "The interdependent relationship between shutter speed, aperture, and ISO in photography", iao:0000115 "The interdependent relationship between shutter speed, aperture, and ISO in photography"
    SubClassOf: bfo:0000015, sdg:triangleIdentifier some xsd:string, sdg:shutterSpeed some xsd:decimal, sdg:apertureValue some xsd:decimal, sdg:isoSetting some xsd:integer, sdg:exposureValue some xsd:decimal, sdg:isBalanced some xsd:boolean, sdg:defines some sdg:ImageCapture

Class: sdg:Share
    Annotations: rdfs:label "Share", iao:0000115 "A single unit of ownership in the corporation, representing a claim on assets and earnings."
    SubClassOf: cco:ont00000995, sdg:identifier some xsd:string, sdg:nominalValue some xsd:decimal, sdg:votingRights some xsd:integer, sdg:issuanceDate some xsd:date, sdg:currentStatus some sdg:CurrentStatusKind, sdg:heldBy some sdg:Shareholder, sdg:represents exactly 1 sdg:ShareCapital

Class: sdg:AnnualGeneralMeeting
    Annotations: rdfs:label "Annual General Meeting", iao:0000115 "The supreme decision-making body of the corporation where shareholders exercise their rights."
    SubClassOf: bfo:0000015, sdg:meetingId some xsd:string, sdg:scheduledDate some xsd:dateTime, sdg:actualDate some xsd:dateTime, sdg:location some xsd:string, sdg:quorumMet some xsd:boolean, sdg:totalSharesRepresented some xsd:integer, sdg:attendeeCount some xsd:integer, sdg:meetingDate some xsd:dateTime, sdg:attendeeShareholderCount some xsd:integer, sdg:minutesPublished some xsd:boolean, sdg:elects some sdg:BoardMember, sdg:appoints exactly 1 sdg:NominationCommittee, sdg:resolves some sdg:Resolution, sdg:hasQuorumOf min 2 sdg:Shareholder, sdg:resolves max 1 sdg:DividendResolution, sdg:resolves min 2 sdg:FeeResolution

Class: sdg:NominationCommittee
    Annotations: rdfs:label "Nomination Committee", iao:0000115 "A committee appointed by the Annual General Meeting to draft proposals for elections and fees."
    SubClassOf: bfo:0000004, sdg:committeeId some xsd:string, sdg:charterVersion some xsd:string, sdg:minMembers some xsd:integer, sdg:maxMembers some xsd:integer, sdg:chairmanId some xsd:string, sdg:meetingDate some xsd:dateTime, sdg:chairmanName some xsd:string, sdg:instructionsAdopted some xsd:boolean, sdg:appointedBy exactly 1 sdg:AnnualGeneralMeeting, sdg:draftsProposalFor some sdg:Resolution, sdg:hasMember min 2 sdg:BoardMember, sdg:draftsProposalFor min 2 sdg:BoardMember

Class: sdg:Resolution
    Annotations: rdfs:label "Resolution", iao:0000115 "A formal decision or directive passed by the Annual General Meeting."
    SubClassOf: bfo:0000015, sdg:resolutionId some xsd:string, sdg:passDate some xsd:dateTime, sdg:resolutionType some xsd:string, sdg:amount some xsd:decimal, sdg:currency some xsd:string, sdg:isPublished some xsd:boolean, sdg:passedAt exactly 1 sdg:AnnualGeneralMeeting, sdg:affects some sdg:Shareholder, sdg:designates some sdg:BoardMember

Class: sdg:MenuLineItem
    Annotations: rdfs:label "Menu Line Item", iao:0000115 "A distinct purchasable offering on the dessert and beverage menu, including its name, description, and base price."
    SubClassOf: sdg:DiningPackage, sdg:itemIdentifier some xsd:string, sdg:displayName some xsd:string, sdg:basePrice some xsd:decimal, sdg:category some sdg:CategoryKind, sdg:servingSize some xsd:string, sdg:isAlaModeAvailable some xsd:boolean, sdg:containsIngredient some sdg:Ingredient, sdg:hasBasePrice exactly 1 sdg:PricePoint, sdg:hasOptionalTopping some sdg:ToppingOption

Class: sdg:PricePoint
    Annotations: rdfs:label "Price Point", iao:0000115 "A specific monetary value associated with a menu item or an add-on option."
    SubClassOf: cco:ont00000995, sdg:priceId some xsd:string, sdg:amount some xsd:decimal, sdg:currencyCode some xsd:string, sdg:priceType some xsd:string, sdg:isPriceFor some sdg:MenuLineItem

Class: sdg:ToppingOption
    Annotations: rdfs:label "Topping Option", iao:0000115 "A selectable add-on component or modification that can be applied to a base menu item."
    SubClassOf: bfo:0000040, sdg:optionId some xsd:string, sdg:optionName some xsd:string, sdg:isChoiceBased some xsd:boolean, sdg:associatedPriceId some xsd:string, sdg:isApplicableTo some sdg:MenuLineItem, sdg:isRealizedBy some sdg:Ingredient

Class: sdg:BeverageServing
    Annotations: rdfs:label "Beverage Serving", iao:0000115 "A specific volume of a prepared drink offered on the menu."
    SubClassOf: bfo:0000040, sdg:servingId some xsd:string, sdg:volumeOz some xsd:decimal, sdg:preparationMethod some xsd:string, sdg:isSweetened some xsd:boolean, sdg:isServingOf exactly 1 sdg:MenuLineItem

Class: sdg:NotebookFile
    Annotations: rdfs:label "Notebook File", iao:0000115 "A digital file containing computational code, output, and narrative text in a specific notebook format."
    SubClassOf: cco:ont00000958, sdg:fileIdentifier some xsd:string, sdg:fileName some xsd:string, sdg:fileExtension some xsd:string, sdg:creationDate some xsd:dateTime, sdg:checksum some xsd:string, sdg:contains exactly 1 sdg:ComputationalExample

Class: sdg:SoftwarePackage
    Annotations: rdfs:label "Software Package", iao:0000115 "A computational tool or system used to perform calculations, simulations, or data analysis."
    SubClassOf: bfo:0000015, sdg:packageIdentifier some xsd:string, sdg:name some sdg:NameKind, sdg:version some xsd:string, sdg:developer some xsd:string, sdg:licenseType some xsd:string, sdg:usedBy exactly 1 sdg:ComputationalExample

Class: sdg:ShellReading
    Annotations: rdfs:label "Shell Reading", iao:0000115 "A structured interpretive record of a client's shell casting, capturing the combination of shells drawn and the resulting thematic analysis."
    SubClassOf: cco:ont00000995, sdg:readingId some xsd:string, sdg:clientName some xsd:string, sdg:sessionDate some xsd:dateTime, sdg:primaryTheme some xsd:string, sdg:emotionalValence some xsd:string, sdg:interpretationConfidence some xsd:decimal, sdg:containsShell min 2 sdg:Shell, sdg:elicitedResponse min 2 sdg:StudentInterpretation

Class: sdg:Shell
    Annotations: rdfs:label "Shell", iao:0000115 "A specific mollusk shell specimen used in divination, identified by a unique catalog number and associated symbolic meaning."
    SubClassOf: cco:ont00000995, sdg:shellId some xsd:string, sdg:catalogNumber some xsd:integer, sdg:commonName some xsd:string, sdg:symbolicMeaning some xsd:string, sdg:speciesType some xsd:string, sdg:partOfReading exactly 1 sdg:ShellReading, sdg:symbolizesConcept some sdg:PsychologicalConcept

Class: sdg:StudentInterpretation
    Annotations: rdfs:label "Student Interpretation", iao:0000115 "A recorded analytical response from a training student regarding the symbolic meaning of a specific shell combination."
    SubClassOf: cco:ont00000995, sdg:interpretationId some xsd:string, sdg:studentName some xsd:string, sdg:interpretationText some xsd:string, sdg:certaintyLevel some xsd:string, sdg:recordedDate some xsd:dateTime, sdg:isJournalEntry some xsd:boolean, sdg:analyzesReading exactly 1 sdg:ShellReading, sdg:referencesConcept some sdg:PsychologicalConcept

Class: sdg:PsychologicalConcept
    Annotations: rdfs:label "Psychological Concept", iao:0000115 "An abstract psychological theme, trauma, or developmental stage identified through the interpretation of shell symbols."
    SubClassOf: bfo:0000015, sdg:conceptId some xsd:string, sdg:conceptName some xsd:string, sdg:category some sdg:CategoryKind, sdg:severityLevel some sdg:SeverityLevelKind, sdg:symbolizedBy some sdg:Shell, sdg:interpretedBy some sdg:StudentInterpretation

Class: sdg:TrainingSession
    Annotations: rdfs:label "Training Session", iao:0000115 "A structured educational event in a shell reading curriculum where students analyze case studies and provide interpretive responses."
    SubClassOf: sdg:EducationalEntity, sdg:sessionId some xsd:string, sdg:sessionTitle some xsd:string, sdg:durationMinutes some xsd:integer, sdg:classLevel some xsd:string, sdg:instructorName some xsd:string, sdg:sessionStatus some sdg:SessionStatusKind, sdg:sessionActivityType some xsd:string, sdg:includesReading some sdg:ShellReading, sdg:elicitedResponses min 2 sdg:StudentInterpretation

Class: sdg:AdministrativeUnit
    Annotations: rdfs:label "Administrative Unit", iao:0000115 "A distinct organizational subdivision within a university's Vice President for Finance and Administration structure, such as a department, office, or service center."
    SubClassOf: bfo:0000040, sdg:unitId some xsd:string, sdg:unitName some xsd:string, sdg:unitType some sdg:UnitTypeKind, sdg:establishedDate some xsd:date, sdg:isSharedService some xsd:boolean, sdg:jurisdictionScope some xsd:string, sdg:unitCode some xsd:string, sdg:supportType some sdg:SupportTypeKind, sdg:staffCount some xsd:integer, sdg:budgetAllocation some xsd:decimal, sdg:hasHead exactly 1 sdg:AdministrativeRole, sdg:providesServiceTo some sdg:StakeholderGroup, sdg:reportsTo max 1 sdg:AdministrativeUnit, sdg:serves some sdg:StatutoryAgency, sdg:employs some sdg:StaffingPlan

Class: sdg:AdministrativeRole
    Annotations: rdfs:label "Administrative Role", iao:0000115 "A specific position or title held by an individual within an administrative unit, defining their responsibilities and authority."
    SubClassOf: sdg:Role, sdg:roleId some xsd:string, sdg:roleTitle some sdg:RoleTitleKind, sdg:roleLevel some sdg:RoleLevelKind, sdg:appointmentDate some xsd:date, sdg:isChiefOfStaff some xsd:boolean, sdg:isChiefResilienceOfficer some xsd:boolean, sdg:roleName some xsd:string, sdg:roleCategory some sdg:RoleCategoryKind, sdg:isSupervisory some xsd:boolean, sdg:reportingLine some xsd:string, sdg:heldBy exactly 1 sdg:Person, sdg:assignedToUnit exactly 1 sdg:AdministrativeUnit, sdg:oversees some sdg:AdministrativeUnit, sdg:heldBy some sdg:AdministrativeStaffMember

Class: sdg:ServiceFunction
    Annotations: rdfs:label "Service Function", iao:0000115 "A distinct operational activity or service provided by an administrative unit, such as payroll processing, facilities management, or risk assessment."
    SubClassOf: sdg:functionId some xsd:string, sdg:functionName some xsd:string, sdg:functionCategory some xsd:string, sdg:isCoreFunction some xsd:boolean, sdg:serviceLevel some sdg:ServiceLevelKind, sdg:providedBy exactly 1 sdg:AdministrativeUnit, sdg:supports some sdg:StakeholderGroup
    HasKey: sdg:functionId

Class: sdg:StakeholderGroup
    Annotations: rdfs:label "Stakeholder Group", iao:0000115 "A defined group of individuals or entities that receive services or are affected by the administrative units and their functions."
    SubClassOf: sdg:CommunityEntity, sdg:groupCode some xsd:string, sdg:groupName some xsd:string, sdg:groupType some sdg:GroupTypeKind, sdg:isEligibleForServices some xsd:boolean, sdg:identifier some xsd:string, sdg:description some xsd:string, sdg:priorityLevel some sdg:PriorityLevelKind, sdg:influenceScore some xsd:decimal, sdg:receivesServiceFrom some sdg:ServiceFunction, sdg:isServedByUnit some sdg:AdministrativeUnit, sdg:hasStakeholderNeeds min 2 sdg:StakeholderNeed, sdg:isRepresentedBy some sdg:Representative

Class: sdg:GraphicsAccelerator
    Annotations: rdfs:label "Graphics Accelerator", iao:0000115 "A physical hardware component designed to accelerate graphics rendering and parallel computing tasks within a workstation or desktop system."
    SubClassOf: cco:ont00000995, sdg:manufacturerPartNumber some xsd:string, sdg:eanNumber some xsd:string, sdg:gpuArchitecture some xsd:string, sdg:memoryCapacityBytes some xsd:integer, sdg:memoryInterfaceWidth some xsd:integer, sdg:memoryBandwidthGbps some xsd:decimal, sdg:maxPowerConsumptionWatts some xsd:integer, sdg:formFactor some xsd:string, sdg:thermalSolution some xsd:string, sdg:supportsApi min 2 sdg:GraphicsApi, sdg:supportsApi min 2 sdg:ComputeApi, sdg:deliversDisplayOutput min 2 sdg:DisplayConnector, sdg:installedIn max 1 sdg:WorkstationEnclosure

Class: sdg:GraphicsApi
    Annotations: rdfs:label "Graphics Application Programming Interface", iao:0000115 "A standardized software interface and specification that defines how a graphics accelerator interacts with 3D graphics applications and the underlying hardware."
    SubClassOf: cco:ont00000958, sdg:apiName some xsd:string, sdg:specificationVersion some xsd:string, sdg:conformanceStatus some xsd:string, sdg:standardBody some xsd:string, sdg:supportedBy min 2 sdg:GraphicsAccelerator

Class: sdg:ComputeApi
    Annotations: rdfs:label "Compute Application Programming Interface", iao:0000115 "A standardized software interface and specification that defines how a graphics accelerator executes parallel computing tasks and manages memory for general-purpose processing."
    SubClassOf: cco:ont00000958, sdg:apiName some xsd:string, sdg:specificationVersion some xsd:string, sdg:programmingLanguageSupport some xsd:string, sdg:featureSet some xsd:string, sdg:supportedBy min 2 sdg:GraphicsAccelerator

Class: sdg:DisplayConnector
    Annotations: rdfs:label "Display Connector", iao:0000115 "A physical port or interface on a graphics accelerator that connects to a display device to transmit video and audio signals."
    SubClassOf: cco:ont00000995, sdg:connectorType some xsd:string, sdg:specificationVersion some xsd:string, sdg:maxResolutionX some xsd:integer, sdg:maxResolutionY some xsd:integer, sdg:refreshRateHz some xsd:integer, sdg:colorDepthBits some xsd:integer, sdg:supportsAudio some xsd:boolean, sdg:supportsHdcp some xsd:boolean, sdg:connectedTo max 1 sdg:GraphicsAccelerator, sdg:requiresAdapter max 1 sdg:Adapter

Class: sdg:Adapter
    Annotations: rdfs:label "Display Adapter", iao:0000115 "A passive or active hardware component used to convert a display connector on a graphics accelerator to a different physical or signal standard."
    SubClassOf: cco:ont00000995, sdg:manufacturerPartNumber some xsd:string, sdg:sourceConnectorType some xsd:string, sdg:targetConnectorType some xsd:string, sdg:quantityIncluded some xsd:integer, sdg:suppliedWith max 1 sdg:GraphicsAccelerator, sdg:usedWith min 2 sdg:DisplayConnector

Class: sdg:WorkstationEnclosure
    Annotations: rdfs:label "Workstation Enclosure", iao:0000115 "A physical chassis or case designed to house computer components, including graphics accelerators, in a desktop, mid-tower, or small form factor system."
    SubClassOf: sdg:System, sdg:enclosureType some xsd:string, sdg:availableExpansionSlots some xsd:integer, sdg:powerSupplyWatts some xsd:integer, sdg:supportedFormFactors some xsd:string, sdg:houses min 2 sdg:GraphicsAccelerator

Class: sdg:SoftwareDriver
    Annotations: rdfs:label "Software Driver", iao:0000115 "A software component that provides an interface between the operating system and the graphics accelerator hardware, enabling application execution and hardware control."
    SubClassOf: cco:ont00000958, sdg:driverName some xsd:string, sdg:version some xsd:string, sdg:supportedOperatingSystem some xsd:string, sdg:bitArchitecture some xsd:string, sdg:installationGuideUrl some xsd:string, sdg:controls min 2 sdg:GraphicsAccelerator

Class: sdg:DataCenter
    Annotations: rdfs:label "Data Center Facility", iao:0000115 "A physical facility housing computing infrastructure, network equipment, and storage systems, selected for proximity to internet landing stations and reliable power."
    SubClassOf: bfo:0000040, sdg:location some xsd:string, sdg:powerSupplyReliability some xsd:string, sdg:guardingSchedule some xsd:string, sdg:accessControlLevel some sdg:AccessControlLevelKind, sdg:hostsNationalInterconnect some xsd:boolean, sdg:latencyReductionStrategy some xsd:string, sdg:contains min 2 sdg:Server, sdg:connectedTo min 1 sdg:Network

Class: sdg:Server
    Annotations: rdfs:label "Remote Server", iao:0000115 "A remote Linux server configured with the RACS client setup to interact with the RACS server for access validation and log pushing."
    SubClassOf: bfo:0000040, sdg:serverId some xsd:string, sdg:osType some xsd:string, sdg:racsClientInstalled some xsd:boolean, sdg:accessLevel some sdg:AccessLevelKind, sdg:lastLogPush some xsd:dateTime, sdg:status some sdg:StatusKind, sdg:model some xsd:string, sdg:partitionType some xsd:string, sdg:iparCount some xsd:integer, sdg:lastHealthCheckDate some xsd:date, sdg:serverName some xsd:string, sdg:operatingSystem some xsd:string, sdg:isBreached some xsd:boolean, sdg:location some xsd:string, sdg:managedBy exactly 1 sdg:RACS, sdg:generates min 2 sdg:AccessLog, sdg:locatedIn exactly 1 sdg:Office, sdg:runs some sdg:SoftwareVersion, sdg:generates some sdg:SystemMetric, sdg:hostsDataFile some sdg:DataFile, sdg:managesEncryptionKey some sdg:EncryptionKey, sdg:runsAutomatedScript some sdg:AutomatedScript

Class: sdg:RACS
    Annotations: rdfs:label "Rediff Access Control System", iao:0000115 "A web-based application that controls remote server access, collects access logs, and provides reporting and diagnostic capabilities."
    SubClassOf: bfo:0000040, sdg:systemId some xsd:string, sdg:version some xsd:string, sdg:deploymentType some sdg:DeploymentTypeKind, sdg:haEnabled some xsd:boolean, sdg:lastAuditDate some xsd:date, sdg:complianceStandard some sdg:ComplianceStandardKind, sdg:manages min 2 sdg:Server, sdg:uses exactly 1 sdg:UMM, sdg:stores min 2 sdg:AccessLog

Class: sdg:UMM
    Annotations: rdfs:label "User Management Module", iao:0000115 "A centralized user management and authentication server that manages the central user database accessible by other applications in the Rediff network."
    SubClassOf: bfo:0000040, sdg:moduleId some xsd:string, sdg:databaseType some xsd:string, sdg:authenticationProtocol some xsd:string, sdg:registeredApplications some xsd:integer, sdg:lastSyncDate some xsd:dateTime, sdg:status some sdg:StatusKind, sdg:authenticates min 2 sdg:User, sdg:manages min 2 sdg:Role, sdg:providesAccessTo min 2 sdg:Application

Class: sdg:AccessLog
    Annotations: rdfs:label "Access Log Entry", iao:0000115 "A record of access activities on remote servers, including details of operations executed, used for reporting and analysis."
    SubClassOf: bfo:0000040, sdg:logId some xsd:string, sdg:timestamp some xsd:dateTime, sdg:userId some xsd:string, sdg:serverId some xsd:string, sdg:operationType some sdg:OperationTypeKind, sdg:status some sdg:StatusKind, sdg:generatedBy exactly 1 sdg:Server, sdg:recordedBy exactly 1 sdg:RACS, sdg:performedBy exactly 1 sdg:User

Class: sdg:Network
    Annotations: rdfs:label "Corporate Network", iao:0000115 "A mesh of interconnected networks peered with major ISPs, providing seamless and always available services, secured by firewalls and VPNs."
    SubClassOf: sdg:NetworkEntity, sdg:networkId some xsd:string, sdg:peeringISPs some xsd:string, sdg:firewallEnabled some xsd:boolean, sdg:vpnRequired some xsd:boolean, sdg:tlsVersion some xsd:string, sdg:ddosProtectionEnabled some xsd:boolean, sdg:connects min 1 sdg:DataCenter, sdg:monitoredBy exactly 1 sdg:ArbourSystem

Class: sdg:ArbourSystem
    Annotations: rdfs:label "DDoS Monitoring and Filtering System", iao:0000115 "A system that monitors and analyzes customer traffic in real-time to detect and filter DDoS attacks, ensuring optimum bandwidth utilization."
    SubClassOf: bfo:0000040, sdg:systemId some xsd:string, sdg:monitoringSchedule some xsd:string, sdg:alertProactive some xsd:boolean, sdg:filteringAutomatic some xsd:boolean, sdg:lastAnalysisDate some xsd:dateTime, sdg:status some sdg:StatusKind, sdg:monitors exactly 1 sdg:Network

Class: sdg:ProviderChangeRequest
    Annotations: rdfs:label "Provider Change Request", iao:0000115 "A formal administrative record submitted by a client to request a change in their assigned behavioral health service provider or clinic."
    SubClassOf: cco:ont00000995, sdg:requestId some xsd:string, sdg:clientMhNumber some xsd:string, sdg:clientName some xsd:string, sdg:guardianName some xsd:string, sdg:contactPhone some xsd:string, sdg:requestDate some xsd:dateTime, sdg:reasonForChange some xsd:string, sdg:status some sdg:StatusKind, sdg:submittedBy exactly 1 sdg:Client, sdg:reviewedBy max 1 sdg:Manager, sdg:targetsProviderType some sdg:ProviderRole, sdg:targetsProviderInstance max 1 sdg:Provider
    HasKey: sdg:requestId

Class: sdg:Client
    Annotations: rdfs:label "Client", iao:0000115 "An individual receiving or eligible for behavioral health and recovery services within the county system."
    SubClassOf: bfo:0000004, sdg:clientId some xsd:string, sdg:mhNumber some xsd:string, sdg:fullName some xsd:string, sdg:isMinor some xsd:boolean, sdg:primaryContactPhone some xsd:string, sdg:assignedClinic some xsd:string, sdg:dateOfBirth some xsd:date, sdg:contactEmail some xsd:string, sdg:contactPhone some xsd:string, sdg:residentialAddress some xsd:string, sdg:clientStatus some sdg:ClientStatusKind, sdg:occupation some xsd:string, sdg:industry some xsd:string, sdg:coachingNeeds some xsd:string, sdg:clientSince some xsd:date, sdg:hasRequest some sdg:ProviderChangeRequest, sdg:assignedToClinic max 1 sdg:Clinic, sdg:hasAccount some sdg:FinancialAccount, sdg:hasPortfolio some sdg:InvestmentPortfolio, sdg:receivesServiceFrom some sdg:FinancialPlanner, sdg:hasReferral some sdg:Referral, sdg:receivesEngagement some sdg:CoachingEngagement

Class: sdg:Manager
    Annotations: rdfs:label "Manager", iao:0000115 "A staff member, such as a Unit Chief or Supervisor, responsible for reviewing and adjudicating provider change requests."
    SubClassOf: sdg:Role, sdg:managerId some xsd:string, sdg:printedName some xsd:string, sdg:signature some xsd:string, sdg:reviewDate some xsd:dateTime, sdg:decisionText some xsd:string, sdg:notificationDate some xsd:dateTime, sdg:reviewsRequest some sdg:ProviderChangeRequest, sdg:worksAtClinic exactly 1 sdg:Clinic

Class: sdg:ProviderRole
    Annotations: rdfs:label "Provider Role", iao:0000115 "A functional role within the behavioral health system that a client may request to change, such as Psychiatrist or Case Manager."
    SubClassOf: bfo:0000023, sdg:roleCode some xsd:string, sdg:roleName some xsd:string, sdg:isClinical some xsd:boolean, sdg:requestedInChange some sdg:ProviderChangeRequest

Class: sdg:Provider
    Annotations: rdfs:label "Provider", iao:0000115 "A specific individual or entity providing behavioral health services, such as a named psychiatrist or clinic."
    SubClassOf: bfo:0000004, sdg:providerId some xsd:string, sdg:providerName some xsd:string, sdg:providerType some xsd:string, sdg:fullName some xsd:string, sdg:credential some sdg:CredentialKind, sdg:stateLicense some xsd:string, sdg:employmentStatus some sdg:EmploymentStatusKind, sdg:yearsExperience some xsd:integer, sdg:edExperienceYears some xsd:integer, sdg:residesInStateDetail some xsd:string, sdg:specialty some xsd:string, sdg:contactNumber some xsd:string, sdg:isRequestedChange some sdg:ProviderChangeRequest, sdg:affiliatedWithClinic some sdg:Clinic, sdg:worksAt exactly 1 sdg:Clinic, sdg:treats min 2 sdg:Patient, sdg:collaboratesWith min 2 sdg:Provider, sdg:leads max 1 sdg:Program, sdg:prescribes min 2 sdg:Prescription

Class: sdg:OzoneTherapySession
    Annotations: rdfs:label "Ozone Therapy Session", iao:0000115 "A clinical process representing a single administration of ozone/oxygen autohemotherapy to a patient."
    SubClassOf: bfo:0000015, sdg:sessionNumber some xsd:integer, sdg:ozoneConcentration some xsd:decimal, sdg:ozoneDose some xsd:decimal, sdg:treatmentDate some xsd:dateTime, sdg:administeredByDetail some xsd:string, sdg:sessionStatus some sdg:SessionStatusKind, sdg:administeredTo exactly 1 sdg:Patient, sdg:uses exactly 1 sdg:OzoneTherapyProtocol

Class: sdg:OphthalmologicalExam
    Annotations: rdfs:label "Ophthalmological Exam", iao:0000115 "A diagnostic process involving a set of tests to measure visual function parameters before or after ozone therapy."
    SubClassOf: bfo:0000015, sdg:examDate some xsd:dateTime, sdg:examType some xsd:string, sdg:visualAcuity some xsd:decimal, sdg:visualField some xsd:decimal, sdg:visualEvokedPotentials some xsd:decimal, sdg:contrastSensitivity some xsd:decimal, sdg:examPerformedBy some xsd:string, sdg:performedOn exactly 1 sdg:Patient, sdg:measures min 3 sdg:VisualFunctionParameter

Class: sdg:VisualFunctionParameter
    Annotations: rdfs:label "Visual Function Parameter", iao:0000115 "A measurable clinical outcome representing a specific aspect of visual function assessed during ophthalmological exams."
    SubClassOf: bfo:0000015, sdg:parameterName some xsd:string, sdg:preTreatmentValue some xsd:decimal, sdg:postTreatmentValue some xsd:decimal, sdg:improvementPercentage some xsd:decimal, sdg:improvementStatus some xsd:string, sdg:measuredIn exactly 1 sdg:OphthalmologicalExam, sdg:associatedWith exactly 1 sdg:Patient

Class: sdg:OzoneTherapyProtocol
    Annotations: rdfs:label "Ozone Therapy Protocol", iao:0000115 "A standardized clinical procedure defining the administration of ozone/oxygen autohemotherapy, including dosage and frequency."
    SubClassOf: bfo:0000015, sdg:protocolId some xsd:string, sdg:totalSessions some xsd:integer, sdg:oxygenRatio some xsd:decimal, sdg:administrationMethod some xsd:string, sdg:biochemicalAdjustment some xsd:boolean, sdg:appliedTo min 2 sdg:Patient, sdg:generates min 2 sdg:OzoneTherapySession

Class: sdg:RecruitingRole
    Annotations: rdfs:label "Recruiting Role", iao:0000115 "A professional position within an organization that is currently open for recruitment or has recently been filled, defined by specific responsibilities and required qualifications."
    SubClassOf: bfo:0000015, sdg:jobTitle some xsd:string, sdg:jobPostingId some xsd:string, sdg:department some xsd:string, sdg:location some xsd:string, sdg:postingDate some xsd:date, sdg:status some sdg:StatusKind, sdg:recruitedBy exactly 1 sdg:Recruiter, sdg:postedBy exactly 1 sdg:Organization, sdg:requiresSkill min 2 sdg:ProfessionalSkill

Class: sdg:Recruiter
    Annotations: rdfs:label "Recruiter", iao:0000115 "A professional responsible for identifying, attracting, and screening candidates for open positions within an organization."
    SubClassOf: bfo:0000015, sdg:recruiterId some xsd:string, sdg:specialization some sdg:SpecializationKind, sdg:employmentStatus some sdg:EmploymentStatusKind, sdg:lastContactDate some xsd:dateTime, sdg:connectionStatus some xsd:string, sdg:employs exactly 1 sdg:Organization, sdg:manages min 3 sdg:RecruitingRole

Class: sdg:CandidateProfile
    Annotations: rdfs:label "Candidate Profile", iao:0000115 "A structured record representing a job seeker's professional history, skills, and qualifications, typically maintained as a resume or CV."
    SubClassOf: cco:ont00000995, sdg:profileId some xsd:string, sdg:headline some xsd:string, sdg:currentRole some xsd:string, sdg:industry some xsd:string, sdg:lastUpdated some xsd:dateTime, sdg:isVerified some xsd:boolean, sdg:targetsRole some sdg:RecruitingRole, sdg:possessesSkill min 3 sdg:ProfessionalSkill, sdg:submittedTo some sdg:RecruitingRole

Class: sdg:ProfessionalSkill
    Annotations: rdfs:label "Professional Skill", iao:0000115 "A specific capability, expertise, or qualification required for or possessed by a candidate in a professional context."
    SubClassOf: bfo:0000016, sdg:skillId some xsd:string, sdg:skillName some xsd:string, sdg:proficiencyLevel some sdg:ProficiencyLevelKind, sdg:category some sdg:CategoryKind, sdg:certificationRequired some xsd:boolean, sdg:requiredBy some sdg:RecruitingRole, sdg:possessedBy some sdg:CandidateProfile

Class: sdg:CorporateNews
    Annotations: rdfs:label "Corporate News", iao:0000115 "A record of recent developments, investments, or strategic changes within an organization that may influence candidate motivation."
    SubClassOf: cco:ont00000995, sdg:newsId some xsd:string, sdg:headline some xsd:string, sdg:eventType some sdg:EventTypeKind, sdg:publicationDate some xsd:date, sdg:sourceUrl some xsd:string, sdg:impactLevel some sdg:ImpactLevelKind, sdg:pertainsTo exactly 1 sdg:Organization, sdg:citedBy some sdg:CandidateProfile

Class: sdg:Educator
    Annotations: rdfs:label "Educator", iao:0000115 "A person who engages in the practice of teaching or education."
    SubClassOf: sdg:educatorId some xsd:string, sdg:firstName some xsd:string, sdg:lastName some xsd:string, sdg:yearsOfExperience some xsd:integer, sdg:specialization some sdg:SpecializationKind, sdg:membershipStatus some sdg:MembershipStatusKind, sdg:affiliatedWith exactly 1 sdg:Chapter, sdg:participatesIn__escalated some sdg:Program

Class: sdg:Chapter
    Annotations: rdfs:label "Chapter", iao:0000115 "A local organizational unit of the Delta Kappa Gamma Society."
    SubClassOf: bfo:0000040, sdg:chapterId some xsd:string, sdg:chapterName some xsd:string, sdg:location some xsd:string, sdg:foundingDate some xsd:date, sdg:currentMembers some xsd:integer, sdg:hosts some sdg:Program, sdg:hasMember min 2 sdg:Educator
    HasKey: sdg:chapterId

Class: sdg:Specialization
    Annotations: rdfs:label "Specialization", iao:0000115 "A specific area of expertise or focus within the field of education."
    SubClassOf: bfo:0000040, sdg:specializationId some xsd:string, sdg:specializationName some xsd:string, sdg:description some xsd:string, sdg:hasEducator min 2 sdg:Educator

Class: sdg:AuthenticationCredential
    Annotations: rdfs:label "Authentication Credential", iao:0000115 "A specific set of credentials (username and password) used to authenticate a user account against a digital service."
    SubClassOf: sdg:Authority, sdg:credentialId some xsd:string, sdg:credentialType some sdg:CredentialTypeKind, sdg:isTemporary some xsd:boolean, sdg:issueDate some xsd:date, sdg:expiryDate some xsd:date, sdg:belongsTo exactly 1 sdg:UserAccount, sdg:validForService some sdg:DigitalService

Class: sdg:DigitalService
    Annotations: rdfs:label "Digital Service", iao:0000115 "A software application or platform provided by the institution that users access via the internet, such as Mūrau or Office 365."
    SubClassOf: cco:ont00000995, sdg:serviceId some xsd:string, sdg:serviceName some xsd:string, sdg:baseUrl some xsd:string, sdg:serviceType some sdg:ServiceTypeKind, sdg:status some sdg:StatusKind, sdg:lastUpdated some xsd:dateTime, sdg:providesApp some sdg:SoftwareApplication, sdg:storesDataIn max 1 sdg:CloudStorage

Class: sdg:SoftwareApplication
    Annotations: rdfs:label "Software Application", iao:0000115 "A specific program or tool within a digital service suite, such as Word, Teams, or OneNote, used for academic or administrative tasks."
    SubClassOf: cco:ont00000995, sdg:appId some xsd:string, sdg:appName some xsd:string, sdg:version some xsd:string, sdg:platform some sdg:PlatformKind, sdg:isBlendedLearningTool some xsd:boolean, sdg:partOfService exactly 1 sdg:DigitalService, sdg:installedOn some sdg:UserDevice

Class: sdg:UserDevice
    Annotations: rdfs:label "User Device", iao:0000115 "A physical computing device owned or used by a user to access institutional digital services and applications."
    SubClassOf: cco:ont00000995, sdg:deviceId some xsd:string, sdg:deviceType some sdg:DeviceTypeKind, sdg:osType some xsd:string, sdg:lastSyncDate some xsd:dateTime, sdg:operatingSystem some xsd:string, sdg:browserVersion some xsd:string, sdg:ownedBy exactly 1 sdg:UserAccount, sdg:runsApp some sdg:SoftwareApplication, sdg:belongsToMany some sdg:DataSubject, sdg:hosts some sdg:Cookie

Class: sdg:CloudStorage
    Annotations: rdfs:label "Cloud Storage", iao:0000115 "A remote, internet-based storage facility where user documents are automatically saved and synchronized across devices."
    SubClassOf: cco:ont00000995, sdg:storageId some xsd:string, sdg:storageName some xsd:string, sdg:capacityTb some xsd:decimal, sdg:isPrivate some xsd:boolean, sdg:autoSaveEnabled some xsd:boolean, sdg:belongsToService exactly 1 sdg:DigitalService, sdg:storesDocument some sdg:UserDocument

Class: sdg:UserDocument
    Annotations: rdfs:label "User Document", iao:0000115 "A digital file created or edited by a user within a software application, stored in cloud storage to prevent data loss."
    SubClassOf: cco:ont00000995, sdg:documentId some xsd:string, sdg:fileName some xsd:string, sdg:fileType some xsd:string, sdg:lastModified some xsd:dateTime, sdg:isSynced some xsd:boolean, sdg:createdBy exactly 1 sdg:UserAccount, sdg:storedIn exactly 1 sdg:CloudStorage, sdg:createdWithApp exactly 1 sdg:SoftwareApplication

Class: sdg:MenuCourse
    Annotations: rdfs:label "Menu Course", iao:0000115 "A single dish or beverage item offered as part of a structured multi-course dining experience."
    SubClassOf: cco:ont00000995, sdg:courseIdentifier some xsd:string, sdg:courseName some xsd:string, sdg:price some xsd:decimal, sdg:isVegetarian some xsd:boolean, sdg:isVegan some xsd:boolean, sdg:description some xsd:string, sdg:courseId some xsd:string, sdg:name some sdg:NameKind, sdg:sequenceOrder some xsd:integer, sdg:courseDescription some xsd:string, sdg:courseType some xsd:string, sdg:partOfMenu exactly 1 sdg:DiningPackage, sdg:containsIngredient some sdg:FoodIngredient, sdg:includesMenuItem some sdg:MenuItem, sdg:servedIn some sdg:DiningPackage

Class: sdg:DiningPackage
    Annotations: rdfs:label "Dining Package", iao:0000115 "A bundled offering of multiple menu courses and beverages sold at a fixed price."
    SubClassOf: cco:ont00000995, sdg:packageId some xsd:string, sdg:packageName some xsd:string, sdg:totalPrice some xsd:decimal, sdg:currencyCode some xsd:string, sdg:includesChampagneCocktail some xsd:boolean, sdg:serviceChargePercentage some xsd:decimal, sdg:packageIdentifier some xsd:string, sdg:courseCount some xsd:integer, sdg:includesBeverageDetail some xsd:boolean, sdg:packageStatus some xsd:string, sdg:includesCourse min 3 sdg:MenuCourse, sdg:appliesToRestaurant exactly 1 sdg:RestaurantOutlet, sdg:includesBeverage exactly 1 sdg:Beverage

Class: sdg:RestaurantOutlet
    Annotations: rdfs:label "Restaurant Outlet", iao:0000115 "A physical location where dining services are provided to customers."
    SubClassOf: bfo:0000015, sdg:outletId some xsd:string, sdg:outletName some xsd:string, sdg:addressLine1 some xsd:string, sdg:city some xsd:string, sdg:postalCode some xsd:string, sdg:operatingHours some xsd:string, sdg:hostsPackage some sdg:DiningPackage, sdg:employsStaff some sdg:RestaurantStaff
    HasKey: sdg:outletId

Class: sdg:RestaurantStaff
    Annotations: rdfs:label "Restaurant Staff", iao:0000115 "An individual performing a specific role within the restaurant's service or kitchen operations."
    SubClassOf: bfo:0000023, sdg:staffId some xsd:string, sdg:staffName some xsd:string, sdg:roleType some sdg:RoleTypeKind, sdg:shiftStart some xsd:dateTime, sdg:shiftEnd some xsd:dateTime, sdg:receivesServiceChargeShare some xsd:boolean, sdg:worksAtOutlet exactly 1 sdg:RestaurantOutlet, sdg:servesCourse some sdg:MenuCourse
    HasKey: sdg:staffId

Class: sdg:ServiceChargeRecord
    Annotations: rdfs:label "Service Charge Record", iao:0000115 "A financial record tracking the collection and distribution of service charges to staff."
    SubClassOf: sdg:Entity, sdg:recordId some xsd:string, sdg:transactionDate some xsd:dateTime, sdg:totalChargeAmount some xsd:decimal, sdg:chargePercentage some xsd:decimal, sdg:paymentMethod some sdg:PaymentMethodKind, sdg:isDeductedByCompany some xsd:boolean, sdg:linkedToPackage exactly 1 sdg:DiningPackage, sdg:distributedToStaff some sdg:RestaurantStaff

Class: sdg:Enrolment
    Annotations: rdfs:label "Enrolment", iao:0000115 "A continuant entity representing the state of a child being registered and attending a specific school."
    SubClassOf: bfo:0000002, sdg:applicationDate some xsd:dateTime, sdg:yearGroup some xsd:string, sdg:status some sdg:StatusKind, sdg:enrolmentStatus some sdg:EnrolmentStatusKind, sdg:durationYears some xsd:integer, sdg:donationAmount some xsd:decimal, sdg:enrolmentDate some xsd:dateTime, sdg:regardingChild exactly 1 sdg:Child, sdg:atSchool exactly 1 sdg:School, sdg:hasParent min 2 sdg:Parent, sdg:initiatedBy exactly 1 sdg:OccasionCard, sdg:managedBy max 1 sdg:PerpetualFolder, sdg:appliesTo exactly 1 sdg:Enrollee

Class: sdg:Child
    Annotations: rdfs:label "Child", iao:0000115 "A minor human being applying for or attending an educational institution."
    SubClassOf: bfo:0000004, sdg:fullLegalName some xsd:string, sdg:dateOfBirth some xsd:date, sdg:gender some sdg:GenderKind, sdg:permanentAddress some xsd:string, sdg:permanentPostalCode some xsd:string, sdg:childName some xsd:string, sdg:age some xsd:integer, sdg:sex some sdg:SexKind, sdg:shirtSize some xsd:string, sdg:pantsSize some xsd:string, sdg:shoeSize some xsd:string, sdg:diaperSize some xsd:string, sdg:favoriteColor some xsd:string, sdg:childId some xsd:string, sdg:fullName some xsd:string, sdg:yearGroup some xsd:string, sdg:birthCertificateReference some xsd:string, sdg:hasEnrolment some sdg:Enrolment, sdg:hasParent min 2 sdg:Parent, sdg:hasSibling some sdg:Child, sdg:dependentOf exactly 1 sdg:AidRecipient, sdg:wasEnrolledAt some sdg:School, sdg:livesWith min 2 sdg:Guardian

Class: sdg:AccreditationCertificate
    Annotations: rdfs:label "Accreditation Certificate", iao:0000115 "A formal document issued by an accreditation body attesting that an organization fulfills specific standards for calibration services."
    SubClassOf: sdg:Document, sdg:certificateNumber some xsd:string, sdg:issueDate some xsd:date, sdg:expiryDate some xsd:date, sdg:accreditationBody some xsd:string, sdg:status some sdg:StatusKind, sdg:issuingBodyName some xsd:string, sdg:issuedTo exactly 1 sdg:CalibrationLaboratory, sdg:certifiesComplianceWith min 2 sdg:CalibrationStandard, sdg:issuingAuthorityType some sdg:AccreditationBody, sdg:accredits exactly 1 sdg:AccreditedOrganization, sdg:coversScope exactly 1 sdg:AccreditationScope, sdg:mandatedBy min 2 sdg:AccreditationStandard

Class: sdg:CalibrationLaboratory
    Annotations: rdfs:label "Calibration Laboratory", iao:0000115 "A physical facility and organizational entity equipped to perform calibration measurements against defined standards."
    SubClassOf: bfo:0000040, sdg:laboratoryName some xsd:string, sdg:address some xsd:string, sdg:contactPhone some xsd:string, sdg:contactPerson some xsd:string, sdg:facilityType some sdg:FacilityTypeKind, sdg:holdsCertificate some sdg:AccreditationCertificate, sdg:performsCalibrationFor min 2 sdg:CalibrationParameter

Class: sdg:CalibrationStandard
    Annotations: rdfs:label "Calibration Standard", iao:0000115 "A recognized normative document or technical specification that defines the requirements for calibration competence."
    SubClassOf: cco:ont00000995, sdg:standardIdentifier some xsd:string, sdg:standardName some xsd:string, sdg:publicationYear some xsd:integer, sdg:issuingOrganizationDetail some xsd:string, sdg:requiredBy some sdg:AccreditationCertificate

Class: sdg:CalibrationParameter
    Annotations: rdfs:label "Calibration Parameter", iao:0000115 "A specific physical quantity or measurement capability that a laboratory is accredited to calibrate, including its range and uncertainty."
    SubClassOf: sdg:AssessmentTool, sdg:parameterName some xsd:string, sdg:measurementRange some xsd:string, sdg:expandedUncertainty some xsd:decimal, sdg:uncertaintyUnit some xsd:string, sdg:frequencyRange some xsd:string, sdg:coverageFactor some xsd:decimal, sdg:accreditationStatus some sdg:AccreditationStatusKind, sdg:performedBy exactly 1 sdg:CalibrationLaboratory, sdg:requiresStandard some sdg:CalibrationStandard

Class: sdg:MeasurementEquipment
    Annotations: rdfs:label "Measurement Equipment", iao:0000115 "A physical instrument or device used to perform or verify calibration measurements within a specific parameter domain."
    SubClassOf: sdg:AssessmentTool, sdg:equipmentType some xsd:string, sdg:equipmentModel some xsd:string, sdg:serialNumber some xsd:string, sdg:manufacturer some xsd:string, sdg:calibrationStatus some xsd:string, sdg:operationalStatus some sdg:OperationalStatusKind, sdg:usedForParameter some sdg:CalibrationParameter, sdg:maintainedBy exactly 1 sdg:CalibrationLaboratory

Class: sdg:VehicleInspectionRecord
    Annotations: rdfs:label "Vehicle Inspection Record", iao:0000115 "A formal assessment document recording the operational condition of a vehicle at a specific point in time, completed by a qualified mechanic."
    SubClassOf: sdg:Record, sdg:inspectionDate some xsd:dateTime, sdg:reviewDueDate some xsd:date, sdg:odometerReading some xsd:integer, sdg:registrationNumber some xsd:string, sdg:mechanicName some xsd:string, sdg:mechanicSignature some xsd:string, sdg:businessName some xsd:string, sdg:businessAddress some xsd:string, sdg:subjectDomain some xsd:string, sdg:assesses exactly 1 sdg:Vehicle, sdg:conductedBy exactly 1 sdg:QualifiedMechanic, sdg:records min 2 sdg:InspectionItem

Class: sdg:InspectionItem
    Annotations: rdfs:label "Inspection Item", iao:0000115 "A specific component or system of a vehicle evaluated for safety and operational compliance during a vehicle inspection."
    SubClassOf: cco:ont00000995, sdg:itemName some xsd:string, sdg:systemCategory some xsd:string, sdg:complianceStatus some sdg:ComplianceStatusKind, sdg:defectDescription some xsd:string, sdg:rectificationDate some xsd:date, sdg:partOf__escalated exactly 1 sdg:Vehicle, sdg:recordedIn exactly 1 sdg:VehicleInspectionRecord, sdg:linkedTo max 1 sdg:NonComplianceIssue

Class: sdg:NonComplianceIssue
    Annotations: rdfs:label "Non-Compliance Issue", iao:0000115 "A documented instance of a vehicle component failing to meet safety or operational standards, requiring rectification."
    SubClassOf: cco:ont00000995, sdg:issueNumber some xsd:integer, sdg:description some xsd:string, sdg:dateRectified some xsd:date, sdg:severity some sdg:SeverityKind, sdg:affects exactly 1 sdg:InspectionItem, sdg:resolvedBy max 1 sdg:QualifiedMechanic

Class: sdg:QualifiedMechanic
    Annotations: rdfs:label "Qualified Mechanic", iao:0000115 "A person holding the necessary qualifications and authority to perform vehicle safety inspections and certify compliance."
    SubClassOf: bfo:0000023, sdg:fullName some xsd:string, sdg:businessName some xsd:string, sdg:businessAddress some xsd:string, sdg:phone some xsd:string, sdg:fax some xsd:string, sdg:conducts min 2 sdg:VehicleInspectionRecord, sdg:resolves min 2 sdg:NonComplianceIssue

Class: sdg:ProtectedArea
    Annotations: rdfs:label "Protected Area", iao:0000115 "A geographically defined territory designated for conservation of biodiversity and natural/cultural heritage within the Alpine Convention perimeter."
    SubClassOf: cco:ont00000995, sdg:identifier some xsd:string, sdg:name some sdg:NameKind, sdg:areaHectares some xsd:decimal, sdg:establishedDate some xsd:date, sdg:protectionLevel some xsd:string, sdg:administeringEntity some xsd:string, sdg:isALPARCMember some xsd:boolean, sdg:areaSize some xsd:decimal, sdg:establishmentDate some xsd:date, sdg:managementStatus some xsd:string, sdg:zoningClassification some xsd:string, sdg:countryCode some sdg:CountryCodeKind, sdg:locatedIn exactly 1 sdg:AlpineRegion, sdg:participatesIn__escalated some sdg:TransalpineEcologicalNetwork, sdg:managedBy exactly 1 sdg:ManagementUnit, sdg:participatesIn__escalated some sdg:Project

Class: sdg:AlpineRegion
    Annotations: rdfs:label "Alpine Region", iao:0000115 "The geographical and political space covered by the Alpine Convention, spanning multiple sovereign states."
    SubClassOf: bfo:0000004, sdg:regionCode some xsd:string, sdg:totalAreaHectares some xsd:decimal, sdg:memberStates some sdg:MemberStatesKind, sdg:perimeterDefinitionDate some xsd:date, sdg:contains min 2 sdg:ProtectedArea

Class: sdg:TransalpineEcologicalNetwork
    Annotations: rdfs:label "Transalpine Ecological Network", iao:0000115 "A coordinated system of protected areas and ecological corridors designed to maintain biodiversity across Alpine borders."
    SubClassOf: cco:ont00000995, sdg:networkId some xsd:string, sdg:name some sdg:NameKind, sdg:establishedDate some xsd:date, sdg:totalCorridorLengthKm some xsd:decimal, sdg:status some sdg:StatusKind, sdg:coordinatingEntity some xsd:string, sdg:includes min 2 sdg:ProtectedArea, sdg:coordinatedBy exactly 1 sdg:ALPARC

Class: sdg:ALPARC
    Annotations: rdfs:label "ALPARC Network", iao:0000115 "The network organization coordinating protected area management, project implementation, and expertise exchange across the Alpine Convention area."
    SubClassOf: cco:ont00000995, sdg:organizationId some xsd:string, sdg:name some sdg:NameKind, sdg:foundedDate some xsd:date, sdg:headquartersCity some xsd:string, sdg:headquartersCountry some xsd:string, sdg:totalMemberAreas some xsd:integer, sdg:coveragePercentage some xsd:decimal, sdg:orgId some xsd:string, sdg:orgName some xsd:string, sdg:foundingYear some xsd:integer, sdg:websiteUrl some xsd:string, sdg:totalMembers some xsd:integer, sdg:coordinates some sdg:TransalpineEcologicalNetwork, sdg:manages some sdg:JointEuropeanProject, sdg:employs some sdg:ProjectLeader, sdg:organizes some sdg:ProfessionalEvent, sdg:coordinates some sdg:Project, sdg:coordinatesWith some sdg:ManagementUnit

Class: sdg:JointEuropeanProject
    Annotations: rdfs:label "Joint European Project", iao:0000115 "A time-bound, collaborative initiative funded under European programmes to achieve conservation or sustainable development goals in Alpine protected areas."
    SubClassOf: bfo:0000015, sdg:projectCode some xsd:string, sdg:title some xsd:string, sdg:startDate some xsd:dateTime, sdg:endDate some xsd:dateTime, sdg:fundingSource some sdg:FundingSourceKind, sdg:budgetEuros some xsd:decimal, sdg:status some sdg:StatusKind, sdg:deliverableCount some xsd:integer, sdg:involves min 2 sdg:ProtectedArea, sdg:coordinatedBy exactly 1 sdg:ALPARC, sdg:managedBy exactly 1 sdg:ProjectLeader, sdg:produces some sdg:Publication

Class: sdg:ProjectLeader
    Annotations: rdfs:label "Project Leader", iao:0000115 "A professional role responsible for managing and coordinating international conservation projects, events, and working groups within ALPARC."
    SubClassOf: bfo:0000023, sdg:employeeId some xsd:string, sdg:fullName some xsd:string, sdg:contractStartDate some xsd:date, sdg:contractEndDate some xsd:date, sdg:weeklyHours some xsd:integer, sdg:primaryLanguage some sdg:PrimaryLanguageKind, sdg:secondaryLanguage some xsd:string, sdg:hasDrivingLicense some xsd:boolean, sdg:yearsExperience some xsd:integer, sdg:educationLevel some sdg:EducationLevelKind, sdg:manages min 2 sdg:JointEuropeanProject, sdg:employedBy exactly 1 sdg:ALPARC, sdg:basedIn exactly 1 sdg:OfficeLocation, sdg:managesProject some sdg:Project, sdg:coordinatesWith some sdg:ManagementUnit

Class: sdg:ProfessionalEvent
    Annotations: rdfs:label "Professional Event", iao:0000115 "A scheduled gathering such as a conference, workshop, or symposium organized to facilitate knowledge exchange, project coordination, or training among protected area managers."
    SubClassOf: sdg:Event, sdg:eventId some xsd:string, sdg:title some xsd:string, sdg:eventType some sdg:EventTypeKind, sdg:startDate some xsd:dateTime, sdg:endDate some xsd:dateTime, sdg:locationCity some xsd:string, sdg:locationCountry some xsd:string, sdg:participantCount some xsd:integer, sdg:status some sdg:StatusKind, sdg:topic some xsd:string, sdg:organizedBy exactly 1 sdg:ALPARC, sdg:supports some sdg:JointEuropeanProject, sdg:coordinatedBy max 1 sdg:ProjectLeader

Class: sdg:MedicalDevice
    Annotations: rdfs:label "Medical Device", iao:0000115 "A physical or software-based medical instrument, implant, or system used for diagnosis, treatment, or monitoring of patients."
    SubClassOf: bfo:0000040, sdg:deviceIdentifier some xsd:string, sdg:manufacturer some xsd:string, sdg:modelNumber some xsd:string, sdg:serialNumber some xsd:string, sdg:operatingSystem some xsd:string, sdg:firmwareVersion some xsd:string, sdg:isNetworkCapable some xsd:boolean, sdg:isCurrentlyConnected some xsd:boolean, sdg:deploymentDate some xsd:dateTime, sdg:expectedServiceLifeYears some xsd:integer, sdg:hasRiskScore exactly 1 sdg:CyberRiskScore, sdg:locatedIn exactly 1 sdg:ClinicalSite, sdg:managedBy exactly 1 sdg:ClinicalEngineeringTeam, sdg:subjectTo some sdg:CyberThreat

Class: sdg:CyberRiskScore
    Annotations: rdfs:label "Cyber Risk Score", iao:0000115 "A quantitative or qualitative assessment of the cybersecurity vulnerability and potential impact of a medical device or system."
    SubClassOf: bfo:0000015, sdg:scoreValue some xsd:decimal, sdg:riskLevel some sdg:RiskLevelKind, sdg:assessmentDate some xsd:dateTime, sdg:scoringMethodology some xsd:string, sdg:isPrioritizedForResponse some xsd:boolean, sdg:responseAction some sdg:ResponseActionKind, sdg:appliesTo exactly 1 sdg:MedicalDevice, sdg:derivedFrom some sdg:CyberThreat

Class: sdg:CyberThreat
    Annotations: rdfs:label "Cyber Threat", iao:0000115 "A malicious activity, exploit, or vulnerability that targets medical devices or healthcare networks."
    SubClassOf: bfo:0000015, sdg:threatIdentifier some xsd:string, sdg:threatType some xsd:string, sdg:targetOperatingSystem some xsd:string, sdg:targetDeviceModel some xsd:string, sdg:discoveryDate some xsd:date, sdg:severityLevel some sdg:SeverityLevelKind, sdg:isExploited some xsd:boolean, sdg:mitigationStatus some sdg:MitigationStatusKind, sdg:affects some sdg:MedicalDevice, sdg:monitoredBy exactly 1 sdg:NetworkMonitoringSolution

Class: sdg:ClinicalSite
    Annotations: rdfs:label "Clinical Site", iao:0000115 "A physical or virtual location where medical devices are deployed and patient care is delivered, such as a hospital, outpatient clinic, or home care setting."
    SubClassOf: sdg:HealthcareEntity, sdg:siteIdentifier some xsd:string, sdg:siteName some xsd:string, sdg:siteType some sdg:SiteTypeKind, sdg:address some xsd:string, sdg:isConnectedToNetwork some xsd:boolean, sdg:totalDevicesAtSite some xsd:integer, sdg:lastAuditDate some xsd:date, sdg:siteId some xsd:string, sdg:name some sdg:NameKind, sdg:city some xsd:string, sdg:state some xsd:string, sdg:country some sdg:CountryKind, sdg:principalInvestigator some xsd:string, sdg:hosts min 2 sdg:MedicalDevice, sdg:managedBy exactly 1 sdg:ClinicalEngineeringTeam, sdg:hosts min 2 sdg:ClinicalTrial, sdg:collectsDataFor min 2 sdg:OutcomeMeasure

Class: sdg:ClinicalEngineeringTeam
    Annotations: rdfs:label "Clinical Engineering Team", iao:0000115 "A group of IT and clinical engineering personnel responsible for managing, maintaining, and securing medical devices and related infrastructure."
    SubClassOf: bfo:0000040, sdg:teamIdentifier some xsd:string, sdg:teamName some xsd:string, sdg:hasCIO some xsd:boolean, sdg:hasCISO some xsd:boolean, sdg:responsibilityScopeDetail some sdg:ResponsibilityScopeKind, sdg:isFormalized some xsd:boolean, sdg:manages min 2 sdg:MedicalDevice, sdg:manages min 2 sdg:ClinicalSite, sdg:implements exactly 1 sdg:CybersecurityProgram

Class: sdg:CybersecurityProgram
    Annotations: rdfs:label "Cybersecurity Program", iao:0000115 "A formalized set of policies, processes, and tools implemented by a healthcare organization to manage and mitigate cybersecurity risks associated with medical devices and networks."
    SubClassOf: bfo:0000015, sdg:programIdentifier some xsd:string, sdg:programName some xsd:string, sdg:isFormalized some xsd:boolean, sdg:hasRiskScoringProcess some xsd:boolean, sdg:hasNetworkMonitoring some xsd:boolean, sdg:hasDeviceInventoryManagement some xsd:boolean, sdg:hasDefinedRoles some xsd:boolean, sdg:implementationDate some xsd:dateTime, sdg:implementedBy exactly 1 sdg:ClinicalEngineeringTeam, sdg:covers min 2 sdg:MedicalDevice, sdg:monitors some sdg:CyberThreat

Class: sdg:NetworkMonitoringSolution
    Annotations: rdfs:label "Network Monitoring Solution", iao:0000115 "A software or hardware system that provides real-time visibility into network traffic, device connectivity, and potential cybersecurity threats."
    SubClassOf: sdg:NetworkEntity, sdg:solutionIdentifier some xsd:string, sdg:solutionName some xsd:string, sdg:isRealTime some xsd:boolean, sdg:monitorsDeviceInventory some xsd:boolean, sdg:detectsVulnerabilities some xsd:boolean, sdg:lastScanDate some xsd:dateTime, sdg:alertThreshold some xsd:decimal, sdg:primaryFunctionDetail some xsd:string, sdg:monitors min 2 sdg:MedicalDevice, sdg:monitors some sdg:CyberThreat, sdg:deployedAt exactly 1 sdg:ClinicalSite

Class: sdg:SailingEvent
    Annotations: rdfs:label "Sailing Event", iao:0000115 "A scheduled recreational sailing activity conducted by Mission Creek Sail Tours on San Francisco Bay."
    SubClassOf: bfo:0000015, sdg:eventId some xsd:string, sdg:eventDate some xsd:dateTime, sdg:eventType some sdg:EventTypeKind, sdg:status some sdg:StatusKind, sdg:maxCapacity some xsd:integer, sdg:actualParticipants some xsd:integer, sdg:hasCaptain exactly 1 sdg:Captain, sdg:hasCrew min 2 sdg:CrewMember, sdg:usesVessel exactly 1 sdg:Sailboat, sdg:occursAt exactly 1 sdg:Dock

Class: sdg:Captain
    Annotations: rdfs:label "Captain", iao:0000115 "A USCG licensed professional who operates the sailboat and manages safety during a sailing event."
    SubClassOf: bfo:0000023, sdg:captainId some xsd:string, sdg:licenseNumber some xsd:string, sdg:yearsExperience some xsd:integer, sdg:currentStatus some sdg:CurrentStatusKind, sdg:commands exactly 1 sdg:Sailboat, sdg:manages exactly 1 sdg:SailingEvent

Class: sdg:CrewMember
    Annotations: rdfs:label "Crew Member", iao:0000115 "A participant in a sailing event who assists with sailing tasks or observes under the captain's direction."
    SubClassOf: bfo:0000023, sdg:crewId some xsd:string, sdg:pfdRequired some xsd:boolean, sdg:pfdWorn some xsd:boolean, sdg:roleDetail some sdg:RoleKind, sdg:participatesIn exactly 1 sdg:SailingEvent, sdg:assignedTo exactly 1 sdg:Sailboat

Class: sdg:Sailboat
    Annotations: rdfs:label "Sailboat", iao:0000115 "A vessel designed for sailing, featuring sails, a keel, and rigging, used for recreational tours on San Francisco Bay."
    SubClassOf: cco:ont00000995, sdg:vesselId some xsd:string, sdg:vesselName some xsd:string, sdg:designHeelAngle some xsd:decimal, sdg:keelMaterial some sdg:KeelMaterialKind, sdg:currentHeelAngle some xsd:decimal, sdg:status some sdg:StatusKind, sdg:mooredAt exactly 1 sdg:Dock, sdg:equippedWith min 2 sdg:PFD, sdg:participatesIn exactly 1 sdg:SailingEvent

Class: sdg:Dock
    Annotations: rdfs:label "Dock", iao:0000115 "A fixed structure at the edge of San Francisco Bay where sailboats are prepared, rigged, and launched."
    SubClassOf: bfo:0000023, sdg:dockId some xsd:string, sdg:dockName some xsd:string, sdg:location some xsd:string, sdg:capacity some xsd:integer, sdg:hosts min 2 sdg:SailingEvent, sdg:moors min 2 sdg:Sailboat

Class: sdg:PFD
    Annotations: rdfs:label "Personal Flotation Device", iao:0000115 "A safety garment required for participants during races and optionally during introductory sails to prevent drowning."
    SubClassOf: cco:ont00000995, sdg:pfdId some xsd:string, sdg:size some xsd:string, sdg:certificationStandard some xsd:string, sdg:wornBy max 1 sdg:CrewMember, sdg:storedOn exactly 1 sdg:Sailboat

Class: sdg:ProductionRecord
    Annotations: rdfs:label "Production Record", iao:0000115 "A quantitative record of hydrocarbon extraction volume from a specific field or region over a defined period."
    SubClassOf: cco:ont00000995, sdg:recordId some xsd:string, sdg:volume some xsd:decimal, sdg:unit some sdg:UnitKind, sdg:startDate some xsd:dateTime, sdg:endDate some xsd:dateTime, sdg:source some xsd:string, sdg:measuredBy exactly 1 sdg:SurveyReport, sdg:originatesFrom exactly 1 sdg:GeographicRegion

Class: sdg:SurveyReport
    Annotations: rdfs:label "Survey Report", iao:0000115 "A formal document or dataset aggregating production statistics from multiple entities for a specific reporting period."
    SubClassOf: cco:ont00000958, sdg:reportId some xsd:string, sdg:publisher some xsd:string, sdg:publicationDate some xsd:date, sdg:reportType some sdg:ReportTypeKind, sdg:periodCovered some xsd:string, sdg:containsRecord min 2 sdg:ProductionRecord

Class: sdg:Institution
    Annotations: rdfs:label "Institution", iao:0000115 "An organized body or entity capable of issuing forecasts, conducting surveys, or regulating markets."
    SubClassOf: bfo:0000040, sdg:institutionId some xsd:string, sdg:name some sdg:NameKind, sdg:type some sdg:TypeKind, sdg:headquarters some xsd:string, sdg:identifier some xsd:string, sdg:location some xsd:string, sdg:foundedDate some xsd:date, sdg:institutionName some xsd:string, sdg:country some sdg:CountryKind, sdg:institutionType some sdg:InstitutionTypeKind, sdg:institutionCode some xsd:string, sdg:foundedYear some xsd:integer, sdg:address some xsd:string, sdg:issuesForecast min 2 sdg:PriceForecast, sdg:contains min 2 sdg:Department, sdg:grants some sdg:Degree, sdg:employs min 2 sdg:Researcher, sdg:hosts some sdg:ResearchProject, sdg:employs some sdg:ProjectManager, sdg:awards some sdg:AcademicQualification, sdg:hosts some sdg:ResearchDesk

Class: sdg:Commodity
    Annotations: rdfs:label "Commodity", iao:0000115 "A raw material or primary agricultural product that can be bought and sold, such as crude oil or natural gas."
    SubClassOf: bfo:0000040, sdg:commodityId some xsd:string, sdg:name some sdg:NameKind, sdg:type some sdg:TypeKind, sdg:unitOfMeasure some sdg:UnitOfMeasureKind, sdg:isSubjectOf min 2 sdg:PriceForecast
    HasKey: sdg:commodityId

Class: sdg:TradeTransaction
    Annotations: rdfs:label "Trade Transaction", iao:0000115 "An economic activity involving the exchange of hydrocarbon resources between a supplier and a buyer."
    SubClassOf: bfo:0000015, sdg:transactionId some xsd:string, sdg:volume some xsd:decimal, sdg:unit some sdg:UnitKind, sdg:date some xsd:dateTime, sdg:direction some sdg:DirectionKind, sdg:status some sdg:StatusKind, sdg:transactionDate some xsd:dateTime, sdg:transactionType some xsd:string, sdg:amount some xsd:decimal, sdg:currencyCode some xsd:string, sdg:executionStatus some xsd:string, sdg:settlementDate some xsd:date, sdg:involvesExporter exactly 1 sdg:GeographicRegion, sdg:involvesImporter exactly 1 sdg:GeographicRegion, sdg:transfers exactly 1 sdg:Commodity, sdg:affectsAsset exactly 1 sdg:FinancialAsset, sdg:linkedToAccount exactly 1 sdg:FinancialAccount, sdg:initiatedByClient exactly 1 sdg:Client, sdg:processedByAssistant exactly 1 sdg:FinancialPlanningAssistant

Class: sdg:AssetDivestment
    Annotations: rdfs:label "Asset Divestment", iao:0000115 "The process of selling or transferring ownership of physical or operational assets, such as land or production rights."
    SubClassOf: bfo:0000015, sdg:divestmentId some xsd:string, sdg:totalValue some xsd:decimal, sdg:currency some xsd:string, sdg:startDate some xsd:dateTime, sdg:endDate some xsd:dateTime, sdg:status some sdg:StatusKind, sdg:initiatedBy exactly 1 sdg:Company, sdg:transferredTo exactly 1 sdg:Company, sdg:involvesAsset min 2 sdg:LandParcel

Class: sdg:Protoplasm
    Annotations: rdfs:label "Biological Protoplasm", iao:0000115 "The living substance of a cell that exhibits irritability and retains engram patterns from past stimuli."
    SubClassOf: cco:ont00000995, sdg:protoplasmId some xsd:string, sdg:originDate some xsd:dateTime, sdg:irritabilityLevel some xsd:decimal, sdg:engramCount some xsd:integer, sdg:nuclearIntelligence some xsd:boolean, sdg:protoplasmType some sdg:ProtoplasmTypeKind, sdg:contains some sdg:Cell, sdg:retains some sdg:Engram

Class: sdg:Cell
    Annotations: rdfs:label "Biological Cell", iao:0000115 "The fundamental structural and functional unit of life, capable of division and containing protoplasm."
    SubClassOf: cco:ont00000995, sdg:cellId some xsd:string, sdg:divisionStage some sdg:DivisionStageKind, sdg:nucleusPresent some xsd:boolean, sdg:cellType some xsd:string, sdg:creationDate some xsd:dateTime, sdg:derivedFrom exactly 1 sdg:Protoplasm, sdg:dividesInto min 2 sdg:Cell, sdg:contains exactly 1 sdg:Nucleus

Class: sdg:Nucleus
    Annotations: rdfs:label "Cell Nucleus", iao:0000115 "The central organelle of a cell containing genetic material and intelligence."
    SubClassOf: cco:ont00000995, sdg:nucleusId some xsd:string, sdg:intelligenceLevel some xsd:decimal, sdg:chromosomeCount some xsd:integer, sdg:divisionState some sdg:DivisionStateKind, sdg:partOf__escalated exactly 1 sdg:Cell, sdg:dividesInto min 2 sdg:Nucleus

Class: sdg:Engram
    Annotations: rdfs:label "Memory Engram", iao:0000115 "A persistent trace of a past stimulus and the protoplasm's reaction to it, forming the basis of memory."
    SubClassOf: cco:ont00000995, sdg:engramId some xsd:string, sdg:stimulusEnergy some xsd:decimal, sdg:reactionPattern some xsd:string, sdg:retentionDate some xsd:dateTime, sdg:disorderAssociation some xsd:boolean, sdg:retainedBy exactly 1 sdg:Protoplasm, sdg:causedBy exactly 1 sdg:Stimulus, sdg:contributesTo some sdg:MentalDisorder

Class: sdg:Stimulus
    Annotations: rdfs:label "Environmental Stimulus", iao:0000115 "An external energy or event that provokes a response from protoplasm."
    SubClassOf: bfo:0000015, sdg:stimulusId some xsd:string, sdg:energyLevel some xsd:decimal, sdg:stimulusType some sdg:StimulusTypeKind, sdg:timestamp some xsd:dateTime, sdg:source some xsd:string, sdg:affects some sdg:Protoplasm, sdg:triggers some sdg:Engram

Class: sdg:MentalDisorder
    Annotations: rdfs:label "Psychological Disorder", iao:0000115 "A condition arising from accumulated engram patterns that disrupt normal mental functioning."
    SubClassOf: bfo:0000015, sdg:disorderId some xsd:string, sdg:disorderName some xsd:string, sdg:severity some sdg:SeverityKind, sdg:onsetDate some xsd:dateTime, sdg:treatmentStatus some xsd:string, sdg:causedBy min 2 sdg:Engram, sdg:affects some sdg:Human

Class: sdg:Human
    Annotations: rdfs:label "Human Individual", iao:0000115 "A living human being derived from ancestral protoplasm and shaped by early stimuli."
    SubClassOf: bfo:0000004, sdg:humanId some xsd:string, sdg:birthDate some xsd:date, sdg:geneticLineage some xsd:string, sdg:earlyStimulusExposure some xsd:decimal, sdg:collectiveUnconsciousAccess some xsd:boolean, sdg:givenName some xsd:string, sdg:familyName some xsd:string, sdg:roleDetail some sdg:RoleKind, sdg:ancestralTown some xsd:string, sdg:occupation some xsd:string, sdg:derivedFrom exactly 1 sdg:Protoplasm, sdg:experiences some sdg:Stimulus, sdg:carries some sdg:Engram, sdg:residesIn max 1 sdg:Location, sdg:participatedIn some sdg:CensusRegistration

Class: sdg:Judgment
    Annotations: rdfs:label "Judgment", iao:0000115 "The formal decision or ruling issued by a court or tribunal in a legal case."
    SubClassOf: bfo:0000040, sdg:judgmentId some xsd:string, sdg:rulingType some xsd:string, sdg:sentenceLength some xsd:decimal, sdg:fineAmount some xsd:decimal, sdg:legalReasoning some xsd:string, sdg:appealStatus some sdg:AppealStatusKind, sdg:issuedIn exactly 1 sdg:LegalCase, sdg:appliesTo some sdg:LegalStatute

Class: sdg:LegalPublication
    Annotations: rdfs:label "Legal Publication", iao:0000115 "A written work, such as an article or book, discussing legal topics, cases, or practices."
    SubClassOf: bfo:0000040, sdg:pubId some xsd:string, sdg:title some xsd:string, sdg:publicationDate some xsd:date, sdg:publisher some xsd:string, sdg:journalName some xsd:string, sdg:topic some xsd:string, sdg:authoredBy some sdg:LegalPerson, sdg:cites some sdg:LegalCase

Class: sdg:CapacityEnhancement
    Annotations: rdfs:label "Capacity Enhancement Event", iao:0000115 "A planned process of increasing the manufacturing output capacity of a facility over a specific period."
    SubClassOf: bfo:0000015, sdg:plannedCapacityMW some xsd:decimal, sdg:actualCapacityMW some xsd:decimal, sdg:planningPeriod some xsd:string, sdg:effectiveDate some xsd:date, sdg:status some sdg:StatusKind, sdg:targetedAt exactly 1 sdg:ManufacturingFacility, sdg:executedBy exactly 1 sdg:Enterprise

Class: sdg:ManufacturingFacility
    Annotations: rdfs:label "Manufacturing Facility", iao:0000115 "A physical site or complex dedicated to the production of specific industrial goods."
    SubClassOf: sdg:System, sdg:facilityName some xsd:string, sdg:location some xsd:string, sdg:facilityType some sdg:FacilityTypeKind, sdg:operationalStatus some sdg:OperationalStatusKind, sdg:locatedIn exactly 1 sdg:GeographicRegion, sdg:produces some sdg:ProductLine

Class: sdg:ProductLine
    Annotations: rdfs:label "Product Line", iao:0000115 "A specific category of manufactured goods or technology developed by an enterprise."
    SubClassOf: bfo:0000040, sdg:productCategory some xsd:string, sdg:technologyReadinessLevel some xsd:integer, sdg:targetOutputMW some xsd:decimal, sdg:isStrategic some xsd:boolean, sdg:developedBy exactly 1 sdg:Enterprise, sdg:manufacturedAt some sdg:ManufacturingFacility

Class: sdg:Enterprise
    Annotations: rdfs:label "Enterprise", iao:0000115 "A corporate entity or organization engaged in industrial or commercial activities."
    SubClassOf: sdg:BusinessEntity, sdg:enterpriseName some xsd:string, sdg:ownershipType some sdg:OwnershipTypeKind, sdg:registrationNumber some xsd:string, sdg:regulatoryAuthority some xsd:string, sdg:owns some sdg:ManufacturingFacility, sdg:develops some sdg:ProductLine, sdg:partnersWith some sdg:Enterprise

Class: sdg:RoleConcept
    Annotations: rdfs:label "Role Concept", iao:0000115 "A theoretical construct representing the concept of 'role' as understood through various perspectives such as symbolic interactionism, psychology, and organizational theory."
    SubClassOf: bfo:0000040, sdg:conceptId some xsd:string, sdg:originLanguage some xsd:string, sdg:theoreticalPerspective some xsd:string, sdg:definitionText some xsd:string, sdg:relatedConcepts some xsd:string, sdg:influences some sdg:RoleEnactment, sdg:influences some sdg:RolePerception

Class: sdg:RoleEnactment
    Annotations: rdfs:label "Role Enactment", iao:0000115 "The process by which community learning disability nurses (CLDNs) carry out their roles in meeting the healthcare needs of people with learning disabilities."
    SubClassOf: bfo:0000015, sdg:enactmentId some xsd:string, sdg:qualityOfEnactment some xsd:string, sdg:influencingFactors some xsd:string, sdg:interAgencyBoundaries some xsd:boolean, sdg:roleConflictPresent some xsd:boolean, sdg:influencedBy some sdg:RoleConcept, sdg:performedBy exactly 1 sdg:CLDN, sdg:affects some sdg:HealthcareDelivery
    HasKey: sdg:enactmentId

Class: sdg:RolePerception
    Annotations: rdfs:label "Role Perception", iao:0000115 "The way in which community learning disability nurses (CLDNs) understand and interpret their roles based on interactions and expectations."
    SubClassOf: sdg:perceptionId some xsd:string, sdg:clarityLevel some xsd:string, sdg:influencingFactors some xsd:string, sdg:publicHealthRoles some xsd:boolean, sdg:reflexivePractice some xsd:boolean, sdg:influencedBy some sdg:RoleConcept, sdg:perceivedBy exactly 1 sdg:CLDN, sdg:affects some sdg:RoleEnactment

Class: sdg:CLDN
    Annotations: rdfs:label "Community Learning Disability Nurse", iao:0000115 "A healthcare professional specializing in providing care to individuals with learning disabilities in community settings."
    SubClassOf: bfo:0000002, sdg:nurseId some xsd:string, sdg:specialization some sdg:SpecializationKind, sdg:yearsOfExperience some xsd:integer, sdg:interAgencyCollaboration some xsd:boolean, sdg:roleClarity some xsd:string, sdg:enacts some sdg:RoleEnactment, sdg:perceives some sdg:RolePerception, sdg:collaboratesWith some sdg:InterAgencyBoundary

Class: sdg:HealthcareDelivery
    Annotations: rdfs:label "Healthcare Delivery", iao:0000115 "The process of providing healthcare services to individuals with learning disabilities, influenced by the clarity and enactment of roles by community learning disability nurses."
    SubClassOf: bfo:0000015, sdg:deliveryId some xsd:string, sdg:serviceType some sdg:ServiceTypeKind, sdg:complexityLevel some xsd:string, sdg:patientNeeds some xsd:string, sdg:effectiveness some sdg:EffectivenessKind, sdg:providedBy some sdg:CLDN, sdg:influencedBy some sdg:RoleEnactment, sdg:serves some sdg:Patient

Class: sdg:InterAgencyBoundary
    Annotations: rdfs:label "Inter-Agency Boundary", iao:0000115 "The boundaries between different agencies involved in the care of individuals with learning disabilities, which can influence role enactment and clarity."
    SubClassOf: bfo:0000040, sdg:boundaryId some xsd:string, sdg:agencyType some sdg:AgencyTypeKind, sdg:tensionLevel some xsd:string, sdg:encroachmentPresent some xsd:boolean, sdg:impactOnRole some sdg:ImpactOnRoleKind, sdg:crossedBy some sdg:CLDN, sdg:influences some sdg:RoleEnactment, sdg:affects some sdg:RolePerception

Class: sdg:Colloquium
    Annotations: rdfs:label "Academic Colloquium Event", iao:0000115 "A scheduled academic presentation event where a speaker discusses a specific research topic to an audience."
    SubClassOf: bfo:0000015, sdg:identifier some xsd:string, sdg:title some xsd:string, sdg:scheduledDate some xsd:dateTime, sdg:startTime some xsd:dateTime, sdg:endTime some xsd:dateTime, sdg:status some sdg:StatusKind, sdg:registrationRequired some xsd:boolean, sdg:presentedBy exactly 1 sdg:Speaker, sdg:heldAt exactly 1 sdg:Venue, sdg:partOf__escalated exactly 1 sdg:Series, sdg:hasAbstract exactly 1 sdg:Abstract

Class: sdg:Speaker
    Annotations: rdfs:label "Academic Speaker", iao:0000115 "An individual who delivers a presentation or lecture at an academic event."
    SubClassOf: bfo:0000015, sdg:identifier some xsd:string, sdg:fullName some xsd:string, sdg:highestDegree some xsd:string, sdg:degreeGrantingInstitution some xsd:string, sdg:department some xsd:string, sdg:affiliation some sdg:AffiliationKind, sdg:delivers some sdg:Colloquium, sdg:affiliatedWith some sdg:Institution

Class: sdg:Venue
    Annotations: rdfs:label "Physical Event Location", iao:0000115 "A specific physical location or room where an academic event takes place."
    SubClassOf: bfo:0000015, sdg:identifier some xsd:string, sdg:buildingName some xsd:string, sdg:roomNumber some xsd:string, sdg:floor some xsd:integer, sdg:capacity some xsd:integer, sdg:locationType some sdg:LocationTypeKind, sdg:venueId some xsd:string, sdg:venueName some xsd:string, sdg:city some xsd:string, sdg:country some sdg:CountryKind, sdg:floorType some xsd:string, sdg:hosts some sdg:Colloquium, sdg:locatedIn exactly 1 sdg:Building, sdg:hostsEvent min 2 sdg:DanceEvent

Class: sdg:Series
    Annotations: rdfs:label "Academic Event Series", iao:0000115 "A recurring collection of academic events organized under a common theme or department."
    SubClassOf: bfo:0000015, sdg:identifier some xsd:string, sdg:name some sdg:NameKind, sdg:academicTerm some xsd:string, sdg:organizingDepartment some xsd:string, sdg:frequency some sdg:FrequencyKind, sdg:contains min 2 sdg:Colloquium, sdg:organizedBy exactly 1 sdg:Department

Class: sdg:Abstract
    Annotations: rdfs:label "Event Description Document", iao:0000115 "A textual summary or description of the content and purpose of an academic presentation."
    SubClassOf: cco:ont00000958, sdg:identifier some xsd:string, sdg:url some xsd:string, sdg:wordCount some xsd:integer, sdg:language some sdg:LanguageKind, sdg:lastModified some xsd:dateTime, sdg:accessLevel some sdg:AccessLevelKind, sdg:describes exactly 1 sdg:Colloquium, sdg:createdBy exactly 1 sdg:Speaker

Class: sdg:Department
    Annotations: rdfs:label "Academic Department", iao:0000115 "An administrative division within an educational institution responsible for academic programs and events."
    SubClassOf: bfo:0000015, sdg:identifier some xsd:string, sdg:name some sdg:NameKind, sdg:code some xsd:string, sdg:parentInstitution some xsd:string, sdg:establishedDate some xsd:date, sdg:departmentId some xsd:string, sdg:departmentName some xsd:string, sdg:headStaffId some xsd:string, sdg:budgetAllocation some xsd:decimal, sdg:deptId some xsd:string, sdg:deptName some xsd:string, sdg:headCount some xsd:integer, sdg:budget some xsd:decimal, sdg:isSharedService some xsd:boolean, sdg:operationalStatus some sdg:OperationalStatusKind, sdg:collegeId some xsd:string, sdg:chairpersonName some xsd:string, sdg:status some sdg:StatusKind, sdg:organizes some sdg:Series, sdg:partOf__escalated exactly 1 sdg:Institution, sdg:employs some sdg:FinancialStaff, sdg:oversees some sdg:WasteProcessingFacility, sdg:manages some sdg:FinancialReport, sdg:hasExecutive exactly 1 sdg:Executive, sdg:supports exactly 1 sdg:Brand, sdg:employs min 2 sdg:Employee, sdg:collaboratesWith some sdg:Department, sdg:offers min 2 sdg:AcademicProgram, sdg:offers min 3 sdg:PrerequisiteCourse, sdg:oversees some sdg:AdmissionCriteria, sdg:containsPosition min 2 sdg:Position, sdg:headOf max 1 sdg:Employee, sdg:reportsTo max 1 sdg:Department

Class: sdg:Degree
    Annotations: rdfs:label "Academic Qualification", iao:0000115 "An academic title conferred by an educational institution upon completion of a course of study."
    SubClassOf: bfo:0000015, sdg:identifier some xsd:string, sdg:name some sdg:NameKind, sdg:level some sdg:LevelKind, sdg:field some xsd:string, sdg:issuingInstitution some xsd:string, sdg:awardedBy exactly 1 sdg:Institution, sdg:heldBy some sdg:Speaker

Class: sdg:ChemicalSubstance
    Annotations: rdfs:label "Chemical Substance", iao:0000115 "A material entity that is composed of atoms and molecules and has a specific chemical structure and properties."
    SubClassOf: bfo:0000040, sdg:casNumber some xsd:string, sdg:commonName some xsd:string, sdg:molecularFormula some xsd:string, sdg:physicalState some xsd:string, sdg:solubilityInWater some xsd:boolean, sdg:solubilityInOrganicSolvents some xsd:string, sdg:meltingPoint some xsd:decimal, sdg:boilingPoint some xsd:decimal, sdg:hasCarcinogenicityStatus exactly 1 sdg:CarcinogenicityAssessment, sdg:hasHalfLifeInHumans exactly 1 sdg:PharmacokineticParameter, sdg:hasHalfLifeInRodents exactly 1 sdg:PharmacokineticParameter, sdg:bindsToReceptor some sdg:BiologicalReceptor

Class: sdg:CarcinogenicityAssessment
    Annotations: rdfs:label "Carcinogenicity Assessment", iao:0000115 "A record or dataset that documents the evaluation of a substance's potential to cause cancer in humans or animals."
    SubClassOf: cco:ont00000995, sdg:assessmentDate some xsd:dateTime, sdg:carcinogenicityStatus some xsd:string, sdg:evidenceLevel some sdg:EvidenceLevelKind, sdg:reportingBody some xsd:string, sdg:reportYear some xsd:integer, sdg:reportTitle some xsd:string, sdg:isMutagenic some xsd:boolean, sdg:genotoxicityFindings some xsd:string, sdg:assessesChemical exactly 1 sdg:ChemicalSubstance, sdg:basedOnHumanStudies min 2 sdg:EpidemiologicalStudy, sdg:basedOnAnimalStudies min 2 sdg:AnimalCarcinogenicityStudy, sdg:usesMechanismOfAction some sdg:MechanismOfCarcinogenesis

Class: sdg:EpidemiologicalStudy
    Annotations: rdfs:label "Epidemiological Study", iao:0000115 "A research activity that investigates the distribution and determinants of health-related states or events in specified populations."
    SubClassOf: bfo:0000015, sdg:studyId some xsd:string, sdg:studyStartDate some xsd:date, sdg:studyEndDate some xsd:date, sdg:populationSize some xsd:integer, sdg:exposureLevel some sdg:ExposureLevelKind, sdg:cohortLocation some xsd:string, sdg:cancerTypesObserved some xsd:string, sdg:mortalityIncrease some xsd:decimal, sdg:studiesExposureTo exactly 1 sdg:ChemicalSubstance, sdg:conductedBy some sdg:ResearchInstitution, sdg:evaluatedBy some sdg:CarcinogenicityAssessment
    HasKey: sdg:studyId

Class: sdg:AnimalCarcinogenicityStudy
    Annotations: rdfs:label "Animal Carcinogenicity Study", iao:0000115 "A research activity that tests the carcinogenic potential of a substance in experimental animals."
    SubClassOf: bfo:0000015, sdg:studyId some xsd:string, sdg:studyStartDate some xsd:date, sdg:studyEndDate some xsd:date, sdg:animalSpecies some xsd:string, sdg:exposureRoute some sdg:ExposureRouteKind, sdg:tissueSitesAffected some xsd:string, sdg:doseDependent some xsd:boolean, sdg:tumorIncidence some xsd:decimal, sdg:testsSubstanceOn exactly 1 sdg:ChemicalSubstance, sdg:conductedBy some sdg:ResearchInstitution, sdg:evaluatedBy some sdg:CarcinogenicityAssessment

Class: sdg:MechanismOfCarcinogenesis
    Annotations: rdfs:label "Mechanism of Carcinogenesis", iao:0000115 "A biological process or activity that describes how a substance induces cancer at the molecular and cellular level."
    SubClassOf: bfo:0000015, sdg:mechanismId some xsd:string, sdg:mechanismName some xsd:string, sdg:isNecessaryStep some xsd:boolean, sdg:isSufficientStep some xsd:boolean, sdg:observedInSpecies some xsd:string, sdg:biologicalResponse some xsd:string, sdg:initiatedBy exactly 1 sdg:ChemicalSubstance, sdg:involvesReceptor exactly 1 sdg:BiologicalReceptor, sdg:leadsTo some sdg:CarcinogenicityAssessment
    HasKey: sdg:mechanismId

Class: sdg:BiologicalReceptor
    Annotations: rdfs:label "Biological Receptor", iao:0000115 "A macromolecule that receives signals and triggers a response in a cell."
    SubClassOf: bfo:0000040, sdg:receptorId some xsd:string, sdg:receptorName some xsd:string, sdg:ubiquitousInVertebrates some xsd:boolean, sdg:affinityForTCDD some sdg:AffinityForTCDDKind, sdg:function some xsd:string, sdg:bindsWith some sdg:ChemicalSubstance, sdg:mediatesMechanism some sdg:MechanismOfCarcinogenesis
    HasKey: sdg:receptorId

Class: sdg:PharmacokineticParameter
    Annotations: rdfs:label "Pharmacokinetic Parameter", iao:0000115 "A measured or recorded value that describes the rate at which a substance is eliminated from the body."
    SubClassOf: cco:ont00000995, sdg:parameterId some xsd:string, sdg:parameterName some xsd:string, sdg:value some xsd:decimal, sdg:unit some sdg:UnitKind, sdg:species some xsd:string, sdg:sourceReference some xsd:string, sdg:describesChemical exactly 1 sdg:ChemicalSubstance

Class: sdg:PreparationMethod
    Annotations: rdfs:label "Preparation Method", iao:0000115 "A specific culinary process or technique applied to ingredients to create a menu item, such as frying, baking, or flambéing."
    SubClassOf: bfo:0000015, sdg:methodId some xsd:string, sdg:name some sdg:NameKind, sdg:cookingTemperature some xsd:decimal, sdg:cookingDuration some xsd:integer, sdg:transformsIngredient min 2 sdg:Ingredient, sdg:producesMenuItem some sdg:MenuItem

Class: sdg:DrinkVariant
    Annotations: rdfs:label "Drink Variant", iao:0000115 "A specific variation of a cocktail or beverage, defined by its base alcohol, mixers, and garnish."
    SubClassOf: cco:ont00000995, sdg:variantId some xsd:string, sdg:name some sdg:NameKind, sdg:baseAlcohol some xsd:string, sdg:price some xsd:decimal, sdg:alcoholContent some xsd:decimal, sdg:containsIngredient min 2 sdg:Ingredient, sdg:isVariantOf some sdg:MenuItem
    HasKey: sdg:variantId

Class: sdg:OmeletteAddOn
    Annotations: rdfs:label "Omelette Add-On", iao:0000115 "An optional ingredient or topping that can be added to a base omelette for an additional fee."
    SubClassOf: cco:ont00000995, sdg:addOnId some xsd:string, sdg:name some sdg:NameKind, sdg:additionalCost some xsd:decimal, sdg:category some sdg:CategoryKind, sdg:isAddedTo some sdg:MenuItem, sdg:isIngredient exactly 1 sdg:Ingredient

Class: sdg:ShockAbsorber
    Annotations: rdfs:label "Shock Absorber", iao:0000115 "A mechanical device designed to absorb and dampen shock energy in delicate structures."
    SubClassOf: cco:ont00000995, sdg:identifier some xsd:string, sdg:model some xsd:string, sdg:maxForce some xsd:decimal, sdg:maxVoltage some xsd:decimal, sdg:maxPower some xsd:decimal, sdg:status some sdg:StatusKind, sdg:installationDate some xsd:date, sdg:installedIn exactly 1 sdg:Structure, sdg:measuredBy some sdg:TemperatureReading, sdg:usedWith some sdg:PowerSystem

Class: sdg:Structure
    Annotations: rdfs:label "Structure", iao:0000115 "A physical construction or building component subject to shock and environmental stress."
    SubClassOf: cco:ont00000995, sdg:identifier some xsd:string, sdg:name some sdg:NameKind, sdg:location some xsd:string, sdg:area some xsd:decimal, sdg:volume some xsd:decimal, sdg:status some sdg:StatusKind, sdg:constructionDate some xsd:dateTime, sdg:hasShockAbsorber some sdg:ShockAbsorber, sdg:experiences some sdg:ShockEvent

Class: sdg:ShockEvent
    Annotations: rdfs:label "Shock Event", iao:0000115 "A transient physical event involving the propagation of a shock wave through a medium."
    SubClassOf: bfo:0000015, sdg:identifier some xsd:string, sdg:startTime some xsd:dateTime, sdg:endTime some xsd:dateTime, sdg:intensity some xsd:decimal, sdg:depth some xsd:decimal, sdg:force some xsd:decimal, sdg:status some sdg:StatusKind, sdg:duration some xsd:decimal, sdg:affects some sdg:Structure, sdg:causes some sdg:TemperatureReading, sdg:measuredBy some sdg:Sensor

Class: sdg:TemperatureReading
    Annotations: rdfs:label "Temperature Reading", iao:0000115 "A recorded measurement of temperature at a specific point in time and space."
    SubClassOf: cco:ont00000995, sdg:identifier some xsd:string, sdg:value some xsd:decimal, sdg:unit some sdg:UnitKind, sdg:timestamp some xsd:dateTime, sdg:location some xsd:string, sdg:status some sdg:StatusKind, sdg:sensorId some xsd:string, sdg:recordedAt exactly 1 sdg:Structure, sdg:causedBy some sdg:ShockEvent, sdg:measuredBy exactly 1 sdg:Sensor

Class: sdg:PowerSystem
    Annotations: rdfs:label "Power System", iao:0000115 "An electrical system providing power to shock-absorbing or wave-generating equipment."
    SubClassOf: cco:ont00000995, sdg:identifier some xsd:string, sdg:voltage some xsd:decimal, sdg:current some xsd:decimal, sdg:power some xsd:decimal, sdg:status some sdg:StatusKind, sdg:installationDate some xsd:date, sdg:cableType some xsd:string, sdg:powers some sdg:ShockAbsorber, sdg:locatedIn exactly 1 sdg:Structure, sdg:monitoredBy some sdg:Sensor

Class: sdg:Sensor
    Annotations: rdfs:label "Sensor", iao:0000115 "A device used to measure physical properties such as temperature, force, or pressure."
    SubClassOf: cco:ont00000995, sdg:identifier some xsd:string, sdg:type some sdg:TypeKind, sdg:accuracy some xsd:decimal, sdg:status some sdg:StatusKind, sdg:installationDate some xsd:date, sdg:calibrationDate some xsd:dateTime, sdg:measures some sdg:TemperatureReading, sdg:monitors some sdg:PowerSystem, sdg:installedIn exactly 1 sdg:Structure

Class: sdg:ImagingStudy
    Annotations: rdfs:label "Imaging Study", iao:0000115 "A recorded medical imaging examination performed on a patient using a specific modality."
    SubClassOf: cco:ont00000995, sdg:studyIdentifier some xsd:string, sdg:modality some sdg:ModalityKind, sdg:studyDate some xsd:dateTime, sdg:bodyRegion some xsd:string, sdg:status some sdg:StatusKind, sdg:contrastUsed some xsd:boolean, sdg:studyId some xsd:string, sdg:isDiagnostic some xsd:boolean, sdg:findingsDescription some xsd:string, sdg:performedAt exactly 1 sdg:HospitalCampus, sdg:interpretedBy max 1 sdg:Radiologist, sdg:usesSoftware some sdg:PostProcessingSoftware, sdg:diagnoses some sdg:GanglionCyst

Class: sdg:Radiologist
    Annotations: rdfs:label "Radiologist", iao:0000115 "A medical doctor who specializes in interpreting medical images and performing imaging-related procedures."
    SubClassOf: bfo:0000023, sdg:physicianIdentifier some xsd:string, sdg:fullName some xsd:string, sdg:certificationBody some xsd:string, sdg:specialization some sdg:SpecializationKind, sdg:employmentStatus some sdg:EmploymentStatusKind, sdg:bilingual some xsd:boolean, sdg:worksAt some sdg:HospitalCampus, sdg:interprets min 2 sdg:ImagingStudy, sdg:performsProcedure some sdg:ThoracicProcedure

Class: sdg:HospitalCampus
    Annotations: rdfs:label "Hospital Campus", iao:0000115 "A physical location or facility within a hospital system where medical services are delivered."
    SubClassOf: bfo:0000040, sdg:campusCode some xsd:string, sdg:campusName some xsd:string, sdg:bedCapacity some xsd:integer, sdg:traumaLevel some xsd:integer, sdg:location some xsd:string, sdg:hostsImagingStudy some sdg:ImagingStudy, sdg:employsRadiologist some sdg:Radiologist, sdg:providesProcedure some sdg:ThoracicProcedure
    HasKey: sdg:campusCode

Class: sdg:ThoracicProcedure
    Annotations: rdfs:label "Thoracic Procedure", iao:0000115 "A medical intervention performed on the thoracic region, such as a biopsy or chest tube insertion."
    SubClassOf: bfo:0000015, sdg:procedureCode some xsd:string, sdg:procedureName some xsd:string, sdg:procedureDate some xsd:dateTime, sdg:invasivenessLevel some xsd:string, sdg:status some sdg:StatusKind, sdg:performedBy exactly 1 sdg:Radiologist, sdg:conductedAt exactly 1 sdg:HospitalCampus, sdg:relatedToStudy max 1 sdg:ImagingStudy

Class: sdg:PostProcessingSoftware
    Annotations: rdfs:label "Post-Processing Software", iao:0000115 "Specialized software tools used for analyzing and processing medical imaging data."
    SubClassOf: sdg:SecuritySystemComponent, sdg:softwareName some xsd:string, sdg:version some xsd:string, sdg:vendor some xsd:string, sdg:licenseStatus some sdg:LicenseStatusKind, sdg:dataProcessingDomain some xsd:string, sdg:usedForStudy some sdg:ImagingStudy

Class: sdg:Role
    Annotations: rdfs:label "Role", iao:0000115 "A realizable entity that inheres in an entity in virtue of the ability to change the disposition of, or produce a change in, other entities."
    SubClassOf: bfo:0000023, sdg:roleName some xsd:string, sdg:startDate some xsd:dateTime, sdg:endDate some xsd:dateTime, sdg:status some sdg:StatusKind, sdg:heldBy exactly 1 sdg:Person, sdg:inOrganization exactly 1 sdg:Organization

Class: sdg:StrategicObjective
    Annotations: rdfs:label "Strategic Objective", iao:0000115 "A real material entity that represents a goal or target for an organization."
    SubClassOf: bfo:0000040, sdg:objectiveId some xsd:string, sdg:objectiveName some xsd:string, sdg:startDate some xsd:dateTime, sdg:endDate some xsd:dateTime, sdg:status some sdg:StatusKind, sdg:pursuedBy exactly 1 sdg:Organization, sdg:supportedBy some sdg:Project
    HasKey: sdg:objectiveId

Class: sdg:OwnerOperator
    Annotations: rdfs:label "Owner or Operator", iao:0000115 "A natural person or legal entity (corporation, LLC, LLP) that owns or controls the management of a livestock facility."
    SubClassOf: cco:ont00000995, sdg:legalName some xsd:string, sdg:contactPerson some xsd:string, sdg:streetAddress some xsd:string, sdg:city some xsd:string, sdg:state some xsd:string, sdg:zipCode some xsd:string, sdg:phone some xsd:string, sdg:emailAddress some xsd:string, sdg:entityType some sdg:EntityTypeKind, sdg:certifies min 1 sdg:PermitApplication, sdg:ownsOrOperates min 1 sdg:Facility

Class: sdg:Watershed
    Annotations: rdfs:label "Watershed of Record", iao:0000115 "A hydrological drainage area identified by the EPA Watershed Information Network that contains the facility."
    SubClassOf: bfo:0000040, sdg:watershedName some xsd:string, sdg:epaAddressCode some xsd:string, sdg:contains min 1 sdg:Facility

Class: sdg:AnimalConfinementBuilding
    Annotations: rdfs:label "Animal Confinement Building", iao:0000115 "A structure or lot where animals are or will be housed or confined as part of the facility."
    SubClassOf: bfo:0000040, sdg:buildingIdentifier some xsd:string, sdg:buildingType some xsd:string, sdg:constructionStatus some sdg:ConstructionStatusKind, sdg:partOf__escalated exactly 1 sdg:Facility, sdg:hasAnimalCapacity min 1 sdg:AnimalCapacity

Class: sdg:AnimalCapacity
    Annotations: rdfs:label "Animal Capacity", iao:0000115 "The design capacity or actual number of animals housed in a confinement building or facility, defining its regulatory classification."
    SubClassOf: bfo:0000023, sdg:animalType some xsd:string, sdg:capacityCount some xsd:integer, sdg:facilityClassification some sdg:FacilityClassificationKind, sdg:appliesTo exactly 1 sdg:AnimalConfinementBuilding, sdg:defines exactly 1 sdg:Facility

Class: sdg:PermitApplication
    Annotations: rdfs:label "Permit Application", iao:0000115 "A formal submission to the regulatory authority requesting a Permit to Install, Permit to Operate, or NPDES authorization."
    SubClassOf: sdg:Document, sdg:applicationId some xsd:string, sdg:applicationDate some xsd:dateTime, sdg:permitType some xsd:string, sdg:reasonCode some xsd:string, sdg:feeAmount some xsd:decimal, sdg:preparedByDetail some xsd:string, sdg:preparedByCompany some xsd:string, sdg:preparedByPhone some xsd:string, sdg:preparedByEmail some xsd:string, sdg:submittedBy min 1 sdg:OwnerOperator, sdg:forFacility exactly 1 sdg:Facility, sdg:preparedByProfessionalEngineer max 1 sdg:OwnerOperator, sdg:requires max 1 sdg:OtherPermit
    HasKey: sdg:applicationId

Class: sdg:OtherPermit
    Annotations: rdfs:label "Other Permit or License", iao:0000115 "A separate regulatory authorization, license, or certification required for the facility or application."
    SubClassOf: cco:ont00000995, sdg:permitName some xsd:string, sdg:issuingAuthorityDetail some xsd:string, sdg:permitNumber some xsd:string, sdg:status some sdg:StatusKind, sdg:linkedTo exactly 1 sdg:PermitApplication

Class: sdg:GanglionCyst
    Annotations: rdfs:label "Ganglion Cyst", iao:0000115 "A benign, thin-walled, pseudocyst containing clear gelatinous fluid, typically originating from connective tissue such as joint capsules or tendon sheaths in the foot and ankle."
    SubClassOf: cco:ont00000995, sdg:cystId some xsd:string, sdg:diameterCm some xsd:decimal, sdg:isMultilocular some xsd:boolean, sdg:cystLocation some xsd:string, sdg:cystType some sdg:CystTypeKind, sdg:containsMucinousFluid some xsd:boolean, sdg:hasSynovialLining some xsd:boolean, sdg:locatedIn exactly 1 sdg:AnatomicalRegion, sdg:originatesFrom max 1 sdg:ConnectiveTissue, sdg:causesCompressionOf some sdg:NerveFascicle, sdg:diagnosedBy some sdg:ImagingStudy
    HasKey: sdg:cystId

Class: sdg:AnatomicalRegion
    Annotations: rdfs:label "Anatomical Region", iao:0000115 "A specific anatomical location within the foot and ankle where ganglion cysts are found, such as the dorsum of the foot, ankle, or tarsal sinus."
    SubClassOf: bfo:0000015, sdg:regionId some xsd:string, sdg:regionName some xsd:string, sdg:isSubchondral some xsd:boolean, sdg:isNearJoint some xsd:boolean, sdg:isNearTendonSheath some xsd:boolean, sdg:contains some sdg:GanglionCyst, sdg:contains some sdg:NerveFascicle
    HasKey: sdg:regionId

Class: sdg:ConnectiveTissue
    Annotations: rdfs:label "Connective Tissue", iao:0000115 "The structural tissue from which ganglion cysts originate, including joint capsules, tendon sheaths, and periosteum."
    SubClassOf: cco:ont00000995, sdg:tissueId some xsd:string, sdg:tissueType some sdg:TissueTypeKind, sdg:isDegenerated some xsd:boolean, sdg:hasCollagenSheets some xsd:boolean, sdg:originates some sdg:GanglionCyst

Class: sdg:NerveFascicle
    Annotations: rdfs:label "Nerve Fascicle", iao:0000115 "A bundle of nerve fibers that can be compressed by ganglion cysts, leading to symptoms such as pain, paresthesias, weakness, and muscle atrophy."
    SubClassOf: bfo:0000015, sdg:nerveId some xsd:string, sdg:nerveName some xsd:string, sdg:isCompressed some xsd:boolean, sdg:hasParesthesia some xsd:boolean, sdg:hasWeakness some xsd:boolean, sdg:hasAtrophy some xsd:boolean, sdg:compressedBy some sdg:GanglionCyst

Class: sdg:PathologicalSpecimen
    Annotations: rdfs:label "Pathological Specimen", iao:0000115 "A tissue sample from a ganglion cyst examined macroscopically and microscopically to confirm diagnosis and characterize its structure."
    SubClassOf: cco:ont00000995, sdg:specimenId some xsd:string, sdg:collectionDate some xsd:dateTime, sdg:isMultilobulated some xsd:boolean, sdg:hasMucinousFluid some xsd:boolean, sdg:hasSynovialEpithelium some xsd:boolean, sdg:hasFibroConnectiveTissue some xsd:boolean, sdg:derivedFrom exactly 1 sdg:GanglionCyst, sdg:examinedBy exactly 1 sdg:PathologicalAnalysis

Class: sdg:PathologicalAnalysis
    Annotations: rdfs:label "Pathological Analysis", iao:0000115 "The microscopic and macroscopic examination of a pathological specimen to identify the presence of proteinaceous material, dense fibro-connective tissue, and the absence of synovial epithelium."
    SubClassOf: bfo:0000015, sdg:analysisId some xsd:string, sdg:analysisDate some xsd:dateTime, sdg:stainingMethod some xsd:string, sdg:hasCollagenSheets some xsd:boolean, sdg:hasFibroblasts some xsd:boolean, sdg:hasMesenchymalCells some xsd:boolean, sdg:hasNecrosis some xsd:boolean, sdg:hasInflammatoryChanges some xsd:boolean, sdg:analyzes exactly 1 sdg:PathologicalSpecimen
    HasKey: sdg:analysisId

Class: sdg:FinancialAccount
    Annotations: rdfs:label "Financial Account", iao:0000115 "A formal record of a monetary relationship between the credit union and a client, encompassing deposits, loans, or investment holdings."
    SubClassOf: bfo:0000040, sdg:accountNumber some xsd:string, sdg:accountType some sdg:AccountTypeKind, sdg:openDate some xsd:date, sdg:currentBalance some xsd:decimal, sdg:currencyCode some xsd:string, sdg:accountStatus some sdg:AccountStatusKind, sdg:lastStatementDate some xsd:date, sdg:belongsToOneClient exactly 1 sdg:Client, sdg:holdsAsset some sdg:FinancialAsset, sdg:isManagedBy max 1 sdg:FinancialPlanner

Class: sdg:InvestmentPortfolio
    Annotations: rdfs:label "Investment Portfolio", iao:0000115 "A collection of financial assets held by a client for the purpose of wealth management and financial planning."
    SubClassOf: bfo:0000040, sdg:portfolioId some xsd:string, sdg:riskProfile some xsd:string, sdg:totalValue some xsd:decimal, sdg:currencyCode some xsd:string, sdg:lastRebalanceDate some xsd:date, sdg:portfolioStatus some sdg:PortfolioStatusKind, sdg:ownedByClient exactly 1 sdg:Client, sdg:containsAsset some sdg:FinancialAsset, sdg:plannedBy exactly 1 sdg:FinancialPlanner

Class: sdg:FinancialAsset
    Annotations: rdfs:label "Financial Asset", iao:0000115 "A tangible or intangible item of economic value owned by the credit union or its clients, such as stocks, bonds, or mutual funds."
    SubClassOf: sdg:FinancialEntity, sdg:assetId some xsd:string, sdg:tickerSymbol some xsd:string, sdg:assetType some sdg:AssetTypeKind, sdg:currentMarketValue some xsd:decimal, sdg:purchaseDate some xsd:date, sdg:purchasePrice some xsd:decimal, sdg:quantity some xsd:integer, sdg:assetStatus some xsd:string, sdg:heldInPortfolio exactly 1 sdg:InvestmentPortfolio, sdg:tradedInTransaction some sdg:TradeTransaction

Class: sdg:FinancialPlanningAssistant
    Annotations: rdfs:label "Financial Planning Assistant", iao:0000115 "A staff member responsible for supporting financial planners, managing client inquiries, processing transactions, and maintaining compliance records."
    SubClassOf: sdg:FinancialEntity, sdg:employeeId some xsd:string, sdg:fullName some xsd:string, sdg:licenseStatus some sdg:LicenseStatusKind, sdg:licenseExpiryDate some xsd:date, sdg:officeLocation some xsd:string, sdg:employmentStatus some sdg:EmploymentStatusKind, sdg:yearsExperience some xsd:integer, sdg:supportsPlanner some sdg:FinancialPlanner, sdg:processesTransaction some sdg:TradeTransaction, sdg:servesClient some sdg:Client, sdg:filesComplianceRecord some sdg:ComplianceRecord
    HasKey: sdg:employeeId

Class: sdg:FinancialPlanner
    Annotations: rdfs:label "Financial Planner", iao:0000115 "A licensed professional who provides strategic financial advice, develops investment strategies, and manages complex client relationships."
    SubClassOf: bfo:0000002, sdg:plannerId some xsd:string, sdg:fullName some xsd:string, sdg:licenseNumber some xsd:string, sdg:specialization some sdg:SpecializationKind, sdg:yearsExperience some xsd:integer, sdg:employmentStatus some sdg:EmploymentStatusKind, sdg:managesPortfolio some sdg:InvestmentPortfolio, sdg:advisesClient some sdg:Client, sdg:supervisedByAssistant some sdg:FinancialPlanningAssistant, sdg:filesComplianceRecord some sdg:ComplianceRecord

Class: sdg:ComplianceRecord
    Annotations: rdfs:label "Compliance Record", iao:0000115 "A documented artifact required by regulatory authorities to verify adherence to financial industry standards, training, and licensing."
    SubClassOf: sdg:Record, sdg:recordId some xsd:string, sdg:recordType some xsd:string, sdg:issueDate some xsd:date, sdg:expiryDate some xsd:date, sdg:issuingAuthorityDetail some xsd:string, sdg:verificationStatus some sdg:VerificationStatusKind, sdg:documentUrl some xsd:string, sdg:belongsToOnePlanner exactly 1 sdg:FinancialPlanner, sdg:belongsToOneAssistant exactly 1 sdg:FinancialPlanningAssistant, sdg:relatedToTransaction some sdg:TradeTransaction

Class: sdg:IndoorAirQualityMeasurement
    Annotations: rdfs:label "Indoor Air Quality Measurement", iao:0000115 "A measurement event recording the concentration of specific pollutants within an indoor environment at a specific time and location."
    SubClassOf: bfo:0000015, sdg:measurementId some xsd:string, sdg:timestamp some xsd:dateTime, sdg:pollutantConcentration some xsd:decimal, sdg:unitOfMeasure some sdg:UnitOfMeasureKind, sdg:measurementMethod some xsd:string, sdg:sensorCalibrationDate some xsd:date, sdg:measuredAt exactly 1 sdg:IndoorEnvironment, sdg:recordsPollutant exactly 1 sdg:IndoorPollutant
    HasKey: sdg:measurementId

Class: sdg:IndoorEnvironment
    Annotations: rdfs:label "Indoor Environment", iao:0000115 "A bounded physical space where human activities occur, such as a home, school, or healthcare facility, characterized by its structural and environmental properties."
    SubClassOf: bfo:0000040, sdg:environmentId some xsd:string, sdg:environmentType some xsd:string, sdg:buildingAge some xsd:integer, sdg:ventilationRate some xsd:decimal, sdg:occupancyLevel some xsd:integer, sdg:lastInspectionDate some xsd:date, sdg:locatedIn exactly 1 sdg:LocalAuthority, sdg:contains some sdg:IndoorPollutant
    HasKey: sdg:environmentId

Class: sdg:IndoorPollutant
    Annotations: rdfs:label "Indoor Pollutant", iao:0000115 "A substance or agent present in an indoor environment that poses a risk to human health, such as carbon monoxide, formaldehyde, or particulate matter."
    SubClassOf: bfo:0000040, sdg:pollutantId some xsd:string, sdg:pollutantName some xsd:string, sdg:sourceType some sdg:SourceTypeKind, sdg:toxicityLevel some sdg:ToxicityLevelKind, sdg:regulatoryLimit some xsd:decimal, sdg:healthImpactCategory some xsd:string, sdg:originatesFrom some sdg:PollutantSource, sdg:affects some sdg:VulnerablePopulation

Class: sdg:PollutantSource
    Annotations: rdfs:label "Pollutant Source", iao:0000115 "A specific object, activity, or material within an indoor environment that emits or generates indoor air pollutants."
    SubClassOf: sdg:Resource, sdg:sourceId some xsd:string, sdg:sourceName some xsd:string, sdg:sourceCategory some xsd:string, sdg:emissionRate some xsd:decimal, sdg:installationDate some xsd:date, sdg:maintenanceStatus some sdg:MaintenanceStatusKind, sdg:emissionContext some xsd:string, sdg:locatedIn exactly 1 sdg:IndoorEnvironment, sdg:emits some sdg:IndoorPollutant

Class: sdg:VulnerablePopulation
    Annotations: rdfs:label "Vulnerable Population", iao:0000115 "A demographic group that is disproportionately affected by indoor air pollution due to factors such as age, health status, or socioeconomic conditions."
    SubClassOf: bfo:0000002, sdg:populationGroupId some xsd:string, sdg:groupType some sdg:GroupTypeKind, sdg:prevalenceRate some xsd:decimal, sdg:riskFactor some xsd:string, sdg:healthOutcome some xsd:string, sdg:exposedTo some sdg:IndoorPollutant, sdg:residesIn some sdg:IndoorEnvironment

Class: sdg:NationalDiabetesPlan
    Annotations: rdfs:label "National Diabetes Plan", iao:0000115 "A formal government policy document outlining strategies for diabetes prevention, management, and care within a specific jurisdiction."
    SubClassOf: cco:ont00000958, sdg:planIdentifier some xsd:string, sdg:jurisdictionName some xsd:string, sdg:implementationStatus some sdg:ImplementationStatusKind, sdg:adoptionDate some xsd:dateTime, sdg:policyScope some xsd:string, sdg:responsibleAgency some xsd:string, sdg:coversJurisdiction exactly 1 sdg:Jurisdiction

Class: sdg:HealthcareExpenditure
    Annotations: rdfs:label "Healthcare Expenditure", iao:0000115 "A financial record quantifying the monetary investment allocated for diabetes-related health services and prevention within a defined period."
    SubClassOf: cco:ont00000995, sdg:expenditureId some xsd:string, sdg:currencyCode some xsd:string, sdg:amountPerPerson some xsd:decimal, sdg:totalAmount some xsd:decimal, sdg:fiscalYear some xsd:integer, sdg:coveragePercentage some xsd:decimal, sdg:allocationRegion some xsd:string, sdg:fundsJurisdiction exactly 1 sdg:Jurisdiction

Class: sdg:SurveillanceMetric
    Annotations: rdfs:label "Surveillance Metric", iao:0000115 "A recorded quantitative measure tracking the incidence, prevalence, or risk factors of diabetes and related conditions within a population."
    SubClassOf: cco:ont00000995, sdg:metricId some xsd:string, sdg:metricType some sdg:MetricTypeKind, sdg:value some xsd:decimal, sdg:unit some sdg:UnitKind, sdg:measurementDate some xsd:dateTime, sdg:populationAgeRange some xsd:string, sdg:dataSource some xsd:string, sdg:measuresPopulation exactly 1 sdg:PopulationSegment, sdg:trackedByFramework some sdg:SurveillanceFramework

Class: sdg:PreventivePolicy
    Annotations: rdfs:label "Preventive Policy", iao:0000115 "A regulatory or voluntary government action designed to reduce diabetes risk factors, such as advertising bans or industry agreements."
    SubClassOf: sdg:GovernmentPolicy, sdg:policyId some xsd:string, sdg:policyName some xsd:string, sdg:policyType some sdg:PolicyTypeKind, sdg:implementationStatus some sdg:ImplementationStatusKind, sdg:targetDemographic some xsd:string, sdg:effectiveDate some xsd:date, sdg:enforcingBody some xsd:string, sdg:appliesToJurisdiction exactly 1 sdg:Jurisdiction
    HasKey: sdg:policyId

Class: sdg:HealthService
    Annotations: rdfs:label "Health Service", iao:0000115 "A specific medical or educational intervention provided to patients, such as self-management education or specialized care for specific groups."
    SubClassOf: sdg:HealthcareEntity, sdg:serviceId some xsd:string, sdg:serviceName some xsd:string, sdg:serviceCategory some sdg:ServiceCategoryKind, sdg:availabilityStatus some xsd:string, sdg:targetGroup some xsd:string, sdg:geographicCoverage some xsd:string, sdg:costCoveragePercent some xsd:decimal, sdg:providedInJurisdiction exactly 1 sdg:Jurisdiction, sdg:servesPopulation some sdg:PopulationSegment

Class: sdg:PopulationSegment
    Annotations: rdfs:label "Population Segment", iao:0000115 "A defined group of individuals within a jurisdiction characterized by specific demographic or clinical criteria, such as age range or diagnosis status."
    SubClassOf: bfo:0000002, sdg:segmentId some xsd:string, sdg:segmentName some xsd:string, sdg:ageMin some xsd:integer, sdg:ageMax some xsd:integer, sdg:totalCount some xsd:integer, sdg:diagnosedCount some xsd:integer, sdg:undiagnosedCount some xsd:integer, sdg:prevalenceRate some xsd:decimal, sdg:residesInJurisdiction exactly 1 sdg:Jurisdiction, sdg:isMeasuredBy some sdg:SurveillanceMetric
    HasKey: sdg:segmentId

Class: sdg:SurveillanceFramework
    Annotations: rdfs:label "Surveillance Framework", iao:0000115 "A systematic process or protocol for routinely collecting, analyzing, and interpreting health data to monitor disease trends and policy effectiveness."
    SubClassOf: bfo:0000015, sdg:frameworkId some xsd:string, sdg:frameworkName some xsd:string, sdg:adoptionStatus some sdg:AdoptionStatusKind, sdg:frequency some sdg:FrequencyKind, sdg:scope some sdg:ScopeKind, sdg:lastReviewDate some xsd:date, sdg:tracksMetric some sdg:SurveillanceMetric, sdg:operatesInJurisdiction exactly 1 sdg:Jurisdiction

Class: sdg:DirectoryEntry
    Annotations: rdfs:label "Directory Entry", iao:0000115 "A record representing an individual or organization registered in the NIC WHOIS database, containing contact and network information."
    SubClassOf: cco:ont00000995, sdg:handle some xsd:string, sdg:fullName some xsd:string, sdg:middleInitial some xsd:string, sdg:mailingAddress some xsd:string, sdg:zipCode some xsd:string, sdg:telephone some xsd:string, sdg:autovonNumber some xsd:string, sdg:ftsNumber some xsd:string, sdg:networkMailbox some xsd:string, sdg:registrationDate some xsd:dateTime, sdg:registeredWith exactly 1 sdg:NetworkInformationCenter, sdg:associatedWith some sdg:NetworkHost, sdg:uses some sdg:NetworkMailbox

Class: sdg:NetworkInformationCenter
    Annotations: rdfs:label "Network Information Center", iao:0000115 "The administrative service and database maintained by SRI International on behalf of the Defense Communications Agency that stores and serves directory information."
    SubClassOf: sdg:NetworkEntity, sdg:centerName some xsd:string, sdg:operatingInstitution some xsd:string, sdg:sponsoringAgency some xsd:string, sdg:servicePort some xsd:integer, sdg:serviceProtocol some xsd:string, sdg:serviceHost some xsd:string, sdg:serviceStatus some sdg:ServiceStatusKind, sdg:maintains min 2 sdg:DirectoryEntry, sdg:operates exactly 1 sdg:DirectoryService, sdg:maintainingOrganization some sdg:SRI

Class: sdg:DirectoryService
    Annotations: rdfs:label "Directory Service", iao:0000115 "The TCP-based query/response server process that delivers directory information to users across the network."
    SubClassOf: sdg:NetworkEntity, sdg:serviceName some xsd:string, sdg:protocol some xsd:string, sdg:portNumber some xsd:integer, sdg:hostAddress some xsd:string, sdg:responseFormat some xsd:string, sdg:connectionBehavior some sdg:ConnectionBehaviorKind, sdg:serves some sdg:DirectoryEntry, sdg:runsOn exactly 1 sdg:NetworkHost

Class: sdg:NetworkHost
    Annotations: rdfs:label "Network Host", iao:0000115 "A computer system connected to the ARPANET, MILNET, or DDN Internet that hosts users and services."
    SubClassOf: bfo:0000015, sdg:hostName some xsd:string, sdg:ipAddress some xsd:string, sdg:networkType some sdg:NetworkTypeKind, sdg:operatingSystem some xsd:string, sdg:hostStatus some sdg:HostStatusKind, sdg:hosts some sdg:DirectoryEntry, sdg:runs some sdg:DirectoryService

Class: sdg:NetworkMailbox
    Annotations: rdfs:label "Network Mailbox", iao:0000115 "An electronic mail address associated with a registered user or organization in the directory."
    SubClassOf: cco:ont00000995, sdg:mailboxAddress some xsd:string, sdg:mailboxType some sdg:MailboxTypeKind, sdg:mailboxStatus some xsd:string, sdg:belongsToMany min 2 sdg:DirectoryEntry

Class: sdg:Sauce
    Annotations: rdfs:label "Sauce", iao:0000115 "A liquid or semi-liquid condiment or accompaniment served with food items, often with a specific price and description."
    SubClassOf: cco:ont00000995, sdg:sauceId some xsd:string, sdg:name some sdg:NameKind, sdg:price some xsd:decimal, sdg:description some xsd:string, sdg:isHomemade some xsd:boolean, sdg:spiceLevel some sdg:SpiceLevelKind, sdg:baseIngredient some xsd:string, sdg:isSpicy some xsd:boolean, sdg:accompaniesMenuItem some sdg:MenuItem, sdg:servedWith min 2 sdg:MenuFoodItem, sdg:servedWith some sdg:MenuItem, sdg:containsIngredient min 2 sdg:Ingredient

Class: sdg:FinancialAidApplication
    Annotations: rdfs:label "Financial Aid Application", iao:0000115 "A formal record submitted by a graduate student to request federal financial aid eligibility and determine the Cost of Attendance for an academic year."
    SubClassOf: cco:ont00000995, sdg:applicationId some xsd:string, sdg:submissionDate some xsd:dateTime, sdg:academicYear some xsd:string, sdg:isElectronicSignatureAccepted some xsd:boolean, sdg:hasPriorFederalAid some xsd:boolean, sdg:status some sdg:StatusKind, sdg:submittedBy exactly 1 sdg:Student, sdg:coversTerm min 2 sdg:AcademicTerm, sdg:determinesAward some sdg:FinancialAward

Class: sdg:EnrollmentPlan
    Annotations: rdfs:label "Enrollment Plan", iao:0000115 "A record of the exact number of credits a student plans to take in a specific term, used to determine federal loan eligibility."
    SubClassOf: cco:ont00000995, sdg:plannedCredits some xsd:integer, sdg:isHalfTimeMinimum some xsd:boolean, sdg:isWithdrawing some xsd:boolean, sdg:doesNotNeedAid some xsd:boolean, sdg:appliesToTerm exactly 1 sdg:AcademicTerm, sdg:belongsToFiledBy exactly 1 sdg:FinancialAidApplication

Class: sdg:FinancialAward
    Annotations: rdfs:label "Financial Award", iao:0000115 "A specific grant or loan allocation determined by the Cost of Attendance and federal loan limits, subject to adjustment based on actual enrollment."
    SubClassOf: sdg:FinancialEntity, sdg:awardId some xsd:string, sdg:awardType some sdg:AwardTypeKind, sdg:estimatedAmount some xsd:decimal, sdg:isWithinAnnualLimit some xsd:boolean, sdg:isWithinAggregateLimit some xsd:boolean, sdg:disbursementStatus some sdg:DisbursementStatusKind, sdg:awardedTo exactly 1 sdg:Student, sdg:derivedFromApplication exactly 1 sdg:FinancialAidApplication, sdg:offsetByOtherResource some sdg:OtherFinancialResource
    HasKey: sdg:awardId

Class: sdg:SatisfactoryAcademicProgress
    Annotations: rdfs:label "Satisfactory Academic Progress", iao:0000115 "A continuous process of monitoring a student's completion rate, GPA, and degree timeframe to maintain federal aid eligibility."
    SubClassOf: bfo:0000015, sdg:completionRatePercent some xsd:decimal, sdg:cumulativeGPA some xsd:decimal, sdg:maxTimeframePercent some xsd:decimal, sdg:isEligible some xsd:boolean, sdg:monitorsStudent exactly 1 sdg:Student

Class: sdg:OtherFinancialResource
    Annotations: rdfs:label "Other Financial Resource", iao:0000115 "External funding sources such as scholarships, employer benefits, or veteran's assistance that must be reported and may adjust federal aid awards."
    SubClassOf: cco:ont00000995, sdg:resourceId some xsd:string, sdg:sourceType some sdg:SourceTypeKind, sdg:amount some xsd:decimal, sdg:isVerified some xsd:boolean, sdg:receivedBy exactly 1 sdg:Student, sdg:reducesAward some sdg:FinancialAward
    HasKey: sdg:resourceId

Class: sdg:Publication
    Annotations: rdfs:label "A periodical or newspaper issued to the public", iao:0000115 "A periodical or newspaper issued to the public, including print and online editions."
    SubClassOf: sdg:Book, sdg:publicationId some xsd:string, sdg:title some xsd:string, sdg:language some sdg:LanguageKind, sdg:frequency some sdg:FrequencyKind, sdg:status some sdg:StatusKind, sdg:circulationCount some xsd:integer, sdg:onlinePageViews some xsd:decimal, sdg:uniqueVisitors some xsd:integer, sdg:contentGenre some xsd:string, sdg:pubIdentifier some xsd:string, sdg:publicationDate some xsd:date, sdg:publisher some xsd:string, sdg:subjectMatter some sdg:SubjectMatterKind, sdg:isCriticalOfMovement some xsd:boolean, sdg:journalName some xsd:string, sdg:isInternational some xsd:boolean, sdg:citationCount some xsd:integer, sdg:publicationIdentifier some xsd:string, sdg:publicationType some sdg:PublicationTypeKind, sdg:peerReviewed some xsd:boolean, sdg:publishedBy exactly 1 sdg:MediaGroup, sdg:deliveredVia some sdg:DeliveryPlatform, sdg:authoredBy exactly 1 sdg:Individual, sdg:discussesMovement some sdg:IdeologicalMovement, sdg:authoredBy some sdg:FacultyResearcher, sdg:publishedIn some sdg:Journal, sdg:authoredBy min 2 sdg:Researcher, sdg:partOfProject some sdg:ResearchProject

Class: sdg:MediaGroup
    Annotations: rdfs:label "A corporate entity that publishes media content", iao:0000115 "A corporate entity that publishes media content and operates various media platforms."
    SubClassOf: cco:ont00000995, sdg:groupId some xsd:string, sdg:groupName some xsd:string, sdg:headquartersLocation some xsd:string, sdg:foundingYear some xsd:integer, sdg:marketShare some xsd:decimal, sdg:totalAudience some xsd:integer, sdg:totalPageViews some xsd:decimal, sdg:totalUniqueVisitors some xsd:integer, sdg:publishes min 2 sdg:Publication, sdg:owns some sdg:Subsidiary, sdg:operates some sdg:DeliveryPlatform

Class: sdg:DeliveryPlatform
    Annotations: rdfs:label "A channel or medium through which media content is distributed", iao:0000115 "A channel or medium through which media content is distributed, including print, online, and mobile platforms."
    SubClassOf: cco:ont00000995, sdg:platformId some xsd:string, sdg:platformName some xsd:string, sdg:platformType some sdg:PlatformTypeKind, sdg:accessMethod some xsd:string, sdg:activeStatus some xsd:boolean, sdg:monthlyVisitors some xsd:integer, sdg:monthlyPageViews some xsd:decimal, sdg:delivers some sdg:Publication, sdg:operatedBy exactly 1 sdg:MediaGroup

Class: sdg:Subsidiary
    Annotations: rdfs:label "A company controlled by a parent media group", iao:0000115 "A company controlled by a parent media group, often operating in a specific media or advertising niche."
    SubClassOf: cco:ont00000995, sdg:subsidiaryId some xsd:string, sdg:subsidiaryName some xsd:string, sdg:ownershipPercentage some xsd:decimal, sdg:businessType some xsd:string, sdg:operationalStatus some sdg:OperationalStatusKind, sdg:location some xsd:string, sdg:ownedBy exactly 1 sdg:MediaGroup, sdg:operates some sdg:DeliveryPlatform

Class: sdg:AdvertisingNetwork
    Annotations: rdfs:label "A network for distributing outdoor or digital advertising", iao:0000115 "A network for distributing outdoor or digital advertising, often managed by a subsidiary."
    SubClassOf: cco:ont00000995, sdg:networkId some xsd:string, sdg:networkName some xsd:string, sdg:networkType some sdg:NetworkTypeKind, sdg:coverageArea some xsd:string, sdg:activeStatus some xsd:boolean, sdg:monthlyImpressions some xsd:integer, sdg:managedBy exactly 1 sdg:Subsidiary, sdg:delivers some sdg:Publication

Class: sdg:RadioChannel
    Annotations: rdfs:label "A broadcast channel for audio content", iao:0000115 "A broadcast channel for audio content, often part of a joint venture or subsidiary."
    SubClassOf: cco:ont00000995, sdg:channelId some xsd:string, sdg:channelName some xsd:string, sdg:frequency some sdg:FrequencyKind, sdg:language some sdg:LanguageKind, sdg:operationalStatus some sdg:OperationalStatusKind, sdg:audienceSize some xsd:integer, sdg:operatedBy exactly 1 sdg:JointVenture, sdg:leverages some sdg:Publication

Class: sdg:JointVenture
    Annotations: rdfs:label "A business entity formed by two or more parties", iao:0000115 "A business entity formed by two or more parties, often to operate specific media or advertising services."
    SubClassOf: cco:ont00000995, sdg:ventureId some xsd:string, sdg:ventureName some xsd:string, sdg:ownershipStructure some xsd:string, sdg:businessType some xsd:string, sdg:operationalStatus some sdg:OperationalStatusKind, sdg:location some xsd:string, sdg:operates min 2 sdg:RadioChannel, sdg:ownedBy exactly 1 sdg:MediaGroup

Class: sdg:ResearchIdea
    Annotations: rdfs:label "Scientific Research Idea", iao:0000115 "A high-risk, interdisciplinary scientific concept or proposal generated by young researchers during brainstorming sessions, intended for future FET project proposals."
    SubClassOf: sdg:ResearchEntity, sdg:ideaId some xsd:string, sdg:ideaTitle some xsd:string, sdg:riskLevel some sdg:RiskLevelKind, sdg:isSelectedForIncubator some xsd:boolean, sdg:isSelectedForFunding some xsd:boolean, sdg:generatedByTeam exactly 1 sdg:ResearchTeam, sdg:alignsWithTheme some sdg:ResearchTheme, sdg:targetsSocietalChallenge some sdg:SocietalChallenge
    HasKey: sdg:ideaId

Class: sdg:ResearchTeam
    Annotations: rdfs:label "Collaborative Research Team", iao:0000115 "A group of young researchers collaborating on a specific high-risk scientific idea, formed through networking and brainstorming events."
    SubClassOf: sdg:teamId some xsd:string, sdg:teamName some xsd:string, sdg:formationRegion some xsd:string, sdg:isFormedForIncubator some xsd:boolean, sdg:consistsOfMembers min 2 sdg:Researcher, sdg:developsIdea exactly 1 sdg:ResearchIdea, sdg:attendsEvent some sdg:Event

Class: sdg:ResearchTheme
    Annotations: rdfs:label "FET Research Theme", iao:0000115 "A broad multidisciplinary research area or convergence topic that provides the thematic framework for EYE activities and FET-quality research."
    SubClassOf: sdg:themeId some xsd:string, sdg:themeName some xsd:string, sdg:isDisruptive some xsd:boolean, sdg:isInterdisciplinary some xsd:boolean, sdg:informsEvent some sdg:Event, sdg:guidesIdea some sdg:ResearchIdea

Class: sdg:Country
    Annotations: rdfs:label "European Country", iao:0000115 "A sovereign state in Europe where EYE partners are located or where local collaborator networks are established."
    SubClassOf: bfo:0000040, sdg:countryCode some sdg:CountryCodeKind, sdg:countryName some xsd:string, sdg:hasPartner some xsd:boolean, sdg:hasLocalNetwork some xsd:boolean, sdg:region some sdg:RegionKind, sdg:name some sdg:NameKind, sdg:gdpPerCapita some xsd:decimal, sdg:internetPenetration some xsd:decimal, sdg:schoolConnectivityRate some xsd:decimal, sdg:totalPopulation some xsd:integer, sdg:totalSocialEnterprises some xsd:integer, sdg:hostsPartner some sdg:PartnerOrganization, sdg:hasLocalNetworkEstablishedBy some sdg:PartnerOrganization, sdg:contains some sdg:ForestPlantation, sdg:contains some sdg:IndustrialFacility, sdg:contains some sdg:School, sdg:hasProvider some sdg:ConnectivityProvider, sdg:containsGeographicRegions some sdg:GeographicRegion

Class: sdg:PastoralCommunity
    Annotations: rdfs:label "Pastoral Community", iao:0000115 "A human social group whose livelihood is primarily based on pastoralism, such as the Gabra, Rendille, or Dasanech peoples in Northern Kenya."
    SubClassOf: sdg:CommunityEntity, sdg:communityName some xsd:string, sdg:territoryName some xsd:string, sdg:primaryLivelihood some sdg:PrimaryLivelihoodKind, sdg:historicalPresence some xsd:integer, sdg:communityIdentifier some xsd:string, sdg:populationSize some xsd:integer, sdg:herdSize some xsd:integer, sdg:decimationEvent some xsd:string, sdg:adaptationStrategy some xsd:string, sdg:inhabits some sdg:Territory, sdg:practices some sdg:WaterManagementPractice, sdg:shiftsTo some sdg:AlternativeLivelihood, sdg:inhabits min 2 sdg:PastoralTerritory, sdg:uses min 2 sdg:WaterSource, sdg:locatedIn exactly 1 sdg:GeographicRegion

Class: sdg:Territory
    Annotations: rdfs:label "Territory", iao:0000115 "A defined geographical area, such as the Chalbi desert or Marsabit County, shaped by water resources and used by pastoral communities."
    SubClassOf: sdg:GeographicEntity, sdg:territoryName some xsd:string, sdg:location some xsd:string, sdg:areaSize some xsd:decimal, sdg:dominantEcosystem some xsd:string, sdg:legalStatus some sdg:LegalStatusKind, sdg:territoryId some xsd:string, sdg:coordinatesDetail some xsd:string, sdg:recognizedByUN some xsd:boolean, sdg:contains some sdg:WellWateredPlace, sdg:borders some sdg:Territory, sdg:usedBy some sdg:PastoralCommunity, sdg:contains some sdg:SettlementProject, sdg:subjectTo some sdg:HumanRightsViolation
    HasKey: sdg:territoryId

Class: sdg:WellWateredPlace
    Annotations: rdfs:label "Well-Watered Place", iao:0000115 "A specific location within arid lands that has reliable access to water, serving as a nexus for socio-ecological adaptation and territorial delimitation."
    SubClassOf: bfo:0000004, sdg:placeName some xsd:string, sdg:waterSource some xsd:string, sdg:reliability some xsd:string, sdg:socioEcologicalNiche some xsd:boolean, sdg:locatedIn exactly 1 sdg:Territory, sdg:supports some sdg:PastoralCommunity, sdg:influences some sdg:WaterManagementPractice

Class: sdg:WaterManagementPractice
    Annotations: rdfs:label "Water Management Practice", iao:0000115 "Traditional or modern methods used by pastoral communities to manage water resources in arid and semi-arid lands."
    SubClassOf: bfo:0000015, sdg:practiceName some xsd:string, sdg:conservationLevel some xsd:string, sdg:historicalPeriod some xsd:string, sdg:effectiveness some sdg:EffectivenessKind, sdg:practicedBy some sdg:PastoralCommunity, sdg:appliedIn some sdg:Territory, sdg:adaptedTo some sdg:HydrologicalStress

Class: sdg:HydrologicalStress
    Annotations: rdfs:label "Hydrological Stress", iao:0000115 "A condition of water scarcity or limited availability in arid and semi-arid lands, impacting pastoral livelihoods and water management."
    SubClassOf: bfo:0000015, sdg:stressLevel some xsd:string, sdg:duration some xsd:decimal, sdg:affectedArea some xsd:string, sdg:impactOnLivelihood some xsd:string, sdg:affects some sdg:PastoralCommunity, sdg:occursIn__escalated some sdg:Territory, sdg:influences some sdg:WaterManagementPractice

Class: sdg:AlternativeLivelihood
    Annotations: rdfs:label "Alternative Livelihood", iao:0000115 "Non-pastoral economic activities adopted by pastoral communities in response to environmental or socio-economic changes, such as agro-pastoralism or wage labor."
    SubClassOf: bfo:0000015, sdg:livelihoodType some xsd:string, sdg:adoptionRate some xsd:decimal, sdg:primaryDrivers some xsd:string, sdg:sustainability some xsd:string, sdg:adoptedBy some sdg:PastoralCommunity, sdg:supportedBy some sdg:WellWateredPlace

Class: sdg:BuildingPermit
    Annotations: rdfs:label "Building Permit", iao:0000115 "An administrative authorization record issued by the municipal Building Inspections Division permitting construction, alteration, or occupancy of a structure."
    SubClassOf: cco:ont00000995, sdg:permitId some xsd:string, sdg:issueDate some xsd:date, sdg:expiryDate some xsd:date, sdg:projectTypeCode some xsd:string, sdg:projectTypeDescription some xsd:string, sdg:ownershipType some sdg:OwnershipTypeKind, sdg:totalUnits some xsd:integer, sdg:contractedSquareFeet some xsd:decimal, sdg:status some sdg:StatusKind, sdg:covers exactly 1 sdg:PropertyParcel, sdg:issuedBy exactly 1 sdg:BuildingInspectionsDivision, sdg:includes min 2 sdg:InspectionEvent

Class: sdg:PropertyParcel
    Annotations: rdfs:label "Property Parcel", iao:0000115 "A distinct real estate parcel or lot identified by a street address and municipal jurisdiction, serving as the physical location for construction activities."
    SubClassOf: bfo:0000040, sdg:streetAddress some xsd:string, sdg:municipality some xsd:string, sdg:parcelId some xsd:string, sdg:zoningDistrict some sdg:ZoningDistrictKind, sdg:landUseCategory some xsd:string, sdg:address some xsd:string, sdg:landUse some xsd:string, sdg:area some xsd:decimal, sdg:ownerName some xsd:string, sdg:parcelIdentifier some xsd:string, sdg:landUseCode some xsd:string, sdg:assessedValue some xsd:decimal, sdg:taxYear some xsd:integer, sdg:isHomesteaded some xsd:boolean, sdg:hasPermit some sdg:BuildingPermit, sdg:hosts some sdg:InspectionEvent, sdg:hasAssessmentNotice some sdg:AssessmentNotice, sdg:hasExemption some sdg:PropertyExemption, sdg:hasAppealWaiver some sdg:AppealWaiver, sdg:hasNotice some sdg:AssessmentNotice

Class: sdg:InspectionEvent
    Annotations: rdfs:label "Inspection Event", iao:0000115 "A scheduled or ad-hoc physical examination of a construction site or structure conducted by municipal inspectors to verify code compliance."
    SubClassOf: bfo:0000015, sdg:inspectionId some xsd:string, sdg:scheduledDate some xsd:dateTime, sdg:completionDate some xsd:date, sdg:inspectionType some xsd:string, sdg:resultStatus some sdg:ResultStatusKind, sdg:completedWithin24Hours some xsd:boolean, sdg:inspectorBadgeNumber some xsd:string, sdg:inspectionDate some xsd:dateTime, sdg:inspectorRole some xsd:string, sdg:deficiencyCount some xsd:integer, sdg:punchListItems some xsd:integer, sdg:status some sdg:StatusKind, sdg:notes some xsd:string, sdg:regulatoryBasis some xsd:string, sdg:overallSafetyRating some sdg:OverallSafetyRatingKind, sdg:overallEffectivenessRating some xsd:string, sdg:overallCaringRating some xsd:string, sdg:overallResponsiveRating some xsd:string, sdg:overallWellLedRating some sdg:OverallWellLedRatingKind, sdg:startDate some xsd:dateTime, sdg:endDate some xsd:dateTime, sdg:overallEffectiveness some xsd:string, sdg:qualityOfEducation some xsd:string, sdg:behaviourAndAttitudes some xsd:string, sdg:personalDevelopment some xsd:string, sdg:leadershipAndManagement some xsd:string, sdg:welfareAndSafeguarding some xsd:string, sdg:overallRating some xsd:string, sdg:safetyRating some xsd:string, sdg:effectivenessRating some sdg:EffectivenessRatingKind, sdg:caringRating some xsd:string, sdg:responsiveRating some xsd:string, sdg:wellLedRating some xsd:string, sdg:publicationDate some xsd:date, sdg:pertainsTo exactly 1 sdg:BuildingPermit, sdg:occursAt exactly 1 sdg:PropertyParcel, sdg:verifies some sdg:ProjectSegment, sdg:performedOn exactly 1 sdg:InfrastructurePhase, sdg:identifiesDeficiency some sdg:Deficiency, sdg:verifies some sdg:TestSheet, sdg:conductedAt exactly 1 sdg:ClinicalService, sdg:conductedBy exactly 1 sdg:RegulatoryAuthority, sdg:references min 2 sdg:RegulatoryFinding, sdg:evaluates exactly 1 sdg:SchoolSite, sdg:assesses some sdg:CurriculumProgramme, sdg:assesses some sdg:StudentOutcome, sdg:evaluatedAgency exactly 1 sdg:CareAgency, sdg:generatedReport exactly 1 sdg:InspectionReport

Class: sdg:ProjectSegment
    Annotations: rdfs:label "Project Segment", iao:0000115 "A specific category of construction work or permit type (e.g., Electrical, Plumbing, Carport) with associated valuation and fee calculations."
    SubClassOf: cco:ont00000995, sdg:segmentCode some xsd:string, sdg:segmentDescription some xsd:string, sdg:valuationAmount some xsd:decimal, sdg:feeAmount some xsd:decimal, sdg:segmentCount some xsd:integer, sdg:partOf__escalated some sdg:BuildingPermit, sdg:verifiedBy some sdg:InspectionEvent

Class: sdg:CertificateOfOccupancy
    Annotations: rdfs:label "Certificate of Occupancy", iao:0000115 "A formal document issued by the municipality certifying that a building complies with applicable building codes and is suitable for occupancy."
    SubClassOf: cco:ont00000995, sdg:cOfOId some xsd:string, sdg:issueDate some xsd:date, sdg:reason some xsd:string, sdg:buildingSquareFootage some xsd:decimal, sdg:occupancyStatus some sdg:OccupancyStatusKind, sdg:covers exactly 1 sdg:PropertyParcel, sdg:subsequentTo exactly 1 sdg:BuildingPermit, sdg:issuedBy exactly 1 sdg:BuildingInspectionsDivision

Class: sdg:BuildingInspectionsDivision
    Annotations: rdfs:label "Building Inspections Division", iao:0000115 "The municipal administrative body responsible for issuing permits, conducting inspections, and enforcing building codes within the City of Cleburne."
    SubClassOf: bfo:0000002, sdg:divisionCode some xsd:string, sdg:jurisdictionName some xsd:string, sdg:reportingPeriodStart some xsd:date, sdg:reportingPeriodEnd some xsd:date, sdg:totalPermitFeesCollected some xsd:decimal, sdg:performanceTarget some xsd:string, sdg:issues some sdg:BuildingPermit, sdg:issues some sdg:CertificateOfOccupancy, sdg:conducts some sdg:InspectionEvent
    HasKey: sdg:divisionCode

Class: sdg:VectorSpecies
    Annotations: rdfs:label "Vector Species", iao:0000115 "A biological species identified as a primary transmitter of a pathogen within a specific geographic region."
    SubClassOf: cco:ont00000995, sdg:speciesCode some xsd:string, sdg:commonName some xsd:string, sdg:isPrimaryVector some xsd:boolean, sdg:breedingPreference some xsd:string, sdg:isUrbanAdapted some xsd:boolean, sdg:transmitsPathogen exactly 1 sdg:Pathogen, sdg:observedIn some sdg:SurveillanceSite

Class: sdg:Pathogen
    Annotations: rdfs:label "Pathogen", iao:0000115 "A viral agent responsible for causing a specific disease outbreak within a defined population."
    SubClassOf: cco:ont00000995, sdg:pathogenCode some xsd:string, sdg:diseaseName some xsd:string, sdg:severityLevel some sdg:SeverityLevelKind, sdg:isEndemic some xsd:boolean, sdg:circulatingStrain some xsd:string, sdg:pathogenId some xsd:string, sdg:scientificName some xsd:string, sdg:commonName some xsd:string, sdg:hostPlant some xsd:string, sdg:geographicDistribution some xsd:string, sdg:transmittedBy some sdg:VectorSpecies, sdg:causesDiseaseIn exactly 1 sdg:CropPlant, sdg:producesEnzyme some sdg:Protein

Class: sdg:SurveillanceSite
    Annotations: rdfs:label "Surveillance Site", iao:0000115 "A specific geographic location or administrative district where entomological or clinical surveillance data is collected."
    SubClassOf: bfo:0000015, sdg:siteCode some xsd:string, sdg:districtName some xsd:string, sdg:regionType some sdg:RegionTypeKind, sdg:isEndemicZone some xsd:boolean, sdg:latitude some xsd:decimal, sdg:longitude some xsd:decimal, sdg:siteIdentifier some xsd:string, sdg:siteName some xsd:string, sdg:siteType some sdg:SiteTypeKind, sdg:operationalStatus some sdg:OperationalStatusKind, sdg:deploymentDate some xsd:dateTime, sdg:containsVectorPopulation some sdg:VectorSpecies, sdg:recordsClinicalCases some sdg:ClinicalCase, sdg:partOfCountry exactly 1 sdg:AdministrativeRegion, sdg:monitoredBy min 1 sdg:ControlCentre, sdg:hosts min 1 sdg:RadarStation, sdg:connectedVia min 1 sdg:NetworkLink

Class: sdg:ClinicalCase
    Annotations: rdfs:label "Clinical Case", iao:0000115 "A recorded instance of a patient presenting with specific symptoms and diagnosed with a particular disease at a healthcare facility."
    SubClassOf: cco:ont00000995, sdg:caseID some xsd:string, sdg:diagnosisDate some xsd:date, sdg:symptomProfile some xsd:string, sdg:diseaseForm some xsd:string, sdg:patientAge some xsd:integer, sdg:outcome some sdg:OutcomeKind, sdg:occurredAt exactly 1 sdg:HealthcareFacility, sdg:infectionSource exactly 1 sdg:Pathogen, sdg:reportedFrom exactly 1 sdg:SurveillanceSite
    HasKey: sdg:caseID

Class: sdg:HealthcareFacility
    Annotations: rdfs:label "Healthcare Facility", iao:0000115 "A medical institution where patients are admitted, diagnosed, and treated for infectious diseases."
    SubClassOf: sdg:HealthcareEntity, sdg:facilityCode some xsd:string, sdg:facilityName some xsd:string, sdg:facilityType some sdg:FacilityTypeKind, sdg:cityLocation some xsd:string, sdg:hasReferralCapacity some xsd:boolean, sdg:jurisdictionCode some xsd:string, sdg:locatedIn exactly 1 sdg:SurveillanceSite, sdg:treatsPathogen some sdg:Pathogen, sdg:receivesReferrals some sdg:HealthcareFacility, sdg:receivesSummary some sdg:HealthCareSummary, sdg:isOriginOf some sdg:TransferEvent, sdg:isDestinationOf some sdg:TransferEvent
    HasKey: sdg:facilityCode

Class: sdg:AdministrativeRegion
    Annotations: rdfs:label "Administrative Region", iao:0000115 "A defined geographic and political boundary, such as a district or country, used for organizing public health data."
    SubClassOf: sdg:GeographicEntity, sdg:regionCode some xsd:string, sdg:regionName some xsd:string, sdg:regionLevel some xsd:string, sdg:borderingCountry some xsd:string, sdg:climateZone some sdg:ClimateZoneKind, sdg:containsSurveillanceSites min 2 sdg:SurveillanceSite, sdg:governedBy exactly 1 sdg:HealthAuthority

Class: sdg:HealthAuthority
    Annotations: rdfs:label "Health Authority", iao:0000115 "An organizational body responsible for public health oversight, policy implementation, and disease control within a region."
    SubClassOf: sdg:Authority, sdg:authorityCode some xsd:string, sdg:authorityName some xsd:string, sdg:authorityType some xsd:string, sdg:isRegulatory some xsd:boolean, sdg:fundingSource some sdg:FundingSourceKind, sdg:contactPhone some xsd:string, sdg:contactEmail some xsd:string, sdg:regionCovered some xsd:string, sdg:overseesRegion exactly 1 sdg:AdministrativeRegion, sdg:fundsResearch some sdg:ResearchProject, sdg:commissionsServiceFrom min 2 sdg:MedicalPractice, sdg:operatesService some sdg:ClinicalService
    HasKey: sdg:authorityCode

Class: sdg:GolfShot
    Annotations: rdfs:label "Golf Shot", iao:0000115 "A discrete physical activity in which a golfer strikes a ball to achieve a specific trajectory and distance."
    SubClassOf: sdg:shotIdentifier some xsd:string, sdg:shotType some xsd:string, sdg:targetDistance some xsd:decimal, sdg:targetDirection some xsd:string, sdg:executionStatus some xsd:string, sdg:practiceSessionId some xsd:string, sdg:shotId some xsd:string, sdg:distance some xsd:decimal, sdg:direction some sdg:DirectionKind, sdg:decision some xsd:string, sdg:outcome some sdg:OutcomeKind, sdg:observedResult some xsd:string, sdg:executedUsing exactly 1 sdg:GolfClub, sdg:targets exactly 1 sdg:LandingSpot, sdg:partOf__escalated some sdg:PracticeRoutine, sdg:uses exactly 1 sdg:GolfClub, sdg:executedBy exactly 1 sdg:Golfer, sdg:targets exactly 1 sdg:TargetSpot
    HasKey: sdg:practiceSessionId

Class: sdg:GolfClub
    Annotations: rdfs:label "Golf Club", iao:0000115 "A manufactured implement used to strike a golf ball, characterized by specific grip and swing mechanics."
    SubClassOf: cco:ont00000995, sdg:clubId some xsd:string, sdg:clubType some sdg:ClubTypeKind, sdg:loftAngle some xsd:decimal, sdg:shaftLength some xsd:decimal, sdg:gripStyle some xsd:string, sdg:material some xsd:string, sdg:length some xsd:decimal, sdg:weight some xsd:decimal, sdg:loft some xsd:decimal, sdg:usedIn some sdg:GolfShot

Class: sdg:LandingSpot
    Annotations: rdfs:label "Landing Spot", iao:0000115 "A specific spatial coordinate on the course where a golf ball is intended to land before rolling to the target."
    SubClassOf: bfo:0000002, sdg:spotId some xsd:string, sdg:distanceFromBall some xsd:decimal, sdg:surfaceType some sdg:SurfaceTypeKind, sdg:elevationChange some xsd:decimal, sdg:targetedBy some sdg:GolfShot

Class: sdg:GripMechanics
    Annotations: rdfs:label "Grip Mechanics", iao:0000115 "The specific hand placement and pressure applied to a golf club during the setup and execution of a shot."
    SubClassOf: bfo:0000015, sdg:mechanicId some xsd:string, sdg:handPlacement some xsd:string, sdg:pressureLevel some sdg:PressureLevelKind, sdg:musclePadContact some xsd:boolean, sdg:appliedTo exactly 1 sdg:GolfClub, sdg:usedIn some sdg:GolfShot

Class: sdg:PracticeRoutine
    Annotations: rdfs:label "Practice Routine", iao:0000115 "A structured sequence of pre-shot and execution steps designed to improve golf performance through quality repetition."
    SubClassOf: bfo:0000015, sdg:routineId some xsd:string, sdg:routineName some xsd:string, sdg:focusArea some sdg:FocusAreaKind, sdg:isQualityFocused some xsd:boolean, sdg:includes min 2 sdg:GolfShot, sdg:defines some sdg:GripMechanics

Class: sdg:CertifiedOrganization
    Annotations: rdfs:label "Certified Organization", iao:0000115 "A material entity representing a legal or operational entity that has achieved and maintains a certified management system."
    SubClassOf: sdg:Organization, sdg:legalName some xsd:string, sdg:registeredAddress some xsd:string, sdg:certificationBody some xsd:string, sdg:certificationBodyRegion some xsd:string, sdg:certificationBodyRepresentative some xsd:string, sdg:certificationBodyTitle some xsd:string, sdg:certificationStatus some sdg:CertificationStatusKind, sdg:streetAddress some xsd:string, sdg:postalCode some xsd:string, sdg:city some xsd:string, sdg:country some sdg:CountryKind, sdg:registrationNumber some xsd:string, sdg:holdsCertification min 1 sdg:CertificationRecord, sdg:holdsApprovalFrom exactly 1 sdg:CertificationBody, sdg:holdsApprovalFor some sdg:CertificationRecord
    HasKey: sdg:postalCode

Class: sdg:ManagementStandard
    Annotations: rdfs:label "Management Standard", iao:0000115 "A material entity representing a published set of requirements and guidelines for management systems."
    SubClassOf: bfo:0000040, sdg:standardIdentifier some xsd:string, sdg:standardTitle some xsd:string, sdg:versionNumber some xsd:string, sdg:issuingBody some xsd:string, sdg:publicationYear some xsd:integer, sdg:standardVersion some xsd:string, sdg:issuingOrganizationDetail some xsd:string, sdg:isCertifiedBy min 1 sdg:CertificationRecord, sdg:isSubjectOf some sdg:CertificationRecord

Class: sdg:CertificationScope
    Annotations: rdfs:label "Certification Scope", iao:0000115 "A material entity representing the specific operational boundaries and activities covered by a certification."
    SubClassOf: bfo:0000040, sdg:scopeDescription some xsd:string, sdg:activityType some sdg:ActivityTypeKind, sdg:productCategory some xsd:string, sdg:isDefinedIn exactly 1 sdg:CertificationRecord

Class: sdg:ApprovalEvent
    Annotations: rdfs:label "Approval Event", iao:0000115 "A process representing the specific historical instance where an organization was granted approval for a standard."
    SubClassOf: sdg:Event, sdg:approvalDate some xsd:dateTime, sdg:approvalNumber some xsd:string, sdg:approvalType some sdg:ApprovalTypeKind, sdg:grantsCertification min 1 sdg:CertificationRecord, sdg:appliesToStandard exactly 1 sdg:ManagementStandard

Class: sdg:TopLevelDomain
    Annotations: rdfs:label "Top-Level Domain", iao:0000115 "A top-level domain (TLD) is a domain name extension that constitutes the highest level in the hierarchical Domain Name System of the Internet."
    SubClassOf: cco:ont00000995, sdg:tldIdentifier some sdg:TldIdentifierKind, sdg:delegationDate some xsd:date, sdg:registryOperator some xsd:string, sdg:isDelegated some xsd:boolean, sdg:totalRegisteredNames some xsd:integer, sdg:retailPrice some xsd:decimal, sdg:contains min 2 sdg:DomainName, sdg:measuredBy some sdg:AbuseRate, sdg:hasSecurityProtocol max 1 sdg:SecurityProtocol

Class: sdg:DomainName
    Annotations: rdfs:label "Domain Name", iao:0000115 "A unique identifier in the Domain Name System that corresponds to a specific resource on the Internet."
    SubClassOf: cco:ont00000995, sdg:domainLabel some xsd:string, sdg:registrationDate some xsd:dateTime, sdg:expirationDate some xsd:date, sdg:registrantId some xsd:string, sdg:status some sdg:StatusKind, sdg:isPrivacyProtected some xsd:boolean, sdg:belongsTld exactly 1 sdg:TopLevelDomain

Class: sdg:AbuseType
    Annotations: rdfs:label "Abuse Type", iao:0000115 "A specific category of malicious or abusive activity occurring within the Domain Name System."
    SubClassOf: bfo:0000015, sdg:abuseCode some xsd:string, sdg:description some xsd:string, sdg:severityLevel some sdg:SeverityLevelKind, sdg:isMitigated some xsd:boolean, sdg:definition some xsd:string, sdg:requiresMandatoryReporting some xsd:boolean, sdg:classification some sdg:ClassificationKind, sdg:affects min 2 sdg:DomainName, sdg:quantifiedBy exactly 1 sdg:AbuseRate, sdg:exhibitedBy some sdg:Incident, sdg:triggers min 2 sdg:SafeguardingProtocol

Class: sdg:AbuseRate
    Annotations: rdfs:label "Abuse Rate", iao:0000115 "A statistical measurement representing the frequency or proportion of abusive activities within a specific domain or TLD over a defined period."
    SubClassOf: bfo:0000015, sdg:measurementDate some xsd:dateTime, sdg:rateValue some xsd:decimal, sdg:sampleSize some xsd:integer, sdg:confidenceInterval some xsd:decimal, sdg:dataSource some xsd:string, sdg:describes exactly 1 sdg:TopLevelDomain, sdg:categorizedAs min 2 sdg:AbuseType, sdg:derivedFrom some sdg:ZoneFile

Class: sdg:ZoneFile
    Annotations: rdfs:label "Zone File", iao:0000115 "A database file containing the authoritative records for a specific top-level domain or zone in the DNS."
    SubClassOf: cco:ont00000995, sdg:fileId some xsd:string, sdg:captureDate some xsd:date, sdg:recordCount some xsd:integer, sdg:isComplete some xsd:boolean, sdg:storageLocation some xsd:string, sdg:covers exactly 1 sdg:TopLevelDomain, sdg:contains min 2 sdg:DomainName, sdg:usedIn some sdg:AbuseRate

Class: sdg:SecurityProtocol
    Annotations: rdfs:label "Security Protocol", iao:0000115 "A technical standard or mechanism deployed to enhance the security of domain name resolution, such as DNSSEC."
    SubClassOf: cco:ont00000995, sdg:protocolName some xsd:string, sdg:version some xsd:string, sdg:deploymentStatus some sdg:DeploymentStatusKind, sdg:lastVerified some xsd:date, sdg:protects exactly 1 sdg:TopLevelDomain, sdg:correlatesWith some sdg:AbuseRate

Class: sdg:InternalCommunicationEvent
    Annotations: rdfs:label "Internal Communication Event", iao:0000115 "A discrete instance of information exchange occurring between employees within the organization using a specific medium."
    SubClassOf: bfo:0000015, sdg:eventIdentifier some xsd:string, sdg:timestamp some xsd:dateTime, sdg:communicationDirection some sdg:CommunicationDirectionKind, sdg:contentType some sdg:ContentTypeKind, sdg:isFormal some xsd:boolean, sdg:effectivenessRating some sdg:EffectivenessRatingKind, sdg:usesPlatform exactly 1 sdg:SocialMediaPlatform, sdg:initiatedBy exactly 1 sdg:Employee, sdg:targetedTo min 2 sdg:Employee

Class: sdg:CommunicationFactor
    Annotations: rdfs:label "Communication Factor", iao:0000115 "A specific attribute, condition, or perceived benefit that influences the adoption or effectiveness of internal communication tools."
    SubClassOf: bfo:0000015, sdg:factorId some xsd:string, sdg:factorName some xsd:string, sdg:category some sdg:CategoryKind, sdg:impactScore some xsd:decimal, sdg:isPositive some xsd:boolean, sdg:influences min 2 sdg:SocialMediaPlatform, sdg:assessedBy min 2 sdg:Employee

Class: sdg:OrganizationalPolicy
    Annotations: rdfs:label "Organizational Policy", iao:0000115 "A formal or informal rule, guideline, or protocol established by the university to govern the use of communication tools."
    SubClassOf: sdg:GovernmentPolicy, sdg:policyId some xsd:string, sdg:policyTitle some xsd:string, sdg:effectiveDate some xsd:date, sdg:status some sdg:StatusKind, sdg:scope some sdg:ScopeKind, sdg:governs min 2 sdg:SocialMediaPlatform, sdg:appliesTo min 2 sdg:Employee

Class: sdg:PasswordCredential
    Annotations: rdfs:label "Password Credential", iao:0000115 "A cryptographic secret value used to authenticate a user account, subject to periodic rotation policies."
    SubClassOf: cco:ont00000995, sdg:credentialId some xsd:string, sdg:hashAlgorithm some xsd:string, sdg:strengthLevel some xsd:integer, sdg:isExpired some xsd:boolean, sdg:rotationPolicyId some xsd:string, sdg:belongsToOne exactly 1 sdg:UserAccount, sdg:usedForService some sdg:NetworkService

Class: sdg:MacBookPro
    Annotations: rdfs:label "MacBook Pro Device", iao:0000115 "A portable computing hardware unit running macOS, serving as the endpoint for user authentication and network configuration."
    SubClassOf: cco:ont00000995, sdg:serialNumber some xsd:string, sdg:modelIdentifier some xsd:string, sdg:osVersion some xsd:string, sdg:lastRebootDate some xsd:dateTime, sdg:isRebootRequired some xsd:boolean, sdg:hostsUserAccount exactly 1 sdg:UserAccount, sdg:configuresNetwork some sdg:NetworkConfiguration
    HasKey: sdg:serialNumber

Class: sdg:NetworkConfiguration
    Annotations: rdfs:label "Network Configuration", iao:0000115 "A structured set of parameters defining network connectivity, including SSID associations, authentication methods, and credential storage."
    SubClassOf: sdg:NetworkEntity, sdg:configId some xsd:string, sdg:ssidName some xsd:string, sdg:securityProtocol some xsd:string, sdg:isAutoJoinEnabled some xsd:boolean, sdg:lastUpdatedDate some xsd:dateTime, sdg:belongsToDevice exactly 1 sdg:MacBookPro, sdg:referencesService some sdg:NetworkService

Class: sdg:NetworkService
    Annotations: rdfs:label "Network Service", iao:0000115 "A remote or local network resource requiring authentication, such as Wi-Fi networks, cloud storage, or email servers."
    SubClassOf: sdg:NetworkEntity, sdg:serviceId some xsd:string, sdg:serviceName some xsd:string, sdg:protocolType some xsd:string, sdg:requiresCredential some xsd:boolean, sdg:lastCredentialUpdate some xsd:dateTime, sdg:criticalityLevel some xsd:string, sdg:ipAddress some xsd:string, sdg:port some xsd:integer, sdg:protocol some xsd:string, sdg:isInternetFacing some xsd:boolean, sdg:associatedWithConfig some sdg:NetworkConfiguration, sdg:authenticatedBy some sdg:PasswordCredential, sdg:isTargetOf some sdg:DDoSAttack, sdg:isMonitoredBy some sdg:FortiDDoSAppliance, sdg:receivesCleanTrafficFrom max 1 sdg:ScrubbingCenter

Class: sdg:ResponsibleInvestor
    Annotations: rdfs:label "Responsible Investor", iao:0000115 "An economic agent who incorporates ethical and environmental principles into investment decisions."
    SubClassOf: bfo:0000040, sdg:investorId some xsd:string, sdg:name some sdg:NameKind, sdg:wealth some xsd:decimal, sdg:diversificationOpportunities some xsd:integer, sdg:motivationType some sdg:MotivationTypeKind, sdg:isGreenAgent some xsd:boolean, sdg:holdsSharesIn some sdg:Corporation, sdg:experiences some sdg:EnvironmentalExternality, sdg:influences some sdg:CorporatePolicy

Class: sdg:Corporation
    Annotations: rdfs:label "Corporation", iao:0000115 "A business entity whose production activities generate environmental externalities and are subject to shareholder activism."
    SubClassOf: bfo:0000040, sdg:corporationId some xsd:string, sdg:name some sdg:NameKind, sdg:industryType some xsd:string, sdg:environmentalPollutionLevel some xsd:decimal, sdg:corporateReputationScore some xsd:decimal, sdg:isSubjectOfDiversification some xsd:boolean, sdg:hasCleaningTechnology some xsd:boolean, sdg:generates some sdg:EnvironmentalExternality, sdg:isInvestedInBy some sdg:ResponsibleInvestor, sdg:adoptsPolicy some sdg:CorporatePolicy

Class: sdg:EnvironmentalExternality
    Annotations: rdfs:label "Environmental Externality", iao:0000115 "A negative side effect of corporate production, such as pollution, that impacts social welfare and investor utility."
    SubClassOf: bfo:0000002, sdg:externalityId some xsd:string, sdg:pollutionSize some xsd:decimal, sdg:abatementCost some xsd:decimal, sdg:impactOnUtility some xsd:decimal, sdg:isInternalized some xsd:boolean, sdg:isGeneratedBy exactly 1 sdg:Corporation, sdg:isMitigatedBy some sdg:CorporatePolicy
    HasKey: sdg:externalityId

Class: sdg:CorporatePolicy
    Annotations: rdfs:label "Corporate Policy", iao:0000115 "A strategic decision or operational standard adopted by a corporation, such as environmental standards or production modernization."
    SubClassOf: sdg:GovernmentPolicy, sdg:policyId some xsd:string, sdg:policyType some sdg:PolicyTypeKind, sdg:implementationDate some xsd:dateTime, sdg:isEthical some xsd:boolean, sdg:targetPollutionReduction some xsd:decimal, sdg:isAdoptedBy exactly 1 sdg:Corporation, sdg:mitigates some sdg:EnvironmentalExternality, sdg:isInfluencedBy some sdg:ResponsibleInvestor

Class: sdg:ResponsibleInvestmentFund
    Annotations: rdfs:label "Responsible Investment Fund", iao:0000115 "A financial vehicle that pools capital from responsible investors to execute socially responsible investing strategies."
    SubClassOf: sdg:FinancialEntity, sdg:fundId some xsd:string, sdg:fundName some xsd:string, sdg:jurisdiction some sdg:JurisdictionKind, sdg:totalAssets some xsd:decimal, sdg:isEmpiricallyAnalyzed some xsd:boolean, sdg:focusRegion some xsd:string, sdg:investmentStrategy some xsd:string, sdg:investsIn some sdg:Corporation, sdg:isManagedBy some sdg:ResponsibleInvestor, sdg:isAnalyzedIn some sdg:EmpiricalStudy

Class: sdg:EmpiricalStudy
    Annotations: rdfs:label "Empirical Study", iao:0000115 "A research activity involving the analysis of data to test theoretical models or provide recommendations for ethical economy implementation."
    SubClassOf: bfo:0000015, sdg:studyId some xsd:string, sdg:studyTitle some xsd:string, sdg:region some sdg:RegionKind, sdg:dataSource some xsd:string, sdg:isTheoreticalModel some xsd:boolean, sdg:hasRecommendations some xsd:boolean, sdg:studyIdentifier some xsd:string, sdg:conductedDate some xsd:dateTime, sdg:methodology some xsd:string, sdg:sampleSize some xsd:integer, sdg:publicationStatus some xsd:string, sdg:journalName some xsd:string, sdg:analyzes some sdg:ResponsibleInvestmentFund, sdg:models some sdg:EnvironmentalExternality, sdg:informs some sdg:CorporatePolicy, sdg:investigates some sdg:InformationLogisticsStrategy, sdg:identifies min 2 sdg:SuccessFactor, sdg:measures some sdg:OrganizationalPerformance

Class: sdg:ClinicalProfile
    Annotations: rdfs:label "Clinical Profile", iao:0000115 "A record of a patient's biochemical markers and physiological measurements used to assess kidney function."
    SubClassOf: cco:ont00000995, sdg:profileId some xsd:string, sdg:urea some xsd:decimal, sdg:creatinine some xsd:decimal, sdg:potassium some xsd:decimal, sdg:sodium some xsd:decimal, sdg:calcium some xsd:decimal, sdg:phosphorus some xsd:decimal, sdg:uricAcid some xsd:decimal, sdg:recordedFor exactly 1 sdg:Patient, sdg:analyzedBy some sdg:NeuralNetworkModel
    HasKey: sdg:profileId

Class: sdg:DialysisSession
    Annotations: rdfs:label "Dialysis Session", iao:0000115 "A medical procedure involving the artificial removal of waste products and excess fluid from the blood."
    SubClassOf: bfo:0000015, sdg:sessionId some xsd:string, sdg:startDate some xsd:dateTime, sdg:duration some xsd:decimal, sdg:status some sdg:StatusKind, sdg:performedOn exactly 1 sdg:Patient, sdg:conductedAt exactly 1 sdg:Facility

Class: sdg:NeuralNetworkModel
    Annotations: rdfs:label "Neural Network Model", iao:0000115 "A computational artifact representing an artificial neural network architecture trained to predict renal failure."
    SubClassOf: cco:ont00000995, sdg:modelId some xsd:string, sdg:architectureType some sdg:ArchitectureTypeKind, sdg:accuracy some xsd:decimal, sdg:trainingDate some xsd:date, sdg:analyzes some sdg:ClinicalProfile, sdg:trainedOn min 2 sdg:Patient

Class: sdg:ProteinStructure
    Annotations: rdfs:label "Protein Structure", iao:0000115 "A three-dimensional conformational arrangement of a polypeptide chain, modeled or characterized computationally."
    SubClassOf: cco:ont00000995, sdg:structureId some xsd:string, sdg:pdbCode some xsd:string, sdg:resolution some sdg:ResolutionKind, sdg:method some sdg:MethodKind, sdg:dateResolved some xsd:dateTime, sdg:chainCount some xsd:integer, sdg:rmsdValue some xsd:decimal, sdg:modeledUsing exactly 1 sdg:SoftwareTool, sdg:associatedWithProtein exactly 1 sdg:Protein

Class: sdg:Protein
    Annotations: rdfs:label "Protein", iao:0000115 "A biological macromolecule composed of amino acid polymers, such as an ABA receptor or a proteolytic enzyme."
    SubClassOf: cco:ont00000995, sdg:proteinId some xsd:string, sdg:uniprotAccession some xsd:string, sdg:geneName some xsd:string, sdg:organism some xsd:string, sdg:molecularWeight some xsd:decimal, sdg:sequenceLength some xsd:integer, sdg:function some xsd:string, sdg:hasStructure some sdg:ProteinStructure, sdg:inhibits some sdg:SmallMolecule, sdg:involvedInPathogenesis max 1 sdg:Pathogen

Class: sdg:SmallMolecule
    Annotations: rdfs:label "Small Molecule", iao:0000115 "A low molecular weight organic compound, such as a drug candidate, toxin, or natural product."
    SubClassOf: cco:ont00000995, sdg:moleculeId some xsd:string, sdg:smiles some xsd:string, sdg:iupacName some xsd:string, sdg:molecularFormula some xsd:string, sdg:molecularWeight some xsd:decimal, sdg:activityClass some xsd:string, sdg:toxicityScore some xsd:decimal, sdg:optimizationStatus some xsd:string, sdg:targets some sdg:Protein, sdg:usedInFormulation some sdg:FoodFormulation
    HasKey: sdg:moleculeId

Class: sdg:MolecularDynamicsSimulation
    Annotations: rdfs:label "Molecular Dynamics Simulation", iao:0000115 "A computational process simulating the physical movements of atoms and molecules over time."
    SubClassOf: bfo:0000015, sdg:simulationId some xsd:string, sdg:startTime some xsd:dateTime, sdg:endTime some xsd:dateTime, sdg:duration some xsd:decimal, sdg:temperature some xsd:decimal, sdg:pressure some xsd:string, sdg:forceField some xsd:string, sdg:convergenceStatus some xsd:string, sdg:usesSoftware exactly 1 sdg:SoftwareTool, sdg:simulatesStructure exactly 1 sdg:ProteinStructure

Class: sdg:CropPlant
    Annotations: rdfs:label "Crop Plant", iao:0000115 "A cultivated plant species grown for agricultural purposes."
    SubClassOf: cco:ont00000995, sdg:plantId some xsd:string, sdg:speciesName some xsd:string, sdg:variety some xsd:string, sdg:growthStage some xsd:string, sdg:stressToleranceLevel some xsd:decimal, sdg:yieldMetric some xsd:decimal, sdg:affectedBy some sdg:Pathogen, sdg:treatedWith some sdg:SmallMolecule

Class: sdg:FoodFormulation
    Annotations: rdfs:label "Food Formulation", iao:0000115 "A prepared mixture or compound designed for application in the food industry, such as a natural colorant."
    SubClassOf: cco:ont00000995, sdg:formulationId some xsd:string, sdg:productCode some xsd:string, sdg:colorantSource some xsd:string, sdg:concentration some xsd:string, sdg:phLevel some xsd:decimal, sdg:shelfLife some xsd:integer, sdg:regulatoryStatus some sdg:RegulatoryStatusKind, sdg:contains some sdg:SmallMolecule, sdg:intendedFor exactly 1 sdg:FoodIndustryApplication

Class: sdg:FoodIndustryApplication
    Annotations: rdfs:label "Food Industry Application", iao:0000115 "A specific use case or process within the food industry where a formulation is applied."
    SubClassOf: bfo:0000015, sdg:applicationId some xsd:string, sdg:applicationType some sdg:ApplicationTypeKind, sdg:targetFoodMatrix some xsd:string, sdg:dosage some xsd:string, sdg:efficacyScore some xsd:decimal, sdg:usesFormulation exactly 1 sdg:FoodFormulation

Class: sdg:ControllingReport
    Annotations: rdfs:label "Controlling Report", iao:0000115 "A structured business report generated by the FACT system for executive review, planning, or strategic monitoring."
    SubClassOf: sdg:Report, sdg:reportId some xsd:string, sdg:reportName some xsd:string, sdg:reportType some sdg:ReportTypeKind, sdg:creationDate some xsd:dateTime, sdg:status some sdg:StatusKind, sdg:layoutFormat some xsd:string, sdg:contentType some sdg:ContentTypeKind, sdg:generatedBy exactly 1 sdg:BusinessProcess, sdg:coversSegment some sdg:BusinessSegment, sdg:createdBy exactly 1 sdg:ControllingUser

Class: sdg:BusinessSegment
    Annotations: rdfs:label "Business Segment", iao:0000115 "A distinct operational division or subsidiary of the airport enterprise, such as retail, properties, or flight operations."
    SubClassOf: sdg:BusinessEntity, sdg:segmentCode some xsd:string, sdg:segmentName some xsd:string, sdg:segmentType some sdg:SegmentTypeKind, sdg:isConsolidated some xsd:boolean, sdg:parentOrganizationId some xsd:string, sdg:generatesReport some sdg:ControllingReport, sdg:partOf__escalated max 1 sdg:BusinessSegment

Class: sdg:ControllingUser
    Annotations: rdfs:label "Controlling User", iao:0000115 "A personnel entity within the corporate controlling department who interacts with the BI system to perform planning, reporting, or analysis tasks."
    SubClassOf: bfo:0000002, sdg:userId some xsd:string, sdg:userName some xsd:string, sdg:roleTitle some sdg:RoleTitleKind, sdg:department some xsd:string, sdg:isStrategicPlanner some xsd:boolean, sdg:createsReport some sdg:ControllingReport, sdg:monitorsStrategy some sdg:StrategicPlan
    HasKey: sdg:userId

Class: sdg:StrategicPlan
    Annotations: rdfs:label "Strategic Plan", iao:0000115 "A driver-based business plan created, executed, and monitored through the integrated BI environment to guide corporate strategy."
    SubClassOf: bfo:0000040, sdg:planId some xsd:string, sdg:planName some xsd:string, sdg:planningHorizon some xsd:integer, sdg:isDriverBased some xsd:boolean, sdg:approvalStatus some sdg:ApprovalStatusKind, sdg:lastReviewDate some xsd:date, sdg:monitoredBy some sdg:ControllingUser, sdg:drivesSegment some sdg:BusinessSegment, sdg:producesReport some sdg:ControllingReport
    HasKey: sdg:planId

Class: sdg:BusinessProcess
    Annotations: rdfs:label "Business Process", iao:0000115 "A standardized operational activity supported by the BI tool, such as group consolidation, accounting, or profit and loss statement creation."
    SubClassOf: bfo:0000015, sdg:processId some xsd:string, sdg:processName some xsd:string, sdg:processCategory some xsd:string, sdg:isAutomated some xsd:boolean, sdg:executionFrequency some xsd:string, sdg:averageDurationHours some xsd:decimal, sdg:efficiencyGainPercent some xsd:decimal, sdg:processStatus some sdg:ProcessStatusKind, sdg:generatesReport some sdg:ControllingReport, sdg:supportsSegment some sdg:BusinessSegment, sdg:executedBy some sdg:ControllingUser, sdg:executedBy min 2 sdg:Employee, sdg:supportedByTool min 2 sdg:ProductivityTool, sdg:generatesOutput max 1 sdg:BudgetSubmission

Class: sdg:WastewaterTreatmentProcess
    Annotations: rdfs:label "Wastewater Treatment Process", iao:0000115 "An industrial activity involving the application of photocatalysis or photo-electrocatalysis to remove hazardous pollutants from industrial effluents."
    SubClassOf: bfo:0000015, sdg:processIdentifier some xsd:string, sdg:processType some xsd:string, sdg:efficiencyRating some xsd:decimal, sdg:resourceConsumptionRate some xsd:decimal, sdg:status some sdg:StatusKind, sdg:targetPollutantClass some xsd:string, sdg:treats min 2 sdg:IndustrialEffluent, sdg:developedBy exactly 1 sdg:ResearchProject, sdg:utilizes min 2 sdg:CatalyticMaterial

Class: sdg:IndustrialEffluent
    Annotations: rdfs:label "Industrial Effluent", iao:0000115 "A liquid waste stream discharged from industrial facilities containing dissolved, toxic, and non-biodegradable pollutants."
    SubClassOf: sdg:Resource, sdg:effluentIdentifier some xsd:string, sdg:sourceIndustry some xsd:string, sdg:pollutantConcentration some xsd:decimal, sdg:biodegradabilityStatus some xsd:string, sdg:toxicityLevel some sdg:ToxicityLevelKind, sdg:sampleCollectionDate some xsd:dateTime, sdg:treatedBy min 2 sdg:WastewaterTreatmentProcess, sdg:contains min 2 sdg:ChemicalPollutant, sdg:originatesFrom exactly 1 sdg:IndustrialFacility

Class: sdg:CatalyticMaterial
    Annotations: rdfs:label "Catalytic Material", iao:0000115 "A nanotechnology-based material designed to facilitate photocatalytic or photo-electrocatalytic reactions for pollutant degradation."
    SubClassOf: cco:ont00000995, sdg:materialIdentifier some xsd:string, sdg:materialClass some xsd:string, sdg:synthesisMethod some xsd:string, sdg:surfaceArea some xsd:decimal, sdg:bandGapEnergy some xsd:decimal, sdg:patentStatus some xsd:string, sdg:usedIn min 2 sdg:WastewaterTreatmentProcess, sdg:developedBy exactly 1 sdg:ResearchProject, sdg:composedOf min 2 sdg:ChemicalElement

Class: sdg:ResearchInstitution
    Annotations: rdfs:label "Research Institution", iao:0000115 "An academic or industrial organization involved in the research, development, or dissemination of water treatment technologies."
    SubClassOf: sdg:ResearchEntity, sdg:institutionIdentifier some xsd:string, sdg:institutionName some xsd:string, sdg:country some sdg:CountryKind, sdg:institutionType some sdg:InstitutionTypeKind, sdg:establishmentDate some xsd:date, sdg:evaluationStatus some xsd:string, sdg:evaluationOutcome some sdg:EvaluationOutcomeKind, sdg:hostingInstitute some xsd:string, sdg:institutionID some xsd:string, sdg:location some xsd:string, sdg:foundingYear some xsd:integer, sdg:specialization some sdg:SpecializationKind, sdg:status some sdg:StatusKind, sdg:collaboratesWith min 2 sdg:ResearchProject, sdg:hosts min 2 sdg:Researcher, sdg:evaluatesProgram some sdg:CommunityProgram, sdg:evaluatesCurriculum some sdg:EducationalCurriculum, sdg:affiliatedWith some sdg:University, sdg:developsProgram min 2 sdg:CognitiveTrainingProgram, sdg:conductsAssessment min 2 sdg:CognitiveAssessment

Class: sdg:ChemicalPollutant
    Annotations: rdfs:label "Chemical Pollutant", iao:0000115 "A specific toxic, hazardous, or persistent chemical substance found in industrial wastewater, such as dyes or heavy metals."
    SubClassOf: cco:ont00000995, sdg:pollutantIdentifier some xsd:string, sdg:chemicalName some xsd:string, sdg:casRegistryNumber some xsd:string, sdg:molecularWeight some xsd:decimal, sdg:pollutantClass some xsd:string, sdg:concentrationThreshold some xsd:decimal, sdg:presentIn min 2 sdg:IndustrialEffluent, sdg:targetedBy min 2 sdg:WastewaterTreatmentProcess, sdg:composedOf min 2 sdg:ChemicalElement

Class: sdg:ChemicalElement
    Annotations: rdfs:label "Chemical Element", iao:0000115 "A fundamental chemical substance that constitutes the atomic building blocks of catalytic materials and chemical pollutants."
    SubClassOf: cco:ont00000995, sdg:elementSymbol some xsd:string, sdg:atomicNumber some xsd:integer, sdg:atomicMass some xsd:decimal, sdg:electronegativity some xsd:decimal, sdg:stateAtSTP some xsd:string, sdg:constitutes min 2 sdg:CatalyticMaterial, sdg:constitutes min 2 sdg:ChemicalPollutant

Class: sdg:SMEEmployer
    Annotations: rdfs:label "Small and Medium-sized Enterprise Employer", iao:0000115 "A commercial business entity operating in the UK economy with fewer than 250 employees, serving as the primary unit of analysis for growth and performance metrics."
    SubClassOf: cco:ont00000995, sdg:employerId some xsd:string, sdg:employeeCount some xsd:integer, sdg:commercialSector some xsd:string, sdg:region some sdg:RegionKind, sdg:exportStatus some xsd:boolean, sdg:trainingCommitment some xsd:string, sdg:recordedIn some sdg:SurveyWave, sdg:measuredBy some sdg:GrowthPerformance, sdg:financedBy some sdg:FinanceAccess

Class: sdg:SurveyWave
    Annotations: rdfs:label "Survey Wave", iao:0000115 "A specific temporal instance of data collection, either from the Annual Small Business Survey (ASBS) or the Business Barometer series, capturing SME characteristics at a defined point in time."
    SubClassOf: bfo:0000015, sdg:waveId some xsd:string, sdg:surveyType some sdg:SurveyTypeKind, sdg:startDate some xsd:dateTime, sdg:endDate some xsd:dateTime, sdg:economicPeriod some xsd:string, sdg:sampleSize some xsd:integer, sdg:covers some sdg:SMEEmployer, sdg:conductedBy exactly 1 sdg:ResearchAgency

Class: sdg:ResearchAgency
    Annotations: rdfs:label "Research Agency", iao:0000115 "The external organization responsible for executing the survey methodology and data collection for the study."
    SubClassOf: sdg:ResearchEntity, sdg:agencyName some xsd:string, sdg:contractId some xsd:string, sdg:roleType some sdg:RoleTypeKind, sdg:executed some sdg:SurveyWave

Class: sdg:GrowthPerformance
    Annotations: rdfs:label "Growth Performance", iao:0000115 "A measured outcome assessing the change in an SME's operational scale, specifically tracking fluctuations in employment levels and financial turnover over a 12-month period."
    SubClassOf: bfo:0000015, sdg:employmentChange some xsd:string, sdg:turnoverChange some xsd:string, sdg:measurementPeriod some xsd:string, sdg:growthAmbition some xsd:string, sdg:appliesTo exactly 1 sdg:SMEEmployer, sdg:observedIn exactly 1 sdg:SurveyWave

Class: sdg:FinanceAccess
    Annotations: rdfs:label "Finance Access", iao:0000115 "A process measuring the availability and supply of financial resources to an SME, influenced by banking sector conditions and recessionary pressures."
    SubClassOf: sdg:FinancialEntity, sdg:accessStatus some sdg:AccessStatusKind, sdg:financeType some xsd:string, sdg:bankingSectorImpact some sdg:BankingSectorImpactKind, sdg:amountRequested some xsd:decimal, sdg:amountApproved some xsd:decimal, sdg:appliesTo exactly 1 sdg:SMEEmployer, sdg:observedIn exactly 1 sdg:SurveyWave

Class: sdg:StakeholderNeed
    Annotations: rdfs:label "Stakeholder Need", iao:0000115 "A specific requirement, expectation, or demand identified by a stakeholder group that the institution must address to provide value and maintain legitimacy."
    SubClassOf: sdg:needId some xsd:string, sdg:needDescription some xsd:string, sdg:urgencyLevel some xsd:string, sdg:satisfactionStatus some sdg:SatisfactionStatusKind, sdg:lastAssessedDate some xsd:dateTime, sdg:belongsToManyStakeholders min 2 sdg:StakeholderGroup, sdg:isAddressedBy some sdg:ITGovernanceProcess

Class: sdg:ITGovernanceProcess
    Annotations: rdfs:label "IT Governance Process", iao:0000115 "A structured activity or set of activities within an institution that directs and controls IT investments and activities to ensure alignment with organizational goals and stakeholder needs."
    SubClassOf: bfo:0000015, sdg:processId some xsd:string, sdg:processName some xsd:string, sdg:framework some xsd:string, sdg:maturityLevel some xsd:integer, sdg:lastAuditDate some xsd:date, sdg:complianceStatus some sdg:ComplianceStatusKind, sdg:addressesStakeholderNeeds min 2 sdg:StakeholderNeed, sdg:isImplementedIn exactly 1 sdg:HigherEducationInstitution
    HasKey: sdg:processId

Class: sdg:HigherEducationInstitution
    Annotations: rdfs:label "Higher Education Institution", iao:0000115 "A public organization in Egypt responsible for providing higher education, conducting research, and offering community services, which is subject to IT governance frameworks."
    SubClassOf: bfo:0000002, sdg:institutionId some xsd:string, sdg:institutionName some xsd:string, sdg:locationCity some xsd:string, sdg:establishmentYear some xsd:integer, sdg:fundingSource some sdg:FundingSourceKind, sdg:governanceStatus some xsd:string, sdg:implementsITGovernanceProcesses min 3 sdg:ITGovernanceProcess, sdg:servesStakeholderGroups min 2 sdg:StakeholderGroup
    HasKey: sdg:institutionId

Class: sdg:ReformInitiative
    Annotations: rdfs:label "Reform Initiative", iao:0000115 "A structured program or project implemented to improve the operational effectiveness, efficiency, or strategic alignment of public higher education institutions, often involving IT infrastructure."
    SubClassOf: bfo:0000015, sdg:initiativeId some xsd:string, sdg:initiativeName some xsd:string, sdg:startDate some xsd:dateTime, sdg:endDate some xsd:dateTime, sdg:budgetAmount some xsd:decimal, sdg:fundingAgency some xsd:string, sdg:completionStatus some sdg:CompletionStatusKind, sdg:targetsInstitutions min 2 sdg:HigherEducationInstitution, sdg:includesITSubProject some sdg:ITSubProject

Class: sdg:ITSubProject
    Annotations: rdfs:label "IT Sub-Project", iao:0000115 "A specific component or sub-project within a larger reform initiative that focuses on implementing Information and Communication Technology infrastructure or governance capabilities."
    SubClassOf: bfo:0000015, sdg:subProjectId some xsd:string, sdg:subProjectName some xsd:string, sdg:budgetAllocation some xsd:decimal, sdg:implementationPhase some xsd:integer, sdg:technologyStack some xsd:string, sdg:successMetric some xsd:string, sdg:isPartOfInitiative exactly 1 sdg:ReformInitiative, sdg:supportsGovernanceProcess some sdg:ITGovernanceProcess

Class: sdg:QualityAssuranceSystem
    Annotations: rdfs:label "Quality Assurance System", iao:0000115 "A coordinated set of procedures, standards, and activities implemented to ensure and improve the quality of higher education programs and institutions within the East African Community region."
    SubClassOf: bfo:0000015, sdg:systemIdentifier some xsd:string, sdg:implementationDate some xsd:dateTime, sdg:status some sdg:StatusKind, sdg:region some sdg:RegionKind, sdg:frameworkVersion some xsd:string, sdg:systemId some xsd:string, sdg:name some sdg:NameKind, sdg:startDate some xsd:dateTime, sdg:developedBy exactly 1 sdg:RegionalCommission, sdg:appliedTo some sdg:AcademicProgram, sdg:measuredBy some sdg:QualityBenchmark, sdg:developedBy exactly 1 sdg:InstitutionalReform, sdg:supports some sdg:RegionalQualificationsFramework, sdg:monitoredBy exactly 1 sdg:QualityAssuranceOffice

Class: sdg:RegionalCommission
    Annotations: rdfs:label "Regional Commission", iao:0000115 "An institutional body responsible for coordinating, developing, and overseeing the implementation of quality assurance frameworks and higher education policies across the East African Community partner states."
    SubClassOf: bfo:0000015, sdg:commissionCode some xsd:string, sdg:establishedDate some xsd:date, sdg:jurisdiction some sdg:JurisdictionKind, sdg:commissionType some xsd:string, sdg:operationalStatus some sdg:OperationalStatusKind, sdg:oversees some sdg:QualityAssuranceSystem, sdg:collaboratesWith some sdg:University

Class: sdg:QualityBenchmark
    Annotations: rdfs:label "Quality Benchmark", iao:0000115 "A standardized metric or criterion used to evaluate the performance and quality of academic programs and institutions against regional and international standards."
    SubClassOf: bfo:0000015, sdg:benchmarkId some xsd:string, sdg:metricName some xsd:string, sdg:targetValue some xsd:decimal, sdg:measurementUnit some xsd:string, sdg:evaluationFrequency some xsd:string, sdg:status some sdg:StatusKind, sdg:definesCriteriaFor some sdg:AcademicProgram, sdg:monitoredBy exactly 1 sdg:RegionalCommission, sdg:validatedBy some sdg:ExpertPanel

Class: sdg:ExpertPanel
    Annotations: rdfs:label "Expert Panel", iao:0000115 "A group of specialists commissioned to provide technical expertise, review quality assurance frameworks, and validate benchmarks during the consultative development process."
    SubClassOf: bfo:0000015, sdg:panelId some xsd:string, sdg:panelName some xsd:string, sdg:expertiseDomain some xsd:string, sdg:commissioningBody some xsd:string, sdg:panelStatus some sdg:PanelStatusKind, sdg:advises exactly 1 sdg:RegionalCommission, sdg:validates some sdg:QualityBenchmark, sdg:consultedBy some sdg:University

Class: sdg:ForestPlantation
    Annotations: rdfs:label "Forest Plantation", iao:0000115 "A managed forest area established through planting activities for timber, carbon sequestration, or conservation purposes."
    SubClassOf: bfo:0000040, sdg:plantationId some xsd:string, sdg:areaHectares some xsd:decimal, sdg:establishmentYear some xsd:integer, sdg:certificationStatus some sdg:CertificationStatusKind, sdg:primarySpecies some xsd:string, sdg:landUseHistory some xsd:string, sdg:locatedIn exactly 1 sdg:Country, sdg:managedBy exactly 1 sdg:Company, sdg:produces some sdg:WoodProduct

Class: sdg:WoodProduct
    Annotations: rdfs:label "Wood Product", iao:0000115 "A processed or raw timber product derived from forest plantations, including sawn timber, poles, pulp, and charcoal."
    SubClassOf: bfo:0000040, sdg:productId some xsd:string, sdg:productName some xsd:string, sdg:productCategory some xsd:string, sdg:productionVolume some xsd:decimal, sdg:productionYear some xsd:integer, sdg:revenueUSD some xsd:decimal, sdg:derivedFrom some sdg:ForestPlantation

Class: sdg:CarbonCredit
    Annotations: rdfs:label "Carbon Credit", iao:0000115 "A tradable certificate representing a verified reduction or sequestration of greenhouse gas emissions, generated through forestry or bio-energy projects."
    SubClassOf: bfo:0000040, sdg:creditId some xsd:string, sdg:standard some sdg:StandardKind, sdg:issueDate some xsd:date, sdg:volumeTonnesCO2 some xsd:decimal, sdg:revenueUSD some xsd:decimal, sdg:projectType some sdg:ProjectTypeKind, sdg:generatedBy some sdg:ForestPlantation

Class: sdg:IndustrialFacility
    Annotations: rdfs:label "Industrial Facility", iao:0000115 "A physical plant or mill used for processing timber into wood products, including sawmills, pole treatment plants, and charcoal production facilities."
    SubClassOf: bfo:0000040, sdg:facilityId some xsd:string, sdg:facilityName some xsd:string, sdg:location some xsd:string, sdg:operationalStatus some sdg:OperationalStatusKind, sdg:capacity some xsd:integer, sdg:revenueUSD some xsd:decimal, sdg:locatedIn exactly 1 sdg:Country, sdg:operatedBy exactly 1 sdg:Company, sdg:processes some sdg:WoodProduct

Class: sdg:DomesticViolenceIncident
    Annotations: rdfs:label "Domestic Violence Incident", iao:0000115 "A specific event of domestic violence involving an offender and a victim, documented through police reports and legal proceedings."
    SubClassOf: sdg:SecurityAndSafetyMeasure, sdg:incidentId some xsd:string, sdg:reportDate some xsd:dateTime, sdg:severityLevel some sdg:SeverityLevelKind, sdg:location some xsd:string, sdg:offenderId some xsd:string, sdg:victimId some xsd:string, sdg:policeReportNumber some xsd:string, sdg:lethalityScore some xsd:decimal, sdg:documentedBy exactly 1 sdg:PoliceReport, sdg:involvesVictim exactly 1 sdg:Victim, sdg:involvesOffender exactly 1 sdg:Offender
    HasKey: sdg:incidentId

Class: sdg:PoliceReport
    Annotations: rdfs:label "Police Report", iao:0000115 "An official document created by law enforcement detailing the circumstances of a domestic violence incident."
    SubClassOf: sdg:Report, sdg:reportId some xsd:string, sdg:officerId some xsd:string, sdg:reportDate some xsd:dateTime, sdg:incidentId some xsd:string, sdg:status some sdg:StatusKind, sdg:narrative some xsd:string, sdg:evidenceCollected some xsd:boolean, sdg:recordsIncident exactly 1 sdg:DomesticViolenceIncident

Class: sdg:Victim
    Annotations: rdfs:label "Victim", iao:0000115 "An individual who has been subjected to domestic violence and is receiving support from the YWCA."
    SubClassOf: bfo:0000002, sdg:victimId some xsd:string, sdg:fullName some xsd:string, sdg:dateOfBirth some xsd:date, sdg:contactNumber some xsd:string, sdg:safetyPlanStatus some sdg:SafetyPlanStatusKind, sdg:crisisCallCount some xsd:integer, sdg:referralStatus some xsd:string, sdg:experiencedIncident min 2 sdg:DomesticViolenceIncident, sdg:assignedAdvocate exactly 1 sdg:LegalAdvocate

Class: sdg:Offender
    Annotations: rdfs:label "Offender", iao:0000115 "An individual who has committed an act of domestic violence against a victim."
    SubClassOf: bfo:0000002, sdg:offenderId some xsd:string, sdg:fullName some xsd:string, sdg:dateOfBirth some xsd:date, sdg:criminalHistory some xsd:string, sdg:accountabilityStatus some xsd:string, sdg:committedIncident min 2 sdg:DomesticViolenceIncident

Class: sdg:LegalAdvocate
    Annotations: rdfs:label "Legal Advocate", iao:0000115 "A professional role within the YWCA providing legal support, crisis intervention, and advocacy for domestic violence survivors."
    SubClassOf: bfo:0000015, sdg:advocateId some xsd:string, sdg:fullName some xsd:string, sdg:educationLevel some sdg:EducationLevelKind, sdg:onCallRotation some sdg:OnCallRotationKind, sdg:supervisorId some xsd:string, sdg:caseLoad some xsd:integer, sdg:supportsVictim min 3 sdg:Victim, sdg:liaisesWithProsecutor some sdg:Prosecutor, sdg:filesProtectionOrder some sdg:ProtectionOrder

Class: sdg:ProtectionOrder
    Annotations: rdfs:label "Protection Order", iao:0000115 "A legal document issued by a court to protect a victim from further domestic violence by an offender."
    SubClassOf: cco:ont00000958, sdg:orderId some xsd:string, sdg:issueDate some xsd:date, sdg:expirationDate some xsd:date, sdg:orderType some sdg:OrderTypeKind, sdg:courtCaseNumber some xsd:string, sdg:status some sdg:StatusKind, sdg:protectsVictim exactly 1 sdg:Victim, sdg:restrictsOffender exactly 1 sdg:Offender, sdg:filedByAdvocate exactly 1 sdg:LegalAdvocate

Class: sdg:Prosecutor
    Annotations: rdfs:label "Prosecutor", iao:0000115 "A legal professional representing the state in criminal cases involving domestic violence."
    SubClassOf: bfo:0000015, sdg:prosecutorId some xsd:string, sdg:fullName some xsd:string, sdg:caseLoad some xsd:integer, sdg:courtAssignment some xsd:string, sdg:handlesCase min 2 sdg:DomesticViolenceIncident, sdg:collaboratesWithAdvocate some sdg:LegalAdvocate
    HasKey: sdg:prosecutorId

Class: sdg:Concentration
    Annotations: rdfs:label "Concentration", iao:0000115 "A specialized area of focus within an academic program that defines the specific methodological tools and reasoning approaches students must master."
    SubClassOf: bfo:0000015, sdg:concentrationName some xsd:string, sdg:focusArea some sdg:FocusAreaKind, sdg:methodologyType some xsd:string, sdg:isCore some xsd:boolean, sdg:concentrationId some xsd:string, sdg:name some sdg:NameKind, sdg:requiredElectives some xsd:integer, sdg:status some sdg:StatusKind, sdg:partOfProgram exactly 1 sdg:AcademicProgram, sdg:teachesMethod some sdg:StatisticalMethod, sdg:includesCourse some sdg:Course, sdg:partOfDegree exactly 1 sdg:DegreeProgram

Class: sdg:ProfessionalRole
    Annotations: rdfs:label "Professional Role", iao:0000115 "A social role or function (e.g., Researcher, Collaborator, Educator) that a graduate is prepared to perform in the public health and biostatistics domain."
    SubClassOf: sdg:Role, sdg:roleName some xsd:string, sdg:roleCategory some sdg:RoleCategoryKind, sdg:primaryResponsibility some xsd:string, sdg:roleTitle some sdg:RoleTitleKind, sdg:department some xsd:string, sdg:startDate some xsd:dateTime, sdg:responsibilities some xsd:string, sdg:reportingTo some xsd:string, sdg:grantedByProgram exactly 1 sdg:AcademicProgram, sdg:requiresCompetency min 2 sdg:Competency, sdg:performedInContext some sdg:ResearchActivity, sdg:heldBy exactly 1 sdg:Person, sdg:partOf__escalated exactly 1 sdg:Organization, sdg:focusesOn some sdg:StrategicInitiative

Class: sdg:ResearchActivity
    Annotations: rdfs:label "Research Activity", iao:0000115 "A specific empirical study, methodological development project, or educational dissemination event conducted within the public health or biomedical domain."
    SubClassOf: sdg:ProgramActivity, sdg:activityID some xsd:string, sdg:activityType some sdg:ActivityTypeKind, sdg:studyDesign some xsd:string, sdg:dataSource some xsd:string, sdg:startDate some xsd:dateTime, sdg:endDate some xsd:dateTime, sdg:status some sdg:StatusKind, sdg:usesMethod some sdg:StatisticalMethod, sdg:demonstratesCompetency some sdg:Competency, sdg:fulfillsRole exactly 1 sdg:ProfessionalRole, sdg:involvesCollaborator some sdg:ProfessionalRole

Class: sdg:StatisticalMethod
    Annotations: rdfs:label "Statistical Method", iao:0000115 "A specific tool, technique, or reasoning framework used for designing studies, analyzing data, quantifying evidence, and making decisions in biostatistics."
    SubClassOf: cco:ont00000995, sdg:methodID some xsd:string, sdg:methodName some sdg:MethodNameKind, sdg:methodCategory some sdg:MethodCategoryKind, sdg:complexityLevel some xsd:string, sdg:isStandardized some xsd:boolean, sdg:taughtInConcentration some sdg:Concentration, sdg:appliedInActivity some sdg:ResearchActivity, sdg:developedByRole some sdg:ProfessionalRole

Class: sdg:QuantumComputer
    Annotations: rdfs:label "Quantum Computer", iao:0000115 "A physical device that exploits quantum phenomena such as superposition and entanglement to perform computations."
    SubClassOf: cco:ont00000995, sdg:qubitCount some xsd:integer, sdg:errorRate some xsd:decimal, sdg:faultTolerance some xsd:boolean, sdg:manufacturer some xsd:string, sdg:modelName some xsd:string, sdg:operationalStatus some sdg:OperationalStatusKind, sdg:usesQubitType exactly 1 sdg:Qubit, sdg:threatensCryptosystem some sdg:Cryptosystem

Class: sdg:Qubit
    Annotations: rdfs:label "Quantum Bit", iao:0000115 "The fundamental unit of quantum information that exists in a vector space allowing superposition of states."
    SubClassOf: bfo:0000015, sdg:stateVector some xsd:string, sdg:superpositionEnabled some xsd:boolean, sdg:entangledWith some xsd:string, sdg:constitutes min 2 sdg:QuantumComputer

Class: sdg:Cryptosystem
    Annotations: rdfs:label "Cryptosystem", iao:0000115 "A system for secure communication that includes the protocols, algorithms, and keys used to encrypt and decrypt data."
    SubClassOf: cco:ont00000995, sdg:algorithmType some sdg:AlgorithmTypeKind, sdg:securityBasis some sdg:SecurityBasisKind, sdg:keyLength some xsd:integer, sdg:vulnerabilityStatus some sdg:VulnerabilityStatusKind, sdg:reliesOnMathProblem exactly 1 sdg:MathematicalProblem, sdg:implementedIn some sdg:CyberSecurityProtocol

Class: sdg:MathematicalProblem
    Annotations: rdfs:label "Mathematical Problem", iao:0000115 "A computational problem such as integer factorization or discrete logarithm that serves as the hardness assumption for cryptographic security."
    SubClassOf: bfo:0000015, sdg:problemName some xsd:string, sdg:classicalComplexity some xsd:string, sdg:quantumComplexity some xsd:string, sdg:solvedBy some sdg:QuantumComputer

Class: sdg:CyberSecurityProtocol
    Annotations: rdfs:label "Cyber Security Protocol", iao:0000115 "A procedure or standard for securing communications, such as Quantum Key Distribution (QKD), that ensures data confidentiality and integrity."
    SubClassOf: bfo:0000015, sdg:protocolName some xsd:string, sdg:transmissionMedium some xsd:string, sdg:maxDistance some xsd:decimal, sdg:disruptionRisk some sdg:DisruptionRiskKind, sdg:usesQKD max 1 sdg:QuantumKeyDistribution

Class: sdg:QuantumKeyDistribution
    Annotations: rdfs:label "Quantum Key Distribution", iao:0000115 "A method of secure communication that uses quantum mechanical properties to allow two parties to produce a shared random secret key."
    SubClassOf: bfo:0000015, sdg:photonPolarizationStates some xsd:integer, sdg:detectorType some xsd:string, sdg:eavesdroppingDetection some xsd:boolean, sdg:implementedBy exactly 1 sdg:CyberSecurityProtocol, sdg:transmitsDataTo exactly 1 sdg:Receiver

Class: sdg:Receiver
    Annotations: rdfs:label "Receiver", iao:0000115 "A physical device or endpoint that receives quantum signals, such as polarized photons, and translates them into classical bits."
    SubClassOf: cco:ont00000995, sdg:deviceID some xsd:string, sdg:location some xsd:string, sdg:detectorSensitivity some xsd:decimal, sdg:receiverIdentifier some xsd:string, sdg:receiverType some xsd:string, sdg:inputImpedance some xsd:decimal, sdg:sensitivity some xsd:decimal, sdg:status some sdg:StatusKind, sdg:receivesFrom exactly 1 sdg:QuantumKeyDistribution, sdg:connectedToPort exactly 1 sdg:RFPort, sdg:receivesFrom some sdg:Antenna

Class: sdg:DivinePerson
    Annotations: rdfs:label "Divine Person", iao:0000115 "A distinct person within the Trinity (Father, Son, Holy Spirit) possessing divine attributes and roles in creation and redemption."
    SubClassOf: sdg:TheologicalConcept, sdg:hasName some xsd:string, sdg:hasRoleDetail some sdg:HasRoleKind, sdg:hasNature some xsd:string, sdg:hasPosition some xsd:string, sdg:participatesIn some sdg:DivineAct, sdg:isSubjectOf some sdg:TheologicalProposition

Class: sdg:DivineAct
    Annotations: rdfs:label "Divine Act", iao:0000115 "A specific action or event performed by the Divine Persons, such as creation, incarnation, atonement, or resurrection."
    SubClassOf: bfo:0000015, sdg:hasActType some sdg:HasActTypeKind, sdg:hasTemporalPhase some xsd:string, sdg:hasLocationDetail some xsd:string, sdg:hasOutcomeDetail some xsd:string, sdg:performedBy exactly 1 sdg:DivinePerson, sdg:affects some sdg:Humanity, sdg:enables exactly 1 sdg:Salvation

Class: sdg:Humanity
    Annotations: rdfs:label "Humanity", iao:0000115 "The collective human race, created in the image of God, subject to sin, and the object of divine redemption."
    SubClassOf: bfo:0000040, sdg:hasImageStatus some xsd:boolean, sdg:hasSinCondition some xsd:boolean, sdg:hasReconciliationStatus some xsd:string, sdg:hasEternalDestiny some xsd:string, sdg:humanityId some xsd:string, sdg:lineage some xsd:string, sdg:isGodly some xsd:boolean, sdg:isUngodly some xsd:boolean, sdg:isCovenantPeople some xsd:boolean, sdg:createdBy exactly 1 sdg:DivinePerson, sdg:affectedBy some sdg:DivineAct, sdg:participatesIn__escalated some sdg:Church, sdg:entersInto some sdg:Covenant, sdg:isSubjectTo some sdg:TheologicalClaim, sdg:intermarriesWith some sdg:Humanity

Class: sdg:Salvation
    Annotations: rdfs:label "Salvation", iao:0000115 "The process of reconciliation with God through faith, involving regeneration by the Spirit and justification by Christ's work."
    SubClassOf: bfo:0000015, sdg:hasSource some xsd:string, sdg:hasMechanism some xsd:string, sdg:hasRecipient some sdg:HasRecipientKind, sdg:hasResultDetail some xsd:string, sdg:causedBy exactly 1 sdg:DivineAct, sdg:receivedBy some sdg:Humanity, sdg:mediatedBy exactly 1 sdg:DivinePerson

Class: sdg:Church
    Annotations: rdfs:label "Church", iao:0000115 "The spiritual unity of believers, comprising the one body of Christ, responsible for fulfilling the Great Commission."
    SubClassOf: sdg:TheologicalConcept, sdg:hasRoleDetail some sdg:HasRoleKind, sdg:hasMission some xsd:string, sdg:hasUnityType some xsd:string, sdg:hasResponsibility some xsd:string, sdg:missionFocus some xsd:string, sdg:composedOf some sdg:Humanity, sdg:ledBy exactly 1 sdg:DivinePerson, sdg:executes some sdg:DivineAct

Class: sdg:TheologicalProposition
    Annotations: rdfs:label "Theological Proposition", iao:0000115 "A core belief or doctrinal statement regarding the nature of God, humanity, and salvation."
    SubClassOf: bfo:0000030, sdg:hasPropositionType some xsd:string, sdg:hasAuthority some xsd:string, sdg:hasTruthValue some xsd:boolean, sdg:hasScope some xsd:string, sdg:describes some sdg:DivinePerson, sdg:describes some sdg:Humanity, sdg:supports some sdg:Salvation

Class: sdg:CampusBuilding
    Annotations: rdfs:label "Campus Building", iao:0000115 "A physical structure on the William & Mary campus used for academic, residential, or administrative purposes."
    SubClassOf: bfo:0000040, sdg:buildingId some xsd:string, sdg:buildingName some xsd:string, sdg:yearBuilt some xsd:integer, sdg:buildingType some xsd:string, sdg:hasFiberOpticCable some xsd:boolean, sdg:numberOfFloors some xsd:integer, sdg:housesDepartment some sdg:AcademicDepartment, sdg:locatedInCampusArea exactly 1 sdg:CampusArea

Class: sdg:CampusEvent
    Annotations: rdfs:label "Campus Event", iao:0000115 "A scheduled activity or gathering occurring on the campus, such as a ball, screening, or philanthropy event."
    SubClassOf: sdg:Event, sdg:eventId some xsd:string, sdg:eventName some xsd:string, sdg:eventDate some xsd:dateTime, sdg:eventLocation some xsd:string, sdg:isAnnual some xsd:boolean, sdg:charityBeneficiary some xsd:string, sdg:heldAtLocation exactly 1 sdg:CampusArea, sdg:organizedBy some sdg:StudentOrganization, sdg:benefitsCharity max 1 sdg:Charity

Class: sdg:StudentOrganization
    Annotations: rdfs:label "Student Organization", iao:0000115 "A group of students organized for social, academic, or philanthropic purposes."
    SubClassOf: sdg:Organization, sdg:orgId some xsd:string, sdg:orgName some xsd:string, sdg:orgType some sdg:OrgTypeKind, sdg:isPhilanthropic some xsd:boolean, sdg:foundingYear some xsd:integer, sdg:organizesEvent some sdg:CampusEvent, sdg:hasMember some sdg:Student, sdg:affiliatedWithDepartment max 1 sdg:AcademicDepartment
    HasKey: sdg:orgId

Class: sdg:CampusArea
    Annotations: rdfs:label "Campus Area", iao:0000115 "A designated physical space on the campus, such as a garden, quad, or parking lot."
    SubClassOf: bfo:0000040, sdg:areaId some xsd:string, sdg:areaName some xsd:string, sdg:areaType some xsd:string, sdg:isWirelessEnabled some xsd:boolean, sdg:areaDescription some xsd:string, sdg:surroundedByBuilding some sdg:CampusBuilding, sdg:containsStatue some sdg:Statue, sdg:adjacentToArea some sdg:CampusArea

Class: sdg:Statue
    Annotations: rdfs:label "Statue", iao:0000115 "A sculptural representation of a person or entity located on the campus grounds."
    SubClassOf: bfo:0000040, sdg:statueId some xsd:string, sdg:statueName some xsd:string, sdg:dedicatedPerson some xsd:string, sdg:giftFrom some xsd:string, sdg:dedicationYear some xsd:integer, sdg:isDecoratedByStudents some xsd:boolean, sdg:locatedInArea exactly 1 sdg:CampusArea, sdg:commemoratesPerson exactly 1 sdg:HistoricalFigure

Class: sdg:HistoricalFigure
    Annotations: rdfs:label "Historical Figure", iao:0000115 "A notable person from history who has a connection to the institution or location."
    SubClassOf: bfo:0000002, sdg:figureId some xsd:string, sdg:fullName some xsd:string, sdg:birthYear some xsd:integer, sdg:deathYear some xsd:integer, sdg:foundedInstitution some xsd:string, sdg:enrollmentDate some xsd:date, sdg:commemoratedByStatue some sdg:Statue, sdg:alumnusOf max 1 sdg:Institution

Class: sdg:Charity
    Annotations: rdfs:label "Charity", iao:0000115 "An organization dedicated to providing aid and support to specific groups in need."
    SubClassOf: bfo:0000040, sdg:charityId some xsd:string, sdg:charityName some xsd:string, sdg:targetBeneficiaries some xsd:string, sdg:location some xsd:string, sdg:isLocal some xsd:boolean, sdg:benefitsFromEvent some sdg:CampusEvent, sdg:receivesDonation some sdg:StudentOrganization
    HasKey: sdg:charityId

Class: sdg:PersonnelRole
    Annotations: rdfs:label "Personnel Role", iao:0000115 "A role assumed by an individual within the organization, such as employee, volunteer, or contractor."
    SubClassOf: bfo:0000023, sdg:roleType some sdg:RoleTypeKind, sdg:department some xsd:string, sdg:clearanceLevel some xsd:string, sdg:startDate some xsd:dateTime, sdg:endDate some xsd:dateTime, sdg:isActive some xsd:boolean, sdg:holdsRole exactly 1 sdg:PersonnelRole, sdg:authorizedBy some sdg:PolicyDocument, sdg:subjectTo some sdg:PolicyDocument

Class: sdg:SocialMediaPost
    Annotations: rdfs:label "Social Media Post", iao:0000115 "A piece of content published on a social media platform, including text, images, or videos."
    SubClassOf: cco:ont00000995, sdg:postId some xsd:string, sdg:content some xsd:string, sdg:postDate some xsd:dateTime, sdg:postType some xsd:string, sdg:isOfficial some xsd:boolean, sdg:isMonitored some xsd:boolean, sdg:isSubjectToDisclosure some xsd:boolean, sdg:publishedOn exactly 1 sdg:SocialMediaPlatform, sdg:authoredBy some sdg:PersonnelRole, sdg:relatedTo some sdg:PolicyDocument
    HasKey: sdg:postId

Class: sdg:ExaminationPaper
    Annotations: rdfs:label "Examination Paper", iao:0000115 "A structured set of assessment items administered to candidates to evaluate their proficiency in a subject."
    SubClassOf: bfo:0000015, sdg:paperId some xsd:string, sdg:subjectCode some xsd:string, sdg:classLevel some xsd:string, sdg:academicSession some xsd:string, sdg:maxTimeMinutes some xsd:integer, sdg:totalMarks some xsd:integer, sdg:totalQuestions some xsd:integer, sdg:requiredAnswers some xsd:integer, sdg:publicationDate some xsd:date, sdg:containsItem min 2 sdg:AssessmentItem, sdg:assessesSubject exactly 1 sdg:Subject

Class: sdg:SourceMaterial
    Annotations: rdfs:label "Source Material", iao:0000115 "A published educational resource, such as a textbook or handbook, from which assessment content is derived."
    SubClassOf: sdg:Book, sdg:materialId some xsd:string, sdg:title some xsd:string, sdg:publisher some xsd:string, sdg:edition some xsd:string, sdg:isbn some xsd:string, sdg:publicationYear some xsd:integer, sdg:format some sdg:FormatKind, sdg:materialType some sdg:MaterialTypeKind, sdg:unitNumber some xsd:integer, sdg:chapterNumber some xsd:integer, sdg:pageReference some xsd:integer, sdg:containsPage min 2 sdg:SourcePage, sdg:containsContentFor some sdg:AssessmentItem

Class: sdg:SourcePage
    Annotations: rdfs:label "Source Page", iao:0000115 "A specific page within a source material that contains the content relevant to an assessment item."
    SubClassOf: cco:ont00000995, sdg:pageId some xsd:string, sdg:pageNumber some xsd:integer, sdg:unitNumber some xsd:integer, sdg:chapterNumber some xsd:integer, sdg:contentSnippet some xsd:string, sdg:partOf__escalated exactly 1 sdg:SourceMaterial, sdg:citesConcept some sdg:Concept

Class: sdg:Concept
    Annotations: rdfs:label "Concept", iao:0000115 "A specific topic, skill, or knowledge domain taught in the curriculum and assessed in the examination."
    SubClassOf: bfo:0000015, sdg:conceptId some xsd:string, sdg:name some sdg:NameKind, sdg:category some sdg:CategoryKind, sdg:difficultyLevel some sdg:DifficultyLevelKind, sdg:description some xsd:string, sdg:conceptName some xsd:string, sdg:isIncoherent some xsd:boolean, sdg:isConstructible some xsd:boolean, sdg:domain some sdg:DomainKind, sdg:domainCategory some xsd:string, sdg:definitionText some xsd:string, sdg:complexityLevel some xsd:string, sdg:taughtIn some sdg:CurriculumUnit, sdg:testedBy some sdg:AssessmentItem, sdg:contains some sdg:Concept, sdg:isConstructedFrom min 2 sdg:Concept, sdg:partOfCurriculum some sdg:SourceMaterial

Class: sdg:CurriculumUnit
    Annotations: rdfs:label "Curriculum Unit", iao:0000115 "A distinct module or section of the educational syllabus covering a specific set of concepts."
    SubClassOf: sdg:EducationalEntity, sdg:unitId some xsd:string, sdg:title some xsd:string, sdg:unitNumber some xsd:integer, sdg:durationHours some xsd:decimal, sdg:learningOutcomes some xsd:string, sdg:containsConcept min 2 sdg:Concept, sdg:partOfSubject exactly 1 sdg:Subject

Class: sdg:Subject
    Annotations: rdfs:label "Subject", iao:0000115 "An academic discipline or field of study for which the examination is conducted."
    SubClassOf: bfo:0000015, sdg:subjectCode some xsd:string, sdg:name some sdg:NameKind, sdg:classLevel some xsd:string, sdg:department some xsd:string, sdg:credits some xsd:integer, sdg:languageCode some xsd:string, sdg:hasUnit min 2 sdg:CurriculumUnit, sdg:assessedBy some sdg:ExaminationPaper, sdg:uses some sdg:Textbook, sdg:uses some sdg:ExerciseBook

Class: sdg:Canape
    Annotations: rdfs:label "Canapé", iao:0000115 "A small, prepared piece of food, typically served on a bread or cracker base, intended for a single bite."
    SubClassOf: cco:ont00000995, sdg:canapeId some xsd:string, sdg:name some sdg:NameKind, sdg:price some xsd:decimal, sdg:category some sdg:CategoryKind, sdg:dietaryClassification some sdg:DietaryClassificationKind, sdg:recommendedCountPerPerson some xsd:integer, sdg:unitPrice some xsd:decimal, sdg:dietaryCategory some xsd:string, sdg:description some xsd:string, sdg:servingSize some xsd:string, sdg:servedIn some sdg:BreadBase, sdg:containsIngredient min 3 sdg:FoodIngredient, sdg:measuredBy exactly 1 sdg:PricingScheme, sdg:servedIn exactly 1 sdg:CanapeCategory, sdg:containsIngredient min 2 sdg:Ingredient

Class: sdg:BreadBase
    Annotations: rdfs:label "Bread Base", iao:0000115 "The foundational edible component, such as bread, cracker, or pastry, upon which a canapé or appetizer is assembled."
    SubClassOf: cco:ont00000995, sdg:baseId some xsd:string, sdg:name some sdg:NameKind, sdg:type some sdg:TypeKind, sdg:supportsCanape some sdg:Canape

Class: sdg:TastingBowl
    Annotations: rdfs:label "Tasting Bowl", iao:0000115 "A portioned serving of food presented in a bowl, typically consisting of multiple ingredients and intended for sharing or sampling."
    SubClassOf: cco:ont00000995, sdg:bowlId some xsd:string, sdg:name some sdg:NameKind, sdg:price some xsd:decimal, sdg:category some sdg:CategoryKind, sdg:dietaryClassification some sdg:DietaryClassificationKind, sdg:recommendedCountPerPerson some xsd:integer, sdg:containsIngredient min 3 sdg:FoodIngredient, sdg:measuredBy exactly 1 sdg:PricingScheme
    HasKey: sdg:bowlId

Class: sdg:PricingScheme
    Annotations: rdfs:label "Pricing Scheme", iao:0000115 "A structured set of rules and values defining the cost associated with specific food items or categories."
    SubClassOf: cco:ont00000958, sdg:schemeId some xsd:string, sdg:pricePoint some xsd:decimal, sdg:currency some xsd:string, sdg:validFrom some xsd:date, sdg:appliesToCanape some sdg:Canape, sdg:appliesToBowl some sdg:TastingBowl

Class: sdg:GenomicSample
    Annotations: rdfs:label "Genomic Sample", iao:0000115 "A physical biological specimen collected from an individual for genomic and phenotypic analysis."
    SubClassOf: cco:ont00000995, sdg:sampleId some xsd:string, sdg:collectionDate some xsd:dateTime, sdg:tissueType some sdg:TissueTypeKind, sdg:sequencingCoverage some xsd:decimal, sdg:sampleStatus some xsd:string, sdg:qualityScore some xsd:decimal, sdg:storageLocation some xsd:string, sdg:analyzedBy some sdg:SequencingAssay, sdg:derivedFrom exactly 1 sdg:Individual, sdg:linkedTo exactly 1 sdg:Individual
    HasKey: sdg:sampleId

Class: sdg:SequencingAssay
    Annotations: rdfs:label "Sequencing Assay", iao:0000115 "A laboratory process or activity that determines the nucleotide sequence of a genomic sample."
    SubClassOf: bfo:0000015, sdg:assayId some xsd:string, sdg:assayType some xsd:string, sdg:coverageDepth some xsd:integer, sdg:platform some sdg:PlatformKind, sdg:resultStatus some sdg:ResultStatusKind, sdg:startDate some xsd:dateTime, sdg:endDate some xsd:dateTime, sdg:processes exactly 1 sdg:GenomicSample, sdg:produces exactly 1 sdg:GenomicDataset, sdg:performedOn exactly 1 sdg:GenomicSample

Class: sdg:GenomicDataset
    Annotations: rdfs:label "Genomic Dataset", iao:0000115 "A structured collection of digital data representing the sequenced genetic information of a sample."
    SubClassOf: cco:ont00000958, sdg:datasetId some xsd:string, sdg:format some sdg:FormatKind, sdg:sizeGB some xsd:decimal, sdg:uploadDate some xsd:dateTime, sdg:accessLevel some sdg:AccessLevelKind, sdg:creationDate some xsd:dateTime, sdg:sizeInGB some xsd:decimal, sdg:checksum some xsd:string, sdg:derivedFrom exactly 1 sdg:SequencingAssay, sdg:storedIn exactly 1 sdg:DataRepository

Class: sdg:HealthRecord
    Annotations: rdfs:label "Health Record", iao:0000115 "A curated digital document containing an individual's clinical, phenotypic, and behavioral health information."
    SubClassOf: sdg:Record, sdg:recordId some xsd:string, sdg:lastUpdated some xsd:dateTime, sdg:completenessScore some xsd:decimal, sdg:recordType some xsd:string, sdg:privacyLevel some xsd:string, sdg:contentDomain some xsd:string, sdg:compilationDate some xsd:dateTime, sdg:riskScore some xsd:decimal, sdg:diagnosisCodes some xsd:string, sdg:medicationList some xsd:string, sdg:lastReviewDate some xsd:date, sdg:belongsTo exactly 1 sdg:Individual, sdg:supplements some sdg:GenomicDataset, sdg:accessedBy some sdg:Researcher, sdg:belongsToOne exactly 1 sdg:Individual, sdg:includes some sdg:GenomicDataset

Class: sdg:ClinicalProgram
    Annotations: rdfs:label "Clinical Program", iao:0000115 "A structured research or service initiative designed to investigate health outcomes or deliver genomic insights."
    SubClassOf: sdg:Program, sdg:programId some xsd:string, sdg:startDate some xsd:dateTime, sdg:endDate some xsd:dateTime, sdg:programType some sdg:ProgramTypeKind, sdg:targetDisease some xsd:string, sdg:enrolls min 2 sdg:Individual, sdg:utilizes some sdg:GenomicDataset, sdg:fundedBy some sdg:PartnerOrganization

Class: sdg:AdoptedPerson
    Annotations: rdfs:label "Adopted Person", iao:0000115 "A justified person who has been legally and spiritually adopted into the family of God, receiving the status and privileges of a child of God."
    SubClassOf: sdg:TheologicalConcept, sdg:personId some xsd:string, sdg:justificationDate some xsd:dateTime, sdg:adoptionStatus some sdg:AdoptionStatusKind, sdg:spiritualName some xsd:string, sdg:inheritanceStatus some sdg:InheritanceStatusKind, sdg:redemptionDay some xsd:dateTime, sdg:receivesSpiritOf exactly 1 sdg:AdoptionSpirit, sdg:enjoysPrivilegeOf min 2 sdg:DivinePrivilege, sdg:sealedBy exactly 1 sdg:AdoptionSeal

Class: sdg:AdoptionSpirit
    Annotations: rdfs:label "Spirit of Adoption", iao:0000115 "The Holy Spirit given to adopted persons, enabling them to know God as Father and bear His image."
    SubClassOf: sdg:TheologicalConcept, sdg:spiritId some xsd:string, sdg:bestowalDate some xsd:dateTime, sdg:spiritType some xsd:string, sdg:functionDescription some xsd:string, sdg:adoptionStatus some sdg:AdoptionStatusKind, sdg:guaranteesInheritanceFor min 2 sdg:AdoptedPerson

Class: sdg:DivinePrivilege
    Annotations: rdfs:label "Divine Privilege", iao:0000115 "A specific liberty or benefit granted to adopted persons, such as bold access to God's presence or divine provision."
    SubClassOf: sdg:TheologicalConcept, sdg:privilegeId some xsd:string, sdg:privilegeType some xsd:string, sdg:scripturalReference some xsd:string, sdg:beneficiaryCount some xsd:integer, sdg:benefitType some sdg:BenefitTypeKind, sdg:enjoyedBy min 2 sdg:AdoptedPerson, sdg:grantedBy exactly 1 sdg:DivineFather
    HasKey: sdg:privilegeId

Class: sdg:DivineFather
    Annotations: rdfs:label "Divine Father", iao:0000115 "God as the adoptive parent who numbers persons as children, bestows His name, and provides for their needs."
    SubClassOf: sdg:TheologicalConcept, sdg:fatherId some xsd:string, sdg:divineName some xsd:string, sdg:relationshipType some sdg:RelationshipTypeKind, sdg:covenantStatus some xsd:string, sdg:adopts min 2 sdg:AdoptedPerson, sdg:bestowsNameOn min 2 sdg:AdoptedPerson, sdg:chastens min 2 sdg:AdoptedPerson

Class: sdg:AdoptionSeal
    Annotations: rdfs:label "Adoption Seal", iao:0000115 "The spiritual guarantee or mark placed on adopted persons, signifying their secure status as children of God until the day of redemption."
    SubClassOf: sdg:TheologicalConcept, sdg:sealId some xsd:string, sdg:sealDate some xsd:dateTime, sdg:sealType some sdg:SealTypeKind, sdg:validUntil some xsd:date, sdg:guaranteeType some xsd:string, sdg:marks min 2 sdg:AdoptedPerson, sdg:guarantees exactly 1 sdg:EternalInheritance
    HasKey: sdg:sealId

Class: sdg:EternalInheritance
    Annotations: rdfs:label "Eternal Inheritance", iao:0000115 "The everlasting salvation and promises received by adopted persons upon the completion of their adoption."
    SubClassOf: sdg:TheologicalConcept, sdg:inheritanceId some xsd:string, sdg:inheritanceType some xsd:string, sdg:distributionDate some xsd:dateTime, sdg:valueDescription some xsd:string, sdg:receivedBy min 2 sdg:AdoptedPerson, sdg:guaranteedBy exactly 1 sdg:AdoptionSeal
    HasKey: sdg:inheritanceId

Class: sdg:FarmlandParcel
    Annotations: rdfs:label "Farmland Parcel", iao:0000115 "A specific tract of agricultural land identified by its geographic boundaries and ownership status."
    SubClassOf: bfo:0000040, sdg:parcelId some xsd:string, sdg:acreage some xsd:decimal, sdg:zoningDistrict some sdg:ZoningDistrictKind, sdg:soilQualityIndex some xsd:decimal, sdg:purchaseDate some xsd:date, sdg:currentMarketValue some xsd:decimal, sdg:heldBy some sdg:InstitutionalInvestor, sdg:locatedIn exactly 1 sdg:GeographicRegion

Class: sdg:InstitutionalInvestor
    Annotations: rdfs:label "Institutional Investor", iao:0000115 "A financial entity such as a pension fund, hedge fund, or insurance company that acquires farmland as an investment asset."
    SubClassOf: bfo:0000040, sdg:investorId some xsd:string, sdg:investorName some xsd:string, sdg:investorType some sdg:InvestorTypeKind, sdg:totalAgriculturalAssets some xsd:decimal, sdg:headquartersLocation some xsd:string, sdg:registrationDate some xsd:dateTime, sdg:acquires min 2 sdg:FarmlandParcel, sdg:subsidyOf max 1 sdg:ParentCorporation
    HasKey: sdg:investorId

Class: sdg:ParentCorporation
    Annotations: rdfs:label "Parent Corporation", iao:0000115 "The ultimate corporate entity that owns or controls an institutional investor or agricultural investment group."
    SubClassOf: bfo:0000040, sdg:corpId some xsd:string, sdg:corpName some xsd:string, sdg:countryOfOrigin some xsd:string, sdg:industrySector some sdg:IndustrySectorKind, sdg:foundingYear some xsd:integer, sdg:isPubliclyTraded some xsd:boolean, sdg:owns min 2 sdg:InstitutionalInvestor

Class: sdg:AgriculturalLease
    Annotations: rdfs:label "Agricultural Lease", iao:0000115 "A legal agreement granting temporary use rights to farmland in exchange for periodic payments."
    SubClassOf: bfo:0000040, sdg:leaseId some xsd:string, sdg:startDate some xsd:dateTime, sdg:endDate some xsd:dateTime, sdg:annualRent some xsd:decimal, sdg:leaseStatus some xsd:string, sdg:cropType some xsd:string, sdg:covers exactly 1 sdg:FarmlandParcel, sdg:grantedTo exactly 1 sdg:InstitutionalInvestor, sdg:issuedBy exactly 1 sdg:LandOwner
    HasKey: sdg:leaseId

Class: sdg:CancerWaitingTimeTarget
    Annotations: rdfs:label "Cancer Waiting Time Target", iao:0000115 "A regulatory performance target defining the maximum allowable duration for a patient to wait between a clinical milestone and the initiation of cancer treatment."
    SubClassOf: bfo:0000015, sdg:targetIdentifier some xsd:string, sdg:effectiveDate some xsd:date, sdg:tolerancePercentage some xsd:decimal, sdg:targetStatus some sdg:TargetStatusKind, sdg:applicablePatientAgeMinimum some xsd:integer, sdg:targetDuration some xsd:integer, sdg:triggeringClinicalEvent some xsd:string, sdg:implementationDate some xsd:dateTime, sdg:status some sdg:StatusKind, sdg:appliesTo some sdg:CancerType, sdg:monitoredBy some sdg:NHSBoard

Class: sdg:CancerType
    Annotations: rdfs:label "Cancer Type", iao:0000115 "A specific pathological classification of primary cancer used for grouping patient cohorts and monitoring treatment waiting times."
    SubClassOf: cco:ont00000995, sdg:cancerTypeName some xsd:string, sdg:icd10Code some xsd:string, sdg:isPrimaryCancer some xsd:boolean, sdg:cancerName some xsd:string, sdg:anatomicalRegion some xsd:string, sdg:isPrimary some xsd:boolean, sdg:clinicalCode some xsd:string, sdg:monitoredUnder some sdg:CancerWaitingTimeTarget

Class: sdg:NHSBoard
    Annotations: rdfs:label "NHS Board", iao:0000115 "A regional health service delivery organization responsible for administering healthcare resources and reporting performance statistics within a specific geographic area."
    SubClassOf: bfo:0000040, sdg:boardName some xsd:string, sdg:isMainland some xsd:boolean, sdg:regionCode some xsd:string, sdg:isIslandBoard some xsd:boolean, sdg:region some sdg:RegionKind, sdg:reportingStatus some xsd:string, sdg:reportsPerformanceFor some sdg:CancerWaitingTimeTarget, sdg:serves some sdg:Patient, sdg:monitors some sdg:CancerWaitingTimeTarget, sdg:reports min 2 sdg:WaitingTimeStatistic

Class: sdg:PatientCohort
    Annotations: rdfs:label "Patient Cohort", iao:0000115 "A defined aggregate of adult patients newly diagnosed with a specific primary cancer type, tracked for statistical analysis of waiting time performance."
    SubClassOf: bfo:0000040, sdg:cohortIdentifier some xsd:string, sdg:diagnosisDateRangeStart some xsd:date, sdg:diagnosisDateRangeEnd some xsd:date, sdg:totalEligiblePatients some xsd:integer, sdg:patientsTreatedWithinTarget some xsd:integer, sdg:compliancePercentage some xsd:decimal, sdg:ageThreshold some xsd:integer, sdg:diagnosisDate some xsd:date, sdg:referralRoute some xsd:string, sdg:cohortSize some xsd:integer, sdg:groupedBy exactly 1 sdg:CancerType, sdg:trackedBy exactly 1 sdg:NHSBoard, sdg:evaluatedAgainst exactly 1 sdg:CancerWaitingTimeTarget, sdg:belongsTo some sdg:CancerType, sdg:monitoredBy exactly 1 sdg:NHSBoard

Class: sdg:StatisticalReport
    Annotations: rdfs:label "Statistical Report", iao:0000115 "A formal quarterly publication documenting the performance of NHS Boards against cancer waiting time targets, including compliance percentages and key findings."
    SubClassOf: cco:ont00000958, sdg:reportTitle some xsd:string, sdg:publicationDate some xsd:date, sdg:reportingPeriodStart some xsd:date, sdg:reportingPeriodEnd some xsd:date, sdg:statisticsClassification some xsd:string, sdg:publisherName some xsd:string, sdg:documents some sdg:PatientCohort, sdg:publishedBy exactly 1 sdg:NHSBoard

Class: sdg:TaperGage
    Annotations: rdfs:label "Taper Gage", iao:0000115 "A manufactured precision measuring instrument designed to verify the dimensions and taper of mating cylindrical components."
    SubClassOf: cco:ont00000995, sdg:gageType some xsd:string, sdg:toolNumber some xsd:string, sdg:markSize some xsd:string, sdg:largeEndDiameter some xsd:decimal, sdg:smallEndDiameter some xsd:decimal, sdg:taperRate some xsd:decimal, sdg:taperTolerance some xsd:decimal, sdg:includedAngle some xsd:decimal, sdg:status some sdg:StatusKind, sdg:taperPerFoot some xsd:decimal, sdg:taperPerInch some xsd:decimal, sdg:measuredBy exactly 1 sdg:DimensionalSpecification, sdg:hasSpecification exactly 1 sdg:ToleranceRequirement, sdg:hasSpecification exactly 1 sdg:GageSpecification, sdg:manufacturedBy exactly 1 sdg:Manufacturer, sdg:requestedBy exactly 1 sdg:Requestor

Class: sdg:DimensionalSpecification
    Annotations: rdfs:label "Dimensional Specification", iao:0000115 "A formal record of the geometric parameters defining a specific gage, including diameters, angles, and taper rates."
    SubClassOf: cco:ont00000958, sdg:largeEndDiameter some xsd:decimal, sdg:smallEndDiameter some xsd:decimal, sdg:taperRatePerFoot some xsd:decimal, sdg:taperRatePerInch some xsd:decimal, sdg:halfAngle some xsd:decimal, sdg:includedAngle some xsd:decimal, sdg:defines exactly 1 sdg:TaperGage

Class: sdg:ToleranceRequirement
    Annotations: rdfs:label "Tolerance Requirement", iao:0000115 "A constraint specification defining the allowable manufacturing deviations for the gage's critical dimensions."
    SubClassOf: cco:ont00000958, sdg:largeEndTolerance some xsd:decimal, sdg:taperTolerancePerInch some xsd:decimal, sdg:referenceStandard some xsd:string, sdg:appliesTo exactly 1 sdg:TaperGage

Class: sdg:GageStep
    Annotations: rdfs:label "Gage Step", iao:0000115 "A physical geometric feature, such as a shoulder or step, located at either the large or small end of a taper gage."
    SubClassOf: bfo:0000040, sdg:location some xsd:string, sdg:isPresent some xsd:boolean, sdg:partOf max 1 sdg:TaperGage

Class: sdg:CollegeResource
    Annotations: rdfs:label "College Resource", iao:0000115 "Assets, property, rights, or records owned, managed, or controlled by the College."
    SubClassOf: cco:ont00000995, sdg:resourceId some xsd:string, sdg:resourceType some sdg:ResourceTypeKind, sdg:description some xsd:string, sdg:value some xsd:decimal, sdg:owner some xsd:string, sdg:misusedIn some sdg:ImproperConduct

Class: sdg:MobileWorker
    Annotations: rdfs:label "Mobile Worker", iao:0000115 "A human employee who requires remote access to corporate network resources from various locations and devices."
    SubClassOf: bfo:0000040, sdg:workerId some xsd:string, sdg:employeeName some xsd:string, sdg:department some xsd:string, sdg:roleDetail some sdg:RoleKind, sdg:deviceType some sdg:DeviceTypeKind, sdg:osPlatform some xsd:string, sdg:authenticationRealm some xsd:string, sdg:lastLoginTimestamp some xsd:dateTime, sdg:authenticatedVia exactly 1 sdg:AuthenticationServer, sdg:assignedRole exactly 1 sdg:UserRole, sdg:connectsTo some sdg:VPNGateway

Class: sdg:VPNGateway
    Annotations: rdfs:label "VPN Gateway", iao:0000115 "A network-based infrastructure node that terminates remote VPN connections and routes traffic to the corporate network."
    SubClassOf: bfo:0000040, sdg:gatewayId some xsd:string, sdg:location some xsd:string, sdg:region some sdg:RegionKind, sdg:maxConcurrentUsers some xsd:integer, sdg:encryptionProtocol some sdg:EncryptionProtocolKind, sdg:status some sdg:StatusKind, sdg:capacityUtilization some xsd:decimal, sdg:routesTo exactly 1 sdg:CorporateNetwork, sdg:servesUsers min 2 sdg:MobileWorker, sdg:usesEquipment exactly 1 sdg:NetworkEquipment
    HasKey: sdg:gatewayId

Class: sdg:CorporateNetwork
    Annotations: rdfs:label "Corporate Network", iao:0000115 "The internal private network infrastructure containing business-critical applications and data resources."
    SubClassOf: sdg:NetworkEntity, sdg:networkId some xsd:string, sdg:networkName some xsd:string, sdg:ipRange some xsd:string, sdg:securityLevel some sdg:SecurityLevelKind, sdg:lastAuditDate some xsd:date, sdg:hostsResources min 2 sdg:BusinessResource, sdg:connectedVia some sdg:VPNGateway

Class: sdg:BusinessResource
    Annotations: rdfs:label "Business Resource", iao:0000115 "A specific application, file share, or service within the corporate network that mobile workers require access to."
    SubClassOf: bfo:0000040, sdg:resourceId some xsd:string, sdg:resourceName some xsd:string, sdg:resourceType some sdg:ResourceTypeKind, sdg:accessProtocol some sdg:AccessProtocolKind, sdg:isSSOSupported some xsd:boolean, sdg:maxConnections some xsd:integer, sdg:accessibleByRole some sdg:UserRole, sdg:hostedOn exactly 1 sdg:CorporateNetwork

Class: sdg:UserRole
    Annotations: rdfs:label "User Role", iao:0000115 "A defined permission set that determines which corporate resources a mobile worker is authorized to access."
    SubClassOf: bfo:0000023, sdg:roleId some xsd:string, sdg:roleName some xsd:string, sdg:roleDescription some xsd:string, sdg:maxResources some xsd:integer, sdg:grantsAccessTo min 2 sdg:BusinessResource, sdg:assignedToWorker some sdg:MobileWorker

Class: sdg:NetworkEquipment
    Annotations: rdfs:label "Network Equipment", iao:0000115 "Physical hardware appliances that provide the underlying infrastructure for VPN termination and routing."
    SubClassOf: sdg:NetworkEntity, sdg:equipmentId some xsd:string, sdg:manufacturer some xsd:string, sdg:model some xsd:string, sdg:firmwareVersion some xsd:string, sdg:status some sdg:StatusKind, sdg:deploysAt exactly 1 sdg:VPNGateway

Class: sdg:AuthenticationServer
    Annotations: rdfs:label "Authentication Server", iao:0000115 "A directory or identity management system that validates user credentials and enforces access policies."
    SubClassOf: bfo:0000040, sdg:serverId some xsd:string, sdg:serverType some xsd:string, sdg:serverAddress some xsd:string, sdg:isPrimary some xsd:boolean, sdg:validatesWorker some sdg:MobileWorker

Class: sdg:DataRepository
    Annotations: rdfs:label "Data Repository", iao:0000115 "A digital storage system that houses genomic datasets and associated metadata."
    SubClassOf: sdg:DataEntity, sdg:repositoryId some xsd:string, sdg:repositoryName some xsd:string, sdg:location some xsd:string, sdg:capacityTB some xsd:decimal, sdg:lastUpdated some xsd:dateTime, sdg:accessProtocol some sdg:AccessProtocolKind, sdg:hosts min 2 sdg:GenomicDataset

Class: sdg:ClinicalTrial
    Annotations: rdfs:label "Clinical Trial", iao:0000115 "A research study performed on human participants to evaluate medical interventions."
    SubClassOf: bfo:0000015, sdg:trialId some xsd:string, sdg:phase some sdg:PhaseKind, sdg:startDate some xsd:dateTime, sdg:endDate some xsd:dateTime, sdg:status some sdg:StatusKind, sdg:primaryOutcome some xsd:string, sdg:trialIdentifier some xsd:string, sdg:title some xsd:string, sdg:sampleSize some xsd:integer, sdg:enrolls min 3 sdg:Individual, sdg:uses some sdg:GenomicDataset, sdg:hasIntervention min 2 sdg:Intervention, sdg:hasControl max 1 sdg:ControlGroup, sdg:measuredBy min 2 sdg:OutcomeMeasure, sdg:conductedAt min 2 sdg:ClinicalSite

Class: sdg:AnalyticalStatement
    Annotations: rdfs:label "Analytical Statement", iao:0000115 "A statement whose predicate concept is contained within the subject concept, such that its truth is established by conceptual analysis alone without reference to experience."
    SubClassOf: bfo:0000015, sdg:statementText some xsd:string, sdg:subjectConcept some xsd:string, sdg:predicateConcept some xsd:string, sdg:isContradictory some xsd:boolean, sdg:isExplicative some xsd:boolean, sdg:hasSubjectConcept exactly 1 sdg:Concept, sdg:hasPredicateConcept exactly 1 sdg:Concept

Class: sdg:SyntheticAPrioriJudgement
    Annotations: rdfs:label "Synthetic A Priori Judgement", iao:0000115 "A judgement that is ampliative (the predicate adds information not contained in the subject) yet necessary and universal, independent of empirical experience, such as mathematical truths."
    SubClassOf: bfo:0000015, sdg:judgementText some xsd:string, sdg:isNecessary some xsd:boolean, sdg:isUniversal some xsd:boolean, sdg:isAmpliative some xsd:boolean, sdg:requiresIntuition some xsd:boolean, sdg:proofMethod some xsd:string, sdg:hasSubjectConcept exactly 1 sdg:Concept, sdg:hasPredicateConcept exactly 1 sdg:Concept, sdg:constructedFrom min 2 sdg:Concept

Class: sdg:EmpiricalJudgement
    Annotations: rdfs:label "Empirical Judgement", iao:0000115 "A judgement that goes beyond mere conceptual analysis by relying on perception, intuition, or experience, such as observing a specific event."
    SubClassOf: bfo:0000015, sdg:judgementText some xsd:string, sdg:isParticular some xsd:boolean, sdg:isContingent some xsd:boolean, sdg:requiresPerception some xsd:boolean, sdg:observationContext some xsd:string, sdg:hasSubjectConcept exactly 1 sdg:Concept, sdg:hasPredicateConcept exactly 1 sdg:Concept

Class: sdg:Intuition
    Annotations: rdfs:label "Intuition", iao:0000115 "A sensible or perceptual act that amplifies concepts, particularly in mathematics, allowing for the construction of concepts and the justification of synthetic a priori judgements."
    SubClassOf: bfo:0000015, sdg:intuitionType some xsd:string, sdg:isSensible some xsd:boolean, sdg:isPossible some xsd:boolean, sdg:amplifiesConcept some xsd:string, sdg:amplifies exactly 1 sdg:Concept, sdg:justifies exactly 1 sdg:SyntheticAPrioriJudgement

Class: sdg:MathematicalStatement
    Annotations: rdfs:label "Mathematical Statement", iao:0000115 "A specific type of synthetic a priori judgement involving numerical or geometric concepts that requires construction or intuition for its justification."
    SubClassOf: bfo:0000015, sdg:statementText some xsd:string, sdg:isNecessary some xsd:boolean, sdg:isUniversal some xsd:boolean, sdg:requiresConstruction some xsd:boolean, sdg:proofMethod some xsd:string, sdg:hasSubjectConcept exactly 1 sdg:Concept, sdg:hasPredicateConcept exactly 1 sdg:Concept, sdg:constructedFrom min 2 sdg:Concept

Class: sdg:FixedPriceMenu
    Annotations: rdfs:label "FixedPriceMenu", iao:0000115 "A complete meal offering with a set price per person, comprising multiple courses and items."
    SubClassOf: cco:ont00000958, sdg:menuName some xsd:string, sdg:pricePerPerson some xsd:decimal, sdg:taxIncluded some xsd:boolean, sdg:gratuityIncluded some xsd:boolean, sdg:validFrom some xsd:date, sdg:validUntil some xsd:date, sdg:includesCourse min 2 sdg:Course, sdg:isServedAt exactly 1 sdg:Restaurant

Class: sdg:Restaurant
    Annotations: rdfs:label "Restaurant", iao:0000115 "A commercial establishment where food and beverages are prepared and served to customers."
    SubClassOf: sdg:restaurantName some xsd:string, sdg:address some xsd:string, sdg:phone some xsd:string, sdg:operatingHours some xsd:string, sdg:cuisineType some xsd:string, sdg:restaurantId some xsd:string, sdg:name some sdg:NameKind, sdg:city some xsd:string, sdg:state some xsd:string, sdg:operatingSince some xsd:integer, sdg:corkageFee some xsd:decimal, sdg:hasGrandAward some xsd:boolean, sdg:grandAwardYear some xsd:integer, sdg:servesMenu min 2 sdg:FixedPriceMenu, sdg:hasWineSpectatorGrandAward some sdg:WineAward, sdg:hasChef exactly 1 sdg:Person, sdg:hasOwner some sdg:Person, sdg:hostsWineDinner some sdg:Event

Class: sdg:DiningOccasion
    Annotations: rdfs:label "Dining Occasion", iao:0000115 "A specific temporal context or event type for which a menu is designed, such as a pre-theatre meal, characterized by time constraints and specific offerings."
    SubClassOf: sdg:DiningPackage, sdg:occasionId some xsd:string, sdg:name some sdg:NameKind, sdg:durationMinutes some xsd:integer, sdg:isAvailable some xsd:boolean, sdg:featuresMenu some sdg:PricingTier

Class: sdg:DigitalAsset
    Annotations: rdfs:label "Digital Asset", iao:0000115 "A digital file or media object created or processed by the student, such as a 3D model, animation, or audio track."
    SubClassOf: sdg:assetIdentifier some xsd:string, sdg:assetTitle some xsd:string, sdg:creationDate some xsd:dateTime, sdg:fileFormat some sdg:FileFormatKind, sdg:durationSeconds some xsd:decimal, sdg:frameCount some xsd:integer, sdg:status some sdg:StatusKind, sdg:assetName some xsd:string, sdg:assetType some sdg:AssetTypeKind, sdg:polygonCount some xsd:integer, sdg:isRigged some xsd:boolean, sdg:sourceOrigin some sdg:SourceOriginKind, sdg:assetId some xsd:string, sdg:osType some xsd:string, sdg:criticalityLevel some xsd:string, sdg:lastComplianceCheck some xsd:date, sdg:createdWith some sdg:SoftwareTool, sdg:partOf__escalated some sdg:Project, sdg:exportedTo max 1 sdg:DigitalAsset, sdg:partOfProject exactly 1 sdg:AnimationProject, sdg:hasRigging max 1 sdg:RiggingSystem, sdg:protectedBy some sdg:SecurityPlatform, sdg:hosts some sdg:SecurityEvent, sdg:ownedBy exactly 1 sdg:Organization

Class: sdg:ExternalResource
    Annotations: rdfs:label "External Resource", iao:0000115 "An external media file, reference, or asset imported into the project, such as textures, sounds, or pre-rigged models."
    SubClassOf: cco:ont00000995, sdg:resourceId some xsd:string, sdg:resourceTitle some xsd:string, sdg:sourceUrl some xsd:string, sdg:resourceType some sdg:ResourceTypeKind, sdg:license some xsd:string, sdg:referencedBy some sdg:Project, sdg:usedIn some sdg:DigitalAsset

Class: sdg:AnimationSequence
    Annotations: rdfs:label "Animation Sequence", iao:0000115 "A specific motion or movement sequence applied to a character or object within a project timeline."
    SubClassOf: sdg:sequenceId some xsd:string, sdg:sequenceName some xsd:string, sdg:durationSeconds some xsd:decimal, sdg:frameCount some xsd:integer, sdg:animationType some xsd:string, sdg:keyframeCount some xsd:integer, sdg:partOf__escalated some sdg:Project, sdg:appliedTo some sdg:DigitalAsset, sdg:usesRig some sdg:DigitalAsset

Class: sdg:InstructionalResource
    Annotations: rdfs:label "InstructionalResource", iao:0000115 "A digital instructional software resource or application used by students for learning purposes."
    SubClassOf: bfo:0000040, sdg:resourceId some xsd:string, sdg:resourceName some xsd:string, sdg:category some sdg:CategoryKind, sdg:requiresAdditionalLogin some xsd:boolean, sdg:accessMethod some xsd:string, sdg:gradeRange some xsd:string, sdg:isAccessedBy min 2 sdg:Student, sdg:usesAuthentication max 1 sdg:AuthenticationMethod
    HasKey: sdg:resourceId

Class: sdg:AuthenticationMethod
    Annotations: rdfs:label "AuthenticationMethod", iao:0000115 "A method or credential used to authenticate a student's access to an instructional resource."
    SubClassOf: bfo:0000040, sdg:authMethodId some xsd:string, sdg:methodName some sdg:MethodNameKind, sdg:isDefault some xsd:boolean, sdg:requiresAppInstallation some xsd:boolean, sdg:isUsedBy min 2 sdg:Student, sdg:authenticatesAccessTo min 2 sdg:InstructionalResource

Class: sdg:LearningManagementSystem
    Annotations: rdfs:label "LearningManagementSystem", iao:0000115 "A specific type of instructional resource that allows teachers to create and manage assignments for students."
    SubClassOf: bfo:0000040, sdg:lmsId some xsd:string, sdg:lmsName some xsd:string, sdg:supportsAssignmentCreation some xsd:boolean, sdg:accessViaClever some xsd:boolean, sdg:isAccessedBy min 2 sdg:Student, sdg:usesAuthentication max 1 sdg:AuthenticationMethod

Class: sdg:CurriculumResource
    Annotations: rdfs:label "CurriculumResource", iao:0000115 "A digital resource that provides structured curriculum content for students, such as science or reading materials."
    SubClassOf: sdg:EducationalEntity, sdg:curriculumId some xsd:string, sdg:curriculumName some xsd:string, sdg:subjectArea some sdg:SubjectAreaKind, sdg:requiresAdditionalLogin some xsd:boolean, sdg:isAccessedBy min 2 sdg:Student, sdg:usesAuthentication max 1 sdg:AuthenticationMethod

Class: sdg:TestPreparationResource
    Annotations: rdfs:label "TestPreparationResource", iao:0000115 "A digital resource that provides a database of questions to support students in test preparation."
    SubClassOf: bfo:0000040, sdg:testPrepId some xsd:string, sdg:testPrepName some xsd:string, sdg:requiresAppInstallation some xsd:boolean, sdg:isAccessedBy min 2 sdg:Student, sdg:usesAuthentication max 1 sdg:AuthenticationMethod

Class: sdg:InterventionProgram
    Annotations: rdfs:label "InterventionProgram", iao:0000115 "A digital program designed to provide targeted intervention in specific subjects for students."
    SubClassOf: sdg:Program, sdg:interventionId some xsd:string, sdg:interventionName some xsd:string, sdg:subjectArea some sdg:SubjectAreaKind, sdg:gradeRange some xsd:string, sdg:requiresAppInstallation some xsd:boolean, sdg:isAccessedBy min 2 sdg:Student, sdg:usesAuthentication max 1 sdg:AuthenticationMethod
    HasKey: sdg:interventionId

Class: sdg:Journalist
    Annotations: rdfs:label "Journalist", iao:0000115 "A person who engages in the profession of journalism, including reporting, anchoring, and broadcasting news."
    SubClassOf: bfo:0000040, sdg:callsign some xsd:string, sdg:birthDate some xsd:date, sdg:deathDate some xsd:date, sdg:birthPlace some xsd:string, sdg:educationInstitution some xsd:string, sdg:primaryEmployer some xsd:string, sdg:isRetired some xsd:boolean, sdg:employedBy exactly 1 sdg:NewsOrganization, sdg:coveredEvent some sdg:HistoricalEvent

Class: sdg:NewsOrganization
    Annotations: rdfs:label "News Organization", iao:0000115 "An institutional entity that produces and disseminates news content, such as a wire service, television network, or radio station."
    SubClassOf: bfo:0000040, sdg:organizationName some xsd:string, sdg:foundingYear some xsd:integer, sdg:headquartersLocation some xsd:string, sdg:organizationType some sdg:OrganizationTypeKind, sdg:isDefunct some xsd:boolean, sdg:employs min 2 sdg:Journalist, sdg:producedContent some sdg:BroadcastProgram

Class: sdg:BroadcastProgram
    Annotations: rdfs:label "Broadcast Program", iao:0000115 "A specific media production intended for radio or television transmission, including news segments, documentaries, and special reports."
    SubClassOf: bfo:0000040, sdg:programTitle some xsd:string, sdg:broadcastDate some xsd:dateTime, sdg:network some xsd:string, sdg:durationMinutes some xsd:integer, sdg:isDocumentary some xsd:boolean, sdg:directorName some xsd:string, sdg:premiereVenue some xsd:string, sdg:producedBy exactly 1 sdg:NewsOrganization, sdg:featuresJournalist some sdg:Journalist, sdg:aboutSubject some sdg:HistoricalEvent

Class: sdg:HistoricalEvent
    Annotations: rdfs:label "Historical Event", iao:0000115 "A significant occurrence in history that is reported on or documented by journalists and media organizations."
    SubClassOf: sdg:Event, sdg:eventName some xsd:string, sdg:eventDate some xsd:dateTime, sdg:location some xsd:string, sdg:eventCategory some xsd:string, sdg:isVerified some xsd:boolean, sdg:reportedOn min 2 sdg:Journalist, sdg:documentedIn some sdg:BroadcastProgram

Class: sdg:MediaPersonality
    Annotations: rdfs:label "Media Personality", iao:0000115 "A public figure known for their role in broadcasting or journalism, often recognized for their professional demeanor and public trust."
    SubClassOf: bfo:0000040, sdg:fullName some xsd:string, sdg:callsign some xsd:string, sdg:recognitionTitle some xsd:string, sdg:yearsActive some xsd:integer, sdg:isRetired some xsd:boolean, sdg:associatedWith some sdg:NewsOrganization, sdg:coveredEvent some sdg:HistoricalEvent

Class: sdg:SpecialEducationalNeed
    Annotations: rdfs:label "Special Educational Need", iao:0000115 "A diagnosed condition or complex need profile, such as Autism Spectrum Condition, Pathological Demand Avoidance, or Chromosome Disorders, that qualifies a student for placement."
    SubClassOf: bfo:0000040, sdg:needCode some xsd:string, sdg:needName some xsd:string, sdg:severityLevel some sdg:SeverityLevelKind, sdg:isPrimary some xsd:boolean, sdg:requiresSpecializedTherapy some xsd:boolean, sdg:affectsStudent some sdg:Student, sdg:requiresStaffTraining some sdg:StaffTrainingModule
    HasKey: sdg:needCode

Class: sdg:AdmissionApplication
    Annotations: rdfs:label "Admission Application", iao:0000115 "A formal request for placement submitted by a Local Education Authority or other source, subject to the school's admissions protocol."
    SubClassOf: sdg:Document, sdg:applicationId some xsd:string, sdg:submissionDate some xsd:dateTime, sdg:applicationStatus some sdg:ApplicationStatusKind, sdg:fundingAgreementId some xsd:string, sdg:interviewScheduled some xsd:boolean, sdg:oversubscribed some xsd:boolean, sdg:targetAudience some sdg:TargetAudienceKind, sdg:applicationDate some xsd:dateTime, sdg:status some sdg:StatusKind, sdg:academicYear some xsd:string, sdg:referenceNumber some xsd:string, sdg:totalScore some xsd:decimal, sdg:rank some xsd:integer, sdg:interviewDate some xsd:dateTime, sdg:interviewResult some sdg:InterviewResultKind, sdg:forStudent exactly 1 sdg:Student, sdg:evaluatesNeed some sdg:SpecialEducationalNeed, sdg:linkedToEHCP exactly 1 sdg:EducationHealthCarePlan, sdg:triggersRiskAssessment max 1 sdg:HealthSafetyRiskAssessment, sdg:requestsAdmissionFor exactly 1 sdg:Child, sdg:submittedBy min 2 sdg:Guardian, sdg:targetsSchool exactly 1 sdg:School, sdg:submittedBy exactly 1 sdg:Student, sdg:evaluatedBy exactly 1 sdg:AdmissionCommittee, sdg:hasAcademicRecord exactly 1 sdg:AcademicRecord, sdg:hasInterviewScore max 1 sdg:InterviewScore, sdg:hasActivityEvidence min 2 sdg:ActivityEvidence

Class: sdg:StaffTrainingModule
    Annotations: rdfs:label "Staff Training Module", iao:0000115 "A professional development activity provided to staff when a student admission results in an area of special educational needs not previously resourced or where staff skills are inadequate."
    SubClassOf: sdg:EducationalEntity, sdg:moduleId some xsd:string, sdg:moduleName some xsd:string, sdg:deliveryDate some xsd:dateTime, sdg:completionStatus some sdg:CompletionStatusKind, sdg:targetAudience some sdg:TargetAudienceKind, sdg:hoursRequired some xsd:decimal, sdg:requiredForNeed some sdg:SpecialEducationalNeed, sdg:assignedToStaff some sdg:StaffMember, sdg:triggeredByAssessment max 1 sdg:HealthSafetyRiskAssessment
    HasKey: sdg:moduleId

Class: sdg:CateringPackage
    Annotations: rdfs:label "Catering Package", iao:0000115 "A pre-configured food service offering defined by a specific guest count, menu composition, and price point."
    SubClassOf: sdg:DiningPackage, sdg:packageId some xsd:string, sdg:title some xsd:string, sdg:basePrice some xsd:decimal, sdg:epicPrice some xsd:decimal, sdg:servesCount some xsd:integer, sdg:status some sdg:StatusKind, sdg:packageName some xsd:string, sdg:mealPeriod some xsd:string, sdg:basePricePerPerson some xsd:decimal, sdg:isBuffet some xsd:boolean, sdg:includesDessert some xsd:boolean, sdg:includesItem min 2 sdg:MenuFoodItem, sdg:hasOption min 2 sdg:MenuFoodItem, sdg:includesSide max 1 sdg:MenuFoodItem, sdg:includesItem min 2 sdg:FoodBeverageItem, sdg:servedWith some sdg:BeverageSelection, sdg:chargedWith exactly 1 sdg:ServiceCharge

Class: sdg:MenuFoodItem
    Annotations: rdfs:label "Menu Food Item", iao:0000115 "A distinct culinary product or ingredient defined by its name, preparation method, and component ingredients."
    SubClassOf: sdg:DiningPackage, sdg:itemId some xsd:string, sdg:name some sdg:NameKind, sdg:category some sdg:CategoryKind, sdg:unitPrice some xsd:decimal, sdg:portionSize some sdg:PortionSizeKind, sdg:isGlutenFree some xsd:boolean, sdg:isVegetarian some xsd:boolean, sdg:containsIngredient min 2 sdg:Ingredient, sdg:servedWith max 1 sdg:MenuFoodItem

Class: sdg:SocialMediaAccount
    Annotations: rdfs:label "Social Media Account", iao:0000115 "A registered online presence representing a school district entity, subject to public record and policy compliance."
    SubClassOf: cco:ont00000995, sdg:accountIdentifier some xsd:string, sdg:platform some sdg:PlatformKind, sdg:representingEntity some xsd:string, sdg:isOfficial some xsd:boolean, sdg:registrationDate some xsd:dateTime, sdg:status some sdg:StatusKind, sdg:accountId some xsd:string, sdg:platformName some xsd:string, sdg:accountType some sdg:AccountTypeKind, sdg:creationDate some xsd:dateTime, sdg:lastLoginDate some xsd:dateTime, sdg:passwordHash some xsd:string, sdg:platformType some sdg:PlatformTypeKind, sdg:registrationStatus some sdg:RegistrationStatusKind, sdg:lastAuditDate some xsd:date, sdg:hasAdministrator exactly 1 sdg:DistrictEmployee, sdg:representsEntity exactly 1 sdg:SchoolEntity, sdg:storedCredentialsIn exactly 1 sdg:SecureCredentialStore, sdg:managedBy some sdg:StaffMember, sdg:registeredIn some sdg:AccountRegister, sdg:subjectToPolicy exactly 1 sdg:SocialMediaPolicy, sdg:representsEntity exactly 1 sdg:SchoolDistrictEntity, sdg:subjectToPolicy exactly 1 sdg:BoardPolicy

Class: sdg:DistrictEmployee
    Annotations: rdfs:label "District Employee", iao:0000115 "A staff member employed by the school district who is responsible for managing official communications and social media accounts."
    SubClassOf: sdg:employeeId some xsd:string, sdg:fullName some xsd:string, sdg:roleDetail some sdg:RoleKind, sdg:employmentStatus some sdg:EmploymentStatusKind, sdg:contactExtension some xsd:string, sdg:managesAccount some sdg:SocialMediaAccount, sdg:conductsBusinessVia some sdg:ElectronicCommunication, sdg:subjectToPolicy exactly 1 sdg:BoardPolicy

Class: sdg:ElectronicCommunication
    Annotations: rdfs:label "Electronic Communication", iao:0000115 "Any digital message or content created by district employees for official business, constituting a public record."
    SubClassOf: cco:ont00000958, sdg:communicationId some xsd:string, sdg:contentType some sdg:ContentTypeKind, sdg:sentDateTime some xsd:dateTime, sdg:isPublicRecord some xsd:boolean, sdg:platformUsed some xsd:string, sdg:contentStatus some sdg:ContentStatusKind, sdg:createdBy exactly 1 sdg:DistrictEmployee, sdg:conductedOnBehalfOf exactly 1 sdg:SchoolEntity

Class: sdg:SchoolEntity
    Annotations: rdfs:label "School Entity", iao:0000115 "An organizational unit within the district, such as a school, program, or group, represented by social media accounts."
    SubClassOf: sdg:EducationalEntity, sdg:entityId some xsd:string, sdg:entityName some xsd:string, sdg:entityType some sdg:EntityTypeKind, sdg:parentDistrict some xsd:string, sdg:hasRepresentedAccount some sdg:SocialMediaAccount, sdg:hasEmployee some sdg:DistrictEmployee

Class: sdg:SecureCredentialStore
    Annotations: rdfs:label "Secure Credential Store", iao:0000115 "A protected repository for storing login credentials of registered social media accounts, accessible only under specific policy violations."
    SubClassOf: cco:ont00000995, sdg:storeIdentifier some xsd:string, sdg:accessLevel some sdg:AccessLevelKind, sdg:lastAccessed some xsd:dateTime, sdg:isEncrypted some xsd:boolean, sdg:storesCredentialsFor some sdg:SocialMediaAccount

Class: sdg:Estate
    Annotations: rdfs:label "Estate", iao:0000115 "The aggregate of financial assets and liabilities held by an individual or couple at a point in time, subject to distribution upon death."
    SubClassOf: cco:ont00000995, sdg:identifier some xsd:string, sdg:ownerName some xsd:string, sdg:totalValue some xsd:decimal, sdg:currencyCode some xsd:string, sdg:creationDate some xsd:dateTime, sdg:status some sdg:StatusKind, sdg:hasBeneficiaryDesignation some sdg:BeneficiaryDesignation, sdg:hasJointOwnership some sdg:JointOwnership, sdg:governedByWill max 1 sdg:Will

Class: sdg:BeneficiaryDesignation
    Annotations: rdfs:label "Beneficiary Designation", iao:0000115 "A legal instrument specifying a named individual or entity to receive specific proceeds from an account or policy upon the owner's death."
    SubClassOf: sdg:designationId some xsd:string, sdg:accountReference some xsd:string, sdg:namedBeneficiary some xsd:string, sdg:percentageShare some xsd:decimal, sdg:effectiveDate some xsd:date, sdg:revocable some xsd:boolean, sdg:appliesToAccount exactly 1 sdg:InvestmentFundAccount, sdg:designatesPerson some sdg:Person

Class: sdg:JointOwnership
    Annotations: rdfs:label "Joint Ownership", iao:0000115 "A legal arrangement where two or more individuals hold title to an asset with survivorship rights, allowing automatic transfer to the surviving owner upon death."
    SubClassOf: cco:ont00000995, sdg:ownershipId some xsd:string, sdg:assetType some sdg:AssetTypeKind, sdg:survivorshipRight some xsd:boolean, sdg:registrationDate some xsd:dateTime, sdg:jurisdiction some sdg:JurisdictionKind, sdg:ownershipPercentage some xsd:decimal, sdg:coversAsset exactly 1 sdg:InvestmentFundAccount, sdg:involvesOwner min 2 sdg:Person
    HasKey: sdg:ownershipId

Class: sdg:Will
    Annotations: rdfs:label "Will", iao:0000115 "A legal document expressing an individual's wishes regarding the distribution of their estate after death."
    SubClassOf: cco:ont00000958, sdg:willId some xsd:string, sdg:testatorName some xsd:string, sdg:executionDate some xsd:date, sdg:probateFiled some xsd:boolean, sdg:executorName some xsd:string, sdg:lastAmendmentDate some xsd:date, sdg:distributesEstate exactly 1 sdg:Estate, sdg:namesBeneficiary some sdg:Person
    HasKey: sdg:willId

Class: sdg:InvestmentFundAccount
    Annotations: rdfs:label "Investment Fund Account", iao:0000115 "A financial account holding investment assets that generates income and can be structured with specific ownership or beneficiary arrangements."
    SubClassOf: sdg:FinancialEntity, sdg:accountNumber some xsd:string, sdg:fundType some xsd:string, sdg:taxEfficiency some xsd:boolean, sdg:currentBalance some xsd:decimal, sdg:currencyCode some xsd:string, sdg:accountStatus some sdg:AccountStatusKind, sdg:heldByOwner some sdg:Person, sdg:generatesWithdrawal some sdg:SystematicWithdrawal, sdg:linkedToDesignation max 1 sdg:BeneficiaryDesignation, sdg:linkedToJointOwnership max 1 sdg:JointOwnership

Class: sdg:SystematicWithdrawal
    Annotations: rdfs:label "Systematic Withdrawal", iao:0000115 "A recurring financial transaction where a fixed amount is distributed from an investment fund account to a recipient on a scheduled basis."
    SubClassOf: bfo:0000015, sdg:withdrawalId some xsd:string, sdg:frequency some sdg:FrequencyKind, sdg:amount some xsd:decimal, sdg:startDate some xsd:dateTime, sdg:endDate some xsd:dateTime, sdg:taxLiabilityShare some xsd:decimal, sdg:originatesFromAccount exactly 1 sdg:InvestmentFundAccount, sdg:depositedToBankAccount exactly 1 sdg:BankAccount, sdg:sharedWith min 2 sdg:Person

Class: sdg:BankAccount
    Annotations: rdfs:label "Bank Account", iao:0000115 "A financial account held at a banking institution used for depositing funds and facilitating transactions."
    SubClassOf: cco:ont00000995, sdg:accountNumber some xsd:string, sdg:bankName some xsd:string, sdg:accountType some sdg:AccountTypeKind, sdg:currencyCode some xsd:string, sdg:openDate some xsd:date, sdg:status some sdg:StatusKind, sdg:receivesDeposit some sdg:SystematicWithdrawal, sdg:ownedBy exactly 1 sdg:Person

Class: sdg:WorkplaceSurvey
    Annotations: rdfs:label "Workplace Survey", iao:0000115 "A structured employee feedback survey administered by a research firm to assess organizational health and workplace culture."
    SubClassOf: bfo:0000015, sdg:surveyId some xsd:string, sdg:administeredByDetail some xsd:string, sdg:surveyDate some xsd:dateTime, sdg:totalEmployees some xsd:integer, sdg:organizationalHealthScore some xsd:decimal, sdg:alignmentScore some xsd:decimal, sdg:executionScore some xsd:decimal, sdg:connectionScore some xsd:decimal, sdg:status some sdg:StatusKind, sdg:conductedBy exactly 1 sdg:ResearchFirm, sdg:assesses exactly 1 sdg:Organization, sdg:produces some sdg:WorkplaceAward

Class: sdg:ResearchFirm
    Annotations: rdfs:label "Research Firm", iao:0000115 "An organization that specializes in organizational health research, employee feedback surveys, and workplace improvement consulting."
    SubClassOf: bfo:0000015, sdg:firmId some xsd:string, sdg:firmName some xsd:string, sdg:headquartersLocation some xsd:string, sdg:foundingYear some xsd:integer, sdg:bCorpMember some xsd:boolean, sdg:specialization some sdg:SpecializationKind, sdg:consultingServices some xsd:boolean, sdg:administers min 2 sdg:WorkplaceSurvey, sdg:partnersWith min 2 sdg:MediaPartner, sdg:providesConsultingTo some sdg:Organization
    HasKey: sdg:firmId

Class: sdg:WorkplaceAward
    Annotations: rdfs:label "Workplace Award", iao:0000115 "A recognition given to organizations that meet strict standards for organizational health based on employee feedback surveys."
    SubClassOf: bfo:00000995, sdg:awardId some xsd:string, sdg:awardName some xsd:string, sdg:awardYear some xsd:integer, sdg:rank some xsd:integer, sdg:issuingBody some xsd:string, sdg:criteriaMet some xsd:boolean, sdg:awardDescription some xsd:string, sdg:category some sdg:CategoryKind, sdg:issuingOrganizationDetail some xsd:string, sdg:surveyMethodology some xsd:string, sdg:isRepeatWinner some xsd:boolean, sdg:awardedTo exactly 1 sdg:Organization, sdg:basedOn exactly 1 sdg:WorkplaceSurvey, sdg:issuedBy exactly 1 sdg:MediaPartner, sdg:basedOnSurvey exactly 1 sdg:EmployeeFeedbackSurvey
    HasKey: sdg:awardId

Class: sdg:MediaPartner
    Annotations: rdfs:label "Media Partner", iao:0000115 "A media organization that partners with a research firm to conduct and publish workplace awards campaigns."
    SubClassOf: bfo:00000958, sdg:partnerId some xsd:string, sdg:partnerName some xsd:string, sdg:country some sdg:CountryKind, sdg:prestigeLevel some xsd:string, sdg:campaignParticipation some xsd:boolean, sdg:publishes min 2 sdg:WorkplaceAward, sdg:partnersWith exactly 1 sdg:ResearchFirm, sdg:conductsCampaignIn exactly 1 sdg:Country

Class: sdg:ClientSector
    Annotations: rdfs:label "Client Sector", iao:0000115 "A specific industry or public sector category that an organization serves through its services and implementations."
    SubClassOf: bfo:0000015, sdg:sectorId some xsd:string, sdg:sectorName some xsd:string, sdg:sectorType some xsd:string, sdg:serviceLevel some sdg:ServiceLevelKind, sdg:implementationComplexity some xsd:string, sdg:sectorCode some xsd:string, sdg:isPublicSector some xsd:string, sdg:incomeShare some xsd:decimal, sdg:servedBy min 2 sdg:Organization, sdg:receivesServices some sdg:Employee, sdg:purchasesFromSocialEnterprises some sdg:SocialEnterprise

Class: sdg:SpillIncident
    Annotations: rdfs:label "Spill Incident", iao:0000115 "A discrete environmental contamination event involving the release of hazardous materials from a vessel into a marine environment."
    SubClassOf: bfo:0000015, sdg:incidentId some xsd:string, sdg:incidentName some xsd:string, sdg:spillNumber some xsd:string, sdg:incidentDateTime some xsd:dateTime, sdg:incidentStatus some sdg:IncidentStatusKind, sdg:vesselName some xsd:string, sdg:vesselType some xsd:string, sdg:vesselLength some xsd:decimal, sdg:occurredAt exactly 1 sdg:GeographicLocation, sdg:causedBy exactly 1 sdg:Vessel, sdg:released min 2 sdg:HazardousMaterial, sdg:affected some sdg:EcologicalResource, sdg:managedBy some sdg:ResponseAgency

Class: sdg:GeographicLocation
    Annotations: rdfs:label "Geographic Location", iao:0000115 "A specific spatial coordinate or area where a spill incident occurred or where response activities are conducted."
    SubClassOf: sdg:GeographicEntity, sdg:locationId some xsd:string, sdg:latitude some xsd:decimal, sdg:longitude some xsd:decimal, sdg:locationName some xsd:string, sdg:waterDepth some xsd:decimal, sdg:distanceFromShore some xsd:decimal, sdg:locationType some sdg:LocationTypeKind, sdg:countryCode some sdg:CountryCodeKind, sdg:regionType some sdg:RegionTypeKind, sdg:locationIdentifier some xsd:string, sdg:city some xsd:string, sdg:state some xsd:string, sdg:country some sdg:CountryKind, sdg:cityName some xsd:string, sdg:provinceState some xsd:string, sdg:elevation some xsd:decimal, sdg:timezone some xsd:string, sdg:contains some sdg:SpillIncident, sdg:adjacentTo some sdg:EcologicalResource, sdg:hosted some sdg:Researcher, sdg:hosted some sdg:TelephoneInterview, sdg:hosts some sdg:ResearchOrganization, sdg:hosts some sdg:ResearchProject, sdg:hosts min 1 sdg:FlightServiceStation

Class: sdg:HazardousMaterial
    Annotations: rdfs:label "Hazardous Material", iao:0000115 "A specific type of oil, fuel, or chemical substance released during a spill incident."
    SubClassOf: cco:ont00000995, sdg:materialId some xsd:string, sdg:materialType some sdg:MaterialTypeKind, sdg:estimatedQuantity some xsd:decimal, sdg:unitOfMeasure some sdg:UnitOfMeasureKind, sdg:onboardQuantity some xsd:decimal, sdg:spilledQuantity some xsd:decimal, sdg:removedQuantity some xsd:decimal, sdg:releasedFrom exactly 1 sdg:Vessel, sdg:associatedWith exactly 1 sdg:SpillIncident

Class: sdg:Vessel
    Annotations: rdfs:label "Vessel", iao:0000115 "A watercraft involved in a spill incident, including its physical characteristics and operational status."
    SubClassOf: cco:ont00000995, sdg:vesselId some xsd:string, sdg:vesselName some xsd:string, sdg:vesselType some xsd:string, sdg:vesselLength some xsd:decimal, sdg:vesselStatus some sdg:VesselStatusKind, sdg:ownerName some xsd:string, sdg:ownerLocation some xsd:string, sdg:totalConstructiveLoss some xsd:boolean, sdg:involvedIn exactly 1 sdg:SpillIncident, sdg:carried min 2 sdg:HazardousMaterial, sdg:sankAt exactly 1 sdg:GeographicLocation, sdg:movedTo max 1 sdg:GeographicLocation

Class: sdg:ResponseAgency
    Annotations: rdfs:label "Response Agency", iao:0000115 "An organization or agency responsible for managing, monitoring, or responding to a spill incident."
    SubClassOf: bfo:0000015, sdg:agencyId some xsd:string, sdg:agencyName some xsd:string, sdg:agencyType some sdg:AgencyTypeKind, sdg:contactPerson some xsd:string, sdg:contactPhone some xsd:string, sdg:contactEmail some xsd:string, sdg:notificationMethod some sdg:NotificationMethodKind, sdg:manages some sdg:SpillIncident, sdg:notifiedOf some sdg:SpillIncident, sdg:monitors some sdg:Vessel

Class: sdg:EcologicalResource
    Annotations: rdfs:label "Ecological Resource", iao:0000115 "A natural resource or habitat area potentially affected by a spill incident, including wildlife and fisheries."
    SubClassOf: sdg:Resource, sdg:resourceId some xsd:string, sdg:resourceName some xsd:string, sdg:resourceType some sdg:ResourceTypeKind, sdg:affectedStatus some sdg:AffectedStatusKind, sdg:speciesList some xsd:string, sdg:commercialUse some xsd:boolean, sdg:locatedAt some sdg:GeographicLocation, sdg:affectedBy some sdg:SpillIncident, sdg:inhabitedBy max 1 sdg:HazardousMaterial
    HasKey: sdg:resourceId

Class: sdg:WasteProcessingFacility
    Annotations: rdfs:label "Waste Processing Facility", iao:0000115 "A physical plant where municipal solid waste and recyclable materials are received, processed, and converted into energy or prepared for disposal."
    SubClassOf: sdg:Resource, sdg:facilityId some xsd:string, sdg:facilityName some xsd:string, sdg:location some xsd:string, sdg:capacityTonsPerDay some xsd:decimal, sdg:operationalStatus some sdg:OperationalStatusKind, sdg:commissioningDate some xsd:date, sdg:primaryFunctionDetail some xsd:string, sdg:wasteCapacityTonsPerDay some xsd:decimal, sdg:energyOutputMWhPerDay some xsd:decimal, sdg:lastInspectionDate some xsd:date, sdg:processes some sdg:WasteStream, sdg:produces some sdg:EnergyOutput, sdg:locatedIn exactly 1 sdg:Jurisdiction, sdg:processesWaste min 2 sdg:WasteStream, sdg:locatedInJurisdiction min 2 sdg:Jurisdiction, sdg:employsStaff min 2 sdg:StaffMember

Class: sdg:WasteStream
    Annotations: rdfs:label "Waste Stream", iao:0000115 "A continuous flow of municipal solid waste and recyclable materials delivered by private haulers to a processing facility."
    SubClassOf: bfo:0000002, sdg:streamId some xsd:string, sdg:wasteType some sdg:WasteTypeKind, sdg:originJurisdiction some xsd:string, sdg:dailyVolumeTons some xsd:decimal, sdg:collectionFrequency some sdg:CollectionFrequencyKind, sdg:haulerContractId some xsd:string, sdg:streamType some xsd:string, sdg:sourceJurisdiction some xsd:string, sdg:deliveryFrequency some xsd:string, sdg:averageWeightTons some xsd:decimal, sdg:contaminationRatePercent some xsd:decimal, sdg:deliveredTo exactly 1 sdg:WasteProcessingFacility, sdg:originatesFrom exactly 1 sdg:Jurisdiction, sdg:deliveredToFacility exactly 1 sdg:WasteProcessingFacility, sdg:processedBySystem exactly 1 sdg:IntegratedWasteSystem

Class: sdg:EnergyOutput
    Annotations: rdfs:label "Energy Output", iao:0000115 "Clean, renewable electricity generated from the processing of municipal solid waste."
    SubClassOf: sdg:Resource, sdg:outputId some xsd:string, sdg:energyType some xsd:string, sdg:capacityMegawatts some xsd:decimal, sdg:dailyGenerationMWh some xsd:decimal, sdg:gridConnectionStatus some sdg:GridConnectionStatusKind, sdg:measurementDate some xsd:dateTime, sdg:quantityMWh some xsd:decimal, sdg:qualityStandard some xsd:string, sdg:outputDate some xsd:dateTime, sdg:energyQuantity some xsd:decimal, sdg:unit some sdg:UnitKind, sdg:conversionType some xsd:string, sdg:sustainabilityLimit some xsd:decimal, sdg:generatedBy exactly 1 sdg:WasteProcessingFacility, sdg:producedBySystem exactly 1 sdg:IntegratedWasteSystem, sdg:suppliesToGrid exactly 1 sdg:PowerGrid, sdg:derivedFrom exactly 1 sdg:EnergyExtraction, sdg:supplies exactly 1 sdg:EnergyResource

Class: sdg:FinancialStaff
    Annotations: rdfs:label "Financial Staff", iao:0000115 "An individual employed to perform accounting, budgeting, and financial analysis tasks within the organization."
    SubClassOf: sdg:FinancialEntity, sdg:staffId some xsd:string, sdg:fullName some xsd:string, sdg:roleDetail some sdg:RoleKind, sdg:employmentStatus some sdg:EmploymentStatusKind, sdg:hireDate some xsd:date, sdg:supervisorStaffId some xsd:string, sdg:prepares some sdg:FinancialReport, sdg:supervises max 1 sdg:FinancialStaff, sdg:assignedTo exactly 1 sdg:Department

Class: sdg:RegulatorySign
    Annotations: rdfs:label "Regulatory Sign", iao:0000115 "A physical traffic sign erected to inform highway users of traffic laws or regulations."
    SubClassOf: cco:ont00000995, sdg:signIdentifier some xsd:string, sdg:signMessage some xsd:string, sdg:signShape some sdg:SignShapeKind, sdg:signColor some xsd:string, sdg:isRetroreflectorized some xsd:boolean, sdg:isIlluminated some xsd:boolean, sdg:installationDate some xsd:date, sdg:status some sdg:StatusKind, sdg:appliesTo some sdg:TrafficRegulation, sdg:locatedAt exactly 1 sdg:RoadwaySegment, sdg:specifies exactly 1 sdg:SignStandard

Class: sdg:TrafficRegulation
    Annotations: rdfs:label "Traffic Regulation", iao:0000115 "A legal rule or requirement imposed on highway users, such as speed limits or right-of-way rules."
    SubClassOf: bfo:0000015, sdg:regulationCode some xsd:string, sdg:regulationType some sdg:RegulationTypeKind, sdg:effectiveDate some xsd:date, sdg:jurisdiction some sdg:JurisdictionKind, sdg:penaltyAmount some xsd:decimal, sdg:isActive some xsd:boolean, sdg:enforcedBy some sdg:RegulatorySign, sdg:appliesTo some sdg:RoadwaySegment

Class: sdg:RoadwaySegment
    Annotations: rdfs:label "Roadway Segment", iao:0000115 "A continuous stretch of highway or road where traffic regulations apply and signs are erected."
    SubClassOf: bfo:0000015, sdg:segmentIdentifier some xsd:string, sdg:roadName some xsd:string, sdg:startMileMarker some xsd:decimal, sdg:endMileMarker some xsd:decimal, sdg:surfaceType some sdg:SurfaceTypeKind, sdg:laneCount some xsd:integer, sdg:speedLimit some xsd:integer, sdg:hasRegulatorySign some sdg:RegulatorySign, sdg:governs some sdg:TrafficRegulation

Class: sdg:SignStandard
    Annotations: rdfs:label "Sign Standard", iao:0000115 "A documented specification from the Arizona Manual of Approved Signs defining the required size, legend, and visibility for regulatory signs."
    SubClassOf: cco:ont00000958, sdg:standardCode some xsd:string, sdg:standardVersion some xsd:string, sdg:requiredSize some xsd:string, sdg:requiredLegend some xsd:string, sdg:retroreflectivityLevel some sdg:RetroreflectivityLevelKind, sdg:illuminationRequirement some xsd:boolean, sdg:specifies some sdg:RegulatorySign

Class: sdg:SupportSystem
    Annotations: rdfs:label "Support System", iao:0000115 "A physical plant system or component that provides essential services (e.g., cooling, power) to safety-related equipment, distinguished from safety-related equipment itself by its functional rather than operability-defined status."
    SubClassOf: sdg:System, sdg:systemIdentifier some xsd:string, sdg:systemName some xsd:string, sdg:isTechnicalSpecificationBound some xsd:boolean, sdg:operabilityStatus some sdg:OperabilityStatusKind, sdg:riskSignificanceLevel some xsd:string, sdg:operationalStatus some sdg:OperationalStatusKind, sdg:hasLCO max 1 sdg:LimitingConditionOfOperation, sdg:hasHazardBarrier some sdg:HazardBarrier, sdg:requiresMaintenance some sdg:MaintenanceAction, sdg:hasAlternateTemporarySystem max 1 sdg:AlternateTemporarySystem

Class: sdg:LimitingConditionOfOperation
    Annotations: rdfs:label "Limiting Condition of Operation", iao:0000115 "A specific state or condition defined in technical specifications that must be met for a support system to be considered operable and for the plant to operate safely."
    SubClassOf: cco:ont00000995, sdg:lcoIdentifier some xsd:string, sdg:lcoDescription some xsd:string, sdg:isNecessary some xsd:boolean, sdg:isRequired some xsd:boolean, sdg:complianceDeadline some xsd:dateTime, sdg:appliesToSupportSystem some sdg:SupportSystem

Class: sdg:HazardBarrier
    Annotations: rdfs:label "Hazard Barrier", iao:0000115 "A physical or administrative control measure designed to prevent the release of hazards or mitigate their consequences, subject to specific regulatory initiatives."
    SubClassOf: bfo:0000015, sdg:barrierIdentifier some xsd:string, sdg:barrierType some sdg:BarrierTypeKind, sdg:effectivenessRating some sdg:EffectivenessRatingKind, sdg:regulatoryInitiative some xsd:string, sdg:protectsSupportSystem some sdg:SupportSystem

Class: sdg:AlternateTemporarySystem
    Annotations: rdfs:label "Alternate Temporary System", iao:0000115 "A provisional system deployed to maintain functionality when a primary support system is inoperable, subject to specific acceptability criteria and evaluation."
    SubClassOf: cco:ont00000995, sdg:atsIdentifier some xsd:string, sdg:deploymentDate some xsd:dateTime, sdg:removalDate some xsd:dateTime, sdg:acceptabilityStatus some xsd:string, sdg:evaluationCriteriaMet some xsd:boolean, sdg:replacesSupportSystem exactly 1 sdg:SupportSystem, sdg:subjectToEvaluation exactly 1 sdg:AcceptabilityEvaluation

Class: sdg:AcceptabilityEvaluation
    Annotations: rdfs:label "Acceptability Evaluation", iao:0000115 "A formal assessment process to determine if an alternate temporary system meets the required criteria for acceptability, considering risk and functional capability."
    SubClassOf: bfo:0000015, sdg:evaluationId some xsd:string, sdg:evaluationDate some xsd:dateTime, sdg:riskConsiderationIncluded some xsd:boolean, sdg:result some sdg:ResultKind, sdg:evaluatorLicenseeId some xsd:string, sdg:evaluatesSystem exactly 1 sdg:AlternateTemporarySystem

Class: sdg:MaintenanceAction
    Annotations: rdfs:label "Maintenance Action", iao:0000115 "A planned or unplanned activity performed on a support system to restore or maintain its operability or functionality, coordinated with technical specifications."
    SubClassOf: sdg:ProgramActivity, sdg:maintenanceId some xsd:string, sdg:startDate some xsd:dateTime, sdg:endDate some xsd:dateTime, sdg:actionType some xsd:string, sdg:completesOnSchedule some xsd:boolean, sdg:maintenanceType some xsd:string, sdg:performedOnSystem exactly 1 sdg:SupportSystem, sdg:satisfiesLCO max 1 sdg:LimitingConditionOfOperation

Class: sdg:Snubber
    Annotations: rdfs:label "Snubber", iao:0000115 "A mechanical device used to limit vibration or movement in piping and equipment, specifically addressed under TSTF 372 for operability and functionality distinctions."
    SubClassOf: cco:ont00000995, sdg:snubberId some xsd:string, sdg:location some xsd:string, sdg:isOperable some xsd:boolean, sdg:isFunctional some xsd:boolean, sdg:regulatoryAddress some xsd:string, sdg:installedInSystem some sdg:SupportSystem, sdg:requiresInspection some sdg:MaintenanceAction

Class: sdg:SponsorshipPackage
    Annotations: rdfs:label "Sponsorship Package", iao:0000115 "A structured offering of benefits and recognition tiers available for purchase by organizations to support RWN major events."
    SubClassOf: cco:ont00000995, sdg:packageId some xsd:string, sdg:packageName some xsd:string, sdg:tierLevel some xsd:string, sdg:price some xsd:decimal, sdg:benefitsDescription some xsd:string, sdg:validFrom some xsd:date, sdg:validUntil some xsd:date, sdg:supports some sdg:MajorEvent, sdg:purchasedBy some sdg:SponsoringOrganization

Class: sdg:MajorEvent
    Annotations: rdfs:label "Major Event", iao:0000115 "A significant annual gathering hosted by RWN designed to foster community, recognize achievements, and generate operating budget support."
    SubClassOf: bfo:0000015, sdg:eventId some xsd:string, sdg:eventName some xsd:string, sdg:eventDate some xsd:dateTime, sdg:venueName some xsd:string, sdg:venueAddress some xsd:string, sdg:eventType some sdg:EventTypeKind, sdg:annualEdition some xsd:integer, sdg:theme some xsd:string, sdg:honors some sdg:AwardRecipient, sdg:features some sdg:NetworkingSession, sdg:includes max 1 sdg:SilentAuction

Class: sdg:AwardRecipient
    Annotations: rdfs:label "Award Recipient", iao:0000115 "A local woman recognized for her professional achievements, leadership potential, or inspirational impact on other women."
    SubClassOf: bfo:0000002, sdg:recipientId some xsd:string, sdg:recipientName some xsd:string, sdg:awardCategory some xsd:string, sdg:yearsInField some xsd:integer, sdg:nominationYear some xsd:integer, sdg:isFinalist some xsd:boolean, sdg:isWinner some xsd:boolean, sdg:recognizedAt exactly 1 sdg:MajorEvent

Class: sdg:SponsoringOrganization
    Annotations: rdfs:label "Sponsoring Organization", iao:0000115 "A business, professional entity, or individual that provides financial or in-kind support to RWN events in exchange for visibility and networking opportunities."
    SubClassOf: bfo:0000040, sdg:orgId some xsd:string, sdg:orgName some xsd:string, sdg:businessType some xsd:string, sdg:contactEmail some xsd:string, sdg:contactPhone some xsd:string, sdg:membershipStatus some sdg:MembershipStatusKind, sdg:purchases some sdg:SponsorshipPackage, sdg:participatesIn max 1 sdg:ConferenceMarketplace

Class: sdg:NetworkingSession
    Annotations: rdfs:label "Networking Session", iao:0000115 "A structured or informal period during an event designed to facilitate connections between attendees, honorees, and sponsors."
    SubClassOf: sdg:sessionId some xsd:string, sdg:sessionName some xsd:string, sdg:startTime some xsd:dateTime, sdg:endTime some xsd:dateTime, sdg:location some xsd:string, sdg:isMandatory some xsd:boolean, sdg:attendeeInteractionPurpose some xsd:string, sdg:occurrentPartOf exactly 1 sdg:MajorEvent, sdg:attendedBy some sdg:SponsoringOrganization

Class: sdg:SilentAuction
    Annotations: rdfs:label "Silent Auction", iao:0000115 "A fundraising activity held during the W Award Celebration where items are bid on, with proceeds supporting RWN programming."
    SubClassOf: bfo:0000015, sdg:auctionId some xsd:string, sdg:auctionDate some xsd:dateTime, sdg:totalProceeds some xsd:decimal, sdg:numberOfItems some xsd:integer, sdg:status some sdg:StatusKind, sdg:heldAt exactly 1 sdg:MajorEvent

Class: sdg:ConferenceMarketplace
    Annotations: rdfs:label "Conference Marketplace", iao:0000115 "A designated area or platform within the Summit Business Conference where business owners display products and services to attendees."
    SubClassOf: sdg:marketplaceId some xsd:string, sdg:boothCount some xsd:integer, sdg:setupDate some xsd:date, sdg:dismantleDate some xsd:date, sdg:status some sdg:StatusKind, sdg:partOf__escalated exactly 1 sdg:MajorEvent, sdg:occupiedBy some sdg:SponsoringOrganization

Class: sdg:EmissionsMonitoringStation
    Annotations: rdfs:label "Emissions Monitoring Station", iao:0000115 "A material entity that is a physical installation or apparatus used for measuring and recording continuous emissions from industrial sources."
    SubClassOf: sdg:Resource, sdg:stationId some xsd:string, sdg:installationDate some xsd:date, sdg:lastCalibrationDate some xsd:date, sdg:operationalStatus some sdg:OperationalStatusKind, sdg:manufacturer some xsd:string, sdg:modelNumber some xsd:string, sdg:monitorsSource some sdg:EmissionSource, sdg:maintainedBy some sdg:TestCrew, sdg:measures some sdg:EmissionSource

Class: sdg:EmissionSource
    Annotations: rdfs:label "Emission Source", iao:0000115 "A material entity representing a physical facility or unit that releases pollutants into the atmosphere, such as boilers, turbines, or incinerators."
    SubClassOf: sdg:Resource, sdg:sourceId some xsd:string, sdg:sourceType some sdg:SourceTypeKind, sdg:commissioningDate some xsd:date, sdg:operationalStatus some sdg:OperationalStatusKind, sdg:fuelType some xsd:string, sdg:capacityMw some xsd:decimal, sdg:hasMonitoringStation some sdg:EmissionsMonitoringStation, sdg:testedBy some sdg:TestCrew
    HasKey: sdg:sourceId

Class: sdg:TestCrew
    Annotations: rdfs:label "Test Crew", iao:0000115 "A social group of personnel organized to perform field testing, monitoring, and analysis of emissions monitoring systems and industrial sources."
    SubClassOf: bfo:0000004, sdg:crewId some xsd:string, sdg:crewName some xsd:string, sdg:supervisorId some xsd:string, sdg:certificationLevel some xsd:string, sdg:activeSince some xsd:date, sdg:supervisedBy exactly 1 sdg:ProjectManager, sdg:conductsTestOn some sdg:EmissionSource, sdg:operatesEquipment some sdg:EmissionsMonitoringStation
    HasKey: sdg:crewId

Class: sdg:ProjectManager
    Annotations: rdfs:label "Project Manager", iao:0000115 "A role played by a person who supervises test crews, manages air pollution test programs, and coordinates on-site equipment handling and operation procedures."
    SubClassOf: bfo:0000004, sdg:managerId some xsd:string, sdg:fullName some xsd:string, sdg:officeLocation some xsd:string, sdg:certifications some xsd:string, sdg:yearsOfExperience some xsd:integer, sdg:email some xsd:string, sdg:telephone some xsd:string, sdg:currentRole some xsd:string, sdg:institution some xsd:string, sdg:managesOffice exactly 1 sdg:RegionalOffice, sdg:supervisesCrew min 2 sdg:TestCrew, sdg:overseesProgram some sdg:EmissionsTestProgram, sdg:manages some sdg:ResearchDesk, sdg:affiliatedWith exactly 1 sdg:Institution, sdg:holdsQualification some sdg:AcademicQualification

Class: sdg:EmissionsTestProgram
    Annotations: rdfs:label "Emissions Test Program", iao:0000115 "A planned activity or series of measurements involving the evaluation, testing, and analysis of continuous emissions monitoring systems and industrial sources."
    SubClassOf: bfo:0000015, sdg:programId some xsd:string, sdg:programName some xsd:string, sdg:startDate some xsd:dateTime, sdg:endDate some xsd:dateTime, sdg:testType some sdg:TestTypeKind, sdg:status some sdg:StatusKind, sdg:targetsSource some sdg:EmissionSource, sdg:usesEquipment some sdg:EmissionsMonitoringStation, sdg:executedBy min 2 sdg:TestCrew

Class: sdg:RegionalOffice
    Annotations: rdfs:label "Regional Office", iao:0000115 "A material entity representing a physical branch location or administrative facility where project managers and test crews are based and operations are coordinated."
    SubClassOf: bfo:0000040, sdg:officeId some xsd:string, sdg:officeName some xsd:string, sdg:city some xsd:string, sdg:state some xsd:string, sdg:establishedDate some xsd:date, sdg:hostsManager some sdg:ProjectManager, sdg:supportsCrew some sdg:TestCrew

Class: sdg:JobApplication
    Annotations: rdfs:label "Job Application", iao:0000115 "A formal record of an individual's request for employment at a specific organization, containing personal details, work history, and qualifications."
    SubClassOf: cco:ont00000958, sdg:applicationId some xsd:string, sdg:submissionDate some xsd:dateTime, sdg:desiredPosition some xsd:string, sdg:desiredWage some xsd:decimal, sdg:availabilityStatus some xsd:string, sdg:overtimeEligibility some xsd:boolean, sdg:preferredShift some xsd:string, sdg:shiftFlexibility some xsd:boolean, sdg:earliestStartDate some xsd:date, sdg:submittedBy exactly 1 sdg:Applicant, sdg:submittedTo exactly 1 sdg:Organization, sdg:references min 3 sdg:Reference, sdg:workHistory min 2 sdg:EmploymentRecord, sdg:educationHistory min 2 sdg:EducationRecord
    HasKey: sdg:applicationId

Class: sdg:EmploymentRecord
    Annotations: rdfs:label "Past Employment Record", iao:0000115 "A historical record of a specific period of work performed by an applicant at a particular organization, detailing dates, role, and compensation."
    SubClassOf: sdg:Record, sdg:startDate some xsd:dateTime, sdg:endDate some xsd:dateTime, sdg:salary some xsd:decimal, sdg:positionTitle some xsd:string, sdg:reasonForLeaving some xsd:string, sdg:contactPermission some xsd:boolean, sdg:employerName some xsd:string, sdg:employerAddress some xsd:string, sdg:employerPhone some xsd:string, sdg:domainContext some xsd:string, sdg:heldBy exactly 1 sdg:Applicant, sdg:performedAt exactly 1 sdg:Organization

Class: sdg:EducationRecord
    Annotations: rdfs:label "Education Record", iao:0000115 "A record of formal academic or vocational training completed by an applicant, specifying the institution, duration, and credential obtained."
    SubClassOf: sdg:Record, sdg:institutionName some xsd:string, sdg:institutionAddress some xsd:string, sdg:institutionPhone some xsd:string, sdg:yearsAttended some xsd:decimal, sdg:courseOfStudy some xsd:string, sdg:degreeOrDiploma some xsd:string, sdg:educationLevel some sdg:EducationLevelKind, sdg:institutionType some sdg:InstitutionTypeKind, sdg:completedBy exactly 1 sdg:Applicant, sdg:awardedBy exactly 1 sdg:Organization

Class: sdg:Reference
    Annotations: rdfs:label "Employment Reference", iao:0000115 "A person designated by an applicant to provide verification of their character, work performance, or qualifications to a prospective employer."
    SubClassOf: bfo:0000002, sdg:fullName some xsd:string, sdg:address some xsd:string, sdg:phone some xsd:string, sdg:relationshipType some sdg:RelationshipTypeKind, sdg:isRelative some xsd:boolean, sdg:providedFor exactly 1 sdg:Applicant

Class: sdg:Interpretation
    Annotations: rdfs:label "Interpretation", iao:0000115 "A scholarly or theological perspective on the identity of the 'sons of God' in Genesis 6 and Job."
    SubClassOf: bfo:0000030, sdg:interpretationId some xsd:string, sdg:interpretationName some xsd:string, sdg:primarySubject some xsd:string, sdg:isMainstream some xsd:boolean, sdg:isAuthorPreferred some xsd:boolean, sdg:discusses some sdg:BiblicalText, sdg:supports some sdg:TheologicalClaim, sdg:contradicts some sdg:Interpretation

Class: sdg:BiblicalText
    Annotations: rdfs:label "Biblical Text", iao:0000115 "A specific passage or book within the Hebrew Bible/Old Testament, such as Genesis 6 or the Book of Job."
    SubClassOf: sdg:Book, sdg:textId some xsd:string, sdg:bookName some xsd:string, sdg:chapterNumber some xsd:integer, sdg:verseRange some xsd:string, sdg:language some sdg:LanguageKind, sdg:isHistoricNarrative some xsd:boolean, sdg:isInterpretedBy some sdg:Interpretation, sdg:contains some sdg:TheologicalClaim

Class: sdg:TheologicalClaim
    Annotations: rdfs:label "Theological Claim", iao:0000115 "A specific doctrinal or exegetical assertion derived from biblical texts, such as the identity of the 'sons of God' or the nature of the covenant."
    SubClassOf: sdg:TheologicalConcept, sdg:claimId some xsd:string, sdg:claimText some xsd:string, sdg:claimType some xsd:string, sdg:isCovenantal some xsd:boolean, sdg:isEschatological some xsd:boolean, sdg:isSupportedBy some sdg:BiblicalText, sdg:isContradictedBy some sdg:BiblicalText, sdg:isPartOf some sdg:Interpretation

Class: sdg:Covenant
    Annotations: rdfs:label "Covenant", iao:0000115 "A formal agreement or promise between God and humanity, such as the Adamic or Mosaic covenant, defining the relationship and expectations."
    SubClassOf: bfo:0000030, sdg:covenantId some xsd:string, sdg:covenantName some xsd:string, sdg:isUnilateral some xsd:boolean, sdg:isBilateral some xsd:boolean, sdg:promises some xsd:string, sdg:requirements some xsd:string, sdg:involves some sdg:Humanity, sdg:establishes some sdg:TheologicalClaim, sdg:isReferencedIn some sdg:BiblicalText

Class: sdg:NutritionUnit
    Annotations: rdfs:label "Children's Nutrition Unit", iao:0000115 "A specialized health facility established by an NGO to deliver inpatient, outpatient, and community-based nutrition services to malnourished children and women in urban slum areas."
    SubClassOf: bfo:0000040, sdg:unitId some xsd:string, sdg:establishedDate some xsd:date, sdg:annualBudget some xsd:decimal, sdg:currencyCode some xsd:string, sdg:serviceStatus some sdg:ServiceStatusKind, sdg:operationalScope some sdg:OperationalScopeKind, sdg:targetPopulationDetail some sdg:TargetPopulationKind, sdg:managementQuality some sdg:ManagementQualityKind, sdg:locatedIn exactly 1 sdg:GeographicArea, sdg:fundedBy some sdg:FundingAgency, sdg:deliversServiceTo some sdg:BeneficiaryGroup, sdg:conductsResearch some sdg:ResearchStudy, sdg:providesTrainingTo some sdg:StaffMember
    HasKey: sdg:unitId

Class: sdg:GeographicArea
    Annotations: rdfs:label "Dhaka Slum Area", iao:0000115 "A densely populated urban slum region in Dhaka, Bangladesh, characterized by high mortality and morbidity rates, serving as the operational context for nutrition interventions."
    SubClassOf: bfo:0000002, sdg:areaId some xsd:string, sdg:areaName some xsd:string, sdg:populationDensity some xsd:decimal, sdg:mortalityRate some xsd:decimal, sdg:morbidityRate some xsd:decimal, sdg:administrativeZone some xsd:string, sdg:socioeconomicStatus some sdg:SocioeconomicStatusKind, sdg:infrastructureLevel some sdg:InfrastructureLevelKind, sdg:name some sdg:NameKind, sdg:type some sdg:TypeKind, sdg:latitude some xsd:decimal, sdg:longitude some xsd:decimal, sdg:description some xsd:string, sdg:contains some sdg:NutritionUnit, sdg:contains some sdg:BeneficiaryGroup, sdg:adjacentTo some sdg:GeographicArea, sdg:traversedBy some sdg:Expedition

Class: sdg:BeneficiaryGroup
    Annotations: rdfs:label "Malnourished Children and Women", iao:0000115 "A demographic cohort of children and women from poor slum communities who are the primary recipients of nutrition rehabilitation and health education services."
    SubClassOf: sdg:groupId some xsd:string, sdg:groupName some xsd:string, sdg:ageRange some xsd:string, sdg:gender some sdg:GenderKind, sdg:enrollmentDate some xsd:date, sdg:dischargeDate some xsd:dateTime, sdg:recoveryStatus some sdg:RecoveryStatusKind, sdg:participationLevel some xsd:string, sdg:receivesServiceFrom exactly 1 sdg:NutritionUnit, sdg:participatesIn__escalated some sdg:TrainingProgram

Class: sdg:TrainingProgram
    Annotations: rdfs:label "Staff Training Initiative", iao:0000115 "A structured educational activity designed to build capacity in Government and NGO staff on nutrition rehabilitation techniques, health education, and operational research methodologies."
    SubClassOf: sdg:Program, sdg:programId some xsd:string, sdg:programName some xsd:string, sdg:startDate some xsd:dateTime, sdg:endDate some xsd:dateTime, sdg:durationHours some xsd:decimal, sdg:targetAudience some sdg:TargetAudienceKind, sdg:completionRate some xsd:decimal, sdg:effectivenessRating some sdg:EffectivenessRatingKind, sdg:deliveredBy exactly 1 sdg:NutritionUnit, sdg:attends some sdg:StaffMember
    HasKey: sdg:programId

Class: sdg:ResearchStudy
    Annotations: rdfs:label "Nutritional Impact Assessment", iao:0000115 "A systematic investigation conducted by the Nutrition Unit to evaluate the effectiveness of malnutrition treatment protocols, community health interventions, and training program outcomes."
    SubClassOf: bfo:0000015, sdg:studyId some xsd:string, sdg:studyTitle some xsd:string, sdg:startDate some xsd:dateTime, sdg:endDate some xsd:dateTime, sdg:studyType some sdg:StudyTypeKind, sdg:sampleSize some xsd:integer, sdg:primaryOutcome some xsd:string, sdg:publicationStatus some xsd:string, sdg:conductedBy exactly 1 sdg:NutritionUnit, sdg:involves some sdg:StaffMember, sdg:measures some sdg:BeneficiaryGroup, sdg:informs some sdg:PolicyRecommendation

Class: sdg:PolicyRecommendation
    Annotations: rdfs:label "Government Nutrition Policy Advisory", iao:0000115 "A formal suggestion or directive derived from research findings and program evaluations, intended to influence Government of Bangladesh nutrition policy and service delivery frameworks."
    SubClassOf: bfo:0000040, sdg:policyId some xsd:string, sdg:policyTitle some xsd:string, sdg:issueDate some xsd:date, sdg:targetPolicyArea some xsd:string, sdg:adoptionStatus some sdg:AdoptionStatusKind, sdg:influenceLevel some sdg:InfluenceLevelKind, sdg:sourceStudy some xsd:string, sdg:derivedFrom some sdg:ResearchStudy, sdg:submittedTo exactly 1 sdg:GovernmentBody, sdg:addresses some sdg:BeneficiaryGroup, sdg:implementedBy some sdg:NutritionUnit

Class: sdg:HypothesisTest
    Annotations: rdfs:label "Hypothesis Test", iao:0000115 "A formal statistical procedure used to evaluate a claim about a population parameter by comparing observed data against a null hypothesis."
    SubClassOf: bfo:0000015, sdg:testIdentifier some xsd:string, sdg:testType some sdg:TestTypeKind, sdg:significanceLevel some xsd:decimal, sdg:actualSignificanceLevel some xsd:decimal, sdg:conclusion some xsd:string, sdg:conclusionText some xsd:string, sdg:tests min 2 sdg:StatisticalHypothesis, sdg:uses exactly 1 sdg:TestStatistic, sdg:appliesTo exactly 1 sdg:PopulationParameter, sdg:determines exactly 1 sdg:CriticalRegion

Class: sdg:StatisticalHypothesis
    Annotations: rdfs:label "Statistical Hypothesis", iao:0000115 "A formal statement regarding the value of a population parameter, categorized as either a null hypothesis (assumed true) or an alternative hypothesis (contradicting the null)."
    SubClassOf: bfo:0000015, sdg:hypothesisType some xsd:string, sdg:parameterSymbol some xsd:string, sdg:operator some xsd:string, sdg:thresholdValue some xsd:decimal, sdg:isTestedIn exactly 1 sdg:HypothesisTest, sdg:concerns exactly 1 sdg:PopulationParameter

Class: sdg:TestStatistic
    Annotations: rdfs:label "Test Statistic", iao:0000115 "A numerical value calculated from sample data used to determine whether to reject the null hypothesis."
    SubClassOf: sdg:statisticSymbol some xsd:string, sdg:observedValue some xsd:integer, sdg:distributionModel some xsd:string, sdg:distributionParameter some xsd:decimal, sdg:isUsedIn exactly 1 sdg:HypothesisTest, sdg:measures exactly 1 sdg:PopulationParameter

Class: sdg:PopulationParameter
    Annotations: rdfs:label "Population Parameter", iao:0000115 "A numerical characteristic of a population, such as a probability or proportion, that is the subject of statistical inference."
    SubClassOf: bfo:0000015, sdg:parameterSymbol some xsd:string, sdg:parameterName some xsd:string, sdg:trueValue some xsd:decimal, sdg:isMeasuredBy some sdg:TestStatistic, sdg:isTestedIn some sdg:StatisticalHypothesis

Class: sdg:CriticalRegion
    Annotations: rdfs:label "Critical Region", iao:0000115 "A set of values for the test statistic that leads to the rejection of the null hypothesis, determined by the significance level."
    SubClassOf: bfo:0000015, sdg:regionType some sdg:RegionTypeKind, sdg:lowerBound some xsd:integer, sdg:upperBound some xsd:integer, sdg:criticalValue some xsd:integer, sdg:isDefinedBy exactly 1 sdg:HypothesisTest, sdg:appliesTo exactly 1 sdg:TestStatistic

Class: sdg:Golfer
    Annotations: rdfs:label "Golfer", iao:0000115 "A human participant engaged in the sport of golf, possessing specific physical and cognitive attributes relevant to shot execution."
    SubClassOf: sdg:CompetitionEntity, sdg:golferId some xsd:string, sdg:name some sdg:NameKind, sdg:handPreference some xsd:string, sdg:skillLevel some sdg:SkillLevelKind, sdg:routine some xsd:string

Class: sdg:TargetSpot
    Annotations: rdfs:label "Target Spot", iao:0000115 "A specific spatial location on the golf course intended as the landing point or final destination for a golf ball."
    SubClassOf: bfo:0000002, sdg:spotId some xsd:string, sdg:xCoordinate some xsd:decimal, sdg:yCoordinate some xsd:decimal, sdg:zCoordinate some xsd:decimal, sdg:surfaceType some sdg:SurfaceTypeKind, sdg:distanceFromHole some xsd:decimal

Class: sdg:ShotRoutine
    Annotations: rdfs:label "Shot Routine", iao:0000115 "A standardized sequence of physical and cognitive actions performed by a golfer before and during a shot to ensure consistency."
    SubClassOf: bfo:0000015, sdg:routineId some xsd:string, sdg:routineName some xsd:string, sdg:steps some xsd:string, sdg:duration some xsd:decimal, sdg:successRate some xsd:decimal, sdg:includes exactly 1 sdg:GripTechnique, sdg:includes exactly 1 sdg:AimProcedure, sdg:includes exactly 1 sdg:PostureSetup

Class: sdg:GripTechnique
    Annotations: rdfs:label "Grip Technique", iao:0000115 "The specific method of holding a golf club, involving hand placement and pressure, critical for shot control."
    SubClassOf: bfo:0000015, sdg:techniqueId some xsd:string, sdg:techniqueName some xsd:string, sdg:handPlacement some xsd:string, sdg:pressure some xsd:string, sdg:applicableShotTypes some xsd:string

Class: sdg:AimProcedure
    Annotations: rdfs:label "Aim Procedure", iao:0000115 "The process of aligning the golfer's body and clubface with the intended target line to ensure accurate direction."
    SubClassOf: bfo:0000015, sdg:procedureId some xsd:string, sdg:procedureName some xsd:string, sdg:targetLine some xsd:string, sdg:alignmentMethod some xsd:string, sdg:visualCue some xsd:string

Class: sdg:PostureSetup
    Annotations: rdfs:label "Posture Setup", iao:0000115 "The physical positioning of the golfer's body, including hip flexion and arm relaxation, prior to initiating the swing."
    SubClassOf: bfo:0000015, sdg:setupId some xsd:string, sdg:setupName some xsd:string, sdg:hipAngle some xsd:decimal, sdg:armPosition some xsd:string, sdg:weightDistribution some xsd:string

Class: sdg:AccountRegister
    Annotations: rdfs:label "Account Register", iao:0000115 "A formal record maintained by an educational institution documenting all active social networking application domain names, administrators, user IDs, and passwords."
    SubClassOf: cco:ont00000958, sdg:registerId some xsd:string, sdg:institutionId some xsd:string, sdg:lastAuditDate some xsd:date, sdg:totalActiveAccounts some xsd:integer, sdg:complianceStatus some sdg:ComplianceStatusKind, sdg:recordFormat some xsd:string, sdg:recordsAccount min 2 sdg:SocialMediaAccount, sdg:maintainedBy exactly 1 sdg:EducationalInstitution, sdg:auditedBy some sdg:StaffMember

Class: sdg:SocialMediaPolicy
    Annotations: rdfs:label "Social Media Policy", iao:0000115 "The official document adopted by the Cavan and Monaghan Education and Training Board outlining rules, responsibilities, and guidelines for social media usage by staff."
    SubClassOf: cco:ont00000958, sdg:policyId some xsd:string, sdg:title some xsd:string, sdg:adoptionDate some xsd:dateTime, sdg:version some xsd:string, sdg:issuingAuthorityDetail some xsd:string, sdg:scope some sdg:ScopeKind, sdg:governs min 2 sdg:StaffMember, sdg:appliesTo min 2 sdg:SocialMediaAccount, sdg:references exactly 1 sdg:TeachingCouncilCode
    HasKey: sdg:policyId

Class: sdg:TeachingCouncilCode
    Annotations: rdfs:label "Teaching Council Code of Conduct", iao:0000115 "The official code of conduct prescribed by the Teaching Council that governs professional behavior and communication standards for teaching staff."
    SubClassOf: cco:ont00000958, sdg:codeId some xsd:string, sdg:codeTitle some xsd:string, sdg:issuingBody some xsd:string, sdg:effectiveDate some xsd:date, sdg:sectionNumber some xsd:string, sdg:binds min 2 sdg:StaffMember, sdg:referencedBy exactly 1 sdg:SocialMediaPolicy

Class: sdg:MarkingScheme
    Annotations: rdfs:label "Marking Scheme", iao:0000115 "A structured rubric defining the correct answers, required justifications, and point allocations for assessment items."
    SubClassOf: sdg:schemeIdentifier some xsd:string, sdg:academicSession some xsd:string, sdg:subjectCode some xsd:string, sdg:totalMarks some xsd:integer, sdg:durationMinutes some xsd:integer, sdg:version some xsd:string, sdg:specifiesCriteriaFor some sdg:AssessmentItem

Class: sdg:AnswerKey
    Annotations: rdfs:label "Answer Key", iao:0000115 "The definitive correct response or set of responses required to achieve full marks for a specific assessment item."
    SubClassOf: sdg:keyIdentifier some xsd:string, sdg:responseText some xsd:string, sdg:isCorrect some xsd:boolean, sdg:alternativeAccepted some xsd:boolean, sdg:formatType some xsd:string, sdg:correspondsTo exactly 1 sdg:AssessmentItem, sdg:demonstratesConcept some sdg:Concept

Class: sdg:ScoringRule
    Annotations: rdfs:label "Scoring Rule", iao:0000115 "A procedural instruction defining how partial or full marks are awarded based on specific content requirements or keywords."
    SubClassOf: bfo:0000015, sdg:ruleIdentifier some xsd:string, sdg:requiredPoints some xsd:integer, sdg:pointsAwarded some xsd:decimal, sdg:conditionType some xsd:string, sdg:penaltyApplied some xsd:boolean, sdg:appliesTo some sdg:AssessmentItem, sdg:evaluatesAnswer some sdg:AnswerKey

Class: sdg:CustomBackAssembly
    Annotations: rdfs:label "Custom Back Assembly", iao:0000115 "A manufactured wheelchair back component configured with specific dimensions, air cell placements, and adjustable compartments to meet a client's postural and pressure-relief needs."
    SubClassOf: cco:ont00000995, sdg:assemblyId some xsd:string, sdg:shellWidth some xsd:decimal, sdg:shellHeight some xsd:decimal, sdg:shellDepth some xsd:decimal, sdg:status some sdg:StatusKind, sdg:orderReference some xsd:string, sdg:manufactureLeadTime some xsd:integer, sdg:contains min 2 sdg:AirCellPlacement, sdg:configuredWith min 2 sdg:AirCompartment, sdg:orderedBy exactly 1 sdg:ProviderAccount

Class: sdg:AirCellPlacement
    Annotations: rdfs:label "Air Cell Placement", iao:0000115 "A specific location and type of air cell installed within the custom back assembly shell grid to provide targeted pressure relief."
    SubClassOf: cco:ont00000995, sdg:cellId some xsd:string, sdg:profileType some xsd:string, sdg:widthCm some xsd:decimal, sdg:heightCm some xsd:decimal, sdg:gridRow some xsd:integer, sdg:gridColumn some xsd:integer, sdg:partOf exactly 1 sdg:CustomBackAssembly
    HasKey: sdg:cellId

Class: sdg:AirCompartment
    Annotations: rdfs:label "Air Compartment", iao:0000115 "A distinct zone of interconnected air cells within the back assembly that can be inflated or deflated together via a shared valve."
    SubClassOf: cco:ont00000995, sdg:compartmentId some xsd:string, sdg:compartmentName some sdg:CompartmentNameKind, sdg:isAdjustable some xsd:boolean, sdg:valveLocation some sdg:ValveLocationKind, sdg:contains min 2 sdg:AirCellPlacement, sdg:partOf exactly 1 sdg:CustomBackAssembly

Class: sdg:ProviderAccount
    Annotations: rdfs:label "Provider Account", iao:0000115 "The business or clinical entity account holding the order, including contact details and billing information."
    SubClassOf: cco:ont00000995, sdg:accountNumber some xsd:string, sdg:providerName some xsd:string, sdg:addressLine1 some xsd:string, sdg:addressLine2 some xsd:string, sdg:city some xsd:string, sdg:state some xsd:string, sdg:zipCode some xsd:string, sdg:country some sdg:CountryKind, sdg:phone some xsd:string, sdg:email some xsd:string, sdg:placed min 2 sdg:CustomBackAssembly
    HasKey: sdg:accountNumber

Class: sdg:ManufacturingOrder
    Annotations: rdfs:label "Manufacturing Order", iao:0000115 "The formal request record generated to initiate the production of a custom back assembly, linking the order to the provider and the assembly specifications."
    SubClassOf: cco:ont00000995, sdg:orderNumber some xsd:string, sdg:orderDate some xsd:dateTime, sdg:orderType some sdg:OrderTypeKind, sdg:poNumber some xsd:string, sdg:specialInstructions some xsd:string, sdg:specifies exactly 1 sdg:CustomBackAssembly, sdg:submittedBy exactly 1 sdg:ProviderAccount

Class: sdg:WallLineDance
    Annotations: rdfs:label "Wall Line Dance", iao:0000115 "A choreographed sequence of footwork steps performed in a line formation, structured into sections with specific counts and timing."
    SubClassOf: bfo:0000015, sdg:danceId some xsd:string, sdg:title some xsd:string, sdg:level some sdg:LevelKind, sdg:totalCounts some xsd:integer, sdg:musicBpm some xsd:integer, sdg:startOffsetSeconds some xsd:decimal, sdg:choreographerName some xsd:string, sdg:choreographyDate some xsd:date, sdg:dedicationText some xsd:string, sdg:hasSection min 2 sdg:DanceSection, sdg:performedTo exactly 1 sdg:MusicTrack

Class: sdg:DanceSection
    Annotations: rdfs:label "Dance Section", iao:0000115 "A discrete segment of a wall line dance containing a specific range of counts, actual footwork instructions, and a calling suggestion."
    SubClassOf: bfo:0000015, sdg:sectionId some xsd:string, sdg:sectionNumber some xsd:string, sdg:countRange some xsd:string, sdg:actualFootwork some xsd:string, sdg:callingSuggestion some xsd:string, sdg:stepCount some xsd:integer, sdg:sectionIndex some xsd:integer, sdg:stepCountRange some xsd:string, sdg:footworkDescription some xsd:string, sdg:sectionIdentifier some xsd:string, sdg:partOf__escalated exactly 1 sdg:WallLineDance, sdg:containsStep min 2 sdg:DanceStep, sdg:partOf__escalated exactly 1 sdg:LineDanceRoutine, sdg:containsStep min 2 sdg:FootworkStep

Class: sdg:DanceStep
    Annotations: rdfs:label "Dance Step", iao:0000115 "A single movement instruction within a dance section, specifying foot placement, direction, and type of motion."
    SubClassOf: bfo:0000015, sdg:stepId some xsd:string, sdg:stepName some xsd:string, sdg:footUsed some sdg:FootUsedKind, sdg:direction some sdg:DirectionKind, sdg:turnAngle some xsd:decimal, sdg:executionOrder some xsd:integer, sdg:partOfSection exactly 1 sdg:DanceSection

Class: sdg:MusicTrack
    Annotations: rdfs:label "Music Track", iao:0000115 "A recorded audio track used as the musical accompaniment for a dance, characterized by tempo, artist, album, and title."
    SubClassOf: cco:ont00000995, sdg:trackId some xsd:string, sdg:title some xsd:string, sdg:artistName some xsd:string, sdg:albumTitle some xsd:string, sdg:tempoBpm some xsd:integer, sdg:durationSeconds some xsd:decimal, sdg:releaseYear some xsd:integer, sdg:accompanies exactly 1 sdg:WallLineDance

Class: sdg:DanceEvent
    Annotations: rdfs:label "Dance Event", iao:0000115 "A scheduled performance or competition instance where a specific wall line dance is executed by participants."
    SubClassOf: bfo:0000015, sdg:eventId some xsd:string, sdg:eventName some xsd:string, sdg:eventDate some xsd:dateTime, sdg:location some xsd:string, sdg:competitionLevel some sdg:CompetitionLevelKind, sdg:participantCount some xsd:integer, sdg:featuresDance exactly 1 sdg:WallLineDance, sdg:heldAt exactly 1 sdg:Venue

Class: sdg:ServiceCharge
    Annotations: rdfs:label "Service Charge", iao:0000115 "A calculated financial transaction representing a percentage of the bill allocated to staff."
    SubClassOf: bfo:0000015, sdg:chargePercentage some xsd:decimal, sdg:chargeAmount some xsd:decimal, sdg:distributionMethod some xsd:string, sdg:isMandatory some xsd:boolean, sdg:calculationDate some xsd:dateTime, sdg:chargeId some xsd:string, sdg:chargeType some xsd:string, sdg:chargeValue some xsd:decimal, sdg:chargeName some xsd:string, sdg:appliesToGroupSize some xsd:string, sdg:appliedTo exactly 1 sdg:DiningPackage, sdg:distributedTo min 2 sdg:StaffRole, sdg:appliesTo some sdg:CateringPackage
    HasKey: sdg:chargeId

Class: sdg:PowerSplitterCombiner
    Annotations: rdfs:label "Power Splitter/Combiner Device", iao:0000115 "A passive reciprocal RF device that splits an input signal into multiple outputs or combines multiple inputs into a single output with specific phase and amplitude characteristics."
    SubClassOf: cco:ont00000995, sdg:deviceIdentifier some xsd:string, sdg:deviceType some sdg:DeviceTypeKind, sdg:nominalImpedance some xsd:decimal, sdg:portCount some xsd:integer, sdg:isolationRating some xsd:decimal, sdg:theoreticalInsertionLoss some xsd:decimal, sdg:phaseRelationship some xsd:string, sdg:status some sdg:StatusKind, sdg:hasPort min 2 sdg:RFPort, sdg:exhibitsCharacteristic some sdg:SignalCharacteristic

Class: sdg:RFPort
    Annotations: rdfs:label "RF Port", iao:0000115 "A physical interface on a power splitter/combiner that accepts or delivers an RF signal, characterized by its impedance and termination state."
    SubClassOf: cco:ont00000995, sdg:portIdentifier some xsd:string, sdg:portLabel some sdg:PortLabelKind, sdg:impedance some xsd:decimal, sdg:terminationState some xsd:string, sdg:vswr some xsd:decimal, sdg:partOf exactly 1 sdg:PowerSplitterCombiner, sdg:connectedTo max 1 sdg:Antenna, sdg:connectedTo max 1 sdg:Receiver

Class: sdg:SignalCharacteristic
    Annotations: rdfs:label "Signal Characteristic", iao:0000115 "A measurable property of an RF signal passing through a splitter/combiner, such as amplitude, phase, or isolation level."
    SubClassOf: bfo:0000015, sdg:characteristicType some xsd:string, sdg:value some xsd:decimal, sdg:unit some sdg:UnitKind, sdg:measurementCondition some xsd:string, sdg:status some sdg:StatusKind, sdg:measuredOn exactly 1 sdg:PowerSplitterCombiner, sdg:appliesToPort some sdg:RFPort

Class: sdg:Antenna
    Annotations: rdfs:label "Antenna", iao:0000115 "A transducer that converts electrical signals into electromagnetic waves or vice versa, connected to the RF ports of a splitter/combiner."
    SubClassOf: cco:ont00000995, sdg:antennaIdentifier some xsd:string, sdg:antennaType some xsd:string, sdg:resonantFrequency some xsd:decimal, sdg:impedance some xsd:decimal, sdg:status some sdg:StatusKind, sdg:connectedToPort exactly 1 sdg:RFPort, sdg:feedsReceiver max 1 sdg:Receiver

Class: sdg:Transformer
    Annotations: rdfs:label "RF Transformer", iao:0000115 "A passive component within a power splitter/combiner circuit that provides impedance matching and phase shifting, often with a specific turns ratio."
    SubClassOf: cco:ont00000995, sdg:transformerIdentifier some xsd:string, sdg:turnsRatio some xsd:string, sdg:impedanceRatio some xsd:decimal, sdg:phaseShift some xsd:decimal, sdg:status some sdg:StatusKind, sdg:partOf exactly 1 sdg:PowerSplitterCombiner, sdg:connectsPort min 2 sdg:RFPort

Class: sdg:FloodAsset
    Annotations: rdfs:label "Flood Infrastructure Asset", iao:0000115 "A material object representing a physical component of the flood defence system, such as a levee, embankment, or pumping station."
    SubClassOf: bfo:0000040, sdg:assetId some xsd:string, sdg:assetName some xsd:string, sdg:assetType some sdg:AssetTypeKind, sdg:constructionYear some xsd:integer, sdg:designCapacity some xsd:decimal, sdg:isCritical some xsd:boolean, sdg:hasConditionRecord min 2 sdg:ConditionRecord, sdg:locatedIn exactly 1 sdg:GeographicZone, sdg:subjectTo some sdg:FloodHazard

Class: sdg:ConditionRecord
    Annotations: rdfs:label "Flood Asset Condition Record", iao:0000115 "A record documenting the physical state, vulnerability, or integrity of a specific flood asset at a given time."
    SubClassOf: cco:ont00000995, sdg:recordId some xsd:string, sdg:assessmentDate some xsd:dateTime, sdg:conditionScore some xsd:decimal, sdg:vulnerabilityLevel some sdg:VulnerabilityLevelKind, sdg:defectType some xsd:string, sdg:isVerified some xsd:boolean, sdg:describesAsset exactly 1 sdg:FloodAsset, sdg:derivedFrom some sdg:EarthObservationData, sdg:measuredBy exactly 1 sdg:MeasurementMethod

Class: sdg:EarthObservationData
    Annotations: rdfs:label "Earth Observation Data Product", iao:0000115 "A dataset or image product derived from satellite or aerial sensors, such as ESA's Copernicus programme, used to monitor flood infrastructure."
    SubClassOf: sdg:DataEntity, sdg:dataProductId some xsd:string, sdg:acquisitionDate some xsd:dateTime, sdg:sensorType some xsd:string, sdg:spatialResolution some xsd:decimal, sdg:coverageArea some xsd:string, sdg:dataQualityIndex some xsd:decimal, sdg:isCopernicusSource some xsd:boolean, sdg:informs min 2 sdg:ConditionRecord, sdg:coversZone some sdg:GeographicZone, sdg:generatedBy exactly 1 sdg:SatelliteMission

Class: sdg:GeographicZone
    Annotations: rdfs:label "Flood Risk Geographic Zone", iao:0000115 "A defined spatial area, such as a catchment, district, or asset location, subject to flood risk assessment."
    SubClassOf: sdg:GeographicEntity, sdg:zoneId some xsd:string, sdg:zoneName some xsd:string, sdg:zoneType some sdg:ZoneTypeKind, sdg:areaSize some xsd:decimal, sdg:populationDensity some xsd:decimal, sdg:isCoastal some xsd:boolean, sdg:riskLevel some sdg:RiskLevelKind, sdg:zoneIdentifier some xsd:string, sdg:populationCount some xsd:integer, sdg:boundaryCoordinates some xsd:string, sdg:containsAssets min 2 sdg:FloodAsset, sdg:experiences some sdg:FloodHazard, sdg:monitoredBy some sdg:EarthObservationData, sdg:subjectTo some sdg:EvacuationOrder, sdg:contains some sdg:EvacuationRoute, sdg:experiences some sdg:HazardEvent

Class: sdg:FloodHazard
    Annotations: rdfs:label "Flood Hazard Event", iao:0000115 "A process or event involving the overflow or inundation of water that poses a risk to flood infrastructure and surrounding areas."
    SubClassOf: bfo:0000015, sdg:hazardId some xsd:string, sdg:eventDate some xsd:dateTime, sdg:peakWaterLevel some xsd:decimal, sdg:duration some xsd:decimal, sdg:hazardSeverity some sdg:HazardSeverityKind, sdg:causeType some xsd:string, sdg:affectsAssets min 2 sdg:FloodAsset, sdg:occursIn__escalated exactly 1 sdg:GeographicZone, sdg:triggers some sdg:ConditionRecord

Class: sdg:SatelliteMission
    Annotations: rdfs:label "Earth Observation Satellite Mission", iao:0000115 "A specific satellite programme or mission, such as ESA's Copernicus, that generates earth observation data products."
    SubClassOf: bfo:0000040, sdg:missionId some xsd:string, sdg:missionName some xsd:string, sdg:operator some xsd:string, sdg:launchYear some xsd:integer, sdg:orbitType some sdg:OrbitTypeKind, sdg:isCopernicusMission some xsd:boolean, sdg:generates min 2 sdg:EarthObservationData, sdg:monitorsZone some sdg:GeographicZone

Class: sdg:MeasurementMethod
    Annotations: rdfs:label "Condition Assessment Method", iao:0000115 "A standardized procedure or technique used to evaluate the physical condition and vulnerability of flood infrastructure."
    SubClassOf: sdg:AssessmentTool, sdg:methodId some xsd:string, sdg:methodName some sdg:MethodNameKind, sdg:methodType some xsd:string, sdg:accuracyLevel some xsd:decimal, sdg:costIndex some xsd:decimal, sdg:isAutomated some xsd:boolean, sdg:applicationDomain some xsd:string, sdg:usedFor min 2 sdg:ConditionRecord, sdg:appliesTo some sdg:FloodAsset
    HasKey: sdg:methodId

Class: sdg:Youth
    Annotations: rdfs:label "Juvenile in Custody", iao:0000115 "A minor subject to the jurisdiction of the Riverside County Probation Department and residing in a juvenile facility."
    SubClassOf: bfo:0000040, sdg:youthIdentifier some xsd:string, sdg:dateOfBirth some xsd:date, sdg:currentStatus some sdg:CurrentStatusKind, sdg:jurisdictionCode some xsd:string, sdg:hasHealthSummary max 1 sdg:HealthCareSummary, sdg:isSubjectOf some sdg:TransferEvent, sdg:isSubjectOf some sdg:ReleaseEvent

Class: sdg:HealthCareSummary
    Annotations: rdfs:label "Juvenile Health Care Summary", iao:0000115 "A compiled documentation of a youth's health record, including summaries and relevant medical data, prepared for transfer or release."
    SubClassOf: sdg:summaryIdentifier some xsd:string, sdg:creationDate some xsd:dateTime, sdg:formatCode some xsd:string, sdg:hasRecords some xsd:boolean, sdg:confidentialityStatus some xsd:string, sdg:documents exactly 1 sdg:Youth, sdg:isForwardedTo some sdg:HealthcareFacility, sdg:requiresAuthorizationFrom some sdg:Authorization

Class: sdg:TransferEvent
    Annotations: rdfs:label "Juvenile Transfer", iao:0000115 "The administrative and physical movement of a youth from one juvenile facility to another jurisdiction."
    SubClassOf: bfo:0000015, sdg:transferIdentifier some xsd:string, sdg:transferDate some xsd:dateTime, sdg:originFacilityCode some xsd:string, sdg:destinationFacilityCode some xsd:string, sdg:hasCommunicableDisease some xsd:boolean, sdg:involvesYouth exactly 1 sdg:Youth, sdg:triggersSummaryTransfer exactly 1 sdg:HealthCareSummary, sdg:notifiesFacility exactly 1 sdg:HealthcareFacility

Class: sdg:ReleaseEvent
    Annotations: rdfs:label "Juvenile Release", iao:0000115 "The process of a youth being discharged from custody into the community, triggering the transmission of health records to community providers."
    SubClassOf: bfo:0000015, sdg:releaseIdentifier some xsd:string, sdg:releaseDate some xsd:dateTime, sdg:releaseType some sdg:ReleaseTypeKind, sdg:authorizationObtained some xsd:boolean, sdg:involvesYouth exactly 1 sdg:Youth, sdg:triggersRecordTransmission exactly 1 sdg:HealthCareSummary, sdg:transmitsToProvider some sdg:HealthcareFacility

Class: sdg:Authorization
    Annotations: rdfs:label "Health Record Release Authorization", iao:0000115 "A formal written permission obtained from a youth or their legal guardian permitting the transfer or release of confidential health records."
    SubClassOf: sdg:Authority, sdg:authorizationIdentifier some xsd:string, sdg:issueDate some xsd:date, sdg:grantorType some sdg:GrantorTypeKind, sdg:isCourtOrdered some xsd:boolean, sdg:status some sdg:StatusKind, sdg:pertainsToYouth exactly 1 sdg:Youth, sdg:enablesTransfer max 1 sdg:TransferEvent, sdg:enablesRelease max 1 sdg:ReleaseEvent

Class: sdg:ClientAssetPortfolio
    Annotations: rdfs:label "Client Asset Portfolio", iao:0000115 "A collection of financial assets held in custody or administration for clients, subject to segregation and protection protocols."
    SubClassOf: cco:ont00000995, sdg:portfolioIdentifier some xsd:string, sdg:totalValueUSD some xsd:decimal, sdg:assetType some sdg:AssetTypeKind, sdg:segregationStatus some xsd:string, sdg:custodianEntity some xsd:string, sdg:lastValuationDate some xsd:dateTime, sdg:riskRating some sdg:RiskRatingKind, sdg:coveredBy some sdg:InsurancePolicy, sdg:heldBy exactly 1 sdg:FinancialInstitution, sdg:subjectTo some sdg:RegulatoryFramework

Class: sdg:InsurancePolicy
    Annotations: rdfs:label "Insurance Policy", iao:0000115 "A contractual agreement providing financial protection against loss of client assets, such as SIPC coverage or excess Lloyd's policies."
    SubClassOf: sdg:GovernmentPolicy, sdg:policyIdentifier some xsd:string, sdg:providerName some xsd:string, sdg:coverageLimitUSD some xsd:decimal, sdg:effectiveDate some xsd:date, sdg:expirationDate some xsd:date, sdg:ratingAgency some xsd:string, sdg:creditRating some xsd:string, sdg:policyType some sdg:PolicyTypeKind, sdg:coverageType some xsd:string, sdg:covers some sdg:ClientAssetPortfolio, sdg:issuedBy exactly 1 sdg:InsuranceUnderwriter, sdg:supersedes max 1 sdg:InsurancePolicy

Class: sdg:RegulatoryFramework
    Annotations: rdfs:label "Regulatory Framework", iao:0000115 "A set of rules, standards, or oversight mechanisms governing financial institutions and client asset protection, such as SEC or FINRA regulations."
    SubClassOf: sdg:RegulatoryComplianceConcept, sdg:frameworkIdentifier some xsd:string, sdg:issuingAuthorityDetail some xsd:string, sdg:jurisdiction some sdg:JurisdictionKind, sdg:complianceStatus some sdg:ComplianceStatusKind, sdg:lastAuditDate some xsd:date, sdg:regulatoryType some xsd:string, sdg:regulatoryDomain some xsd:string, sdg:governs some sdg:FinancialInstitution, sdg:appliesTo some sdg:ClientAssetPortfolio, sdg:enforcedBy exactly 1 sdg:RegulatoryBody

Class: sdg:AuditReport
    Annotations: rdfs:label "Audit Report", iao:0000115 "A formal document detailing the evaluation of internal controls, financial status, or compliance of a financial institution or asset portfolio."
    SubClassOf: sdg:Report, sdg:reportIdentifier some xsd:string, sdg:auditFirm some xsd:string, sdg:reportDate some xsd:dateTime, sdg:auditType some xsd:string, sdg:findingsSummary some xsd:string, sdg:complianceRating some xsd:string, sdg:scopeDescription some xsd:string, sdg:audits exactly 1 sdg:FinancialInstitution, sdg:evaluates some sdg:ClientAssetPortfolio, sdg:references some sdg:RegulatoryFramework

Class: sdg:InsuranceUnderwriter
    Annotations: rdfs:label "Insurance Underwriter", iao:0000115 "An entity or market providing insurance coverage, such as Lloyd's of London, that issues policies to protect client assets."
    SubClassOf: cco:ont00000995, sdg:underwriterIdentifier some xsd:string, sdg:legalName some xsd:string, sdg:location some xsd:string, sdg:creditRatingSP some xsd:string, sdg:creditRatingAMBest some xsd:string, sdg:creditRatingFitch some xsd:string, sdg:ratingDate some xsd:date, sdg:issues some sdg:InsurancePolicy, sdg:ratedBy some sdg:RatingAgency

Class: sdg:RatingAgency
    Annotations: rdfs:label "Rating Agency", iao:0000115 "An organization that assigns credit or financial strength ratings to insurance underwriters or financial institutions."
    SubClassOf: cco:ont00000995, sdg:agencyIdentifier some xsd:string, sdg:agencyName some xsd:string, sdg:ratingMethodology some xsd:string, sdg:lastReviewDate some xsd:date, sdg:rates some sdg:InsuranceUnderwriter, sdg:rates some sdg:FinancialInstitution

Class: sdg:UniversitySupportSystem
    Annotations: rdfs:label "University Support System", iao:0000115 "A structured institutional program or resource designed to facilitate student entrepreneurial activities."
    SubClassOf: cco:ont00000995, sdg:systemId some xsd:string, sdg:systemName some xsd:string, sdg:systemType some xsd:string, sdg:startDate some xsd:dateTime, sdg:endDate some xsd:dateTime, sdg:status some sdg:StatusKind, sdg:budget some xsd:decimal, sdg:accessibilityScore some xsd:decimal, sdg:providesTo min 2 sdg:StudentLedBusinessInitiative, sdg:deliveredBy exactly 1 sdg:UniversityDepartment
    HasKey: sdg:systemId

Class: sdg:StudentLedBusinessInitiative
    Annotations: rdfs:label "Student-Led Business Initiative", iao:0000115 "A business venture or entrepreneurial project initiated and managed by a university student."
    SubClassOf: bfo:0000015, sdg:initiativeId some xsd:string, sdg:initiativeName some xsd:string, sdg:status some sdg:StatusKind, sdg:foundedDate some xsd:date, sdg:sector some sdg:SectorKind, sdg:revenue some xsd:decimal, sdg:employeeCount some xsd:integer, sdg:successRating some xsd:decimal, sdg:supportedBy min 2 sdg:UniversitySupportSystem, sdg:managedBy exactly 1 sdg:StudentEntrepreneur, sdg:operatesIn exactly 1 sdg:GeographicJurisdiction
    HasKey: sdg:initiativeId

Class: sdg:StudentEntrepreneur
    Annotations: rdfs:label "Student Entrepreneur", iao:0000115 "A university student who actively engages in entrepreneurial activities and manages business initiatives."
    SubClassOf: bfo:0000004, sdg:studentId some xsd:string, sdg:fullName some xsd:string, sdg:major some xsd:string, sdg:enrollmentStatus some sdg:EnrollmentStatusKind, sdg:demographicGroup some sdg:DemographicGroupKind, sdg:contactEmail some xsd:string, sdg:satisfactionScore some xsd:decimal, sdg:manages min 2 sdg:StudentLedBusinessInitiative, sdg:enrolledAt exactly 1 sdg:UniversityDepartment, sdg:receivesMentorshipFrom some sdg:Mentor

Class: sdg:Mentor
    Annotations: rdfs:label "Mentor", iao:0000115 "An experienced entrepreneur or industry professional who provides guidance and advice to student entrepreneurs."
    SubClassOf: bfo:0000004, sdg:mentorId some xsd:string, sdg:fullName some xsd:string, sdg:expertiseArea some xsd:string, sdg:yearsOfExperience some xsd:integer, sdg:affiliation some sdg:AffiliationKind, sdg:rating some xsd:integer, sdg:availabilityStatus some xsd:string, sdg:contactInfo some xsd:string, sdg:guides min 2 sdg:StudentEntrepreneur, sdg:affiliatedWith exactly 1 sdg:UniversityDepartment
    HasKey: sdg:mentorId

Class: sdg:UniversityDepartment
    Annotations: rdfs:label "University Department", iao:0000115 "An administrative or academic unit within a university responsible for delivering support systems and education."
    SubClassOf: sdg:EducationalEntity, sdg:departmentId some xsd:string, sdg:departmentName some xsd:string, sdg:departmentCode some xsd:string, sdg:headOfDepartment some xsd:string, sdg:location some xsd:string, sdg:establishedDate some xsd:date, sdg:operationalStatus some sdg:OperationalStatusKind, sdg:budgetAllocation some xsd:decimal, sdg:campusLocation some xsd:string, sdg:delivers min 2 sdg:UniversitySupportSystem, sdg:employs some sdg:Mentor, sdg:hosts min 2 sdg:StudentEntrepreneur

Class: sdg:GeographicJurisdiction
    Annotations: rdfs:label "Geographic Jurisdiction", iao:0000115 "A defined geographical area or administrative region where business initiatives operate or are supported."
    SubClassOf: sdg:GeographicEntity, sdg:jurisdictionId some xsd:string, sdg:jurisdictionName some xsd:string, sdg:jurisdictionType some xsd:string, sdg:population some xsd:integer, sdg:gdp some xsd:decimal, sdg:entrepreneurshipIndex some xsd:decimal, sdg:governmentPolicies some xsd:string, sdg:lastUpdated some xsd:dateTime, sdg:hosts min 2 sdg:StudentLedBusinessInitiative

Class: sdg:SanctionsScreeningTool
    Annotations: rdfs:label "Sanctions Screening Tool", iao:0000115 "A software-as-a-service system that filters financial transactions against global sanctions lists to ensure regulatory compliance."
    SubClassOf: cco:ont00000995, sdg:toolId some xsd:string, sdg:provider some xsd:string, sdg:deploymentModel some sdg:DeploymentModelKind, sdg:implementationMonths some xsd:decimal, sdg:costPercentage some xsd:decimal, sdg:lastUpdated some xsd:dateTime, sdg:listCoverage some xsd:string, sdg:isAutoUpdating some xsd:boolean, sdg:deployedAt some sdg:FinancialInstitution, sdg:references min 3 sdg:SanctionsList, sdg:trainedBy some sdg:ConsultancyTeam

Class: sdg:SanctionsList
    Annotations: rdfs:label "Sanctions List", iao:0000115 "A curated dataset of restricted persons and entities issued by a regulatory authority for compliance screening."
    SubClassOf: cco:ont00000995, sdg:listId some xsd:string, sdg:issuingAuthorityDetail some xsd:string, sdg:effectiveDate some xsd:date, sdg:expirationDate some xsd:date, sdg:recordCount some xsd:integer, sdg:listType some xsd:string, sdg:referencedBy some sdg:SanctionsScreeningTool, sdg:issuedBy exactly 1 sdg:RegulatoryAgency

Class: sdg:RegulatoryAgency
    Annotations: rdfs:label "Regulatory Agency", iao:0000115 "A governmental or supranational body that enforces financial regulations and publishes sanctions lists."
    SubClassOf: sdg:RegulatoryComplianceConcept, sdg:agencyId some xsd:string, sdg:agencyName some xsd:string, sdg:jurisdiction some sdg:JurisdictionKind, sdg:isInternational some xsd:boolean, sdg:foundedYear some xsd:integer, sdg:enforcementLevel some sdg:EnforcementLevelKind, sdg:jurisdictionScope some xsd:string, sdg:issues min 2 sdg:SanctionsList, sdg:oversees some sdg:FinancialInstitution
    HasKey: sdg:agencyId

Class: sdg:ComplianceTraining
    Annotations: rdfs:label "Compliance Training", iao:0000115 "A structured educational activity conducted to prepare staff for using sanctions screening tools and meeting regulatory deadlines."
    SubClassOf: sdg:RegulatoryComplianceConcept, sdg:trainingId some xsd:string, sdg:startDate some xsd:dateTime, sdg:endDate some xsd:dateTime, sdg:location some xsd:string, sdg:attendeeCount some xsd:integer, sdg:isCompleted some xsd:boolean, sdg:followUpFrequency some sdg:FollowUpFrequencyKind, sdg:schedulingFrequency some xsd:string, sdg:conductedFor exactly 1 sdg:FinancialInstitution, sdg:deliveredBy exactly 1 sdg:ConsultancyTeam, sdg:enables exactly 1 sdg:SanctionsScreeningTool

Class: sdg:ConsultancyTeam
    Annotations: rdfs:label "Consultancy Team", iao:0000115 "A group of specialists provided by a service vendor to assist with the implementation and training of compliance software."
    SubClassOf: cco:ont00000995, sdg:teamId some xsd:string, sdg:vendorName some xsd:string, sdg:primaryRegion some xsd:string, sdg:specialization some sdg:SpecializationKind, sdg:isActive some xsd:boolean, sdg:supports some sdg:FinancialInstitution, sdg:delivers some sdg:ComplianceTraining, sdg:affiliatedWith exactly 1 sdg:SanctionsScreeningTool

Class: sdg:SchoolDivision
    Annotations: rdfs:label "School Division", iao:0000115 "A public school administrative jurisdiction within Virginia that participates in the regional magnet school program."
    SubClassOf: bfo:0000040, sdg:divisionId some xsd:string, sdg:divisionName some xsd:string, sdg:region some sdg:RegionKind, sdg:establishedDate some xsd:date, sdg:totalEnrollment some xsd:integer, sdg:districtType some sdg:DistrictTypeKind, sdg:servesStudents min 2 sdg:Student

Class: sdg:Diploma
    Annotations: rdfs:label "Diploma", iao:0000115 "A formal credential awarded to students who meet the magnet school's graduation requirements, including the Governor's School Seal."
    SubClassOf: bfo:0000040, sdg:diplomaId some xsd:string, sdg:issueDate some xsd:date, sdg:hasSeal some xsd:boolean, sdg:totalCreditsEarned some xsd:decimal, sdg:isAdvancedStudies some xsd:boolean, sdg:awardedTo exactly 1 sdg:Student, sdg:requires min 2 sdg:DiplomaRequirement

Class: sdg:DiplomaRequirement
    Annotations: rdfs:label "Diploma Requirement", iao:0000115 "A specific academic or administrative condition that must be satisfied for graduation, such as minimum credit units or verified credits."
    SubClassOf: bfo:0000040, sdg:requirementId some xsd:string, sdg:description some xsd:string, sdg:minimumCredits some xsd:decimal, sdg:isVerified some xsd:boolean, sdg:regulationCode some xsd:string, sdg:satisfiedBy min 2 sdg:Course, sdg:partOf__escalated exactly 1 sdg:Diploma

Class: sdg:ExtracurricularActivity
    Annotations: rdfs:label "Extracurricular Activity", iao:0000115 "A non-academic program or club offered by the school, such as athletics, arts, or student organizations."
    SubClassOf: bfo:0000040, sdg:activityId some xsd:string, sdg:activityName some sdg:ActivityNameKind, sdg:category some sdg:CategoryKind, sdg:isCompetitive some xsd:boolean, sdg:season some sdg:SeasonKind, sdg:hasParticipants__escalated min 2 sdg:Student, sdg:sponsoredBy some sdg:SchoolDivision
    HasKey: sdg:activityId

Class: sdg:TournamentGame
    Annotations: rdfs:label "Tournament Game", iao:0000115 "A competitive correspondence chess match between two players or teams, governed by ICCF rules and tracked via move cards or electronic transmission."
    SubClassOf: sdg:CompetitionEntity, sdg:gameId some xsd:string, sdg:startDate some xsd:dateTime, sdg:endDate some xsd:dateTime, sdg:timeControl some xsd:string, sdg:status some sdg:StatusKind, sdg:notationAgreement some xsd:string, sdg:transmissionMode some sdg:TransmissionModeKind, sdg:isTeamEvent some xsd:boolean, sdg:hasPlayer min 2 sdg:Player, sdg:hasTournamentDirector exactly 1 sdg:TournamentDirector, sdg:hasTeam max 1 sdg:Team, sdg:hasMoveCard min 2 sdg:MoveCard

Class: sdg:Player
    Annotations: rdfs:label "Player", iao:0000115 "An individual chess competitor participating in a tournament game, responsible for making moves and managing time."
    SubClassOf: sdg:CompetitionEntity, sdg:playerId some xsd:string, sdg:fullName some xsd:string, sdg:emailAddress some xsd:string, sdg:countryCode some sdg:CountryCodeKind, sdg:isTeamCaptain some xsd:boolean, sdg:vacationPeriods some xsd:string, sdg:totalTimeUsed some xsd:decimal, sdg:accumulatedTime some xsd:decimal, sdg:email some xsd:string, sdg:country some sdg:CountryKind, sdg:rating some xsd:integer, sdg:status some sdg:StatusKind, sdg:firstName some xsd:string, sdg:lastName some xsd:string, sdg:jerseyNumber some xsd:integer, sdg:position some xsd:string, sdg:isEligibleToBlitz some xsd:boolean, sdg:stanceType some sdg:StanceTypeKind, sdg:participatesIn__escalated min 2 sdg:TournamentGame, sdg:representsTeam max 1 sdg:Team, sdg:contactedBy max 1 sdg:TournamentDirector, sdg:contactedBy max 1 sdg:TeamCaptain, sdg:sportDomain some sdg:ChessPlayerCharacteristic, sdg:participatesIn__escalated some sdg:Tournament, sdg:playsInGame some sdg:ChessGame, sdg:belongsTeam max 1 sdg:Team, sdg:memberOf exactly 1 sdg:Team, sdg:assignedTo some sdg:GameMatch

Class: sdg:Team
    Annotations: rdfs:label "Team", iao:0000115 "A group of players competing together in a team tournament event, represented by a designated Team Captain."
    SubClassOf: bfo:00000995, sdg:teamId some xsd:string, sdg:teamName some xsd:string, sdg:countryCode some sdg:CountryCodeKind, sdg:captainId some xsd:string, sdg:registrationDate some xsd:dateTime, sdg:status some sdg:StatusKind, sdg:country some sdg:CountryKind, sdg:affiliationId some xsd:string, sdg:maxSquadSize some xsd:integer, sdg:minSquadSize some xsd:integer, sdg:gender some sdg:GenderKind, sdg:ageGroup some xsd:string, sdg:hasCaptain exactly 1 sdg:TeamCaptain, sdg:hasMember min 2 sdg:Player, sdg:competesIn min 2 sdg:TournamentGame, sdg:hasPlayer min 2 sdg:Player, sdg:competesIn some sdg:Tournament, sdg:competesIn some sdg:GameMatch, sdg:composedOf min 2 sdg:Player

Class: sdg:TeamCaptain
    Annotations: rdfs:label "Team Captain", iao:0000115 "A player who serves as the official liaison between their team and the Tournament Director for administrative and dispute resolution purposes."
    SubClassOf: bfo:0000023, sdg:captainId some xsd:string, sdg:fullName some xsd:string, sdg:emailAddress some xsd:string, sdg:teamId some xsd:string, sdg:notificationPreference some xsd:string, sdg:email some xsd:string, sdg:representsTeam exactly 1 sdg:Team, sdg:contacts exactly 1 sdg:TournamentDirector, sdg:leadsTeam exactly 1 sdg:Team, sdg:communicatesWith some sdg:TournamentDirector

Class: sdg:MoveCard
    Annotations: rdfs:label "Move Card", iao:0000115 "A physical or electronic record containing a player's move, time usage, and postmark or transmission timestamp."
    SubClassOf: bfo:00000995, sdg:cardId some xsd:string, sdg:moveNumber some xsd:integer, sdg:playerId some xsd:string, sdg:moveNotation some xsd:string, sdg:timeUsed some xsd:decimal, sdg:postmarkDate some xsd:date, sdg:transmissionTimestamp some xsd:dateTime, sdg:isAmbiguous some xsd:boolean, sdg:status some sdg:StatusKind, sdg:gameId some xsd:string, sdg:totalTime some xsd:decimal, sdg:transmissionDate some xsd:dateTime, sdg:belongsGame exactly 1 sdg:TournamentGame, sdg:submittedBy exactly 1 sdg:Player, sdg:receivedBy exactly 1 sdg:Player, sdg:verifiedBy max 1 sdg:TournamentDirector, sdg:belongsGame exactly 1 sdg:ChessGame, sdg:recordedBy max 1 sdg:TournamentDirector
    HasKey: sdg:cardId

Class: sdg:TournamentDirector
    Annotations: rdfs:label "Tournament Director", iao:0000115 "An official responsible for enforcing ICCF rules, managing game status, resolving disputes, and recording forfeits or penalties."
    SubClassOf: sdg:CompetitionEntity, sdg:tdId some xsd:string, sdg:fullName some xsd:string, sdg:emailAddress some xsd:string, sdg:jurisdiction some sdg:JurisdictionKind, sdg:activeGamesCount some xsd:integer, sdg:disputeResolutionLog some xsd:string, sdg:roleFunction some xsd:string, sdg:email some xsd:string, sdg:oversees min 2 sdg:TournamentGame, sdg:contacts min 2 sdg:Player, sdg:contacts min 2 sdg:TeamCaptain, sdg:verifies min 2 sdg:MoveCard, sdg:oversees some sdg:Tournament, sdg:managesGame some sdg:ChessGame, sdg:handlesDispute some sdg:Dispute

Class: sdg:Brand
    Annotations: rdfs:label "Retail Brand", iao:0000115 "A commercial enterprise entity that sells consumer goods through physical stores and direct-to-consumer channels."
    SubClassOf: cco:ont00000995, sdg:brandId some xsd:string, sdg:brandName some xsd:string, sdg:foundingYear some xsd:integer, sdg:annualRevenue some xsd:decimal, sdg:totalStoreCount some xsd:integer, sdg:headquartersLocation some xsd:string, sdg:parentCompany some xsd:string, sdg:hasLeadershipTeam exactly 1 sdg:LeadershipTeam, sdg:employs min 2 sdg:Employee, sdg:operatesIn some sdg:MarketCondition

Class: sdg:LeadershipTeam
    Annotations: rdfs:label "Retail Leadership Team", iao:0000115 "A group of top executives responsible for the overall performance and reputation of the retail brand."
    SubClassOf: bfo:0000015, sdg:teamId some xsd:string, sdg:teamName some xsd:string, sdg:assessmentDate some xsd:dateTime, sdg:teamSize some xsd:integer, sdg:assessmentScore some xsd:decimal, sdg:teamStatus some sdg:TeamStatusKind, sdg:belongsTo exactly 1 sdg:Brand, sdg:hasMember min 2 sdg:Executive, sdg:conducts some sdg:TeamAssessment, sdg:reviews some sdg:BrandGoal

Class: sdg:Executive
    Annotations: rdfs:label "Retail Executive", iao:0000115 "A senior individual responsible for a specific functional area within the retail organization."
    SubClassOf: bfo:0000015, sdg:executiveId some xsd:string, sdg:fullName some xsd:string, sdg:jobTitle some xsd:string, sdg:department some xsd:string, sdg:tenureYears some xsd:integer, sdg:location some xsd:string, sdg:isSenior some xsd:boolean, sdg:executiveName some xsd:string, sdg:title some xsd:string, sdg:decisionAuthority some xsd:string, sdg:leads exactly 1 sdg:Department, sdg:participatesIn__escalated some sdg:LeadershipTeam, sdg:hasGoal some sdg:BrandGoal, sdg:reportsTo max 1 sdg:Executive, sdg:oversees min 2 sdg:AccountManager, sdg:reviews some sdg:SalesReport

Class: sdg:BrandGoal
    Annotations: rdfs:label "Strategic Brand Goal", iao:0000115 "A specific, measurable objective set for the brand to achieve within a defined timeframe."
    SubClassOf: cco:ont00000995, sdg:goalId some xsd:string, sdg:goalDescription some xsd:string, sdg:targetYear some xsd:integer, sdg:metricType some sdg:MetricTypeKind, sdg:targetValue some xsd:decimal, sdg:currentValue some xsd:decimal, sdg:isBenchmarked some xsd:boolean, sdg:belongsTo exactly 1 sdg:Brand, sdg:assignedTo some sdg:Executive, sdg:benchmarkedAgainst max 1 sdg:BrandGoal

Class: sdg:TeamAssessment
    Annotations: rdfs:label "Team Performance Assessment", iao:0000115 "A structured evaluation process measuring team functioning and performance against established models."
    SubClassOf: bfo:0000015, sdg:assessmentId some xsd:string, sdg:assessmentType some xsd:string, sdg:dateConducted some xsd:dateTime, sdg:durationMinutes some xsd:integer, sdg:modelUsed some xsd:string, sdg:resultStatus some sdg:ResultStatusKind, sdg:assesses exactly 1 sdg:LeadershipTeam, sdg:conductedBy some sdg:Executive

Class: sdg:MarketCondition
    Annotations: rdfs:label "External Market Condition", iao:0000115 "An external economic or environmental factor influencing the brand's performance and strategy."
    SubClassOf: bfo:0000015, sdg:conditionId some xsd:string, sdg:conditionName some xsd:string, sdg:impactLevel some sdg:ImpactLevelKind, sdg:trendDirection some xsd:string, sdg:measurementValue some xsd:decimal, sdg:lastUpdated some xsd:dateTime, sdg:affects some sdg:Brand, sdg:influences some sdg:BrandGoal, sdg:monitoredBy some sdg:Executive

Class: sdg:Carpet
    Annotations: rdfs:label "Carpet", iao:0000115 "A woven textile floor covering or wall hanging produced in West and Central Asia, serving functional, decorative, and ceremonial purposes."
    SubClassOf: cco:ont00000995, sdg:carpetId some xsd:string, sdg:designStyle some sdg:DesignStyleKind, sdg:originRegion some xsd:string, sdg:productionDate some xsd:dateTime, sdg:dimensions some xsd:string, sdg:materialComposition some xsd:string, sdg:currentLocation some xsd:string, sdg:conditionStatus some sdg:ConditionStatusKind, sdg:producedBy some sdg:Workshop, sdg:displayedIn some sdg:RoyalHousehold, sdg:tradedTo some sdg:MarketRegion, sdg:exhibitsPattern some sdg:DesignPattern

Class: sdg:Workshop
    Annotations: rdfs:label "Carpet Workshop", iao:0000115 "A state-sponsored or private production facility where carpets were designed, woven, and finished through a division of labor."
    SubClassOf: bfo:0000015, sdg:workshopId some xsd:string, sdg:location some xsd:string, sdg:establishedDate some xsd:date, sdg:patron some xsd:string, sdg:specialization some sdg:SpecializationKind, sdg:productionVolume some xsd:decimal, sdg:operationalStatus some sdg:OperationalStatusKind, sdg:employs min 2 sdg:Craftsperson, sdg:produces min 2 sdg:Carpet, sdg:supplies some sdg:MarketRegion

Class: sdg:Craftsperson
    Annotations: rdfs:label "Carpet Craftsperson", iao:0000115 "An individual worker engaged in specific stages of carpet production, such as spinning, dyeing, or knotting."
    SubClassOf: bfo:0000023, sdg:craftspersonId some xsd:string, sdg:roleDetail some sdg:RoleKind, sdg:gender some sdg:GenderKind, sdg:region some sdg:RegionKind, sdg:yearsOfExperience some xsd:integer, sdg:affiliatedWorkshop some xsd:string, sdg:worksAt exactly 1 sdg:Workshop

Class: sdg:DesignPattern
    Annotations: rdfs:label "Carpet Design Pattern", iao:0000115 "A visual motif or structural arrangement used in carpet weaving, such as vegetal arabesques, geometric tessellations, or garden layouts."
    SubClassOf: cco:ont00000995, sdg:patternId some xsd:string, sdg:patternType some xsd:string, sdg:complexityLevel some xsd:string, sdg:culturalOrigin some xsd:string, sdg:visualImpact some xsd:string, sdg:repetitionFrequency some xsd:integer, sdg:usedIn min 2 sdg:Carpet

Class: sdg:RoyalHousehold
    Annotations: rdfs:label "Royal Household", iao:0000115 "A royal residence or administrative unit where valuable carpets were stored, rotated, and displayed to project power and wealth."
    SubClassOf: bfo:0000015, sdg:householdId some xsd:string, sdg:location some xsd:string, sdg:rulingDynasty some sdg:RulingDynastyKind, sdg:storageCapacity some xsd:decimal, sdg:rotationPeriod some xsd:integer, sdg:custodianName some xsd:string, sdg:stores min 2 sdg:Carpet, sdg:displays some sdg:DesignPattern

Class: sdg:MarketRegion
    Annotations: rdfs:label "Carpet Market Region", iao:0000115 "A geographic area where carpets were traded, consumed, or culturally integrated, such as Europe or the Far East."
    SubClassOf: bfo:0000015, sdg:regionId some xsd:string, sdg:regionName some xsd:string, sdg:importVolume some xsd:integer, sdg:primaryUse some xsd:string, sdg:culturalAdoption some xsd:string, sdg:tradeRoute some xsd:string, sdg:householdCount some xsd:integer, sdg:housingStartsRate some xsd:decimal, sdg:marketMaturity some xsd:string, sdg:isTargetMarket some xsd:boolean, sdg:imports min 2 sdg:Carpet, sdg:suppliedBy some sdg:Workshop, sdg:contains some sdg:DistributionChannel, sdg:targets some sdg:IoTDevice

Class: sdg:IndigenousKnowledgeBase
    Annotations: rdfs:label "Indigenous Knowledge Base", iao:0000115 "A dynamic, community-held repository of traditional ecological knowledge, practices, and cultural understandings related to environmental hazards and land management."
    SubClassOf: cco:ont00000995, sdg:knowledgeBaseId some xsd:string, sdg:communityName some xsd:string, sdg:region some sdg:RegionKind, sdg:primaryHazardType some xsd:string, sdg:transmissionMode some sdg:TransmissionModeKind, sdg:lastVerifiedDate some xsd:dateTime, sdg:isIntegrated some xsd:boolean, sdg:coversRegion exactly 1 sdg:Community, sdg:informsRiskReductionStrategy some sdg:RiskReductionStrategy, sdg:interactsWith some sdg:ScientificKnowledgeBase
    HasKey: sdg:knowledgeBaseId

Class: sdg:ScientificKnowledgeBase
    Annotations: rdfs:label "Scientific Knowledge Base", iao:0000115 "A structured, empirically validated collection of data, models, and technical assessments regarding environmental hazards and community vulnerability."
    SubClassOf: cco:ont00000995, sdg:knowledgeBaseId some xsd:string, sdg:dataSource some xsd:string, sdg:modelType some sdg:ModelTypeKind, sdg:resolution some sdg:ResolutionKind, sdg:lastUpdated some xsd:dateTime, sdg:validationStatus some sdg:ValidationStatusKind, sdg:coversRegion exactly 1 sdg:Community, sdg:informsRiskReductionStrategy some sdg:RiskReductionStrategy, sdg:interactsWith some sdg:IndigenousKnowledgeBase

Class: sdg:Community
    Annotations: rdfs:label "Community", iao:0000115 "A distinct social group residing in a specific geographic location, characterized by shared vulnerability to environmental hazards and engagement in risk reduction activities."
    SubClassOf: sdg:CommunityEntity, sdg:communityId some xsd:string, sdg:communityName some xsd:string, sdg:province some xsd:string, sdg:population some xsd:integer, sdg:islandGroup some xsd:string, sdg:primaryLivelihood some sdg:PrimaryLivelihoodKind, sdg:vulnerabilityLevel some sdg:VulnerabilityLevelKind, sdg:livelihoodStrategy some xsd:string, sdg:hostsIndigenousKnowledge some sdg:IndigenousKnowledgeBase, sdg:hostsScientificAssessment some sdg:ScientificKnowledgeBase, sdg:implementsStrategy min 2 sdg:RiskReductionStrategy

Class: sdg:RiskReductionStrategy
    Annotations: rdfs:label "Risk Reduction Strategy", iao:0000115 "A planned intervention or set of practices designed to mitigate community vulnerability to environmental hazards through the integration of indigenous and scientific knowledge."
    SubClassOf: sdg:SecurityAndSafetyMeasure, sdg:strategyId some xsd:string, sdg:strategyName some xsd:string, sdg:integrationLevel some sdg:IntegrationLevelKind, sdg:implementationStatus some sdg:ImplementationStatusKind, sdg:targetHazard some xsd:string, sdg:startDate some xsd:dateTime, sdg:endDate some xsd:dateTime, sdg:strategyType some xsd:string, sdg:appliedIn exactly 1 sdg:Community, sdg:drawsFromIndigenousKnowledge some sdg:IndigenousKnowledgeBase, sdg:drawsFromScientificKnowledge some sdg:ScientificKnowledgeBase
    HasKey: sdg:strategyId

Class: sdg:EnvironmentalHazard
    Annotations: rdfs:label "Environmental Hazard", iao:0000115 "A natural or anthropogenic event or condition that poses a threat to human life, property, or the environment within a specific geographic area."
    SubClassOf: bfo:0000015, sdg:hazardId some xsd:string, sdg:hazardType some xsd:string, sdg:frequency some sdg:FrequencyKind, sdg:magnitude some xsd:decimal, sdg:affectedArea some xsd:string, sdg:lastOccurrence some xsd:dateTime, sdg:threatens some sdg:Community, sdg:monitoredBy some sdg:ScientificKnowledgeBase

Class: sdg:DatabaseInstance
    Annotations: rdfs:label "Database Instance", iao:0000115 "A specific operational deployment of an Oracle database software environment, including its memory structures and background processes."
    SubClassOf: bfo:0000040, sdg:instanceId some xsd:string, sdg:version some xsd:string, sdg:operatingSystem some xsd:string, sdg:status some sdg:StatusKind, sdg:environmentType some xsd:string, sdg:createdDate some xsd:dateTime, sdg:runsOn exactly 1 sdg:ServerHost, sdg:managedBy some sdg:DBA, sdg:usesStorage some sdg:StorageStructure

Class: sdg:ServerHost
    Annotations: rdfs:label "Server Host", iao:0000115 "The physical or virtual machine hardware and operating system environment where the database instance resides."
    SubClassOf: bfo:0000040, sdg:hostId some xsd:string, sdg:osType some xsd:string, sdg:osVersion some xsd:string, sdg:cpuCount some xsd:integer, sdg:ramGB some xsd:decimal, sdg:sanAllocationGB some xsd:decimal, sdg:hostsInstance some sdg:DatabaseInstance
    HasKey: sdg:hostId

Class: sdg:StorageStructure
    Annotations: rdfs:label "Storage Structure", iao:0000115 "The logical and physical data storage components of the database, including tablespaces, datafiles, and blocks."
    SubClassOf: bfo:0000040, sdg:structureId some xsd:string, sdg:structureType some sdg:StructureTypeKind, sdg:sizeGB some xsd:decimal, sdg:storageLocation some xsd:string, sdg:partOfInstance exactly 1 sdg:DatabaseInstance
    HasKey: sdg:structureId

Class: sdg:DBA
    Annotations: rdfs:label "Database Administrator", iao:0000115 "A person or role responsible for the installation, configuration, maintenance, and performance tuning of the database system."
    SubClassOf: bfo:0000002, sdg:dbaId some xsd:string, sdg:name some sdg:NameKind, sdg:yearsExperience some xsd:integer, sdg:specialization some sdg:SpecializationKind, sdg:employer some sdg:EmployerKind, sdg:managesInstance some sdg:DatabaseInstance, sdg:performsTask some sdg:MaintenanceTask

Class: sdg:MaintenanceTask
    Annotations: rdfs:label "Maintenance Task", iao:0000115 "A specific operational activity performed on the database, such as backup, recovery, tuning, or patching."
    SubClassOf: bfo:0000015, sdg:taskId some xsd:string, sdg:taskType some sdg:TaskTypeKind, sdg:startDate some xsd:dateTime, sdg:endDate some xsd:dateTime, sdg:status some sdg:StatusKind, sdg:toolUsed some xsd:string, sdg:executedBy exactly 1 sdg:DBA, sdg:targetsInstance exactly 1 sdg:DatabaseInstance

Class: sdg:PerformanceReport
    Annotations: rdfs:label "Performance Report", iao:0000115 "A generated document or dataset containing metrics and analysis of database performance, such as STATSPACK or AWR reports."
    SubClassOf: sdg:Report, sdg:reportId some xsd:string, sdg:reportType some sdg:ReportTypeKind, sdg:generatedDate some xsd:dateTime, sdg:durationHours some xsd:decimal, sdg:topWaitEvent some xsd:string, sdg:reportDate some xsd:dateTime, sdg:periodStart some xsd:dateTime, sdg:periodEnd some xsd:dateTime, sdg:trailingReturn some xsd:decimal, sdg:benchmarkReturn some xsd:decimal, sdg:standardDeviation some xsd:decimal, sdg:sharpeRatio some xsd:decimal, sdg:alpha some xsd:decimal, sdg:beta some xsd:decimal, sdg:generatedForInstance exactly 1 sdg:DatabaseInstance, sdg:createdBy exactly 1 sdg:DBA, sdg:reportsForFund exactly 1 sdg:Fund, sdg:reportsForUnderlyingFund some sdg:UnderlyingFund, sdg:comparedToBenchmark exactly 1 sdg:BenchmarkIndex, sdg:generatedByManager exactly 1 sdg:FundManager
    HasKey: sdg:reportId

Class: sdg:MenuSection
    Annotations: rdfs:label "Menu Section", iao:0000115 "A categorical grouping of menu items, such as Starters, Mains, or Sides."
    SubClassOf: cco:ont00000995, sdg:sectionId some xsd:string, sdg:name some sdg:NameKind, sdg:sortOrder some xsd:integer, sdg:containsItem min 2 sdg:MenuItem

Class: sdg:InstitutionalReform
    Annotations: rdfs:label "Institutional Reform Process", iao:0000115 "A strategic reform process undertaken by the Inter-University Council for East Africa to reposition itself and address its expanded mandate within the East African Community framework."
    SubClassOf: bfo:0000015, sdg:reformId some xsd:string, sdg:initiationDate some xsd:dateTime, sdg:ratificationDate some xsd:date, sdg:legalBasis some xsd:string, sdg:status some sdg:StatusKind, sdg:mandateScope some xsd:string, sdg:resultedIn some sdg:QualityAssuranceSystem

Class: sdg:RegionalQualificationsFramework
    Annotations: rdfs:label "Regional Qualifications Framework", iao:0000115 "A harmonized framework articulating the structure of education and training systems, qualification levels, credit systems, and recognition of prior learning to facilitate mutual recognition of qualifications across the East African Community."
    SubClassOf: cco:ont00000995, sdg:frameworkId some xsd:string, sdg:name some sdg:NameKind, sdg:version some xsd:string, sdg:status some sdg:StatusKind, sdg:totalLevels some xsd:integer, sdg:creditSystemType some xsd:string, sdg:supports some sdg:QualityAssuranceSystem
    HasKey: sdg:frameworkId

Class: sdg:QualityAssuranceOffice
    Annotations: rdfs:label "Regional Quality Assurance Office", iao:0000115 "A dedicated office established at the IUCEA Secretariat to manage, coordinate, and oversee the implementation of the regional quality assurance system for higher education institutions."
    SubClassOf: bfo:0000015, sdg:officeId some xsd:string, sdg:officeName some xsd:string, sdg:establishmentDate some xsd:date, sdg:location some xsd:string, sdg:status some sdg:StatusKind, sdg:staffCount some xsd:integer, sdg:manages exactly 1 sdg:QualityAssuranceSystem, sdg:conducts some sdg:CapacityBuildingTraining

Class: sdg:CapacityBuildingTraining
    Annotations: rdfs:label "Capacity Building Training Program", iao:0000115 "Training programs provided to staff in universities and national higher education commissions/councils to build their capacity for implementing the regional quality assurance system."
    SubClassOf: bfo:0000015, sdg:trainingId some xsd:string, sdg:title some xsd:string, sdg:startDate some xsd:dateTime, sdg:endDate some xsd:dateTime, sdg:targetAudience some sdg:TargetAudienceKind, sdg:status some sdg:StatusKind, sdg:participantsCount some xsd:integer, sdg:organizedBy exactly 1 sdg:QualityAssuranceOffice, sdg:deliveredTo min 2 sdg:NationalCommission, sdg:covers exactly 1 sdg:QualityAssuranceSystem

Class: sdg:NationalCommission
    Annotations: rdfs:label "National Higher Education Commission", iao:0000115 "A national body responsible for higher education regulation and quality assurance within a specific Partner State of the East African Community, participating in the regional harmonization process."
    SubClassOf: cco:ont00000995, sdg:commissionId some xsd:string, sdg:name some sdg:NameKind, sdg:country some sdg:CountryKind, sdg:establishmentDate some xsd:date, sdg:status some sdg:StatusKind, sdg:jurisdictionLevel some sdg:JurisdictionLevelKind, sdg:participatesIn__escalated some sdg:QualityAssuranceSystem, sdg:receivesTraining some sdg:CapacityBuildingTraining, sdg:collaboratesWith min 2 sdg:University

Class: sdg:SafeguardingPolicy
    Annotations: rdfs:label "Safeguarding Policy", iao:0000115 "A formal document establishing procedures and commitments for protecting students from harm, aligned with national and international legal frameworks."
    SubClassOf: sdg:GovernmentPolicy, sdg:policyIdentifier some xsd:string, sdg:effectiveDate some xsd:date, sdg:issuingAuthorityDetail some xsd:string, sdg:jurisdiction some sdg:JurisdictionKind, sdg:complianceStatus some sdg:ComplianceStatusKind, sdg:lastReviewDate some xsd:date, sdg:complianceStandard some sdg:ComplianceStandardKind, sdg:reviewCycle some xsd:integer, sdg:status some sdg:StatusKind, sdg:mandatedBy some sdg:LegalStatute, sdg:implementedBy min 2 sdg:SafeguardingProcedure, sdg:scopeOfProtection some sdg:Student, sdg:supersedes max 1 sdg:SafeguardingPolicy, sdg:mandatedBy min 2 sdg:LegalFramework, sdg:appliesTo some sdg:Student, sdg:enforcedBy some sdg:StaffMember

Class: sdg:SafeguardingProcedure
    Annotations: rdfs:label "Safeguarding Procedure", iao:0000115 "A defined operational process for identifying, reporting, and responding to risks or incidents of harm to students."
    SubClassOf: sdg:SecurityAndSafetyMeasure, sdg:procedureCode some xsd:string, sdg:procedureName some xsd:string, sdg:triggerCondition some xsd:string, sdg:responseTimeLimit some xsd:decimal, sdg:status some sdg:StatusKind, sdg:assignedRoleDetail some xsd:string, sdg:targetPopulationDetail some sdg:TargetPopulationKind, sdg:executedBy min 2 sdg:StaffRole, sdg:addresses min 2 sdg:HarmType, sdg:triggers some sdg:IncidentReport
    HasKey: sdg:procedureCode

Class: sdg:HarmType
    Annotations: rdfs:label "Harm Type", iao:0000115 "A category of maltreatment or risk to a student's physical, emotional, or sexual well-being, as defined by safeguarding standards."
    SubClassOf: bfo:0000015, sdg:harmCode some xsd:string, sdg:harmCategory some xsd:string, sdg:severityLevel some sdg:SeverityLevelKind, sdg:description some xsd:string, sdg:requiresMandatoryReporting some xsd:boolean, sdg:reportedIn min 2 sdg:IncidentReport, sdg:observedIn min 2 sdg:Student

Class: sdg:PhysicalLocation
    Annotations: rdfs:label "Physical School Location", iao:0000115 "A material entity representing the physical premises where the educational institution conducts its operations and classes."
    SubClassOf: bfo:0000040, sdg:streetAddress some xsd:string, sdg:city some xsd:string, sdg:state some xsd:string, sdg:postalCode some xsd:string, sdg:country some sdg:CountryKind, sdg:buildingFloors some xsd:integer, sdg:totalAreaSqFt some xsd:decimal, sdg:contains min 2 sdg:Classroom, sdg:locatedIn exactly 1 sdg:Jurisdiction

Class: sdg:Classroom
    Annotations: rdfs:label "Classroom", iao:0000115 "A physical room within the school facility designated for instructional activities."
    SubClassOf: bfo:0000040, sdg:roomIdentifier some xsd:string, sdg:capacity some xsd:integer, sdg:equipmentInventory some xsd:string, sdg:locatedIn exactly 1 sdg:PhysicalLocation, sdg:hosts min 2 sdg:InstructionalSession

Class: sdg:InstructionalSession
    Annotations: rdfs:label "Instructional Session", iao:0000115 "A scheduled period of teaching and learning activity conducted for students."
    SubClassOf: sdg:EducationalEntity, sdg:sessionIdentifier some xsd:string, sdg:startDate some xsd:dateTime, sdg:endDate some xsd:dateTime, sdg:status some sdg:StatusKind, sdg:participationMode some xsd:string, sdg:heldIn exactly 1 sdg:Classroom, sdg:instructedBy exactly 1 sdg:FacultyMember, sdg:enrolls min 2 sdg:Student

Class: sdg:StudentSurvey
    Annotations: rdfs:label "Student Survey", iao:0000115 "A record of feedback collected from students regarding the ESL program and teachers."
    SubClassOf: cco:ont00000995, sdg:surveyId some xsd:string, sdg:collectionDate some xsd:dateTime, sdg:feedbackCategory some xsd:string, sdg:satisfactionScore some xsd:decimal, sdg:comments some xsd:string, sdg:submittedBy exactly 1 sdg:Student, sdg:evaluates exactly 1 sdg:FacultyMember, sdg:reviews exactly 1 sdg:InstructionalSession
    HasKey: sdg:surveyId

Class: sdg:Accreditation
    Annotations: rdfs:label "Accreditation", iao:0000115 "A formal recognition granted by an accrediting agency validating the institution's compliance with educational standards."
    SubClassOf: cco:ont00000995, sdg:accreditationId some xsd:string, sdg:issuingAgency some xsd:string, sdg:startDate some xsd:dateTime, sdg:endDate some xsd:dateTime, sdg:status some sdg:StatusKind, sdg:grantedTo exactly 1 sdg:Institution

Class: sdg:I20Form
    Annotations: rdfs:label "I-20 Form", iao:0000115 "A certificate of eligibility for nonimmigrant student status issued by the institution via the SEVIS system."
    SubClassOf: cco:ont00000995, sdg:formId some xsd:string, sdg:issueDate some xsd:date, sdg:sevisId some xsd:string, sdg:programStartDate some xsd:date, sdg:programEndDate some xsd:date, sdg:fundingSource some sdg:FundingSourceKind, sdg:issuedTo exactly 1 sdg:Student, sdg:issuedBy exactly 1 sdg:Institution

Class: sdg:InformationLogisticsStrategy
    Annotations: rdfs:label "Information Logistics Strategy", iao:0000115 "A coordinated enterprise-wide plan to systematically pursue long-range aggregate goals for information logistics in sync with IT and business strategy."
    SubClassOf: bfo:0000015, sdg:strategyIdentifier some xsd:string, sdg:formulationDate some xsd:dateTime, sdg:implementationStatus some sdg:ImplementationStatusKind, sdg:targetOrganizationalScope some xsd:string, sdg:alignmentWithITStrategy some xsd:boolean, sdg:alignmentWithBusinessStrategy some xsd:boolean, sdg:targetScope some xsd:string, sdg:alignmentLevel some xsd:decimal, sdg:influencedBy some sdg:SuccessFactor, sdg:evaluatedBy some sdg:EmpiricalStudy, sdg:implementedBy some sdg:OrganizationalUnit, sdg:governs min 2 sdg:AnalyticalInformationSystem, sdg:evaluatedBy min 2 sdg:PerformanceMetric

Class: sdg:SuccessFactor
    Annotations: rdfs:label "Critical Success Factor", iao:0000115 "A specific organizational or operational factor identified as significantly influencing the success of an information logistics strategy implementation."
    SubClassOf: bfo:0000015, sdg:factorName some xsd:string, sdg:factorCategory some xsd:string, sdg:validationStatus some sdg:ValidationStatusKind, sdg:influenceStrength some xsd:decimal, sdg:measurementMethod some xsd:string, sdg:factorIdentifier some xsd:string, sdg:impactCoefficient some xsd:decimal, sdg:contributesTo some sdg:InformationLogisticsStrategy, sdg:measuredIn some sdg:EmpiricalStudy, sdg:measuredBy exactly 1 sdg:PerformanceMetric, sdg:contextualizedIn some sdg:OrganizationalUnit

Class: sdg:OrganizationalPerformance
    Annotations: rdfs:label "Organizational Performance Metric", iao:0000115 "A measurable outcome or indicator reflecting the effectiveness and efficiency of an organization's information logistics strategy implementation."
    SubClassOf: sdg:BusinessEntity, sdg:metricName some xsd:string, sdg:measurementDate some xsd:dateTime, sdg:value some xsd:decimal, sdg:unitOfMeasure some sdg:UnitOfMeasureKind, sdg:performanceCategory some xsd:string, sdg:measuredOutcome some xsd:string, sdg:resultOf exactly 1 sdg:InformationLogisticsStrategy, sdg:recordedIn some sdg:EmpiricalStudy

Class: sdg:OrganizationalUnit
    Annotations: rdfs:label "Organizational Unit", iao:0000115 "A distinct functional division or department within an enterprise responsible for implementing or utilizing information logistics strategies."
    SubClassOf: bfo:0000015, sdg:unitIdentifier some xsd:string, sdg:unitName some xsd:string, sdg:departmentType some sdg:DepartmentTypeKind, sdg:implementationRole some xsd:string, sdg:departmentCode some xsd:string, sdg:headCount some xsd:integer, sdg:budgetAllocation some xsd:decimal, sdg:implements some sdg:InformationLogisticsStrategy, sdg:utilizes some sdg:AnalyticalInformationSystem, sdg:owns min 2 sdg:AnalyticalInformationSystem, sdg:employs min 3 sdg:DecisionMaker, sdg:participatesIn__escalated some sdg:InformationLogisticsStrategy, sdg:reportsTo max 1 sdg:OrganizationalUnit

Class: sdg:AnalyticalInformationSystem
    Annotations: rdfs:label "Analytical Information System", iao:0000115 "An enterprise application component designed to deliver analytical information to stakeholders for decision-making purposes, extending traditional business intelligence."
    SubClassOf: cco:ont00000995, sdg:systemIdentifier some xsd:string, sdg:systemName some xsd:string, sdg:systemType some xsd:string, sdg:deploymentDate some xsd:dateTime, sdg:coverageScope some sdg:CoverageScopeKind, sdg:uptimePercentage some xsd:decimal, sdg:supports some sdg:OrganizationalUnit, sdg:extends some sdg:AnalyticalInformationSystem, sdg:deployedIn some sdg:OrganizationalUnit, sdg:supports min 2 sdg:DecisionMaker, sdg:supersededBy max 1 sdg:InformationLogisticsStrategy

Class: sdg:MigrationEvent
    Annotations: rdfs:label "Migration Event", iao:0000115 "A discrete movement of a Russian citizen across Georgia's border into the country, either as a transit or permanent relocation."
    SubClassOf: bfo:0000015, sdg:eventIdentifier some xsd:string, sdg:arrivalDate some xsd:date, sdg:departureCountry some xsd:string, sdg:destinationCity some xsd:string, sdg:purposeOfStay some xsd:string, sdg:isTransit some xsd:boolean, sdg:originatedFrom exactly 1 sdg:Country, sdg:arrivedIn exactly 1 sdg:City, sdg:involves min 1 sdg:Migrant

Class: sdg:Migrant
    Annotations: rdfs:label "Russian Migrant", iao:0000115 "A Russian citizen who has relocated to Georgia, either temporarily or permanently, often fleeing mobilization or political conditions."
    SubClassOf: bfo:0000004, sdg:migrantId some xsd:string, sdg:nationality some xsd:string, sdg:residenceStatus some xsd:string, sdg:employmentType some sdg:EmploymentTypeKind, sdg:salaryLevel some xsd:decimal, sdg:languageProficiency some xsd:string, sdg:integrationIntent some xsd:string, sdg:participatedIn min 1 sdg:MigrationEvent, sdg:residesIn exactly 1 sdg:City, sdg:employs max 1 sdg:Business, sdg:perceivedBy min 2 sdg:Local
    HasKey: sdg:migrantId

Class: sdg:Local
    Annotations: rdfs:label "Georgian Local", iao:0000115 "A citizen or resident of Georgia who holds opinions and perceptions about Russian migrants and their integration."
    SubClassOf: bfo:0000004, sdg:localId some xsd:string, sdg:nationality some xsd:string, sdg:residenceCity some xsd:string, sdg:languageProficiency some xsd:string, sdg:perceptionOfMigrants some xsd:string, sdg:employmentSector some xsd:string, sdg:perceives min 2 sdg:Migrant, sdg:residesIn exactly 1 sdg:City, sdg:employs max 1 sdg:Business

Class: sdg:City
    Annotations: rdfs:label "Georgian City", iao:0000115 "A population center in Georgia where Russian migrants have resettled, such as Tbilisi or Batumi."
    SubClassOf: bfo:0000002, sdg:cityId some xsd:string, sdg:cityName some xsd:string, sdg:region some sdg:RegionKind, sdg:populationDensity some xsd:decimal, sdg:costOfLivingIndex some xsd:decimal, sdg:hosts min 2 sdg:Migrant, sdg:hosts min 2 sdg:Local, sdg:hosts min 2 sdg:Business

Class: sdg:Business
    Annotations: rdfs:label "Migrant-Owned Business", iao:0000115 "A commercial venture established by Russian migrants in Georgia, such as restaurants, bars, or cafes, often catering to a Russophone clientele."
    SubClassOf: bfo:0000040, sdg:businessId some xsd:string, sdg:businessName some xsd:string, sdg:businessType some xsd:string, sdg:targetClientele some xsd:string, sdg:establishmentDate some xsd:date, sdg:operatingStatus some xsd:string, sdg:ownedBy exactly 1 sdg:Migrant, sdg:locatedIn exactly 1 sdg:City, sdg:serves min 2 sdg:Local
    HasKey: sdg:businessId

Class: sdg:PriceOption
    Annotations: rdfs:label "Price Option", iao:0000115 "A specific pricing configuration for a menu item, including base price, portion size, or add-ons."
    SubClassOf: cco:ont00000995, sdg:optionId some xsd:string, sdg:price some xsd:decimal, sdg:type some sdg:TypeKind, sdg:description some xsd:string, sdg:appliesTo exactly 1 sdg:MenuItem, sdg:modifiesIngredient some sdg:Ingredient

Class: sdg:BreadType
    Annotations: rdfs:label "Bread Type", iao:0000115 "A specific variety of house-made bread used for sandwiches and toast."
    SubClassOf: cco:ont00000995, sdg:breadId some xsd:string, sdg:name some sdg:NameKind, sdg:isHouseMade some xsd:boolean, sdg:breadCode some xsd:string, sdg:breadName some xsd:string, sdg:isGlutenFree some xsd:boolean, sdg:isVegan some xsd:boolean, sdg:usedIn some sdg:MenuItem

Class: sdg:AdvertisingRule
    Annotations: rdfs:label "Advertising Rule", iao:0000115 "A regulatory provision within the Rules Regulating The Florida Bar that governs the content and format of lawyer advertisements."
    SubClassOf: cco:ont00000958, sdg:ruleNumber some xsd:string, sdg:ruleTitle some xsd:string, sdg:effectiveDate some xsd:date, sdg:status some sdg:StatusKind, sdg:sectionIdentifier some xsd:string, sdg:contains min 2 sdg:AdvertisingRequirement, sdg:governs some sdg:Advertisement

Class: sdg:Advertisement
    Annotations: rdfs:label "Advertisement", iao:0000115 "A communicative record or media instance created to promote legal services, subject to regulatory compliance."
    SubClassOf: cco:ont00000995, sdg:adIdentifier some xsd:string, sdg:mediaType some sdg:MediaTypeKind, sdg:publicationDate some xsd:date, sdg:complianceStatus some sdg:ComplianceStatusKind, sdg:language some sdg:LanguageKind, sdg:feeOffered some xsd:decimal, sdg:feeValidityDays some xsd:integer, sdg:createdBy exactly 1 sdg:Lawyer, sdg:governedBy some sdg:AdvertisingRule, sdg:mentions some sdg:LegalClaim, sdg:includes some sdg:Disclaimer

Class: sdg:Lawyer
    Annotations: rdfs:label "Lawyer", iao:0000115 "A legal professional holding a role within The Florida Bar or providing legal services in Florida, subject to advertising regulations."
    SubClassOf: bfo:0000023, sdg:barMembershipNumber some xsd:string, sdg:lawyerName some xsd:string, sdg:firmName some xsd:string, sdg:officeLocation some xsd:string, sdg:certificationStatus some sdg:CertificationStatusKind, sdg:isOutofState some xsd:boolean, sdg:practiceAreas some xsd:string, sdg:employs some sdg:Lawyer, sdg:creates some sdg:Advertisement, sdg:providesReferralTo some sdg:Lawyer

Class: sdg:LegalClaim
    Annotations: rdfs:label "Legal Claim", iao:0000115 "A factual assertion or representation made within an advertisement regarding legal services, results, or qualifications."
    SubClassOf: cco:ont00000995, sdg:claimText some xsd:string, sdg:claimType some xsd:string, sdg:isVerifiable some xsd:boolean, sdg:isMisleading some xsd:boolean, sdg:requiresDisclaimer some xsd:boolean, sdg:disclaimerText some xsd:string, sdg:appearsIn exactly 1 sdg:Advertisement, sdg:evaluatedBy exactly 1 sdg:AdvertisingRule

Class: sdg:Disclaimer
    Annotations: rdfs:label "Disclaimer", iao:0000115 "A mandatory textual or visual statement included in an advertisement to clarify context, limit liability, or identify non-lawyer participants."
    SubClassOf: cco:ont00000995, sdg:disclaimerText some xsd:string, sdg:disclaimerType some xsd:string, sdg:prominenceLevel some sdg:ProminenceLevelKind, sdg:isMandatory some xsd:boolean, sdg:attachedTo exactly 1 sdg:Advertisement, sdg:requiredBy some sdg:AdvertisingRule

Class: sdg:AdvertisingRequirement
    Annotations: rdfs:label "Advertising Requirement", iao:0000115 "A specific procedural or content obligation imposed by a regulatory rule that must be satisfied for an advertisement to be compliant."
    SubClassOf: sdg:Document, sdg:requirementText some xsd:string, sdg:requirementCategory some sdg:RequirementCategoryKind, sdg:isSafeHarbor some xsd:boolean, sdg:appliesToMedia some xsd:string, sdg:contentSpecification some xsd:string, sdg:specifiedIn exactly 1 sdg:AdvertisingRule, sdg:appliesTo some sdg:Advertisement

Class: sdg:GovernanceBoard
    Annotations: rdfs:label "Governance Board", iao:0000115 "A collective body of individuals responsible for the oversight and strategic direction of an organization."
    SubClassOf: bfo:0000023, sdg:boardId some xsd:string, sdg:boardName some xsd:string, sdg:organizationId some xsd:string, sdg:establishedDate some xsd:date, sdg:status some sdg:StatusKind, sdg:establishmentDate some xsd:date, sdg:governanceScope some xsd:string, sdg:meetingFrequency some sdg:MeetingFrequencyKind, sdg:decisionAuthority some xsd:string, sdg:oversees exactly 1 sdg:Organization, sdg:hasMember min 2 sdg:BoardMember, sdg:coChairedBy min 2 sdg:ChiefInformationOfficer, sdg:governs min 2 sdg:InteroperabilityStandard, sdg:manages exactly 1 sdg:InformationEnvironment

Class: sdg:AcademicQualification
    Annotations: rdfs:label "Academic Qualification", iao:0000115 "A formal credential or degree awarded by an educational institution to an individual."
    SubClassOf: sdg:EducationalEntity, sdg:qualId some xsd:string, sdg:degreeType some xsd:string, sdg:fieldOfStudy some xsd:string, sdg:awardingInstitution some xsd:string, sdg:graduationYear some xsd:integer, sdg:distinction some xsd:string, sdg:credentialType some sdg:CredentialTypeKind, sdg:qualificationId some xsd:string, sdg:distinctionLevel some xsd:string, sdg:heldBy exactly 1 sdg:Person, sdg:awardedBy exactly 1 sdg:Organization, sdg:heldBy exactly 1 sdg:ProjectManager, sdg:awardedBy exactly 1 sdg:Institution

Class: sdg:BusinessVenture
    Annotations: rdfs:label "Business Venture", iao:0000115 "A specific commercial enterprise, project, or asset with operational activities and financial outcomes."
    SubClassOf: sdg:BusinessEntity, sdg:ventureId some xsd:string, sdg:ventureName some xsd:string, sdg:industrySector some sdg:IndustrySectorKind, sdg:operationalStatus some sdg:OperationalStatusKind, sdg:geographicScope some xsd:string, sdg:ownedBy some sdg:Organization, sdg:directedBy some sdg:Person, sdg:locatedIn some sdg:Location

Class: sdg:NotificationContact
    Annotations: rdfs:label "Notification Contact", iao:0000115 "A real, independent continuant entity representing a person or organization to be notified about a memorial or honor gift."
    SubClassOf: bfo:0000040, sdg:contactId some xsd:string, sdg:contactName some xsd:string, sdg:streetAddress some xsd:string, sdg:city some xsd:string, sdg:state some xsd:string, sdg:zipCode some xsd:string, sdg:relationship some sdg:RelationshipKind, sdg:notifiesAbout some sdg:Honoree

Class: sdg:Fund
    Annotations: rdfs:label "Fund", iao:0000115 "A real, independent continuant entity representing a specific financial category, program, or purpose to which a donation is directed."
    SubClassOf: bfo:0000040, sdg:fundId some xsd:string, sdg:fundName some xsd:string, sdg:fundDescription some xsd:string, sdg:fundIdentifier some xsd:string, sdg:inceptionDate some xsd:date, sdg:fundClass some xsd:string, sdg:totalAssetsUnderManagement some xsd:decimal, sdg:managementFeeRate some xsd:decimal, sdg:performanceFeeRate some xsd:decimal, sdg:charitableDonationStatus some xsd:boolean, sdg:receivesDonation some sdg:Donation, sdg:holdsUnderlyingFund min 2 sdg:UnderlyingFund, sdg:tracksBenchmark exactly 1 sdg:BenchmarkIndex, sdg:reportsPerformance min 2 sdg:PerformanceReport, sdg:donatesToCharity exactly 1 sdg:CharitableCause

Class: sdg:ExerciseBook
    Annotations: rdfs:label "Exercise Book", iao:0000115 "A physical notebook or pad of paper used by students for writing exercises, assignments, and practice work."
    SubClassOf: cco:ont00000995, sdg:code some xsd:string, sdg:description some xsd:string, sdg:size some xsd:string, sdg:lineType some xsd:string, sdg:unitPrice some xsd:decimal, sdg:requiredQuantity some xsd:integer, sdg:subject some xsd:string, sdg:isCompulsory some xsd:boolean, sdg:assignedTo exactly 1 sdg:GradeLevel, sdg:usedFor some sdg:Subject

Class: sdg:StationeryItem
    Annotations: rdfs:label "Stationery Item", iao:0000115 "A non-book educational supply or material used in the classroom or for homework, such as files, folders, or art supplies."
    SubClassOf: cco:ont00000995, sdg:code some xsd:string, sdg:description some xsd:string, sdg:unitPrice some xsd:decimal, sdg:requiredQuantity some xsd:integer, sdg:isCompulsory some xsd:boolean, sdg:color some xsd:string, sdg:assignedTo exactly 1 sdg:GradeLevel, sdg:usedFor some sdg:Subject
    HasKey: sdg:code

Class: sdg:GradeLevel
    Annotations: rdfs:label "Grade Level", iao:0000115 "A specific academic year or cohort within a primary school system, defining the curriculum and materials required."
    SubClassOf: bfo:0000015, sdg:gradeNumber some xsd:integer, sdg:academicYear some xsd:string, sdg:schoolName some xsd:string, sdg:gradeIdentifier some xsd:string, sdg:description some xsd:string, sdg:requires min 2 sdg:Textbook, sdg:requires min 2 sdg:ExerciseBook, sdg:requires min 2 sdg:StationeryItem, sdg:participatesIn__escalated some sdg:WebinarSession

Class: sdg:Publisher
    Annotations: rdfs:label "Publisher", iao:0000115 "An organization responsible for the production and distribution of educational textbooks and workbooks."
    SubClassOf: sdg:Book, sdg:name some sdg:NameKind, sdg:publishes min 2 sdg:Textbook, sdg:role some sdg:Thing

Class: sdg:BoardAppointment
    Annotations: rdfs:label "Board Appointment", iao:0000115 "A formal act of appointing an individual to a specific board or trusteeship for a defined term."
    SubClassOf: bfo:0000015, sdg:appointmentId some xsd:string, sdg:appointmentDate some xsd:date, sdg:termStartDate some xsd:date, sdg:termEndDate some xsd:date, sdg:termLengthYears some xsd:integer, sdg:confirmationStatus some xsd:string, sdg:statutoryAuthority some xsd:string, sdg:roleTitle some sdg:RoleTitleKind, sdg:appointmentStatus some sdg:AppointmentStatusKind, sdg:appoints min 1 sdg:BoardMember, sdg:governs exactly 1 sdg:BoardOfTrustees, sdg:issuedBy exactly 1 sdg:CountyExecutive, sdg:appointsPerson exactly 1 sdg:Person, sdg:appointsToOrganization exactly 1 sdg:NonProfitOrganization, sdg:succeedsPreviousAppointee max 1 sdg:Person
    HasKey: sdg:appointmentId

Class: sdg:BoardOfTrustees
    Annotations: rdfs:label "Board of Trustees", iao:0000115 "A formal governing body or commission established to oversee the operations and assets of a specific public institution."
    SubClassOf: bfo:0000015, sdg:boardId some xsd:string, sdg:boardName some xsd:string, sdg:establishmentDate some xsd:date, sdg:governingStatute some xsd:string, sdg:jurisdiction some sdg:JurisdictionKind, sdg:hasMember min 2 sdg:BoardMember, sdg:oversees exactly 1 sdg:PublicInstitution, sdg:operatesUnder exactly 1 sdg:CountyJurisdiction

Class: sdg:CountyJurisdiction
    Annotations: rdfs:label "County Jurisdiction", iao:0000115 "A specific geographic and administrative territory governed by a county-level legislative and executive authority."
    SubClassOf: bfo:0000015, sdg:jurisdictionId some xsd:string, sdg:jurisdictionName some xsd:string, sdg:stateCode some xsd:string, sdg:legislativeBody some xsd:string, sdg:appoints exactly 1 sdg:BoardOfTrustees, sdg:employs exactly 1 sdg:CountyExecutive, sdg:contains some sdg:PublicInstitution

Class: sdg:CountyExecutive
    Annotations: rdfs:label "County Executive", iao:0000115 "The chief administrative officer of a county government who holds the statutory authority to make or recommend appointments to public boards."
    SubClassOf: bfo:0000015, sdg:executiveId some xsd:string, sdg:fullName some xsd:string, sdg:termStartDate some xsd:date, sdg:termEndDate some xsd:date, sdg:appointmentAuthority some xsd:string, sdg:issues min 1 sdg:BoardAppointment, sdg:servesIn exactly 1 sdg:CountyJurisdiction

Class: sdg:PublicInstitution
    Annotations: rdfs:label "Public Institution", iao:0000115 "A physical or organizational entity owned or operated by the government for public use, such as a memorial or cultural center."
    SubClassOf: bfo:0000015, sdg:institutionId some xsd:string, sdg:institutionName some xsd:string, sdg:institutionType some sdg:InstitutionTypeKind, sdg:locationAddress some xsd:string, sdg:operationalStatus some sdg:OperationalStatusKind, sdg:isOverseenBy exactly 1 sdg:BoardOfTrustees, sdg:locatedIn exactly 1 sdg:CountyJurisdiction
    HasKey: sdg:institutionId

Class: sdg:StrategicInitiative
    Annotations: rdfs:label "Strategic Initiative", iao:0000115 "A planned organizational activity or program designed to achieve specific business growth or operational goals."
    SubClassOf: bfo:0000015, sdg:initiativeId some xsd:string, sdg:initiativeName some xsd:string, sdg:targetRegion some xsd:string, sdg:status some sdg:StatusKind, sdg:description some xsd:string, sdg:drivenBy some sdg:ProfessionalRole, sdg:targetsMarket some sdg:GeographicMarket, sdg:supportsIndustry some sdg:IndustrySector

Class: sdg:GeographicMarket
    Annotations: rdfs:label "Geographic Market", iao:0000115 "A specific region, country, or territory targeted for business expansion or operational presence."
    SubClassOf: sdg:GeographicEntity, sdg:marketId some xsd:string, sdg:regionName some xsd:string, sdg:countryCode some sdg:CountryCodeKind, sdg:marketType some sdg:MarketTypeKind, sdg:targetedBy some sdg:StrategicInitiative, sdg:contains some sdg:IndustrySector
    HasKey: sdg:marketId

Class: sdg:IndustrySector
    Annotations: rdfs:label "Industry Sector", iao:0000115 "A specific segment of the economy or professional field served by an organization or initiative."
    SubClassOf: sdg:BusinessEntity, sdg:sectorId some xsd:string, sdg:sectorName some xsd:string, sdg:classificationCode some xsd:string, sdg:isPublicSector some xsd:string, sdg:description some xsd:string, sdg:servedBy some sdg:Organization, sdg:supportedBy some sdg:StrategicInitiative, sdg:targetedBy some sdg:PartnerOrganization

Class: sdg:WorldCafEvent
    Annotations: rdfs:label "World Café Event", iao:0000115 "A structured qualitative research gathering designed to facilitate dialogue and collect expertise on burglary prevention."
    SubClassOf: bfo:0000040, sdg:eventIdentifier some xsd:string, sdg:eventDate some xsd:dateTime, sdg:location some xsd:string, sdg:status some sdg:StatusKind, sdg:durationMinutes some xsd:integer, sdg:participantCount some xsd:integer, sdg:moderatorCount some xsd:integer, sdg:breakCount some xsd:integer, sdg:hasSession min 2 sdg:DiscussionSession, sdg:hasModerator min 2 sdg:FieldModerator, sdg:hasParticipant__escalated min 2 sdg:FieldParticipant, sdg:supportsProject exactly 1 sdg:SecurityProject

Class: sdg:DiscussionSession
    Annotations: rdfs:label "Discussion Session", iao:0000115 "A timed, thematic sub-group conversation within a World Café event where participants exchange views on specific burglary prevention topics."
    SubClassOf: bfo:0000040, sdg:sessionIdentifier some xsd:string, sdg:startTime some xsd:dateTime, sdg:endTime some xsd:dateTime, sdg:durationMinutes some xsd:integer, sdg:theme some xsd:string, sdg:tableNumber some xsd:integer, sdg:status some sdg:StatusKind, sdg:notesSummary some xsd:string, sdg:partOfEvent exactly 1 sdg:WorldCafEvent, sdg:hasModerator exactly 1 sdg:FieldModerator, sdg:hasParticipant__escalated min 3 sdg:FieldParticipant, sdg:generatesInsight min 2 sdg:PreventionInsight, sdg:movesToNextSession max 1 sdg:DiscussionSession

Class: sdg:FieldModerator
    Annotations: rdfs:label "Field Moderator", iao:0000115 "A practitioner facilitating a discussion session, responsible for guiding dialogue, preventing substantive pitfalls, and summarizing key points for subsequent groups."
    SubClassOf: bfo:0000002, sdg:moderatorIdentifier some xsd:string, sdg:fullName some xsd:string, sdg:expertiseArea some xsd:string, sdg:roleDetail some sdg:RoleKind, sdg:sessionCount some xsd:integer, sdg:availabilityStatus some xsd:string, sdg:facilitatesSession min 2 sdg:DiscussionSession, sdg:employedByProject exactly 1 sdg:SecurityProject, sdg:collaboratesWith min 2 sdg:FieldModerator

Class: sdg:FieldParticipant
    Annotations: rdfs:label "Field Participant", iao:0000115 "A practitioner from the daily practice of security or prevention who contributes opinions and visions to the World Café discussions."
    SubClassOf: bfo:0000002, sdg:participantIdentifier some xsd:string, sdg:fullName some xsd:string, sdg:organization some xsd:string, sdg:roleDetail some sdg:RoleKind, sdg:motivationLevel some sdg:MotivationLevelKind, sdg:previousExperience some xsd:boolean, sdg:attendsSession min 2 sdg:DiscussionSession, sdg:providesInsight min 2 sdg:PreventionInsight, sdg:employedByProject exactly 1 sdg:SecurityProject

Class: sdg:PreventionInsight
    Annotations: rdfs:label "Prevention Insight", iao:0000115 "A qualitative finding, opinion, or vision regarding burglary prevention collected from participants, representing a supporting trend or new idea."
    SubClassOf: bfo:0000040, sdg:insightIdentifier some xsd:string, sdg:content some xsd:string, sdg:sourceSession some xsd:string, sdg:theme some xsd:string, sdg:qualityRating some sdg:QualityRatingKind, sdg:isRecurring some xsd:boolean, sdg:isNewElement some xsd:boolean, sdg:generatedBySession exactly 1 sdg:DiscussionSession, sdg:providedByParticipant min 2 sdg:FieldParticipant, sdg:addressesTopic exactly 1 sdg:BurglaryPreventionTopic, sdg:usedInReport max 1 sdg:ProjectReport

Class: sdg:BurglaryPreventionTopic
    Annotations: rdfs:label "Burglary Prevention Topic", iao:0000115 "A specific theme or issue within the domain of domestic burglary prevention that is discussed and analyzed during the World Café."
    SubClassOf: bfo:0000002, sdg:topicIdentifier some xsd:string, sdg:topicName some xsd:string, sdg:category some sdg:CategoryKind, sdg:complexityLevel some xsd:string, sdg:isPrimaryFocus some xsd:boolean, sdg:discussedInSession min 2 sdg:DiscussionSession, sdg:hasInsight min 2 sdg:PreventionInsight, sdg:partOfProject exactly 1 sdg:SecurityProject

Class: sdg:SecurityProject
    Annotations: rdfs:label "Security Project", iao:0000115 "A European initiative aimed at controlling the burglary phenomenon through awareness raising, practice exchange, and strengthening cooperation within the security chain."
    SubClassOf: sdg:SecurityAndSafetyMeasure, sdg:projectIdentifier some xsd:string, sdg:projectName some xsd:string, sdg:startDate some xsd:dateTime, sdg:endDate some xsd:dateTime, sdg:fundingSource some sdg:FundingSourceKind, sdg:status some sdg:StatusKind, sdg:objectives some xsd:string, sdg:projectStatus some sdg:ProjectStatusKind, sdg:organizesEvent min 2 sdg:WorldCafEvent, sdg:employsModerator min 2 sdg:FieldModerator, sdg:engagesParticipant min 2 sdg:FieldParticipant, sdg:addressesTopic min 2 sdg:BurglaryPreventionTopic, sdg:producesReport min 2 sdg:ProjectReport

Class: sdg:ProjectReport
    Annotations: rdfs:label "Project Report", iao:0000115 "A document summarizing the findings, conclusions, and insights derived from the World Café event and the broader security project."
    SubClassOf: bfo:0000040, sdg:reportIdentifier some xsd:string, sdg:title some xsd:string, sdg:publicationDate some xsd:date, sdg:status some sdg:StatusKind, sdg:wordCount some xsd:integer, sdg:containsInsights some xsd:boolean, sdg:derivedFromEvent exactly 1 sdg:WorldCafEvent, sdg:includesInsight min 2 sdg:PreventionInsight, sdg:producedByProject exactly 1 sdg:SecurityProject

Class: sdg:CalendarOrder
    Annotations: rdfs:label "Calendar Order", iao:0000115 "A commercial transaction record for the procurement of promotional flip-style calendars."
    SubClassOf: cco:ont00000995, sdg:orderReference some xsd:string, sdg:orderDate some xsd:dateTime, sdg:unitPrice some xsd:decimal, sdg:setupFee some xsd:decimal, sdg:totalQuantity some xsd:integer, sdg:status some sdg:StatusKind, sdg:submissionDeadline some xsd:date, sdg:orderedBy exactly 1 sdg:BusinessClient, sdg:containsTheme exactly 1 sdg:CalendarTheme, sdg:containsAdCopy exactly 1 sdg:AdCopy, sdg:includesLogo max 1 sdg:CorporateLogo

Class: sdg:BusinessClient
    Annotations: rdfs:label "Business Client", iao:0000115 "A commercial entity or individual submitting an order for promotional materials."
    SubClassOf: sdg:BusinessEntity, sdg:businessName some xsd:string, sdg:contactName some xsd:string, sdg:membershipStatus some sdg:MembershipStatusKind, sdg:emailAddress some xsd:string, sdg:faxNumber some xsd:string, sdg:websiteUrl some xsd:string, sdg:placesOrder min 2 sdg:CalendarOrder, sdg:providesAdCopy min 2 sdg:AdCopy, sdg:orderSubmissionRole some sdg:OrderSubmissionRole

Class: sdg:CalendarTheme
    Annotations: rdfs:label "Calendar Theme", iao:0000115 "A specific visual design category for the calendar, such as automotive or regional scenery."
    SubClassOf: cco:ont00000995, sdg:themeName some xsd:string, sdg:category some sdg:CategoryKind, sdg:previewUrl some xsd:string, sdg:hasOrder min 2 sdg:CalendarOrder

Class: sdg:AdCopy
    Annotations: rdfs:label "Ad Copy", iao:0000115 "The specific text and branding content printed on the calendar's advertisement area."
    SubClassOf: cco:ont00000995, sdg:copyAreaDimensions some xsd:string, sdg:printColor some sdg:PrintColorKind, sdg:language some sdg:LanguageKind, sdg:imprintSource some xsd:string, sdg:belongsToOrder exactly 1 sdg:CalendarOrder, sdg:providedBy exactly 1 sdg:BusinessClient, sdg:featuresLogo max 1 sdg:CorporateLogo

Class: sdg:CorporateLogo
    Annotations: rdfs:label "Corporate Logo", iao:0000115 "A graphical mark or design representing a business, used in the calendar's ad area."
    SubClassOf: cco:ont00000995, sdg:logoType some xsd:string, sdg:vendor some xsd:string, sdg:attachedToOrder min 2 sdg:CalendarOrder, sdg:includedInAd min 2 sdg:AdCopy

Class: sdg:MeasurementActivity
    Annotations: rdfs:label "Measurement Activity", iao:0000115 "A systematic process of gathering, recording, and validating clinical performance metrics through defined protocols and instruments."
    SubClassOf: sdg:ProgramActivity, sdg:activityId some xsd:string, sdg:startTime some xsd:dateTime, sdg:endTime some xsd:dateTime, sdg:protocolVersion some xsd:string, sdg:instrumentUsed some xsd:string, sdg:status some sdg:StatusKind, sdg:performedBy exactly 1 sdg:HealthcareProfessional, sdg:generates min 2 sdg:ClinicalPerformanceData, sdg:partOf__escalated some sdg:QualityImprovementProgram
    HasKey: sdg:activityId

Class: sdg:AnalyticTool
    Annotations: rdfs:label "Analytic Tool", iao:0000115 "A software application, statistical method, or computational framework used to process, analyze, and interpret clinical performance data for quality improvement purposes."
    SubClassOf: cco:ont00000995, sdg:toolId some xsd:string, sdg:toolName some xsd:string, sdg:toolType some sdg:ToolTypeKind, sdg:version some xsd:string, sdg:lastUpdated some xsd:dateTime, sdg:validationStatus some sdg:ValidationStatusKind, sdg:analyzes min 2 sdg:ClinicalPerformanceData, sdg:usedBy some sdg:HealthcareProfessional, sdg:supports some sdg:QualityImprovementProgram

Class: sdg:ActivationKey
    Annotations: rdfs:label "Activation Key", iao:0000115 "A unique alphanumeric string issued by Agena to a customer that authorizes use of the Licensed Software and encodes license parameters."
    SubClassOf: cco:ont00000958, sdg:keyString some xsd:string, sdg:issuedDate some xsd:dateTime, sdg:licenseType some xsd:string, sdg:licensePeriodStart some xsd:date, sdg:licensePeriodEnd some xsd:date, sdg:maxConcurrentSessions some xsd:integer, sdg:grantsAccessTo exactly 1 sdg:LicensedSoftware, sdg:issuedTo exactly 1 sdg:Customer

Class: sdg:LicensedSoftware
    Annotations: rdfs:label "Licensed Software", iao:0000115 "The Agena.ai Modeller application and/or API, including updates and upgrades, licensed to a customer for computational modeling."
    SubClassOf: cco:ont00000995, sdg:softwareName some xsd:string, sdg:versionNumber some xsd:string, sdg:isCloudService some xsd:boolean, sdg:lastUpdated some xsd:dateTime, sdg:activatedBy exactly 1 sdg:ActivationKey, sdg:usedBy some sdg:AuthorisedUser

Class: sdg:AuthorisedUser
    Annotations: rdfs:label "Authorised User", iao:0000115 "A named individual authorized by the Customer to install and use the Licensed Software on a designated machine."
    SubClassOf: bfo:0000002, sdg:userName some xsd:string, sdg:userRole some sdg:UserRoleKind, sdg:isConcurrent some xsd:boolean, sdg:authorizedBy exactly 1 sdg:Customer, sdg:usesSoftware exactly 1 sdg:LicensedSoftware, sdg:occupiesSession max 1 sdg:UserSession

Class: sdg:IdeologicalMovement
    Annotations: rdfs:label "Ideological Movement", iao:0000115 "A structured socio-political organization with a defined doctrine, strategic phases, and territorial or political objectives."
    SubClassOf: bfo:0000015, sdg:movementIdentifier some xsd:string, sdg:foundingYear some xsd:integer, sdg:founderName some xsd:string, sdg:strategicPhase some sdg:StrategicPhaseKind, sdg:ultimateGoal some xsd:string, sdg:operationalTerritory some sdg:OperationalTerritoryKind, sdg:isPolitical some xsd:boolean, sdg:employsStrategy some sdg:StrategicOperation, sdg:operatesInRegion some sdg:GeopoliticalRegion

Class: sdg:StrategicOperation
    Annotations: rdfs:label "Strategic Operation", iao:0000115 "A specific tactical activity or phase of implementation used by an ideological movement to achieve its long-term goals, such as integration or power consolidation."
    SubClassOf: bfo:0000015, sdg:operationCode some xsd:string, sdg:operationName some sdg:OperationNameKind, sdg:description some xsd:string, sdg:targetRegion some xsd:string, sdg:implementationMethod some xsd:string, sdg:isCoercive some xsd:boolean, sdg:isPartOfMovement exactly 1 sdg:IdeologicalMovement, sdg:targetsRegion exactly 1 sdg:GeopoliticalRegion
    HasKey: sdg:operationCode

Class: sdg:GeopoliticalRegion
    Annotations: rdfs:label "Geopolitical Region", iao:0000115 "A defined geographic or political area where an ideological movement operates or seeks to establish influence, such as a country or continent."
    SubClassOf: sdg:GeographicEntity, sdg:regionIdentifier some xsd:string, sdg:regionName some xsd:string, sdg:regionType some sdg:RegionTypeKind, sdg:currentInfluenceLevel some xsd:string, sdg:historicalStatus some xsd:string, sdg:hostsOperation some sdg:StrategicOperation, sdg:containsOrganization some sdg:ReligiousOrganization

Class: sdg:ReligiousOrganization
    Annotations: rdfs:label "Religious Organization", iao:0000115 "A formal institutional body representing a religious community, often linked to a broader ideological movement, with specific membership and leadership structures."
    SubClassOf: sdg:Organization, sdg:orgIdentifier some xsd:string, sdg:orgName some xsd:string, sdg:affiliation some sdg:AffiliationKind, sdg:foundingDate some xsd:date, sdg:headquartersLocation some xsd:string, sdg:isPolitical some xsd:boolean, sdg:membershipCount some xsd:integer, sdg:ideologicalAlignment some xsd:string, sdg:isAffiliatedWith max 1 sdg:IdeologicalMovement, sdg:operatesInRegion some sdg:GeopoliticalRegion, sdg:emplocesPerson some sdg:Individual

Class: sdg:AidRecipient
    Annotations: rdfs:label "Aid Recipient", iao:0000115 "A person who registers to receive Christmas aid packages for their family."
    SubClassOf: bfo:0000004, sdg:contactName some xsd:string, sdg:cellPhone some xsd:string, sdg:physicalAddress some xsd:string, sdg:registrationDeadline some xsd:dateTime, sdg:registrationStatus some sdg:RegistrationStatusKind, sdg:hasDependent min 1 sdg:Child, sdg:registeredFor exactly 1 sdg:AidProgram, sdg:receivesPickupReminder exactly 1 sdg:NotificationEvent

Class: sdg:AidProgram
    Annotations: rdfs:label "Aid Program", iao:0000115 "A charitable initiative providing Christmas aid packages to families in the local area."
    SubClassOf: bfo:0000002, sdg:programName some xsd:string, sdg:season some sdg:SeasonKind, sdg:supportingOrganization some xsd:string, sdg:registrationDeadline some xsd:dateTime, sdg:pickupDate some xsd:date, sdg:pickupStartTime some xsd:dateTime, sdg:pickupEndTime some xsd:dateTime, sdg:deliveredAt exactly 1 sdg:DistributionSite, sdg:enrollsRecipient min 1 sdg:AidRecipient

Class: sdg:DistributionSite
    Annotations: rdfs:label "Distribution Site", iao:0000115 "A physical location where aid packages are made available for family pickup."
    SubClassOf: bfo:0000004, sdg:siteName some xsd:string, sdg:streetAddress some xsd:string, sdg:city some xsd:string, sdg:state some xsd:string, sdg:postalCode some xsd:string, sdg:hostsProgram exactly 1 sdg:AidProgram

Class: sdg:NotificationEvent
    Annotations: rdfs:label "Notification Event", iao:0000115 "A scheduled communication event, such as a text message reminder, sent to participants."
    SubClassOf: sdg:Event, sdg:notificationType some xsd:string, sdg:scheduledDate some xsd:dateTime, sdg:deliveryStatus some sdg:DeliveryStatusKind, sdg:targetsRecipient exactly 1 sdg:AidRecipient, sdg:relatedToProgram exactly 1 sdg:AidProgram

Class: sdg:EthicalPolicyReport
    Annotations: rdfs:label "Ethical Policy Report", iao:0000115 "A formal document produced by a financial institution detailing its ethical criteria, values, and compliance with human rights standards."
    SubClassOf: cco:ont00000958, sdg:reportId some xsd:string, sdg:publishDate some xsd:date, sdg:reportTitle some xsd:string, sdg:issuingInstitution some xsd:string, sdg:complianceStatus some sdg:ComplianceStatusKind, sdg:issuedBy exactly 1 sdg:FinancialInstitution

Class: sdg:InsuranceProduct
    Annotations: rdfs:label "Insurance Product", iao:0000115 "A financial product or service provided by an insurance company, such as travel insurance, underwritten by a specific provider."
    SubClassOf: cco:ont00000995, sdg:productId some xsd:string, sdg:productName some xsd:string, sdg:productType some xsd:string, sdg:underwriter some xsd:string, sdg:coverageScope some sdg:CoverageScopeKind, sdg:distributedBy some sdg:FinancialInstitution

Class: sdg:SettlementProject
    Annotations: rdfs:label "Settlement Project", iao:0000115 "A construction or development initiative in occupied territories, including residential, commercial, or infrastructure projects."
    SubClassOf: bfo:0000015, sdg:projectId some xsd:string, sdg:projectName some xsd:string, sdg:projectType some sdg:ProjectTypeKind, sdg:constructionStatus some sdg:ConstructionStatusKind, sdg:fundingAmount some xsd:decimal, sdg:locatedIn exactly 1 sdg:Territory, sdg:financedBy some sdg:CorporateEntity, sdg:causes some sdg:HumanRightsViolation

Class: sdg:HumanRightsViolation
    Annotations: rdfs:label "Human Rights Violation", iao:0000115 "An act or systematic practice that infringes upon the fundamental rights and freedoms of individuals or groups, as defined by international law."
    SubClassOf: bfo:0000015, sdg:violationId some xsd:string, sdg:violationType some sdg:ViolationTypeKind, sdg:severityLevel some sdg:SeverityLevelKind, sdg:dateReported some xsd:date, sdg:documentedByDetail some xsd:string, sdg:occursIn__escalated exactly 1 sdg:Territory, sdg:perpetratedBy some sdg:CorporateEntity, sdg:affects some sdg:PopulationGroup
    HasKey: sdg:violationId

Class: sdg:PopulationGroup
    Annotations: rdfs:label "Population Group", iao:0000115 "A distinct demographic or ethnic community subject to specific legal, social, or political conditions."
    SubClassOf: bfo:0000002, sdg:groupId some xsd:string, sdg:groupName some xsd:string, sdg:populationSize some xsd:integer, sdg:legalStatus some sdg:LegalStatusKind, sdg:prisonerCount some xsd:integer, sdg:ageRangeStart some xsd:integer, sdg:ageRangeEnd some xsd:integer, sdg:totalCount some xsd:integer, sdg:percentageOfTotal some xsd:decimal, sdg:affectedBy some sdg:HumanRightsViolation, sdg:residesIn some sdg:Territory, sdg:partOfTerritory exactly 1 sdg:GeographicRegion, sdg:exhibitsHealthIndicator some sdg:HealthIndicator
    HasKey: sdg:groupId

Class: sdg:Household
    Annotations: rdfs:label "Household", iao:0000115 "A residential dwelling unit occupied by one or more persons for domestic purposes."
    SubClassOf: bfo:0000040, sdg:householdId some xsd:string, sdg:address some xsd:string, sdg:occupancyStatus some sdg:OccupancyStatusKind, sdg:constructionYear some xsd:integer, sdg:floorArea some xsd:decimal, sdg:totalMembers some xsd:integer, sdg:childCount some xsd:integer, sdg:immigrantStatus some xsd:boolean, sdg:incomeLevel some xsd:decimal, sdg:householdHead some xsd:string, sdg:numberOfMembers some xsd:integer, sdg:location some xsd:string, sdg:economicStatus some sdg:EconomicStatusKind, sdg:vulnerabilityLevel some sdg:VulnerabilityLevelKind, sdg:supportReceived some xsd:boolean, sdg:householdIdentifier some xsd:string, sdg:vehicleCount some xsd:integer, sdg:hasTransportationArrangement some xsd:boolean, sdg:disasterKitReady some xsd:boolean, sdg:evacuationStatus some sdg:EvacuationStatusKind, sdg:fuelLevelPercent some xsd:decimal, sdg:hasMeter exactly 1 sdg:ElectricityMeter, sdg:hasAppliance min 2 sdg:EnergyAppliance, sdg:hasProgram max 1 sdg:HomeEnergyReductionProgram, sdg:experienced some sdg:HouseholdIncomeChange, sdg:subjectTo some sdg:SafetyNetProgram, sdg:containsBeneficiaries min 2 sdg:Beneficiary, sdg:receivesSupportFrom some sdg:Program, sdg:residesAt exactly 1 sdg:Property, sdg:evacuatesTo some sdg:Shelter, sdg:monitors exactly 1 sdg:WarningChannel

Class: sdg:ElectricityMeter
    Annotations: rdfs:label "Electricity Meter", iao:0000115 "A physical device installed at a household to measure cumulative electrical energy consumption in kilowatt-hours."
    SubClassOf: cco:ont00000995, sdg:meterId some xsd:string, sdg:installationDate some xsd:date, sdg:meterType some xsd:string, sdg:currentReading some xsd:decimal, sdg:lastCalibrationDate some xsd:date, sdg:measures min 2 sdg:EnergyConsumptionEvent, sdg:serves exactly 1 sdg:Household

Class: sdg:EnergyConsumptionEvent
    Annotations: rdfs:label "Energy Consumption Event", iao:0000115 "A discrete measurement instance recording the quantity of electrical energy consumed over a specific time interval by a metered household."
    SubClassOf: bfo:0000015, sdg:eventTimestamp some xsd:dateTime, sdg:consumptionKwh some xsd:decimal, sdg:intervalDuration some xsd:integer, sdg:measurementQuality some xsd:string, sdg:tariffBand some xsd:string, sdg:recordedBy exactly 1 sdg:ElectricityMeter, sdg:occursAt exactly 1 sdg:Household, sdg:associatedWith exactly 1 sdg:EnergyTariff

Class: sdg:EnergyTariff
    Annotations: rdfs:label "Energy Tariff", iao:0000115 "A structured pricing schedule published by an electricity provider that defines the rates, charges, and conditions applied to household energy consumption."
    SubClassOf: cco:ont00000958, sdg:tariffCode some xsd:string, sdg:providerName some xsd:string, sdg:baseCharge some xsd:decimal, sdg:ratePerKwh some xsd:decimal, sdg:effectiveDate some xsd:date, sdg:expirationDate some xsd:date, sdg:appliesTo min 2 sdg:EnergyConsumptionEvent

Class: sdg:EnergyAppliance
    Annotations: rdfs:label "Energy Appliance", iao:0000115 "A physical electrical device installed in a household that consumes energy to perform a specific function."
    SubClassOf: cco:ont00000995, sdg:applianceId some xsd:string, sdg:applianceType some xsd:string, sdg:ratedPowerWatts some xsd:decimal, sdg:energyStarRating some xsd:integer, sdg:purchaseDate some xsd:date, sdg:operationalStatus some sdg:OperationalStatusKind, sdg:locatedIn exactly 1 sdg:Household, sdg:consumesEnergyIn min 2 sdg:EnergyConsumptionEvent
    HasKey: sdg:applianceId

Class: sdg:HomeEnergyReductionProgram
    Annotations: rdfs:label "Home Energy Reduction Program", iao:0000115 "A structured intervention plan implemented by a professional service to identify, analyze, and reduce household electricity consumption and costs."
    SubClassOf: bfo:0000015, sdg:programId some xsd:string, sdg:startDate some xsd:dateTime, sdg:endDate some xsd:dateTime, sdg:programStatus some sdg:ProgramStatusKind, sdg:targetSavingsPercent some xsd:decimal, sdg:targets exactly 1 sdg:Household, sdg:implementedBy exactly 1 sdg:EnergyConsultant, sdg:analyzes min 2 sdg:EnergyConsumptionEvent

Class: sdg:EnergyConsultant
    Annotations: rdfs:label "Energy Consultant", iao:0000115 "A professional role held by an individual or business entity providing independent advice and services for household electricity reduction."
    SubClassOf: bfo:0000023, sdg:consultantId some xsd:string, sdg:businessName some xsd:string, sdg:certificationLevel some xsd:string, sdg:contactEmail some xsd:string, sdg:implements min 2 sdg:HomeEnergyReductionProgram, sdg:advisesOn min 2 sdg:EnergyAppliance

Class: sdg:ShareCapital
    Annotations: rdfs:label "Share Capital", iao:0000115 "The total monetary value of issued shares representing ownership in the corporation."
    SubClassOf: cco:ont00000995, sdg:totalValue some xsd:decimal, sdg:currencyCode some xsd:string, sdg:totalSharesIssued some xsd:integer, sdg:votingRightsPerShare some xsd:integer, sdg:recordDate some xsd:date, sdg:hasShareholder min 2 sdg:Shareholder, sdg:hasDividendPolicy max 1 sdg:DividendResolution

Class: sdg:DividendResolution
    Annotations: rdfs:label "Dividend Resolution", iao:0000115 "A formal decision by the Annual General Meeting regarding the distribution of profits to shareholders."
    SubClassOf: cco:ont00000995, sdg:resolutionId some xsd:string, sdg:amountPerShare some xsd:decimal, sdg:currencyCode some xsd:string, sdg:paymentDate some xsd:dateTime, sdg:approvedByMeeting some xsd:string, sdg:resolvedAt exactly 1 sdg:AnnualGeneralMeeting, sdg:appliesTo exactly 1 sdg:ShareCapital

Class: sdg:FeeResolution
    Annotations: rdfs:label "Fee Resolution", iao:0000115 "A formal decision by the Annual General Meeting establishing remuneration for board members, auditors, and committee members."
    SubClassOf: cco:ont00000995, sdg:resolutionId some xsd:string, sdg:roleType some sdg:RoleTypeKind, sdg:feeAmount some xsd:decimal, sdg:currencyCode some xsd:string, sdg:paymentFrequency some xsd:string, sdg:approvedByMeeting some xsd:string, sdg:resolvedAt exactly 1 sdg:AnnualGeneralMeeting, sdg:appliesTo min 2 sdg:BoardMember

Class: sdg:ShootingEvent
    Annotations: rdfs:label "Shooting Event", iao:0000115 "A competitive shooting activity defined by weapon type, distance, and gender category."
    SubClassOf: bfo:0000015, sdg:eventCode some xsd:string, sdg:genderCategory some xsd:string, sdg:qualificationScore some xsd:integer, sdg:finalScore some xsd:decimal, sdg:finalRank some xsd:integer, sdg:medalAwarded some xsd:string, sdg:eventId some xsd:string, sdg:eventName some xsd:string, sdg:hostCity some xsd:string, sdg:hostCountry some xsd:string, sdg:startDate some xsd:dateTime, sdg:endDate some xsd:dateTime, sdg:status some sdg:StatusKind, sdg:hasParticipant__escalated min 2 sdg:Shooter, sdg:heldAt exactly 1 sdg:Championship, sdg:hasResult min 2 sdg:CompetitionResult

Class: sdg:Shooter
    Annotations: rdfs:label "Shooter", iao:0000115 "A human athlete who participates in a shooting event."
    SubClassOf: bfo:0000040, sdg:shooterId some xsd:string, sdg:fullName some xsd:string, sdg:nationality some xsd:string, sdg:isOlympicChampion some xsd:boolean, sdg:firstName some xsd:string, sdg:lastName some xsd:string, sdg:gender some sdg:GenderKind, sdg:birthDate some xsd:date, sdg:competesIn min 2 sdg:ShootingEvent, sdg:represents exactly 1 sdg:NationalTeam, sdg:participatesIn__escalated min 2 sdg:ShootingEvent, sdg:competesIn min 2 sdg:Discipline, sdg:hasResult min 2 sdg:CompetitionResult

Class: sdg:NationalTeam
    Annotations: rdfs:label "National Team", iao:0000115 "A group of shooters representing a specific country in a championship."
    SubClassOf: sdg:CompetitionEntity, sdg:teamCode some xsd:string, sdg:countryName some xsd:string, sdg:totalScore some xsd:decimal, sdg:teamRank some xsd:integer, sdg:teamMedal some xsd:string, sdg:competesIn min 2 sdg:ShootingEvent, sdg:hasMember min 2 sdg:Shooter

Class: sdg:Championship
    Annotations: rdfs:label "Championship", iao:0000115 "A multi-day international shooting competition held at a specific location."
    SubClassOf: sdg:CompetitionEntity, sdg:championshipName some xsd:string, sdg:editionNumber some xsd:integer, sdg:hostCity some xsd:string, sdg:hostCountry some xsd:string, sdg:startDate some xsd:dateTime, sdg:endDate some xsd:dateTime, sdg:eventDuration some xsd:string, sdg:hostsEvent min 2 sdg:ShootingEvent, sdg:heldIn exactly 1 sdg:Location

Class: sdg:Location
    Annotations: rdfs:label "Location", iao:0000115 "A specific geographical place where a championship is held."
    SubClassOf: sdg:GeographicEntity, sdg:cityName some xsd:string, sdg:countryName some xsd:string, sdg:venueType some sdg:VenueTypeKind, sdg:locationID some xsd:string, sdg:address some xsd:string, sdg:city some xsd:string, sdg:state some xsd:string, sdg:addressLine some xsd:string, sdg:locationType some sdg:LocationTypeKind, sdg:supervisionRequired some xsd:boolean, sdg:locationId some xsd:string, sdg:name some sdg:NameKind, sdg:type some sdg:TypeKind, sdg:hasSlide some xsd:boolean, sdg:waterTemperature some xsd:decimal, sdg:isIndoor some xsd:boolean, sdg:description some xsd:string, sdg:coordinatesDetail some xsd:string, sdg:accessibility some xsd:string, sdg:hostsMeeting some sdg:BranchMeeting, sdg:hostsMeeting some sdg:CommitteeMeeting, sdg:isPickupFor exactly 1 sdg:TransportAuthorization, sdg:isDropoffFor exactly 1 sdg:TransportAuthorization, sdg:hostsEvent some sdg:SocialInteractionEvent, sdg:hostedEvent some sdg:BirthEvent, sdg:containsResident some sdg:Human, sdg:hosts min 2 sdg:Encounter

Class: sdg:AnimationProject
    Annotations: rdfs:label "Animation Project", iao:0000115 "A made thing representing a digital animation composition, including its assets, rigging, and timeline data."
    SubClassOf: bfo:0000040, sdg:projectIdentifier some xsd:string, sdg:projectTitle some xsd:string, sdg:creationDate some xsd:dateTime, sdg:totalFrames some xsd:integer, sdg:renderResolution some xsd:string, sdg:isRigged some xsd:boolean, sdg:hasGreenScreen some xsd:boolean, sdg:createdWith some sdg:SoftwareTool, sdg:containsAsset some sdg:DigitalAsset, sdg:usesSoundtrack some sdg:AudioTrack, sdg:exportedAs some sdg:VideoFile

Class: sdg:RiggingSystem
    Annotations: rdfs:label "Rigging System", iao:0000115 "A made thing representing the skeletal structure and control hierarchy used to animate a digital character."
    SubClassOf: sdg:System, sdg:rigIdentifier some xsd:string, sdg:rigType some xsd:string, sdg:jointCount some xsd:integer, sdg:hasControls some xsd:boolean, sdg:isConstrained some xsd:boolean, sdg:controlHierarchyType some xsd:string, sdg:animatesAsset exactly 1 sdg:DigitalAsset, sdg:usesControl some sdg:AnimationControl

Class: sdg:AnimationControl
    Annotations: rdfs:label "Animation Control", iao:0000115 "A made thing representing a specific handle, joint, or constraint used to manipulate a character's rig."
    SubClassOf: bfo:0000040, sdg:controlIdentifier some xsd:string, sdg:controlName some xsd:string, sdg:controlType some xsd:string, sdg:isConstrained some xsd:boolean, sdg:partOfRig exactly 1 sdg:RiggingSystem, sdg:affectsAsset exactly 1 sdg:DigitalAsset

Class: sdg:AudioTrack
    Annotations: rdfs:label "Audio Track", iao:0000115 "A made thing representing a sound composition or loop used to accompany an animation project."
    SubClassOf: bfo:0000040, sdg:trackIdentifier some xsd:string, sdg:trackTitle some xsd:string, sdg:fileFormat some sdg:FileFormatKind, sdg:isOriginal some xsd:boolean, sdg:durationSeconds some xsd:decimal, sdg:artistName some xsd:string, sdg:albumTitle some xsd:string, sdg:tempoBpm some xsd:integer, sdg:totalDurationSeconds some xsd:integer, sdg:accompaniesProject exactly 1 sdg:AnimationProject, sdg:createdWith exactly 1 sdg:SoftwareTool, sdg:accompanies exactly 1 sdg:LineDanceRoutine

Class: sdg:VideoFile
    Annotations: rdfs:label "Video File", iao:0000115 "A made thing representing a rendered video output of an animation project."
    SubClassOf: bfo:0000040, sdg:fileIdentifier some xsd:string, sdg:fileName some xsd:string, sdg:fileFormat some sdg:FileFormatKind, sdg:resolution some sdg:ResolutionKind, sdg:hasLighting some xsd:boolean, sdg:rendersProject exactly 1 sdg:AnimationProject, sdg:exportedWith exactly 1 sdg:SoftwareTool

Class: sdg:StatutoryAgency
    Annotations: rdfs:label "Statutory Agency", iao:0000115 "A legally established public entity with a defined mission and governance structure, such as a state development corporation."
    SubClassOf: bfo:0000040, sdg:agencyIdentifier some xsd:string, sdg:agencyName some xsd:string, sdg:parentDepartment some xsd:string, sdg:statutoryReference some xsd:string, sdg:fiscalYear some xsd:integer, sdg:isConsolidated some xsd:boolean, sdg:hasStaffingPlan some sdg:StaffingPlan, sdg:executesMission exactly 1 sdg:MissionStatement, sdg:receivesAdministrativeSupport some sdg:AdministrativeUnit

Class: sdg:MissionStatement
    Annotations: rdfs:label "Mission Statement", iao:0000115 "A formal declaration of an agency's purpose, duties, and operational scope as defined by statute."
    SubClassOf: bfo:0000040, sdg:missionId some xsd:string, sdg:missionText some xsd:string, sdg:isSubsetOf some xsd:string, sdg:requiresSpecializedExpertise some xsd:boolean, sdg:fundingMechanism some xsd:string, sdg:belongsToMany some sdg:StatutoryAgency

Class: sdg:StaffingPlan
    Annotations: rdfs:label "Staffing Plan", iao:0000115 "A structured record of personnel requirements, roles, and salary allocations necessary to execute an agency's mission."
    SubClassOf: bfo:0000040, sdg:planId some xsd:string, sdg:positionTitle some xsd:string, sdg:fullTimeEquivalent some xsd:decimal, sdg:salaryRange some xsd:string, sdg:isExecutive some xsd:boolean, sdg:requiresSpecializedSkills some xsd:boolean, sdg:supports exactly 1 sdg:StatutoryAgency, sdg:isPartOf some sdg:AdministrativeUnit

Class: sdg:ConsolidationImpact
    Annotations: rdfs:label "Consolidation Impact", iao:0000115 "A recorded assessment of the financial, operational, and staffing consequences of merging two or more statutory agencies."
    SubClassOf: bfo:0000040, sdg:impactId some xsd:string, sdg:costSavings some xsd:decimal, sdg:salarySavings some xsd:decimal, sdg:positionCountChange some xsd:integer, sdg:efficiencyGain some xsd:decimal, sdg:requiresNewInfrastructure some xsd:boolean, sdg:affects min 2 sdg:StatutoryAgency, sdg:evaluates some sdg:MissionStatement

Class: sdg:WebinarSession
    Annotations: rdfs:label "Webinar Session", iao:0000115 "A scheduled educational presentation event conducted by the National Hurricane Center for students regarding hurricane science and meteorology."
    SubClassOf: bfo:0000015, sdg:sessionIdentifier some xsd:string, sdg:scheduledStartDateTime some xsd:dateTime, sdg:scheduledEndDateTime some xsd:dateTime, sdg:registrationDeadline some xsd:dateTime, sdg:maxParticipants some xsd:integer, sdg:currentRegistrations some xsd:integer, sdg:status some sdg:StatusKind, sdg:language some sdg:LanguageKind, sdg:targetedAtGradeLevel min 2 sdg:GradeLevel, sdg:targetedAtRegion some sdg:GeographicRegion, sdg:hostedBy exactly 1 sdg:Meteorologist, sdg:recordedAs max 1 sdg:VideoRecording, sdg:hasRegistrationLink exactly 1 sdg:RegistrationLink

Class: sdg:Meteorologist
    Annotations: rdfs:label "Meteorologist", iao:0000115 "A professional scientist who studies atmospheric phenomena and is responsible for conducting educational webinars and providing weather information."
    SubClassOf: bfo:0000002, sdg:meteorologistIdentifier some xsd:string, sdg:fullName some xsd:string, sdg:specialization some sdg:SpecializationKind, sdg:affiliation some sdg:AffiliationKind, sdg:conductsWebinar some sdg:WebinarSession

Class: sdg:VideoRecording
    Annotations: rdfs:label "Video Recording", iao:0000115 "A digital video file capturing the content of a completed webinar session, made available for on-demand viewing."
    SubClassOf: cco:ont00000995, sdg:recordingIdentifier some xsd:string, sdg:hostingPlatform some xsd:string, sdg:accessUrl some xsd:string, sdg:publishDate some xsd:date, sdg:durationSeconds some xsd:decimal, sdg:isRecordingOf exactly 1 sdg:WebinarSession

Class: sdg:RegistrationLink
    Annotations: rdfs:label "Registration Link", iao:0000115 "A unique web address (URL) used to register participants for a specific webinar session."
    SubClassOf: cco:ont00000958, sdg:linkIdentifier some xsd:string, sdg:url some xsd:string, sdg:expirationDate some xsd:date, sdg:linksToWebinar exactly 1 sdg:WebinarSession

Class: sdg:Session
    Annotations: rdfs:label "Scheduled Academic Session", iao:0000115 "A scheduled academic session within the ARRALD program, representing a discrete block of instructional or discussion time."
    SubClassOf: bfo:0000015, sdg:sessionIdentifier some xsd:string, sdg:startTime some xsd:dateTime, sdg:endTime some xsd:dateTime, sdg:title some xsd:string, sdg:status some sdg:StatusKind, sdg:deliveredBy min 1 sdg:FacultyMember, sdg:partOf__escalated exactly 1 sdg:ProgramDay, sdg:coversTopic min 1 sdg:AcademicTopic

Class: sdg:ProgramDay
    Annotations: rdfs:label "Program Day", iao:0000115 "A single calendar day on which the ARRALD program activities occur, serving as a container for multiple sessions."
    SubClassOf: bfo:0000015, sdg:date some xsd:dateTime, sdg:dayNumber some xsd:integer, sdg:location some xsd:string, sdg:containsSession min 2 sdg:Session, sdg:partOf__escalated exactly 1 sdg:ARRALDProgram

Class: sdg:AcademicTopic
    Annotations: rdfs:label "Academic Topic", iao:0000115 "A specific subject matter or skill area addressed during a session, such as leadership theory or communication skills."
    SubClassOf: bfo:0000015, sdg:topicId some xsd:string, sdg:topicName some xsd:string, sdg:category some sdg:CategoryKind, sdg:coveredIn min 1 sdg:Session

Class: sdg:ARRALDProgram
    Annotations: rdfs:label "ARRALD Program", iao:0000115 "The overarching Radiology Resident Academic Leadership Development program, encompassing all scheduled days and sessions."
    SubClassOf: bfo:0000015, sdg:programId some xsd:string, sdg:programName some xsd:string, sdg:startDate some xsd:dateTime, sdg:endDate some xsd:dateTime, sdg:organizingBody some xsd:string, sdg:containsDay min 1 sdg:ProgramDay, sdg:administersTo min 1 sdg:Resident

Class: sdg:Resident
    Annotations: rdfs:label "Resident Participant", iao:0000115 "A radiology resident participating in the ARRALD program for academic leadership development."
    SubClassOf: cco:ont00000995, sdg:residentId some xsd:string, sdg:fullName some xsd:string, sdg:institution some xsd:string, sdg:yearOfTraining some xsd:integer, sdg:enrolledIn exactly 1 sdg:ARRALDProgram, sdg:attendsSession min 1 sdg:Session

Class: sdg:InvestigationCase
    Annotations: rdfs:label "Investigation Case", iao:0000115 "A formal inquiry or examination into potential legal, compliance, or security incidents initiated by a company or independent committee."
    SubClassOf: bfo:0000015, sdg:caseId some xsd:string, sdg:caseTitle some xsd:string, sdg:startDate some xsd:dateTime, sdg:endDate some xsd:dateTime, sdg:caseStatus some sdg:CaseStatusKind, sdg:caseType some sdg:CaseTypeKind, sdg:dataVolume some xsd:decimal, sdg:handledBy exactly 1 sdg:LegalTechSolutionLab, sdg:uses some sdg:AIEngine, sdg:uses some sdg:DataAnalysisTool

Class: sdg:LegalTechSolutionLab
    Annotations: rdfs:label "LegalTech Solution Lab", iao:0000115 "A specialized facility integrating discovery, forensics, and cyber-security capabilities to handle large-scale investigations with tight schedules using proprietary AI and expert skills."
    SubClassOf: cco:ont00000995, sdg:labId some xsd:string, sdg:labName some xsd:string, sdg:location some xsd:string, sdg:establishmentDate some xsd:date, sdg:ismsCompliant some xsd:boolean, sdg:serviceScope some xsd:string, sdg:supportedLanguages some sdg:SupportedLanguagesKind, sdg:integrates exactly 1 sdg:DiscoveryOperationCenter, sdg:integrates exactly 1 sdg:ForensicOperationCenter, sdg:employs exactly 1 sdg:AIEngine, sdg:employs some sdg:DataAnalysisTool

Class: sdg:DiscoveryOperationCenter
    Annotations: rdfs:label "Discovery Operation Center", iao:0000115 "A facility supporting the discovery process, which involves evidence disclosure for international litigation, by analyzing data and logs to identify relevant information."
    SubClassOf: cco:ont00000995, sdg:centerId some xsd:string, sdg:centerName some xsd:string, sdg:focusArea some sdg:FocusAreaKind, sdg:dataSources some xsd:string, sdg:analysisTechniques some xsd:string, sdg:integratedInto exactly 1 sdg:LegalTechSolutionLab, sdg:supports some sdg:InvestigationCase

Class: sdg:ForensicOperationCenter
    Annotations: rdfs:label "Forensic Operation Center", iao:0000115 "A facility that investigates fraud and other incidents using digital forensics techniques, including data salvaging, restoration, and log tracing."
    SubClassOf: cco:ont00000995, sdg:centerId some xsd:string, sdg:centerName some xsd:string, sdg:focusArea some sdg:FocusAreaKind, sdg:techniques some xsd:string, sdg:reportingCapability some xsd:boolean, sdg:integratedInto exactly 1 sdg:LegalTechSolutionLab, sdg:supports some sdg:InvestigationCase

Class: sdg:AIEngine
    Annotations: rdfs:label "AI Engine", iao:0000115 "A proprietary artificial intelligence engine developed by FRONTEO to enable efficient data processing, prioritization, and analysis in legal tech investigations."
    SubClassOf: cco:ont00000995, sdg:engineId some xsd:string, sdg:engineName some xsd:string, sdg:version some xsd:string, sdg:trainingData some xsd:string, sdg:supportedLanguages some sdg:SupportedLanguagesKind, sdg:processingEfficiency some xsd:decimal, sdg:usedBy exactly 1 sdg:LegalTechSolutionLab, sdg:usedIn some sdg:InvestigationCase

Class: sdg:DataAnalysisTool
    Annotations: rdfs:label "Data Analysis Tool", iao:0000115 "A software system or tool used for data analysis, log tracing, and information aggregation in legal tech investigations, including the Lit i View series."
    SubClassOf: cco:ont00000995, sdg:toolId some xsd:string, sdg:toolName some xsd:string, sdg:toolType some sdg:ToolTypeKind, sdg:developer some xsd:string, sdg:version some xsd:string, sdg:featuresDetail some sdg:FeaturesKind, sdg:usedBy some sdg:LegalTechSolutionLab, sdg:usedIn some sdg:InvestigationCase

Class: sdg:LaserDiodeModule
    Annotations: rdfs:label "Laser Diode Module", iao:0000115 "A manufactured optoelectronic assembly comprising a laser diode chip, a monitor photodiode, and polarization-maintaining fiber pigtails within a coaxial package."
    SubClassOf: cco:ont00000995, sdg:partNumber some xsd:string, sdg:centerWavelength some xsd:decimal, sdg:outputPower some xsd:decimal, sdg:thresholdCurrent some xsd:decimal, sdg:operatingCurrent some xsd:decimal, sdg:operatingVoltage some xsd:decimal, sdg:monitorCurrent some xsd:decimal, sdg:pdReverseVoltage some xsd:decimal, sdg:fiberLength some xsd:decimal, sdg:hasFiberAssembly exactly 1 sdg:FiberAssembly, sdg:hasPackageStyle exactly 1 sdg:PackageStyle, sdg:hasConnector exactly 1 sdg:FiberConnector, sdg:usesFiberType exactly 1 sdg:OpticalFiber

Class: sdg:FiberAssembly
    Annotations: rdfs:label "Fiber Assembly", iao:0000115 "The polarization-maintaining optical fiber assembly coupled to the laser diode, including the fiber core, cladding, and length specifications."
    SubClassOf: cco:ont00000995, sdg:fiberType some xsd:string, sdg:fiberCore some xsd:string, sdg:fiberLength some xsd:decimal, sdg:isPartOf exactly 1 sdg:LaserDiodeModule

Class: sdg:PackageStyle
    Annotations: rdfs:label "Package Style", iao:0000115 "The physical housing and mechanical configuration of the laser diode module, specifically a coaxial package with defined pinout."
    SubClassOf: cco:ont00000995, sdg:styleName some xsd:string, sdg:pinConfiguration some xsd:string, sdg:packageStyle some xsd:string

Class: sdg:FiberConnector
    Annotations: rdfs:label "Fiber Connector", iao:0000115 "The mechanical interface used to connect the pigtailed fiber to external optical systems, such as an FC connector."
    SubClassOf: cco:ont00000995, sdg:connectorType some xsd:string, sdg:fiberLength some xsd:decimal

Class: sdg:EnvironmentalSpecification
    Annotations: rdfs:label "Environmental Specification", iao:0000115 "The operational and storage environmental limits defining the safe operating conditions for the laser diode module."
    SubClassOf: cco:ont00000995, sdg:operatingTemperatureMin some xsd:decimal, sdg:operatingTemperatureMax some xsd:decimal, sdg:storageTemperatureMin some xsd:decimal, sdg:storageTemperatureMax some xsd:decimal, sdg:solderingTemperature some xsd:decimal, sdg:solderingDuration some xsd:decimal, sdg:appliesTo exactly 1 sdg:LaserDiodeModule

Class: sdg:ApplicationDomain
    Annotations: rdfs:label "Application Domain", iao:0000115 "The intended use case or functional role of the laser diode module in medical or sensing contexts."
    SubClassOf: bfo:0000023, sdg:domainName some xsd:string, sdg:isUsedIn some sdg:LaserDiodeModule

Class: sdg:ExploitedYouth
    Annotations: rdfs:label "Commercially Sexually Exploited Child", iao:0000115 "A minor who has been subjected to commercial sexual exploitation, characterized by ongoing trauma and systemic entanglement."
    SubClassOf: bfo:0000040, sdg:youthID some xsd:string, sdg:ageAtIntervention some xsd:integer, sdg:traumaHistory some xsd:string, sdg:systemEntanglement some xsd:string, sdg:resilienceFactors some xsd:string, sdg:receivesTreatmentFrom some sdg:TherapeuticIntervention, sdg:isServedBy some sdg:CommunityAgency, sdg:isSubjectTo some sdg:LegalProceeding

Class: sdg:TherapeuticIntervention
    Annotations: rdfs:label "Trauma-Focused Psychotherapy Protocol", iao:0000115 "A structured, evidence-based behavioral health process designed to address trauma in youth experiencing commercial sexual exploitation."
    SubClassOf: bfo:0000015, sdg:protocolID some xsd:string, sdg:interventionType some xsd:string, sdg:sessionFrequency some xsd:integer, sdg:durationWeeks some xsd:integer, sdg:status some sdg:StatusKind, sdg:targetSymptoms some xsd:string, sdg:isDeliveredBy exactly 1 sdg:BehavioralHealthProfessional, sdg:isAppliedTo some sdg:ExploitedYouth, sdg:isImplementedBy exactly 1 sdg:CommunityAgency

Class: sdg:BehavioralHealthProfessional
    Annotations: rdfs:label "Community-Based Therapist", iao:0000115 "A licensed practitioner providing behavioral health services to exploited youth within a community-based setting."
    SubClassOf: bfo:0000002, sdg:licenseNumber some xsd:string, sdg:credentialType some sdg:CredentialTypeKind, sdg:specialization some sdg:SpecializationKind, sdg:yearsExperience some xsd:integer, sdg:currentStatus some sdg:CurrentStatusKind, sdg:isEmployedBy exactly 1 sdg:CommunityAgency, sdg:deliversTreatmentTo min 2 sdg:ExploitedYouth

Class: sdg:CommunityAgency
    Annotations: rdfs:label "Community-Based Behavioral Health Agency", iao:0000115 "An organization providing community-based services, including psychotherapy and case management, to exploited youth."
    SubClassOf: sdg:CommunityEntity, sdg:agencyID some xsd:string, sdg:agencyName some xsd:string, sdg:serviceArea some xsd:string, sdg:fundingSource some sdg:FundingSourceKind, sdg:operationalStatus some sdg:OperationalStatusKind, sdg:accreditationLevel some xsd:string, sdg:employs min 2 sdg:BehavioralHealthProfessional, sdg:implements some sdg:TherapeuticIntervention, sdg:receivesFundingFrom some sdg:GrantAward

Class: sdg:GrantAward
    Annotations: rdfs:label "Research and Service Grant", iao:0000115 "A financial award provided to support the development and implementation of trauma-focused psychotherapy guides and services."
    SubClassOf: bfo:0000040, sdg:grantID some xsd:string, sdg:grantAmount some xsd:decimal, sdg:awardDate some xsd:date, sdg:grantPurpose some xsd:string, sdg:fundingAgency some xsd:string, sdg:status some sdg:StatusKind, sdg:grantCurrency some xsd:string, sdg:grantProgramName some xsd:string, sdg:grantStatus some xsd:string, sdg:grantReferenceId some xsd:string, sdg:supports some sdg:CommunityAgency, sdg:isIssuedBy exactly 1 sdg:FundingOrganization, sdg:awardedTo exactly 1 sdg:CommunityOrganization, sdg:fundedBy exactly 1 sdg:CorporateSponsor, sdg:fundsProject exactly 1 sdg:SustainabilityProject

Class: sdg:LegalProceeding
    Annotations: rdfs:label "Juvenile Justice or Child Protection Case", iao:0000115 "A formal legal or administrative process involving the child protection or juvenile justice systems that an exploited youth is entangled in."
    SubClassOf: sdg:caseNumber some xsd:string, sdg:caseType some sdg:CaseTypeKind, sdg:filingDate some xsd:date, sdg:currentStatus some sdg:CurrentStatusKind, sdg:jurisdiction some sdg:JurisdictionKind, sdg:involves exactly 1 sdg:ExploitedYouth

Class: sdg:FundingOrganization
    Annotations: rdfs:label "Grant Funding Body", iao:0000115 "An institution or foundation that provides financial support for behavioral health initiatives and research related to exploited youth."
    SubClassOf: bfo:0000040, sdg:orgID some xsd:string, sdg:orgName some xsd:string, sdg:orgType some sdg:OrgTypeKind, sdg:fundingFocus some xsd:string, sdg:establishedYear some xsd:integer, sdg:issues min 2 sdg:GrantAward, sdg:partnersWith some sdg:CommunityAgency
    HasKey: sdg:orgID

Class: sdg:Regulation
    Annotations: rdfs:label "Regulation", iao:0000115 "A formal document establishing binding rules, such as UN Regulation No. 117, governing vehicle component standards."
    SubClassOf: cco:ont00000958, sdg:identifier some xsd:string, sdg:title some xsd:string, sdg:status some sdg:StatusKind, sdg:effectiveDate some xsd:date, sdg:issuingBody some xsd:string, sdg:ruleId some xsd:string, sdg:ruleNumber some xsd:string, sdg:ruleTitle some xsd:string, sdg:issuingAuthorityDetail some xsd:string, sdg:isElectronicRequired some xsd:boolean, sdg:scope some sdg:ScopeKind, sdg:amendedBy some sdg:Corrigendum, sdg:governs some sdg:TyreType, sdg:supersededBy max 1 sdg:Regulation, sdg:governs some sdg:TestSheet, sdg:governs some sdg:Drawing, sdg:appliesTo some sdg:InfrastructurePhase

Class: sdg:Corrigendum
    Annotations: rdfs:label "Corrigendum", iao:0000115 "A formal document issued to correct errors or update provisions within an existing regulation without full re-issuance."
    SubClassOf: cco:ont00000958, sdg:identifier some xsd:string, sdg:issueNumber some xsd:integer, sdg:submissionDate some xsd:dateTime, sdg:proposingEntity some xsd:string, sdg:status some sdg:StatusKind, sdg:amends exactly 1 sdg:Regulation, sdg:modifies some sdg:TestProtocol

Class: sdg:TyreType
    Annotations: rdfs:label "Tyre Type", iao:0000115 "A specific design and model of a tyre subject to type-approval and noise testing standards."
    SubClassOf: cco:ont00000995, sdg:typeCode some xsd:string, sdg:manufacturerId some xsd:string, sdg:rollingNoiseDb some xsd:decimal, sdg:widthMm some xsd:integer, sdg:profileIndex some xsd:integer, sdg:loadIndex some xsd:integer, sdg:speedRating some xsd:string, sdg:testedIn some sdg:TestFacility, sdg:approvedBy some sdg:TypeApprovalAuthority, sdg:measuredBy exactly 1 sdg:TestProtocol

Class: sdg:TestProtocol
    Annotations: rdfs:label "Test Protocol", iao:0000115 "A standardized procedure and set of conditions for measuring tyre rolling noise and other performance metrics."
    SubClassOf: bfo:0000015, sdg:protocolId some xsd:string, sdg:protocolVersion some xsd:string, sdg:measurementUnit some xsd:string, sdg:witnessingRequired some xsd:boolean, sdg:testEnvironment some xsd:string, sdg:temperatureCelsius some xsd:decimal, sdg:pressureBar some xsd:decimal, sdg:appliedTo some sdg:TyreType, sdg:conductedAt exactly 1 sdg:TestFacility, sdg:governedBy exactly 1 sdg:Regulation

Class: sdg:TestFacility
    Annotations: rdfs:label "Test Facility", iao:0000115 "A laboratory or physical location equipped to perform standardized tyre noise and performance testing."
    SubClassOf: bfo:0000015, sdg:facilityId some xsd:string, sdg:facilityName some xsd:string, sdg:location some xsd:string, sdg:certificationStatus some sdg:CertificationStatusKind, sdg:ownerType some sdg:OwnerTypeKind, sdg:hosts some sdg:TestProtocol, sdg:certifiedBy exactly 1 sdg:TypeApprovalAuthority, sdg:ownedBy exactly 1 sdg:Manufacturer

Class: sdg:TypeApprovalAuthority
    Annotations: rdfs:label "Type Approval Authority", iao:0000115 "A designated governmental or regulatory body responsible for granting type-approval to vehicle components and overseeing testing."
    SubClassOf: sdg:Authority, sdg:authorityId some xsd:string, sdg:authorityName some xsd:string, sdg:jurisdiction some sdg:JurisdictionKind, sdg:witnessingPolicy some sdg:WitnessingPolicyKind, sdg:contactEmail some xsd:string, sdg:scopeOfApproval some xsd:string, sdg:approves some sdg:TyreType, sdg:certifies some sdg:TestFacility, sdg:witnesses max 1 sdg:TestProtocol

Class: sdg:NursingLeader
    Annotations: rdfs:label "Nursing Leader", iao:0000115 "An individual holding a senior leadership or advisory role within the NHS, responsible for nursing strategy, quality improvement, or patient safety."
    SubClassOf: bfo:0000023, sdg:leaderIdentifier some xsd:string, sdg:fullLegalName some xsd:string, sdg:professionalQualifications some sdg:ProfessionalQualificationsKind, sdg:currentTitle some xsd:string, sdg:appointmentDate some xsd:date, sdg:yearsOfExperience some xsd:integer, sdg:leadsWorkstream max 1 sdg:NursingWorkstream, sdg:affiliatedWithTrust max 1 sdg:NHSFoundationTrust, sdg:previouslyHeldRoleAt some sdg:NHSFoundationTrust

Class: sdg:NursingWorkstream
    Annotations: rdfs:label "Nursing Quality Workstream", iao:0000115 "A specific strategic initiative or focus area within the Nursing and Care Quality Forum dedicated to improving a particular aspect of nursing care."
    SubClassOf: bfo:0000015, sdg:workstreamIdentifier some xsd:string, sdg:workstreamTitle some xsd:string, sdg:startDate some xsd:dateTime, sdg:targetOutcome some xsd:string, sdg:successMetric some xsd:string, sdg:ledBy exactly 1 sdg:NursingLeader, sdg:partOfForum exactly 1 sdg:NursingForum, sdg:targetsTrust some sdg:NHSFoundationTrust

Class: sdg:NHSFoundationTrust
    Annotations: rdfs:label "NHS Foundation Trust", iao:0000115 "A legally independent organization within the National Health Service responsible for delivering hospital and/or community health services."
    SubClassOf: cco:ont00000995, sdg:trustIdentifier some xsd:string, sdg:trustName some xsd:string, sdg:trustType some sdg:TrustTypeKind, sdg:foundingYear some xsd:integer, sdg:currentQualityRating some xsd:string, sdg:hasNursingDirector max 1 sdg:NursingLeader, sdg:subjectOfReview some sdg:QualityReview, sdg:implementsWorkstream some sdg:NursingWorkstream

Class: sdg:QualityReview
    Annotations: rdfs:label "Quality and Safety Review", iao:0000115 "An independent assessment or inspection conducted by regulatory bodies or expert panels to evaluate the quality, safety, and governance of an NHS Trust."
    SubClassOf: sdg:Report, sdg:reviewIdentifier some xsd:string, sdg:reviewType some xsd:string, sdg:reviewDate some xsd:dateTime, sdg:reviewOutcome some sdg:ReviewOutcomeKind, sdg:keyFindings some xsd:string, sdg:conductedOnTrust exactly 1 sdg:NHSFoundationTrust, sdg:informedByExpert some sdg:NursingLeader, sdg:ledToImprovementPlan some sdg:NursingWorkstream

Class: sdg:PatientSafetyMetric
    Annotations: rdfs:label "Patient Safety and Quality Metric", iao:0000115 "A quantifiable measure used to track improvements in patient safety, clinical outcomes, or care quality within an NHS Trust."
    SubClassOf: cco:ont00000995, sdg:metricIdentifier some xsd:string, sdg:metricName some xsd:string, sdg:baselineValue some xsd:decimal, sdg:currentValue some xsd:decimal, sdg:targetValue some xsd:decimal, sdg:measurementDate some xsd:dateTime, sdg:measuredAtTrust exactly 1 sdg:NHSFoundationTrust, sdg:trackedByWorkstream some sdg:NursingWorkstream, sdg:monitoredByLeader some sdg:NursingLeader

Class: sdg:ManagedInvestmentScheme
    Annotations: rdfs:label "Managed Investment Scheme", iao:0000115 "A collective investment vehicle structured as an unlisted scheme where investors hold units representing beneficial ownership."
    SubClassOf: cco:ont00000995, sdg:schemeIdentifier some xsd:string, sdg:schemeName some xsd:string, sdg:responsibleEntity some xsd:string, sdg:isUnlisted some xsd:boolean, sdg:establishmentDate some xsd:date, sdg:arsn some xsd:string, sdg:status some sdg:StatusKind, sdg:listingStatus some sdg:ListingStatusKind, sdg:hasResponsibleEntity exactly 1 sdg:FinancialLicence, sdg:issuesUnits min 2 sdg:FinancialProduct, sdg:hasResponsibleEntity exactly 1 sdg:AuthorisedRepresentative, sdg:issuesUnitsTo min 2 sdg:Investor

Class: sdg:FinancialLicence
    Annotations: rdfs:label "Australian Financial Services Licence", iao:0000115 "A regulatory authorisation issued by ASIC permitting the holder to provide financial services in Australia."
    SubClassOf: cco:ont00000995, sdg:licenceNumber some xsd:string, sdg:licenceHolder some xsd:string, sdg:issuingAuthorityDetail some xsd:string, sdg:status some sdg:StatusKind, sdg:complianceDate some xsd:date, sdg:authorisesRepresentative min 2 sdg:AuthorisedRepresentative

Class: sdg:AuthorisedRepresentative
    Annotations: rdfs:label "Authorised Representative", iao:0000115 "An individual or entity authorised to provide financial services on behalf of a licence holder under an AFSL."
    SubClassOf: sdg:Authority, sdg:representativeId some xsd:string, sdg:representativeName some xsd:string, sdg:authorisationDate some xsd:date, sdg:remunerationRate some xsd:decimal, sdg:contactEmail some xsd:string, sdg:serviceDomain some xsd:string, sdg:repId some xsd:string, sdg:repName some xsd:string, sdg:authorisationStatus some xsd:string, sdg:licensingEntity some xsd:string, sdg:actsForLicence exactly 1 sdg:FinancialLicence, sdg:providesAdviceOn min 2 sdg:FinancialProduct, sdg:receivesRemunerationFrom min 2 sdg:ManagedInvestmentScheme, sdg:actsOnBehalfOf min 2 sdg:ManagedInvestmentScheme, sdg:receivesRemunerationFrom min 2 sdg:FinancialProduct
    HasKey: sdg:representativeId

Class: sdg:ProductDisclosureStatement
    Annotations: rdfs:label "Product Disclosure Statement", iao:0000115 "A statutory document providing detailed information about a financial product to assist investors in making informed decisions."
    SubClassOf: cco:ont00000958, sdg:pdsId some xsd:string, sdg:issueDate some xsd:date, sdg:validUntilDate some xsd:date, sdg:totalFees some xsd:decimal, sdg:significantRisks some xsd:string, sdg:versionNumber some xsd:string, sdg:regulatoryStatus some sdg:RegulatoryStatusKind, sdg:documentUrl some xsd:string, sdg:relatesToProduct exactly 1 sdg:FinancialProduct, sdg:providedByLicence exactly 1 sdg:FinancialLicence, sdg:receivedByInvestor min 2 sdg:Investor, sdg:describesProduct min 2 sdg:FinancialProduct, sdg:providedTo min 2 sdg:Investor

Class: sdg:Investor
    Annotations: rdfs:label "Investor", iao:0000115 "An individual or entity that acquires units in a managed investment scheme."
    SubClassOf: bfo:0000004, sdg:investorId some xsd:string, sdg:investorName some xsd:string, sdg:registrationDate some xsd:dateTime, sdg:totalInvested some xsd:decimal, sdg:contactPhone some xsd:string, sdg:accountStatus some sdg:AccountStatusKind, sdg:totalInvestment some xsd:decimal, sdg:acquiresUnitsIn min 2 sdg:ManagedInvestmentScheme, sdg:receivesAdviceFrom some sdg:AuthorisedRepresentative, sdg:submitsComplaintTo max 1 sdg:ComplaintRecord
    HasKey: sdg:investorId

Class: sdg:ComplaintRecord
    Annotations: rdfs:label "Complaint Record", iao:0000115 "A formal record of a complaint lodged by an investor regarding financial services provided."
    SubClassOf: cco:ont00000995, sdg:complaintId some xsd:string, sdg:lodgedDate some xsd:dateTime, sdg:status some sdg:StatusKind, sdg:resolutionDate some xsd:date, sdg:escalatedToDetail some xsd:string, sdg:filedByInvestor exactly 1 sdg:Investor, sdg:addressedByRepresentative exactly 1 sdg:AuthorisedRepresentative, sdg:escalatedToExternalBody max 1 sdg:ExternalOmbudsman

Class: sdg:ExternalOmbudsman
    Annotations: rdfs:label "External Ombudsman Service", iao:0000115 "An independent dispute resolution body, such as the Financial Ombudsman Service, that handles unresolved complaints."
    SubClassOf: bfo:0000004, sdg:ombudsmanName some xsd:string, sdg:contactPhone some xsd:string, sdg:contactEmail some xsd:string, sdg:jurisdiction some sdg:JurisdictionKind, sdg:establishedDate some xsd:date, sdg:handlesComplaintsFrom min 2 sdg:ComplaintRecord

Class: sdg:EmploymentAppointment
    Annotations: rdfs:label "Employment Appointment", iao:0000115 "A formal record of an individual's appointment to a municipal position for a specified term."
    SubClassOf: cco:ont00000995, sdg:appointmentId some xsd:string, sdg:positionTitle some xsd:string, sdg:appointeeName some xsd:string, sdg:termStartDate some xsd:date, sdg:termEndDate some xsd:date, sdg:nominationDate some xsd:dateTime, sdg:approvalStatus some sdg:ApprovalStatusKind, sdg:reappointmentCount some xsd:integer, sdg:nominatedBy exactly 1 sdg:MunicipalOfficial, sdg:approvedBy some sdg:MunicipalCouncil, sdg:heldBy exactly 1 sdg:MunicipalEmployee

Class: sdg:MunicipalEmployee
    Annotations: rdfs:label "Municipal Employee", iao:0000115 "An individual performing duties for a municipal government entity."
    SubClassOf: bfo:0000015, sdg:employeeId some xsd:string, sdg:fullName some xsd:string, sdg:department some xsd:string, sdg:jobTitle some xsd:string, sdg:yearsOfService some xsd:integer, sdg:employmentStatus some sdg:EmploymentStatusKind, sdg:hireDate some xsd:date, sdg:supervisedBy max 1 sdg:MunicipalOfficial, sdg:reportsTo max 1 sdg:MunicipalOfficial

Class: sdg:MunicipalOfficial
    Annotations: rdfs:label "Municipal Official", iao:0000115 "An individual holding a formal elected or appointed position within a municipal government."
    SubClassOf: bfo:0000023, sdg:officialId some xsd:string, sdg:fullName some xsd:string, sdg:officeTitle some xsd:string, sdg:termStartDate some xsd:date, sdg:termEndDate some xsd:date, sdg:partyAffiliation some xsd:string, sdg:contactEmail some xsd:string, sdg:instructs some sdg:MunicipalEmployee

Class: sdg:MunicipalCouncil
    Annotations: rdfs:label "Municipal Council", iao:0000115 "A legislative body responsible for governing a municipal entity and making policy decisions."
    SubClassOf: bfo:0000015, sdg:councilId some xsd:string, sdg:municipalityName some xsd:string, sdg:meetingDate some xsd:dateTime, sdg:quorumPresent some xsd:boolean, sdg:sessionType some sdg:SessionTypeKind, sdg:agendaItemsCount some xsd:integer
    HasKey: sdg:councilId

Class: sdg:PayrollRecord
    Annotations: rdfs:label "Payroll Record", iao:0000115 "A financial document detailing compensation, overtime, and deductions for municipal employees."
    SubClassOf: cco:ont00000995, sdg:recordId some xsd:string, sdg:payPeriodStart some xsd:date, sdg:payPeriodEnd some xsd:date, sdg:employeeId some xsd:string, sdg:baseSalary some xsd:decimal, sdg:overtimeHours some xsd:decimal, sdg:overtimeRate some xsd:decimal, sdg:totalGrossPay some xsd:decimal, sdg:complianceStatus some sdg:ComplianceStatusKind, sdg:generatedBy exactly 1 sdg:MunicipalEmployee, sdg:auditedBy max 1 sdg:MunicipalEmployee

Class: sdg:FLSAComplianceIssue
    Annotations: rdfs:label "FLSA Compliance Issue", iao:0000115 "A specific instance of non-compliance or potential violation of the Fair Labor Standards Act within a municipal payroll context."
    SubClassOf: bfo:0000015, sdg:issueId some xsd:string, sdg:issueDescription some xsd:string, sdg:discoveryDate some xsd:date, sdg:resolutionDate some xsd:date, sdg:affectedDepartment some xsd:string, sdg:violationType some sdg:ViolationTypeKind, sdg:severityLevel some sdg:SeverityLevelKind, sdg:identifiedBy exactly 1 sdg:MunicipalEmployee, sdg:addressedBy some sdg:MunicipalOfficial, sdg:affects some sdg:PayrollRecord

Class: sdg:DiscretionaryPlaceApplication
    Annotations: rdfs:label "Discretionary Place Application", iao:0000115 "A formal submission record by a student and guardian seeking admission to a specific secondary school grade through a discretionary allocation process."
    SubClassOf: cco:ont00000958, sdg:applicationId some xsd:string, sdg:submissionDate some xsd:dateTime, sdg:academicYear some xsd:string, sdg:status some sdg:StatusKind, sdg:totalScore some xsd:decimal, sdg:rank some xsd:integer, sdg:interviewDate some xsd:dateTime, sdg:submittedBy exactly 1 sdg:Student, sdg:submittedTo exactly 1 sdg:School, sdg:evaluatedBy exactly 1 sdg:AdmissionCommittee, sdg:hasAcademicRecord exactly 1 sdg:AcademicRecord, sdg:hasInterviewScore max 1 sdg:InterviewScore, sdg:hasExtracurricularRecord some sdg:ExtracurricularRecord

Class: sdg:AcademicRecord
    Annotations: rdfs:label "Academic Record", iao:0000115 "A compiled record of a student's grades and scores in core subjects and overall conduct for a specific academic period."
    SubClassOf: sdg:Record, sdg:recordId some xsd:string, sdg:gradeLevel some xsd:integer, sdg:term some xsd:string, sdg:conductScore some xsd:decimal, sdg:academicScore some xsd:decimal, sdg:totalWeightedScore some xsd:decimal, sdg:overallWeightedScore some xsd:decimal, sdg:belongsToStudent exactly 1 sdg:Student, sdg:containsSubjectGrade min 3 sdg:SubjectGrade, sdg:partOfApplication exactly 1 sdg:AdmissionApplication

Class: sdg:SubjectGrade
    Annotations: rdfs:label "Subject Grade", iao:0000115 "A specific grade and corresponding numerical score achieved by a student in a core academic subject."
    SubClassOf: cco:ont00000995, sdg:subjectName some xsd:string, sdg:letterGrade some xsd:string, sdg:numericScore some xsd:integer, sdg:grade some sdg:GradeKind, sdg:score some xsd:decimal, sdg:term some xsd:string, sdg:partOfRecord exactly 1 sdg:AcademicRecord, sdg:recordedIn exactly 1 sdg:AcademicRecord

Class: sdg:InterviewScore
    Annotations: rdfs:label "Interview Score", iao:0000115 "A measurement of a student's performance during an individual admission interview, including appearance, politeness, and manner."
    SubClassOf: bfo:0000015, sdg:appearanceScore some xsd:integer, sdg:politenessScore some xsd:integer, sdg:mannerScore some xsd:integer, sdg:totalInterviewScore some xsd:decimal, sdg:interviewDate some xsd:dateTime, sdg:scoreId some xsd:string, sdg:appearanceAndPoliteness some xsd:integer, sdg:manner some xsd:integer, sdg:weighting some xsd:decimal, sdg:evaluatesStudent exactly 1 sdg:Student, sdg:linkedToApplication exactly 1 sdg:DiscretionaryPlaceApplication, sdg:belongsToApplication exactly 1 sdg:AdmissionApplication

Class: sdg:ExtracurricularRecord
    Annotations: rdfs:label "Extracurricular Record", iao:0000115 "A record of a student's participation and achievement in in-school or out-of-school extra-curricular activities."
    SubClassOf: cco:ont00000995, sdg:activityName some sdg:ActivityNameKind, sdg:activityType some sdg:ActivityTypeKind, sdg:achievementLevel some sdg:AchievementLevelKind, sdg:scorePoints some xsd:integer, sdg:belongsToStudent exactly 1 sdg:Student, sdg:linkedToApplication some sdg:DiscretionaryPlaceApplication

Class: sdg:AdmissionCommittee
    Annotations: rdfs:label "Admission Committee", iao:0000115 "A group of school staff responsible for evaluating applications, conducting interviews, and determining admission rankings."
    SubClassOf: bfo:0000040, sdg:committeeId some xsd:string, sdg:evaluationDate some xsd:dateTime, sdg:resultReleaseDate some xsd:date, sdg:evaluatesApplications some sdg:DiscretionaryPlaceApplication, sdg:partOfSchool exactly 1 sdg:School

Class: sdg:WorkshopSession
    Annotations: rdfs:label "Workshop Session", iao:0000115 "A structured educational event focused on water, sanitation, and hygiene (WASH) topics where participants engage in learning activities."
    SubClassOf: bfo:0000015, sdg:sessionIdentifier some xsd:string, sdg:startDate some xsd:dateTime, sdg:endDate some xsd:dateTime, sdg:location some xsd:string, sdg:topic some xsd:string, sdg:status some sdg:StatusKind, sdg:maxCapacity some xsd:integer, sdg:currentAttendance some xsd:integer, sdg:requires exactly 1 sdg:LearningEnvironment, sdg:delivers min 2 sdg:LearningModule, sdg:attends min 3 sdg:Participant, sdg:hasLearningEnvironment exactly 1 sdg:LearningEnvironment, sdg:hasParticipant__escalated min 2 sdg:Participant, sdg:deliversContent min 3 sdg:LearningModule

Class: sdg:LearningEnvironment
    Annotations: rdfs:label "Learning Environment", iao:0000115 "The physical and psychological conditions established during a workshop to ensure participants feel safe, respected, and able to focus."
    SubClassOf: bfo:0000015, sdg:environmentId some xsd:string, sdg:safetyLevel some sdg:SafetyLevelKind, sdg:noiseLevel some xsd:decimal, sdg:lightingCondition some xsd:string, sdg:temperature some xsd:decimal, sdg:isSecure some xsd:boolean, sdg:physicalSafetyLevel some xsd:string, sdg:emotionalSafetyLevel some sdg:EmotionalSafetyLevelKind, sdg:hasGroupAgreement some xsd:boolean, sdg:stressReductionMeasures some xsd:string, sdg:accessibilityCompliance some xsd:boolean, sdg:supports exactly 1 sdg:WorkshopSession, sdg:provides min 2 sdg:PhysicalAmenity, sdg:establishes exactly 1 sdg:GroupAgreement, sdg:isPartOf exactly 1 sdg:WorkshopSession, sdg:supportsParticipant min 2 sdg:Participant
    HasKey: sdg:environmentId

Class: sdg:MotivationType
    Annotations: rdfs:label "Motivation Type", iao:0000115 "A role or state describing the internal or external drivers influencing a participant's engagement and learning speed."
    SubClassOf: bfo:0000023, sdg:motivationId some xsd:string, sdg:motivationCategory some xsd:string, sdg:intensity some xsd:decimal, sdg:triggerSource some xsd:string, sdg:isSustainable some xsd:boolean, sdg:influences some sdg:Participant, sdg:drives some sdg:LearningOutcome
    HasKey: sdg:motivationId

Class: sdg:PracticeActivity
    Annotations: rdfs:label "Practice Activity", iao:0000115 "A structured exercise or simulation designed to reinforce new knowledge and skills through meaningful repetition."
    SubClassOf: sdg:ProgramActivity, sdg:activityId some xsd:string, sdg:activityName some sdg:ActivityNameKind, sdg:durationMinutes some xsd:integer, sdg:complexityLevel some xsd:string, sdg:isHandsOn some xsd:boolean, sdg:completionRate some xsd:decimal, sdg:activityType some sdg:ActivityTypeKind, sdg:requiredMaterials some xsd:string, sdg:successCriteria some xsd:string, sdg:isCompleted some xsd:boolean, sdg:isPartOf some sdg:WorkshopSession, sdg:performedBy min 2 sdg:Participant, sdg:reinforces some sdg:LearningModule, sdg:isAssignedTo min 1 sdg:WorkshopSession, sdg:isPerformedBy min 2 sdg:Participant

Class: sdg:LearningModule
    Annotations: rdfs:label "Learning Module", iao:0000115 "A discrete unit of instructional content delivered during a workshop, such as a lesson on water-borne diseases."
    SubClassOf: cco:ont00000958, sdg:moduleId some xsd:string, sdg:title some xsd:string, sdg:contentFormat some sdg:ContentFormatKind, sdg:durationMinutes some xsd:integer, sdg:difficultyLevel some sdg:DifficultyLevelKind, sdg:isRelevant some xsd:boolean, sdg:deliveryMethod some xsd:string, sdg:learningObjective some xsd:string, sdg:deliveredIn some sdg:WorkshopSession, sdg:connectsTo some sdg:ParticipantPriorKnowledge, sdg:assessedBy some sdg:PracticeActivity, sdg:isDeliveredIn min 1 sdg:WorkshopSession, sdg:enablesPractice min 1 sdg:PracticeActivity

Class: sdg:PhysicalAmenity
    Annotations: rdfs:label "Physical Amenity", iao:0000115 "A tangible resource or facility provided to meet the physical needs of participants, such as food or sanitation facilities."
    SubClassOf: sdg:System, sdg:amenityId some xsd:string, sdg:amenityType some sdg:AmenityTypeKind, sdg:quantityProvided some xsd:integer, sdg:isClean some xsd:boolean, sdg:isAccessible some xsd:boolean, sdg:providedIn some sdg:LearningEnvironment, sdg:consumedBy some sdg:Participant
    HasKey: sdg:amenityId

Class: sdg:GroupAgreement
    Annotations: rdfs:label "Group Agreement", iao:0000115 "A set of rules or norms established at the beginning of a workshop to ensure respect and psychological safety among participants."
    SubClassOf: sdg:CommunityEntity, sdg:agreementId some xsd:string, sdg:ruleDescription some xsd:string, sdg:isEnforced some xsd:boolean, sdg:violationCount some xsd:integer, sdg:establishedBy exactly 1 sdg:LearningEnvironment, sdg:governs min 2 sdg:Participant

Class: sdg:DataProcessor
    Annotations: rdfs:label "Data Processor", iao:0000115 "A legal entity that processes personal data on behalf of the data controller."
    SubClassOf: sdg:DataEntity, sdg:legalName some xsd:string, sdg:registrationNumber some xsd:string, sdg:registeredAddress some xsd:string, sdg:serviceType some sdg:ServiceTypeKind, sdg:contractStartDate some xsd:date, sdg:legalEntityStatus some xsd:string, sdg:actsOnBehalfOf exactly 1 sdg:DataController, sdg:processes some sdg:PersonalData
    HasKey: sdg:registrationNumber

Class: sdg:PrivacyRepresentative
    Annotations: rdfs:label "Privacy Representative", iao:0000115 "A role played by an individual or entity responsible for ensuring compliance with data protection regulations."
    SubClassOf: bfo:0000023, sdg:name some sdg:NameKind, sdg:contactEmail some xsd:string, sdg:contactPhone some xsd:string, sdg:appointmentDate some xsd:date, sdg:represents exactly 1 sdg:DataController

Class: sdg:SurfingData
    Annotations: rdfs:label "Surfing Data", iao:0000115 "Technical data collected during website visits, including IP addresses and browser parameters."
    SubClassOf: cco:ont00000995, sdg:ipAddress some xsd:string, sdg:domainName some xsd:string, sdg:operatingSystem some xsd:string, sdg:visitTimestamp some xsd:dateTime, sdg:sessionDuration some xsd:decimal, sdg:isAnonymous some xsd:boolean, sdg:collectedBy exactly 1 sdg:DataController

Class: sdg:PersonalData
    Annotations: rdfs:label "Personal Data", iao:0000115 "Information relating to an identified or identifiable natural person."
    SubClassOf: sdg:DataEntity, sdg:dataCategory some xsd:string, sdg:consentStatus some sdg:ConsentStatusKind, sdg:collectionPurpose some xsd:string, sdg:retentionPeriod some xsd:string, sdg:isSensitive some xsd:boolean, sdg:processedBy exactly 1 sdg:DataController, sdg:subjectOf exactly 1 sdg:DataSubject

Class: sdg:Cookie
    Annotations: rdfs:label "Cookie", iao:0000115 "A small data file stored on a user's device to enhance website functionality and track usage."
    SubClassOf: cco:ont00000995, sdg:cookieId some xsd:string, sdg:purpose some sdg:PurposeKind, sdg:expirationDate some xsd:date, sdg:isEssential some xsd:boolean, sdg:thirdPartyProvider some xsd:string, sdg:deployedBy exactly 1 sdg:DataController, sdg:storedOn exactly 1 sdg:UserDevice
    HasKey: sdg:cookieId

Class: sdg:InsuranceApplication
    Annotations: rdfs:label "Insurance Application", iao:0000115 "A formal document submitted by an organization to request amateur sports association insurance coverage, containing organizational details, participant counts, requested coverage limits, and underwriting disclosures."
    SubClassOf: sdg:applicationId some xsd:string, sdg:organizationName some xsd:string, sdg:headquartersStreet some xsd:string, sdg:headquartersCity some xsd:string, sdg:headquartersState some xsd:string, sdg:headquartersZip some xsd:string, sdg:dateOfFormation some xsd:date, sdg:charteredInState some xsd:string, sdg:submissionDate some xsd:dateTime, sdg:isBinding some xsd:boolean, sdg:submittedBy exactly 1 sdg:Organization, sdg:coversEvents some sdg:Event, sdg:requestedCoverageFor some sdg:CoveragePolicy, sdg:disclosesPastClaims some sdg:ClaimRecord

Class: sdg:OfficerRole
    Annotations: rdfs:label "Officer Role", iao:0000115 "A specific governance position within an organization, such as President, Vice President, Secretary, Treasurer, or Insurance Coordinator, defining the scope of authority and responsibility."
    SubClassOf: sdg:Role, sdg:roleCode some xsd:string, sdg:roleName some xsd:string, sdg:isExecutive some xsd:boolean, sdg:requiresInsuranceTraining some xsd:boolean, sdg:governanceAuthorityScope some xsd:string
    HasKey: sdg:roleCode

Class: sdg:CoveragePolicy
    Annotations: rdfs:label "Coverage Policy", iao:0000115 "A specific insurance product or limit requested for an event or organization, such as Primary General Liability, Participant Legal Liability, or Medical Coverage, with defined monetary limits and deductibles."
    SubClassOf: cco:ont00000995, sdg:policyId some xsd:string, sdg:coverageType some xsd:string, sdg:coverageLimit some xsd:decimal, sdg:deductibleAmount some xsd:decimal, sdg:isExcessCoverage some xsd:boolean, sdg:claimExcessThreshold some xsd:decimal, sdg:requestedFor some sdg:Event, sdg:issuedTo exactly 1 sdg:Organization, sdg:coversParticipantAccidents some sdg:Participant

Class: sdg:ClaimRecord
    Annotations: rdfs:label "Claim Record", iao:0000115 "A historical record of an insurance claim filed against an organization, including the year, premium paid, total incurred claims (paid and reserved), and details for claims exceeding a specified threshold."
    SubClassOf: sdg:Record, sdg:claimId some xsd:string, sdg:claimYear some xsd:integer, sdg:premiumPaid some xsd:decimal, sdg:totalIncurredClaims some xsd:decimal, sdg:claimDescription some xsd:string, sdg:exceedsThreshold some xsd:boolean, sdg:thresholdAmount some xsd:decimal, sdg:financialMetricType some xsd:string, sdg:associatedWith exactly 1 sdg:Organization, sdg:relatedToPolicy some sdg:CoveragePolicy

Class: sdg:CanapeCategory
    Annotations: rdfs:label "Canapé Category", iao:0000115 "A classification used to group canapés based on their flavor profile, such as savory or sweet."
    SubClassOf: cco:ont00000958, sdg:categoryId some xsd:string, sdg:categoryName some xsd:string, sdg:recommendedServingSize some xsd:integer, sdg:eventType some sdg:EventTypeKind, sdg:includesCanape min 2 sdg:Canape

Class: sdg:TastingDish
    Annotations: rdfs:label "Tasting Dish", iao:0000115 "A portioned food item served in a bowl or mini dish, typically as a main or substantial appetizer."
    SubClassOf: cco:ont00000995, sdg:dishId some xsd:string, sdg:name some sdg:NameKind, sdg:unitPrice some xsd:decimal, sdg:dietaryCategory some xsd:string, sdg:description some xsd:string, sdg:servingSize some xsd:string, sdg:servedIn exactly 1 sdg:DishCategory, sdg:containsIngredient min 2 sdg:Ingredient

Class: sdg:DishCategory
    Annotations: rdfs:label "Dish Category", iao:0000115 "A classification used to group tasting dishes based on their flavor profile, such as savory or sweet."
    SubClassOf: sdg:DiningPackage, sdg:categoryId some xsd:string, sdg:categoryName some xsd:string, sdg:recommendedServingSize some xsd:integer, sdg:eventType some sdg:EventTypeKind, sdg:includesDish min 2 sdg:TastingDish

Class: sdg:Norm
    Annotations: rdfs:label "Norm", iao:0000115 "A conditional standard of behaviour that imposes an obligation or prohibition on an agent, triggered by specific environmental states and enforced via sanctions or regimentation."
    SubClassOf: bfo:0000015, sdg:normId some xsd:string, sdg:normType some sdg:NormTypeKind, sdg:triggerCondition some xsd:string, sdg:deadlineCondition some xsd:string, sdg:enforcementMode some sdg:EnforcementModeKind, sdg:sanctionType some xsd:string, sdg:appliedIn exactly 1 sdg:PhysicalTransitionSystem, sdg:triggers some sdg:NormViolation, sdg:imposes some sdg:Sanction

Class: sdg:PhysicalTransitionSystem
    Annotations: rdfs:label "Physical Transition System", iao:0000115 "A computational model describing the state transitions and propositional valuations of a multi-agent system environment."
    SubClassOf: bfo:0000015, sdg:systemId some xsd:string, sdg:initialStateId some xsd:string, sdg:stateCount some xsd:integer, sdg:transitionRelationId some xsd:string, sdg:valuationFunctionId some xsd:string, sdg:physicalAtoms some xsd:string, sdg:sanctionAtoms some xsd:string, sdg:contains min 2 sdg:State, sdg:defines min 2 sdg:Transition, sdg:hosts some sdg:Norm
    HasKey: sdg:systemId

Class: sdg:Transition
    Annotations: rdfs:label "Transition", iao:0000115 "A directed relation between two states representing an action execution or state change within the multi-agent system."
    SubClassOf: bfo:0000015, sdg:transitionId some xsd:string, sdg:actionId some xsd:string, sdg:precondition some xsd:string, sdg:effect some xsd:string, sdg:originatesFrom exactly 1 sdg:State, sdg:terminatesAt exactly 1 sdg:State, sdg:partOf__escalated exactly 1 sdg:PhysicalTransitionSystem

Class: sdg:NormViolation
    Annotations: rdfs:label "Norm Violation", iao:0000115 "An event where an agent fails to satisfy a norm's condition or deadline, triggering a sanction or regimentation."
    SubClassOf: bfo:0000015, sdg:violationId some xsd:string, sdg:violationTimestamp some xsd:dateTime, sdg:violationType some sdg:ViolationTypeKind, sdg:sanctionIncurment some xsd:boolean, sdg:causedBy exactly 1 sdg:Norm, sdg:occursIn__escalated exactly 1 sdg:State, sdg:triggers exactly 1 sdg:Sanction

Class: sdg:Sanction
    Annotations: rdfs:label "Sanction", iao:0000115 "A punitive measure or constraint imposed on an agent as a consequence of violating a norm."
    SubClassOf: bfo:0000015, sdg:sanctionId some xsd:string, sdg:sanctionType some xsd:string, sdg:severityLevel some sdg:SeverityLevelKind, sdg:isRegimented some xsd:boolean, sdg:imposedBy exactly 1 sdg:Norm, sdg:resultingFrom exactly 1 sdg:NormViolation, sdg:affects exactly 1 sdg:Agent

Class: sdg:Agent
    Annotations: rdfs:label "Agent", iao:0000115 "An autonomous entity within the multi-agent system capable of executing actions and subject to normative constraints."
    SubClassOf: sdg:agentId some xsd:string, sdg:agentType some xsd:string, sdg:currentSanctionCount some xsd:integer, sdg:maxAllowedSanctions some xsd:integer, sdg:agentIdentifier some xsd:string, sdg:agentName some xsd:string, sdg:appointmentDate some xsd:date, sdg:terminationDate some xsd:date, sdg:subjectTo some sdg:Norm, sdg:executes some sdg:Transition, sdg:incurs some sdg:Sanction, sdg:appointedBy exactly 1 sdg:BoardOfGovernors, sdg:performs some sdg:FundOperation, sdg:locatedIn exactly 1 sdg:ArchiveLocation
    HasKey: sdg:agentId

Class: sdg:CertificationBody
    Annotations: rdfs:label "Certification Body", iao:0000115 "An accredited organization authorized to assess and certify the conformity of management systems to standards."
    SubClassOf: cco:ont00000995, sdg:bodyName some xsd:string, sdg:accreditationCode some xsd:string, sdg:jurisdiction some sdg:JurisdictionKind, sdg:issuesApprovalTo some sdg:CertifiedOrganization, sdg:employsAuditor some sdg:CertificationRecord

Class: sdg:Auditor
    Annotations: rdfs:label "Auditor", iao:0000115 "A person acting in the role of assessing compliance and issuing certification on behalf of a certification body."
    SubClassOf: bfo:0000023, sdg:auditorName some xsd:string, sdg:auditorTitle some xsd:string, sdg:region some sdg:RegionKind, sdg:auditorId some xsd:string, sdg:licenseNumber some xsd:string, sdg:firmName some xsd:string, sdg:certificationBody some xsd:string, sdg:recordsApproval some sdg:CertificationRecord, sdg:employedBy exactly 1 sdg:CertificationBody, sdg:audits some sdg:FinancialStatement
    HasKey: sdg:auditorId

Class: sdg:ApprovalHistory
    Annotations: rdfs:label "Approval History", iao:0000115 "A record of a past certification event or initial approval granted to an organization."
    SubClassOf: cco:ont00000958, sdg:originalApprovalDate some xsd:date, sdg:historicalApprovalNumber some xsd:string, sdg:historicalStandard some xsd:string, sdg:relatesToOrganization exactly 1 sdg:CertifiedOrganization, sdg:conformsToStandard exactly 1 sdg:ManagementStandard

Class: sdg:InfrastructurePhase
    Annotations: rdfs:label "Infrastructure Construction Phase", iao:0000115 "A discrete temporal segment of a development project during which specific infrastructure construction and inspection activities are executed."
    SubClassOf: sdg:NetworkEntity, sdg:phaseIdentifier some xsd:string, sdg:phaseName some xsd:string, sdg:startDate some xsd:dateTime, sdg:endDate some xsd:dateTime, sdg:status some sdg:StatusKind, sdg:isGuaranteed some xsd:boolean, sdg:phaseStatus some xsd:string, sdg:contains min 2 sdg:InspectionEvent, sdg:requires min 2 sdg:TestSheet, sdg:requires min 2 sdg:Drawing

Class: sdg:TestSheet
    Annotations: rdfs:label "Sewer Main Test Sheet", iao:0000115 "A standardized record or dataset documenting the results of pressure, integrity, or flow tests performed on sanitary or storm sewer mains during construction."
    SubClassOf: cco:ont00000995, sdg:testSheetId some xsd:string, sdg:testType some sdg:TestTypeKind, sdg:testDate some xsd:dateTime, sdg:resultStatus some sdg:ResultStatusKind, sdg:approvedByDetail some xsd:string, sdg:approvalDate some xsd:dateTime, sdg:testSpecification some xsd:string, sdg:isElectronic some xsd:boolean, sdg:requiredFor exactly 1 sdg:InfrastructurePhase, sdg:verifiedBy some sdg:InspectionEvent, sdg:governingRule exactly 1 sdg:Regulation

Class: sdg:Drawing
    Annotations: rdfs:label "Stub-out Record Drawing", iao:0000115 "An electronic designator or dataset representing the precise location and configuration of utility stub-outs connecting to municipal infrastructure."
    SubClassOf: cco:ont00000995, sdg:drawingId some xsd:string, sdg:drawingType some sdg:DrawingTypeKind, sdg:submissionDate some xsd:dateTime, sdg:format some sdg:FormatKind, sdg:status some sdg:StatusKind, sdg:fileSize some xsd:decimal, sdg:isElectronic some xsd:boolean, sdg:requiredFor exactly 1 sdg:InfrastructurePhase, sdg:governingRule exactly 1 sdg:Regulation, sdg:references exactly 1 sdg:InfrastructurePhase

Class: sdg:Deficiency
    Annotations: rdfs:label "Construction Deficiency", iao:0000115 "A specific defect, non-compliance, or punch-list item identified during inspection that requires correction by the contractor before final acceptance."
    SubClassOf: bfo:0000015, sdg:deficiencyId some xsd:string, sdg:description some xsd:string, sdg:severity some sdg:SeverityKind, sdg:identifiedDate some xsd:dateTime, sdg:correctedDate some xsd:dateTime, sdg:status some sdg:StatusKind, sdg:requiresReInspection some xsd:boolean, sdg:identifiedIn exactly 1 sdg:InspectionEvent, sdg:correctedBy exactly 1 sdg:Contractor, sdg:verifiedBy some sdg:InspectionEvent

Class: sdg:Contractor
    Annotations: rdfs:label "Construction Contractor", iao:0000115 "An entity or role responsible for the physical execution of infrastructure construction and the correction of identified deficiencies."
    SubClassOf: bfo:0000015, sdg:contractorId some xsd:string, sdg:contractorName some xsd:string, sdg:licenseNumber some xsd:string, sdg:contactEmail some xsd:string, sdg:status some sdg:StatusKind, sdg:contractorIdentifier some xsd:string, sdg:contractorType some xsd:string, sdg:taxIdentificationNumber some xsd:string, sdg:corrects some sdg:Deficiency, sdg:employedBy exactly 1 sdg:Developer, sdg:receives min 2 sdg:Payment, sdg:holds min 2 sdg:Contract

Class: sdg:Developer
    Annotations: rdfs:label "Project Developer", iao:0000115 "The entity or role responsible for overseeing the construction phase, conducting independent inspections, and certifying completion to the City."
    SubClassOf: bfo:0000015, sdg:developerId some xsd:string, sdg:developerName some xsd:string, sdg:contactEmail some xsd:string, sdg:representativeName some xsd:string, sdg:oversees exactly 1 sdg:InfrastructurePhase, sdg:employs some sdg:Contractor, sdg:submits some sdg:Drawing

Class: sdg:HealthcareProvider
    Annotations: rdfs:label "Healthcare Provider", iao:0000115 "A real-world entity that provides medical or health-related services to a patient."
    SubClassOf: sdg:HealthcareEntity, sdg:providerId some xsd:string, sdg:providerName some xsd:string, sdg:specialty some xsd:string, sdg:contactInfo some xsd:string, sdg:roleDetail some sdg:RoleKind, sdg:accessPermission some xsd:boolean, sdg:providerIdentifier some xsd:string, sdg:licenseNumber some xsd:string, sdg:acceptsNewPatients some xsd:boolean, sdg:performs some sdg:TreatmentEvent, sdg:disclosesTo some sdg:DisclosureRecord, sdg:designatedByIndividual min 2 sdg:EligibleIndividual, sdg:providesServiceTo min 2 sdg:InsuranceClaim
    HasKey: sdg:providerId

Class: sdg:Recipient
    Annotations: rdfs:label "Recipient", iao:0000115 "An individual who receives information about a patient's HIV status."
    SubClassOf: bfo:0000004, sdg:recipientId some xsd:string, sdg:recipientName some xsd:string, sdg:relationshipType some sdg:RelationshipTypeKind, sdg:trustLevel some xsd:string, sdg:receivesDisclosureFrom some sdg:Patient

Class: sdg:SupportResource
    Annotations: rdfs:label "Support Resource", iao:0000115 "A resource or service provided to assist patients in disclosing their HIV status."
    SubClassOf: cco:ont00000995, sdg:resourceId some xsd:string, sdg:resourceName some xsd:string, sdg:resourceType some sdg:ResourceTypeKind, sdg:availabilityStatus some xsd:string, sdg:supportsDisclosureFor some sdg:Patient

Class: sdg:AdmissionCriteria
    Annotations: rdfs:label "Admission Criteria", iao:0000115 "A formal set of requirements and standards that applicants must satisfy to be considered for enrollment in an academic program."
    SubClassOf: cco:ont00000995, sdg:criteriaId some xsd:string, sdg:effectiveDate some xsd:date, sdg:minimumGPA some xsd:decimal, sdg:status some sdg:StatusKind, sdg:description some xsd:string, sdg:appliesTo exactly 1 sdg:AcademicProgram, sdg:requires min 2 sdg:PrerequisiteCourse, sdg:requires max 1 sdg:StandardizedExam, sdg:requires max 1 sdg:ExperientialRequirement

Class: sdg:PrerequisiteCourse
    Annotations: rdfs:label "Prerequisite Course", iao:0000115 "A specific course that must be successfully completed before a student can enroll in a target course or program."
    SubClassOf: cco:ont00000995, sdg:courseCode some sdg:CourseCodeKind, sdg:courseTitle some xsd:string, sdg:credits some xsd:integer, sdg:departmentId some xsd:string, sdg:status some sdg:StatusKind, sdg:requiredBy some sdg:AdmissionCriteria, sdg:offeredBy exactly 1 sdg:Department

Class: sdg:StandardizedExam
    Annotations: rdfs:label "Standardized Exam", iao:0000115 "A formal assessment instrument used to measure academic readiness or aptitude for admission into a program."
    SubClassOf: cco:ont00000995, sdg:examCode some xsd:string, sdg:examName some xsd:string, sdg:status some sdg:StatusKind, sdg:administeredByDetail some xsd:string, sdg:lastUsedDate some xsd:date, sdg:requiredBy max 1 sdg:AdmissionCriteria

Class: sdg:ExperientialRequirement
    Annotations: rdfs:label "Experiential Requirement", iao:0000115 "A non-academic requirement involving practical exposure, work hours, or field experience necessary for program admission."
    SubClassOf: cco:ont00000995, sdg:requirementId some xsd:string, sdg:description some xsd:string, sdg:minimumHours some xsd:integer, sdg:verificationMethod some sdg:VerificationMethodKind, sdg:status some sdg:StatusKind, sdg:requiredBy max 1 sdg:AdmissionCriteria

Class: sdg:ExternalAuthority
    Annotations: rdfs:label "External Authority", iao:0000115 "An outside organization or agency, such as police or government departments, that may be involved in the investigation or resolution of serious bullying incidents."
    SubClassOf: bfo:0000002, sdg:authorityId some xsd:string, sdg:authorityName some xsd:string, sdg:contactPerson some xsd:string, sdg:contactNumber some xsd:string, sdg:authorityType some xsd:string, sdg:receivesReportFrom some sdg:BullyingIncident, sdg:providesSupportTo some sdg:StaffMember

Class: sdg:SurveillanceInstallation
    Annotations: rdfs:label "Video Surveillance Installation Project", iao:0000115 "A planned or executed deployment of video surveillance infrastructure for a specific site or organization."
    SubClassOf: sdg:SecuritySystemComponent, sdg:installationId some xsd:string, sdg:projectName some xsd:string, sdg:targetScale some sdg:TargetScaleKind, sdg:deploymentDate some xsd:dateTime, sdg:status some sdg:StatusKind, sdg:totalCost some xsd:decimal, sdg:uses some sdg:ServerHardware, sdg:uses some sdg:StorageSystem, sdg:uses exactly 1 sdg:VideoManagementSoftware, sdg:targets exactly 1 sdg:ClientOrganization, sdg:deliveredBy some sdg:ChannelPartner
    HasKey: sdg:installationId

Class: sdg:ServerHardware
    Annotations: rdfs:label "Enterprise Server Unit", iao:0000115 "A physical computing unit (rack, blade, tower, or hyperscale) provided by Dell for processing surveillance data."
    SubClassOf: cco:ont00000995, sdg:serverId some xsd:string, sdg:manufacturer some xsd:string, sdg:formFactor some xsd:string, sdg:modelNumber some xsd:string, sdg:serialNumber some xsd:string, sdg:warrantyExpiry some xsd:date, sdg:isManagedService some xsd:boolean, sdg:installedIn some sdg:SurveillanceInstallation

Class: sdg:StorageSystem
    Annotations: rdfs:label "Data Storage Infrastructure", iao:0000115 "Physical or logical storage infrastructure (SAN, NAS, DAS, backup) used to retain surveillance video and metadata."
    SubClassOf: sdg:DataEntity, sdg:storageId some xsd:string, sdg:storageType some sdg:StorageTypeKind, sdg:capacityTB some xsd:decimal, sdg:manufacturer some xsd:string, sdg:modelNumber some xsd:string, sdg:encryptionEnabled some xsd:boolean, sdg:storesDataFor some sdg:SurveillanceInstallation

Class: sdg:VideoManagementSoftware
    Annotations: rdfs:label "VMS Platform", iao:0000115 "Proprietary software suite for managing, viewing, and recording video feeds from surveillance cameras."
    SubClassOf: sdg:SecuritySystemComponent, sdg:softwareId some xsd:string, sdg:version some xsd:string, sdg:licenseType some xsd:string, sdg:maxCameras some xsd:integer, sdg:supportsHD some xsd:boolean, sdg:supportsIP some xsd:boolean, sdg:supportsAnalog some xsd:boolean, sdg:softwareType some xsd:string, sdg:deployedIn exactly 1 sdg:SurveillanceInstallation

Class: sdg:ClientOrganization
    Annotations: rdfs:label "End-User Organization", iao:0000115 "The entity (government, industry, banking, retail, etc.) that commissions and utilizes the surveillance system."
    SubClassOf: sdg:BusinessEntity, sdg:orgId some xsd:string, sdg:orgName some xsd:string, sdg:sector some sdg:SectorKind, sdg:region some sdg:RegionKind, sdg:orgSize some xsd:string, sdg:industrySector some sdg:IndustrySectorKind, sdg:clientId some xsd:string, sdg:organizationName some xsd:string, sdg:accountManager some xsd:string, sdg:commissioned some sdg:SurveillanceInstallation, sdg:subscribesTo min 1 sdg:VideoDeliveryService, sdg:requiresSupportFrom min 1 sdg:TechnicalSupportEngineer, sdg:locatedIn min 1 sdg:NetworkInfrastructure
    HasKey: sdg:orgId

Class: sdg:ChannelPartner
    Annotations: rdfs:label "System Integrator / Reseller", iao:0000115 "A third-party business entity authorized to design, implement, and support surveillance projects on behalf of Infinova and Dell."
    SubClassOf: bfo:0000023, sdg:partnerId some xsd:string, sdg:partnerName some xsd:string, sdg:certificationLevel some xsd:string, sdg:serviceArea some xsd:string, sdg:delivers some sdg:SurveillanceInstallation

Class: sdg:EducationalDevice
    Annotations: rdfs:label "Educational Device", iao:0000115 "A physical computing device (e.g., tablet, computer) procured and distributed to schools for educational use."
    SubClassOf: cco:ont00000995, sdg:deviceId some xsd:string, sdg:deviceType some sdg:DeviceTypeKind, sdg:manufacturer some xsd:string, sdg:modelNumber some xsd:string, sdg:procurementCost some xsd:decimal, sdg:specificationScore some xsd:decimal, sdg:status some sdg:StatusKind, sdg:assignedTo some sdg:School, sdg:suppliedBy exactly 1 sdg:Supplier

Class: sdg:ConnectivityProvider
    Annotations: rdfs:label "Connectivity Provider", iao:0000115 "An organization or entity providing internet connectivity services to schools."
    SubClassOf: sdg:NetworkEntity, sdg:providerId some xsd:string, sdg:name some sdg:NameKind, sdg:serviceType some sdg:ServiceTypeKind, sdg:maxBandwidth some xsd:decimal, sdg:dataAllowance some xsd:decimal, sdg:contractStartDate some xsd:date, sdg:contractEndDate some xsd:date, sdg:providesConnectivityTo some sdg:School, sdg:operatesIn exactly 1 sdg:Country

Class: sdg:Supplier
    Annotations: rdfs:label "Device Supplier", iao:0000115 "An entity or organization supplying educational devices to schools or governments."
    SubClassOf: bfo:0000040, sdg:supplierId some xsd:string, sdg:name some sdg:NameKind, sdg:countryOfOrigin some xsd:string, sdg:certificationLevel some xsd:string, sdg:marketShare some xsd:decimal, sdg:contactEmail some xsd:string, sdg:suppliesDevicesTo some sdg:School, sdg:suppliesTo some sdg:Country

Class: sdg:SocialEnterprise
    Annotations: rdfs:label "Social Enterprise", iao:0000115 "An organization trading for the common good, addressing social needs, strengthening communities, improving people's life chances, and protecting the environment, operating consistent with the Voluntary Code of Practice for Social Enterprise in Scotland."
    SubClassOf: sdg:CommunityEntity, sdg:enterpriseId some xsd:string, sdg:legalForm some xsd:string, sdg:annualIncome some xsd:decimal, sdg:ageYears some xsd:integer, sdg:isCharity some xsd:boolean, sdg:selfIdentifiesAsSocialEnterprise some xsd:boolean, sdg:headquartersLocation some xsd:string, sdg:primaryMarketType some xsd:string, sdg:tradingPurpose some xsd:string, sdg:operatesIn exactly 1 sdg:GeographicRegion, sdg:providesServiceTo some sdg:ServiceDomain, sdg:receivesIncomeFrom some sdg:ClientSector, sdg:formedIn exactly 1 sdg:CensusPeriod
    HasKey: sdg:enterpriseId

Class: sdg:ServiceDomain
    Annotations: rdfs:label "Service Domain", iao:0000115 "A sector or field in which social enterprises operate, such as Housing, Health & Social Care, Community Centres & Halls, or Theatre."
    SubClassOf: bfo:0000015, sdg:domainCode some xsd:string, sdg:domainName some xsd:string, sdg:sectorShareOfIncome some xsd:decimal, sdg:isPrimaryProvider some xsd:boolean, sdg:targetPopulationDetail some sdg:TargetPopulationKind, sdg:serviceType some sdg:ServiceTypeKind, sdg:isHolistic some xsd:boolean, sdg:servedBySocialEnterprises some sdg:SocialEnterprise, sdg:assessedIn some sdg:InspectionReport

Class: sdg:CensusPeriod
    Annotations: rdfs:label "Census Period", iao:0000115 "A biennial time interval during which the Social Enterprise Census is conducted to track the scale, characteristics, and contribution of Scotland's social enterprise sector."
    SubClassOf: bfo:0000015, sdg:periodId some xsd:string, sdg:startYear some xsd:integer, sdg:endYear some xsd:integer, sdg:isBaseline some xsd:boolean, sdg:totalEnterprises some xsd:integer, sdg:growthRate some xsd:decimal, sdg:coversSocialEnterprises some sdg:SocialEnterprise

Class: sdg:MenuItemSize
    Annotations: rdfs:label "Menu Item Size", iao:0000115 "A specific size variant of a menu item that may have a different price or composition, such as different weights for steaks."
    SubClassOf: cco:ont00000995, sdg:sizeId some xsd:string, sdg:weightOz some xsd:decimal, sdg:price some xsd:decimal, sdg:description some xsd:string, sdg:variantOf exactly 1 sdg:MenuItem
    HasKey: sdg:sizeId

Class: sdg:PizzaTopping
    Annotations: rdfs:label "Pizza Topping", iao:0000115 "A specific ingredient available for customization on pizza items, selected from a predefined list."
    SubClassOf: cco:ont00000995, sdg:toppingId some xsd:string, sdg:name some sdg:NameKind, sdg:type some sdg:TypeKind, sdg:isExtraCost some xsd:boolean, sdg:extraCostAmount some xsd:decimal, sdg:usedOn some sdg:MenuItem

Class: sdg:AddOnOption
    Annotations: rdfs:label "Add-On Option", iao:0000115 "An optional extra item that can be added to a base menu item for an additional fee, such as extra protein or sides."
    SubClassOf: cco:ont00000995, sdg:addOnId some xsd:string, sdg:name some sdg:NameKind, sdg:additionalPrice some xsd:decimal, sdg:type some sdg:TypeKind, sdg:availableFor some sdg:MenuItem

Class: sdg:TelephoneInterview
    Annotations: rdfs:label "Telephone Interview", iao:0000115 "A structured conversational process conducted via telephone to gather qualitative insights from researchers about their needs and perceptions."
    SubClassOf: bfo:0000015, sdg:interviewId some xsd:string, sdg:startDate some xsd:dateTime, sdg:endDate some xsd:dateTime, sdg:durationMinutes some xsd:integer, sdg:interviewerId some xsd:string, sdg:conductedWith exactly 1 sdg:Researcher, sdg:conductedWith exactly 1 sdg:GeographicLocation, sdg:yielded some sdg:QualitativeInsight

Class: sdg:QualitativeInsight
    Annotations: rdfs:label "Qualitative Insight", iao:0000115 "A recorded finding, opinion, or perception derived from the analysis of interview data regarding researcher needs and collaboration barriers."
    SubClassOf: cco:ont00000995, sdg:insightId some xsd:string, sdg:theme some xsd:string, sdg:sentiment some sdg:SentimentKind, sdg:priorityLevel some sdg:PriorityLevelKind, sdg:summaryText some xsd:string, sdg:derivedFrom exactly 1 sdg:TelephoneInterview, sdg:supports some sdg:PolicyInstrument

Class: sdg:ChemicalManagementExpert
    Annotations: rdfs:label "Chemical Management Expert", iao:0000115 "A role held by a chemist responsible for overseeing chemical safety, permitting, and inspection activities within a national environmental authority."
    SubClassOf: bfo:0000023, sdg:expertIdentifier some xsd:string, sdg:fullName some xsd:string, sdg:degree some xsd:string, sdg:specialization some sdg:SpecializationKind, sdg:startDate some xsd:dateTime, sdg:currentStatus some sdg:CurrentStatusKind, sdg:worksFor exactly 1 sdg:EnvironmentalAuthority, sdg:coordinates max 1 sdg:InternationalNetwork

Class: sdg:EnvironmentalAuthority
    Annotations: rdfs:label "Environmental Authority", iao:0000115 "A government organization or ministry responsible for environmental policy enforcement, permitting, and inspection activities."
    SubClassOf: sdg:Authority, sdg:authorityCode some xsd:string, sdg:authorityName some xsd:string, sdg:countryCode some sdg:CountryCodeKind, sdg:establishedDate some xsd:date, sdg:competenceLevel some xsd:string, sdg:isCompetentAuthority some xsd:boolean, sdg:scopeOfJurisdiction some xsd:string, sdg:employs min 2 sdg:ChemicalManagementExpert, sdg:enforces some sdg:EnvironmentalRegulation
    HasKey: sdg:authorityCode

Class: sdg:InternationalNetwork
    Annotations: rdfs:label "International Environmental Network", iao:0000115 "A collaborative network of environmental enforcement agencies across multiple jurisdictions, such as IMPEL."
    SubClassOf: bfo:0000015, sdg:networkCode some xsd:string, sdg:networkName some xsd:string, sdg:foundingDate some xsd:date, sdg:memberCount some xsd:integer, sdg:scope some sdg:ScopeKind, sdg:isActive some xsd:boolean, sdg:hasCoordinator max 1 sdg:ChemicalManagementExpert, sdg:coordinatesWith some sdg:EnvironmentalAuthority
    HasKey: sdg:networkCode

Class: sdg:EnvironmentalRegulation
    Annotations: rdfs:label "Environmental Regulation", iao:0000115 "A formal legal instrument or policy document governing environmental protection, chemical safety, or waste management."
    SubClassOf: bfo:00000995, sdg:regulationId some xsd:string, sdg:regulationTitle some xsd:string, sdg:issuingBody some xsd:string, sdg:effectiveDate some xsd:date, sdg:jurisdiction some sdg:JurisdictionKind, sdg:status some sdg:StatusKind, sdg:isEnforcedBy some sdg:EnvironmentalAuthority, sdg:governs some sdg:ChemicalActivity

Class: sdg:ChemicalActivity
    Annotations: rdfs:label "Chemical Activity", iao:0000115 "A process or operation involving the handling, storage, transport, or disposal of chemicals, subject to regulatory oversight."
    SubClassOf: sdg:ProgramActivity, sdg:activityId some xsd:string, sdg:activityType some sdg:ActivityTypeKind, sdg:startDate some xsd:dateTime, sdg:endDate some xsd:dateTime, sdg:status some sdg:StatusKind, sdg:riskLevel some sdg:RiskLevelKind, sdg:isSupervisedBy exactly 1 sdg:ChemicalManagementExpert, sdg:isRegulatedBy some sdg:EnvironmentalRegulation, sdg:occursAt exactly 1 sdg:Facility

Class: sdg:IntegratedWasteSystem
    Annotations: rdfs:label "Integrated Waste System", iao:0000115 "A multi-step process activity employed by the authority to dispose of and process trash, saving landfill capacity and creating clean, renewable energy."
    SubClassOf: bfo:0000015, sdg:systemId some xsd:string, sdg:systemName some xsd:string, sdg:efficiencyRating some xsd:decimal, sdg:landfillCapacitySavedPercent some xsd:decimal, sdg:energyGeneratedMWh some xsd:decimal, sdg:lastAuditDate some xsd:date, sdg:processesWasteStream min 2 sdg:WasteStream, sdg:operatedByFacility exactly 1 sdg:WasteProcessingFacility, sdg:generatesEnergy min 2 sdg:EnergyOutput

Class: sdg:PowerGrid
    Annotations: rdfs:label "Power Grid", iao:0000115 "A material entity representing the electrical infrastructure network to which renewable energy from waste processing is supplied."
    SubClassOf: bfo:0000040, sdg:gridId some xsd:string, sdg:gridOperator some xsd:string, sdg:voltageLevel some xsd:string, sdg:capacityMVA some xsd:decimal, sdg:lastMaintenanceDate some xsd:date, sdg:receivesEnergyFrom min 2 sdg:EnergyOutput, sdg:servesRegion min 2 sdg:Jurisdiction

Class: sdg:ExecutiveDirector
    Annotations: rdfs:label "Executive Director", iao:0000115 "The senior operating officer role responsible for overseeing administration, operations, facility integrity, fundraising, and strategic planning at the Capitol Civic Centre."
    SubClassOf: bfo:0000023, sdg:employeeId some xsd:string, sdg:reportingTo some xsd:string, sdg:positionType some xsd:string, sdg:salaryMin some xsd:decimal, sdg:salaryMax some xsd:decimal, sdg:degreeLevel some xsd:string, sdg:yearsExperience some xsd:integer, sdg:isExempt some xsd:boolean, sdg:manages exactly 1 sdg:Organization, sdg:supervises min 2 sdg:StaffMember, sdg:oversees exactly 1 sdg:Facility

Class: sdg:ClinicalService
    Annotations: rdfs:label "Weight Management Clinic", iao:0000115 "A private healthcare facility providing weight reduction services, dietary advice, and prescribed medicines to adult patients."
    SubClassOf: sdg:HealthcareEntity, sdg:serviceId some xsd:string, sdg:serviceType some sdg:ServiceTypeKind, sdg:operatingHours some xsd:string, sdg:locationAddress some xsd:string, sdg:locationPostcode some xsd:string, sdg:numberOfClinicians some xsd:integer, sdg:numberOfSupportStaff some xsd:integer, sdg:serviceStatus some sdg:ServiceStatusKind, sdg:serviceCategory some sdg:ServiceCategoryKind, sdg:serviceName some xsd:string, sdg:requiresAppointment some xsd:boolean, sdg:isUrgentCare some xsd:boolean, sdg:serviceCode some xsd:string, sdg:frequency some sdg:FrequencyKind, sdg:duration some xsd:decimal, sdg:status some sdg:StatusKind, sdg:staffedBy min 1 sdg:Clinician, sdg:managedBy exactly 1 sdg:RegisteredManager, sdg:serves min 2 sdg:Patient, sdg:providedBy min 2 sdg:HealthcareProfessional, sdg:deliveredTo min 2 sdg:Patient, sdg:locatedAt exactly 1 sdg:MedicalPractice, sdg:providedBy exactly 1 sdg:TreatmentProgram, sdg:performedOn some sdg:Patient, sdg:usesAssessment max 1 sdg:RiskAssessment

Class: sdg:RegulatoryFinding
    Annotations: rdfs:label "Compliance Finding", iao:0000115 "A recorded observation or determination regarding a specific aspect of a clinical service's adherence to regulatory standards."
    SubClassOf: sdg:RegulatoryComplianceConcept, sdg:findingId some xsd:string, sdg:findingCategory some xsd:string, sdg:findingStatus some sdg:FindingStatusKind, sdg:findingDescription some xsd:string, sdg:findingDate some xsd:dateTime, sdg:priorFindingId some xsd:string, sdg:pertainsTo exactly 1 sdg:ClinicalService, sdg:partOf__escalated exactly 1 sdg:InspectionEvent, sdg:addresses some sdg:RegulatoryRequirement

Class: sdg:Medicine
    Annotations: rdfs:label "Prescribed Pharmaceutical", iao:0000115 "A pharmaceutical product supplied to patients as part of a weight management treatment plan, including licensed and unlicensed medicines."
    SubClassOf: cco:ont00000995, sdg:medicineId some xsd:string, sdg:medicineName some xsd:string, sdg:medicineType some xsd:string, sdg:prescriptionStatus some sdg:PrescriptionStatusKind, sdg:storageCondition some xsd:string, sdg:clinicalNeedJustification some xsd:string, sdg:prescribedTo min 2 sdg:Patient, sdg:prescribedBy exactly 1 sdg:Clinician
    HasKey: sdg:medicineId

Class: sdg:RegulatoryRequirement
    Annotations: rdfs:label "Legal Compliance Standard", iao:0000115 "A specific legal or regulatory obligation derived from the Health and Social Care Act 2008 that a clinical service must satisfy."
    SubClassOf: sdg:RegulatoryComplianceConcept, sdg:requirementId some xsd:string, sdg:requirementCategory some sdg:RequirementCategoryKind, sdg:requirementDescription some xsd:string, sdg:legalBasis some xsd:string, sdg:complianceStatus some sdg:ComplianceStatusKind, sdg:governs exactly 1 sdg:ClinicalService, sdg:addressedBy some sdg:RegulatoryFinding

Class: sdg:BranchSociety
    Annotations: rdfs:label "Branch Society", iao:0000115 "A geographically defined subdivision of the Harris County Medical Society that organizes local meetings and educational programs for physicians in a specific area."
    SubClassOf: bfo:0000040, sdg:branchCode some xsd:string, sdg:geographicArea some xsd:string, sdg:meetingFrequency some sdg:MeetingFrequencyKind, sdg:primaryAddress some xsd:string, sdg:hostsMeeting some sdg:BranchMeeting, sdg:servesPhysician some sdg:Physician

Class: sdg:BranchMeeting
    Annotations: rdfs:label "Branch Meeting", iao:0000115 "A scheduled educational and networking event held by a branch society, typically focusing on continuing medical education and practice management."
    SubClassOf: bfo:0000015, sdg:meetingDate some xsd:dateTime, sdg:startTime some xsd:dateTime, sdg:durationHours some xsd:decimal, sdg:location some xsd:string, sdg:topic some xsd:string, sdg:status some sdg:StatusKind, sdg:organizedBy exactly 1 sdg:BranchSociety, sdg:attendedBy some sdg:Physician

Class: sdg:Physician
    Annotations: rdfs:label "Physician", iao:0000115 "A licensed medical doctor who is a member of the Harris County Medical Society and participates in its activities and committees."
    SubClassOf: bfo:0000002, sdg:physicianID some xsd:string, sdg:fullName some xsd:string, sdg:age some xsd:integer, sdg:yearsInPractice some xsd:integer, sdg:primaryAddress some xsd:string, sdg:membershipStatus some sdg:MembershipStatusKind, sdg:physicianId some xsd:string, sdg:specialty some xsd:string, sdg:boardCertified some xsd:boolean, sdg:roleInStudy some xsd:string, sdg:assignedToBranch exactly 1 sdg:BranchSociety, sdg:attendsMeeting some sdg:BranchMeeting, sdg:servesOnCommittee some sdg:Committee, sdg:enrolls min 2 sdg:PatientEnrollment, sdg:orders min 2 sdg:ImagingProcedure, sdg:interprets min 2 sdg:ScanResult

Class: sdg:Committee
    Annotations: rdfs:label "Committee", iao:0000115 "A formal organizational unit within the Harris County Medical Society responsible for specific oversight, educational, or legislative functions."
    SubClassOf: bfo:0000040, sdg:committeeName some xsd:string, sdg:committeeCode some xsd:string, sdg:meetingFrequency some sdg:MeetingFrequencyKind, sdg:meetingTime some xsd:string, sdg:meetingLocation some xsd:string, sdg:appointmentMonth some xsd:integer, sdg:meetsAt exactly 1 sdg:Location, sdg:hasMember min 2 sdg:Physician

Class: sdg:FinancialCrisis
    Annotations: rdfs:label "Financial Crisis", iao:0000115 "A systemic failure in the financial system characterized by widespread insolvency, liquidity shortages, and loss of confidence among financial institutions."
    SubClassOf: bfo:0000015, sdg:startDate some xsd:dateTime, sdg:endDate some xsd:dateTime, sdg:severityIndex some xsd:decimal, sdg:affectedRegions some xsd:string, sdg:primaryTrigger some xsd:string, sdg:causedBy min 2 sdg:EconomicCondition, sdg:triggeredByBy some sdg:PolicyDecision, sdg:resolvedBy some sdg:BailoutProgram

Class: sdg:EconomicCondition
    Annotations: rdfs:label "Economic Condition", iao:0000115 "A measurable state of the macroeconomy, such as inequality, debt levels, or income stagnation, that contributes to systemic risk."
    SubClassOf: sdg:conditionType some xsd:string, sdg:measurementValue some xsd:decimal, sdg:measurementUnit some xsd:string, sdg:geographicScope some xsd:string, sdg:timePeriod some xsd:string, sdg:contributesTo some sdg:FinancialCrisis

Class: sdg:BailoutProgram
    Annotations: rdfs:label "Bailout Program", iao:0000115 "A government intervention program designed to rescue failing financial institutions or stabilize the financial system during a crisis."
    SubClassOf: bfo:0000015, sdg:programName some xsd:string, sdg:startDate some xsd:dateTime, sdg:endDate some xsd:dateTime, sdg:totalCost some xsd:decimal, sdg:currency some xsd:string, sdg:status some sdg:StatusKind, sdg:executedBy min 2 sdg:GovernmentAgency, sdg:targets min 2 sdg:FinancialInstitution, sdg:partOf__escalated exactly 1 sdg:FinancialCrisis

Class: sdg:PolicyDecision
    Annotations: rdfs:label "Policy Decision", iao:0000115 "A formal action or regulation enacted by a government body that influences economic or financial conditions, such as deregulation or fiscal tightening."
    SubClassOf: bfo:0000015, sdg:decisionTitle some xsd:string, sdg:effectiveDate some xsd:date, sdg:decisionType some xsd:string, sdg:issuingAuthorityDetail some xsd:string, sdg:legalBasis some xsd:string, sdg:influences some sdg:EconomicCondition, sdg:implementedBy exactly 1 sdg:GovernmentAgency, sdg:contributesTo some sdg:FinancialCrisis

Class: sdg:LegalAct
    Annotations: rdfs:label "Legal Act", iao:0000115 "A formal legislative instrument such as a Council Regulation or Directive that establishes or modifies the legal basis and operational framework of the European Monetary Cooperation Fund."
    SubClassOf: sdg:LegalEntity, sdg:actIdentifier some xsd:string, sdg:actTitle some xsd:string, sdg:issuingBody some xsd:string, sdg:effectiveDate some xsd:date, sdg:legalStatus some sdg:LegalStatusKind, sdg:actIdentif some xsd:string, sdg:governs some sdg:FundOperation, sdg:cites some sdg:LegalAct

Class: sdg:FundOperation
    Annotations: rdfs:label "Fund Operation", iao:0000115 "A specific administrative or financial activity carried out by the European Monetary Cooperation Fund, such as currency intervention monitoring, short-term financing administration, or ECU creation and remuneration."
    SubClassOf: sdg:FinancialEntity, sdg:operationCode some xsd:string, sdg:operationType some sdg:OperationTypeKind, sdg:startDate some xsd:dateTime, sdg:endDate some xsd:dateTime, sdg:status some sdg:StatusKind, sdg:governedBy exactly 1 sdg:LegalAct, sdg:conductedBy exactly 1 sdg:Agent

Class: sdg:BoardOfGovernors
    Annotations: rdfs:label "Board of Governors", iao:0000115 "The governing body of the European Monetary Cooperation Fund, composed of central bank governors from EEC member states, responsible for overseeing fund activities and appointing the Agent."
    SubClassOf: bfo:0000015, sdg:boardIdentifier some xsd:string, sdg:meetingDate some xsd:dateTime, sdg:meetingLocation some xsd:string, sdg:attendanceStatus some xsd:string, sdg:decisionOutcome some xsd:string, sdg:appoints exactly 1 sdg:Agent, sdg:oversees some sdg:FundOperation, sdg:attends some sdg:BoardMeeting

Class: sdg:BoardMeeting
    Annotations: rdfs:label "Board Meeting", iao:0000115 "A formal gathering of the Board of Governors to discuss fund policies, review operations, and make decisions regarding the European Monetary Cooperation Fund's activities."
    SubClassOf: bfo:0000015, sdg:meetingIdentifier some xsd:string, sdg:meetingDate some xsd:dateTime, sdg:agendaItem some xsd:string, sdg:minutesStatus some xsd:string, sdg:confidentialityLevel some xsd:string, sdg:meetingType some sdg:MeetingTypeKind, sdg:status some sdg:StatusKind, sdg:quorumPresent some xsd:boolean, sdg:convenedBy exactly 1 sdg:BoardOfGovernors, sdg:records some sdg:Document, sdg:discusses some sdg:FundOperation, sdg:approves some sdg:AssessmentNotice, sdg:approves some sdg:PropertyExemption, sdg:convenedBy exactly 1 sdg:BoardOfAssessors

Class: sdg:Document
    Annotations: rdfs:label "Document", iao:0000115 "A textual record, report, notification, or legal instrument created or held by the European Monetary Cooperation Fund, including minutes, directives, and operational reports."
    SubClassOf: sdg:Book, sdg:documentIdentifier some xsd:string, sdg:documentTitle some xsd:string, sdg:creationDate some xsd:dateTime, sdg:language some sdg:LanguageKind, sdg:accessStatus some sdg:AccessStatusKind, sdg:documentId some xsd:string, sdg:name some sdg:NameKind, sdg:type some sdg:TypeKind, sdg:issueDate some xsd:date, sdg:issuingAuthorityDetail some xsd:string, sdg:recognizedBy some xsd:integer, sdg:documentType some sdg:DocumentTypeKind, sdg:isCopyrighted some xsd:boolean, sdg:hasOriginalPages some xsd:integer, sdg:hasCopyCount some xsd:integer, sdg:isEmergency some xsd:boolean, sdg:dropBoxLocation some xsd:string, sdg:createdBy exactly 1 sdg:Agent, sdg:relatedTo some sdg:FundOperation, sdg:storedIn exactly 1 sdg:ArchiveLocation, sdg:references some sdg:LegalAct, sdg:inventedBy exactly 1 sdg:Explorer, sdg:usedFor some sdg:HumanitarianAction, sdg:submittedBy some sdg:Person, sdg:processedBy some sdg:OfficeProcess, sdg:requiresForm exactly 1 sdg:CopyRequestForm, sdg:sentTo some sdg:PostalAddress

Class: sdg:ArchiveLocation
    Annotations: rdfs:label "Archive Location", iao:0000115 "A physical or institutional repository where documents and records of the European Monetary Cooperation Fund are stored, such as the Bank for International Settlements in Basel or the ECB Archives in Frankfurt."
    SubClassOf: bfo:0000002, sdg:locationIdentifier some xsd:string, sdg:locationName some xsd:string, sdg:city some xsd:string, sdg:country some sdg:CountryKind, sdg:accessPolicy some sdg:AccessPolicyKind, sdg:holds some sdg:Document, sdg:transferredTo max 1 sdg:ArchiveLocation

Class: sdg:LegalFramework
    Annotations: rdfs:label "Legal Framework", iao:0000115 "A recognized law, treaty, or regulatory standard that mandates child protection obligations."
    SubClassOf: sdg:LegalEntity, sdg:frameworkIdentifier some xsd:string, sdg:jurisdiction some sdg:JurisdictionKind, sdg:enactmentDate some xsd:date, sdg:issuingBody some xsd:string, sdg:frameworkType some xsd:string, sdg:status some sdg:StatusKind, sdg:mandates some sdg:SafeguardingPolicy, sdg:covers min 2 sdg:AbuseType

Class: sdg:SafeguardingProtocol
    Annotations: rdfs:label "Safeguarding Protocol", iao:0000115 "A defined procedure or action taken in response to a safeguarding concern, such as reporting, investigation, or referral."
    SubClassOf: sdg:SecurityAndSafetyMeasure, sdg:protocolId some xsd:string, sdg:protocolName some xsd:string, sdg:triggerCondition some xsd:string, sdg:requiredAction some xsd:string, sdg:deadlineHours some xsd:integer, sdg:status some sdg:StatusKind, sdg:protocolStatus some xsd:string, sdg:triggeredBy some sdg:Incident, sdg:assignedTo min 1 sdg:StaffMember, sdg:resultsIn max 1 sdg:Referral

Class: sdg:Referral
    Annotations: rdfs:label "External Referral", iao:0000115 "A formal transmission of information to an external agency for further action regarding a safeguarding incident."
    SubClassOf: cco:ont00000995, sdg:referralId some xsd:string, sdg:submittedDate some xsd:dateTime, sdg:recipientAgency some xsd:string, sdg:agencyContact some xsd:string, sdg:referralType some xsd:string, sdg:status some sdg:StatusKind, sdg:originatesFrom exactly 1 sdg:Incident, sdg:initiatedBy exactly 1 sdg:StaffMember

Class: sdg:HeatRecoverySystem
    Annotations: rdfs:label "Condensing Heat Recovery System", iao:0000115 "A manufactured industrial system designed to capture waste thermal energy from exhaust streams and transfer it to process fluids."
    SubClassOf: sdg:Resource, sdg:systemIdentifier some xsd:string, sdg:systemModel some xsd:string, sdg:designCapacity some xsd:decimal, sdg:commissioningDate some xsd:date, sdg:deliveryMode some xsd:string, sdg:status some sdg:StatusKind, sdg:commissioningStatus some xsd:string, sdg:installedAt exactly 1 sdg:PulpMill, sdg:capturesFrom exactly 1 sdg:ExhaustStream, sdg:deliversTo min 2 sdg:HeatSink

Class: sdg:PulpMill
    Annotations: rdfs:label "Pulp Manufacturing Facility", iao:0000115 "A physical industrial plant where wood pulp is processed, characterized by specific infrastructure and operational zones."
    SubClassOf: bfo:0000004, sdg:millIdentifier some xsd:string, sdg:location some xsd:string, sdg:country some sdg:CountryKind, sdg:operationalStatus some sdg:OperationalStatusKind, sdg:primaryProduct some xsd:string, sdg:hosts some sdg:HeatRecoverySystem, sdg:hosts some sdg:SteamTurbine

Class: sdg:ExhaustStream
    Annotations: rdfs:label "Pulp Dryer Exhaust", iao:0000115 "A gaseous effluent stream generated by the pulp drying process, characterized by specific thermal and humidity properties."
    SubClassOf: bfo:0000002, sdg:streamIdentifier some xsd:string, sdg:sourceProcess some xsd:string, sdg:temperature some xsd:decimal, sdg:humidityLevel some xsd:string, sdg:flowRate some xsd:decimal, sdg:foulingPotential some xsd:string, sdg:capturedBy exactly 1 sdg:HeatRecoverySystem, sdg:originatesFrom exactly 1 sdg:PulpMill

Class: sdg:HeatSink
    Annotations: rdfs:label "Thermal Energy Recipient", iao:0000115 "A physical system, fluid, or space that receives thermal energy transferred from the heat recovery system."
    SubClassOf: bfo:0000004, sdg:sinkIdentifier some xsd:string, sdg:sinkType some xsd:string, sdg:targetTemperature some xsd:decimal, sdg:flowVolume some xsd:decimal, sdg:unitCount some xsd:integer, sdg:suppliedBy exactly 1 sdg:HeatRecoverySystem, sdg:locatedIn exactly 1 sdg:PulpMill

Class: sdg:SteamTurbine
    Annotations: rdfs:label "Electricity Generating Steam Turbine", iao:0000115 "A mechanical device that converts thermal energy from steam into rotational mechanical energy for electricity generation."
    SubClassOf: bfo:0000004, sdg:turbineIdentifier some xsd:string, sdg:powerOutput some xsd:decimal, sdg:steamInputRate some xsd:decimal, sdg:operationalSeason some xsd:string, sdg:fedBy exactly 1 sdg:HeatSink, sdg:locatedIn exactly 1 sdg:PulpMill

Class: sdg:ProcessWater
    Annotations: rdfs:label "Industrial Process Water", iao:0000115 "Water used in industrial processes such as boiler feed or bleach plant makeup, characterized by volume and temperature."
    SubClassOf: bfo:0000002, sdg:waterIdentifier some xsd:string, sdg:usageType some sdg:UsageTypeKind, sdg:flowRate some xsd:decimal, sdg:temperature some xsd:decimal, sdg:preheatedBy some xsd:boolean, sdg:heatedBy exactly 1 sdg:HeatRecoverySystem, sdg:consumedBy exactly 1 sdg:PulpMill

Class: sdg:ESGMetric
    Annotations: rdfs:label "ESG Metric", iao:0000115 "A quantifiable measure of environmental, social, or governance performance tracked by the organization."
    SubClassOf: cco:ont00000995, sdg:metricId some xsd:string, sdg:metricName some xsd:string, sdg:category some sdg:CategoryKind, sdg:standard some sdg:StandardKind, sdg:unitOfMeasure some sdg:UnitOfMeasureKind, sdg:isMaterial some xsd:boolean, sdg:standardFramework some xsd:string, sdg:reportedIn some sdg:ESGReport, sdg:monitoredBy some sdg:ESGAdvisor, sdg:measuredBy some sdg:ESGMeasurement

Class: sdg:ESGReport
    Annotations: rdfs:label "ESG Report", iao:0000115 "A formal document detailing the organization's ESG performance, material issues, and strategic initiatives."
    SubClassOf: cco:ont00000995, sdg:reportId some xsd:string, sdg:reportTitle some xsd:string, sdg:publicationDate some xsd:date, sdg:reportingPeriodStart some xsd:date, sdg:reportingPeriodEnd some xsd:date, sdg:status some sdg:StatusKind, sdg:sectorClassification some xsd:string, sdg:complianceStatus some sdg:ComplianceStatusKind, sdg:containsMetric min 2 sdg:ESGMetric, sdg:authoredBy some sdg:ESGAdvisor, sdg:approvedBy exactly 1 sdg:ExecutiveLeader, sdg:governedBy exactly 1 sdg:ESGStrategy

Class: sdg:ESGAdvisor
    Annotations: rdfs:label "ESG Advisor", iao:0000115 "A staff member responsible for providing subject matter expertise, strategic guidance, and analysis on ESG matters."
    SubClassOf: bfo:0000002, sdg:employeeId some xsd:string, sdg:jobTitle some xsd:string, sdg:department some xsd:string, sdg:salaryMin some xsd:decimal, sdg:salaryMax some xsd:decimal, sdg:contractType some xsd:string, sdg:startDate some xsd:dateTime, sdg:advisorId some xsd:string, sdg:advisorName some xsd:string, sdg:designation some xsd:string, sdg:yearsExperience some xsd:integer, sdg:employmentStatus some sdg:EmploymentStatusKind, sdg:reportsTo exactly 1 sdg:ExecutiveLeader, sdg:monitors min 2 sdg:ESGMetric, sdg:authored some sdg:ESGReport, sdg:specializesIn min 2 sdg:ESGStandard, sdg:leads some sdg:ESGStrategy, sdg:conducts some sdg:ESGMeasurement, sdg:monitors some sdg:PolicyChange
    HasKey: sdg:employeeId

Class: sdg:ExecutiveLeader
    Annotations: rdfs:label "Executive Leader", iao:0000115 "A senior organizational role responsible for strategic oversight, approval of major reports, and cross-functional leadership."
    SubClassOf: bfo:0000002, sdg:employeeId some xsd:string, sdg:jobTitle some xsd:string, sdg:department some xsd:string, sdg:hasDottedLineTo some xsd:string, sdg:supervises min 2 sdg:ESGAdvisor, sdg:approves min 2 sdg:ESGReport, sdg:leads min 2 sdg:ESGStrategy

Class: sdg:ESGStrategy
    Annotations: rdfs:label "ESG Strategy", iao:0000115 "A planned set of actions, programs, and initiatives designed to achieve specific environmental, social, and governance goals."
    SubClassOf: bfo:0000015, sdg:strategyId some xsd:string, sdg:strategyName some xsd:string, sdg:status some sdg:StatusKind, sdg:targetCompletionDate some xsd:date, sdg:scope some sdg:ScopeKind, sdg:targetYear some xsd:integer, sdg:alignmentFramework some sdg:AlignmentFrameworkKind, sdg:drives min 2 sdg:ESGMetric, sdg:implementedBy some sdg:ESGAdvisor, sdg:oversightedBy exactly 1 sdg:ExecutiveLeader, sdg:evaluates min 2 sdg:ESGReport, sdg:targetsMetric min 2 sdg:ESGMetric, sdg:monitors some sdg:PolicyChange

Class: sdg:ESGStandard
    Annotations: rdfs:label "ESG Standard", iao:0000115 "A recognized framework, set of guidelines, or regulatory requirement used to structure ESG reporting and compliance."
    SubClassOf: cco:ont00000958, sdg:standardId some xsd:string, sdg:standardName some xsd:string, sdg:issuingBody some xsd:string, sdg:effectiveDate some xsd:date, sdg:jurisdiction some sdg:JurisdictionKind, sdg:guides min 2 sdg:ESGMetric, sdg:monitoredBy min 2 sdg:ESGAdvisor, sdg:compliesWith min 2 sdg:ESGReport

Class: sdg:KnowledgeOrganizationSystem
    Annotations: rdfs:label "Knowledge Organization System", iao:0000115 "A structured system of controlled terms, vocabularies, or taxonomies used to organize and retrieve information resources."
    SubClassOf: cco:ont00000995, sdg:identifier some xsd:string, sdg:name some sdg:NameKind, sdg:version some xsd:string, sdg:lastUpdated some xsd:dateTime, sdg:scope some sdg:ScopeKind, sdg:status some sdg:StatusKind, sdg:containsTerm min 2 sdg:ControlledTerm, sdg:usedBy some sdg:TaggingActivity

Class: sdg:ControlledTerm
    Annotations: rdfs:label "Controlled Term", iao:0000115 "A standardized vocabulary item within a knowledge organization system, representing a specific concept with controlled spelling and disambiguation."
    SubClassOf: cco:ont00000995, sdg:termId some xsd:string, sdg:prefLabel some xsd:string, sdg:altLabel some xsd:string, sdg:definition some xsd:string, sdg:broaderTerm some xsd:string, sdg:narrowerTerm some xsd:string, sdg:relatedTerm some xsd:string, sdg:partOfSystem exactly 1 sdg:KnowledgeOrganizationSystem, sdg:synonymOf some sdg:ControlledTerm, sdg:broaderThan max 1 sdg:ControlledTerm, sdg:narrowerThan some sdg:ControlledTerm

Class: sdg:SocialTag
    Annotations: rdfs:label "Social Tag", iao:0000115 "An uncontrolled, user-generated keyword or phrase applied to a digital resource to describe its content or context."
    SubClassOf: sdg:tagId some xsd:string, sdg:tagText some xsd:string, sdg:spellingVariant some xsd:string, sdg:usageCount some xsd:integer, sdg:firstUsed some xsd:dateTime, sdg:lastUsed some xsd:dateTime, sdg:isAmbiguous some xsd:boolean, sdg:appliedTo some sdg:DigitalResource, sdg:createdBy exactly 1 sdg:User, sdg:mapsTo max 1 sdg:ControlledTerm
    HasKey: sdg:tagId

Class: sdg:TaggingActivity
    Annotations: rdfs:label "Tagging Activity", iao:0000115 "The process or event of applying social tags or controlled terms to digital resources by users or indexers."
    SubClassOf: bfo:0000015, sdg:activityId some xsd:string, sdg:startTime some xsd:dateTime, sdg:endTime some xsd:dateTime, sdg:method some sdg:MethodKind, sdg:qualityScore some xsd:decimal, sdg:indexerRole some xsd:string, sdg:targetsResource exactly 1 sdg:DigitalResource, sdg:usesSystem max 1 sdg:KnowledgeOrganizationSystem, sdg:appliesTag some sdg:SocialTag, sdg:appliesTerm some sdg:ControlledTerm, sdg:performedBy exactly 1 sdg:User

Class: sdg:User
    Annotations: rdfs:label "User", iao:0000115 "An individual or agent who interacts with digital resources, either by tagging them, creating them, or indexing them."
    SubClassOf: bfo:0000023, sdg:userId some xsd:string, sdg:username some xsd:string, sdg:registrationDate some xsd:dateTime, sdg:roleDetail some sdg:RoleKind, sdg:affiliation some sdg:AffiliationKind, sdg:isActive some xsd:boolean, sdg:creates some sdg:DigitalResource, sdg:tags some sdg:SocialTag, sdg:performsActivity some sdg:TaggingActivity

Class: sdg:DigitalCollection
    Annotations: rdfs:label "Digital Collection", iao:0000115 "A curated set of digital resources organized for specific purposes, such as research, education, or archival preservation."
    SubClassOf: cco:ont00000995, sdg:collectionId some xsd:string, sdg:name some sdg:NameKind, sdg:description some xsd:string, sdg:dateEstablished some xsd:date, sdg:resourceCount some xsd:integer, sdg:accessLevel some sdg:AccessLevelKind, sdg:containsResource min 2 sdg:DigitalResource, sdg:usesSystem some sdg:KnowledgeOrganizationSystem, sdg:managedBy some sdg:User

Class: sdg:Expedition
    Annotations: rdfs:label "Expedition", iao:0000115 "A planned journey or voyage undertaken to explore a specific region or achieve scientific objectives."
    SubClassOf: bfo:0000015, sdg:expeditionId some xsd:string, sdg:startDate some xsd:dateTime, sdg:endDate some xsd:dateTime, sdg:durationDays some xsd:integer, sdg:objective some xsd:string, sdg:status some sdg:StatusKind, sdg:teamSize some xsd:integer, sdg:region some sdg:RegionKind, sdg:ledBy exactly 1 sdg:Explorer, sdg:usesEquipment some sdg:Equipment, sdg:collectsData some sdg:Observation, sdg:traverses some sdg:GeographicArea

Class: sdg:Explorer
    Annotations: rdfs:label "Explorer", iao:0000115 "A person who leads or participates in expeditions to explore unknown or remote regions."
    SubClassOf: bfo:0000004, sdg:explorerId some xsd:string, sdg:fullName some xsd:string, sdg:birthDate some xsd:date, sdg:deathDate some xsd:date, sdg:nationality some xsd:string, sdg:specialization some sdg:SpecializationKind, sdg:skills some xsd:string, sdg:leads some sdg:Expedition, sdg:awarded some sdg:Award, sdg:invented some sdg:Document

Class: sdg:Observation
    Annotations: rdfs:label "Observation", iao:0000115 "A recorded measurement or data point collected during an expedition or scientific study."
    SubClassOf: cco:ont00000995, sdg:observationId some xsd:string, sdg:timestamp some xsd:dateTime, sdg:parameter some xsd:string, sdg:value some xsd:decimal, sdg:unit some sdg:UnitKind, sdg:status some sdg:StatusKind, sdg:observationIdentifier some xsd:string, sdg:observationDateTime some xsd:dateTime, sdg:targetBodyName some xsd:string, sdg:targetBodyType some xsd:string, sdg:angularSeparation some xsd:decimal, sdg:instrumentUsed some xsd:string, sdg:observerName some xsd:string, sdg:weatherCondition some sdg:WeatherConditionKind, sdg:collectedBy exactly 1 sdg:Expedition, sdg:measuredBy some sdg:Equipment, sdg:targeted exactly 1 sdg:CelestialBody, sdg:performedBy exactly 1 sdg:Observer, sdg:usedInstrument exactly 1 sdg:Telescope

Class: sdg:HumanitarianAction
    Annotations: rdfs:label "HumanitarianAction", iao:0000115 "An organized effort to provide relief, repatriation, or assistance to displaced persons or refugees."
    SubClassOf: bfo:0000015, sdg:actionId some xsd:string, sdg:startDate some xsd:dateTime, sdg:endDate some xsd:dateTime, sdg:type some sdg:TypeKind, sdg:beneficiariesCount some xsd:integer, sdg:status some sdg:StatusKind, sdg:ledBy exactly 1 sdg:Explorer, sdg:usesDocument some sdg:Document

Class: sdg:ControlGroup
    Annotations: rdfs:label "Control Group", iao:0000115 "A group of participants in a clinical trial who do not receive the experimental intervention, serving as a baseline for comparison."
    SubClassOf: bfo:00000995, sdg:controlGroupId some xsd:string, sdg:type some sdg:TypeKind, sdg:size some xsd:string, sdg:partOf__escalated exactly 1 sdg:ClinicalTrial, sdg:receives max 1 sdg:ControlIntervention

Class: sdg:ControlIntervention
    Annotations: rdfs:label "Control Intervention", iao:0000115 "The treatment or procedure given to the control group in a clinical trial, such as a placebo or standard care."
    SubClassOf: bfo:0000015, sdg:controlInterventionId some xsd:string, sdg:name some sdg:NameKind, sdg:dosage some xsd:string, sdg:unit some sdg:UnitKind, sdg:administeredTo exactly 1 sdg:ControlGroup

Class: sdg:OutcomeMeasure
    Annotations: rdfs:label "Outcome Measure", iao:0000115 "A specific metric or endpoint used to evaluate the effectiveness of an intervention in a clinical trial."
    SubClassOf: bfo:0000015, sdg:measureId some xsd:string, sdg:name some sdg:NameKind, sdg:type some sdg:TypeKind, sdg:unit some sdg:UnitKind, sdg:collectionMethod some xsd:string, sdg:usedIn exactly 1 sdg:ClinicalTrial

Class: sdg:AmateurRadioStation
    Annotations: rdfs:label "Amateur Radio Station", iao:0000115 "A physical or logical amateur radio station identified by a unique call sign and SSID used for communication with LignoSat."
    SubClassOf: cco:ont00000995, sdg:callSign some xsd:string, sdg:ssid some xsd:integer, sdg:locationQth some xsd:string, sdg:regionQra some xsd:string, sdg:status some sdg:StatusKind, sdg:transmitsTo some sdg:LignoSatUplinkSignal, sdg:receivesCertificateFrom max 1 sdg:CommunicationCertificate

Class: sdg:LignoSatUplinkSignal
    Annotations: rdfs:label "LignoSat Uplink Signal", iao:0000115 "An FM packet transmission from an amateur radio station to LignoSat containing call sign and message data."
    SubClassOf: bfo:0000015, sdg:signalId some xsd:string, sdg:timestamp some xsd:dateTime, sdg:frequency some sdg:FrequencyKind, sdg:protocolVersion some xsd:string, sdg:messageContent some xsd:string, sdg:originatesFrom exactly 1 sdg:AmateurRadioStation, sdg:processedBy exactly 1 sdg:LignoSat, sdg:containsMessage some sdg:ExtractedMessage
    HasKey: sdg:signalId

Class: sdg:LignoSat
    Annotations: rdfs:label "LignoSat Satellite", iao:0000115 "A satellite platform that receives amateur radio uplink signals, extracts call signs and messages, and transmits CW downlink responses."
    SubClassOf: cco:ont00000995, sdg:satelliteId some xsd:string, sdg:orbitType some sdg:OrbitTypeKind, sdg:memoryCapacity some xsd:integer, sdg:downlinkMode some xsd:string, sdg:status some sdg:StatusKind, sdg:receivesUplinkFrom some sdg:LignoSatUplinkSignal, sdg:transmitsDownlinkTo some sdg:LignoSatDownlinkSignal
    HasKey: sdg:satelliteId

Class: sdg:LignoSatDownlinkSignal
    Annotations: rdfs:label "LignoSat Downlink Signal", iao:0000115 "A CW or FM packet transmission from LignoSat to amateur radio stations containing call signs and collected message data."
    SubClassOf: bfo:0000015, sdg:downlinkId some xsd:string, sdg:timestamp some xsd:dateTime, sdg:downlinkType some sdg:DownlinkTypeKind, sdg:callSignsIncluded some xsd:string, sdg:messageCount some xsd:integer, sdg:transmittedBy exactly 1 sdg:LignoSat, sdg:receivedBy some sdg:AmateurRadioStation, sdg:deliversMessagesTo some sdg:ExtractedMessage
    HasKey: sdg:downlinkId

Class: sdg:ExtractedMessage
    Annotations: rdfs:label "Extracted Message", iao:0000115 "A message (e.g., QTH, QRA) extracted from an uplink signal and temporarily stored in LignoSat's memory."
    SubClassOf: cco:ont00000995, sdg:messageId some xsd:string, sdg:messageType some sdg:MessageTypeKind, sdg:content some xsd:string, sdg:extractionTimestamp some xsd:dateTime, sdg:storageStatus some sdg:StorageStatusKind, sdg:extractedFromUplink exactly 1 sdg:LignoSatUplinkSignal, sdg:storedInSatellite exactly 1 sdg:LignoSat, sdg:collectedViaDownlink some sdg:LignoSatDownlinkSignal

Class: sdg:CommunicationCertificate
    Annotations: rdfs:label "Communication Certificate", iao:0000115 "A digital certificate issued to an amateur radio station upon successful communication with LignoSat."
    SubClassOf: cco:ont00000995, sdg:certificateId some xsd:string, sdg:issueDate some xsd:date, sdg:validUntil some xsd:date, sdg:communicationType some xsd:string, sdg:status some sdg:StatusKind, sdg:issuedToStation exactly 1 sdg:AmateurRadioStation, sdg:linkedToUplink exactly 1 sdg:LignoSatUplinkSignal
    HasKey: sdg:certificateId

Class: sdg:ElectronicHealthRecord
    Annotations: rdfs:label "Electronic Health Record", iao:0000115 "A digital record of a patient's health information collected by a healthcare organization."
    SubClassOf: cco:ont00000995, sdg:ehrId some xsd:string, sdg:patientId some xsd:string, sdg:collectionDate some xsd:dateTime, sdg:dataVolume some xsd:decimal, sdg:dataVariety some xsd:string, sdg:status some sdg:StatusKind, sdg:dataFormat some sdg:DataFormatKind, sdg:isComplete some xsd:boolean, sdg:storageLocation some xsd:string, sdg:storedIn exactly 1 sdg:HealthcareOrganization, sdg:contains min 2 sdg:ClinicalDataPoint, sdg:generatedBy exactly 1 sdg:HealthcareOrganization

Class: sdg:ClinicalDataPoint
    Annotations: rdfs:label "Clinical Data Point", iao:0000115 "A single measurement or observation recorded in an electronic health record."
    SubClassOf: bfo:0000015, sdg:dataPointId some xsd:string, sdg:measurementType some sdg:MeasurementTypeKind, sdg:value some xsd:decimal, sdg:unit some sdg:UnitKind, sdg:timestamp some xsd:dateTime, sdg:isAnomalous some xsd:boolean, sdg:metricName some xsd:string, sdg:metricValue some xsd:decimal, sdg:measurementUnit some xsd:string, sdg:dataQuality some xsd:string, sdg:partOf__escalated exactly 1 sdg:ElectronicHealthRecord, sdg:measuredBy exactly 1 sdg:HealthcareProfessional, sdg:measuredBy some sdg:HealthcareAnalyticsSolution

Class: sdg:AnalyticsSolution
    Annotations: rdfs:label "Analytics Solution", iao:0000115 "A software tool or system used to transform healthcare data into actionable insights."
    SubClassOf: cco:ont00000958, sdg:solutionId some xsd:string, sdg:name some sdg:NameKind, sdg:type some sdg:TypeKind, sdg:provider some xsd:string, sdg:deploymentDate some xsd:dateTime, sdg:isWebBased some xsd:boolean, sdg:usedBy some sdg:HealthcareOrganization, sdg:processes min 2 sdg:ElectronicHealthRecord
    HasKey: sdg:solutionId

Class: sdg:ClinicalDecisionSupport
    Annotations: rdfs:label "Clinical Decision Support", iao:0000115 "A process or system that provides healthcare professionals with knowledge and patient-specific information to aid in decision-making."
    SubClassOf: bfo:0000015, sdg:cdsId some xsd:string, sdg:triggerCondition some xsd:string, sdg:recommendation some xsd:string, sdg:effectivenessScore some xsd:decimal, sdg:lastUpdated some xsd:dateTime, sdg:isProactive some xsd:boolean, sdg:cdsName some xsd:string, sdg:cdsType some xsd:string, sdg:effectiveness some sdg:EffectivenessKind, sdg:isPredictive some xsd:boolean, sdg:derivedFrom exactly 1 sdg:AnalyticsSolution, sdg:supports min 2 sdg:HealthcareProfessional, sdg:enabledBy some sdg:HealthcareAnalyticsSolution, sdg:appliedTo some sdg:ElectronicHealthRecord, sdg:improves some sdg:HealthcareOrganization

Class: sdg:OperatingDivision
    Annotations: rdfs:label "Operating Division", iao:0000115 "A distinct organizational unit within the general contracting firm responsible for specific project types or geographic regions, submitting budgets and managing project teams."
    SubClassOf: bfo:0000040, sdg:divisionId some xsd:string, sdg:divisionName some xsd:string, sdg:headquartersLocation some xsd:string, sdg:employeeCount some xsd:integer, sdg:fiscalYear some xsd:integer, sdg:submitsBudgetTo min 1 sdg:BudgetSubmission
    HasKey: sdg:divisionId

Class: sdg:BudgetSubmission
    Annotations: rdfs:label "Budget Submission", iao:0000115 "A formalized financial record submitted by an operating division to the company treasurer, detailing projected expenditures and revenue for a fiscal period."
    SubClassOf: bfo:0000040, sdg:submissionId some xsd:string, sdg:totalProjectedExpenditure some xsd:decimal, sdg:submissionDate some xsd:dateTime, sdg:fiscalYear some xsd:integer, sdg:submissionStatus some sdg:SubmissionStatusKind, sdg:submittedBy exactly 1 sdg:OperatingDivision, sdg:containsLineItem min 2 sdg:BudgetLineItem
    HasKey: sdg:submissionId

Class: sdg:BudgetLineItem
    Annotations: rdfs:label "Budget Line Item", iao:0000115 "A specific financial category or cost component within a divisional budget submission, such as labor, materials, or equipment."
    SubClassOf: bfo:0000040, sdg:lineItemId some xsd:string, sdg:categoryName some xsd:string, sdg:allocatedAmount some xsd:decimal, sdg:currencyCode some xsd:string, sdg:approvalStatus some sdg:ApprovalStatusKind, sdg:partOfSubmission exactly 1 sdg:BudgetSubmission, sdg:fundedByDivision exactly 1 sdg:OperatingDivision
    HasKey: sdg:lineItemId

Class: sdg:InternalTrainingClass
    Annotations: rdfs:label "Internal Training Class", iao:0000115 "A scheduled educational session offered by the company to employees, covering topics such as safety standards, equipment operation, or software proficiency."
    SubClassOf: sdg:EducationalEntity, sdg:classId some xsd:string, sdg:className some xsd:string, sdg:topicCategory some xsd:string, sdg:scheduledDate some xsd:dateTime, sdg:maxCapacity some xsd:integer, sdg:currentEnrollment some xsd:integer, sdg:targetAudience some sdg:TargetAudienceKind, sdg:offeredAt exactly 1 sdg:OfficeLocation, sdg:enrollsParticipant min 2 sdg:Employee
    HasKey: sdg:classId

Class: sdg:OfficeLocation
    Annotations: rdfs:label "Office Location", iao:0000115 "A physical facility or headquarters where the company's employees operate, manage projects, and conduct administrative tasks."
    SubClassOf: bfo:0000040, sdg:locationId some xsd:string, sdg:city some xsd:string, sdg:state some xsd:string, sdg:isHeadquarters some xsd:boolean, sdg:employeeCapacity some xsd:integer, sdg:hostsTraining min 2 sdg:InternalTrainingClass, sdg:employsStaff min 2 sdg:Employee
    HasKey: sdg:locationId

Class: sdg:ProductivityTool
    Annotations: rdfs:label "Productivity Tool", iao:0000115 "A software application or system deployed to employees to enhance workflow, such as spreadsheet editors, presentation software, or collaboration platforms."
    SubClassOf: bfo:0000040, sdg:toolId some xsd:string, sdg:toolName some xsd:string, sdg:softwareVersion some xsd:string, sdg:deploymentDate some xsd:dateTime, sdg:isCollaborative some xsd:boolean, sdg:usedByEmployee min 2 sdg:Employee, sdg:supportsTask min 2 sdg:BusinessProcess

Class: sdg:NetworkAccount
    Annotations: rdfs:label "Network Account", iao:0000115 "A digital identity and access credential issued to a student for interacting with the school's computer network and internet resources."
    SubClassOf: cco:ont00000995, sdg:accountIdentifier some xsd:string, sdg:username some xsd:string, sdg:passwordHash some xsd:string, sdg:status some sdg:StatusKind, sdg:creationDate some xsd:dateTime, sdg:lastLoginTimestamp some xsd:dateTime, sdg:accountType some sdg:AccountTypeKind, sdg:assignedTo exactly 1 sdg:Student, sdg:managedBy exactly 1 sdg:NetworkAdministrator, sdg:grantsAccessTo some sdg:NetworkResource

Class: sdg:NetworkAdministrator
    Annotations: rdfs:label "Network Administrator", iao:0000115 "A staff member appointed to supervise distributive and user support systems, manage network accounts, and enforce acceptable use policies."
    SubClassOf: bfo:0000004, sdg:adminId some xsd:string, sdg:fullName some xsd:string, sdg:roleLevel some sdg:RoleLevelKind, sdg:appointmentDate some xsd:date, sdg:isAuthorizedToRevoke some xsd:boolean, sdg:manages some sdg:NetworkAccount, sdg:worksAt exactly 1 sdg:School, sdg:enforcesPolicy exactly 1 sdg:AcceptableUsePolicy
    HasKey: sdg:adminId

Class: sdg:AcceptableUsePolicy
    Annotations: rdfs:label "Acceptable Use Policy", iao:0000115 "A formal document and set of rules governing the ethical and legal use of the school's network and internet facilities by students and staff."
    SubClassOf: sdg:GovernmentPolicy, sdg:policyId some xsd:string, sdg:versionNumber some xsd:string, sdg:effectiveDate some xsd:date, sdg:isLegallyBinding some xsd:boolean, sdg:prohibitsCommercialUse some xsd:boolean, sdg:requiresEthicalBehavior some xsd:boolean, sdg:scopeOfApplication some xsd:string, sdg:governs some sdg:NetworkAccount, sdg:appliesTo some sdg:Student, sdg:enforcedBy some sdg:NetworkAdministrator

Class: sdg:NetworkResource
    Annotations: rdfs:label "Network Resource", iao:0000115 "A digital service, library, or computing facility accessible via the school's network for educational research and collaboration."
    SubClassOf: cco:ont00000995, sdg:resourceId some xsd:string, sdg:resourceName some xsd:string, sdg:resourceType some sdg:ResourceTypeKind, sdg:isFeeBased some xsd:boolean, sdg:requiresPriorApproval some xsd:boolean, sdg:accessLevel some sdg:AccessLevelKind, sdg:accessedBy some sdg:NetworkAccount, sdg:providedBy exactly 1 sdg:School, sdg:subjectTo exactly 1 sdg:AcceptableUsePolicy

Class: sdg:SecurityIncident
    Annotations: rdfs:label "Security Incident", iao:0000115 "A recorded event involving a violation of network security, vandalism, or inappropriate use that triggers administrative review or account suspension."
    SubClassOf: sdg:SecurityAndSafetyMeasure, sdg:incidentId some xsd:string, sdg:incidentType some sdg:IncidentTypeKind, sdg:severityLevel some sdg:SeverityLevelKind, sdg:reportedDate some xsd:dateTime, sdg:isResolved some xsd:boolean, sdg:resultingAction some sdg:ResultingActionKind, sdg:incidentStatus some sdg:IncidentStatusKind, sdg:incidentDateTime some xsd:dateTime, sdg:status some sdg:StatusKind, sdg:reportedByDetail some xsd:string, sdg:involvesAccount exactly 1 sdg:NetworkAccount, sdg:reportedTo exactly 1 sdg:NetworkAdministrator, sdg:triggersReview exactly 1 sdg:AcceptableUsePolicy, sdg:occurredAt exactly 1 sdg:LibraryProperty, sdg:hasEvidence some sdg:VideoSurveillanceData, sdg:investigatedBy some sdg:StaffMember, sdg:reportedTo some sdg:LawEnforcementAgency

Class: sdg:EvacuationOrder
    Annotations: rdfs:label "Evacuation Order", iao:0000115 "An official directive issued by local authorities to mandate the departure of residents from a specified area due to an imminent hazard."
    SubClassOf: bfo:0000015, sdg:orderIdentifier some xsd:string, sdg:issuanceDateTime some xsd:dateTime, sdg:issuingAuthorityDetail some xsd:string, sdg:evacuationZone some xsd:string, sdg:hazardType some xsd:string, sdg:status some sdg:StatusKind, sdg:mandatory some xsd:boolean, sdg:issueDateTime some xsd:dateTime, sdg:evacuationType some sdg:EvacuationTypeKind, sdg:warningMethod some sdg:WarningMethodKind, sdg:complianceStatus some sdg:ComplianceStatusKind, sdg:triggeredBy exactly 1 sdg:HazardEvent, sdg:appliesTo some sdg:GeographicZone, sdg:communicatedVia some sdg:WarningMethod, sdg:appliesToZone min 2 sdg:EvacuationZone, sdg:communicatedVia some sdg:WarningChannel

Class: sdg:HazardEvent
    Annotations: rdfs:label "Hazard Event", iao:0000115 "A dangerous natural or man-made occurrence that threatens public safety and necessitates evacuation."
    SubClassOf: bfo:0000015, sdg:eventIdentifier some xsd:string, sdg:startTime some xsd:dateTime, sdg:endTime some xsd:dateTime, sdg:eventType some sdg:EventTypeKind, sdg:severityLevel some sdg:SeverityLevelKind, sdg:affectedArea some xsd:string, sdg:monitored some xsd:boolean, sdg:eventCategory some xsd:string, sdg:onsetDateTime some xsd:dateTime, sdg:peakIntensityDateTime some xsd:dateTime, sdg:affectedPopulationCount some xsd:integer, sdg:isMonitored some xsd:boolean, sdg:triggers some sdg:EvacuationOrder, sdg:occursIn__escalated exactly 1 sdg:GeographicZone, sdg:causes some sdg:EvacuationOrder, sdg:impactsLocation min 2 sdg:GeographicZone, sdg:requiresRoute some sdg:EvacuationRoute

Class: sdg:EvacuationRoute
    Annotations: rdfs:label "Evacuation Route", iao:0000115 "A designated path for safe travel out of an evacuation zone, marked on official maps and recommended by authorities."
    SubClassOf: bfo:0000015, sdg:routeIdentifier some xsd:string, sdg:routeName some xsd:string, sdg:startPoint some xsd:string, sdg:endPoint some xsd:string, sdg:routeLength some xsd:decimal, sdg:roadCondition some xsd:string, sdg:recommended some xsd:boolean, sdg:routeStatus some sdg:RouteStatusKind, sdg:capacityRating some xsd:integer, sdg:isShortcut some xsd:boolean, sdg:floodRiskLevel some xsd:string, sdg:locatedIn exactly 1 sdg:GeographicZone, sdg:connectsTo some sdg:GeographicZone, sdg:usedBy some sdg:EvacuationOrder, sdg:servesZone min 2 sdg:EvacuationZone, sdg:leadsToShelter exactly 1 sdg:Shelter

Class: sdg:WarningMethod
    Annotations: rdfs:label "Warning Method", iao:0000115 "A channel or mechanism used by authorities to disseminate evacuation information and instructions to the public."
    SubClassOf: sdg:SecurityAndSafetyMeasure, sdg:methodIdentifier some xsd:string, sdg:methodName some sdg:MethodNameKind, sdg:reach some xsd:string, sdg:reliability some xsd:string, sdg:activeDuringPowerOutage some xsd:boolean, sdg:usedFor some sdg:EvacuationOrder, sdg:deliversTo some sdg:Population

Class: sdg:Population
    Annotations: rdfs:label "Population", iao:0000115 "The group of individuals residing in or visiting an evacuation zone who are subject to evacuation orders."
    SubClassOf: sdg:populationIdentifier some xsd:string, sdg:householdCount some xsd:integer, sdg:averageHouseholdSize some xsd:decimal, sdg:evacuationComplianceRate some xsd:decimal, sdg:transportationAccess some sdg:TransportationAccessKind, sdg:populationId some xsd:string, sdg:populationName some xsd:string, sdg:geographicRegion some xsd:string, sdg:sampleSize some xsd:integer, sdg:inclusionCriteria some xsd:string, sdg:monitoringStatus some sdg:MonitoringStatusKind, sdg:residesIn exactly 1 sdg:GeographicZone, sdg:receives some sdg:WarningMethod, sdg:subjectTo some sdg:EvacuationOrder, sdg:includesIndividuals min 2 sdg:Individual, sdg:studiedBy min 2 sdg:StudyDesign

Class: sdg:RegulatoryInstrument
    Annotations: rdfs:label "Regulatory Instrument", iao:0000115 "A formal legal or regulatory document that establishes rules, standards, or procedures for compliance within a specific jurisdiction."
    SubClassOf: sdg:RegulatoryComplianceConcept, sdg:instrumentIdentifier some xsd:string, sdg:title some xsd:string, sdg:issuingAuthorityDetail some xsd:string, sdg:adoptionDate some xsd:dateTime, sdg:publicationDate some xsd:date, sdg:entryIntoForceDate some xsd:dateTime, sdg:status some sdg:StatusKind, sdg:regulatoryStatus some sdg:RegulatoryStatusKind, sdg:supersedes some sdg:RegulatoryInstrument, sdg:amends some sdg:RegulatoryInstrument, sdg:governs some sdg:FinancialCounterparty

Class: sdg:FinancialCounterparty
    Annotations: rdfs:label "Financial Counterparty", iao:0000115 "An entity, such as a UCITS or AIF, that engages in financial transactions and is subject to regulatory oversight under EMIR."
    SubClassOf: sdg:FinancialEntity, sdg:counterpartyIdentifier some xsd:string, sdg:legalName some xsd:string, sdg:entityType some sdg:EntityTypeKind, sdg:jurisdiction some sdg:JurisdictionKind, sdg:registrationStatus some sdg:RegistrationStatusKind, sdg:clearingThresholdExceeded some xsd:boolean, sdg:regulatoryStatus some sdg:RegulatoryStatusKind, sdg:subjectTo some sdg:RegulatoryInstrument, sdg:entersInto min 2 sdg:OTCDerivativeTrade, sdg:posts some sdg:Collateral

Class: sdg:OTCDerivativeTrade
    Annotations: rdfs:label "OTC Derivative Trade", iao:0000115 "A privately negotiated financial contract between two parties that is not traded on a regulated exchange."
    SubClassOf: bfo:0000015, sdg:tradeIdentifier some xsd:string, sdg:tradeDate some xsd:dateTime, sdg:tradeType some xsd:string, sdg:settlementType some xsd:string, sdg:notionalAmount some xsd:decimal, sdg:currency some xsd:string, sdg:maturityDate some xsd:dateTime, sdg:status some sdg:StatusKind, sdg:involves min 2 sdg:FinancialCounterparty, sdg:governedBy max 1 sdg:NettingAgreement, sdg:requires some sdg:Collateral, sdg:subjectTo some sdg:RegulatoryInstrument

Class: sdg:NettingAgreement
    Annotations: rdfs:label "Netting Agreement", iao:0000115 "A legal contract that allows for the netting of multiple obligations between counterparties into a single net amount."
    SubClassOf: cco:ont00000958, sdg:agreementIdentifier some xsd:string, sdg:agreementType some xsd:string, sdg:enforceabilityReviewStatus some xsd:string, sdg:reviewedByDetail some xsd:string, sdg:effectiveDate some xsd:date, sdg:terminationDate some xsd:date, sdg:governs min 2 sdg:OTCDerivativeTrade, sdg:amendedBy some sdg:RegulatoryInstrument

Class: sdg:Collateral
    Annotations: rdfs:label "Collateral", iao:0000115 "An asset or security pledged by one party to another as security for the performance of a contract."
    SubClassOf: bfo:0000040, sdg:collateralIdentifier some xsd:string, sdg:assetType some sdg:AssetTypeKind, sdg:issuingEntity some xsd:string, sdg:creditQualityRating some xsd:string, sdg:denomination some xsd:string, sdg:eligibilityStatus some xsd:string, sdg:wrongWayRisk some xsd:boolean, sdg:postedBy some sdg:FinancialCounterparty, sdg:covers some sdg:OTCDerivativeTrade, sdg:governedBy some sdg:RegulatoryInstrument

Class: sdg:CreditSupportAnnex
    Annotations: rdfs:label "Credit Support Annex", iao:0000115 "A legal document that specifies the terms and conditions for the exchange of collateral between counterparties."
    SubClassOf: cco:ont00000958, sdg:csaIdentifier some xsd:string, sdg:nettingSet some xsd:string, sdg:amendmentStatus some xsd:string, sdg:effectiveDate some xsd:date, sdg:terminationDate some xsd:date, sdg:partOf max 1 sdg:NettingAgreement, sdg:governs min 2 sdg:Collateral, sdg:amendedBy some sdg:RegulatoryInstrument

Class: sdg:Address
    Annotations: rdfs:label "Address", iao:0000115 "A physical location or postal designation where a guardian or child resides."
    SubClassOf: bfo:0000004, sdg:addressId some xsd:string, sdg:street some xsd:string, sdg:city some xsd:string, sdg:county some xsd:string, sdg:postCode some xsd:string, sdg:addressType some xsd:string, sdg:isResidenceOf some sdg:Guardian, sdg:isResidenceOf some sdg:Child
    HasKey: sdg:addressId

Class: sdg:RepairJob
    Annotations: rdfs:label "Automotive Repair Job", iao:0000115 "A specific automotive repair or maintenance task performed on a vehicle."
    SubClassOf: bfo:0000015, sdg:jobId some xsd:string, sdg:jobType some xsd:string, sdg:startTime some xsd:dateTime, sdg:endTime some xsd:dateTime, sdg:laborCost some xsd:decimal, sdg:partsCost some xsd:decimal, sdg:status some sdg:StatusKind, sdg:assignedTo exactly 1 sdg:Technician, sdg:performedOn exactly 1 sdg:Vehicle, sdg:generates max 1 sdg:Invoice

Class: sdg:Invoice
    Annotations: rdfs:label "Service Invoice", iao:0000115 "A financial record detailing charges for automotive repair services and parts."
    SubClassOf: sdg:Entity, sdg:invoiceId some xsd:string, sdg:issueDate some xsd:date, sdg:totalAmount some xsd:decimal, sdg:taxAmount some xsd:decimal, sdg:paymentStatus some sdg:PaymentStatusKind, sdg:dueDate some xsd:date, sdg:generatedFrom exactly 1 sdg:RepairJob, sdg:issuedTo exactly 1 sdg:Customer
    HasKey: sdg:invoiceId

Class: sdg:CyberneticOrganism
    Annotations: rdfs:label "Cybernetic Organism", iao:0000115 "A biological organism that has been extended or modified with cybernetic technology to alter its self-regulatory control functions."
    SubClassOf: bfo:0000040, sdg:organismId some xsd:string, sdg:organismType some sdg:OrganismTypeKind, sdg:modificationDate some xsd:dateTime, sdg:controlSystemType some xsd:string, sdg:environmentAdaptation some xsd:string, sdg:homeostaticStatus some xsd:string, sdg:hasModification some sdg:CyberneticModification, sdg:participatesIn__escalated some sdg:CyberneticsResearch
    HasKey: sdg:organismId

Class: sdg:CyberneticModification
    Annotations: rdfs:label "Cybernetic Modification", iao:0000115 "A technological or procedural alteration applied to an organism to extend its self-regulatory control functions."
    SubClassOf: bfo:0000040, sdg:modificationId some xsd:string, sdg:modificationType some xsd:string, sdg:implementationDate some xsd:dateTime, sdg:controlMechanism some xsd:string, sdg:targetFunction some xsd:string, sdg:researcherId some xsd:string, sdg:appliedTo exactly 1 sdg:CyberneticOrganism, sdg:designedBy some sdg:CyberneticsResearch

Class: sdg:CyberneticsResearch
    Annotations: rdfs:label "Cybernetics Research", iao:0000115 "A scientific activity or project focused on the study and application of control and communication theory in machines and organisms."
    SubClassOf: bfo:0000015, sdg:researchId some xsd:string, sdg:researchTitle some xsd:string, sdg:startDate some xsd:dateTime, sdg:endDate some xsd:dateTime, sdg:researchLocation some xsd:string, sdg:fundingSource some sdg:FundingSourceKind, sdg:researchStatus some xsd:string, sdg:conductedBy some sdg:Cybernetician, sdg:produces some sdg:CyberneticOrganism, sdg:usesMethod some sdg:ResearchMethod

Class: sdg:Cybernetician
    Annotations: rdfs:label "Cybernetician", iao:0000115 "A scientist or researcher who works in the field of cybernetics, focusing on control and communication theory."
    SubClassOf: bfo:0000002, sdg:researcherId some xsd:string, sdg:fullName some xsd:string, sdg:institution some xsd:string, sdg:specialization some sdg:SpecializationKind, sdg:activePeriod some xsd:string, sdg:keyContributions some xsd:string, sdg:conducts some sdg:CyberneticsResearch, sdg:collaboratesWith some sdg:Cybernetician

Class: sdg:ResearchMethod
    Annotations: rdfs:label "Research Method", iao:0000115 "A specific scientific approach or technique used in cybernetics research, such as analogies or feedback control."
    SubClassOf: sdg:ResearchEntity, sdg:methodId some xsd:string, sdg:methodName some sdg:MethodNameKind, sdg:methodType some xsd:string, sdg:applicationDomain some xsd:string, sdg:effectiveness some sdg:EffectivenessKind, sdg:methodCategory some sdg:MethodCategoryKind, sdg:accuracyLevel some xsd:decimal, sdg:biasRisk some sdg:BiasRiskKind, sdg:isStandardized some xsd:boolean, sdg:usedIn some sdg:CyberneticsResearch, sdg:developedBy some sdg:Cybernetician, sdg:appliedTo min 2 sdg:StudyDesign, sdg:measuresAttribute min 2 sdg:BiologicalMeasurement, sdg:usedIn min 2 sdg:Dataset

Class: sdg:ScientificDiscourse
    Annotations: rdfs:label "Scientific Discourse", iao:0000115 "A body of written or spoken communication within the field of cybernetics, including theories, critiques, and historical accounts."
    SubClassOf: bfo:0000040, sdg:discourseId some xsd:string, sdg:discourseTitle some xsd:string, sdg:publicationDate some xsd:date, sdg:authorId some xsd:string, sdg:discourseType some xsd:string, sdg:keyThemes some xsd:string, sdg:discusses some sdg:CyberneticsResearch, sdg:references some sdg:ScientificDiscourse

Class: sdg:VideoDeliveryService
    Annotations: rdfs:label "Video Delivery Service", iao:0000115 "A cloud-based software and service offering that enables the delivery of premium movie and TV content to end-users across multiple platforms and devices."
    SubClassOf: sdg:SecuritySystemComponent, sdg:serviceId some xsd:string, sdg:serviceTier some sdg:ServiceTierKind, sdg:uptimePercentage some xsd:decimal, sdg:supportedPlatforms some xsd:string, sdg:region some sdg:RegionKind, sdg:status some sdg:StatusKind, sdg:contentTier some xsd:string, sdg:supports min 2 sdg:VideoCodec, sdg:uses min 1 sdg:DRMSystem, sdg:deliversTo min 1 sdg:ClientOrganization

Class: sdg:DRMSystem
    Annotations: rdfs:label "Digital Rights Management System", iao:0000115 "An industry-grade software system used to protect digital media content from unauthorized access and distribution."
    SubClassOf: bfo:0000040, sdg:drmId some xsd:string, sdg:vendorName some xsd:string, sdg:encryptionStandard some sdg:EncryptionStandardKind, sdg:complianceLevel some sdg:ComplianceLevelKind, sdg:licenseServerUrl some xsd:string, sdg:protects min 1 sdg:VideoDeliveryService

Class: sdg:VideoCodec
    Annotations: rdfs:label "Video Codec", iao:0000115 "A software or hardware tool used to compress and decompress digital video data for efficient storage and transmission."
    SubClassOf: bfo:0000040, sdg:codecId some xsd:string, sdg:codecName some xsd:string, sdg:compressionRatio some xsd:decimal, sdg:bitrate some xsd:decimal, sdg:resolution some sdg:ResolutionKind, sdg:usedIn min 1 sdg:VideoDeliveryService, sdg:requires min 1 sdg:NetworkInfrastructure

Class: sdg:TechnicalSupportEngineer
    Annotations: rdfs:label "Technical Support Engineer", iao:0000115 "A professional responsible for providing technical assistance, troubleshooting, and support for video delivery services and client infrastructure."
    SubClassOf: bfo:0000040, sdg:engineerId some xsd:string, sdg:name some sdg:NameKind, sdg:location some xsd:string, sdg:experienceYears some xsd:integer, sdg:languages some xsd:string, sdg:educationLevel some sdg:EducationLevelKind, sdg:employmentStatus some sdg:EmploymentStatusKind, sdg:supports min 1 sdg:ClientOrganization, sdg:troubleshoots min 1 sdg:NetworkInfrastructure, sdg:employs min 1 sdg:VideoDeliveryService

Class: sdg:NetworkInfrastructure
    Annotations: rdfs:label "Network Infrastructure", iao:0000115 "The underlying hardware and software systems, including TCP/IP networking components, that facilitate the transmission of video data."
    SubClassOf: sdg:NetworkEntity, sdg:networkId some xsd:string, sdg:protocol some xsd:string, sdg:bandwidth some xsd:decimal, sdg:latency some xsd:decimal, sdg:operatingSystem some xsd:string, sdg:status some sdg:StatusKind, sdg:connects min 1 sdg:ClientOrganization, sdg:transmits min 1 sdg:VideoCodec, sdg:monitoredBy min 1 sdg:TechnicalSupportEngineer
    HasKey: sdg:networkId

Class: sdg:SecuritySoftwarePackage
    Annotations: rdfs:label "Security Software Package", iao:0000115 "A commercial software application designed to extract and process personal data from official identification documents for registration and authentication workflows."
    SubClassOf: sdg:SecuritySystemComponent, sdg:softwareIdentifier some xsd:string, sdg:productName some xsd:string, sdg:retailPrice some xsd:decimal, sdg:supportedOperatingSystem some xsd:string, sdg:currencyCode some xsd:string, sdg:compatibilityStatus some sdg:CompatibilityStatusKind, sdg:dataProcessingPurpose some xsd:string, sdg:runsOn some sdg:HardwareScannerDevice, sdg:uses exactly 1 sdg:OpticalCharacterRecognitionEngine, sdg:supportsDocumentType min 2 sdg:OfficialIdentificationDocument

Class: sdg:HardwareScannerDevice
    Annotations: rdfs:label "Hardware Scanner Device", iao:0000115 "A physical peripheral device that captures optical data from physical documents and converts it into digital signals for processing."
    SubClassOf: sdg:SecuritySystemComponent, sdg:deviceModelName some xsd:string, sdg:cameraResolutionMegapixels some xsd:integer, sdg:maximumScanningSize some xsd:string, sdg:powerSourceType some xsd:string, sdg:interfaceType some sdg:InterfaceTypeKind, sdg:retailPrice some xsd:decimal, sdg:currencyCode some xsd:string, sdg:hasExternalButton some xsd:boolean, sdg:hasBarcodeScanner some xsd:boolean, sdg:physicalFormFactor some xsd:string, sdg:runsSoftwarePackage some sdg:SecuritySoftwarePackage, sdg:capturesDocument some sdg:OfficialIdentificationDocument

Class: sdg:OfficialIdentificationDocument
    Annotations: rdfs:label "Official Identification Document", iao:0000115 "A government-issued physical or digital credential containing biographical data and machine-readable zones used for identity verification."
    SubClassOf: sdg:Document, sdg:documentType some sdg:DocumentTypeKind, sdg:issuingCountryCode some xsd:string, sdg:documentNumber some xsd:string, sdg:mRZLine1 some xsd:string, sdg:mRZLine2 some xsd:string, sdg:mRZRecognitionStatus some sdg:MRZRecognitionStatusKind, sdg:extractionTimestamp some xsd:dateTime, sdg:providesDataTo exactly 1 sdg:ExtractedPersonalDataRecord, sdg:isScannedBy some sdg:HardwareScannerDevice

Class: sdg:ExtractedPersonalDataRecord
    Annotations: rdfs:label "Extracted Personal Data Record", iao:0000115 "A structured digital representation of biographical information extracted from an official identification document via OCR and MRZ processing."
    SubClassOf: cco:ont00000995, sdg:recordIdentifier some xsd:string, sdg:extractionMethod some xsd:string, sdg:sourceLanguageCode some xsd:string, sdg:outputFormat some sdg:OutputFormatKind, sdg:dataArchiveStatus some sdg:DataArchiveStatusKind, sdg:extractionTimestamp some xsd:dateTime, sdg:derivedFrom exactly 1 sdg:OfficialIdentificationDocument, sdg:processedBy exactly 1 sdg:OpticalCharacterRecognitionEngine

Class: sdg:OpticalCharacterRecognitionEngine
    Annotations: rdfs:label "Optical Character Recognition Engine", iao:0000115 "A computational process or software module that recognizes and converts printed text in various languages from image data into machine-readable text."
    SubClassOf: bfo:0000015, sdg:engineVersion some xsd:string, sdg:supportedLanguageCount some xsd:integer, sdg:recognitionAccuracy some xsd:decimal, sdg:processingSpeed some xsd:decimal, sdg:awardStatus some xsd:string, sdg:processesDocument some sdg:OfficialIdentificationDocument, sdg:generatesRecord some sdg:ExtractedPersonalDataRecord

Class: sdg:EconomicRecession
    Annotations: rdfs:label "Economic Recession", iao:0000115 "A period of significant economic decline characterized by rising unemployment and falling household incomes."
    SubClassOf: bfo:0000015, sdg:startDate some xsd:dateTime, sdg:endDate some xsd:dateTime, sdg:peakUnemploymentRate some xsd:decimal, sdg:affectedStates some xsd:string, sdg:severityLevel some sdg:SeverityLevelKind, sdg:impacted some sdg:ChildPovertyMeasure, sdg:caused some sdg:HouseholdIncomeChange

Class: sdg:ChildPovertyMeasure
    Annotations: rdfs:label "Child Poverty Measure", iao:0000115 "A quantitative assessment of child poverty levels based on household income relative to a defined poverty threshold."
    SubClassOf: cco:ont00000995, sdg:measureType some xsd:string, sdg:povertyRate some xsd:decimal, sdg:year some xsd:integer, sdg:stateCode some xsd:string, sdg:householdIncomePercentile some xsd:decimal, sdg:measuredDuring exactly 1 sdg:EconomicRecession, sdg:appliedTo some sdg:Household

Class: sdg:SafetyNetProgram
    Annotations: rdfs:label "Safety Net Program", iao:0000115 "A government or private program designed to provide financial or in-kind assistance to vulnerable populations."
    SubClassOf: sdg:SecurityAndSafetyMeasure, sdg:programName some xsd:string, sdg:programType some sdg:ProgramTypeKind, sdg:eligibilityCriteria some xsd:string, sdg:fundingSource some sdg:FundingSourceKind, sdg:assistanceType some xsd:string, sdg:benefits some sdg:Household, sdg:mitigates some sdg:ChildPovertyMeasure

Class: sdg:HouseholdIncomeChange
    Annotations: rdfs:label "Household Income Change", iao:0000115 "A measurable change in household income resulting from economic conditions or safety net interventions."
    SubClassOf: bfo:0000015, sdg:changePercentage some xsd:decimal, sdg:direction some sdg:DirectionKind, sdg:cause some xsd:string, sdg:measurementPeriod some xsd:string, sdg:resultedFrom exactly 1 sdg:EconomicRecession, sdg:affected some sdg:Household

Class: sdg:RegistrationCard
    Annotations: rdfs:label "EUSR Registration Card", iao:0000115 "A physical or digital credential issued to an individual to certify their registration status and associated trade categories within the Energy & Utility Skills framework."
    SubClassOf: cco:ont00000995, sdg:cardId some xsd:string, sdg:cardType some xsd:string, sdg:issueDate some xsd:date, sdg:expiryDate some xsd:date, sdg:holderName some xsd:string, sdg:tradeCategory some xsd:string, sdg:vatExcludedPrice some xsd:decimal, sdg:hasCategory min 2 sdg:RegistrationCategory
    HasKey: sdg:cardId

Class: sdg:RegistrationCategory
    Annotations: rdfs:label "EUSR Registration Category", iao:0000115 "A specific trade or professional classification (e.g., Electrician, Plumber) that defines the scope of work an individual is registered to perform."
    SubClassOf: bfo:0000015, sdg:categoryId some xsd:string, sdg:categoryName some xsd:string, sdg:categoryCode some xsd:string, sdg:isAdditional some xsd:boolean, sdg:assignedToCard min 2 sdg:RegistrationCard

Class: sdg:TrainerApproval
    Annotations: rdfs:label "Trainer Approval Status", iao:0000115 "A formal authorization granted to an individual allowing them to deliver training under specific approved schemes."
    SubClassOf: bfo:0000015, sdg:approvalId some xsd:string, sdg:approvalType some sdg:ApprovalTypeKind, sdg:grantDate some xsd:date, sdg:expiryDate some xsd:date, sdg:vatExcludedPrice some xsd:decimal, sdg:grantedForScheme min 2 sdg:TrainingScheme, sdg:heldByTrainer exactly 1 sdg:Trainer

Class: sdg:TrainingScheme
    Annotations: rdfs:label "Approved Training Scheme", iao:0000115 "A structured educational program or framework (e.g., SHEA, NWH, BESC, SCO) that defines the curriculum and standards for training delivery."
    SubClassOf: sdg:EducationalEntity, sdg:schemeCode some xsd:string, sdg:schemeName some xsd:string, sdg:schemeType some xsd:string, sdg:isSmartMetering some xsd:boolean, sdg:requiresApproval min 2 sdg:TrainerApproval, sdg:requiresProviderApproval min 2 sdg:ProviderApproval

Class: sdg:ProviderApproval
    Annotations: rdfs:label "Organisation Provider Approval", iao:0000115 "An organizational accreditation allowing an entity to deliver training programs and undergo audits within specific approved schemes."
    SubClassOf: bfo:0000015, sdg:approvalId some xsd:string, sdg:approvalStatus some sdg:ApprovalStatusKind, sdg:grantDate some xsd:date, sdg:expiryDate some xsd:date, sdg:vatExcludedPrice some xsd:decimal, sdg:grantedForScheme min 2 sdg:TrainingScheme, sdg:heldByOrganisation exactly 1 sdg:TrainingOrganisation, sdg:subjectToAudit min 2 sdg:ProviderAudit

Class: sdg:ProviderAudit
    Annotations: rdfs:label "Annual Provider Audit", iao:0000115 "A periodic compliance review and assessment conducted to verify that a training provider maintains the required standards for their approved schemes."
    SubClassOf: sdg:Report, sdg:auditId some xsd:string, sdg:auditDate some xsd:dateTime, sdg:auditType some xsd:string, sdg:auditResult some xsd:string, sdg:vatExcludedPrice some xsd:decimal, sdg:conductedForApproval exactly 1 sdg:ProviderApproval, sdg:conductedByAuditor exactly 1 sdg:Auditor

Class: sdg:TrainingOrganisation
    Annotations: rdfs:label "Training Provider Organisation", iao:0000115 "A legal entity or business organization authorized to deliver training programs and employ trainers within the Energy & Utility Skills framework."
    SubClassOf: sdg:EducationalEntity, sdg:organisationId some xsd:string, sdg:organisationName some xsd:string, sdg:registrationNumber some xsd:string, sdg:contactEmail some xsd:string, sdg:contactPhone some xsd:string, sdg:legalEntityStatus some xsd:string, sdg:holdsApproval min 2 sdg:ProviderApproval, sdg:employsTrainer min 2 sdg:Trainer
    HasKey: sdg:organisationId

Class: sdg:Trainer
    Annotations: rdfs:label "Approved Trainer", iao:0000115 "An individual professional who has been granted approval to deliver training content under specific approved schemes."
    SubClassOf: bfo:0000015, sdg:trainerId some xsd:string, sdg:firstName some xsd:string, sdg:lastName some xsd:string, sdg:emailAddress some xsd:string, sdg:isApproved some xsd:boolean, sdg:holdsApproval min 2 sdg:TrainerApproval, sdg:employedBy exactly 1 sdg:TrainingOrganisation

Class: sdg:CollectiveBargainingAgreement
    Annotations: rdfs:label "Collective Bargaining Agreement", iao:0000115 "A formal written contract between an employer and a labor union representing employees, detailing terms of employment."
    SubClassOf: cco:ont00000958, sdg:agreementId some xsd:string, sdg:effectiveDate some xsd:date, sdg:expirationDate some xsd:date, sdg:unionName some xsd:string, sdg:status some sdg:StatusKind, sdg:covers some sdg:Employee, sdg:governs some sdg:Position, sdg:administeredBy exactly 1 sdg:Employee

Class: sdg:PerformanceReview
    Annotations: rdfs:label "Performance Review", iao:0000115 "A formal assessment process evaluating an employee's job performance against established objectives and standards."
    SubClassOf: bfo:0000015, sdg:reviewId some xsd:string, sdg:reviewDate some xsd:dateTime, sdg:rating some xsd:integer, sdg:status some sdg:StatusKind, sdg:comments some xsd:string, sdg:assesses exactly 1 sdg:Employee, sdg:conductedBy exactly 1 sdg:Employee, sdg:references exactly 1 sdg:Position, sdg:basedOn some sdg:CollectiveBargainingAgreement

Class: sdg:CaseReviewProtocol
    Annotations: rdfs:label "Case Review Protocol", iao:0000115 "A structured assessment instrument used to evaluate the effectiveness of child welfare and Medicaid systems by reviewing case files and administrative data."
    SubClassOf: cco:ont00000958, sdg:protocolIdentifier some xsd:string, sdg:protocolName some xsd:string, sdg:versionNumber some xsd:string, sdg:reviewDate some xsd:dateTime, sdg:status some sdg:StatusKind, sdg:scopeDescription some xsd:string, sdg:reviewerName some xsd:string, sdg:assessesDomain some sdg:SystemDomain, sdg:reviewedBy some sdg:ExpertReviewer, sdg:usedInLawsuit some sdg:LegalCase
    HasKey: sdg:versionNumber

Class: sdg:SystemDomain
    Annotations: rdfs:label "System Domain", iao:0000115 "A functional area of public service delivery, such as child welfare or education, for which a specific government agency holds responsibility."
    SubClassOf: bfo:0000015, sdg:domainIdentifier some xsd:string, sdg:domainName some xsd:string, sdg:responsibleAgency some xsd:string, sdg:assessmentCriteria some xsd:string, sdg:isWithinJurisdiction some xsd:boolean, sdg:monitoredBy some sdg:CaseReviewProtocol, sdg:overseenBy exactly 1 sdg:GovernmentAgency

Class: sdg:ExpertReviewer
    Annotations: rdfs:label "Expert Reviewer", iao:0000115 "A qualified professional engaged to evaluate the appropriateness and scope of assessment instruments for public systems."
    SubClassOf: bfo:0000015, sdg:reviewerIdentifier some xsd:string, sdg:reviewerName some xsd:string, sdg:academicTitle some xsd:string, sdg:institution some xsd:string, sdg:yearsExperience some xsd:integer, sdg:specialization some sdg:SpecializationKind, sdg:reviewDate some xsd:dateTime, sdg:reviewsProtocol some sdg:CaseReviewProtocol, sdg:affiliatedWith exactly 1 sdg:AcademicInstitution

Class: sdg:FacultyResearcher
    Annotations: rdfs:label "Faculty Researcher", iao:0000115 "A human scholar holding a faculty position who engages in research and publication activities."
    SubClassOf: bfo:0000040, sdg:researcherId some xsd:string, sdg:fullName some xsd:string, sdg:age some xsd:integer, sdg:isMarried some xsd:boolean, sdg:highestDegree some xsd:string, sdg:university some xsd:string, sdg:researchField some xsd:string, sdg:publicationCount some xsd:integer, sdg:holdsRank exactly 1 sdg:AcademicRank, sdg:worksAt exactly 1 sdg:University, sdg:specializesIn some sdg:ResearchField, sdg:hasCoreCharacteristics some sdg:CoreCharacteristic

Class: sdg:AcademicRank
    Annotations: rdfs:label "Academic Rank", iao:0000115 "A formal title or position held by a faculty member within a university hierarchy."
    SubClassOf: bfo:0000023, sdg:rankCode some xsd:string, sdg:rankTitle some xsd:string, sdg:level some sdg:LevelKind, sdg:responsibilities some xsd:string, sdg:heldBy some sdg:FacultyResearcher

Class: sdg:ResearchField
    Annotations: rdfs:label "Research Field", iao:0000115 "A specific academic discipline or area of study in which a researcher specializes."
    SubClassOf: bfo:0000004, sdg:fieldCode some xsd:string, sdg:fieldName some xsd:string, sdg:category some sdg:CategoryKind, sdg:studiedBy some sdg:FacultyResearcher

Class: sdg:CoreCharacteristic
    Annotations: rdfs:label "Core Characteristic", iao:0000115 "An intrinsic personal trait or quality that influences a researcher's productivity and behavior."
    SubClassOf: bfo:0000016, sdg:traitId some xsd:string, sdg:traitName some xsd:string, sdg:description some xsd:string, sdg:impactLevel some sdg:ImpactLevelKind, sdg:exhibitedBy some sdg:FacultyResearcher
    HasKey: sdg:traitId

Class: sdg:Journal
    Annotations: rdfs:label "Journal", iao:0000115 "A periodical publication in which scholarly articles are published."
    SubClassOf: cco:ont00000958, sdg:journalId some xsd:string, sdg:journalName some xsd:string, sdg:issn some xsd:string, sdg:isInternational some xsd:boolean, sdg:impactFactor some xsd:decimal, sdg:publisher some xsd:string, sdg:hostsPublication some sdg:Publication, sdg:publishes min 2 sdg:Publication, sdg:editedBy min 2 sdg:EditorialBoard

Class: sdg:EditorialBoard
    Annotations: rdfs:label "Editorial Board", iao:0000115 "A group of experts responsible for overseeing the content and quality of a scientific journal."
    SubClassOf: bfo:0000002, sdg:boardId some xsd:string, sdg:roleDetail some sdg:RoleKind, sdg:appointmentDate some xsd:date, sdg:servesOn exactly 1 sdg:Journal, sdg:memberOf min 2 sdg:Researcher

Class: sdg:ResearchReport
    Annotations: rdfs:label "Equity Research Report", iao:0000115 "A published analytical document containing investment recommendations and financial analysis produced by the research firm."
    SubClassOf: cco:ont00000995, sdg:reportId some xsd:string, sdg:publishDate some xsd:date, sdg:tickerSymbol some xsd:string, sdg:recommendation some xsd:string, sdg:performanceVsIndex some xsd:decimal, sdg:isBoldCall some xsd:boolean, sdg:deliveredTo some sdg:ClientAccount

Class: sdg:ClientAccount
    Annotations: rdfs:label "Client Account", iao:0000115 "A registered commercial entity or individual portfolio that subscribes to the research firm's services."
    SubClassOf: cco:ont00000995, sdg:accountId some xsd:string, sdg:clientType some xsd:string, sdg:region some sdg:RegionKind, sdg:accountStatus some sdg:AccountStatusKind, sdg:revenueGenerated some xsd:decimal, sdg:assignedTo exactly 1 sdg:AccountManager, sdg:subscribesTo some sdg:ResearchReport

Class: sdg:AccountManager
    Annotations: rdfs:label "Equity Research Account Manager", iao:0000115 "A staff member responsible for managing client relationships, driving revenue growth, and coordinating sales initiatives."
    SubClassOf: bfo:0000023, sdg:managerId some xsd:string, sdg:employeeName some xsd:string, sdg:salesTarget some xsd:decimal, sdg:crmUsageLevel some sdg:CrmUsageLevelKind, sdg:complianceStatus some sdg:ComplianceStatusKind, sdg:manages min 3 sdg:ClientAccount, sdg:reportsTo exactly 1 sdg:Executive, sdg:executes min 2 sdg:SalesCampaign
    HasKey: sdg:managerId

Class: sdg:SalesCampaign
    Annotations: rdfs:label "Marketing and Sales Campaign", iao:0000115 "A coordinated series of marketing activities such as seminars, webinars, and email initiatives designed to generate leads and revenue."
    SubClassOf: bfo:0000015, sdg:campaignId some xsd:string, sdg:campaignType some xsd:string, sdg:openRate some xsd:decimal, sdg:startDate some xsd:dateTime, sdg:endDate some xsd:dateTime, sdg:targets some sdg:ClientAccount, sdg:executedBy exactly 1 sdg:AccountManager

Class: sdg:SalesReport
    Annotations: rdfs:label "Sales and Strategy Report", iao:0000115 "A documented record of sales observations, client feedback, and strategic recommendations submitted to executive leadership."
    SubClassOf: cco:ont00000995, sdg:reportId some xsd:string, sdg:submissionDate some xsd:dateTime, sdg:observationType some xsd:string, sdg:priorityLevel some sdg:PriorityLevelKind, sdg:isActionable some xsd:boolean, sdg:reportDate some xsd:dateTime, sdg:totalCalls some xsd:integer, sdg:newProspects some xsd:integer, sdg:appointmentsSet some xsd:integer, sdg:status some sdg:StatusKind, sdg:submittedBy exactly 1 sdg:AccountManager, sdg:reviewedBy some sdg:Executive, sdg:generatedBy exactly 1 sdg:SalesAdministrator, sdg:covers min 2 sdg:SalesActivityRecord

Class: sdg:CourseUnit
    Annotations: rdfs:label "Accredited Course Unit or Module", iao:0000115 "A formally accredited educational unit or module defining a specific learning outcome and assessment structure within a vocational training framework."
    SubClassOf: sdg:EducationalEntity, sdg:unitCode some xsd:string, sdg:unitTitle some xsd:string, sdg:trainingTypeCode some xsd:string, sdg:trainingTypeName some xsd:string, sdg:accreditationStatus some sdg:AccreditationStatusKind, sdg:currentEffectiveDate some xsd:dateTime, sdg:expiryDate some xsd:date, sdg:isRestricted some xsd:boolean, sdg:hasRecognitionManager exactly 1 sdg:RecognitionAuthority, sdg:hasCurrencyPeriod some sdg:CurrencyPeriod, sdg:hasRestriction some sdg:Restriction, sdg:hasContactDetail some sdg:ContactDetail

Class: sdg:RecognitionAuthority
    Annotations: rdfs:label "Vocational Education Regulatory Authority", iao:0000115 "A government body or statutory regulator responsible for accrediting, monitoring, and maintaining the currency of vocational training units."
    SubClassOf: sdg:Authority, sdg:authorityName some xsd:string, sdg:legalBasis some xsd:string, sdg:jurisdiction some sdg:JurisdictionKind, sdg:accreditationStartDate some xsd:dateTime, sdg:accreditationScope some xsd:string, sdg:accredits some sdg:CourseUnit

Class: sdg:CurrencyPeriod
    Annotations: rdfs:label "Regulatory Currency Period", iao:0000115 "A defined temporal interval during which a course unit remains valid and recognized under a specific legislative or regulatory framework."
    SubClassOf: bfo:0000015, sdg:periodStartDate some xsd:dateTime, sdg:periodEndDate some xsd:dateTime, sdg:legislativeReference some xsd:string, sdg:isCurrentPeriod some xsd:boolean, sdg:appliesTo exactly 1 sdg:CourseUnit, sdg:governedBy exactly 1 sdg:RecognitionAuthority

Class: sdg:Restriction
    Annotations: rdfs:label "Course Delivery Restriction", iao:0000115 "A conditional limitation or constraint applied to the delivery, enrollment, or recognition of a specific course unit."
    SubClassOf: bfo:0000015, sdg:restrictionType some sdg:RestrictionTypeKind, sdg:restrictionDescription some xsd:string, sdg:restrictionStartDate some xsd:dateTime, sdg:restrictionEndDate some xsd:dateTime, sdg:isActive some xsd:boolean, sdg:appliesTo exactly 1 sdg:CourseUnit

Class: sdg:ContactDetail
    Annotations: rdfs:label "Administrative Contact Point", iao:0000115 "A recorded communication channel or administrative point of contact associated with the management or delivery of a course unit."
    SubClassOf: cco:ont00000995, sdg:contactType some sdg:ContactTypeKind, sdg:contactValue some xsd:string, sdg:contactStartDate some xsd:dateTime, sdg:contactEndDate some xsd:dateTime, sdg:isPrimary some xsd:boolean, sdg:associatedWith exactly 1 sdg:CourseUnit

Class: sdg:RegulatedPerson
    Annotations: rdfs:label "Regulated Person", iao:0000115 "A legal entity or individual authorized by a regulatory commission to conduct financial or professional activities under a specific certificate or licence."
    SubClassOf: cco:ont00000995, sdg:certificateNumber some xsd:string, sdg:legalName some xsd:string, sdg:registeredAddress some xsd:string, sdg:status some sdg:StatusKind, sdg:registrationDate some xsd:dateTime, sdg:employs some sdg:Applicant, sdg:holds some sdg:Application

Class: sdg:Application
    Annotations: rdfs:label "Regulatory Approval Application", iao:0000115 "A formal submission to a regulatory commission seeking approval for an individual to hold a specific regulated position within a regulated entity."
    SubClassOf: cco:ont00000958, sdg:applicationId some xsd:string, sdg:submissionDate some xsd:dateTime, sdg:status some sdg:StatusKind, sdg:applicationType some sdg:ApplicationTypeKind, sdg:processingOffice some xsd:string, sdg:submittedBy exactly 1 sdg:RegulatedPerson, sdg:concerns exactly 1 sdg:Applicant, sdg:seeksPosition exactly 1 sdg:RegulatedPosition

Class: sdg:RegulatedPosition
    Annotations: rdfs:label "Regulated Position", iao:0000115 "A specific role within a regulated entity that requires formal regulatory approval, such as Director, Compliance Officer, or Senior Officer."
    SubClassOf: bfo:0000023, sdg:positionTitle some xsd:string, sdg:proposedStartDate some xsd:date, sdg:isMoneyLaunderingReportingOfficer some xsd:boolean, sdg:employmentType some sdg:EmploymentTypeKind, sdg:heldBy exactly 1 sdg:Applicant, sdg:within exactly 1 sdg:RegulatedPerson

Class: sdg:Qualification
    Annotations: rdfs:label "Educational Qualification", iao:0000115 "A degree, diploma, or other academic credential obtained by an applicant from an educational institution."
    SubClassOf: cco:ont00000995, sdg:institutionName some xsd:string, sdg:qualificationType some xsd:string, sdg:completionDate some xsd:date, sdg:qualificationName some xsd:string, sdg:issuingBody some xsd:string, sdg:creditsRequired some xsd:integer, sdg:endorsementEligible some xsd:boolean, sdg:qualificationId some xsd:string, sdg:title some xsd:string, sdg:level some sdg:LevelKind, sdg:credits some xsd:integer, sdg:awardedDate some xsd:date, sdg:earnedBy exactly 1 sdg:Applicant, sdg:awardedFor some sdg:Course, sdg:awardedTo some sdg:ApprenticeshipParticipant, sdg:definedByFramework exactly 1 sdg:TrainingFramework, sdg:addressesSkillGap some sdg:SkillGap
    HasKey: sdg:qualificationId

Class: sdg:ProfessionalMembership
    Annotations: rdfs:label "Professional Body Membership", iao:0000115 "An active or inactive membership status in a recognized professional organization or association."
    SubClassOf: cco:ont00000995, sdg:organizationName some xsd:string, sdg:membershipStatus some sdg:MembershipStatusKind, sdg:memberSince some xsd:dateTime, sdg:membershipNumber some xsd:string, sdg:membershipId some xsd:string, sdg:certificationLevel some xsd:string, sdg:issueDate some xsd:date, sdg:expiryDate some xsd:date, sdg:heldBy exactly 1 sdg:Applicant, sdg:heldByCoach some sdg:Coach

Class: sdg:Zone
    Annotations: rdfs:label "Mission Zone", iao:0000115 "A bounded, open area containing obstacles and parking spaces that an autonomous vehicle must traverse during a mission."
    SubClassOf: bfo:0000040, sdg:zoneId some xsd:string, sdg:length some xsd:decimal, sdg:width some xsd:decimal, sdg:surfaceType some sdg:SurfaceTypeKind, sdg:isCulDeSac some xsd:boolean, sdg:zoneIdentifier some xsd:string, sdg:zoneLength some xsd:decimal, sdg:zoneWidth some xsd:decimal, sdg:zoneElevation some xsd:string, sdg:zoneStatus some sdg:ZoneStatusKind, sdg:contains min 2 sdg:Obstacle, sdg:contains some sdg:ParkingSpace, sdg:hasEntryPoint exactly 1 sdg:Waypoint, sdg:hasExitPoint exactly 1 sdg:Waypoint, sdg:hasEntryPoint exactly 1 sdg:Checkpoint, sdg:hasExitPoint exactly 1 sdg:Checkpoint

Class: sdg:Obstacle
    Annotations: rdfs:label "Environmental Obstacle", iao:0000115 "A physical object or marked boundary within a zone that the autonomous vehicle must avoid or navigate around."
    SubClassOf: bfo:0000040, sdg:obstacleId some xsd:string, sdg:obstacleType some xsd:string, sdg:positionX some xsd:decimal, sdg:positionY some xsd:decimal, sdg:isStatic some xsd:boolean, sdg:obstacleX some xsd:decimal, sdg:obstacleY some xsd:decimal, sdg:obstacleRadius some xsd:decimal, sdg:obstacleStatus some sdg:ObstacleStatusKind, sdg:locatedIn exactly 1 sdg:Zone, sdg:hasTangentCircle min 1 sdg:TangentCircle

Class: sdg:ParkingSpace
    Annotations: rdfs:label "Parking Space", iao:0000115 "A designated area within a zone where the autonomous vehicle is required to pull in and park."
    SubClassOf: bfo:0000040, sdg:spaceId some xsd:string, sdg:length some xsd:decimal, sdg:width some xsd:decimal, sdg:isOccupied some xsd:boolean, sdg:locatedIn exactly 1 sdg:Zone, sdg:hasBoundaryLine min 1 sdg:Obstacle

Class: sdg:TangentCircle
    Annotations: rdfs:label "Maximum Curvature Circle", iao:0000115 "A circle constructed adjacent to an obstacle, representing the maximum curvature the vehicle can achieve."
    SubClassOf: bfo:0000040, sdg:circleId some xsd:string, sdg:radius some xsd:decimal, sdg:centerX some xsd:decimal, sdg:centerY some xsd:decimal, sdg:circleRadius some xsd:decimal, sdg:circleCenterX some xsd:decimal, sdg:circleCenterY some xsd:decimal, sdg:circleCurvature some xsd:decimal, sdg:adjacentTo exactly 1 sdg:Obstacle, sdg:connectedByStraightLine min 2 sdg:StraightLineSegment, sdg:connectedBy min 2 sdg:PathSegment
    HasKey: sdg:circleId

Class: sdg:StraightLineSegment
    Annotations: rdfs:label "Straight Line Path Segment", iao:0000115 "A straight-line path segment that connects tangent circles at tangent points, forming part of the planned route."
    SubClassOf: bfo:0000015, sdg:segmentId some xsd:string, sdg:length some xsd:decimal, sdg:startTangentPointX some xsd:decimal, sdg:startTangentPointY some xsd:decimal, sdg:endTangentPointX some xsd:decimal, sdg:endTangentPointY some xsd:decimal, sdg:connects exactly 2 sdg:TangentCircle, sdg:partOfRoute some sdg:PlannedRoute

Class: sdg:PlannedRoute
    Annotations: rdfs:label "Autonomous Vehicle Route", iao:0000115 "A sequence of straight-line segments and arc sections that the autonomous vehicle follows to traverse a zone."
    SubClassOf: bfo:0000015, sdg:routeId some xsd:string, sdg:startTime some xsd:dateTime, sdg:endTime some xsd:dateTime, sdg:isFeasible some xsd:boolean, sdg:minObstacleDistance some xsd:decimal, sdg:composedOf min 2 sdg:StraightLineSegment, sdg:composedOf min 1 sdg:ArcSection, sdg:traverses exactly 1 sdg:Zone, sdg:startsAt exactly 1 sdg:Waypoint, sdg:endsAt exactly 1 sdg:Waypoint

Class: sdg:ArcSection
    Annotations: rdfs:label "Curved Path Section", iao:0000115 "A curved section of the planned route that connects straight-line segments, adhering to the vehicle's minimum turning radius."
    SubClassOf: bfo:0000015, sdg:arcId some xsd:string, sdg:radius some xsd:decimal, sdg:startAngle some xsd:decimal, sdg:endAngle some xsd:decimal, sdg:connects exactly 2 sdg:StraightLineSegment, sdg:partOfRoute some sdg:PlannedRoute

Class: sdg:Waypoint
    Annotations: rdfs:label "Navigation Waypoint", iao:0000115 "A specific geographic point used for navigation, such as an entry point, exit point, or destination checkpoint."
    SubClassOf: bfo:0000040, sdg:waypointId some xsd:string, sdg:x some xsd:decimal, sdg:y some xsd:decimal, sdg:waypointType some sdg:WaypointTypeKind, sdg:locatedIn exactly 1 sdg:Zone, sdg:isStartOf some sdg:PlannedRoute, sdg:isEndOf some sdg:PlannedRoute
    HasKey: sdg:waypointId

Class: sdg:CensusRecord
    Annotations: rdfs:label "Census Record", iao:0000115 "A statistical record of population, housing, and establishment data collected during a national census."
    SubClassOf: cco:ont00000995, sdg:censusYear some xsd:integer, sdg:totalPopulation some xsd:integer, sdg:region some sdg:RegionKind, sdg:dataStatus some xsd:string, sdg:recordIdentifier some xsd:string, sdg:coversRegion exactly 1 sdg:GeographicRegion, sdg:containsDemographicData min 2 sdg:DemographicStatistic

Class: sdg:DemographicStatistic
    Annotations: rdfs:label "Demographic Statistic", iao:0000115 "A quantified measure of population characteristics such as age distribution, fertility rates, or mortality."
    SubClassOf: cco:ont00000995, sdg:statisticType some xsd:string, sdg:value some xsd:decimal, sdg:unit some sdg:UnitKind, sdg:year some xsd:integer, sdg:region some sdg:RegionKind, sdg:derivedFromCensus exactly 1 sdg:CensusRecord, sdg:describesPopulation exactly 1 sdg:PopulationGroup

Class: sdg:HealthIndicator
    Annotations: rdfs:label "Health Indicator", iao:0000115 "A measured value representing the health status, medical care access, or nutritional condition of a population."
    SubClassOf: cco:ont00000995, sdg:indicatorName some xsd:string, sdg:percentage some xsd:decimal, sdg:year some xsd:integer, sdg:region some sdg:RegionKind, sdg:dataSource some xsd:string, sdg:appliesToGroup exactly 1 sdg:PopulationGroup, sdg:measuredBySurvey exactly 1 sdg:HealthSurvey

Class: sdg:HealthSurvey
    Annotations: rdfs:label "Health Survey", iao:0000115 "A structured data collection instrument used to gather information on family health, nutrition, and medical care."
    SubClassOf: cco:ont00000958, sdg:surveyName some xsd:string, sdg:surveyYear some xsd:integer, sdg:issuingBody some xsd:string, sdg:sampleSize some xsd:integer, sdg:status some sdg:StatusKind, sdg:coversRegion exactly 1 sdg:GeographicRegion, sdg:generatesIndicators min 2 sdg:HealthIndicator

Class: sdg:EducationalEnrollment
    Annotations: rdfs:label "Educational Enrollment", iao:0000115 "A statistical record of student enrollment in educational institutions within a specific academic period."
    SubClassOf: sdg:EducationalEntity, sdg:academicYear some xsd:string, sdg:totalStudents some xsd:integer, sdg:femalePercentage some xsd:decimal, sdg:region some sdg:RegionKind, sdg:schoolStage some sdg:SchoolStageKind, sdg:occursInRegion exactly 1 sdg:GeographicRegion, sdg:relatedToTeacherCount exactly 1 sdg:TeacherCount

Class: sdg:TeacherCount
    Annotations: rdfs:label "Teacher Count", iao:0000115 "A statistical record of the number of teachers employed in educational institutions within a specific period."
    SubClassOf: cco:ont00000995, sdg:academicYear some xsd:string, sdg:totalTeachers some xsd:integer, sdg:malePercentage some xsd:decimal, sdg:femalePercentage some xsd:decimal, sdg:region some sdg:RegionKind, sdg:servesRegion exactly 1 sdg:GeographicRegion, sdg:supportsEnrollment exactly 1 sdg:EducationalEnrollment

Class: sdg:AdministrativeStaffMember
    Annotations: rdfs:label "Administrative Staff Member", iao:0000115 "A person holding an administrative or support role within the English Department, such as Chair, Office Administrator, or Support Specialist."
    SubClassOf: sdg:Role, sdg:staffId some xsd:string, sdg:fullName some xsd:string, sdg:officeLocation some xsd:string, sdg:phoneNumber some xsd:string, sdg:roleTitle some sdg:RoleTitleKind, sdg:department some xsd:string, sdg:departmentalAffiliation some xsd:string, sdg:holdsRole exactly 1 sdg:AdministrativeRole, sdg:locatedIn exactly 1 sdg:OfficeRoom

Class: sdg:OfficeRoom
    Annotations: rdfs:label "Office Room", iao:0000115 "A physical room within the department building (e.g., Reavis Hall) used for administrative work, meetings, or storage."
    SubClassOf: bfo:0000002, sdg:roomNumber some xsd:string, sdg:buildingName some xsd:string, sdg:floorNumber some xsd:integer, sdg:roomType some xsd:string, sdg:isLocked some xsd:boolean, sdg:contains some sdg:OfficeEquipment, sdg:assignedTo some sdg:AdministrativeStaffMember

Class: sdg:OfficeEquipment
    Annotations: rdfs:label "Office Equipment", iao:0000115 "Physical machinery or devices located in department offices used for administrative tasks, such as duplicators, photocopiers, or fax machines."
    SubClassOf: bfo:0000002, sdg:equipmentId some xsd:string, sdg:equipmentType some xsd:string, sdg:locationRoom some xsd:string, sdg:isRestricted some xsd:boolean, sdg:maintenanceStatus some sdg:MaintenanceStatusKind, sdg:locatedIn exactly 1 sdg:OfficeRoom, sdg:operatedBy some sdg:AdministrativeStaffMember

Class: sdg:TravelRequest
    Annotations: rdfs:label "Travel Request", iao:0000115 "A formal record or form submitted by department personnel to request funding or authorization for professional travel and attendance at meetings."
    SubClassOf: cco:ont00000995, sdg:requestId some xsd:string, sdg:submissionDate some xsd:dateTime, sdg:travelPurpose some xsd:string, sdg:destination some xsd:string, sdg:fundingSource some sdg:FundingSourceKind, sdg:approvalStatus some sdg:ApprovalStatusKind, sdg:isEmergency some xsd:boolean, sdg:meetingName some xsd:string, sdg:requiresAbsenceAuthorization some xsd:boolean, sdg:requiresUniversityCar some xsd:boolean, sdg:isSubmittedEarly some xsd:boolean, sdg:submittedBy exactly 1 sdg:AdministrativeStaffMember, sdg:processedBy exactly 1 sdg:AdministrativeStaffMember, sdg:relatedTo some sdg:TravelVoucher, sdg:submittedBy exactly 1 sdg:Person, sdg:reviewedBy exactly 1 sdg:OfficeStaffRole, sdg:generates some sdg:TravelVoucher
    HasKey: sdg:requestId

Class: sdg:TravelVoucher
    Annotations: rdfs:label "Travel Voucher", iao:0000115 "A financial document submitted after travel is completed, detailing expenses and attaching original receipts for reimbursement."
    SubClassOf: cco:ont00000995, sdg:voucherId some xsd:string, sdg:submissionDate some xsd:dateTime, sdg:totalAmount some xsd:decimal, sdg:currency some xsd:string, sdg:isNotarized some xsd:boolean, sdg:receiptCount some xsd:integer, sdg:hasAllReceipts some xsd:boolean, sdg:missingReceiptsCount some xsd:integer, sdg:submittedBy exactly 1 sdg:AdministrativeStaffMember, sdg:supports exactly 1 sdg:TravelRequest, sdg:containsReceipt min 2 sdg:Receipt, sdg:generatedFrom exactly 1 sdg:TravelRequest, sdg:submittedBy exactly 1 sdg:Person, sdg:attachedTo min 2 sdg:Receipt

Class: sdg:Receipt
    Annotations: rdfs:label "Receipt", iao:0000115 "An original document or digital record proving payment for an expense incurred during departmental travel."
    SubClassOf: cco:ont00000995, sdg:receiptId some xsd:string, sdg:issueDate some xsd:date, sdg:vendorName some xsd:string, sdg:expenseAmount some xsd:decimal, sdg:expenseCategory some xsd:string, sdg:isOriginal some xsd:boolean, sdg:attachedTo exactly 1 sdg:TravelVoucher

Class: sdg:OfficeServiceRequest
    Annotations: rdfs:label "Office Service Request", iao:0000115 "A formal request submitted by department members for administrative services such as duplicating, photocopying, or faxing materials."
    SubClassOf: cco:ont00000995, sdg:requestId some xsd:string, sdg:submissionDate some xsd:dateTime, sdg:serviceType some sdg:ServiceTypeKind, sdg:pageCount some xsd:integer, sdg:isCopyrighted some xsd:boolean, sdg:estimatedCompletionTime some xsd:string, sdg:isEmergency some xsd:boolean, sdg:submittedBy exactly 1 sdg:AdministrativeStaffMember, sdg:processedBy exactly 1 sdg:AdministrativeStaffMember, sdg:requiresForm exactly 1 sdg:RequestForm

Class: sdg:RequestForm
    Annotations: rdfs:label "Request Form", iao:0000115 "A physical or digital document that must be completed and attached to service requests to ensure proper authorization and copyright compliance."
    SubClassOf: cco:ont00000995, sdg:formId some xsd:string, sdg:formType some xsd:string, sdg:isComplete some xsd:boolean, sdg:copyrightInfoProvided some xsd:boolean, sdg:locationInOffice some xsd:string, sdg:usedFor some sdg:OfficeServiceRequest
    HasKey: sdg:formId

Class: sdg:SocietyCharter
    Annotations: rdfs:label "Society Charter", iao:0000115 "The foundational legal and operational document establishing the American Society of Pediatric Otolaryngology, including its name, offices, and purposes."
    SubClassOf: cco:ont00000958, sdg:legalName some xsd:string, sdg:principalOfficeAddress some xsd:string, sdg:registeredOfficeAddress some xsd:string, sdg:jurisdictionState some xsd:string, sdg:charitablePurposeStatement some xsd:string

Class: sdg:MembershipCategory
    Annotations: rdfs:label "Membership Category", iao:0000115 "A specific role or classification defining the rights, eligibility, and status of an individual within the Society."
    SubClassOf: bfo:0000023, sdg:categoryName some xsd:string, sdg:requiresMedicalLicense some xsd:boolean, sdg:requiresBoardCertification some xsd:boolean, sdg:requiresFellowshipTraining some xsd:boolean, sdg:requiresPeerRecommendations some xsd:integer, sdg:requiresPublications some xsd:integer, sdg:governs exactly 1 sdg:SocietyCharter

Class: sdg:MedicalProfessional
    Annotations: rdfs:label "Medical Professional", iao:0000115 "A licensed physician or surgeon specializing in otolaryngology who is eligible for or holds membership in the Society."
    SubClassOf: bfo:0000002, sdg:licenseState some xsd:string, sdg:boardCertificationBody some xsd:string, sdg:pediatricPracticePercentage some xsd:decimal, sdg:yearsPostFellowship some xsd:integer, sdg:peerReviewPublicationsCount some xsd:integer, sdg:meetsEligibilityCriteria some xsd:boolean, sdg:professionalID some xsd:string, sdg:fullName some xsd:string, sdg:medicalLicenseNumber some xsd:string, sdg:employmentStatus some sdg:EmploymentStatusKind, sdg:specialty some xsd:string, sdg:holdsRole some sdg:MembershipCategory, sdg:attends some sdg:SocietyMeeting, sdg:evaluates some sdg:EthicalDecision, sdg:teaches exactly 1 sdg:Course

Class: sdg:SocietyMeeting
    Annotations: rdfs:label "Society Meeting", iao:0000115 "A regular postgraduate meeting or seminar sponsored by the Society for the dissemination of knowledge in pediatric otolaryngology."
    SubClassOf: bfo:0000015, sdg:meetingDate some xsd:dateTime, sdg:meetingType some sdg:MeetingTypeKind, sdg:location some xsd:string, sdg:isEligibilityRequirement some xsd:boolean, sdg:sponsoredBy exactly 1 sdg:SocietyCharter, sdg:attendedBy some sdg:MedicalProfessional

Class: sdg:FellowshipProgram
    Annotations: rdfs:label "Fellowship Program", iao:0000115 "A specialized training program in pediatric otolaryngology that a candidate must complete to be eligible for certain membership categories."
    SubClassOf: bfo:0000015, sdg:programName some xsd:string, sdg:durationYears some xsd:integer, sdg:isPediatricOtolaryngology some xsd:boolean, sdg:completionDate some xsd:date, sdg:completedBy some sdg:MedicalProfessional, sdg:establishedBy exactly 1 sdg:SocietyCharter

Class: sdg:FoodBeverageItem
    Annotations: rdfs:label "Food or Beverage Item", iao:0000115 "A specific food or beverage component (e.g., scrambled eggs, orange juice, pretzels) that constitutes a catering package."
    SubClassOf: sdg:DiningPackage, sdg:itemId some xsd:string, sdg:itemName some xsd:string, sdg:itemCategory some xsd:string, sdg:isSeasonal some xsd:boolean, sdg:isHousemade some xsd:boolean, sdg:allergenInfo some xsd:string, sdg:includedIn some sdg:CateringPackage, sdg:pairedWith some sdg:BeverageSelection

Class: sdg:BeverageSelection
    Annotations: rdfs:label "Beverage Selection", iao:0000115 "A standardized set of beverages (e.g., coffee, tea, sodas, waters) provided with a catering package."
    SubClassOf: cco:ont00000995, sdg:selectionId some xsd:string, sdg:selectionName some xsd:string, sdg:includesHotBeverages some xsd:boolean, sdg:includesColdBeverages some xsd:boolean, sdg:includesAlcohol some xsd:boolean, sdg:servedWith some sdg:CateringPackage, sdg:containsItem min 2 sdg:FoodBeverageItem

Class: sdg:SandwichVariety
    Annotations: rdfs:label "Sandwich Variety", iao:0000115 "A specific configuration of meats, cheeses, and breads offered within a boxed lunch or sandwich board."
    SubClassOf: cco:ont00000995, sdg:varietyId some xsd:string, sdg:varietyName some xsd:string, sdg:breadType some xsd:string, sdg:primaryProtein some xsd:string, sdg:includesCheese some xsd:boolean, sdg:partOf__escalated some sdg:CateringPackage, sdg:servedWith min 2 sdg:BoxedLunchSide

Class: sdg:BoxedLunchSide
    Annotations: rdfs:label "Boxed Lunch Side", iao:0000115 "A standard accompaniment (e.g., granola bar, chips, fruit, cookie) included with every boxed lunch variety."
    SubClassOf: cco:ont00000995, sdg:sideId some xsd:string, sdg:sideName some xsd:string, sdg:sideCategory some xsd:string, sdg:accompanies exactly 1 sdg:SandwichVariety
    HasKey: sdg:sideId

Class: sdg:EmployeeFeedbackSurvey
    Annotations: rdfs:label "Employee Feedback Survey", iao:0000115 "A structured questionnaire administered to employees to measure organizational health and workplace culture."
    SubClassOf: bfo:0000015, sdg:surveyId some xsd:string, sdg:administeredByDetail some xsd:string, sdg:numberOfEmployees some xsd:integer, sdg:numberOfOrganizations some xsd:integer, sdg:measurementAspects some xsd:string, sdg:surveyDate some xsd:dateTime, sdg:responseRate some xsd:decimal, sdg:measures min 2 sdg:WorkplaceCultureDimension, sdg:conductedFor some sdg:Organization, sdg:usedInAward some sdg:WorkplaceAward

Class: sdg:WorkplaceCultureDimension
    Annotations: rdfs:label "Workplace Culture Dimension", iao:0000115 "A specific aspect of organizational culture measured in employee feedback surveys."
    SubClassOf: bfo:00000995, sdg:dimensionId some xsd:string, sdg:dimensionName some xsd:string, sdg:description some xsd:string, sdg:measurementScale some xsd:string, sdg:isCoreMetric some xsd:boolean, sdg:measuredBy some sdg:EmployeeFeedbackSurvey, sdg:contributesTo exactly 1 sdg:OrganizationalHealth

Class: sdg:OrganizationalHealth
    Annotations: rdfs:label "Organizational Health", iao:0000115 "A composite measure of an organization's internal effectiveness and employee well-being."
    SubClassOf: bfo:0000015, sdg:healthId some xsd:string, sdg:organizationId some xsd:string, sdg:healthScore some xsd:decimal, sdg:assessmentDate some xsd:dateTime, sdg:healthStatus some sdg:HealthStatusKind, sdg:improvementAreas some xsd:string, sdg:assessedFor exactly 1 sdg:Organization, sdg:influencedBy min 2 sdg:WorkplaceCultureDimension, sdg:evaluatedIn some sdg:WorkplaceAward
    HasKey: sdg:healthId

Class: sdg:Activity
    Annotations: rdfs:label "A specific action or event carried out under a program", iao:0000115 "A specific action or event carried out under a program to achieve its objectives."
    SubClassOf: sdg:ProgramActivity, sdg:activityId some xsd:string, sdg:activityName some sdg:ActivityNameKind, sdg:activityType some sdg:ActivityTypeKind, sdg:date some xsd:dateTime, sdg:location some xsd:string, sdg:participantsCount some xsd:integer, sdg:status some sdg:StatusKind, sdg:resourcesUsed some xsd:decimal, sdg:partOfProgram exactly 1 sdg:Program, sdg:involvesBeneficiaries some sdg:Beneficiary, sdg:usesResources some sdg:Resource

Class: sdg:Resource
    Annotations: rdfs:label "A tangible or intangible item used or distributed during activities", iao:0000115 "A tangible or intangible item used or distributed during activities to support beneficiaries."
    SubClassOf: bfo:0000040, sdg:resourceId some xsd:string, sdg:resourceName some xsd:string, sdg:resourceType some sdg:ResourceTypeKind, sdg:quantity some xsd:integer, sdg:unitCost some xsd:decimal, sdg:totalCost some xsd:decimal, sdg:distributionDate some xsd:dateTime, sdg:status some sdg:StatusKind, sdg:usedInActivity some sdg:Activity, sdg:distributedToBeneficiaries some sdg:Beneficiary

Class: sdg:AeroScopeSystem
    Annotations: rdfs:label "AeroScope Detection System", iao:0000115 "A hardware and software platform used by military and law enforcement to detect, identify, and track drones in real time."
    SubClassOf: bfo:0000040, sdg:systemId some xsd:string, sdg:firmwareVersion some xsd:string, sdg:detectionRangeKm some xsd:decimal, sdg:status some sdg:StatusKind, sdg:lastMaintenanceDate some xsd:date, sdg:uses max 1 sdg:DongleModule, sdg:monitors some sdg:Drone, sdg:connectedTo max 1 sdg:NetworkSegment

Class: sdg:DongleModule
    Annotations: rdfs:label "AeroScope Upgrade Dongle", iao:0000115 "A USB hardware device that enables encryption support and firmware updates for the AeroScope system."
    SubClassOf: bfo:0000040, sdg:dongleId some xsd:string, sdg:firmwareHash some xsd:string, sdg:manufactureDate some xsd:date, sdg:encryptionSupport some xsd:boolean, sdg:securityRiskLevel some xsd:string, sdg:authenticatesWith exactly 1 sdg:DjiServer, sdg:pluggedInto exactly 1 sdg:AeroScopeSystem

Class: sdg:Drone
    Annotations: rdfs:label "Small Unmanned Aircraft System", iao:0000115 "A consumer or commercial drone capable of transmitting flight data and location information."
    SubClassOf: sdg:Entity, sdg:serialNumber some xsd:string, sdg:manufacturer some xsd:string, sdg:flightStatus some sdg:FlightStatusKind, sdg:lastKnownLocation some xsd:string, sdg:encryptionStatus some xsd:boolean, sdg:droneId some xsd:string, sdg:model some xsd:string, sdg:operationalStatus some sdg:OperationalStatusKind, sdg:detectedBy some sdg:AeroScopeSystem, sdg:transmitsDataTo some sdg:DataPackage, sdg:emits min 2 sdg:DroneSignal, sdg:operatesIn min 2 sdg:AirspaceZone

Class: sdg:DataPackage
    Annotations: rdfs:label "Encrypted Drone Data Packet", iao:0000115 "A structured data transmission containing drone flight status, path, and pilot location, encrypted by the DongleModule."
    SubClassOf: bfo:0000040, sdg:packageId some xsd:string, sdg:timestamp some xsd:dateTime, sdg:payloadSizeBytes some xsd:integer, sdg:encryptionAlgorithm some xsd:string, sdg:decryptionStatus some xsd:string, sdg:generatedBy exactly 1 sdg:Drone, sdg:processedBy some sdg:AeroScopeSystem, sdg:contains min 3 sdg:FlightPathPoint

Class: sdg:FlightPathPoint
    Annotations: rdfs:label "Drone Flight Path Coordinate", iao:0000115 "A single geographic coordinate and timestamp representing a point in a drone's flight trajectory."
    SubClassOf: bfo:0000040, sdg:pointId some xsd:string, sdg:latitude some xsd:decimal, sdg:longitude some xsd:decimal, sdg:altitudeMeters some xsd:decimal, sdg:timestamp some xsd:dateTime, sdg:partOf exactly 1 sdg:DataPackage, sdg:recordedBy some sdg:AeroScopeSystem

Class: sdg:DjiServer
    Annotations: rdfs:label "DJI Authentication Server", iao:0000115 "A remote server operated by DJI that validates encryption keys and processes authentication requests from DongleModules."
    SubClassOf: bfo:0000040, sdg:serverId some xsd:string, sdg:ipAddress some xsd:string, sdg:lastCommunicationTime some xsd:dateTime, sdg:responseLatencyMs some xsd:integer, sdg:securityAuditStatus some sdg:SecurityAuditStatusKind, sdg:authenticates some sdg:DongleModule, sdg:stores some sdg:EncryptionKey, sdg:communicatesWith some sdg:NetworkSegment

Class: sdg:EncryptionKey
    Annotations: rdfs:label "Drone Data Encryption Key", iao:0000115 "A cryptographic key used to encrypt and decrypt drone data signals, managed by DJI servers and validated by DongleModules."
    SubClassOf: bfo:0000040, sdg:keyId some xsd:string, sdg:algorithmType some sdg:AlgorithmTypeKind, sdg:keyLengthBits some xsd:integer, sdg:expirationDate some xsd:date, sdg:usageCount some xsd:integer, sdg:keyType some xsd:string, sdg:creationDate some xsd:dateTime, sdg:isRevoked some xsd:boolean, sdg:managedByServerDetail some xsd:string, sdg:issuedBy exactly 1 sdg:DjiServer, sdg:usedBy some sdg:DongleModule, sdg:encrypts some sdg:DataPackage, sdg:managedByServer exactly 1 sdg:Server, sdg:usedInTransaction some sdg:DataTransaction
    HasKey: sdg:keyId

Class: sdg:SecurityPolicy
    Annotations: rdfs:label "Network Security Policy", iao:0000115 "A set of rules and configurations governing access, encryption, and monitoring of network segments containing AeroScope systems."
    SubClassOf: sdg:GovernmentPolicy, sdg:policyId some xsd:string, sdg:policyName some xsd:string, sdg:effectiveDate some xsd:date, sdg:lastReviewDate some xsd:date, sdg:complianceStatus some sdg:ComplianceStatusKind, sdg:scope some sdg:ScopeKind, sdg:lastUpdated some xsd:dateTime, sdg:encryptionLevel some xsd:string, sdg:accessControlMode some xsd:string, sdg:auditLogRetentionDays some xsd:integer, sdg:appliesTo some sdg:NetworkSegment, sdg:auditedBy some sdg:SecurityAudit, sdg:enforcedOn exactly 1 sdg:VpnServer, sdg:governsNetwork exactly 1 sdg:NetworkSegment

Class: sdg:SecurityAudit
    Annotations: rdfs:label "Network Security Audit", iao:0000115 "A formal review and assessment of a network segment's compliance with security policies and identification of vulnerabilities."
    SubClassOf: bfo:0000040, sdg:auditId some xsd:string, sdg:auditDate some xsd:dateTime, sdg:auditorName some xsd:string, sdg:findingsCount some xsd:integer, sdg:riskRating some sdg:RiskRatingKind, sdg:assesses exactly 1 sdg:NetworkSegment, sdg:evaluates some sdg:SecurityPolicy, sdg:documents some sdg:VulnerabilityReport
    HasKey: sdg:auditId

Class: sdg:VulnerabilityReport
    Annotations: rdfs:label "Security Vulnerability Report", iao:0000115 "A documented record of identified security weaknesses in a network segment or system, resulting from a security audit."
    SubClassOf: sdg:Report, sdg:reportId some xsd:string, sdg:vulnerabilityType some xsd:string, sdg:severityScore some xsd:decimal, sdg:discoveryDate some xsd:date, sdg:remediationStatus some xsd:string, sdg:status some sdg:StatusKind, sdg:generatedBy exactly 1 sdg:SecurityAudit, sdg:pertainsTo exactly 1 sdg:NetworkSegment, sdg:references some sdg:SecurityPolicy

Class: sdg:AdoptionCase
    Annotations: rdfs:label "Adoption Case", iao:0000115 "A legal record documenting the formal adoption of an adult by a petitioner, capturing the procedural and relational data of the adoption proceeding."
    SubClassOf: cco:ont00000995, sdg:caseId some xsd:string, sdg:filingDate some xsd:date, sdg:status some sdg:StatusKind, sdg:jurisdiction some sdg:JurisdictionKind, sdg:caseNotes some xsd:string, sdg:petitionerContactPerson some xsd:string, sdg:nlfRep some xsd:string, sdg:caseIdentifier some xsd:string, sdg:jurisdictionCode some xsd:string, sdg:caseStatus some sdg:CaseStatusKind, sdg:courtDocketNumber some xsd:string, sdg:hasPetitioner exactly 1 sdg:AdoptionPetitioner, sdg:hasAdultAdoptee exactly 1 sdg:AdultAdoptee, sdg:involvesPetitioner exactly 1 sdg:AdoptionPetitioner, sdg:involvesAdultToBeAdopted exactly 1 sdg:AdultToBeAdopted, sdg:managedByNLFRep max 1 sdg:NLFRepresentative

Class: sdg:AdoptionPetitioner
    Annotations: rdfs:label "Adoption Petitioner", iao:0000115 "An individual who files a legal petition to adopt an adult, holding the role of petitioner in the adoption proceeding."
    SubClassOf: bfo:0000023, sdg:fullName some xsd:string, sdg:dateOfBirth some xsd:date, sdg:socialSecurityNumber some xsd:string, sdg:streetAddress some xsd:string, sdg:city some xsd:string, sdg:state some xsd:string, sdg:zipCode some xsd:string, sdg:phoneNumber some xsd:string, sdg:emailAddress some xsd:string, sdg:dateMovedToNevada some xsd:date, sdg:relationshipToAdoptee some xsd:string, sdg:durationOfAcquaintance some xsd:string, sdg:fullLegalName some xsd:string, sdg:residencyStartDate some xsd:date, sdg:relationshipToAdult some xsd:string, sdg:filesPetitionFor exactly 1 sdg:AdultAdoptee, sdg:residesIn exactly 1 sdg:Jurisdiction, sdg:residesAt exactly 1 sdg:ResidentialAddress, sdg:contactedBy min 2 sdg:ContactMethod, sdg:filesPetitionFor exactly 1 sdg:AdoptionCase

Class: sdg:AdultAdoptee
    Annotations: rdfs:label "Adult Adoptee", iao:0000115 "An adult individual who is the subject of an adoption petition, possessing pre-adoption and post-adoption identity attributes."
    SubClassOf: bfo:0000023, sdg:fullName some xsd:string, sdg:dateOfBirth some xsd:date, sdg:socialSecurityNumber some xsd:string, sdg:streetAddress some xsd:string, sdg:city some xsd:string, sdg:state some xsd:string, sdg:zipCode some xsd:string, sdg:phoneNumber some xsd:string, sdg:emailAddress some xsd:string, sdg:dateMovedToNevada some xsd:date, sdg:birthCityState some xsd:string, sdg:preferredPostAdoptionName some xsd:string, sdg:birthMotherName some xsd:string, sdg:birthFatherName some xsd:string, sdg:isPetitionedBy exactly 1 sdg:AdoptionPetitioner, sdg:residesIn exactly 1 sdg:Jurisdiction

Class: sdg:ContactInformation
    Annotations: rdfs:label "Contact Information", iao:0000115 "A structured record of communication details for a party involved in the adoption process, including primary and alternate contact methods."
    SubClassOf: cco:ont00000995, sdg:contactPerson some xsd:string, sdg:streetAddress some xsd:string, sdg:cellPhone some xsd:string, sdg:city some xsd:string, sdg:state some xsd:string, sdg:zipCode some xsd:string, sdg:alternatePhone some xsd:string, sdg:email some xsd:string, sdg:belongsToMany min 2 sdg:AdoptionCase

Class: sdg:PastoralTerritory
    Annotations: rdfs:label "Pastoral Territory", iao:0000115 "A spatially bounded socio-ecological domain defined by pastoralist communities through historical land-use, resource access, and cultural practices."
    SubClassOf: bfo:0000040, sdg:territoryIdentifier some xsd:string, sdg:territoryName some xsd:string, sdg:primaryEthnicGroup some xsd:string, sdg:areaHectares some xsd:decimal, sdg:establishmentDate some xsd:date, sdg:currentStatus some sdg:CurrentStatusKind, sdg:contains min 2 sdg:WaterSource, sdg:inhabitedBy min 2 sdg:PastoralCommunity, sdg:locatedIn exactly 1 sdg:GeographicRegion

Class: sdg:WaterSource
    Annotations: rdfs:label "Water Source", iao:0000115 "A natural or engineered hydrological feature providing water access, ranging from traditional wells to modern boreholes and underground aquifers."
    SubClassOf: bfo:0000040, sdg:sourceIdentifier some xsd:string, sdg:sourceName some xsd:string, sdg:sourceType some sdg:SourceTypeKind, sdg:depthMeters some xsd:decimal, sdg:flowRateLitersPerSecond some xsd:decimal, sdg:waterQualityIndex some xsd:decimal, sdg:discoveryDate some xsd:date, sdg:isModernInvention some xsd:boolean, sdg:locatedIn exactly 1 sdg:PastoralTerritory, sdg:serves min 2 sdg:PastoralCommunity

Class: sdg:HydrologicalEvent
    Annotations: rdfs:label "Hydrological Event", iao:0000115 "A discrete hydrological occurrence affecting water availability, such as drought, flooding, or aquifer discovery, impacting pastoral livelihoods."
    SubClassOf: sdg:Event, sdg:eventIdentifier some xsd:string, sdg:eventType some sdg:EventTypeKind, sdg:startDate some xsd:dateTime, sdg:endDate some xsd:dateTime, sdg:severityIndex some xsd:decimal, sdg:affectedAreaHectares some xsd:decimal, sdg:causedHerdDecimation some xsd:boolean, sdg:impacts min 2 sdg:PastoralCommunity, sdg:affects min 2 sdg:WaterSource, sdg:occursIn__escalated exactly 1 sdg:GeographicRegion

Class: sdg:BreakfastService
    Annotations: rdfs:label "Breakfast Service", iao:0000115 "A scheduled daily meal service offering a selection of food and beverage items during a fixed time window."
    SubClassOf: bfo:0000015, sdg:serviceId some xsd:string, sdg:name some sdg:NameKind, sdg:startTime some xsd:dateTime, sdg:endTime some xsd:dateTime, sdg:status some sdg:StatusKind, sdg:isBuffetStyle some xsd:boolean, sdg:offers min 2 sdg:MenuOption, sdg:servesTo some sdg:GuestReservation

Class: sdg:MenuOption
    Annotations: rdfs:label "Menu Option", iao:0000115 "A specific food or beverage item available within a breakfast service, often with customizable components."
    SubClassOf: sdg:optionId some xsd:string, sdg:name some sdg:NameKind, sdg:category some sdg:CategoryKind, sdg:isGlutenFree some xsd:boolean, sdg:isVegetarian some xsd:boolean, sdg:isVegan some xsd:boolean, sdg:servingSize some xsd:string, sdg:partOf__escalated exactly 1 sdg:BreakfastService, sdg:includesIngredient some sdg:FoodIngredient, sdg:hasBeverageChoice some sdg:BeverageType

Class: sdg:BeverageType
    Annotations: rdfs:label "Beverage Type", iao:0000115 "A distinct category of drink served during the breakfast service."
    SubClassOf: cco:ont00000995, sdg:beverageId some xsd:string, sdg:name some sdg:NameKind, sdg:type some sdg:TypeKind, sdg:servingTemp some sdg:ServingTempKind, sdg:caffeinated some xsd:boolean, sdg:servedWith some sdg:MenuOption
    HasKey: sdg:beverageId

Class: sdg:GuestReservation
    Annotations: rdfs:label "Guest Reservation", iao:0000115 "A booking record for a guest to access the breakfast service."
    SubClassOf: bfo:0000015, sdg:reservationId some xsd:string, sdg:guestName some xsd:string, sdg:checkInDate some xsd:date, sdg:roomNumber some xsd:string, sdg:dietaryRestrictions some xsd:string, sdg:status some sdg:StatusKind, sdg:bookedFor exactly 1 sdg:BreakfastService, sdg:requestedOption some sdg:MenuOption

Class: sdg:GovernanceBody
    Annotations: rdfs:label "Governance Body", iao:0000115 "A distinct organizational unit or committee established to exercise oversight, decision-making, or advisory functions within the corporate governance structure."
    SubClassOf: bfo:0000040, sdg:bodyIdentifier some xsd:string, sdg:bodyName some xsd:string, sdg:bodyType some xsd:string, sdg:meetingFrequency some sdg:MeetingFrequencyKind, sdg:establishmentDate some xsd:date, sdg:isExternal some xsd:boolean, sdg:supervises some sdg:BusinessUnit, sdg:audits some sdg:BusinessUnit, sdg:composedOf min 2 sdg:GovernanceMember

Class: sdg:GovernanceMember
    Annotations: rdfs:label "Governance Member", iao:0000115 "An individual holding a specific role (director, auditor, officer) within a governance body, responsible for oversight, execution, or advisory duties."
    SubClassOf: bfo:0000040, sdg:memberIdentifier some xsd:string, sdg:memberName some xsd:string, sdg:memberRole some xsd:string, sdg:appointmentDate some xsd:date, sdg:isExternal some xsd:boolean, sdg:certificationStatus some sdg:CertificationStatusKind, sdg:memberID some xsd:string, sdg:roleTitle some sdg:RoleTitleKind, sdg:certificationType some xsd:string, sdg:servesOn exactly 1 sdg:GovernanceBody, sdg:participatesIn__escalated some sdg:Meeting, sdg:servesOn some sdg:GovernanceCommittee, sdg:audits some sdg:BusinessUnit
    HasKey: sdg:memberID

Class: sdg:BusinessUnit
    Annotations: rdfs:label "Business Unit", iao:0000115 "A distinct operational segment, division, or subsidiary within the corporate group responsible for specific business activities and reporting to governance bodies."
    SubClassOf: bfo:0000040, sdg:unitIdentifier some xsd:string, sdg:unitName some xsd:string, sdg:unitType some sdg:UnitTypeKind, sdg:reportingFrequency some xsd:string, sdg:operationalStatus some sdg:OperationalStatusKind, sdg:sector some sdg:SectorKind, sdg:revenue some xsd:decimal, sdg:employeeCount some xsd:integer, sdg:unitID some xsd:string, sdg:isSubsidiary some xsd:boolean, sdg:lastAuditDate some xsd:date, sdg:reportsTo some sdg:GovernanceBody, sdg:auditedBy some sdg:InternalAuditingDivision, sdg:supervisedBy some sdg:GovernanceBody, sdg:partOf__escalated exactly 1 sdg:Corporation, sdg:managedBy some sdg:ExecutiveRole, sdg:operatesIn some sdg:GeographicRegion, sdg:isAuditedBy some sdg:GovernanceMember, sdg:reportsTo some sdg:GovernanceCommittee
    HasKey: sdg:unitID

Class: sdg:InternalAuditingDivision
    Annotations: rdfs:label "Internal Auditing Division", iao:0000115 "A dedicated organizational unit responsible for conducting internal audits to assess business operations, prevent improprieties, and streamline processes."
    SubClassOf: sdg:Report, sdg:divisionIdentifier some xsd:string, sdg:divisionName some xsd:string, sdg:memberCount some xsd:integer, sdg:certificationRequirement some xsd:string, sdg:auditScope some xsd:string, sdg:organizationalUnitType some xsd:string, sdg:audits some sdg:BusinessUnit, sdg:employs min 2 sdg:InternalAuditor

Class: sdg:InternalAuditor
    Annotations: rdfs:label "Internal Auditor", iao:0000115 "A certified professional employed within the Internal Auditing Division to conduct audits and assess operational compliance."
    SubClassOf: bfo:0000040, sdg:auditorIdentifier some xsd:string, sdg:auditorName some xsd:string, sdg:certificationType some xsd:string, sdg:assignmentDate some xsd:date, sdg:specialization some sdg:SpecializationKind, sdg:employedBy exactly 1 sdg:InternalAuditingDivision, sdg:conductsAuditFor some sdg:BusinessUnit

Class: sdg:Meeting
    Annotations: rdfs:label "Meeting", iao:0000115 "A scheduled gathering of governance members or executives to discuss policies, review operations, or make decisions."
    SubClassOf: bfo:0000015, sdg:meetingIdentifier some xsd:string, sdg:meetingType some sdg:MeetingTypeKind, sdg:scheduledDate some xsd:dateTime, sdg:durationHours some xsd:decimal, sdg:agendaItems some xsd:string, sdg:meetingStatus some sdg:MeetingStatusKind, sdg:convenedBy exactly 1 sdg:GovernanceBody, sdg:attendedBy min 2 sdg:GovernanceMember, sdg:reviews some sdg:BusinessUnit

Class: sdg:SchoolDistrictEntity
    Annotations: rdfs:label "School District Entity", iao:0000115 "An official organizational unit or representation within the school district, such as a sport, club, or program."
    SubClassOf: sdg:EducationalEntity, sdg:entityId some xsd:string, sdg:entityName some xsd:string, sdg:entityType some sdg:EntityTypeKind, sdg:affiliationStatus some sdg:AffiliationStatusKind, sdg:hasRepresentativeAccount min 2 sdg:SocialMediaAccount

Class: sdg:BoardPolicy
    Annotations: rdfs:label "Board Policy", iao:0000115 "A formal document establishing rules and expectations for district employees regarding technology and communication."
    SubClassOf: sdg:GovernmentPolicy, sdg:policyNumber some xsd:string, sdg:policyTitle some xsd:string, sdg:effectiveDate some xsd:date, sdg:policyStatus some sdg:PolicyStatusKind, sdg:targetAudience some sdg:TargetAudienceKind, sdg:governsAccount min 2 sdg:SocialMediaAccount, sdg:governsEmployee min 2 sdg:DistrictEmployee

Class: sdg:PublicInformationOfficer
    Annotations: rdfs:label "Public Information Officer", iao:0000115 "A district employee responsible for overseeing public communications and managing access to official social media accounts."
    SubClassOf: sdg:officerId some xsd:string, sdg:fullName some xsd:string, sdg:contactExtension some xsd:string, sdg:accessLevel some sdg:AccessLevelKind, sdg:storesCredentials min 2 sdg:SocialMediaAccount, sdg:subjectToPolicy exactly 1 sdg:BoardPolicy
    HasKey: sdg:officerId

Class: sdg:SecurityCamera
    Annotations: rdfs:label "Security Camera", iao:0000115 "A dedicated physical device installed at the Teton County Library to provide real-time surveillance and recorded archival video data for safety and security purposes."
    SubClassOf: bfo:0000040, sdg:cameraId some xsd:string, sdg:location some xsd:string, sdg:installationDate some xsd:date, sdg:isAudioEnabled some xsd:boolean, sdg:status some sdg:StatusKind, sdg:monitors some sdg:LibraryProperty, sdg:records some sdg:VideoSurveillanceData

Class: sdg:LibraryProperty
    Annotations: rdfs:label "Library Property", iao:0000115 "The physical land, buildings, and grounds owned or operated by the Teton County Library that are subject to security camera surveillance."
    SubClassOf: bfo:0000004, sdg:propertyId some xsd:string, sdg:address some xsd:string, sdg:propertyType some sdg:PropertyTypeKind, sdg:squareFootage some xsd:decimal, sdg:lastInspectionDate some xsd:date, sdg:hasCamera some sdg:SecurityCamera, sdg:contains some sdg:SecurityIncident

Class: sdg:VideoSurveillanceData
    Annotations: rdfs:label "Video Surveillance Data", iao:0000115 "Recorded archival video footage captured by security cameras, used for investigating incidents, assessing security risks, and cooperating with law enforcement."
    SubClassOf: sdg:DataEntity, sdg:dataId some xsd:string, sdg:captureDateTime some xsd:dateTime, sdg:durationSeconds some xsd:decimal, sdg:dataFormat some sdg:DataFormatKind, sdg:storageStatus some sdg:StorageStatusKind, sdg:accessLevel some sdg:AccessLevelKind, sdg:mediaFormat some xsd:string, sdg:capturedBy exactly 1 sdg:SecurityCamera, sdg:relatedTo some sdg:SecurityIncident, sdg:storedIn exactly 1 sdg:DataStorageSystem
    HasKey: sdg:dataId

Class: sdg:DataStorageSystem
    Annotations: rdfs:label "Data Storage System", iao:0000115 "The digital infrastructure used to store and manage recorded video surveillance data from library security cameras."
    SubClassOf: sdg:DataEntity, sdg:systemId some xsd:string, sdg:systemName some xsd:string, sdg:storageCapacityGB some xsd:decimal, sdg:lastBackupDate some xsd:date, sdg:encryptionStatus some xsd:boolean, sdg:stores some sdg:VideoSurveillanceData, sdg:dataContentScope some sdg:Thing

Class: sdg:ReligiousPractice
    Annotations: rdfs:label "Religious Practice", iao:0000115 "A culturally transmitted ritual, belief, or activity associated with African traditional religions, such as ancestor veneration, spirit sacrifice, or the use of charms."
    SubClassOf: sdg:TheologicalConcept, sdg:practiceId some xsd:string, sdg:practiceName some xsd:string, sdg:practiceType some xsd:string, sdg:prevalencePercentage some xsd:decimal, sdg:region some sdg:RegionKind, sdg:isSyncretic some xsd:boolean, sdg:ritualActivityType some xsd:string, sdg:observedIn some sdg:SurveyResponse, sdg:associatedWith some sdg:ReligiousIdentity

Class: sdg:ReligiousIdentity
    Annotations: rdfs:label "Religious Identity", iao:0000115 "The primary religious affiliation or self-identification of an individual, such as Christianity, Islam, or African Traditional Religion."
    SubClassOf: sdg:TheologicalConcept, sdg:identityId some xsd:string, sdg:identityLabel some xsd:string, sdg:isPrimary some xsd:boolean, sdg:adherenceLevel some xsd:string, sdg:heldBy some sdg:SurveyResponse, sdg:syncretizesWith some sdg:ReligiousPractice
    HasKey: sdg:identityId

Class: sdg:TraditionalHealer
    Annotations: rdfs:label "Traditional Healer", iao:0000115 "A religious specialist, such as a diviner or healer, called upon to discern the root causes of misfortune and prescribe rituals or traditional medicines."
    SubClassOf: bfo:0000023, sdg:healerId some xsd:string, sdg:specialistType some xsd:string, sdg:regionOfPractice some xsd:string, sdg:isRecognized some xsd:boolean, sdg:consultedBy some sdg:SurveyResponse, sdg:prescribes some sdg:TraditionalMedicine

Class: sdg:SacredObject
    Annotations: rdfs:label "Sacred Object", iao:0000115 "A physical item, such as an animal skin, skull, or charm (juju), kept in the home or used in rituals for protection or spiritual purposes."
    SubClassOf: cco:ont00000995, sdg:objectId some xsd:string, sdg:objectType some xsd:string, sdg:protectivePurpose some xsd:string, sdg:isKeptAtHome some xsd:boolean, sdg:possessedBy some sdg:SurveyResponse, sdg:usedIn some sdg:ReligiousPractice

Class: sdg:TraditionalMedicine
    Annotations: rdfs:label "Traditional Medicine", iao:0000115 "A substance or preparation derived from natural sources, prescribed by traditional healers to treat illness or counteract the effects of witchcraft or spiritual harm."
    SubClassOf: cco:ont00000995, sdg:medicineId some xsd:string, sdg:medicineName some xsd:string, sdg:sourceMaterial some xsd:string, sdg:intendedEffect some sdg:IntendedEffectKind, sdg:prescribedBy exactly 1 sdg:TraditionalHealer, sdg:usedBy some sdg:SurveyResponse

Class: sdg:InspectionBody
    Annotations: rdfs:label "Inspection Body", iao:0000115 "A statutory organization or agency, such as the Social Services Inspectorate, responsible for exercising oversight, conducting evaluations, and providing professional advice on social care services."
    SubClassOf: bfo:0000015, sdg:bodyName some xsd:string, sdg:parentDepartment some xsd:string, sdg:statutoryPowers some xsd:boolean, sdg:jurisdiction some sdg:JurisdictionKind

Class: sdg:FamilyUnit
    Annotations: rdfs:label "Family Unit", iao:0000115 "A household or social group comprising disabled adults and their children, recognized as a discrete unit for the purpose of receiving integrated social care and parenting support."
    SubClassOf: bfo:0000015, sdg:familyId some xsd:string, sdg:hasDisabledParent some xsd:boolean, sdg:hasChildren some xsd:boolean, sdg:impairmentType some sdg:ImpairmentTypeKind, sdg:undergoes some sdg:NeedsAssessment, sdg:receives min 2 sdg:ServiceDelivery
    HasKey: sdg:familyId

Class: sdg:ControlCentre
    Annotations: rdfs:label "Control Centre", iao:0000115 "A central facility where operators supervise multiple remote surveillance sites and process monitoring data."
    SubClassOf: bfo:0000040, sdg:centreIdentifier some xsd:string, sdg:centreName some xsd:string, sdg:jurisdiction some sdg:JurisdictionKind, sdg:centreType some sdg:CentreTypeKind, sdg:establishedDate some xsd:date, sdg:isPrimary some xsd:boolean, sdg:supervises min 1 sdg:SurveillanceSite, sdg:runs min 1 sdg:MonitoringApplication, sdg:connectedVia min 1 sdg:NetworkLink

Class: sdg:RadarStation
    Annotations: rdfs:label "Radar Station", iao:0000115 "A specific piece of radar hardware or sensor array installed at a surveillance site."
    SubClassOf: bfo:0000040, sdg:radarIdentifier some xsd:string, sdg:radarModel some xsd:string, sdg:frequencyBand some xsd:string, sdg:maxRange some xsd:decimal, sdg:installationDate some xsd:date, sdg:lastMaintenanceDate some xsd:date, sdg:isUpgraded some xsd:boolean, sdg:locatedAt exactly 1 sdg:SurveillanceSite, sdg:generatesDataFor exactly 1 sdg:DataAcquisitionUnit, sdg:monitoredBy min 1 sdg:ControlCentre

Class: sdg:DataAcquisitionUnit
    Annotations: rdfs:label "Data Acquisition Unit", iao:0000115 "A hardware or software component responsible for collecting raw surveillance data from radar stations."
    SubClassOf: bfo:0000040, sdg:acquisitionUnitId some xsd:string, sdg:firmwareVersion some xsd:string, sdg:samplingRate some xsd:decimal, sdg:dataFormat some sdg:DataFormatKind, sdg:status some sdg:StatusKind, sdg:lastSyncTimestamp some xsd:dateTime, sdg:connectedTo exactly 1 sdg:RadarStation, sdg:transmitsTo min 1 sdg:NetworkLink, sdg:processedBy min 1 sdg:ProcessingServer

Class: sdg:NetworkLink
    Annotations: rdfs:label "Network Link", iao:0000115 "A communication channel, such as a leased line or surveillance network, connecting sites and centres."
    SubClassOf: sdg:NetworkEntity, sdg:linkIdentifier some xsd:string, sdg:linkType some xsd:string, sdg:bandwidth some xsd:decimal, sdg:latency some xsd:decimal, sdg:isRedundant some xsd:boolean, sdg:protocol some xsd:string, sdg:connects exactly 1 sdg:SurveillanceSite, sdg:connectsTo exactly 1 sdg:ControlCentre, sdg:supports min 1 sdg:DataAcquisitionUnit

Class: sdg:MonitoringEvent
    Annotations: rdfs:label "Monitoring Event", iao:0000115 "A discrete occurrence or alert generated by the system indicating a change in status, fault, or operational state."
    SubClassOf: sdg:Event, sdg:eventId some xsd:string, sdg:eventTimestamp some xsd:dateTime, sdg:eventType some sdg:EventTypeKind, sdg:severity some sdg:SeverityKind, sdg:description some xsd:string, sdg:resolved some xsd:boolean, sdg:resolutionTime some xsd:dateTime, sdg:originatesFrom exactly 1 sdg:SurveillanceSite, sdg:affects min 1 sdg:RadarStation, sdg:triggeredBy min 1 sdg:DataAcquisitionUnit, sdg:viewedBy min 1 sdg:ControlCentre
    HasKey: sdg:eventId

Class: sdg:ProcessingServer
    Annotations: rdfs:label "Processing Server", iao:0000115 "A hardware or virtualized server instance responsible for processing, storing, and managing surveillance data."
    SubClassOf: bfo:0000040, sdg:serverId some xsd:string, sdg:serverRole some sdg:ServerRoleKind, sdg:osVersion some xsd:string, sdg:databaseType some xsd:string, sdg:uptime some xsd:decimal, sdg:lastHealthCheck some xsd:dateTime, sdg:locatedIn exactly 1 sdg:ControlCentre, sdg:processesDataFrom min 1 sdg:DataAcquisitionUnit, sdg:supports min 1 sdg:MonitoringApplication

Class: sdg:MonitoringApplication
    Annotations: rdfs:label "Monitoring Application", iao:0000115 "A software module or interface used by operators to visualize, filter, and manage surveillance data."
    SubClassOf: sdg:SecuritySystemComponent, sdg:appId some xsd:string, sdg:appName some xsd:string, sdg:version some xsd:string, sdg:interfaceType some sdg:InterfaceTypeKind, sdg:isCustomized some xsd:boolean, sdg:lastUpdated some xsd:dateTime, sdg:runsOn min 1 sdg:ProcessingServer, sdg:usedAt exactly 1 sdg:ControlCentre, sdg:displaysDataFrom min 1 sdg:SurveillanceSite
    HasKey: sdg:appId

Class: sdg:PoolFacility
    Annotations: rdfs:label "Municipal Swimming Pool Facility", iao:0000115 "A physical structure and associated land parcel designated for public aquatic recreation and maintenance."
    SubClassOf: sdg:facilityId some xsd:string, sdg:facilityName some xsd:string, sdg:municipality some xsd:string, sdg:state some xsd:string, sdg:isOutdoor some xsd:boolean, sdg:operatingSeason some xsd:string, sdg:lastInspectionDate some xsd:date, sdg:healthDepartmentComplianceStatus some xsd:string, sdg:hasStaff min 2 sdg:PoolStaffMember, sdg:undergoesMaintenance min 2 sdg:MaintenanceActivity, sdg:hostsEvents min 2 sdg:AquaticEvent

Class: sdg:PoolStaffMember
    Annotations: rdfs:label "Municipal Pool Staff Member", iao:0000115 "A person employed to supervise, maintain, or operate a municipal swimming pool facility."
    SubClassOf: bfo:0000002, sdg:staffId some xsd:string, sdg:fullName some xsd:string, sdg:positionTitle some xsd:string, sdg:employmentStatus some sdg:EmploymentStatusKind, sdg:hireDate some xsd:date, sdg:terminationDate some xsd:date, sdg:supervisorId some xsd:string, sdg:certifications some xsd:string, sdg:supervises max 1 sdg:PoolStaffMember, sdg:assignedToFacility exactly 1 sdg:PoolFacility, sdg:holdsCertification min 2 sdg:SafetyCertification
    HasKey: sdg:staffId

Class: sdg:SafetyCertification
    Annotations: rdfs:label "Aquatic Safety Certification", iao:0000115 "A formal credential or license verifying competence in water safety, rescue, and first aid."
    SubClassOf: sdg:SecurityAndSafetyMeasure, sdg:certId some xsd:string, sdg:certType some xsd:string, sdg:issuingBody some xsd:string, sdg:issueDate some xsd:date, sdg:expirationDate some xsd:date, sdg:isCurrent some xsd:boolean, sdg:certificationId some xsd:string, sdg:standardCode some xsd:string, sdg:issuingAuthorityDetail some xsd:string, sdg:expiryDate some xsd:date, sdg:status some sdg:StatusKind, sdg:scopeDescription some xsd:string, sdg:heldBy min 2 sdg:PoolStaffMember, sdg:requiredFor min 2 sdg:PoolStaffMember, sdg:appliesTo some sdg:IoTDevice, sdg:issuedBy some sdg:Manufacturer

Class: sdg:MaintenanceActivity
    Annotations: rdfs:label "Pool Maintenance and Safety Process", iao:0000115 "A process involving the monitoring, cleaning, and chemical treatment of pool water and equipment to ensure safety and compliance."
    SubClassOf: bfo:0000015, sdg:activityId some xsd:string, sdg:activityType some sdg:ActivityTypeKind, sdg:scheduledDate some xsd:dateTime, sdg:completedDate some xsd:date, sdg:performedByDetail some xsd:string, sdg:healthStandardCompliance some xsd:boolean, sdg:notes some xsd:string, sdg:performedAt exactly 1 sdg:PoolFacility, sdg:performedBy exactly 1 sdg:PoolStaffMember, sdg:usesEquipment min 2 sdg:PoolEquipment

Class: sdg:PoolEquipment
    Annotations: rdfs:label "Aquatic Facility Equipment", iao:0000115 "Physical apparatus used for pool filtration, chemical treatment, lifeguarding, and general facility operation."
    SubClassOf: bfo:0000040, sdg:equipmentId some xsd:string, sdg:equipmentName some xsd:string, sdg:equipmentType some xsd:string, sdg:installationDate some xsd:date, sdg:lastMaintenanceDate some xsd:date, sdg:operationalStatus some sdg:OperationalStatusKind, sdg:weightKg some xsd:decimal, sdg:locatedAt exactly 1 sdg:PoolFacility, sdg:servicedBy max 1 sdg:PoolStaffMember, sdg:usedInActivity min 2 sdg:MaintenanceActivity

Class: sdg:AquaticEvent
    Annotations: rdfs:label "Public Aquatic Event or Session", iao:0000115 "A scheduled time period for public use, lessons, or special events at the municipal pool."
    SubClassOf: sdg:Event, sdg:eventId some xsd:string, sdg:eventName some xsd:string, sdg:eventType some sdg:EventTypeKind, sdg:startDate some xsd:dateTime, sdg:endDate some xsd:dateTime, sdg:capacity some xsd:integer, sdg:registrationFee some xsd:decimal, sdg:isCancelled some xsd:boolean, sdg:heldAt exactly 1 sdg:PoolFacility, sdg:staffedBy min 2 sdg:PoolStaffMember, sdg:requiresMaintenance min 2 sdg:MaintenanceActivity

Class: sdg:DroneDetectionSystem
    Annotations: rdfs:label "Drone Detection System", iao:0000115 "A physical system designed to detect, identify, and track unmanned aerial vehicles using radio frequency signals and data processing."
    SubClassOf: bfo:0000040, sdg:systemIdentifier some xsd:string, sdg:manufacturer some xsd:string, sdg:modelNumber some xsd:string, sdg:deploymentStatus some sdg:DeploymentStatusKind, sdg:effectiveRangeMeters some xsd:decimal, sdg:lastFirmwareVersion some xsd:string, sdg:uses max 1 sdg:UpgradeModule, sdg:processes min 2 sdg:DroneSignal, sdg:monitors min 2 sdg:AirspaceZone

Class: sdg:UpgradeModule
    Annotations: rdfs:label "Upgrade Module", iao:0000115 "A hardware dongle or USB device that enables encryption support and firmware updates for drone detection systems."
    SubClassOf: bfo:0000040, sdg:moduleSerialNumber some xsd:string, sdg:firmwareVersion some xsd:string, sdg:encryptionStandard some sdg:EncryptionStandardKind, sdg:authenticationStatus some sdg:AuthenticationStatusKind, sdg:sessionKey some xsd:string, sdg:compatibilityStatus some sdg:CompatibilityStatusKind, sdg:connectsTo exactly 1 sdg:DroneDetectionSystem, sdg:communicatesWith exactly 1 sdg:ManufacturerServer

Class: sdg:DroneSignal
    Annotations: rdfs:label "Drone Signal", iao:0000115 "A radio frequency transmission emitted by a drone containing identification and flight data."
    SubClassOf: bfo:0000040, sdg:signalId some xsd:string, sdg:droneSerialNumber some xsd:string, sdg:flightStatus some sdg:FlightStatusKind, sdg:pilotLocation some xsd:string, sdg:encryptionStatus some xsd:boolean, sdg:timestamp some xsd:dateTime, sdg:detectedBy min 2 sdg:DroneDetectionSystem, sdg:originatesFrom exactly 1 sdg:Drone, sdg:processedBy max 1 sdg:UpgradeModule

Class: sdg:ManufacturerServer
    Annotations: rdfs:label "Manufacturer Server", iao:0000115 "A remote server operated by the drone manufacturer that handles authentication, encryption key distribution, and firmware updates."
    SubClassOf: bfo:0000040, sdg:serverId some xsd:string, sdg:serverLocation some xsd:string, sdg:accessLevel some sdg:AccessLevelKind, sdg:lastMaintenanceDate some xsd:date, sdg:securityAuditStatus some sdg:SecurityAuditStatusKind, sdg:authenticates min 2 sdg:UpgradeModule, sdg:distributes min 2 sdg:EncryptionKey, sdg:monitors min 2 sdg:DroneDetectionSystem

Class: sdg:AirspaceZone
    Annotations: rdfs:label "Airspace Zone", iao:0000115 "A defined geographic area with specific flight restrictions or surveillance requirements."
    SubClassOf: bfo:0000040, sdg:zoneId some xsd:string, sdg:zoneType some sdg:ZoneTypeKind, sdg:altitudeLimitMeters some xsd:decimal, sdg:radiusMeters some xsd:decimal, sdg:enforcementLevel some sdg:EnforcementLevelKind, sdg:monitoredBy min 2 sdg:DroneDetectionSystem, sdg:contains min 2 sdg:Drone
    HasKey: sdg:zoneId

Class: sdg:FisherySurvey
    Annotations: rdfs:label "Fishery Survey", iao:0000115 "A structured quantitative study instrument and dataset used to collect fishermen's perceptions of global warming impacts on the sea."
    SubClassOf: cco:ont00000958, sdg:surveyIdentifier some xsd:string, sdg:samplingMethod some xsd:string, sdg:totalRespondents some xsd:integer, sdg:startDate some xsd:dateTime, sdg:endDate some xsd:dateTime, sdg:status some sdg:StatusKind, sdg:coversRegion exactly 1 sdg:CoastalZone, sdg:targetsPopulation exactly 1 sdg:FishermenPopulation, sdg:measuresVariable min 2 sdg:EnvironmentalVariable

Class: sdg:CoastalZone
    Annotations: rdfs:label "Coastal Zone", iao:0000115 "A specific geographic region along the east coast of Peninsular Malaysia subject to sea-level rise and storm vulnerability."
    SubClassOf: bfo:0000004, sdg:zoneIdentifier some xsd:string, sdg:zoneName some xsd:string, sdg:stateJurisdiction some xsd:string, sdg:latitude some xsd:decimal, sdg:longitude some xsd:decimal, sdg:floodVulnerabilityIndex some xsd:decimal, sdg:containsSamplingUnit min 2 sdg:FishermenPopulation, sdg:exhibitsVariable min 2 sdg:EnvironmentalVariable

Class: sdg:FishermenPopulation
    Annotations: rdfs:label "Fishermen Population", iao:0000115 "The aggregate of registered fishermen residing in or operating within a specific coastal zone, serving as the target population for impact assessment."
    SubClassOf: bfo:0000004, sdg:populationIdentifier some xsd:string, sdg:registeredCount some xsd:integer, sdg:primaryGearType some xsd:string, sdg:averageVesselSize some xsd:decimal, sdg:adaptationReadiness some sdg:AdaptationReadinessKind, sdg:locatedInZone exactly 1 sdg:CoastalZone, sdg:respondsToSurvey max 1 sdg:FisherySurvey, sdg:experiencesVariable min 2 sdg:EnvironmentalVariable

Class: sdg:EnvironmentalVariable
    Annotations: rdfs:label "Environmental Variable", iao:0000115 "A measurable oceanographic or atmospheric parameter affected by global warming, such as temperature, current, or wave action."
    SubClassOf: bfo:0000015, sdg:variableIdentifier some xsd:string, sdg:variableName some xsd:string, sdg:measurementUnit some xsd:string, sdg:trendDirection some xsd:string, sdg:impactSeverity some xsd:string, sdg:observationPeriod some xsd:string, sdg:recordedInZone exactly 1 sdg:CoastalZone, sdg:assessedBySurvey max 1 sdg:FisherySurvey, sdg:affectsPopulation max 1 sdg:FishermenPopulation

Class: sdg:AdaptationIntervention
    Annotations: rdfs:label "Adaptation Intervention", iao:0000115 "A planned action or training program designed to assist fishermen in adapting to the impacts of global warming."
    SubClassOf: bfo:0000015, sdg:interventionIdentifier some xsd:string, sdg:interventionType some xsd:string, sdg:targetAudience some sdg:TargetAudienceKind, sdg:implementationDate some xsd:dateTime, sdg:status some sdg:StatusKind, sdg:budgetAllocated some xsd:decimal, sdg:interventionId some xsd:string, sdg:startDate some xsd:dateTime, sdg:endDate some xsd:dateTime, sdg:budget some xsd:decimal, sdg:targetsPopulation exactly 1 sdg:FishermenPopulation, sdg:mitigatesVariable min 2 sdg:EnvironmentalVariable, sdg:implementedInZone exactly 1 sdg:CoastalZone, sdg:targetsZone exactly 1 sdg:SpatialZone, sdg:benefitsFisherman min 2 sdg:Fisherman

Class: sdg:CyberIncident
    Annotations: rdfs:label "Cyber Incident", iao:0000115 "A discrete cybersecurity event involving unauthorized access, attack, damage, or theft against an organization's digital assets."
    SubClassOf: bfo:0000015, sdg:incidentId some xsd:string, sdg:timestamp some xsd:dateTime, sdg:severityLevel some sdg:SeverityLevelKind, sdg:dwellTime some xsd:decimal, sdg:status some sdg:StatusKind, sdg:falsePositiveFlag some xsd:boolean, sdg:detectedBy some sdg:ThreatDetectionSystem, sdg:affects some sdg:DigitalAsset

Class: sdg:ThreatDetectionSystem
    Annotations: rdfs:label "Threat Detection System", iao:0000115 "A technological component or service that monitors, correlates, and identifies potential cyber threats across various environments."
    SubClassOf: sdg:SecurityAndSafetyMeasure, sdg:systemId some xsd:string, sdg:systemName some xsd:string, sdg:deploymentType some sdg:DeploymentTypeKind, sdg:monitoringStatus some sdg:MonitoringStatusKind, sdg:lastScanDate some xsd:dateTime, sdg:aiEnabled some xsd:boolean, sdg:monitors some sdg:DigitalAsset, sdg:generates some sdg:SecurityEvent, sdg:partOf__escalated exactly 1 sdg:SecurityPlatform

Class: sdg:SecurityEvent
    Annotations: rdfs:label "Security Event", iao:0000115 "A recorded instance of activity within a monitored environment that may indicate a security threat or policy violation."
    SubClassOf: sdg:Event, sdg:eventId some xsd:string, sdg:eventType some sdg:EventTypeKind, sdg:sourceIp some xsd:string, sdg:destinationIp some xsd:string, sdg:timestamp some xsd:dateTime, sdg:correlationScore some xsd:decimal, sdg:eventCategory some xsd:string, sdg:originatesFrom exactly 1 sdg:ThreatDetectionSystem, sdg:relatesTo max 1 sdg:CyberIncident, sdg:triggers max 1 sdg:AutomatedResponse

Class: sdg:SecurityPlatform
    Annotations: rdfs:label "Security Platform", iao:0000115 "A unified software platform that integrates multiple security tools and services for holistic threat detection and response."
    SubClassOf: cco:ont00000995, sdg:platformId some xsd:string, sdg:platformName some xsd:string, sdg:version some xsd:string, sdg:deploymentDate some xsd:dateTime, sdg:complianceFramework some xsd:string, sdg:isOpenXdr some xsd:boolean, sdg:integrates min 2 sdg:ThreatDetectionSystem, sdg:manages some sdg:SecurityIncident, sdg:provides some sdg:AutomatedResponse

Class: sdg:AutomatedResponse
    Annotations: rdfs:label "Automated Response", iao:0000115 "A pre-configured action or workflow executed automatically by a security system to mitigate a detected threat."
    SubClassOf: sdg:SecurityAndSafetyMeasure, sdg:responseId some xsd:string, sdg:responseType some xsd:string, sdg:executionTime some xsd:dateTime, sdg:successStatus some xsd:boolean, sdg:triggerEventId some xsd:string, sdg:triggeredBy exactly 1 sdg:SecurityEvent, sdg:executedOn exactly 1 sdg:DigitalAsset, sdg:partOf__escalated exactly 1 sdg:SecurityPlatform

Class: sdg:InsulationTubing
    Annotations: rdfs:label "Insulation Tubing", iao:0000115 "A radiation cross-linked halogen-free heat-shrinkable tubing used to protect and insulate bus bars in electrical switchgear and substations."
    SubClassOf: cco:ont00000995, sdg:productCode some xsd:string, sdg:shrinkRatio some xsd:string, sdg:operatingTemperatureMin some xsd:decimal, sdg:operatingTemperatureMax some xsd:decimal, sdg:minimumShrinkTemperature some xsd:decimal, sdg:halogenFree some xsd:boolean, sdg:rohsCompliant some xsd:boolean, sdg:continuousLength some xsd:boolean, sdg:meetsSpecification exactly 1 sdg:MaterialSpecification, sdg:appliedTo some sdg:BusBar, sdg:testedBy min 2 sdg:TestMethod

Class: sdg:BusBar
    Annotations: rdfs:label "Bus Bar", iao:0000115 "A conductive metal bar used in electrical switchgear and substations to distribute electrical power, which can be rectangular or round in cross-section."
    SubClassOf: bfo:0000015, sdg:barType some xsd:string, sdg:crossSectionWidth some xsd:decimal, sdg:crossSectionHeight some xsd:decimal, sdg:nominalDiameter some xsd:decimal, sdg:voltageRating some xsd:decimal, sdg:material some xsd:string, sdg:insulatedBy some sdg:InsulationTubing, sdg:locatedIn exactly 1 sdg:SwitchgearAssembly

Class: sdg:SwitchgearAssembly
    Annotations: rdfs:label "Switchgear Assembly", iao:0000115 "An electrical assembly containing bus bars, switches, and protective devices used to control, protect, and isolate electrical equipment in substations."
    SubClassOf: bfo:0000015, sdg:assemblyId some xsd:string, sdg:voltageLevel some xsd:string, sdg:installationDate some xsd:date, sdg:manufacturer some xsd:string, sdg:status some sdg:StatusKind, sdg:contains min 2 sdg:BusBar, sdg:suppliedBy exactly 1 sdg:Manufacturer

Class: sdg:MaterialSpecification
    Annotations: rdfs:label "Material Specification", iao:0000115 "A set of physical and chemical properties defining the performance characteristics of the insulation tubing material, including mechanical, electrical, and thermal properties."
    SubClassOf: cco:ont00000995, sdg:specId some xsd:string, sdg:tensileStrength some xsd:decimal, sdg:elongationAtBreak some xsd:decimal, sdg:dielectricStrength some xsd:decimal, sdg:dielectricConstant some xsd:decimal, sdg:volumeResistance some xsd:decimal, sdg:oxygenIndex some xsd:decimal, sdg:copperCorrosionRate some xsd:decimal, sdg:coldBendTemperature some xsd:decimal, sdg:materialType some sdg:MaterialTypeKind, sdg:serviceApplication some xsd:string, sdg:testedBy min 2 sdg:TestMethod, sdg:definesMaterial exactly 1 sdg:InsulationTubing, sdg:specifies min 2 sdg:ProductModel

Class: sdg:TestMethod
    Annotations: rdfs:label "Test Method", iao:0000115 "A standardized procedure used to evaluate the physical, electrical, or thermal properties of the insulation tubing material."
    SubClassOf: bfo:0000015, sdg:methodCode some xsd:string, sdg:testType some sdg:TestTypeKind, sdg:standardBody some xsd:string, sdg:agingCondition some xsd:string, sdg:evaluatesProperty some sdg:MaterialSpecification, sdg:appliedTo some sdg:InsulationTubing

Class: sdg:DimensionalProfile
    Annotations: rdfs:label "Dimensional Profile", iao:0000115 "A set of geometric measurements defining the as-supplied and recovered dimensions of the insulation tubing, including inside diameter, wall thickness, and compatible bus bar sizes."
    SubClassOf: cco:ont00000995, sdg:profileId some xsd:string, sdg:insideDiameterMin some xsd:decimal, sdg:insideDiameterMax some xsd:decimal, sdg:wallThicknessMin some xsd:decimal, sdg:rectangularBusBarWidth some xsd:decimal, sdg:rectangularBusBarHeight some xsd:decimal, sdg:roundBusBarDiameter some xsd:decimal, sdg:shrinkRatio some xsd:string, sdg:fitsBusBar some sdg:BusBar, sdg:specifiesFor exactly 1 sdg:InsulationTubing
    HasKey: sdg:profileId

Class: sdg:Office
    Annotations: rdfs:label "ALICO Office", iao:0000115 "A physical or organizational location where ALICO conducts business operations, such as the Wilmington headquarters or regional offices."
    SubClassOf: bfo:0000040, sdg:officeId some xsd:string, sdg:city some xsd:string, sdg:region some sdg:RegionKind, sdg:country some sdg:CountryKind, sdg:isActive some xsd:boolean, sdg:establishedDate some xsd:date, sdg:hosts some sdg:Server, sdg:uses some sdg:SoftwareVersion

Class: sdg:SoftwareVersion
    Annotations: rdfs:label "Application Software Version", iao:0000115 "A specific release or 'flavor' of an application deployed across ALICO offices, tracked to ensure correct maintenance and upgrades."
    SubClassOf: bfo:0000040, sdg:softwareId some xsd:string, sdg:applicationName some xsd:string, sdg:versionNumber some xsd:string, sdg:releaseDate some xsd:dateTime, sdg:isObsolete some xsd:boolean, sdg:maintenanceStatus some sdg:MaintenanceStatusKind, sdg:deployedTo some sdg:Office, sdg:installedOn some sdg:Server

Class: sdg:SystemMetric
    Annotations: rdfs:label "System Performance Metric", iao:0000115 "A recorded measurement of system resource usage, such as disk space, CPU utilization, or job counts, captured at specific intervals."
    SubClassOf: bfo:0000015, sdg:metricId some xsd:string, sdg:metricType some sdg:MetricTypeKind, sdg:value some xsd:decimal, sdg:timestamp some xsd:dateTime, sdg:unit some sdg:UnitKind, sdg:isAnomalous some xsd:boolean, sdg:measuredOn exactly 1 sdg:Server, sdg:recordedBy exactly 1 sdg:MonitoringTool

Class: sdg:MonitoringTool
    Annotations: rdfs:label "System Monitoring Application", iao:0000115 "A software application (e.g., Vision Director) used to automate system administration, collect metrics, and audit historical activity."
    SubClassOf: sdg:SecuritySystemComponent, sdg:toolId some xsd:string, sdg:toolName some xsd:string, sdg:version some xsd:string, sdg:vendor some xsd:string, sdg:isAutomated some xsd:boolean, sdg:lastRunDate some xsd:date, sdg:installedOn some sdg:Server, sdg:collects some sdg:SystemMetric

Class: sdg:AuditLog
    Annotations: rdfs:label "Security Audit Record", iao:0000115 "A historical record of system activities, user actions, and job executions used for security auditing and troubleshooting."
    SubClassOf: bfo:0000040, sdg:logId some xsd:string, sdg:actionType some xsd:string, sdg:userId some xsd:string, sdg:timestamp some xsd:dateTime, sdg:status some sdg:StatusKind, sdg:isSuspicious some xsd:boolean, sdg:generatedBy exactly 1 sdg:MonitoringTool, sdg:relatedTo some sdg:SystemMetric

Class: sdg:ComponentPart
    Annotations: rdfs:label "Component Part", iao:0000115 "A manufactured discrete electronic component, such as a silicon controlled rectifier, characterized by specific electrical and mechanical properties."
    SubClassOf: cco:ont00000995, sdg:partNumber some xsd:string, sdg:basePartNumber some xsd:string, sdg:suffix some xsd:string, sdg:caseStyle some xsd:string, sdg:markingStyle some xsd:string, sdg:isRoHsCompliant some xsd:boolean, sdg:isHighReliability some xsd:boolean, sdg:screeningStandard some xsd:string, sdg:hasElectricalSpec some sdg:ElectricalSpecification, sdg:hasMechanicalSpec exactly 1 sdg:MechanicalSpecification, sdg:hasRating some sdg:ElectricalRating

Class: sdg:ElectricalSpecification
    Annotations: rdfs:label "Electrical Specification", iao:0000115 "A set of electrical performance parameters and limits for a discrete electronic component, measured under defined conditions."
    SubClassOf: cco:ont00000995, sdg:testAmbientTemperature some xsd:decimal, sdg:testConditionDescription some xsd:string, sdg:blockingVoltageRating some xsd:decimal, sdg:dcOnStateCurrent some xsd:decimal, sdg:repetitivePeakOnStateCurrent some xsd:decimal, sdg:peakSurgeCurrent some xsd:decimal, sdg:peakGateCurrent some xsd:decimal, sdg:averageGateCurrent some xsd:decimal, sdg:reverseGateVoltage some xsd:decimal, sdg:junctionTemperatureRange some xsd:string, sdg:appliesTo some sdg:ComponentPart

Class: sdg:ElectricalRating
    Annotations: rdfs:label "Electrical Rating", iao:0000115 "A specific maximum or nominal electrical value assigned to a component, representing a limit or characteristic under defined conditions."
    SubClassOf: cco:ont00000995, sdg:symbol some xsd:string, sdg:value some xsd:decimal, sdg:unit some sdg:UnitKind, sdg:condition some sdg:ConditionKind, sdg:isRepetitive some xsd:boolean, sdg:isSurge some xsd:boolean, sdg:assignedTo some sdg:ComponentPart

Class: sdg:MechanicalSpecification
    Annotations: rdfs:label "Mechanical Specification", iao:0000115 "The physical construction details of a component, including its case style, pinout, and marking conventions."
    SubClassOf: sdg:System, sdg:caseStyle some xsd:string, sdg:markingStyle some xsd:string, sdg:pinoutDescription some xsd:string, sdg:storageTemperatureRange some xsd:string, sdg:defines exactly 1 sdg:ComponentPart

Class: sdg:ScreeningStandard
    Annotations: rdfs:label "Screening Standard", iao:0000115 "A documented set of procedures and criteria used to qualify high-reliability electronic components, such as military specifications."
    SubClassOf: cco:ont00000958, sdg:standardCode some xsd:string, sdg:level some sdg:LevelKind, sdg:description some xsd:string, sdg:qualifies some sdg:ComponentPart

Class: sdg:StudyProtocol
    Annotations: rdfs:label "Study Protocol", iao:0000115 "A planned research activity defining the enrollment criteria, imaging procedures, and data capture methods for the IDEAS Study."
    SubClassOf: sdg:ResearchEntity, sdg:studyIdentifier some xsd:string, sdg:studyTitle some xsd:string, sdg:targetEnrollmentCount some xsd:integer, sdg:startDate some xsd:dateTime, sdg:fundingSource some sdg:FundingSourceKind, sdg:coveragePolicy some xsd:string, sdg:enrolls min 2 sdg:PatientEnrollment, sdg:specifiesImaging exactly 1 sdg:ImagingProcedure, sdg:governs min 2 sdg:ReimbursementRecord

Class: sdg:PatientEnrollment
    Annotations: rdfs:label "Patient Enrollment", iao:0000115 "The process of registering a Medicare beneficiary with mild cognitive impairment or uncertain dementia into the research study for longitudinal follow-up."
    SubClassOf: bfo:0000015, sdg:enrollmentId some xsd:string, sdg:patientAge some xsd:integer, sdg:clinicalDiagnosis some xsd:string, sdg:enrollmentDate some xsd:date, sdg:referringPhysicianId some xsd:string, sdg:medicareBeneficiaryId some xsd:string, sdg:initiates exactly 1 sdg:ImagingProcedure, sdg:recordedIn exactly 1 sdg:StudyProtocol, sdg:hasOutcome max 1 sdg:ScanResult

Class: sdg:ImagingProcedure
    Annotations: rdfs:label "Imaging Procedure", iao:0000115 "A brain positron emission tomography (PET) scan performed to detect amyloid accumulation in patients with diagnostic uncertainty."
    SubClassOf: bfo:0000015, sdg:procedureId some xsd:string, sdg:procedureDate some xsd:dateTime, sdg:modality some sdg:ModalityKind, sdg:anatomicalRegion some xsd:string, sdg:tracerAgent some xsd:string, sdg:facilityId some xsd:string, sdg:performedAt exactly 1 sdg:ImagingFacility, sdg:orderedBy exactly 1 sdg:Physician, sdg:interpretedBy exactly 1 sdg:Physician, sdg:generatesResult exactly 1 sdg:ScanResult

Class: sdg:ScanResult
    Annotations: rdfs:label "Scan Result", iao:0000115 "A diagnostic record capturing the presence or absence of amyloid accumulation and the clinical interpretation provided by a nuclear medicine physician or radiologist."
    SubClassOf: cco:ont00000995, sdg:resultId some xsd:string, sdg:amyloidStatus some sdg:AmyloidStatusKind, sdg:interpretationText some xsd:string, sdg:resultDate some xsd:dateTime, sdg:clinicalImpact some xsd:string, sdg:derivedFrom exactly 1 sdg:ImagingProcedure, sdg:disclosedTo exactly 1 sdg:PatientEnrollment

Class: sdg:ImagingFacility
    Annotations: rdfs:label "Imaging Facility", iao:0000115 "A physical location or organization authorized to perform amyloid PET scans and receive reimbursement under the CED policy."
    SubClassOf: bfo:0000004, sdg:facilityId some xsd:string, sdg:facilityName some xsd:string, sdg:location some xsd:string, sdg:certificationStatus some sdg:CertificationStatusKind, sdg:hosts min 2 sdg:ImagingProcedure

Class: sdg:ReimbursementRecord
    Annotations: rdfs:label "Reimbursement Record", iao:0000115 "A financial record documenting the payment made to a PET facility or interpreting physician under the CMS Coverage with Evidence Development (CED) policy."
    SubClassOf: cco:ont00000995, sdg:reimbursementId some xsd:string, sdg:amount some xsd:decimal, sdg:paymentDate some xsd:dateTime, sdg:payer some xsd:string, sdg:policyCode some xsd:string, sdg:covers exactly 1 sdg:ImagingProcedure, sdg:paidTo exactly 1 sdg:ImagingFacility

Class: sdg:CorporateResponsibilityProgramme
    Annotations: rdfs:label "Corporate Responsibility Programme", iao:0000115 "A structured initiative or programme managed by a corporate entity to address social, environmental, and ethical responsibilities, such as community engagement and strategic philanthropy."
    SubClassOf: cco:ont00000995, sdg:programmeIdentifier some xsd:string, sdg:programmeName some xsd:string, sdg:startDate some xsd:dateTime, sdg:status some sdg:StatusKind, sdg:scope some sdg:ScopeKind, sdg:managedBy exactly 1 sdg:ExecutiveRole, sdg:hasComponent min 2 sdg:CSRComponent

Class: sdg:CSRComponent
    Annotations: rdfs:label "Corporate Social Responsibility Component", iao:0000115 "A distinct functional area or sub-programme within a broader corporate responsibility framework, such as community engagement or strategic philanthropy."
    SubClassOf: cco:ont00000995, sdg:componentIdentifier some xsd:string, sdg:componentName some xsd:string, sdg:componentType some xsd:string, sdg:budget some xsd:decimal, sdg:targetAudience some sdg:TargetAudienceKind, sdg:partOf__escalated exactly 1 sdg:CorporateResponsibilityProgramme, sdg:targetsRegion some sdg:GeographicRegion

Class: sdg:ExecutiveRole
    Annotations: rdfs:label "Executive Role", iao:0000115 "A specific position of authority and responsibility held by an individual within a corporate structure, defining their scope of management and oversight."
    SubClassOf: bfo:0000023, sdg:roleIdentifier some xsd:string, sdg:roleTitle some sdg:RoleTitleKind, sdg:department some xsd:string, sdg:startDate some xsd:dateTime, sdg:endDate some xsd:dateTime, sdg:employmentStatus some sdg:EmploymentStatusKind, sdg:roleLevel some sdg:RoleLevelKind, sdg:roleStatus some sdg:RoleStatusKind, sdg:appointmentDate some xsd:date, sdg:terminationDate some xsd:date, sdg:reportingTo some xsd:string, sdg:compensationBand some xsd:string, sdg:isCurrent some xsd:boolean, sdg:heldBy exactly 1 sdg:Professional, sdg:oversees some sdg:BusinessUnit, sdg:managesProgramme max 1 sdg:CorporateResponsibilityProgramme, sdg:assignedToAppointment exactly 1 sdg:ExecutiveAppointment, sdg:belongsToEntity exactly 1 sdg:CorporateEntity, sdg:heldBy exactly 1 sdg:Person, sdg:atOrganization exactly 1 sdg:CreditUnion, sdg:previouslyHeld some sdg:ExecutiveRole

Class: sdg:Campaign
    Annotations: rdfs:label "Public Awareness Campaign", iao:0000115 "A coordinated series of activities and communications designed to raise awareness, influence behavior, or promote a specific cause or product across multiple regions."
    SubClassOf: bfo:0000015, sdg:campaignId some xsd:string, sdg:campaignTitle some xsd:string, sdg:launchDate some xsd:date, sdg:endDate some xsd:dateTime, sdg:reach some xsd:string, sdg:campaignStatus some xsd:string, sdg:campaignName some xsd:string, sdg:candidateName some xsd:string, sdg:officeSought some xsd:string, sdg:ballotQuestion some xsd:string, sdg:status some sdg:StatusKind, sdg:designedBy some sdg:Professional, sdg:implementedIn min 2 sdg:GeographicRegion, sdg:supportsProgramme some sdg:CSRComponent, sdg:receivesFunds max 1 sdg:GamblingFund, sdg:regulatedBy exactly 1 sdg:RegulatoryStatute

Class: sdg:SchoolSite
    Annotations: rdfs:label "School Site", iao:0000115 "A physical location and building complex where the school operates, including its address and geographic coordinates."
    SubClassOf: bfo:0000040, sdg:siteId some xsd:string, sdg:streetAddress some xsd:string, sdg:city some xsd:string, sdg:county some xsd:string, sdg:postalCode some xsd:string, sdg:country some sdg:CountryKind, sdg:latitude some xsd:decimal, sdg:longitude some xsd:decimal, sdg:siteName some xsd:string, sdg:districtAffiliation some xsd:string, sdg:siteType some sdg:SiteTypeKind, sdg:operationalStatus some sdg:OperationalStatusKind, sdg:capacity some xsd:integer, sdg:hasSite exactly 1 sdg:InspectionEvent, sdg:hosts some sdg:CurriculumProgramme, sdg:hosts some sdg:StaffMember, sdg:hosts some sdg:StudentEnrolment, sdg:employsTeacher min 2 sdg:SpecialDayClassTeacher

Class: sdg:CurriculumProgramme
    Annotations: rdfs:label "Curriculum Programme", iao:0000115 "A structured set of educational content, subjects, and learning objectives designed to meet the needs of students, including vocational and academic pathways."
    SubClassOf: sdg:Program, sdg:programmeId some xsd:string, sdg:programmeName some xsd:string, sdg:subjectArea some sdg:SubjectAreaKind, sdg:targetAgeGroup some xsd:string, sdg:isCore some xsd:boolean, sdg:isVocational some xsd:boolean, sdg:sequencingStrategy some xsd:string, sdg:phonicsApproach some xsd:string, sdg:educationalLevel some xsd:string, sdg:deliveredAt exactly 1 sdg:SchoolSite, sdg:deliveredTo some sdg:StudentEnrolment, sdg:includes some sdg:LearningActivity, sdg:supports some sdg:StudentOutcome

Class: sdg:StudentEnrolment
    Annotations: rdfs:label "Student Enrolment", iao:0000115 "A record of a student's registration and participation in the school, including their personal details, attendance, and educational needs."
    SubClassOf: sdg:EducationalEntity, sdg:enrolmentId some xsd:string, sdg:studentId some xsd:string, sdg:dateOfBirth some xsd:date, sdg:gender some sdg:GenderKind, sdg:attendanceRate some xsd:decimal, sdg:persistentAbsence some xsd:boolean, sdg:ehcPlan some xsd:boolean, sdg:ehcPlanId some xsd:string, sdg:currentYearGroup some xsd:integer, sdg:isSixthForm some xsd:boolean, sdg:enrolledAt exactly 1 sdg:SchoolSite, sdg:enrolledIn some sdg:CurriculumProgramme, sdg:hasOutcome some sdg:StudentOutcome, sdg:hasStaff some sdg:StaffMember

Class: sdg:StudentOutcome
    Annotations: rdfs:label "Student Outcome", iao:0000115 "A measurable result of a student's educational journey, including qualifications achieved, destinations, and personal development milestones."
    SubClassOf: bfo:0000040, sdg:outcomeId some xsd:string, sdg:outcomeType some sdg:OutcomeTypeKind, sdg:qualificationName some xsd:string, sdg:qualificationGrade some xsd:string, sdg:destinationType some xsd:string, sdg:destinationProvider some xsd:string, sdg:achievementDate some xsd:date, sdg:isSuccessful some xsd:boolean, sdg:achievedBy exactly 1 sdg:StudentEnrolment, sdg:supportedBy some sdg:CurriculumProgramme, sdg:supportedBy some sdg:StaffMember

Class: sdg:LearningActivity
    Annotations: rdfs:label "Learning Activity", iao:0000115 "A specific educational activity or experience designed to enhance student learning, such as trips, workshops, or extracurricular events."
    SubClassOf: sdg:ProgramActivity, sdg:activityId some xsd:string, sdg:activityName some sdg:ActivityNameKind, sdg:activityType some sdg:ActivityTypeKind, sdg:location some xsd:string, sdg:date some xsd:dateTime, sdg:participantCount some xsd:integer, sdg:isOptional some xsd:boolean, sdg:organisedBy exactly 1 sdg:StaffMember, sdg:participatedIn some sdg:StudentEnrolment, sdg:supports some sdg:CurriculumProgramme
    HasKey: sdg:activityId

Class: sdg:IoTDevice
    Annotations: rdfs:label "Internet of Things Device", iao:0000115 "A physical electronic device capable of network connectivity and automated function, such as a USB charger."
    SubClassOf: cco:ont00000995, sdg:deviceIdentifier some xsd:string, sdg:deviceName some xsd:string, sdg:deviceModel some xsd:string, sdg:firmwareVersion some xsd:string, sdg:manufacturingDate some xsd:dateTime, sdg:isCertified some xsd:boolean, sdg:certificationBody some xsd:string, sdg:manufacturedBy exactly 1 sdg:Manufacturer, sdg:distributedBy some sdg:DistributionChannel, sdg:soldIn some sdg:MarketRegion

Class: sdg:DistributionChannel
    Annotations: rdfs:label "Distribution Channel", iao:0000115 "A commercial pathway or intermediary through which IoT devices are moved from manufacturers to end-users."
    SubClassOf: cco:ont00000995, sdg:channelId some xsd:string, sdg:channelName some xsd:string, sdg:regionServed some xsd:string, sdg:contractStartDate some xsd:date, sdg:contractEndDate some xsd:date, sdg:isNegotiating some xsd:boolean, sdg:distributes some sdg:IoTDevice, sdg:serves exactly 1 sdg:MarketRegion

Class: sdg:IntellectualPropertyAsset
    Annotations: rdfs:label "Intellectual Property Asset", iao:0000115 "A non-physical creation of the mind, such as a trademark, e-commerce website, or design, owned by a company."
    SubClassOf: sdg:BusinessEntity, sdg:assetId some xsd:string, sdg:assetName some xsd:string, sdg:assetType some sdg:AssetTypeKind, sdg:valuationAmount some xsd:decimal, sdg:currencyCode some xsd:string, sdg:registrationDate some xsd:dateTime, sdg:isLicensed some xsd:boolean, sdg:usedIn some sdg:IoTDevice, sdg:ownedBy exactly 1 sdg:Manufacturer

Class: sdg:BioethicalPrinciple
    Annotations: rdfs:label "Bioethical Principle", iao:0000115 "A foundational normative rule or standard used to guide medical ethical decision-making."
    SubClassOf: bfo:0000040, sdg:principleCode some xsd:string, sdg:principleName some xsd:string, sdg:isFoundational some xsd:boolean, sdg:description some xsd:string, sdg:appliedIn min 2 sdg:EthicalDecision
    HasKey: sdg:principleCode

Class: sdg:EthicalDecision
    Annotations: rdfs:label "Ethical Decision", iao:0000115 "A deliberative process or outcome in medical practice where conflicting bioethical principles are weighed to determine a course of action."
    SubClassOf: bfo:0000015, sdg:decisionIdentifier some xsd:string, sdg:decisionDate some xsd:dateTime, sdg:decisionStatus some sdg:DecisionStatusKind, sdg:clinicalContext some xsd:string, sdg:isControversial some xsd:boolean, sdg:appliesPrinciple min 2 sdg:BioethicalPrinciple, sdg:addressesTopic exactly 1 sdg:BioethicalTopic, sdg:evaluatedBy exactly 1 sdg:MedicalProfessional

Class: sdg:BioethicalTopic
    Annotations: rdfs:label "Bioethical Topic", iao:0000115 "A specific controversial subject matter within medical ethics, such as assisted suicide or genetic manipulation, that serves as the focus of ethical deliberation."
    SubClassOf: bfo:0000040, sdg:topicCode some xsd:string, sdg:topicName some xsd:string, sdg:isControversial some xsd:boolean, sdg:regulatoryStatus some sdg:RegulatoryStatusKind, sdg:studiedIn some sdg:Course, sdg:addressedBy some sdg:EthicalDecision

Class: sdg:AssessmentStandard
    Annotations: rdfs:label "Assessment Standard", iao:0000115 "A formalized unit of learning and assessment defined by NZQA, specifying a skill, knowledge area, or performance outcome to be demonstrated by a student."
    SubClassOf: sdg:standardNumber some xsd:string, sdg:version some xsd:string, sdg:level some sdg:LevelKind, sdg:credits some xsd:integer, sdg:literacyOrNumeracyRequirement some xsd:string, sdg:fullTitle some xsd:string, sdg:methodOfAssessment some xsd:string, sdg:assessmentOpportunitiesOffered some xsd:integer, sdg:assessmentType some xsd:string, sdg:partOf__escalated some sdg:Course, sdg:measuredBy some sdg:AssessmentEvent
    HasKey: sdg:standardNumber

Class: sdg:AssessmentEvent
    Annotations: rdfs:label "Assessment Event", iao:0000115 "A scheduled instance or opportunity for a student to demonstrate competence against a specific assessment standard, occurring at a specific time and method."
    SubClassOf: sdg:Event, sdg:eventDate some xsd:dateTime, sdg:method some sdg:MethodKind, sdg:status some sdg:StatusKind, sdg:opportunityNumber some xsd:integer, sdg:assessmentType some xsd:string, sdg:covers exactly 1 sdg:AssessmentStandard, sdg:conductedFor some sdg:Course

Class: sdg:Teacher
    Annotations: rdfs:label "Teacher", iao:0000115 "An individual role or person responsible for instructing, assessing, and managing a specific educational course or subject area."
    SubClassOf: bfo:0000023, sdg:fullName some xsd:string, sdg:employeeId some xsd:string, sdg:department some xsd:string, sdg:signatureStatus some xsd:boolean, sdg:instructs some sdg:Course

Class: sdg:CapitalAccessProgram
    Annotations: rdfs:label "Capital Access Program", iao:0000115 "A structured financial instrument or policy mechanism designed to deploy public or private capital to support small business growth, infrastructure development, and economic expansion within a jurisdiction."
    SubClassOf: cco:ont00000958, sdg:programIdentifier some xsd:string, sdg:programName some xsd:string, sdg:establishedDate some xsd:date, sdg:totalFinancedAmount some xsd:decimal, sdg:maxGuaranteeAmount some xsd:decimal, sdg:programStatus some sdg:ProgramStatusKind, sdg:targetJurisdiction some xsd:string, sdg:administeredBy exactly 1 sdg:EconomicDevelopmentBank, sdg:deliveredThrough some sdg:FinancialDevelopmentCorporation, sdg:supports some sdg:SmallBusiness, sdg:targets some sdg:UnderservedCommunity

Class: sdg:EconomicDevelopmentBank
    Annotations: rdfs:label "Economic Development Bank", iao:0000115 "A state-chartered municipal entity with broad authority to issue bonds, provide credit enhancements, and finance public infrastructure and private development to stimulate economic growth."
    SubClassOf: cco:ont00000995, sdg:bankIdentifier some xsd:string, sdg:bankName some xsd:string, sdg:foundingYear some xsd:integer, sdg:governingOffice some xsd:string, sdg:totalFinancedAmount some xsd:decimal, sdg:bondIssuanceAuthority some xsd:boolean, sdg:jurisdiction some sdg:JurisdictionKind, sdg:administers min 2 sdg:CapitalAccessProgram, sdg:leverages some sdg:FinancialDevelopmentCorporation, sdg:finances some sdg:InfrastructureProject, sdg:targets some sdg:SmallBusiness

Class: sdg:FinancialDevelopmentCorporation
    Annotations: rdfs:label "Financial Development Corporation", iao:0000115 "A non-profit entity created through legislation to leverage public dollars, support lender credit or bond risk, and deploy capital investment to small businesses and community development projects."
    SubClassOf: sdg:FinancialEntity, sdg:fdcIdentifier some xsd:string, sdg:fdcName some xsd:string, sdg:establishmentDate some xsd:date, sdg:publicDollarsLeveraged some xsd:decimal, sdg:totalGuaranteeIssuance some xsd:decimal, sdg:deploymentStatus some sdg:DeploymentStatusKind, sdg:jurisdiction some sdg:JurisdictionKind, sdg:legalEstablishmentMechanism some xsd:string, sdg:delivers some sdg:CapitalAccessProgram, sdg:supports min 2 sdg:SmallBusiness, sdg:partnersWith some sdg:InstitutionalLender, sdg:targets some sdg:UnderservedCommunity

Class: sdg:SmallBusiness
    Annotations: rdfs:label "Small Business", iao:0000115 "A commercial enterprise receiving financial support, loan guarantees, or capital access to facilitate growth, job creation, employee retention, and tax base expansion."
    SubClassOf: bfo:0000015, sdg:businessIdentifier some xsd:string, sdg:businessName some xsd:string, sdg:industrySector some sdg:IndustrySectorKind, sdg:employeeCount some xsd:integer, sdg:jobCreationCommitment some xsd:integer, sdg:employeeRetentionCommitment some xsd:boolean, sdg:taxBaseImpact some xsd:decimal, sdg:receivesSupportFrom some sdg:CapitalAccessProgram, sdg:isSupportedBy some sdg:FinancialDevelopmentCorporation, sdg:locatedIn exactly 1 sdg:UnderservedCommunity, sdg:employs min 2 sdg:Employee

Class: sdg:UnderservedCommunity
    Annotations: rdfs:label "Underserved Community", iao:0000115 "A geographic neighborhood or jurisdiction characterized by limited access to capital, credit, or economic development resources, targeted for intervention by public finance programs."
    SubClassOf: sdg:CommunityEntity, sdg:communityIdentifier some xsd:string, sdg:communityName some xsd:string, sdg:geographicBoundary some xsd:string, sdg:populationDensity some xsd:decimal, sdg:medianIncome some xsd:decimal, sdg:accessLevel some sdg:AccessLevelKind, sdg:targetedStatus some xsd:boolean, sdg:hosts some sdg:SmallBusiness, sdg:receivesInvestmentFrom some sdg:CapitalAccessProgram, sdg:isLocatedIn exactly 1 sdg:Jurisdiction

Class: sdg:InfrastructureProject
    Annotations: rdfs:label "Infrastructure Project", iao:0000115 "A public or private development initiative involving the construction, improvement, or financing of physical assets such as roads, utilities, or commercial facilities to support economic activity."
    SubClassOf: sdg:CommunityEntity, sdg:projectIdentifier some xsd:string, sdg:projectName some xsd:string, sdg:projectType some sdg:ProjectTypeKind, sdg:totalCost some xsd:decimal, sdg:financedAmount some xsd:decimal, sdg:startDate some xsd:dateTime, sdg:completionDate some xsd:date, sdg:projectStatus some sdg:ProjectStatusKind, sdg:financedBy exactly 1 sdg:EconomicDevelopmentBank, sdg:locatedIn some sdg:UnderservedCommunity, sdg:supports some sdg:SmallBusiness, sdg:createsJobsFor min 2 sdg:Employee

Class: sdg:InstitutionalLender
    Annotations: rdfs:label "Institutional Lender", iao:0000115 "A financial institution such as a commercial bank, credit union, or community development financial institution that deploys capital and extends credit to small businesses with risk support from public entities."
    SubClassOf: cco:ont00000995, sdg:lenderIdentifier some xsd:string, sdg:lenderName some xsd:string, sdg:lenderType some xsd:string, sdg:totalCapitalDeployed some xsd:decimal, sdg:riskTolerance some sdg:RiskToleranceKind, sdg:jurisdiction some sdg:JurisdictionKind, sdg:partnersWith some sdg:FinancialDevelopmentCorporation, sdg:extendsCreditTo min 2 sdg:SmallBusiness, sdg:receivesRiskSupportFrom some sdg:CapitalAccessProgram, sdg:operatesIn exactly 1 sdg:Jurisdiction

Class: sdg:Discipline
    Annotations: rdfs:label "Discipline", iao:0000115 "A specific shooting event category within a competition."
    SubClassOf: sdg:disciplineId some xsd:string, sdg:disciplineName some xsd:string, sdg:weaponType some xsd:string, sdg:distance some xsd:decimal, sdg:genderCategory some xsd:string, sdg:format some sdg:FormatKind, sdg:partOf__escalated exactly 1 sdg:ShootingEvent, sdg:hasResult min 2 sdg:CompetitionResult

Class: sdg:CompetitionResult
    Annotations: rdfs:label "Competition Result", iao:0000115 "A record of a shooter's performance in a specific discipline."
    SubClassOf: sdg:CompetitionEntity, sdg:resultId some xsd:string, sdg:qualificationScore some xsd:integer, sdg:finalScore some xsd:decimal, sdg:aggregateScore some xsd:decimal, sdg:rank some xsd:integer, sdg:medal some xsd:string, sdg:status some sdg:StatusKind, sdg:recordedBy exactly 1 sdg:Shooter, sdg:forDiscipline exactly 1 sdg:Discipline, sdg:partOfEvent exactly 1 sdg:ShootingEvent

Class: sdg:TeamResult
    Annotations: rdfs:label "Team Result", iao:0000115 "A record of a team's performance in a team discipline."
    SubClassOf: cco:ont00000995, sdg:teamResultId some xsd:string, sdg:totalScore some xsd:decimal, sdg:rank some xsd:integer, sdg:medal some xsd:string, sdg:teamName some xsd:string, sdg:forDiscipline exactly 1 sdg:Discipline, sdg:partOfEvent exactly 1 sdg:ShootingEvent, sdg:composedOf min 2 sdg:Shooter

Class: sdg:ActivityEvidence
    Annotations: rdfs:label "Activity Evidence", iao:0000115 "Documentation of a student's participation and achievement in in-school or out-of-school extra-curricular activities."
    SubClassOf: sdg:ProgramActivity, sdg:evidenceId some xsd:string, sdg:activityName some sdg:ActivityNameKind, sdg:activityType some sdg:ActivityTypeKind, sdg:achievementLevel some sdg:AchievementLevelKind, sdg:awardedScore some xsd:integer, sdg:isTopFive some xsd:boolean, sdg:supportsApplication exactly 1 sdg:AdmissionApplication

Class: sdg:IdentityDocument
    Annotations: rdfs:label "Identity Document", iao:0000115 "An official document used to verify the identity and age of the applicant."
    SubClassOf: sdg:Document, sdg:documentId some xsd:string, sdg:documentType some sdg:DocumentTypeKind, sdg:issueDate some xsd:date, sdg:expiryDate some xsd:date, sdg:verificationStatus some sdg:VerificationStatusKind, sdg:belongsToStudent exactly 1 sdg:Student

Class: sdg:IntelligenceReport
    Annotations: rdfs:label "Intelligence Report", iao:0000115 "A structured record of analyzed information regarding threats, suspicious behavior, or criminal activity, maintained and disseminated to law enforcement personnel."
    SubClassOf: sdg:Report, sdg:reportIdentifier some xsd:string, sdg:reportDate some xsd:dateTime, sdg:classificationLevel some xsd:string, sdg:threatCategory some xsd:string, sdg:status some sdg:StatusKind, sdg:complianceStandard some sdg:ComplianceStandardKind, sdg:contentDomain some xsd:string, sdg:storedIn exactly 1 sdg:IntelligenceRepository, sdg:analyzedBy some sdg:IntelligenceAnalyst, sdg:concernsSubject some sdg:SubjectOfInterest, sdg:disseminatedTo some sdg:PartnerAgency

Class: sdg:IntelligenceRepository
    Annotations: rdfs:label "Intelligence Repository", iao:0000115 "The physical or digital facility, such as the Delaware Valley Intelligence Center, that serves as the central storage and processing hub for intelligence data and personnel."
    SubClassOf: bfo:0000040, sdg:facilityIdentifier some xsd:string, sdg:facilityName some xsd:string, sdg:locationCity some xsd:string, sdg:locationState some xsd:string, sdg:operationalStatus some sdg:OperationalStatusKind, sdg:jurisdictionCoverage some xsd:string, sdg:housesUnit some sdg:IntelligenceUnit, sdg:storesReport min 2 sdg:IntelligenceReport, sdg:employsPersonnel min 2 sdg:IntelligenceAnalyst

Class: sdg:IntelligenceUnit
    Annotations: rdfs:label "Intelligence Unit", iao:0000115 "A specialized organizational entity, such as the DVIC Unit, responsible for the collection, analysis, and dissemination of intelligence within a specific jurisdiction or partnership."
    SubClassOf: bfo:0000004, sdg:unitCode some xsd:string, sdg:unitName some xsd:string, sdg:parentOrganization some xsd:string, sdg:missionScope some xsd:string, sdg:establishmentDate some xsd:date, sdg:operatesIn exactly 1 sdg:IntelligenceRepository, sdg:employsAnalyst min 2 sdg:IntelligenceAnalyst, sdg:coordinatesWith some sdg:PartnerAgency, sdg:producesReport min 2 sdg:IntelligenceReport

Class: sdg:IntelligenceAnalyst
    Annotations: rdfs:label "Intelligence Analyst", iao:0000115 "A law enforcement personnel or partner agency representative assigned to collect, review, analyze, and disseminate intelligence information."
    SubClassOf: bfo:0000004, sdg:analystBadgeNumber some xsd:string, sdg:analystName some xsd:string, sdg:agencyAffiliation some xsd:string, sdg:clearanceLevel some xsd:string, sdg:assignmentDate some xsd:date, sdg:status some sdg:StatusKind, sdg:assignedToUnit exactly 1 sdg:IntelligenceUnit, sdg:basedAt exactly 1 sdg:IntelligenceRepository, sdg:analyzesReport min 2 sdg:IntelligenceReport, sdg:representsAgency exactly 1 sdg:PartnerAgency
    HasKey: sdg:analystBadgeNumber

Class: sdg:PartnerAgency
    Annotations: rdfs:label "Partner Agency", iao:0000115 "A governmental, non-governmental, or private sector entity that collaborates with the DVIC Unit for intelligence sharing, analysis, and public safety."
    SubClassOf: bfo:0000004, sdg:agencyIdentifier some xsd:string, sdg:agencyName some xsd:string, sdg:agencyType some sdg:AgencyTypeKind, sdg:jurisdictionRegion some xsd:string, sdg:contactEmail some xsd:string, sdg:collaboratesWithUnit some sdg:IntelligenceUnit, sdg:receivesReport min 2 sdg:IntelligenceReport, sdg:employsAnalyst min 2 sdg:IntelligenceAnalyst, sdg:sharesDataWith some sdg:PartnerAgency

Class: sdg:SubjectOfInterest
    Annotations: rdfs:label "Subject of Interest", iao:0000115 "An individual, group, or entity that is the target of intelligence collection and analysis due to suspected involvement in criminal activity, threats, or hazards."
    SubClassOf: bfo:0000002, sdg:subjectIdentifier some xsd:string, sdg:subjectName some xsd:string, sdg:subjectType some xsd:string, sdg:riskLevel some sdg:RiskLevelKind, sdg:lastKnownLocation some xsd:string, sdg:associatedThreats some xsd:string, sdg:monitoredBy some sdg:IntelligenceUnit, sdg:documentedInReport min 2 sdg:IntelligenceReport, sdg:linkedToActivity some sdg:SuspiciousActivityReport

Class: sdg:UniversityOfficial
    Annotations: rdfs:label "University Official", iao:0000115 "A person employed by the University, performing assigned administrative or professional responsibilities and the Board of Regents and its members."
    SubClassOf: bfo:0000040, sdg:officialId some xsd:string, sdg:fullName some xsd:string, sdg:roleDetail some sdg:RoleKind, sdg:department some xsd:string, sdg:employmentStatus some sdg:EmploymentStatusKind, sdg:hireDate some xsd:date

Class: sdg:ConductViolation
    Annotations: rdfs:label "Conduct Violation", iao:0000115 "An act of proscribed conduct by a student that violates the Student Code of Conduct."
    SubClassOf: bfo:0000015, sdg:violationId some xsd:string, sdg:description some xsd:string, sdg:dateOfIncident some xsd:dateTime, sdg:location some xsd:string, sdg:severityLevel some sdg:SeverityLevelKind, sdg:status some sdg:StatusKind, sdg:committedBy exactly 1 sdg:Student, sdg:adjudicatedBy max 1 sdg:StudentConductBoard, sdg:sanctionedBy max 1 sdg:StudentConductAdministrator

Class: sdg:StudentConductBoard
    Annotations: rdfs:label "Student Conduct Board", iao:0000115 "A group of persons authorized by the Vice President of Student Affairs to determine whether a student has violated the Student Code and to recommend sanctions."
    SubClassOf: bfo:0000015, sdg:boardId some xsd:string, sdg:composition some xsd:string, sdg:authorizationDate some xsd:dateTime, sdg:status some sdg:StatusKind, sdg:adjudicates some sdg:ConductViolation, sdg:authorizedBy exactly 1 sdg:UniversityOfficial

Class: sdg:StudentConductAdministrator
    Annotations: rdfs:label "Student Conduct Administrator", iao:0000115 "A University official authorized on a case-by-case basis by the Vice President of Student Affairs to impose sanctions upon any student(s) found to have violated the Student Code."
    SubClassOf: bfo:0000015, sdg:administratorId some xsd:string, sdg:authorizationDate some xsd:dateTime, sdg:caseAuthorization some xsd:boolean, sdg:status some sdg:StatusKind, sdg:imposesSanctionsOn some sdg:ConductViolation, sdg:authorizedBy exactly 1 sdg:UniversityOfficial
    HasKey: sdg:administratorId

Class: sdg:UniversityPremises
    Annotations: rdfs:label "University Premises", iao:0000115 "All land, buildings, facilities, and other property in the possession of or owned, used, or controlled by the University, including all adjacent streets and sidewalks."
    SubClassOf: bfo:0000002, sdg:premisesId some xsd:string, sdg:name some sdg:NameKind, sdg:type some sdg:TypeKind, sdg:location some xsd:string, sdg:siteOf some sdg:ConductViolation

Class: sdg:SpecialDayClassTeacher
    Annotations: rdfs:label "Special Day Class Teacher", iao:0000115 "A credentialed professional who provides direct instruction and supervision for students with specific learning handicaps within a special day class setting."
    SubClassOf: bfo:0000040, sdg:credentialType some sdg:CredentialTypeKind, sdg:employeeId some xsd:string, sdg:employmentStatus some sdg:EmploymentStatusKind, sdg:salarySchedule some xsd:string, sdg:hireDate some xsd:date, sdg:lastEvaluationDate some xsd:date, sdg:supervisoryRole some xsd:boolean, sdg:assignedTo exactly 1 sdg:SchoolSite, sdg:evaluates min 2 sdg:Student, sdg:participatesIn__escalated min 2 sdg:IEPTeam

Class: sdg:IndividualizedEducationProgram
    Annotations: rdfs:label "Individualized Education Program", iao:0000115 "A legally binding document outlining specific educational objectives, accommodations, and services for a student with a disability."
    SubClassOf: bfo:0000016, sdg:iepId some xsd:string, sdg:creationDate some xsd:dateTime, sdg:lastReviewDate some xsd:date, sdg:expirationDate some xsd:date, sdg:status some sdg:StatusKind, sdg:meetsFederalCompliance some xsd:boolean, sdg:meetsStateCompliance some xsd:boolean, sdg:coversStudent exactly 1 sdg:Student, sdg:createdBy exactly 1 sdg:IEPTeam, sdg:specifiesInstruction min 2 sdg:InstructionalObjective, sdg:mandatesAccommodation min 2 sdg:Accommodation

Class: sdg:InstructionalObjective
    Annotations: rdfs:label "Instructional Objective", iao:0000115 "A clearly defined goal in learning or behavior designed to reduce the handicapping effect of a pupil's disability, specify remedial instruction, or enhance pupil strengths."
    SubClassOf: bfo:0000016, sdg:objectiveId some xsd:string, sdg:objectiveType some sdg:ObjectiveTypeKind, sdg:targetSkill some xsd:string, sdg:anticipatedAttainmentLevel some xsd:decimal, sdg:measurementMethod some xsd:string, sdg:dueDate some xsd:date, sdg:isRemedial some xsd:boolean, sdg:partOfIEP exactly 1 sdg:IndividualizedEducationProgram, sdg:targetsStudent exactly 1 sdg:Student, sdg:measuredBy min 2 sdg:AssessmentInstrument

Class: sdg:AssessmentInstrument
    Annotations: rdfs:label "Assessment Instrument", iao:0000115 "A standardized tool or method used to measure achievement levels, ascertain attainment of objectives, and evaluate the effectiveness of instructional programs."
    SubClassOf: sdg:AssessmentTool, sdg:instrumentId some xsd:string, sdg:instrumentName some xsd:string, sdg:instrumentType some sdg:InstrumentTypeKind, sdg:validityDate some xsd:date, sdg:reliabilityCoefficient some xsd:decimal, sdg:administeredByDetail some xsd:string, sdg:instrumentFormat some sdg:InstrumentFormatKind, sdg:instrumentCode some xsd:string, sdg:format some sdg:FormatKind, sdg:administeringBody some xsd:string, sdg:validityPeriodMonths some xsd:integer, sdg:isDeprecated some xsd:boolean, sdg:versionNumber some xsd:string, sdg:usedToMeasure min 2 sdg:InstructionalObjective, sdg:administeredTo min 2 sdg:Student, sdg:definesBenchmark min 2 sdg:ReadinessBenchmark, sdg:administers min 2 sdg:StudentAssessmentRecord

Class: sdg:IEPTeam
    Annotations: rdfs:label "IEP Team", iao:0000115 "A collaborative group including teachers, administrators, parents, and specialists responsible for developing, reviewing, and evaluating Individualized Education Programs."
    SubClassOf: bfo:0000002, sdg:teamId some xsd:string, sdg:teamName some xsd:string, sdg:meetingFrequency some sdg:MeetingFrequencyKind, sdg:lastMeetingDate some xsd:date, sdg:nextScheduledMeeting some xsd:date, sdg:complianceStatus some sdg:ComplianceStatusKind, sdg:createsIEP min 2 sdg:IndividualizedEducationProgram, sdg:includesMember min 2 sdg:SpecialDayClassTeacher, sdg:includesMember min 2 sdg:Parent

Class: sdg:GovernanceCommittee
    Annotations: rdfs:label "Corporate Governance Committee", iao:0000115 "A formally established organizational unit within the corporate structure tasked with overseeing specific governance domains such as compliance, compensation, or disclosure."
    SubClassOf: sdg:Organization, sdg:committeeName some xsd:string, sdg:establishmentDate some xsd:date, sdg:primaryObjective some sdg:PrimaryObjectiveKind, sdg:isCrossFunctional some xsd:boolean, sdg:reportingFrequency some xsd:string, sdg:governanceDomain some xsd:string, sdg:oversees some sdg:GovernanceDomain, sdg:composedOf min 2 sdg:GovernanceMember

Class: sdg:GovernanceDomain
    Annotations: rdfs:label "Corporate Governance Domain", iao:0000115 "A specific functional area of corporate oversight and management, such as internal control, information security, or CSR policy formulation."
    SubClassOf: bfo:0000040, sdg:domainName some xsd:string, sdg:domainCode some xsd:string, sdg:regulatoryBasis some xsd:string, sdg:isMandatory some xsd:boolean, sdg:isOverseenBy some sdg:GovernanceCommittee, sdg:governs some sdg:BusinessUnit

Class: sdg:GovernancePolicy
    Annotations: rdfs:label "Corporate Governance Policy", iao:0000115 "A formalized rule, standard, or basic policy established to ensure the properness of business activities and compliance with legal ordinances."
    SubClassOf: sdg:GovernmentPolicy, sdg:policyID some xsd:string, sdg:policyTitle some xsd:string, sdg:effectiveDate some xsd:date, sdg:issuingAuthorityDetail some xsd:string, sdg:complianceStatus some sdg:ComplianceStatusKind, sdg:governs some sdg:BusinessUnit, sdg:supports some sdg:GovernanceDomain, sdg:issuingAuthority some sdg:GovernmentEntity

Class: sdg:HealthAndSafetyPolicy
    Annotations: rdfs:label "Health and Safety Policy", iao:0000115 "A formal organizational document establishing standards, responsibilities, and procedures for maintaining a safe and healthy workplace environment."
    SubClassOf: sdg:GovernmentPolicy, sdg:policyIdentifier some xsd:string, sdg:effectiveDate some xsd:date, sdg:issuingAuthorityDetail some xsd:string, sdg:complianceStandard some sdg:ComplianceStandardKind, sdg:policyStatus some sdg:PolicyStatusKind, sdg:scopeOfProtectionDetail some xsd:string, sdg:governs some sdg:WorkplaceActivity

Class: sdg:WorkplaceActivity
    Annotations: rdfs:label "Workplace Activity", iao:0000115 "Any operational task, process, or routine performed within the library's facilities by employees, contractors, or management."
    SubClassOf: sdg:ProgramActivity, sdg:activityCode some xsd:string, sdg:locationZone some xsd:string, sdg:riskLevel some sdg:RiskLevelKind, sdg:scheduledDate some xsd:dateTime, sdg:status some sdg:StatusKind, sdg:conductedBy some sdg:Worker, sdg:occursIn__escalated exactly 1 sdg:FacilityZone, sdg:subjectTo some sdg:HealthAndSafetyPolicy

Class: sdg:Worker
    Annotations: rdfs:label "Worker", iao:0000115 "An individual employed by, contracted to, or managing the Aurora Public Library, including employees, supervisors, and contractors."
    SubClassOf: bfo:0000002, sdg:workerId some xsd:string, sdg:roleDetail some sdg:RoleKind, sdg:department some xsd:string, sdg:safetyTrainingStatus some xsd:string, sdg:certificationExpiry some xsd:date, sdg:assignedTo some sdg:WorkplaceActivity, sdg:reportsTo max 1 sdg:Worker, sdg:subjectTo some sdg:HarassmentPolicy

Class: sdg:SafetyIncident
    Annotations: rdfs:label "Safety Incident", iao:0000115 "An event involving unsafe conditions, harassment, or violence that occurred in the workplace, requiring investigation or reporting."
    SubClassOf: sdg:SecurityAndSafetyMeasure, sdg:incidentId some xsd:string, sdg:incidentType some sdg:IncidentTypeKind, sdg:severityLevel some sdg:SeverityLevelKind, sdg:reportedDate some xsd:dateTime, sdg:investigationStatus some xsd:string, sdg:reportedBy exactly 1 sdg:Worker, sdg:occurredIn exactly 1 sdg:FacilityZone, sdg:investigatedBy max 1 sdg:Worker
    HasKey: sdg:incidentId

Class: sdg:FacilityZone
    Annotations: rdfs:label "Facility Zone", iao:0000115 "A distinct physical area or department within the library premises where specific health and safety protocols apply."
    SubClassOf: bfo:0000004, sdg:zoneCode some xsd:string, sdg:zoneName some xsd:string, sdg:occupancyLimit some xsd:integer, sdg:hazardRating some xsd:string, sdg:lastInspectionDate some xsd:date, sdg:contains some sdg:SafetyIncident, sdg:hostedActivity some sdg:WorkplaceActivity

Class: sdg:HarassmentPolicy
    Annotations: rdfs:label "Workplace Harassment Policy", iao:0000115 "A formal organizational document defining prohibited conduct, reporting mechanisms, and investigation procedures for workplace harassment."
    SubClassOf: sdg:GovernmentPolicy, sdg:policyIdentifier some xsd:string, sdg:effectiveDate some xsd:date, sdg:issuingAuthorityDetail some xsd:string, sdg:complianceStandard some sdg:ComplianceStandardKind, sdg:policyStatus some sdg:PolicyStatusKind, sdg:subjectMatter some sdg:SubjectMatterKind, sdg:governs some sdg:Worker, sdg:mandates some sdg:SafetyIncident

Class: sdg:ViolencePolicy
    Annotations: rdfs:label "Workplace Violence Policy", iao:0000115 "A formal organizational document establishing protocols for preventing, reporting, and responding to physical violence and threats in the workplace."
    SubClassOf: sdg:GovernmentPolicy, sdg:policyIdentifier some xsd:string, sdg:effectiveDate some xsd:date, sdg:issuingAuthorityDetail some xsd:string, sdg:complianceStandard some sdg:ComplianceStandardKind, sdg:policyStatus some sdg:PolicyStatusKind, sdg:scopeOfProtectionDetail some xsd:string, sdg:governs some sdg:Worker, sdg:mandates some sdg:SafetyIncident

Class: sdg:HOALot
    Annotations: rdfs:label "Homeowners Association Property Lot", iao:0000115 "A specific parcel of real property within the Mountain High HOA jurisdiction, subject to the Declarations and Restrictions."
    SubClassOf: bfo:0000004, sdg:lotIdentifier some xsd:string, sdg:legalDescription some xsd:string, sdg:county some xsd:string, sdg:parcelNumber some xsd:string, sdg:hasViolation some sdg:HOAViolation, sdg:hasAssessment some sdg:HOAAssessment

Class: sdg:HOAMember
    Annotations: rdfs:label "Homeowners Association Member", iao:0000115 "An individual or entity holding membership rights and obligations within the Mountain High HOA, typically the owner of an HOA_Lot."
    SubClassOf: bfo:0000002, sdg:memberIdentifier some xsd:string, sdg:votingRightsStatus some sdg:VotingRightsStatusKind, sdg:recreationalAccessStatus some xsd:string, sdg:contactEmail some xsd:string, sdg:ownsLot exactly 1 sdg:HOALot, sdg:isSubjectOf some sdg:HOAViolation

Class: sdg:HOAViolation
    Annotations: rdfs:label "Homeowners Association Rule Violation", iao:0000115 "An instance of non-compliance with the Mountain High HOA Declarations, Restrictions, Protective Covenants, or Rules and Regulations."
    SubClassOf: bfo:0000015, sdg:violationIdentifier some xsd:string, sdg:violationType some sdg:ViolationTypeKind, sdg:severityLevel some sdg:SeverityLevelKind, sdg:isContinuing some xsd:boolean, sdg:reportedDate some xsd:dateTime, sdg:resolutionStatus some sdg:ResolutionStatusKind, sdg:occursOnLot exactly 1 sdg:HOALot, sdg:attributedToMember exactly 1 sdg:HOAMember, sdg:triggersAssessment some sdg:HOAAssessment, sdg:triggersRemedy some sdg:HOARemedialAction

Class: sdg:HOAAssessment
    Annotations: rdfs:label "HOA Financial Assessment", iao:0000115 "A monetary charge levied against a specific HOA_Lot, including fines for violations, late charges, and abatement costs."
    SubClassOf: cco:ont00000995, sdg:assessmentIdentifier some xsd:string, sdg:assessmentType some xsd:string, sdg:amount some xsd:decimal, sdg:dueDate some xsd:date, sdg:paymentStatus some sdg:PaymentStatusKind, sdg:issuanceDate some xsd:date, sdg:leviedOnLot exactly 1 sdg:HOALot, sdg:derivedFromViolation exactly 1 sdg:HOAViolation, sdg:calculatedBy exactly 1 sdg:HOABoard

Class: sdg:HOARemedialAction
    Annotations: rdfs:label "HOA Remedial Action", iao:0000115 "A formal enforcement procedure undertaken by the Association to address a violation, including self-help abatement, fines, or legal proceedings."
    SubClassOf: bfo:0000015, sdg:actionIdentifier some xsd:string, sdg:actionType some xsd:string, sdg:initiationDate some xsd:dateTime, sdg:status some sdg:StatusKind, sdg:costIncurred some xsd:decimal, sdg:addressesViolation exactly 1 sdg:HOAViolation, sdg:targetsMember exactly 1 sdg:HOAMember, sdg:resultsInAssessment some sdg:HOAAssessment

Class: sdg:HOABoard
    Annotations: rdfs:label "Homeowners Association Board of Directors", iao:0000115 "The governing body of the Mountain High HOA authorized to enforce rules, impose fines, and manage remedial actions."
    SubClassOf: bfo:0000040, sdg:boardIdentifier some xsd:string, sdg:meetingDate some xsd:dateTime, sdg:quorumStatus some xsd:boolean, sdg:issuesAssessment some sdg:HOAAssessment, sdg:authorizesAction some sdg:HOARemedialAction

Class: sdg:HOAManagementCompany
    Annotations: rdfs:label "HOA Management Company", iao:0000115 "The external entity contracted to handle day-to-day operations, initial complaint intake, and conflict resolution for the HOA."
    SubClassOf: bfo:0000040, sdg:companyIdentifier some xsd:string, sdg:companyName some xsd:string, sdg:contractStartDate some xsd:date, sdg:handlesComplaint some sdg:HOAViolation, sdg:escalatesToBoard exactly 1 sdg:HOABoard

Class: sdg:CareAgency
    Annotations: rdfs:label "Domiciliary Care Agency", iao:0000115 "A registered provider organization that delivers domiciliary care services to individuals in their own homes."
    SubClassOf: sdg:HealthcareEntity, sdg:agencyId some xsd:string, sdg:agencyName some xsd:string, sdg:registeredAddress some xsd:string, sdg:contactTelephone some xsd:string, sdg:websiteUrl some xsd:string, sdg:registrationStatus some sdg:RegistrationStatusKind, sdg:lastInspectionDate some xsd:date, sdg:serviceDeliveryModeDetail some xsd:string, sdg:hasRegisteredManager exactly 1 sdg:RegisteredManager, sdg:conductedInspection some sdg:InspectionEvent, sdg:servesClient some sdg:CareRecipient

Class: sdg:StaffAssignment
    Annotations: rdfs:label "Staff Care Assignment", iao:0000115 "A scheduled or completed instance of a staff member providing care support to a specific recipient."
    SubClassOf: bfo:0000015, sdg:assignmentId some xsd:string, sdg:scheduledDateTime some xsd:dateTime, sdg:completedDateTime some xsd:dateTime, sdg:staffCountRequired some xsd:integer, sdg:assignmentStatus some xsd:string, sdg:assignedToRecipient exactly 1 sdg:CareRecipient, sdg:performedBy min 1 sdg:CareStaff, sdg:executesTask some sdg:CareTask

Class: sdg:CareTask
    Annotations: rdfs:label "Specific Care Activity", iao:0000115 "A discrete unit of care work, such as medication administration, meal preparation, or personal hygiene support."
    SubClassOf: bfo:0000015, sdg:taskId some xsd:string, sdg:taskDescription some xsd:string, sdg:taskCategory some xsd:string, sdg:requiresTwoStaff some xsd:boolean, sdg:partOfPlan some sdg:CarePlan, sdg:performedDuring some sdg:StaffAssignment

Class: sdg:CommunityProgram
    Annotations: rdfs:label "Community Program", iao:0000115 "A structured social intervention or service initiative designed to address a specific community need or disadvantage through defined activities and resources."
    SubClassOf: sdg:Program, sdg:programIdentifier some xsd:string, sdg:programName some xsd:string, sdg:startDate some xsd:dateTime, sdg:endDate some xsd:dateTime, sdg:status some sdg:StatusKind, sdg:scope some sdg:ScopeKind, sdg:targetAgeRange some xsd:string, sdg:totalParticipants some xsd:integer, sdg:programDurationYears some xsd:integer, sdg:primaryFocusArea some xsd:string, sdg:evidenceBasedStatus some xsd:string, sdg:hasLogicModel exactly 1 sdg:LogicModel, sdg:addressesNeed min 1 sdg:CommunityNeed, sdg:hasInput min 2 sdg:ProgramInput, sdg:undertakesActivity min 2 sdg:ProgramActivity, sdg:producesOutput min 2 sdg:ProgramOutput, sdg:achievesOutcome min 2 sdg:ProgramOutcome, sdg:deliveredBy exactly 1 sdg:NonprofitOrganization, sdg:evaluatedBy some sdg:ResearchInstitution, sdg:partOfCurriculum some sdg:EducationalCurriculum

Class: sdg:LogicModel
    Annotations: rdfs:label "Logic Model", iao:0000115 "A graphic representation or flow chart that explicitly defines the causal linkages, assumptions, and components of a community program from inputs to long-term impact."
    SubClassOf: bfo:0000040, sdg:modelIdentifier some xsd:string, sdg:layoutOrientation some xsd:string, sdg:creationDate some xsd:dateTime, sdg:isVerified some xsd:boolean, sdg:isExplicit some xsd:boolean, sdg:isMeaningful some xsd:boolean, sdg:describesProgram exactly 1 sdg:CommunityProgram, sdg:containsComponent min 1 sdg:ProgramInput, sdg:containsComponent min 1 sdg:ProgramActivity, sdg:containsComponent min 1 sdg:ProgramOutput, sdg:containsComponent min 1 sdg:ProgramOutcome, sdg:hasAssumption min 2 sdg:CausalAssumption

Class: sdg:CommunityNeed
    Annotations: rdfs:label "Community Need", iao:0000115 "A state of disadvantage, safety concern, or unmet requirement within a community that a program aims to address or change."
    SubClassOf: bfo:0000002, sdg:needIdentifier some xsd:string, sdg:needDescription some xsd:string, sdg:severityLevel some sdg:SeverityLevelKind, sdg:targetPopulationDetail some sdg:TargetPopulationKind, sdg:geographicScope some xsd:string, sdg:isAddressedBy min 1 sdg:CommunityProgram, sdg:isMeasuredBy min 1 sdg:ProgramOutcome

Class: sdg:ProgramInput
    Annotations: rdfs:label "Program Input", iao:0000115 "The resources, such as budgets, personnel, or materials, required to make a program possible and support its activities."
    SubClassOf: bfo:0000040, sdg:inputIdentifier some xsd:string, sdg:inputName some xsd:string, sdg:resourceType some sdg:ResourceTypeKind, sdg:quantity some xsd:integer, sdg:cost some xsd:decimal, sdg:acquisitionDate some xsd:dateTime, sdg:supportsProgram exactly 1 sdg:CommunityProgram, sdg:enablesActivity min 1 sdg:ProgramActivity

Class: sdg:ProgramActivity
    Annotations: rdfs:label "Program Activity", iao:0000115 "The specific tasks, actions, or interventions undertaken during the implementation of a program to achieve its goals."
    SubClassOf: bfo:0000015, sdg:activityIdentifier some xsd:string, sdg:activityName some sdg:ActivityNameKind, sdg:startDate some xsd:dateTime, sdg:endDate some xsd:dateTime, sdg:frequency some sdg:FrequencyKind, sdg:duration some xsd:decimal, sdg:isPartOfProgram exactly 1 sdg:CommunityProgram, sdg:usesInput min 1 sdg:ProgramInput, sdg:producesOutput min 1 sdg:ProgramOutput, sdg:influencesOutcome min 1 sdg:ProgramOutcome

Class: sdg:ProgramOutput
    Annotations: rdfs:label "Program Output", iao:0000115 "The direct results of program activities, including the amount of services provided, products produced, or number of clients reached."
    SubClassOf: bfo:0000040, sdg:outputIdentifier some xsd:string, sdg:outputName some xsd:string, sdg:outputType some xsd:string, sdg:value some xsd:decimal, sdg:measurementDate some xsd:dateTime, sdg:targetValue some xsd:decimal, sdg:resultsFromActivity exactly 1 sdg:ProgramActivity, sdg:contributesToOutcome min 1 sdg:ProgramOutcome

Class: sdg:ProgramOutcome
    Annotations: rdfs:label "Program Outcome", iao:0000115 "The changes that occur at an individual, group, or community level as a result of program activities and outputs, categorized by time horizon."
    SubClassOf: bfo:0000015, sdg:outcomeIdentifier some xsd:string, sdg:outcomeDescription some xsd:string, sdg:timeHorizon some sdg:TimeHorizonKind, sdg:changeDirection some xsd:string, sdg:targetLevel some xsd:string, sdg:measurableValue some xsd:decimal, sdg:measurementDate some xsd:dateTime, sdg:isAchievedByProgram exactly 1 sdg:CommunityProgram, sdg:isDrivenByOutput min 1 sdg:ProgramOutput, sdg:addressesNeed min 1 sdg:CommunityNeed

Class: sdg:CausalAssumption
    Annotations: rdfs:label "Causal Assumption", iao:0000115 "An explicit statement of the assumed causal linkage or influence between program components (e.g., how an activity leads to an output or outcome)."
    SubClassOf: bfo:0000016, sdg:assumptionIdentifier some xsd:string, sdg:assumptionText some xsd:string, sdg:confidenceLevel some sdg:ConfidenceLevelKind, sdg:isVerified some xsd:boolean, sdg:linksSourceComponent min 1 sdg:ProgramInput, sdg:linksTargetComponent min 1 sdg:ProgramActivity

Class: sdg:LegislativeBody
    Annotations: rdfs:label "Legislative Body", iao:0000115 "A governmental assembly empowered to enact, amend, or repeal statutes within a defined jurisdiction."
    SubClassOf: bfo:0000015, sdg:bodyName some xsd:string, sdg:jurisdictionName some xsd:string, sdg:sessionYear some xsd:integer, sdg:status some sdg:StatusKind, sdg:enacts some sdg:LegislativeAct

Class: sdg:StatutoryAmendment
    Annotations: rdfs:label "Statutory Amendment", iao:0000115 "A specific legislative action that modifies the text, numbers, or clauses of an existing statute."
    SubClassOf: sdg:LegalEntity, sdg:amendmentId some xsd:string, sdg:targetSection some xsd:string, sdg:targetClause some xsd:string, sdg:originalValue some xsd:string, sdg:substitutedValue some xsd:string, sdg:amendmentType some sdg:AmendmentTypeKind, sdg:appliesTo exactly 1 sdg:LegislativeAct, sdg:executedBy exactly 1 sdg:LegislativeBody

Class: sdg:GovernmentOfficial
    Annotations: rdfs:label "Government Official", iao:0000115 "A person holding a designated public office responsible for certifying or promulgating legislative instruments."
    SubClassOf: bfo:0000023, sdg:officialName some xsd:string, sdg:designation some xsd:string, sdg:department some xsd:string, sdg:certificationDate some xsd:date, sdg:status some sdg:StatusKind, sdg:certifies some sdg:LegislativeAct, sdg:holdsRoleIn exactly 1 sdg:LegislativeBody

Class: sdg:ApprenticeshipScheme
    Annotations: rdfs:label "Apprenticeship Scheme", iao:0000115 "A structured training program combining workplace experience with formal education, designed to develop specific occupational skills."
    SubClassOf: sdg:EducationalEntity, sdg:schemeId some xsd:string, sdg:level some sdg:LevelKind, sdg:sector some sdg:SectorKind, sdg:durationMonths some xsd:integer, sdg:status some sdg:StatusKind, sdg:frameworkId some xsd:string, sdg:hasFramework exactly 1 sdg:TrainingFramework, sdg:targetsSector some sdg:EconomicSector, sdg:fundedBy some sdg:FundingInstrument

Class: sdg:TrainingFramework
    Annotations: rdfs:label "Training Framework", iao:0000115 "A standardized set of requirements and curricula defining the competencies and qualifications for a specific apprenticeship level."
    SubClassOf: sdg:EducationalEntity, sdg:frameworkId some xsd:string, sdg:title some xsd:string, sdg:version some xsd:string, sdg:lastUpdated some xsd:dateTime, sdg:competencyCount some xsd:integer, sdg:definesLevel some sdg:ApprenticeshipScheme, sdg:mapsToQualification some sdg:Qualification

Class: sdg:EconomicSector
    Annotations: rdfs:label "Economic Sector", iao:0000115 "A distinct branch of the economy characterized by similar products, services, or production processes."
    SubClassOf: bfo:0000040, sdg:sectorCode some xsd:string, sdg:sectorName some xsd:string, sdg:skillShortageLevel some xsd:string, sdg:apprenticeshipCapacity some xsd:integer, sdg:hostsApprenticeships some sdg:ApprenticeshipScheme, sdg:experiencesShortage some sdg:SkillGap

Class: sdg:ApprenticeshipParticipant
    Annotations: rdfs:label "Apprenticeship Participant", iao:0000115 "An individual enrolled in an apprenticeship program, either as a new entrant or an existing employee reclassified."
    SubClassOf: bfo:0000004, sdg:participantId some xsd:string, sdg:age some xsd:integer, sdg:employmentStatus some sdg:EmploymentStatusKind, sdg:gender some sdg:GenderKind, sdg:startDate some xsd:dateTime, sdg:completionStatus some sdg:CompletionStatusKind, sdg:enrolledIn exactly 1 sdg:ApprenticeshipScheme, sdg:employedBy some sdg:Employer, sdg:achievesQualification some sdg:Qualification

Class: sdg:Employer
    Annotations: rdfs:label "Employer", iao:0000115 "An organization that hires individuals for apprenticeship programs and provides workplace training."
    SubClassOf: bfo:0000040, sdg:employerId some xsd:string, sdg:name some sdg:NameKind, sdg:sector some sdg:SectorKind, sdg:totalWorkforce some xsd:integer, sdg:apprenticeCount some xsd:integer, sdg:reclassificationRate some xsd:decimal, sdg:offersApprenticeships some sdg:ApprenticeshipScheme, sdg:hiresParticipants some sdg:ApprenticeshipParticipant, sdg:receivesFunding some sdg:FundingInstrument

Class: sdg:FundingInstrument
    Annotations: rdfs:label "Funding Instrument", iao:0000115 "A financial mechanism or policy tool used to subsidize or pay for apprenticeship training and related costs."
    SubClassOf: sdg:FinancialEntity, sdg:instrumentId some xsd:string, sdg:type some sdg:TypeKind, sdg:amount some xsd:decimal, sdg:currency some xsd:string, sdg:eligibilityCriteria some xsd:string, sdg:effectiveDate some xsd:date, sdg:instrumentType some sdg:InstrumentTypeKind, sdg:supportsApprenticeships some sdg:ApprenticeshipScheme, sdg:receivedBy some sdg:Employer, sdg:coversParticipant some sdg:ApprenticeshipParticipant

Class: sdg:SkillGap
    Annotations: rdfs:label "Skill Gap", iao:0000115 "A discrepancy between the skills possessed by the workforce and the skills required by employers in a specific sector or occupation."
    SubClassOf: bfo:0000015, sdg:gapId some xsd:string, sdg:sector some sdg:SectorKind, sdg:occupation some xsd:string, sdg:severity some sdg:SeverityKind, sdg:estimatedShortage some xsd:integer, sdg:reportedDate some xsd:dateTime, sdg:affectsSector exactly 1 sdg:EconomicSector, sdg:addressedByApprenticeships some sdg:ApprenticeshipScheme, sdg:linkedToQualification some sdg:Qualification

Class: sdg:ClimateObservation
    Annotations: rdfs:label "Climate Observation", iao:0000115 "A measurement or recorded instance of a climatic or oceanographic variable at a specific location and time."
    SubClassOf: bfo:0000015, sdg:observationId some xsd:string, sdg:recordedAtDetail some xsd:dateTime, sdg:variableType some xsd:string, sdg:value some xsd:decimal, sdg:unit some sdg:UnitKind, sdg:status some sdg:StatusKind, sdg:recordedIn exactly 1 sdg:SpatialZone, sdg:measuredBy some sdg:FishermanReport

Class: sdg:SpatialZone
    Annotations: rdfs:label "Spatial Zone", iao:0000115 "A geographically defined area, such as a coastal region or state, subject to environmental monitoring."
    SubClassOf: sdg:GeographicEntity, sdg:zoneId some xsd:string, sdg:zoneName some xsd:string, sdg:region some sdg:RegionKind, sdg:country some sdg:CountryKind, sdg:zoneType some sdg:ZoneTypeKind, sdg:containsObservation min 2 sdg:ClimateObservation, sdg:containsFisherman min 2 sdg:Fisherman

Class: sdg:Fisherman
    Annotations: rdfs:label "Fisherman", iao:0000115 "A registered individual engaged in fishing activities within a specific coastal zone."
    SubClassOf: bfo:0000004, sdg:fishermanId some xsd:string, sdg:name some sdg:NameKind, sdg:registrationNumber some xsd:string, sdg:state some xsd:string, sdg:yearsOfExperience some xsd:integer, sdg:status some sdg:StatusKind, sdg:residesIn exactly 1 sdg:SpatialZone, sdg:providesReport min 2 sdg:FishermanReport

Class: sdg:FishermanReport
    Annotations: rdfs:label "Fisherman Report", iao:0000115 "A structured record of a fisherman's observations and perceptions regarding environmental changes."
    SubClassOf: cco:ont00000995, sdg:reportId some xsd:string, sdg:submissionDate some xsd:dateTime, sdg:surveyMethod some xsd:string, sdg:responseCount some xsd:integer, sdg:dataQuality some xsd:string, sdg:submittedBy exactly 1 sdg:Fisherman, sdg:coversZone exactly 1 sdg:SpatialZone, sdg:includesObservation min 2 sdg:ClimateObservation
    HasKey: sdg:reportId

Class: sdg:ExecutiveAppointment
    Annotations: rdfs:label "Executive Appointment", iao:0000115 "A temporal role assignment event where an individual assumes a specific executive position within an organization."
    SubClassOf: bfo:0000015, sdg:appointmentDate some xsd:date, sdg:startDate some xsd:dateTime, sdg:endDate some xsd:dateTime, sdg:appointmentStatus some sdg:AppointmentStatusKind, sdg:appointmentIdentifier some xsd:string, sdg:heldBy exactly 1 sdg:ExecutivePerson, sdg:heldAt exactly 1 sdg:CorporateEntity, sdg:occupiesRole exactly 1 sdg:ExecutiveRole

Class: sdg:ExecutivePerson
    Annotations: rdfs:label "Executive Person", iao:0000115 "A human individual who holds or has held executive leadership positions within corporate entities."
    SubClassOf: bfo:0000040, sdg:personIdentifier some xsd:string, sdg:fullName some xsd:string, sdg:professionalTitle some xsd:string, sdg:certificationStatus some sdg:CertificationStatusKind, sdg:certificationBody some xsd:string, sdg:holdsAppointment some sdg:ExecutiveAppointment, sdg:affiliatedWith some sdg:CorporateEntity

Class: sdg:EvacuationZone
    Annotations: rdfs:label "Evacuation Zone", iao:0000115 "A defined geographic area or land parcel designated by authorities for evacuation based on proximity to a hazard or specific risk criteria."
    SubClassOf: cco:ont00000995, sdg:zoneIdentifier some xsd:string, sdg:zoneName some xsd:string, sdg:riskCategory some sdg:RiskCategoryKind, sdg:estimatedResidentCount some xsd:integer, sdg:zoneBoundaryCoordinates some xsd:string, sdg:isCoastal some xsd:boolean, sdg:subjectToOrder some sdg:EvacuationOrder, sdg:containsProperty min 3 sdg:Property, sdg:connectedToRoute min 2 sdg:EvacuationRoute

Class: sdg:Property
    Annotations: rdfs:label "Property", iao:0000115 "A specific residential, commercial, or institutional building and its immediate land parcel that is subject to evacuation orders."
    SubClassOf: cco:ont00000995, sdg:propertyIdentifier some xsd:string, sdg:address some xsd:string, sdg:propertyType some sdg:PropertyTypeKind, sdg:occupancyStatus some sdg:OccupancyStatusKind, sdg:hasVehicleAccess some xsd:boolean, sdg:floodingRisk some xsd:boolean, sdg:locatedInZone exactly 1 sdg:EvacuationZone, sdg:occupiedBy exactly 1 sdg:Household, sdg:usesRoute some sdg:EvacuationRoute

Class: sdg:Shelter
    Annotations: rdfs:label "Shelter", iao:0000115 "A designated safe location or facility where evacuees are directed to go to avoid the immediate threat of a hazard."
    SubClassOf: cco:ont00000995, sdg:shelterIdentifier some xsd:string, sdg:shelterName some xsd:string, sdg:shelterType some sdg:ShelterTypeKind, sdg:currentOccupancy some xsd:integer, sdg:maxCapacity some xsd:integer, sdg:operationalStatus some sdg:OperationalStatusKind, sdg:receivesFromRoute min 2 sdg:EvacuationRoute, sdg:accommodatesHouseholds min 3 sdg:Household, sdg:locatedInSafeZone exactly 1 sdg:GeographicZone

Class: sdg:WarningChannel
    Annotations: rdfs:label "Warning Channel", iao:0000115 "A method or medium used by authorities to disseminate evacuation instructions and hazard information to the public."
    SubClassOf: cco:ont00000995, sdg:channelIdentifier some xsd:string, sdg:channelName some xsd:string, sdg:channelType some sdg:ChannelTypeKind, sdg:powerDependency some xsd:boolean, sdg:coverageArea some xsd:string, sdg:isReliableDuringOutage some xsd:boolean, sdg:broadcastsOrder some sdg:EvacuationOrder, sdg:monitoredBy some sdg:Household

Class: sdg:ParticipantPriorKnowledge
    Annotations: rdfs:label "Participant Prior Knowledge", iao:0000115 "The existing knowledge, experiences, and reference points a participant brings to a workshop session."
    SubClassOf: cco:ont00000995, sdg:knowledgeId some xsd:string, sdg:topicArea some xsd:string, sdg:proficiencyLevel some sdg:ProficiencyLevelKind, sdg:sourceExperience some xsd:string, sdg:lastUpdated some xsd:dateTime, sdg:belongsTo exactly 1 sdg:Participant, sdg:isConnectedTo min 1 sdg:LearningModule

Class: sdg:ResearchExecutive
    Annotations: rdfs:label "Research Executive Officer", iao:0000115 "A person holding a specific administrative or academic role responsible for research management or technology transfer."
    SubClassOf: sdg:ResearchEntity, sdg:executiveIdentifier some xsd:string, sdg:fullLegalName some xsd:string, sdg:appointmentDate some xsd:date, sdg:departmentCode some xsd:string, sdg:holdsRoleIn some sdg:ResearchCommittee, sdg:leads some sdg:ResearchLaboratory
    HasKey: sdg:departmentCode

Class: sdg:DDoSAttack
    Annotations: rdfs:label "Distributed Denial of Service Attack", iao:0000115 "A malicious attempt to disrupt normal traffic of a targeted network, service, or server by overwhelming the target or its surrounding infrastructure with a flood of Internet traffic."
    SubClassOf: bfo:0000015, sdg:attackId some xsd:string, sdg:attackType some xsd:string, sdg:layer some xsd:integer, sdg:peakBandwidth some xsd:decimal, sdg:startDateTime some xsd:dateTime, sdg:endDateTime some xsd:dateTime, sdg:isMitigated some xsd:boolean, sdg:targets some sdg:NetworkService, sdg:detectedBy some sdg:FortiDDoSAppliance
    HasKey: sdg:attackId

Class: sdg:FortiDDoSAppliance
    Annotations: rdfs:label "FortiDDoS On-Premise Mitigation Appliance", iao:0000115 "A purpose-built hardware or virtualized appliance deployed on-premise to detect and mitigate DDoS attacks in real-time using sophisticated filtering technologies."
    SubClassOf: cco:ont00000995, sdg:applianceId some xsd:string, sdg:model some xsd:string, sdg:firmwareVersion some xsd:string, sdg:deploymentLocation some xsd:string, sdg:maxThroughputGbps some xsd:decimal, sdg:isAlwaysOn some xsd:boolean, sdg:lastHealthCheck some xsd:dateTime, sdg:monitors some sdg:NetworkService, sdg:sendsAlertTo exactly 1 sdg:VerisignDDoSService, sdg:generatesAlertFor some sdg:DDoSAttack

Class: sdg:VerisignDDoSService
    Annotations: rdfs:label "Verisign DDoS Protection Cloud Service", iao:0000115 "A cloud-based, scalable DDoS protection service that provides on-demand mitigation, traffic scrubbing, and expert analysis for attacks exceeding on-premise capacity."
    SubClassOf: cco:ont00000995, sdg:serviceId some xsd:string, sdg:platformName some xsd:string, sdg:apiEndpoint some xsd:string, sdg:supportLevel some xsd:string, sdg:isActive some xsd:boolean, sdg:lastUpdated some xsd:dateTime, sdg:integratesWith some sdg:FortiDDoSAppliance, sdg:usesPlatform exactly 1 sdg:AthenaPlatform, sdg:providesMitigationFor some sdg:DDoSAttack

Class: sdg:AthenaPlatform
    Annotations: rdfs:label "Verisign Athena Scrubbing Platform", iao:0000115 "Verisign's globally distributed, purpose-built proprietary platform used to protect against volumetric and complex application layer attacks through traffic redirection and scrubbing."
    SubClassOf: cco:ont00000995, sdg:platformId some xsd:string, sdg:region some sdg:RegionKind, sdg:capacityTbps some xsd:decimal, sdg:isOperational some xsd:boolean, sdg:lastMaintenance some xsd:date, sdg:hostsScrubbingCenter some sdg:ScrubbingCenter
    HasKey: sdg:platformId

Class: sdg:ScrubbingCenter
    Annotations: rdfs:label "Traffic Scrubbing Center", iao:0000115 "A physical or logical facility where malicious traffic is filtered and clean traffic is returned to the customer's network during a DDoS event."
    SubClassOf: bfo:0000015, sdg:centerId some xsd:string, sdg:location some xsd:string, sdg:currentLoadPercent some xsd:decimal, sdg:isAcceptingTraffic some xsd:boolean, sdg:lastTrafficRedirect some xsd:dateTime, sdg:processesTrafficFor some sdg:DDoSAttack, sdg:belongsTo exactly 1 sdg:AthenaPlatform
    HasKey: sdg:centerId

Class: sdg:MitigationAlert
    Annotations: rdfs:label "DDoS Mitigation Alert", iao:0000115 "A signal generated by the on-premise appliance when attack thresholds are exceeded, triggering evaluation and potential traffic redirection by the cloud service."
    SubClassOf: cco:ont00000995, sdg:alertId some xsd:string, sdg:severity some sdg:SeverityKind, sdg:thresholdExceeded some xsd:decimal, sdg:generatedDateTime some xsd:dateTime, sdg:isAcknowledged some xsd:boolean, sdg:status some sdg:StatusKind, sdg:generatedBy exactly 1 sdg:FortiDDoSAppliance, sdg:receivedBy exactly 1 sdg:VerisignDDoSService, sdg:relatesToAttack exactly 1 sdg:DDoSAttack

Class: sdg:MarketStructure
    Annotations: rdfs:label "Market Structure", iao:0000115 "A classification of market conditions based on the degree of competition and number of firms, such as perfect competition, monopoly, oligopoly, or monopolistic competition."
    SubClassOf: bfo:0000040, sdg:structureType some sdg:StructureTypeKind, sdg:numberOfFirms some xsd:integer, sdg:barrierToEntry some xsd:string, sdg:priceControl some xsd:boolean, sdg:productDifferentiation some sdg:ProductDifferentiationKind, sdg:hosts some sdg:BusinessEntity, sdg:influencedBy some sdg:GovernmentPolicy

Class: sdg:GovernmentPolicy
    Annotations: rdfs:label "Government Policy", iao:0000115 "A formal measure or regulation implemented by a state to support, regulate, or influence business activities and market conditions."
    SubClassOf: bfo:0000040, sdg:policyId some xsd:string, sdg:policyType some sdg:PolicyTypeKind, sdg:issuingAuthorityDetail some xsd:string, sdg:effectiveDate some xsd:date, sdg:expirationDate some xsd:date, sdg:targetSector some xsd:string, sdg:appliesTo some sdg:BusinessEntity, sdg:implementedBy exactly 1 sdg:Jurisdiction, sdg:supports some sdg:InnovativeBusiness
    HasKey: sdg:policyId

Class: sdg:InnovativeBusiness
    Annotations: rdfs:label "Innovative Business", iao:0000115 "A business entity characterized by the development and application of new technologies, products, or processes to gain competitive advantage."
    SubClassOf: bfo:0000040, sdg:innovationType some sdg:InnovationTypeKind, sdg:patentCount some xsd:integer, sdg:rAndDInvestment some xsd:decimal, sdg:marketShare some xsd:decimal, sdg:growthRate some xsd:decimal, sdg:isTypeOf exactly 1 sdg:BusinessEntity, sdg:utilizes some sdg:IntellectualProperty, sdg:receivesSupportFrom some sdg:GovernmentPolicy

Class: sdg:IntellectualProperty
    Annotations: rdfs:label "Intellectual Property", iao:0000115 "A creation of the mind, such as an invention, literary or artistic work, design, symbol, name, or image, used in commerce."
    SubClassOf: bfo:0000040, sdg:ipId some xsd:string, sdg:ipType some xsd:string, sdg:registrationDate some xsd:dateTime, sdg:expirationDate some xsd:date, sdg:owner some xsd:string, sdg:jurisdiction some sdg:JurisdictionKind, sdg:ownedBy exactly 1 sdg:BusinessEntity, sdg:protectedUnder exactly 1 sdg:Jurisdiction

Class: sdg:FinancialStatement
    Annotations: rdfs:label "Financial Statement", iao:0000115 "A formal record of the financial activities and position of a business entity, such as an income statement, balance sheet, or cash flow statement."
    SubClassOf: bfo:0000040, sdg:statementId some xsd:string, sdg:statementType some xsd:string, sdg:reportingPeriod some xsd:date, sdg:totalRevenue some xsd:decimal, sdg:totalExpenses some xsd:decimal, sdg:netIncome some xsd:decimal, sdg:preparedByDetail some xsd:string, sdg:auditStatus some sdg:AuditStatusKind, sdg:belongsToMany exactly 1 sdg:BusinessEntity, sdg:auditedBy max 1 sdg:Auditor
    HasKey: sdg:statementId

Class: sdg:UnderlyingFund
    Annotations: rdfs:label "Underlying Investment Fund", iao:0000115 "A specialist investment fund managed by external managers that holds the actual assets and is held by the parent fund of funds."
    SubClassOf: cco:ont00000995, sdg:underlyingFundIdentifier some xsd:string, sdg:underlyingFundName some xsd:string, sdg:managementFeeWaived some xsd:boolean, sdg:performanceFeeWaived some xsd:boolean, sdg:investmentStrategy some xsd:string, sdg:geographicFocus some xsd:string, sdg:assetClass some xsd:string, sdg:managerName some xsd:string, sdg:heldByFund exactly 1 sdg:Fund, sdg:investsInAssets min 2 sdg:Asset, sdg:measuredByBenchmark exactly 1 sdg:BenchmarkIndex, sdg:reportsPerformance min 2 sdg:PerformanceReport

Class: sdg:BenchmarkIndex
    Annotations: rdfs:label "Composite Benchmark Index", iao:0000115 "A statistical measure of market performance used as a standard for evaluating the success of the investment fund."
    SubClassOf: cco:ont00000995, sdg:indexName some xsd:string, sdg:indexTicker some xsd:string, sdg:indexType some xsd:string, sdg:currency some xsd:string, sdg:rebalancingFrequency some xsd:string, sdg:weightingScheme some xsd:string, sdg:numberOfComponents some xsd:integer, sdg:isHedged some xsd:boolean, sdg:tracksAsset min 2 sdg:Asset, sdg:usedByFund exactly 1 sdg:Fund, sdg:usedByUnderlyingFund some sdg:UnderlyingFund

Class: sdg:Asset
    Annotations: rdfs:label "Financial Asset", iao:0000115 "A financial instrument or security held within the investment portfolio that generates returns."
    SubClassOf: bfo:0000040, sdg:assetIdentifier some xsd:string, sdg:assetName some xsd:string, sdg:assetType some sdg:AssetTypeKind, sdg:marketCap some xsd:decimal, sdg:sector some sdg:SectorKind, sdg:countryOfIncorporation some xsd:string, sdg:currencyDenomination some xsd:string, sdg:isEquity some xsd:boolean, sdg:isFixedIncome some xsd:boolean, sdg:heldInUnderlyingFund some sdg:UnderlyingFund, sdg:constitutesBenchmark some sdg:BenchmarkIndex

Class: sdg:FundManager
    Annotations: rdfs:label "Investment Fund Manager", iao:0000115 "An entity or individual responsible for managing the investment strategy and operations of an underlying fund."
    SubClassOf: bfo:0000040, sdg:managerIdentifier some xsd:string, sdg:managerName some xsd:string, sdg:regulatoryLicense some xsd:string, sdg:managementFeeWaived some xsd:boolean, sdg:performanceFeeWaived some xsd:boolean, sdg:headquartersCountry some xsd:string, sdg:totalAUM some xsd:decimal, sdg:yearsInOperation some xsd:integer, sdg:managesUnderlyingFund min 2 sdg:UnderlyingFund, sdg:generatesPerformanceReport min 2 sdg:PerformanceReport, sdg:selectsAssets min 2 sdg:Asset, sdg:conductsMeetings min 2 sdg:CorporateMeeting

Class: sdg:CharitableCause
    Annotations: rdfs:label "Charitable Cause", iao:0000115 "A non-profit organization or specific cause that receives financial donations from the fund's management and performance fees."
    SubClassOf: bfo:0000040, sdg:causeIdentifier some xsd:string, sdg:causeName some xsd:string, sdg:causeCategory some xsd:string, sdg:totalDonationsReceived some xsd:decimal, sdg:donationFrequency some xsd:string, sdg:nextDonationDate some xsd:date, sdg:taxExemptStatus some xsd:string, sdg:geographicFocus some xsd:string, sdg:receivesDonationsFromFund exactly 1 sdg:Fund, sdg:receivesDonationsFromUnderlyingFund some sdg:UnderlyingFund, sdg:supportsCommunity some sdg:Community

Class: sdg:CorporateMeeting
    Annotations: rdfs:label "Corporate Engagement Meeting", iao:0000115 "A scheduled interaction between fund managers and company management, boards, or industry experts to gather investment insights."
    SubClassOf: bfo:0000015, sdg:meetingIdentifier some xsd:string, sdg:meetingDate some xsd:dateTime, sdg:meetingType some sdg:MeetingTypeKind, sdg:participantsCount some xsd:integer, sdg:meetingOutcome some xsd:string, sdg:isConfidential some xsd:boolean, sdg:meetingDurationMinutes some xsd:integer, sdg:location some xsd:string, sdg:organizedByManager exactly 1 sdg:FundManager, sdg:involvesCompany exactly 1 sdg:Asset

Class: sdg:ParticipatingOrganization
    Annotations: rdfs:label "Participating Organization", iao:0000115 "A legal or informal entity such as a Farmers' Producer Organization, Company, Interest Group, or Farmers' Club that applies to participate in the Sufal Bangla Project for the Ahare Bangla Food Festival."
    SubClassOf: cco:ont00000995, sdg:organizationId some xsd:string, sdg:legalName some xsd:string, sdg:organizationType some sdg:OrganizationTypeKind, sdg:registrationDate some xsd:dateTime, sdg:contactPerson some xsd:string, sdg:contactPhone some xsd:string, sdg:contactEmail some xsd:string, sdg:enrollmentStatus some sdg:EnrollmentStatusKind, sdg:organizationName some xsd:string, sdg:contactPersonName some xsd:string, sdg:streetAddress some xsd:string, sdg:city some xsd:string, sdg:state some xsd:string, sdg:zipCode some xsd:string, sdg:authorizationSignature some xsd:string, sdg:submissionStatus some sdg:SubmissionStatusKind, sdg:submitsApplicationFor exactly 1 sdg:FestivalEnrollment, sdg:displaysProductsAt some sdg:FestivalStall, sdg:submitsEntry exactly 1 sdg:ParadeEntry, sdg:designatesDriver exactly 1 sdg:VehicleOperator

Class: sdg:FestivalEnrollment
    Annotations: rdfs:label "Festival Enrollment", iao:0000115 "The formal application record submitted by a participating organization to enroll in the Sufal Bangla Project for a specific agricultural food festival."
    SubClassOf: cco:ont00000995, sdg:enrollmentId some xsd:string, sdg:submissionDate some xsd:dateTime, sdg:festivalName some xsd:string, sdg:festivalStartDate some xsd:date, sdg:festivalEndDate some xsd:date, sdg:venueName some xsd:string, sdg:venueCity some xsd:string, sdg:evaluationOutcome some sdg:EvaluationOutcomeKind, sdg:isSubmittedBy exactly 1 sdg:ParticipatingOrganization, sdg:isEvaluatedBy some sdg:QualityAssessment, sdg:grantsAccessTo max 1 sdg:FestivalStall

Class: sdg:QualityAssessment
    Annotations: rdfs:label "Quality Assessment", iao:0000115 "The measurement and evaluation process conducted to determine the quality and standard of products submitted by a participating organization for festival enrollment."
    SubClassOf: sdg:AssessmentTool, sdg:assessmentId some xsd:string, sdg:assessmentDate some xsd:dateTime, sdg:qualityScore some xsd:decimal, sdg:standardCompliance some xsd:boolean, sdg:assessorName some xsd:string, sdg:assessmentMethod some sdg:AssessmentMethodKind, sdg:assessmentPurpose some xsd:string, sdg:evaluatesProductsOf exactly 1 sdg:FestivalEnrollment, sdg:performedBy exactly 1 sdg:ProjectDirector

Class: sdg:FestivalStall
    Annotations: rdfs:label "Festival Stall", iao:0000115 "A designated physical space or booth at the Ahare Bangla Food Festival where participating organizations display and sell their agricultural products."
    SubClassOf: bfo:0000023, sdg:stallId some xsd:string, sdg:stallLocationCode some xsd:string, sdg:stallSize some xsd:decimal, sdg:stallStatus some xsd:string, sdg:utilityAccess some xsd:boolean, sdg:isAssignedTo max 1 sdg:FestivalEnrollment, sdg:hostsProductsFrom min 2 sdg:AgriculturalProduct

Class: sdg:AgriculturalProduct
    Annotations: rdfs:label "Agricultural Product", iao:0000115 "A tangible agricultural produce or processed product offered for display and sale by a participating organization at the festival."
    SubClassOf: cco:ont00000995, sdg:productId some xsd:string, sdg:productName some xsd:string, sdg:productCategory some xsd:string, sdg:weight some xsd:decimal, sdg:unitOfMeasure some sdg:UnitOfMeasureKind, sdg:price some xsd:decimal, sdg:expiryDate some xsd:date, sdg:isOfferedBy min 2 sdg:FestivalStall, sdg:isProducedBy some sdg:ParticipatingOrganization

Class: sdg:ProjectDirector
    Annotations: rdfs:label "Project Director", iao:0000115 "The official role held by the individual responsible for managing the Sufal Bangla Project and overseeing the evaluation and enrollment process for the festival."
    SubClassOf: bfo:0000023, sdg:directorId some xsd:string, sdg:fullName some xsd:string, sdg:officeLocation some xsd:string, sdg:officeAddress some xsd:string, sdg:officeCity some xsd:string, sdg:officePincode some xsd:string, sdg:oversees some sdg:QualityAssessment, sdg:manages some sdg:FestivalEnrollment

Class: sdg:ResearchDesk
    Annotations: rdfs:label "Research Desk", iao:0000115 "A rapid-response research activity conducted by a knowledge management centre to support policy development and project implementation for international development agencies."
    SubClassOf: sdg:ResearchEntity, sdg:deskIdentifier some xsd:string, sdg:agencyFundedBy some xsd:string, sdg:startDate some xsd:dateTime, sdg:endDate some xsd:dateTime, sdg:status some sdg:StatusKind, sdg:responseType some xsd:string, sdg:outputType some xsd:string, sdg:conductedBy exactly 1 sdg:ProjectManager, sdg:fundedBy exactly 1 sdg:DevelopmentAgency, sdg:produces some sdg:ResearchOutput

Class: sdg:DevelopmentAgency
    Annotations: rdfs:label "Development Agency", iao:0000115 "An international organization or governmental body that commissions rapid-response research to support policy development and project implementation in international development."
    SubClassOf: bfo:0000040, sdg:agencyCode some xsd:string, sdg:agencyName some xsd:string, sdg:countryOfOrigin some xsd:string, sdg:fundingProgram some xsd:string, sdg:establishedYear some xsd:integer, sdg:commissions some sdg:ResearchDesk, sdg:funds some sdg:ResearchDesk

Class: sdg:PersonWithAlbinism
    Annotations: rdfs:label "Person with Albinism", iao:0000115 "A human individual who has albinism, characterized by low vision and reduced skin pigmentation."
    SubClassOf: bfo:0000040, sdg:personId some xsd:string, sdg:name some sdg:NameKind, sdg:dateOfBirth some xsd:date, sdg:visionLevel some sdg:VisionLevelKind, sdg:skinSensitivity some xsd:string, sdg:currentLocation some xsd:string, sdg:enrolledInProgram some xsd:boolean, sdg:enrolledIn some sdg:EducationProgram, sdg:experiencesStigmaFrom some sdg:SocialStigma, sdg:requiresAccommodation some sdg:EnvironmentalAccommodation
    HasKey: sdg:personId

Class: sdg:EducationProgram
    Annotations: rdfs:label "Inclusive Education Program", iao:0000115 "A structured educational initiative designed to integrate persons with albinism into mainstream schooling while providing necessary support."
    SubClassOf: sdg:Program, sdg:programId some xsd:string, sdg:programName some xsd:string, sdg:startDate some xsd:dateTime, sdg:endDate some xsd:dateTime, sdg:status some sdg:StatusKind, sdg:targetDemographic some xsd:string, sdg:fundingSource some sdg:FundingSourceKind, sdg:deliversTo min 2 sdg:PersonWithAlbinism, sdg:operatesIn some sdg:MainstreamSchool, sdg:providesAccommodation some sdg:EnvironmentalAccommodation, sdg:targetPopulation some sdg:PersonWithAlbinism

Class: sdg:MainstreamSchool
    Annotations: rdfs:label "Mainstream Educational Institution", iao:0000115 "A standard educational facility that integrates students with albinism into general education without segregation."
    SubClassOf: bfo:0000040, sdg:schoolId some xsd:string, sdg:schoolName some xsd:string, sdg:location some xsd:string, sdg:academicStandard some sdg:AcademicStandardKind, sdg:enrollmentCapacity some xsd:integer, sdg:hasInclusivePolicy some xsd:boolean, sdg:lastInspectionDate some xsd:date, sdg:hostsStudents min 2 sdg:PersonWithAlbinism, sdg:implementsAccommodation some sdg:EnvironmentalAccommodation, sdg:reducesStigmaFor some sdg:SocialStigma

Class: sdg:EnvironmentalAccommodation
    Annotations: rdfs:label "Environmental Accommodation", iao:0000115 "Physical or procedural adjustments made to support persons with albinism, such as lighting control or seating arrangements."
    SubClassOf: bfo:0000040, sdg:accommodationId some xsd:string, sdg:accommodationType some sdg:AccommodationTypeKind, sdg:implementationDate some xsd:dateTime, sdg:effectivenessRating some sdg:EffectivenessRatingKind, sdg:status some sdg:StatusKind, sdg:description some xsd:string, sdg:providedAt some sdg:MainstreamSchool, sdg:benefits min 2 sdg:PersonWithAlbinism, sdg:supports some sdg:EducationProgram

Class: sdg:SocialStigma
    Annotations: rdfs:label "Social Stigma Against Albinism", iao:0000115 "Negative social attitudes, discrimination, and isolation experienced by persons with albinism due to misconceptions and myths."
    SubClassOf: bfo:0000040, sdg:stigmaId some xsd:string, sdg:stigmaType some xsd:string, sdg:severityLevel some sdg:SeverityLevelKind, sdg:location some xsd:string, sdg:dateReported some xsd:date, sdg:source some xsd:string, sdg:affects min 2 sdg:PersonWithAlbinism, sdg:mitigatedBy some sdg:MainstreamSchool, sdg:counteredBy some sdg:EducationProgram

Class: sdg:JurisdictionalStatute
    Annotations: rdfs:label "Jurisdictional Statute", iao:0000115 "A legislative enactment or regulatory instrument that governs the oil and gas industry within a specific jurisdiction."
    SubClassOf: sdg:LegalEntity, sdg:statuteIdentifier some xsd:string, sdg:enactmentDate some xsd:date, sdg:jurisdictionName some xsd:string, sdg:status some sdg:StatusKind, sdg:subjectMatter some sdg:SubjectMatterKind, sdg:subjectMatterDomain some xsd:string, sdg:governs min 2 sdg:ExtractionWell, sdg:amends max 1 sdg:JurisdictionalStatute

Class: sdg:ExtractionWell
    Annotations: rdfs:label "Extraction Well", iao:0000115 "A physical borehole or facility constructed for the purpose of extracting oil, gas, or mineral resources from the subsurface."
    SubClassOf: cco:ont00000995, sdg:wellIdentifier some xsd:string, sdg:completionDate some xsd:date, sdg:wellType some xsd:string, sdg:depthMeters some xsd:decimal, sdg:operatorName some xsd:string, sdg:status some sdg:StatusKind, sdg:locatedIn exactly 1 sdg:LandParcel, sdg:operatedBy max 1 sdg:ExtractionWell, sdg:produces min 2 sdg:ResourceExtractionEvent

Class: sdg:ResourceExtractionEvent
    Annotations: rdfs:label "Resource Extraction Event", iao:0000115 "A discrete measurement or activity recording the volume, pressure, or quality of oil or gas extracted from a well at a specific time."
    SubClassOf: bfo:0000015, sdg:eventIdentifier some xsd:string, sdg:measurementDateTime some xsd:dateTime, sdg:volumeBarrels some xsd:decimal, sdg:volumeThousandCubicFeet some xsd:decimal, sdg:pressurePSI some xsd:decimal, sdg:fluidType some sdg:FluidTypeKind, sdg:measuredAt exactly 1 sdg:ExtractionWell, sdg:recordsExtractionFrom exactly 1 sdg:LandParcel, sdg:compliesWith exactly 1 sdg:JurisdictionalStatute

Class: sdg:LeaseAgreement
    Annotations: rdfs:label "Lease Agreement", iao:0000115 "A legal contract granting rights to explore and extract oil or gas from a specific land parcel in exchange for royalties or bonuses."
    SubClassOf: cco:ont00000958, sdg:leaseIdentifier some xsd:string, sdg:effectiveDate some xsd:date, sdg:expirationDate some xsd:date, sdg:royaltyPercentage some xsd:decimal, sdg:bonusPaymentAmount some xsd:decimal, sdg:lessorName some xsd:string, sdg:lesseeName some xsd:string, sdg:covers exactly 1 sdg:LandParcel, sdg:authorizes min 2 sdg:ExtractionWell, sdg:governedBy exactly 1 sdg:JurisdictionalStatute

Class: sdg:InternalAuditRole
    Annotations: rdfs:label "Internal Audit Role", iao:0000115 "A role occupied by the executive responsible for the organisation's internal audit service, including drawing up the internal audit strategy and annual plan and giving the annual audit opinion."
    SubClassOf: bfo:0000023, sdg:roleIdentifier some xsd:string, sdg:roleTitle some sdg:RoleTitleKind, sdg:standardComplianceStatus some xsd:string, sdg:contractingOrganisation some xsd:string, sdg:sharedServiceFlag some xsd:boolean, sdg:lastReviewDate some xsd:date, sdg:performanceRating some xsd:decimal, sdg:assignedToOrganisation exactly 1 sdg:PublicServiceOrganisation, sdg:evaluatesGovernanceFramework some sdg:GovernanceFramework

Class: sdg:PublicServiceOrganisation
    Annotations: rdfs:label "Public Service Organisation", iao:0000115 "An entity providing public services where public money needs to be effectively and efficiently managed."
    SubClassOf: bfo:0000040, sdg:organisationId some xsd:string, sdg:organisationName some xsd:string, sdg:jurisdiction some sdg:JurisdictionKind, sdg:establishmentDate some xsd:date, sdg:serviceType some sdg:ServiceTypeKind, sdg:annualBudget some xsd:decimal, sdg:governanceMaturityLevel some xsd:integer, sdg:employsInternalAuditRole exactly 1 sdg:InternalAuditRole, sdg:subjectToAuditStandards exactly 1 sdg:AuditStandard, sdg:hasAuditCommittee exactly 1 sdg:AuditCommittee

Class: sdg:AuditStandard
    Annotations: rdfs:label "Audit Standard", iao:0000115 "A document or dataset that provides clear standards for internal audit, such as the UK Public Sector Internal Audit Standards (PSIAS)."
    SubClassOf: cco:ont00000958, sdg:standardId some xsd:string, sdg:standardName some xsd:string, sdg:issuingBody some xsd:string, sdg:effectiveDate some xsd:date, sdg:revisionNumber some xsd:integer, sdg:complianceLevel some sdg:ComplianceLevelKind, sdg:mandatedByRegulator some sdg:RegulatoryBody, sdg:appliesToOrganisation some sdg:PublicServiceOrganisation
    HasKey: sdg:standardId

Class: sdg:AuditCommittee
    Annotations: rdfs:label "Audit Committee", iao:0000115 "A group of individuals responsible for overseeing the internal audit function and ensuring compliance with standards."
    SubClassOf: sdg:Report, sdg:committeeId some xsd:string, sdg:committeeName some xsd:string, sdg:establishmentDate some xsd:date, sdg:meetingFrequency some sdg:MeetingFrequencyKind, sdg:memberCount some xsd:integer, sdg:independenceLevel some xsd:string, sdg:overseesInternalAuditRole exactly 1 sdg:InternalAuditRole, sdg:reportsToOrganisation exactly 1 sdg:PublicServiceOrganisation
    HasKey: sdg:committeeId

Class: sdg:GovernanceFramework
    Annotations: rdfs:label "Governance Framework", iao:0000115 "A set of arrangements and principles that define how an organisation is directed and controlled, including risk management and internal control."
    SubClassOf: bfo:0000040, sdg:frameworkId some xsd:string, sdg:frameworkName some xsd:string, sdg:version some xsd:string, sdg:lastUpdated some xsd:dateTime, sdg:complianceScore some xsd:decimal, sdg:riskAssessmentFrequency some xsd:string, sdg:evaluatedByInternalAuditRole some sdg:InternalAuditRole, sdg:implementedByOrganisation exactly 1 sdg:PublicServiceOrganisation

Class: sdg:ESGMeasurement
    Annotations: rdfs:label "ESG Measurement", iao:0000115 "A specific process or activity of collecting, recording, and quantifying data for a particular ESG metric at a given time."
    SubClassOf: bfo:0000015, sdg:measurementId some xsd:string, sdg:measurementDate some xsd:dateTime, sdg:numericValue some xsd:decimal, sdg:status some sdg:StatusKind, sdg:dataSource some xsd:string, sdg:quantifies exactly 1 sdg:ESGMetric, sdg:conductedBy some sdg:ESGAdvisor
    HasKey: sdg:measurementId

Class: sdg:PolicyChange
    Annotations: rdfs:label "Policy Change", iao:0000115 "A legislative, regulatory, or governmental update affecting ESG standards, reporting requirements, or operational compliance."
    SubClassOf: bfo:0000015, sdg:policyId some xsd:string, sdg:policyTitle some xsd:string, sdg:issuingJurisdiction some xsd:string, sdg:effectiveDate some xsd:date, sdg:impactLevel some sdg:ImpactLevelKind, sdg:affects some sdg:ESGStrategy, sdg:triggers some sdg:ESGMeasurement, sdg:analyzedBy some sdg:ESGAdvisor

Class: sdg:CreditUnion
    Annotations: rdfs:label "Credit Union", iao:0000115 "A member-owned financial cooperative providing financial services to a defined group of individuals."
    SubClassOf: cco:ont00000995, sdg:identifier some xsd:string, sdg:legalName some xsd:string, sdg:foundingDate some xsd:date, sdg:headquartersCity some xsd:string, sdg:headquartersState some xsd:string, sdg:memberEligibilityCriteria some xsd:string, sdg:regulatoryStatus some sdg:RegulatoryStatusKind, sdg:hasChiefExecutiveOfficer exactly 1 sdg:ExecutiveRole, sdg:awarded some sdg:Award

Class: sdg:ScholarshipFund
    Annotations: rdfs:label "Scholarship Fund", iao:0000115 "A financial resource established to provide scholarships for training and career development."
    SubClassOf: cco:ont00000995, sdg:fundName some xsd:string, sdg:establishedYear some xsd:integer, sdg:targetBeneficiaries some xsd:string, sdg:fundingSource some sdg:FundingSourceKind, sdg:createdBy exactly 1 sdg:Organization, sdg:honors exactly 1 sdg:Person, sdg:awardedTo some sdg:Person

Class: sdg:DidacticalSituation
    Annotations: rdfs:label "Didactical Situation", iao:0000115 "A structured educational interaction between a teacher and students centered on a specific mathematical problem or concept."
    SubClassOf: bfo:0000015, sdg:situationId some xsd:string, sdg:title some xsd:string, sdg:periodStart some xsd:dateTime, sdg:periodEnd some xsd:dateTime, sdg:status some sdg:StatusKind, sdg:description some xsd:string, sdg:describes min 1 sdg:MathematicalConcept, sdg:involves min 2 sdg:EducationalActor, sdg:uses some sdg:DidacticInstrument

Class: sdg:EducationalActor
    Annotations: rdfs:label "Educational Actor", iao:0000115 "A person participating in a didactical situation, specifically a teacher or a student."
    SubClassOf: bfo:0000004, sdg:actorId some xsd:string, sdg:roleDetail some sdg:RoleKind, sdg:institution some xsd:string, sdg:yearsOfExperience some xsd:integer, sdg:demographicGroup some sdg:DemographicGroupKind, sdg:participatesIn__escalated some sdg:DidacticalSituation, sdg:affiliatedWith max 1 sdg:EducationalInstitution
    HasKey: sdg:actorId

Class: sdg:DidacticInstrument
    Annotations: rdfs:label "Didactic Instrument", iao:0000115 "A physical or digital tool, artifact, or resource used to facilitate the learning of mathematical concepts within a didactical situation."
    SubClassOf: cco:ont00000995, sdg:instrumentId some xsd:string, sdg:title some xsd:string, sdg:type some sdg:TypeKind, sdg:publicationYear some xsd:integer, sdg:authorName some xsd:string, sdg:isDigital some xsd:boolean, sdg:supports min 1 sdg:MathematicalConcept, sdg:usedIn some sdg:DidacticalSituation

Class: sdg:DidacticInstitution
    Annotations: rdfs:label "Didactic Institution", iao:0000115 "An organizational body or system that establishes the rules, norms, and constraints governing the didactical situation."
    SubClassOf: bfo:0000040, sdg:institutionId some xsd:string, sdg:name some sdg:NameKind, sdg:jurisdiction some sdg:JurisdictionKind, sdg:foundingYear some xsd:integer, sdg:type some sdg:TypeKind, sdg:governs some sdg:DidacticalSituation, sdg:employs min 1 sdg:EducationalActor
    HasKey: sdg:institutionId

Class: sdg:LearningOutcome
    Annotations: rdfs:label "Learning Outcome", iao:0000115 "A measurable change in a student's knowledge, skill, or understanding resulting from a didactical situation."
    SubClassOf: bfo:0000015, sdg:outcomeId some xsd:string, sdg:assessmentScore some xsd:decimal, sdg:masteryLevel some xsd:string, sdg:dateAssessed some xsd:date, sdg:isAchieved some xsd:boolean, sdg:domain some sdg:DomainKind, sdg:objectiveText some xsd:string, sdg:proficiencyLevel some sdg:ProficiencyLevelKind, sdg:assessmentMethod some sdg:AssessmentMethodKind, sdg:isMandatory some xsd:boolean, sdg:lastReviewedDate some xsd:date, sdg:resultsFrom exactly 1 sdg:DidacticalSituation, sdg:measures exactly 1 sdg:MathematicalConcept, sdg:attributedTo exactly 1 sdg:EducationalActor, sdg:requiredBy min 2 sdg:CourseLevel, sdg:supportsDomain exactly 1 sdg:ReadinessBenchmark

Class: sdg:AcademicText
    Annotations: rdfs:label "Academic Text", iao:0000115 "A published educational resource, such as a textbook or e-text, containing structured instructional material on a specific subject."
    SubClassOf: sdg:Book, sdg:isbn some xsd:string, sdg:edition some xsd:string, sdg:publicationDate some xsd:date, sdg:format some sdg:FormatKind, sdg:suggestedRetailPrice some xsd:decimal, sdg:title some xsd:string, sdg:hasAuthor some sdg:AcademicAuthor, sdg:partOfPackage some sdg:AccessCardPackage, sdg:hasAccessPlatform some sdg:DigitalPlatform

Class: sdg:AcademicAuthor
    Annotations: rdfs:label "Academic Author", iao:0000115 "An individual who has written or contributed to the creation of an academic text or educational material."
    SubClassOf: bfo:0000015, sdg:authorId some xsd:string, sdg:fullName some xsd:string, sdg:affiliation some sdg:AffiliationKind, sdg:roleDetail some sdg:RoleKind, sdg:authored some sdg:AcademicText

Class: sdg:AccessCardPackage
    Annotations: rdfs:label "Access Card Package", iao:0000115 "A physical or digital bundle containing an access card or code that grants users entry to an online educational platform and associated digital content."
    SubClassOf: cco:ont00000995, sdg:packageId some xsd:string, sdg:accessDuration some xsd:string, sdg:platformName some xsd:string, sdg:status some sdg:StatusKind, sdg:activationDate some xsd:dateTime, sdg:grantsAccessTo exactly 1 sdg:DigitalPlatform, sdg:includesText some sdg:AcademicText

Class: sdg:DigitalPlatform
    Annotations: rdfs:label "Digital Platform", iao:0000115 "An online system or service that hosts educational content, exercises, and assessment tools for students and instructors."
    SubClassOf: bfo:0000015, sdg:platformId some xsd:string, sdg:platformName some xsd:string, sdg:version some xsd:string, sdg:provider some xsd:string, sdg:isAvailable some xsd:boolean, sdg:platformType some sdg:PlatformTypeKind, sdg:url some xsd:string, sdg:cookieEnabled some xsd:boolean, sdg:analyticsProvider some xsd:string, sdg:hostsContent some sdg:AcademicText, sdg:providesExercises min 2 sdg:StatisticalExercise, sdg:collectsDataFrom min 2 sdg:PersonalDataRecord, sdg:usesTrackingTool some sdg:TrackingSoftware

Class: sdg:StatisticalExercise
    Annotations: rdfs:label "Statistical Exercise", iao:0000115 "A specific problem, question, or task designed to test or reinforce statistical concepts and analytical skills."
    SubClassOf: cco:ont00000995, sdg:exerciseId some xsd:string, sdg:exerciseType some xsd:string, sdg:difficultyLevel some sdg:DifficultyLevelKind, sdg:isUpdated some xsd:boolean, sdg:conceptCovered some xsd:string, sdg:isPartOf exactly 1 sdg:DigitalPlatform, sdg:testsConcept some sdg:StatisticalConcept

Class: sdg:StatisticalConcept
    Annotations: rdfs:label "Statistical Concept", iao:0000115 "A fundamental principle, method, or theoretical framework within the field of statistics used for data analysis and interpretation."
    SubClassOf: bfo:0000015, sdg:conceptId some xsd:string, sdg:conceptName some xsd:string, sdg:category some sdg:CategoryKind, sdg:isCore some xsd:boolean, sdg:isTestedBy some sdg:StatisticalExercise

Class: sdg:LabActivity
    Annotations: rdfs:label "Lab Activity", iao:0000115 "A structured educational activity conducted in a laboratory setting to teach plant and microbial biology concepts."
    SubClassOf: bfo:0000015, sdg:activityId some xsd:string, sdg:title some xsd:string, sdg:description some xsd:string, sdg:durationMinutes some xsd:integer, sdg:difficultyLevel some sdg:DifficultyLevelKind, sdg:status some sdg:StatusKind, sdg:taughtBy exactly 1 sdg:FacultyMember, sdg:attendedBy min 2 sdg:Student, sdg:usesMaterial some sdg:LabMaterial

Class: sdg:TeachingAssistant
    Annotations: rdfs:label "Teaching Assistant", iao:0000115 "A person, often a graduate student, who assists faculty members in teaching and supervising laboratory activities."
    SubClassOf: bfo:0000003, sdg:taId some xsd:string, sdg:firstName some xsd:string, sdg:lastName some xsd:string, sdg:assignedCourse some xsd:string, sdg:hoursPerWeek some xsd:integer, sdg:assists exactly 1 sdg:FacultyMember, sdg:supervises min 2 sdg:Student

Class: sdg:LabMaterial
    Annotations: rdfs:label "Lab Material", iao:0000115 "Physical or digital resources required to conduct a laboratory activity, such as specimens, equipment, or software."
    SubClassOf: cco:ont00000995, sdg:materialId some xsd:string, sdg:name some sdg:NameKind, sdg:quantity some xsd:integer, sdg:unit some sdg:UnitKind, sdg:storageLocation some xsd:string, sdg:usedIn some sdg:LabActivity

Class: sdg:WineAward
    Annotations: rdfs:label "Wine Award", iao:0000115 "A formal recognition or accolade granted to a restaurant or wine list based on specific criteria."
    SubClassOf: bfo:0000040, sdg:awardId some xsd:string, sdg:awardName some xsd:string, sdg:issuingOrganizationDetail some xsd:string, sdg:awardYear some xsd:integer, sdg:minimumSelections some xsd:integer, sdg:isGrandAward some xsd:boolean, sdg:awardedTo some sdg:Restaurant, sdg:grantedBy exactly 1 sdg:Organization

Class: sdg:Wine
    Annotations: rdfs:label "Wine", iao:0000115 "An alcoholic beverage made from fermented grapes, including specific vintages and producers."
    SubClassOf: bfo:0000040, sdg:wineId some xsd:string, sdg:producer some xsd:string, sdg:vintage some xsd:integer, sdg:variety some xsd:string, sdg:appellation some xsd:string, sdg:vineyardSource some xsd:string, sdg:parkerRating some xsd:string, sdg:containsResveratrol some xsd:boolean, sdg:producedBy some sdg:Person, sdg:sourcedFromVineyard some sdg:Vineyard, sdg:servedAt some sdg:Restaurant, sdg:pairsWithFood some sdg:Food

Class: sdg:Vineyard
    Annotations: rdfs:label "Vineyard", iao:0000115 "A piece of land dedicated to the cultivation of grapevines."
    SubClassOf: bfo:0000040, sdg:vineyardId some xsd:string, sdg:name some sdg:NameKind, sdg:location some xsd:string, sdg:acres some xsd:decimal, sdg:averageVineAge some xsd:integer, sdg:ownershipType some sdg:OwnershipTypeKind, sdg:suppliesWine some sdg:Wine, sdg:ownedBy some sdg:Person

Class: sdg:Food
    Annotations: rdfs:label "Food", iao:0000115 "A substance consumed to provide nutritional support, including specific ingredients and dishes."
    SubClassOf: sdg:DiningPackage, sdg:foodId some xsd:string, sdg:name some sdg:NameKind, sdg:category some sdg:CategoryKind, sdg:isStaining some xsd:boolean, sdg:preparationMethod some xsd:string, sdg:pairsWithWine some sdg:Wine, sdg:servedAt some sdg:Restaurant
    HasKey: sdg:foodId

Class: sdg:Chemical
    Annotations: rdfs:label "Chemical", iao:0000115 "A substance with distinct molecular composition, such as resveratrol found in wine."
    SubClassOf: bfo:0000040, sdg:chemicalId some xsd:string, sdg:name some sdg:NameKind, sdg:locationInWine some xsd:string, sdg:biologicalEffect some xsd:string, sdg:testedOnOrganism some xsd:string, sdg:foundIn some sdg:Wine, sdg:studiedBy some sdg:Person

Class: sdg:TreatmentEvent
    Annotations: rdfs:label "Treatment Event", iao:0000115 "A specific instance of medical treatment or service provided to a patient."
    SubClassOf: sdg:Event, sdg:eventId some xsd:string, sdg:eventDate some xsd:dateTime, sdg:serviceCode some xsd:string, sdg:eventStatus some xsd:string, sdg:involves exactly 1 sdg:Patient, sdg:performedBy exactly 1 sdg:HealthcareProvider, sdg:generates exactly 1 sdg:BillingRecord

Class: sdg:BillingRecord
    Annotations: rdfs:label "Billing Record", iao:0000115 "A financial record detailing the costs and payment status for medical services provided."
    SubClassOf: cco:ont00000995, sdg:billingId some xsd:string, sdg:amount some xsd:decimal, sdg:paymentStatus some sdg:PaymentStatusKind, sdg:billingDate some xsd:dateTime, sdg:linkedTo exactly 1 sdg:TreatmentEvent, sdg:belongsToMany some sdg:PatientRecord

Class: sdg:DisclosureRecord
    Annotations: rdfs:label "Disclosure Record", iao:0000115 "A log entry documenting the use or disclosure of medical information for specific purposes."
    SubClassOf: cco:ont00000995, sdg:disclosureId some xsd:string, sdg:disclosureDate some xsd:dateTime, sdg:purpose some sdg:PurposeKind, sdg:recipient some xsd:string, sdg:references exactly 1 sdg:PatientRecord, sdg:initiatedBy exactly 1 sdg:HealthcareProvider

Class: sdg:OpticalFiber
    Annotations: rdfs:label "Optical Fiber", iao:0000115 "A polarization-maintaining (PM) optical fiber used to transmit light from the laser diode."
    SubClassOf: cco:ont00000995, sdg:fiberType some xsd:string, sdg:fiberCore some xsd:string

Class: sdg:Photodiode
    Annotations: rdfs:label "Photodiode", iao:0000115 "A built-in monitoring photodiode integrated within the laser diode module to measure output power."
    SubClassOf: cco:ont00000995, sdg:pdReverseVoltage some xsd:decimal, sdg:monitorCurrent some xsd:decimal

Class: sdg:InformationSharingAgreement
    Annotations: rdfs:label "Information Sharing Agreement", iao:0000115 "A formal memorandum of agreement establishing a shared vision and interoperability standards between the Department of Defense and the Intelligence Community."
    SubClassOf: cco:ont00000958, sdg:agreementId some xsd:string, sdg:issueDate some xsd:date, sdg:agreementType some xsd:string, sdg:status some sdg:StatusKind, sdg:scope some sdg:ScopeKind, sdg:governedBy exactly 1 sdg:GovernanceBoard, sdg:enforces min 2 sdg:InteroperabilityStandard, sdg:signedBy min 2 sdg:ChiefInformationOfficer

Class: sdg:ChiefInformationOfficer
    Annotations: rdfs:label "Chief Information Officer", iao:0000115 "A role held by a senior official responsible for the information technology and management of the Department of Defense or the Intelligence Community."
    SubClassOf: bfo:0000023, sdg:officerId some xsd:string, sdg:fullName some xsd:string, sdg:organization some xsd:string, sdg:rankOrTitle some xsd:string, sdg:appointmentDate some xsd:date, sdg:coChairs exactly 1 sdg:GovernanceBoard, sdg:signs some sdg:InformationSharingAgreement

Class: sdg:InteroperabilityStandard
    Annotations: rdfs:label "Interoperability Standard", iao:0000115 "A jointly-developed standard, rule, or technical specification ensuring interoperability and secure infrastructure services within the shared information environment."
    SubClassOf: cco:ont00000995, sdg:standardId some xsd:string, sdg:standardName some xsd:string, sdg:version some xsd:string, sdg:technologyType some sdg:TechnologyTypeKind, sdg:complianceLevel some sdg:ComplianceLevelKind, sdg:effectiveDate some xsd:date, sdg:governedBy exactly 1 sdg:GovernanceBoard, sdg:supports some sdg:InformationEnvironment, sdg:implementedBy min 2 sdg:MissionService

Class: sdg:InformationEnvironment
    Annotations: rdfs:label "Information Environment", iao:0000115 "A services-based information environment leveraging commercial practices and standard web technologies to provide mission and business services across the DoD and IC."
    SubClassOf: bfo:0000015, sdg:environmentId some xsd:string, sdg:environmentName some xsd:string, sdg:architectureType some sdg:ArchitectureTypeKind, sdg:operationalStatus some sdg:OperationalStatusKind, sdg:visibilityLevel some xsd:string, sdg:managedBy exactly 1 sdg:GovernanceBoard, sdg:uses min 2 sdg:InteroperabilityStandard, sdg:hosts min 2 sdg:MissionService

Class: sdg:MissionService
    Annotations: rdfs:label "Mission Service", iao:0000115 "A secure mission or business service provided and used by functions and organizations across the DoD and IC, based on applicable enterprise architectures."
    SubClassOf: cco:ont00000995, sdg:serviceId some xsd:string, sdg:serviceName some xsd:string, sdg:serviceCategory some sdg:ServiceCategoryKind, sdg:securityClassification some xsd:string, sdg:availabilityStatus some xsd:string, sdg:providerOrganization some sdg:ProviderOrganizationKind, sdg:implementedUsing min 2 sdg:InteroperabilityStandard, sdg:hostedIn exactly 1 sdg:InformationEnvironment, sdg:usedBy min 2 sdg:MissionService

Class: sdg:PathSegment
    Annotations: rdfs:label "Straight-Line Tangent", iao:0000115 "A straight-line geometric segment that connects two tangent circles at tangent points, forming part of the planned route."
    SubClassOf: bfo:0000040, sdg:segmentId some xsd:string, sdg:segmentLength some xsd:decimal, sdg:segmentStartX some xsd:decimal, sdg:segmentStartY some xsd:decimal, sdg:segmentEndX some xsd:decimal, sdg:segmentEndY some xsd:decimal, sdg:segmentStatus some sdg:SegmentStatusKind, sdg:connectsStart exactly 1 sdg:TangentCircle, sdg:connectsEnd exactly 1 sdg:TangentCircle, sdg:partOf exactly 1 sdg:Route

Class: sdg:Route
    Annotations: rdfs:label "Mission Route", iao:0000115 "A complete sequence of path segments and turns that guides the vehicle from an entry checkpoint to an exit checkpoint while avoiding obstacles."
    SubClassOf: bfo:0000002, sdg:routeId some xsd:string, sdg:routeStatus some sdg:RouteStatusKind, sdg:totalLength some xsd:decimal, sdg:generationTime some xsd:dateTime, sdg:steeringCompliant some xsd:boolean, sdg:composedOf min 2 sdg:PathSegment, sdg:traverses exactly 1 sdg:Zone, sdg:startsAt exactly 1 sdg:Checkpoint, sdg:endsAt exactly 1 sdg:Checkpoint

Class: sdg:Checkpoint
    Annotations: rdfs:label "Mission Checkpoint", iao:0000115 "A defined geographic point marking a critical location in the mission, such as a zone entry, exit, or parking space."
    SubClassOf: bfo:0000040, sdg:checkpointId some xsd:string, sdg:checkpointType some xsd:string, sdg:checkpointX some xsd:decimal, sdg:checkpointY some xsd:decimal, sdg:checkpointStatus some xsd:string, sdg:locatedIn exactly 1 sdg:Zone, sdg:servesAsStartFor some sdg:Route, sdg:servesAsEndFor some sdg:Route
    HasKey: sdg:checkpointId

Class: sdg:NetworkDevice
    Annotations: rdfs:label "Network Device", iao:0000115 "A physical or virtual piece of networking hardware or software that processes and forwards data packets within a local area network or across the internet."
    SubClassOf: sdg:NetworkEntity, sdg:deviceId some xsd:string, sdg:deviceType some sdg:DeviceTypeKind, sdg:ipAddress some xsd:string, sdg:firmwareVersion some xsd:string, sdg:status some sdg:StatusKind, sdg:lastHeartbeat some xsd:dateTime, sdg:deviceName some xsd:string, sdg:osVersion some xsd:string, sdg:macAddress some xsd:string, sdg:lastSeen some xsd:dateTime, sdg:isAuthenticated some xsd:boolean, sdg:configuredBy some sdg:ServiceLevelAgreement, sdg:partOf__escalated exactly 1 sdg:NetworkSegment, sdg:measuredBy some sdg:PerformanceMetric, sdg:connectedToClient max 1 sdg:VpnClient, sdg:residesIn exactly 1 sdg:NetworkSegment, sdg:generatesTraffic min 2 sdg:DataPacket

Class: sdg:ServiceLevelAgreement
    Annotations: rdfs:label "Service Level Agreement", iao:0000115 "A formal contract between an Internet Service Provider and a customer or between network segments that defines the level of service, quality of service parameters, and resource allocation guarantees."
    SubClassOf: sdg:slaId some xsd:string, sdg:providerId some xsd:string, sdg:customerClass some sdg:CustomerClassKind, sdg:maxBandwidth some xsd:decimal, sdg:latencyThreshold some xsd:decimal, sdg:packetLossLimit some xsd:decimal, sdg:effectiveDate some xsd:date, sdg:expirationDate some xsd:date, sdg:governs min 2 sdg:NetworkDevice, sdg:definesQoSFor some sdg:TrafficClass, sdg:monitoredBy exactly 1 sdg:ResourceManagementSystem
    HasKey: sdg:slaId

Class: sdg:TrafficClass
    Annotations: rdfs:label "Traffic Class", iao:0000115 "A categorization of network traffic flows based on quality of service requirements, such as latency, bandwidth, and jitter, used for differentiated services (DiffServ) handling."
    SubClassOf: sdg:trafficClassId some xsd:string, sdg:dscpCode some xsd:integer, sdg:priorityLevel some sdg:PriorityLevelKind, sdg:bandwidthAllocation some xsd:decimal, sdg:maxLatency some xsd:decimal, sdg:jitterTolerance some xsd:decimal, sdg:mappedTo some sdg:NetworkDevice, sdg:subjectTo some sdg:ServiceLevelAgreement, sdg:classifiedBy exactly 1 sdg:CallAdmissionControl
    HasKey: sdg:trafficClassId

Class: sdg:CallAdmissionControl
    Annotations: rdfs:label "Call Admission Control", iao:0000115 "A process or mechanism that determines whether a new network connection or data flow should be admitted to the network based on available resources and current load, preventing congestion."
    SubClassOf: bfo:0000015, sdg:cacId some xsd:string, sdg:algorithmType some sdg:AlgorithmTypeKind, sdg:currentLoad some xsd:decimal, sdg:thresholdUtilization some xsd:decimal, sdg:decisionStatus some sdg:DecisionStatusKind, sdg:timestamp some xsd:dateTime, sdg:evaluates some sdg:TrafficClass, sdg:enforces some sdg:ServiceLevelAgreement, sdg:partOf__escalated exactly 1 sdg:ResourceManagementSystem

Class: sdg:ResourceManagementSystem
    Annotations: rdfs:label "Resource Management System", iao:0000115 "A two-tier system (ATTRM) that plans and manages network resources, allocating bandwidth and capacity based on service level agreements and traffic engineering principles to optimize long-term revenue and efficiency."
    SubClassOf: bfo:0000015, sdg:rmsId some xsd:string, sdg:systemVersion some xsd:string, sdg:optimizationGoal some xsd:string, sdg:totalCapacity some xsd:decimal, sdg:allocatedCapacity some xsd:decimal, sdg:lastOptimizationRun some xsd:dateTime, sdg:manages min 2 sdg:NetworkDevice, sdg:implements some sdg:ServiceLevelAgreement, sdg:contains min 2 sdg:CallAdmissionControl, sdg:monitors some sdg:PerformanceMetric

Class: sdg:PerformanceMetric
    Annotations: rdfs:label "Performance Metric", iao:0000115 "A recorded measurement of network performance indicators such as bandwidth usage, latency, packet loss, or jitter, used to evaluate the effectiveness of resource management and service level agreements."
    SubClassOf: bfo:0000015, sdg:metricId some xsd:string, sdg:metricType some sdg:MetricTypeKind, sdg:value some xsd:decimal, sdg:unit some sdg:UnitKind, sdg:sampleTime some xsd:dateTime, sdg:sourceDeviceId some xsd:string, sdg:metricIdentifier some xsd:string, sdg:metricName some xsd:string, sdg:measurementDate some xsd:dateTime, sdg:targetValue some xsd:decimal, sdg:actualValue some xsd:decimal, sdg:status some sdg:StatusKind, sdg:measuredOn exactly 1 sdg:NetworkDevice, sdg:validates some sdg:ServiceLevelAgreement, sdg:feeds exactly 1 sdg:ResourceManagementSystem, sdg:tracks min 2 sdg:InformationLogisticsStrategy, sdg:measures exactly 1 sdg:SuccessFactor, sdg:appliesTo min 3 sdg:DecisionMaker, sdg:derivedFrom some sdg:AnalyticalInformationSystem

Class: sdg:AcademicSession
    Annotations: rdfs:label "Academic Session", iao:0000115 "A scheduled segment of an academic conference dedicated to specific topics or presentations."
    SubClassOf: bfo:0000015, sdg:sessionTitle some xsd:string, sdg:sessionType some sdg:SessionTypeKind, sdg:scheduledDate some xsd:dateTime, sdg:venueRoom some xsd:string, sdg:status some sdg:StatusKind, sdg:partOfEvent exactly 1 sdg:AcademicConference, sdg:featuresSpeaker min 2 sdg:AcademicResearcher

Class: sdg:ResearchPresentation
    Annotations: rdfs:label "Research Presentation", iao:0000115 "A specific academic talk or paper delivery within a conference session."
    SubClassOf: sdg:ResearchEntity, sdg:presentationTitle some xsd:string, sdg:submissionStatus some sdg:SubmissionStatusKind, sdg:presentationType some sdg:PresentationTypeKind, sdg:abstractText some xsd:string, sdg:deliveredBy exactly 1 sdg:AcademicResearcher, sdg:presentedIn exactly 1 sdg:AcademicSession

Class: sdg:AdultToBeAdopted
    Annotations: rdfs:label "Adult Subject of Adoption", iao:0000115 "The adult individual who is the subject of the adoption petition and whose legal status is being altered."
    SubClassOf: bfo:0000040, sdg:fullLegalName some xsd:string, sdg:dateOfBirth some xsd:date, sdg:socialSecurityNumber some xsd:string, sdg:residencyStartDate some xsd:date, sdg:birthCity some xsd:string, sdg:birthState some xsd:string, sdg:preferredPostAdoptionName some xsd:string, sdg:residesAt exactly 1 sdg:ResidentialAddress, sdg:contactedBy min 2 sdg:ContactMethod, sdg:subjectOfAdoptionCase exactly 1 sdg:AdoptionCase, sdg:hasBirthMother max 1 sdg:Person, sdg:hasBirthFather max 1 sdg:Person

Class: sdg:ResidentialAddress
    Annotations: rdfs:label "Residential Address", iao:0000115 "A physical location entity comprising street, city, state, and postal code components used for jurisdictional and contact purposes."
    SubClassOf: bfo:0000004, sdg:streetAddress some xsd:string, sdg:city some xsd:string, sdg:stateCode some xsd:string, sdg:zipCode some xsd:string, sdg:occupiedBy some sdg:AdoptionPetitioner, sdg:occupiedBy some sdg:AdultToBeAdopted

Class: sdg:ContactMethod
    Annotations: rdfs:label "Contact Method", iao:0000115 "A specific communication channel or device identifier (phone or email) associated with a party in the adoption proceeding."
    SubClassOf: bfo:0000004, sdg:contactValue some xsd:string, sdg:contactType some sdg:ContactTypeKind, sdg:isPrimary some xsd:boolean, sdg:belongsToMany some sdg:AdoptionPetitioner, sdg:belongsToMany some sdg:AdultToBeAdopted

Class: sdg:NLFRepresentative
    Annotations: rdfs:label "NLF Representative", iao:0000115 "An internal staff member or agent assigned to manage and track the progress of an adoption case."
    SubClassOf: bfo:0000040, sdg:repIdentifier some xsd:string, sdg:repName some xsd:string, sdg:manages some sdg:AdoptionCase

Class: sdg:Cyborg
    Annotations: rdfs:label "Cyborg", iao:0000115 "A cybernetic organism that incorporates technological implants connected to its nervous system."
    SubClassOf: sdg:cyborgId some xsd:string, sdg:classification some sdg:ClassificationKind, sdg:implantLocation some xsd:string, sdg:neuralIntegrationLevel some xsd:decimal, sdg:status some sdg:StatusKind, sdg:hasImplant some sdg:NeuralImplant, sdg:partOf__escalated some sdg:CyborgationProcess

Class: sdg:NeuralImplant
    Annotations: rdfs:label "Neural Implant", iao:0000115 "A technological device implanted into the body to interface with the nervous system."
    SubClassOf: sdg:System, sdg:implantId some xsd:string, sdg:type some sdg:TypeKind, sdg:material some xsd:string, sdg:powerSource some xsd:string, sdg:signalFormat some sdg:SignalFormatKind, sdg:implantType some xsd:string, sdg:connectedTo some sdg:NerveFiber, sdg:transmitsTo some sdg:ComputerSystem

Class: sdg:CyborgationProcess
    Annotations: rdfs:label "Cyborgation Process", iao:0000115 "The process of transforming an organism into a cyborg through the implantation of technological devices."
    SubClassOf: bfo:0000015, sdg:processId some xsd:string, sdg:startDate some xsd:dateTime, sdg:endDate some xsd:dateTime, sdg:procedureType some sdg:ProcedureTypeKind, sdg:successRate some xsd:decimal, sdg:transforms exactly 1 sdg:Cyborg, sdg:usesImplant some sdg:NeuralImplant

Class: sdg:Hybrot
    Annotations: rdfs:label "Hybrot", iao:0000115 "A cybernetic organism resembling a robot, engineered from organic and inorganic materials."
    SubClassOf: bfo:0000040, sdg:hybrotId some xsd:string, sdg:biologicalComponent some xsd:string, sdg:electronicComponent some xsd:string, sdg:longevity some xsd:decimal, sdg:status some sdg:StatusKind, sdg:contains some sdg:NeuralImplant, sdg:connectedTo some sdg:ComputerSystem
    HasKey: sdg:hybrotId

Class: sdg:ComputerSystem
    Annotations: rdfs:label "Computer System", iao:0000115 "A system used to process and store data from neural implants and cyborgs."
    SubClassOf: sdg:System, sdg:systemId some xsd:string, sdg:processingPower some xsd:decimal, sdg:storageCapacity some xsd:decimal, sdg:communicationProtocol some xsd:string, sdg:status some sdg:StatusKind, sdg:receivesDataFrom some sdg:NeuralImplant, sdg:processesFor some sdg:Cyborg

Class: sdg:NerveFiber
    Annotations: rdfs:label "Nerve Fiber", iao:0000115 "A biological structure that transmits nerve impulses."
    SubClassOf: bfo:0000002, sdg:fiberId some xsd:string, sdg:location some xsd:string, sdg:diameter some xsd:decimal, sdg:signalSpeed some xsd:decimal, sdg:connectedTo some sdg:NeuralImplant, sdg:transmitsTo some sdg:Muscle

Class: sdg:Muscle
    Annotations: rdfs:label "Muscle", iao:0000115 "A biological tissue that contracts to produce movement."
    SubClassOf: sdg:System, sdg:muscleId some xsd:string, sdg:type some sdg:TypeKind, sdg:location some xsd:string, sdg:strength some xsd:string, sdg:controlledBy some sdg:NerveFiber

Class: sdg:HappyHourSpecial
    Annotations: rdfs:label "Happy Hour Special", iao:0000115 "A time-limited promotional offer for discounted beverages and food items available during specific hours."
    SubClassOf: bfo:0000015, sdg:startTime some xsd:dateTime, sdg:endTime some xsd:dateTime, sdg:discountPercentage some xsd:decimal, sdg:isActive some xsd:boolean, sdg:includes min 2 sdg:Beverage, sdg:includes min 2 sdg:FoodItem

Class: sdg:DippingSauce
    Annotations: rdfs:label "Dipping Sauce", iao:0000115 "A liquid or semi-liquid condiment served alongside food items for dipping."
    SubClassOf: cco:ont00000995, sdg:name some sdg:NameKind, sdg:flavorProfile some xsd:string, sdg:spiciness some xsd:string, sdg:servedWith some sdg:FoodItem

Class: sdg:GageSpecification
    Annotations: rdfs:label "Gage Specification", iao:0000115 "A formal record of the dimensional and angular requirements for a specific tapered gage, including tolerances and geometric constraints."
    SubClassOf: cco:ont00000958, sdg:largeEndDiameter some xsd:decimal, sdg:smallEndDiameter some xsd:decimal, sdg:taperPerFoot some xsd:decimal, sdg:taperPerInch some xsd:decimal, sdg:taperTolerance some xsd:decimal, sdg:halfAngle some xsd:decimal, sdg:includedAngle some xsd:decimal, sdg:hasSteps some xsd:boolean, sdg:stepLocation some xsd:string, sdg:specifies exactly 1 sdg:TaperGage

Class: sdg:Requestor
    Annotations: rdfs:label "Requestor", iao:0000115 "An individual or organizational entity that initiates a request for the manufacture of a tapered gage."
    SubClassOf: bfo:0000040, sdg:name some sdg:NameKind, sdg:company some xsd:string, sdg:phone some xsd:string, sdg:email some xsd:string, sdg:requests min 1 sdg:TaperGage

Class: sdg:HealthcareAnalyticsSolution
    Annotations: rdfs:label "Healthcare Analytics Solution", iao:0000115 "A technology solution or tool used to transform healthcare data into information and wisdom for decision-making."
    SubClassOf: cco:ont00000958, sdg:solutionId some xsd:string, sdg:solutionName some xsd:string, sdg:solutionType some xsd:string, sdg:vendor some xsd:string, sdg:isWebBased some xsd:boolean, sdg:supportsBigData some xsd:boolean, sdg:deploymentDate some xsd:dateTime, sdg:usedBy some sdg:HealthcareOrganization, sdg:processes some sdg:ElectronicHealthRecord, sdg:enables some sdg:ClinicalDecisionSupport

Class: sdg:CoachingEngagement
    Annotations: rdfs:label "A structured coaching engagement between a coach and a client", iao:0000115 "A structured coaching engagement between a coach and a client, involving sessions and outcomes."
    SubClassOf: bfo:0000015, sdg:engagementId some xsd:string, sdg:startDate some xsd:dateTime, sdg:endDate some xsd:dateTime, sdg:status some sdg:StatusKind, sdg:sessionCount some xsd:integer, sdg:coachingGoal some xsd:string, sdg:conductedBy exactly 1 sdg:Coach, sdg:servedClient exactly 1 sdg:Client, sdg:focusedOnTopic some sdg:CoachingTopic
    HasKey: sdg:engagementId

Class: sdg:Coach
    Annotations: rdfs:label "A professional providing coaching services", iao:0000115 "A professional providing coaching services, often with specific qualifications and experience."
    SubClassOf: bfo:0000015, sdg:coachId some xsd:string, sdg:fullName some xsd:string, sdg:qualifications some xsd:string, sdg:yearsExperience some xsd:integer, sdg:specialization some sdg:SpecializationKind, sdg:contactEmail some xsd:string, sdg:contactPhone some xsd:string, sdg:holdsMembership some sdg:ProfessionalMembership, sdg:deliversEngagement min 2 sdg:CoachingEngagement

Class: sdg:CoachingTopic
    Annotations: rdfs:label "A specific area or subject of coaching focus", iao:0000115 "A specific area or subject of coaching focus, such as work/life balance or stress management."
    SubClassOf: bfo:0000015, sdg:topicId some xsd:string, sdg:topicName some xsd:string, sdg:description some xsd:string, sdg:category some sdg:CategoryKind, sdg:coveredInEngagement some sdg:CoachingEngagement

Class: sdg:ClientFeedback
    Annotations: rdfs:label "Feedback provided by a client about their coaching experience", iao:0000115 "Feedback provided by a client about their coaching experience, often including testimonials and ratings."
    SubClassOf: bfo:0000015, sdg:feedbackId some xsd:string, sdg:feedbackDate some xsd:date, sdg:rating some xsd:integer, sdg:testimonial some xsd:string, sdg:sentiment some sdg:SentimentKind, sdg:providedByClient exactly 1 sdg:Client, sdg:relatedToEngagement max 1 sdg:CoachingEngagement

Class: sdg:ManagementUnit
    Annotations: rdfs:label "Management Unit", iao:0000115 "The administrative body or institution responsible for the day-to-day governance, planning, and conservation activities of a specific protected area."
    SubClassOf: cco:ont00000995, sdg:unitId some xsd:string, sdg:unitName some xsd:string, sdg:headquartersLocation some xsd:string, sdg:establishmentDate some xsd:date, sdg:legalStatus some sdg:LegalStatusKind, sdg:contactEmail some xsd:string, sdg:oversees some sdg:ProtectedArea, sdg:coordinatesWith exactly 1 sdg:ALPARC

Class: sdg:NuclearFacility
    Annotations: rdfs:label "Nuclear Facility", iao:0000115 "A material entity that is a nuclear installation or site, such as a licensed power plant, research reactor, or waste storage site, subject to regulatory oversight."
    SubClassOf: bfo:0000040, sdg:facilityId some xsd:string, sdg:facilityName some xsd:string, sdg:licenseStatus some sdg:LicenseStatusKind, sdg:operationalStatus some sdg:OperationalStatusKind, sdg:siteType some sdg:SiteTypeKind, sdg:lastInspectionDate some xsd:date, sdg:hasSafetyDirector exactly 1 sdg:SafetyDirector, sdg:isSubjectTo some sdg:RegulatoryFramework, sdg:generates some sdg:HSSSEQIssue

Class: sdg:SafetyDirector
    Annotations: rdfs:label "Safety Director", iao:0000115 "A person holding the senior role responsible for health, safety, security, safeguards, environment, and quality (HSSSEQ) at a nuclear site or company."
    SubClassOf: bfo:0000002, sdg:directorId some xsd:string, sdg:fullName some xsd:string, sdg:roleType some sdg:RoleTypeKind, sdg:appointmentDate some xsd:date, sdg:isSponsor some xsd:boolean, sdg:represents exactly 1 sdg:NuclearFacility, sdg:sponsors max 1 sdg:SubGroup, sdg:attends some sdg:ForumMeeting

Class: sdg:ForumMeeting
    Annotations: rdfs:label "Forum Meeting", iao:0000115 "A scheduled gathering of the Safety Directors' Forum to discuss HSSSEQ issues, review policy, and coordinate industry responses."
    SubClassOf: bfo:0000015, sdg:meetingId some xsd:string, sdg:meetingDate some xsd:dateTime, sdg:meetingType some sdg:MeetingTypeKind, sdg:venue some xsd:string, sdg:status some sdg:StatusKind, sdg:totalCost some xsd:decimal, sdg:chairedBy exactly 1 sdg:SafetyDirector, sdg:attendedBy min 2 sdg:SafetyDirector, sdg:generates some sdg:MeetingDocument, sdg:tracks some sdg:ActionItem

Class: sdg:HSSSEQIssue
    Annotations: rdfs:label "HSSSEQ Issue", iao:0000115 "A strategic Health, Safety, Security, Safeguards, Environment, or Quality matter identified by the industry that requires response or improvement."
    SubClassOf: bfo:0000015, sdg:issueId some xsd:string, sdg:issueTitle some xsd:string, sdg:category some sdg:CategoryKind, sdg:riskLevel some sdg:RiskLevelKind, sdg:status some sdg:StatusKind, sdg:reportedDate some xsd:dateTime, sdg:originatesFrom some sdg:NuclearFacility, sdg:addressedBy some sdg:SubGroup, sdg:influences some sdg:PolicyDocument
    HasKey: sdg:issueId

Class: sdg:SubGroup
    Annotations: rdfs:label "Sub Group", iao:0000115 "A dedicated working group established by the Forum to focus on specific HSSSEQ topics or technical matters."
    SubClassOf: bfo:0000040, sdg:subGroupId some xsd:string, sdg:subGroupTitle some xsd:string, sdg:focusArea some sdg:FocusAreaKind, sdg:isActive some xsd:boolean, sdg:establishedDate some xsd:date, sdg:sponsoredBy exactly 1 sdg:SafetyDirector, sdg:addresses min 2 sdg:HSSSEQIssue, sdg:produces some sdg:MeetingDocument

Class: sdg:MeetingDocument
    Annotations: rdfs:label "Meeting Document", iao:0000115 "A record, agenda, minutes, or report generated from or associated with a Forum meeting or Sub Group activity."
    SubClassOf: cco:ont00000958, sdg:documentId some xsd:string, sdg:documentType some sdg:DocumentTypeKind, sdg:publicationDate some xsd:date, sdg:version some xsd:string, sdg:isPublic some xsd:boolean, sdg:relatedToMeeting max 1 sdg:ForumMeeting, sdg:createdBy exactly 1 sdg:SafetyDirector, sdg:containsAction some sdg:ActionItem

Class: sdg:ActionItem
    Annotations: rdfs:label "Action Item", iao:0000115 "A specific task or responsibility assigned during a meeting to address an issue or follow up on a discussion."
    SubClassOf: bfo:0000015, sdg:actionId some xsd:string, sdg:description some xsd:string, sdg:dueDate some xsd:date, sdg:priority some xsd:string, sdg:status some sdg:StatusKind, sdg:assignedTo exactly 1 sdg:SafetyDirector, sdg:linkedToIssue max 1 sdg:HSSSEQIssue, sdg:recordedIn exactly 1 sdg:MeetingDocument

Class: sdg:CooperativeAgreement
    Annotations: rdfs:label "Cooperative Agreement", iao:0000115 "A formal partnership arrangement between two organizations to collaborate on shared goals in the field of augmentative and alternative communication."
    SubClassOf: sdg:CommunityEntity, sdg:agreementIdentifier some xsd:string, sdg:startDate some xsd:dateTime, sdg:endDate some xsd:dateTime, sdg:status some sdg:StatusKind, sdg:description some xsd:string, sdg:agreementStatus some xsd:string, sdg:initiatedBy min 2 sdg:Organization, sdg:hasObjective some sdg:CommunicationGoal

Class: sdg:AssistiveTechnology
    Annotations: rdfs:label "Assistive Technology", iao:0000115 "A manufactured device, system, or software designed to enhance learning, working, or daily living for persons with disabilities."
    SubClassOf: sdg:System, sdg:technologyIdentifier some xsd:string, sdg:productName some xsd:string, sdg:technologyType some sdg:TechnologyTypeKind, sdg:manufacturer some xsd:string, sdg:availabilityStatus some xsd:string, sdg:manufacturedBy some sdg:Organization, sdg:usedBy some sdg:Individual, sdg:supports some sdg:CommunicationGoal

Class: sdg:CommunicationGoal
    Annotations: rdfs:label "Communication Goal", iao:0000115 "A specific objective related to the promotion, recognition, or utilization of augmentative and alternative communication methods."
    SubClassOf: bfo:0000015, sdg:goalIdentifier some xsd:string, sdg:goalDescription some xsd:string, sdg:targetAudience some sdg:TargetAudienceKind, sdg:priorityLevel some sdg:PriorityLevelKind, sdg:pursuedBy some sdg:Organization, sdg:supportedBy some sdg:AssistiveTechnology, sdg:achievedBy some sdg:Individual

Class: sdg:CapacityAssessment
    Annotations: rdfs:label "Capacity Assessment", iao:0000115 "A decision-making process or activity performed by a clinician or assessor to determine whether a specific individual possesses the mental capacity to make a particular decision at a specific time."
    SubClassOf: sdg:AssessmentTool, sdg:assessmentIdentifier some xsd:string, sdg:assessmentDate some xsd:dateTime, sdg:decisionTopic some xsd:string, sdg:assessorRole some sdg:AssessorRoleKind, sdg:outcome some sdg:OutcomeKind, sdg:supportProvided some xsd:string, sdg:assesses exactly 1 sdg:Individual, sdg:evaluates exactly 1 sdg:DecisionContext, sdg:triggers max 1 sdg:BestInterestDetermination, sdg:performerRole some sdg:Clinician

Class: sdg:DecisionContext
    Annotations: rdfs:label "Decision Context", iao:0000115 "A specific matter, choice, or action requiring a decision, such as medical treatment, financial management, or living arrangements, which serves as the focus of a capacity assessment."
    SubClassOf: bfo:0000040, sdg:contextIdentifier some xsd:string, sdg:decisionCategory some xsd:string, sdg:urgencyLevel some xsd:string, sdg:riskLevel some sdg:RiskLevelKind, sdg:description some xsd:string, sdg:evaluatedBy exactly 1 sdg:CapacityAssessment, sdg:subjectOf exactly 1 sdg:BestInterestDetermination, sdg:involves min 2 sdg:Intervention

Class: sdg:LegalRepresentative
    Annotations: rdfs:label "Legal Representative", iao:0000115 "A real, dependent continuant entity representing a person or body (such as a guardian, attorney, or family member) authorized to make decisions or act on behalf of an individual who lacks capacity."
    SubClassOf: sdg:LegalEntity, sdg:representativeIdentifier some xsd:string, sdg:relationshipType some sdg:RelationshipTypeKind, sdg:authorizationDate some xsd:dateTime, sdg:scopeOfAuthority some sdg:ScopeOfAuthorityKind, sdg:contactInformation some xsd:string, sdg:representativeRole some xsd:string, sdg:represents exactly 1 sdg:Individual, sdg:conducts min 2 sdg:BestInterestDetermination, sdg:authorizes min 2 sdg:Intervention

Class: sdg:GaulishTribe
    Annotations: rdfs:label "Gaulish Tribe", iao:0000115 "A named social-political grouping of people in ancient Gaul, often identified by ethnonyms and settlement areas."
    SubClassOf: bfo:0000023, sdg:tribeName some xsd:string, sdg:primaryOccupation some xsd:string, sdg:settlementRegion some xsd:string, sdg:ethnicity some xsd:string, sdg:isCeltic some xsd:boolean, sdg:ethnonym some xsd:string, sdg:settlementArea some xsd:string, sdg:isCelticOrigin some xsd:boolean, sdg:slavicEtymology some xsd:string, sdg:inhabited some sdg:SettlementArea, sdg:leftInscription some sdg:AncientInscription, sdg:hasToponym min 2 sdg:Toponym, sdg:hasInscription some sdg:EpigraphicInscription, sdg:inhabitsRegion exactly 1 sdg:HistoricalRegion

Class: sdg:SettlementArea
    Annotations: rdfs:label "Settlement Area", iao:0000115 "A geographic region or territory historically occupied by a specific Gaulish tribe or community."
    SubClassOf: bfo:0000015, sdg:regionName some xsd:string, sdg:geographicCoordinates some xsd:string, sdg:historicalPeriod some xsd:string, sdg:isCoastal some xsd:boolean, sdg:occupiedBy some sdg:GaulishTribe, sdg:containsToponym some sdg:Toponym

Class: sdg:Toponym
    Annotations: rdfs:label "Toponym", iao:0000115 "A named place or geographic feature in ancient Gaul, often analyzed for etymological roots."
    SubClassOf: cco:ont00000995, sdg:placeName some xsd:string, sdg:etymologicalRoot some xsd:string, sdg:linguisticFamily some xsd:string, sdg:locationReference some xsd:string, sdg:confidenceScore some xsd:decimal, sdg:name some sdg:NameKind, sdg:region some sdg:RegionKind, sdg:slavicRoot some xsd:string, sdg:sourceMap some xsd:string, sdg:confidenceLevel some sdg:ConfidenceLevelKind, sdg:locatedIn exactly 1 sdg:SettlementArea, sdg:derivedFrom some sdg:LinguisticRoot, sdg:locatedIn exactly 1 sdg:HistoricalRegion, sdg:associatedWithTribe some sdg:GaulishTribe, sdg:recordedIn some sdg:HistoricalDocument

Class: sdg:AncientInscription
    Annotations: rdfs:label "Ancient Inscription", iao:0000115 "A physical or textual record of writing found in ancient Gaul, used for linguistic and historical analysis."
    SubClassOf: cco:ont00000995, sdg:inscriptionID some xsd:string, sdg:scriptType some xsd:string, sdg:discoveryLocation some xsd:string, sdg:dateDiscovered some xsd:date, sdg:decipheredText some xsd:string, sdg:linguisticInterpretation some xsd:string, sdg:foundIn exactly 1 sdg:SettlementArea, sdg:attributedTo some sdg:GaulishTribe, sdg:usesScript exactly 1 sdg:WritingSystem

Class: sdg:WritingSystem
    Annotations: rdfs:label "Writing System", iao:0000115 "A system of visual representation of language used in ancient Gaul, such as Greek or Latin scripts."
    SubClassOf: sdg:Book, sdg:systemName some xsd:string, sdg:originRegion some xsd:string, sdg:usagePeriod some xsd:string, sdg:isAlphabetic some xsd:boolean, sdg:usedBy some sdg:GaulishTribe, sdg:records some sdg:AncientInscription

Class: sdg:LinguisticRoot
    Annotations: rdfs:label "Linguistic Root", iao:0000115 "A foundational word or morpheme from a specific language family, used to explain the etymology of Gaulish names."
    SubClassOf: cco:ont00000995, sdg:rootWord some xsd:string, sdg:meaning some xsd:string, sdg:sourceLanguage some xsd:string, sdg:semanticField some xsd:string, sdg:explains some sdg:Toponym, sdg:explains some sdg:GaulishTribe

Class: sdg:ClinicalDocumentation
    Annotations: rdfs:label "Clinical Documentation", iao:0000115 "A record or dataset created by a provider to document patient care, treatment plans, and insurance requirements."
    SubClassOf: cco:ont00000995, sdg:docId some xsd:string, sdg:docType some xsd:string, sdg:creationDate some xsd:dateTime, sdg:status some sdg:StatusKind, sdg:containsSupplementReview some xsd:boolean, sdg:isPublicFacing some xsd:boolean, sdg:createdBy exactly 1 sdg:Provider, sdg:pertainsTo exactly 1 sdg:Patient, sdg:storedIn exactly 1 sdg:ChartingSoftware

Class: sdg:ChartingSoftware
    Annotations: rdfs:label "Charting Software", iao:0000115 "A digital system or application used by the clinic to manage patient records, scheduling, and billing."
    SubClassOf: sdg:SecuritySystemComponent, sdg:softwareId some xsd:string, sdg:softwareName some xsd:string, sdg:version some xsd:string, sdg:hasBillingModule some xsd:boolean, sdg:hasSchedulingModule some xsd:boolean, sdg:isCloudBased some xsd:boolean, sdg:stores min 2 sdg:ClinicalDocumentation, sdg:usedBy min 2 sdg:Provider

Class: sdg:EpigraphicInscription
    Annotations: rdfs:label "Epigraphic Inscription", iao:0000115 "A physical or textual record of writing in Greek or Latin characters found in Gaul, interpreted through Slavic linguistic analysis."
    SubClassOf: bfo:00000995, sdg:inscriptionText some xsd:string, sdg:scriptType some xsd:string, sdg:discoveryLocation some xsd:string, sdg:decipheredMeaning some xsd:string, sdg:sourceReference some xsd:string, sdg:foundInRegion exactly 1 sdg:HistoricalRegion, sdg:analyzedBy exactly 1 sdg:LinguisticAnalysis, sdg:associatedWithTribe some sdg:GaulishTribe

Class: sdg:LinguisticAnalysis
    Annotations: rdfs:label "Linguistic Analysis", iao:0000115 "A scholarly interpretation or decipherment of ancient names or texts based on Slavic linguistic correspondences."
    SubClassOf: bfo:0000015, sdg:methodology some xsd:string, sdg:slavicLanguageBasis some xsd:string, sdg:interpretationResult some xsd:string, sdg:author some xsd:string, sdg:publicationYear some xsd:integer, sdg:analyzesInscription some sdg:EpigraphicInscription, sdg:analyzesToponym some sdg:Toponym, sdg:citesSource some sdg:HistoricalDocument

Class: sdg:HistoricalRegion
    Annotations: rdfs:label "Historical Region", iao:0000115 "A defined geographical area in ancient Europe, such as Armorica or Gaul, characterized by specific settlement patterns and cultural influences."
    SubClassOf: bfo:0000015, sdg:regionName some xsd:string, sdg:geographicalBounds some xsd:string, sdg:dominantCulture some xsd:string, sdg:slavicInfluenceLevel some xsd:string, sdg:historicalPeriod some xsd:string, sdg:containsToponyms min 2 sdg:Toponym, sdg:containsTribe min 2 sdg:GaulishTribe, sdg:containsInscription some sdg:EpigraphicInscription

Class: sdg:HistoricalDocument
    Annotations: rdfs:label "Historical Document", iao:0000115 "A recorded source, such as a map, itinerary, or scholarly book, used to identify and analyze ancient toponyms and inscriptions."
    SubClassOf: sdg:Book, sdg:documentTitle some xsd:string, sdg:author some xsd:string, sdg:publicationYear some xsd:integer, sdg:documentType some sdg:DocumentTypeKind, sdg:contentSummary some xsd:string, sdg:citedByAnalysis some sdg:LinguisticAnalysis, sdg:recordsToponym some sdg:Toponym, sdg:recordsInscription some sdg:EpigraphicInscription

Class: sdg:EnergyResource
    Annotations: rdfs:label "Energy Resource", iao:0000115 "A natural or engineered accumulation of energy-bearing matter or field that serves as a source for energy extraction."
    SubClassOf: sdg:Resource, sdg:resourceIdentifier some xsd:string, sdg:resourceName some xsd:string, sdg:renewabilityStatus some xsd:string, sdg:exploitationRate some xsd:decimal, sdg:expectedReservesYears some xsd:integer, sdg:shareInEnergyMix some xsd:decimal, sdg:classificationStandard some xsd:string, sdg:subjectTo some sdg:EnergyExtraction, sdg:locatedIn exactly 1 sdg:GeologicalFormation

Class: sdg:EnergyExtraction
    Annotations: rdfs:label "Energy Extraction", iao:0000115 "The industrial process of removing usable energy from a natural resource for conversion into power."
    SubClassOf: sdg:Resource, sdg:extractionId some xsd:string, sdg:extractionDate some xsd:dateTime, sdg:extractionMethod some xsd:string, sdg:extractionRate some xsd:decimal, sdg:sustainabilityStatus some sdg:SustainabilityStatusKind, sdg:capacityInstalled some xsd:decimal, sdg:capacityLimited some xsd:decimal, sdg:extractsFrom exactly 1 sdg:EnergyResource, sdg:usesMechanism exactly 1 sdg:HeatTransportMechanism, sdg:produces some sdg:EnergyOutput

Class: sdg:HeatTransportMechanism
    Annotations: rdfs:label "Heat Transport Mechanism", iao:0000115 "The physical process by which thermal energy moves within a geological system, determining recharge rates."
    SubClassOf: bfo:0000015, sdg:mechanismId some xsd:string, sdg:mechanismType some xsd:string, sdg:transportSpeed some sdg:TransportSpeedKind, sdg:rechargeRate some xsd:decimal, sdg:timeScale some xsd:string, sdg:governs some sdg:EnergyResource, sdg:enables some sdg:EnergyExtraction

Class: sdg:GeologicalFormation
    Annotations: rdfs:label "Geological Formation", iao:0000115 "A distinct body of rock or fluid-bearing strata that constitutes the physical container for an energy resource."
    SubClassOf: bfo:0000040, sdg:formationId some xsd:string, sdg:formationName some xsd:string, sdg:formationType some xsd:string, sdg:depth some xsd:decimal, sdg:temperature some xsd:decimal, sdg:locationRegion some xsd:string, sdg:contains some sdg:EnergyResource, sdg:exhibits some sdg:HeatTransportMechanism
    HasKey: sdg:formationId

Class: sdg:LineDanceRoutine
    Annotations: rdfs:label "Line Dance Routine", iao:0000115 "A choreographed sequence of footwork steps and calling suggestions designed for group performance to music."
    SubClassOf: bfo:0000040, sdg:routineIdentifier some xsd:string, sdg:title some xsd:string, sdg:level some sdg:LevelKind, sdg:totalWallCount some xsd:integer, sdg:totalCounts some xsd:integer, sdg:bpm some xsd:integer, sdg:trackStartOffset some xsd:integer, sdg:choreographerName some xsd:string, sdg:dedicationText some xsd:string, sdg:creationDate some xsd:dateTime, sdg:composedOf min 2 sdg:DanceSection, sdg:performedTo exactly 1 sdg:AudioTrack, sdg:createdBy exactly 1 sdg:Choreographer

Class: sdg:FootworkStep
    Annotations: rdfs:label "Footwork Step", iao:0000115 "A specific physical movement or maneuver executed by a dancer's feet during a routine."
    SubClassOf: sdg:stepName some xsd:string, sdg:footUsed some sdg:FootUsedKind, sdg:direction some sdg:DirectionKind, sdg:turnAngle some xsd:decimal, sdg:executionCount some xsd:integer, sdg:stepType some xsd:string, sdg:executedIn exactly 1 sdg:DanceSection

Class: sdg:Choreographer
    Annotations: rdfs:label "Choreographer", iao:0000115 "The individual responsible for designing and structuring the sequence of movements in a dance routine."
    SubClassOf: bfo:0000040, sdg:choreographerName some xsd:string, sdg:nationality some xsd:string, sdg:creationDate some xsd:dateTime, sdg:dedicationTarget some xsd:string, sdg:created min 2 sdg:LineDanceRoutine

Class: sdg:CareerTransition
    Annotations: rdfs:label "Career Transition", iao:0000115 "A process in which an individual shifts from one occupational state to another, such as moving from traditional retirement into paid later-life work or a second career."
    SubClassOf: bfo:0000015, sdg:transitionId some xsd:string, sdg:transitionType some sdg:TransitionTypeKind, sdg:startDate some xsd:dateTime, sdg:endDate some xsd:dateTime, sdg:description some xsd:string, sdg:involvesParticipant min 2 sdg:OlderAdult, sdg:observedInPhase exactly 1 sdg:ResearchPhase
    HasKey: sdg:transitionId

Class: sdg:OlderAdult
    Annotations: rdfs:label "Older Adult", iao:0000115 "An individual aged 60 or older who is the subject of career development research, particularly regarding later-life work and retirement transitions."
    SubClassOf: bfo:0000040, sdg:participantId some xsd:string, sdg:age some xsd:integer, sdg:gender some sdg:GenderKind, sdg:employmentStatus some sdg:EmploymentStatusKind, sdg:previousOccupation some xsd:string, sdg:undergoesTransition some sdg:CareerTransition, sdg:providesDataFor some sdg:ResearchPhase

Class: sdg:ResearchPhase
    Annotations: rdfs:label "Research Phase", iao:0000115 "A distinct stage of the Redirection Project's empirical investigation, such as Phase 1 (volunteer work), Phase 2 (volunteer work), or Phase 3 (practitioner perspectives)."
    SubClassOf: sdg:ResearchEntity, sdg:phaseId some xsd:string, sdg:phaseNumber some xsd:integer, sdg:focusArea some sdg:FocusAreaKind, sdg:startDate some xsd:dateTime, sdg:endDate some xsd:dateTime, sdg:status some sdg:StatusKind, sdg:ledBy exactly 1 sdg:PrincipalInvestigator, sdg:supportedBy some sdg:ResearchCoordinator, sdg:assistedBy min 2 sdg:ResearchAssistant

Class: sdg:PrincipalInvestigator
    Annotations: rdfs:label "Principal Investigator", iao:0000115 "The lead researcher responsible for the design, execution, and oversight of the Redirection Project."
    SubClassOf: bfo:0000040, sdg:investigatorId some xsd:string, sdg:fullName some xsd:string, sdg:title some xsd:string, sdg:affiliation some sdg:AffiliationKind, sdg:contactEmail some xsd:string, sdg:leadsPhase min 2 sdg:ResearchPhase

Class: sdg:ResearchCoordinator
    Annotations: rdfs:label "Research Coordinator", iao:0000115 "A staff member responsible for the administrative and operational management of the research project."
    SubClassOf: bfo:0000040, sdg:coordinatorId some xsd:string, sdg:fullName some xsd:string, sdg:roleDetail some sdg:RoleKind, sdg:startDate some xsd:dateTime, sdg:endDate some xsd:dateTime, sdg:supportsPhase some sdg:ResearchPhase

Class: sdg:ResearchAssistant
    Annotations: rdfs:label "Research Assistant", iao:0000115 "A student or junior researcher providing assistance with data collection, analysis, or project completion."
    SubClassOf: sdg:ResearchEntity, sdg:assistantId some xsd:string, sdg:fullName some xsd:string, sdg:degree some xsd:string, sdg:institution some xsd:string, sdg:assistsPhase min 2 sdg:ResearchPhase

Class: sdg:FundingGrant
    Annotations: rdfs:label "Funding Grant", iao:0000115 "A financial award provided by an organization to support the research project."
    SubClassOf: cco:ont00000995, sdg:grantId some xsd:string, sdg:funderName some xsd:string, sdg:amount some xsd:decimal, sdg:awardDate some xsd:date, sdg:purpose some sdg:PurposeKind, sdg:fundsPhase min 2 sdg:ResearchPhase

Class: sdg:Credential
    Annotations: rdfs:label "Credential", iao:0000115 "A formal recognition issued by an educational institution to a student who has successfully completed all requirements of an approved program of study."
    SubClassOf: cco:ont00000995, sdg:credentialId some xsd:string, sdg:credentialType some sdg:CredentialTypeKind, sdg:programName some xsd:string, sdg:issuingInstitution some xsd:string, sdg:issueDate some xsd:date, sdg:status some sdg:StatusKind, sdg:honoursNotation some xsd:boolean, sdg:awardedTo exactly 1 sdg:Student, sdg:conferredBy exactly 1 sdg:ProgramOfStudy, sdg:requiredFor some sdg:AdmissionRequirement, sdg:awardedBy exactly 1 sdg:Institution

Class: sdg:ProgramOfStudy
    Annotations: rdfs:label "Program of Study", iao:0000115 "An approved curriculum or course of study leading to a specific credential, with defined requirements and standard length."
    SubClassOf: sdg:programCode some xsd:string, sdg:programName some xsd:string, sdg:approvalAuthority some sdg:ApprovalAuthorityKind, sdg:standardLength some xsd:integer, sdg:completionDeadlineMultiplier some xsd:decimal, sdg:isApprenticeProgram some xsd:boolean, sdg:currentVersion some xsd:string, sdg:awards min 1 sdg:Credential, sdg:requiresResidencyFrom exactly 1 sdg:Institution

Class: sdg:Parchment
    Annotations: rdfs:label "Parchment", iao:0000115 "The physical or digital document certifying the award of a credential to a graduate."
    SubClassOf: cco:ont00000995, sdg:parchmentId some xsd:string, sdg:issueDate some xsd:date, sdg:graduateName some xsd:string, sdg:programNameAtGraduation some xsd:string, sdg:honoursNotation some xsd:boolean, sdg:isReissued some xsd:boolean, sdg:revocationReason some xsd:string, sdg:issuedTo exactly 1 sdg:Student, sdg:certifies exactly 1 sdg:Credential

Class: sdg:GraduationEligibilityCheck
    Annotations: rdfs:label "Graduation Eligibility Check", iao:0000115 "A verification process performed by the Registrar's office to determine if a student meets all requirements for graduation."
    SubClassOf: bfo:0000015, sdg:checkId some xsd:string, sdg:checkDate some xsd:dateTime, sdg:eligibilityStatus some xsd:string, sdg:ggpaMet some xsd:boolean, sdg:residencyMet some xsd:boolean, sdg:financialObligationsMet some xsd:boolean, sdg:completionDeadlineMet some xsd:boolean, sdg:evaluates exactly 1 sdg:Student, sdg:verifiesFor exactly 1 sdg:ProgramOfStudy, sdg:triggers max 1 sdg:Parchment

Class: sdg:ExceptionRecord
    Annotations: rdfs:label "Exception Record", iao:0000115 "A documented and formally approved deviation from the standard graduation procedure."
    SubClassOf: cco:ont00000995, sdg:exceptionId some xsd:string, sdg:exceptionDate some xsd:dateTime, sdg:natureOfException some xsd:string, sdg:alignmentConfirmation some xsd:boolean, sdg:riskDescription some xsd:string, sdg:approvalStatus some sdg:ApprovalStatusKind, sdg:appliesTo exactly 1 sdg:Student, sdg:relatedTo exactly 1 sdg:ProgramOfStudy

Class: sdg:AssessmentNotice
    Annotations: rdfs:label "Assessment Notice", iao:0000115 "An official document issued by the Board of Assessors notifying property owners of their property's assessed value and providing details for appeals or corrections."
    SubClassOf: sdg:Document, sdg:noticeId some xsd:string, sdg:issueDate some xsd:date, sdg:propertyType some sdg:PropertyTypeKind, sdg:noticeType some xsd:string, sdg:status some sdg:StatusKind, sdg:propertyIdentifier some xsd:string, sdg:assessmentScope some xsd:string, sdg:noticeIdentifier some xsd:string, sdg:noticePeriod some xsd:integer, sdg:taxYear some xsd:integer, sdg:pertainsTo exactly 1 sdg:PropertyParcel, sdg:issuedBy exactly 1 sdg:BoardOfAssessors, sdg:issuedFor exactly 1 sdg:PropertyParcel, sdg:submittedBy exactly 1 sdg:ChiefAppraiser

Class: sdg:PropertyExemption
    Annotations: rdfs:label "Property Exemption", iao:0000115 "A legal provision that reduces or eliminates the taxable value of a property based on specific criteria such as capital improvements, historic rehabilitation, or personal property status."
    SubClassOf: cco:ont00000995, sdg:exemptionId some xsd:string, sdg:exemptionType some xsd:string, sdg:approvalDate some xsd:dateTime, sdg:status some sdg:StatusKind, sdg:propertyIdentifier some xsd:string, sdg:applicableYear some xsd:integer, sdg:exemptionIdentifier some xsd:string, sdg:taxYear some xsd:integer, sdg:reductionAmount some xsd:decimal, sdg:applicationDate some xsd:dateTime, sdg:appliesTo some sdg:PropertyParcel, sdg:approvedBy exactly 1 sdg:BoardOfAssessors, sdg:grantedBy exactly 1 sdg:BoardOfAssessors
    HasKey: sdg:exemptionId

Class: sdg:AppealWaiver
    Annotations: rdfs:label "Appeal Waiver", iao:0000115 "A formal document certifying that a property owner has waived their right to appeal a property assessment decision to the Board of Equalization."
    SubClassOf: cco:ont00000995, sdg:waiverId some xsd:string, sdg:waiverDate some xsd:date, sdg:propertyIdentifier some xsd:string, sdg:status some sdg:StatusKind, sdg:certifiedByDetail some xsd:string, sdg:pertainsTo exactly 1 sdg:PropertyParcel, sdg:certifiedTo exactly 1 sdg:BoardOfEqualization

Class: sdg:BoardOfAssessors
    Annotations: rdfs:label "Board of Assessors", iao:0000115 "A governmental body responsible for assessing property values and managing related administrative processes."
    SubClassOf: bfo:0000040, sdg:boardId some xsd:string, sdg:jurisdiction some sdg:JurisdictionKind, sdg:meetingDate some xsd:dateTime, sdg:status some sdg:StatusKind, sdg:boardIdentifier some xsd:string, sdg:establishedDate some xsd:date, sdg:currentSession some xsd:string, sdg:issues some sdg:AssessmentNotice, sdg:approves some sdg:PropertyExemption, sdg:convenes some sdg:BoardMeeting, sdg:oversees exactly 1 sdg:ChiefAppraiser

Class: sdg:BoardOfEqualization
    Annotations: rdfs:label "Board of Equalization", iao:0000115 "A higher-level governmental body that reviews and certifies appeal waivers and other assessment-related decisions."
    SubClassOf: bfo:0000040, sdg:boardId some xsd:string, sdg:jurisdiction some sdg:JurisdictionKind, sdg:meetingDate some xsd:dateTime, sdg:status some sdg:StatusKind, sdg:receives some sdg:AppealWaiver

Class: sdg:Tournament
    Annotations: rdfs:label "Tournament", iao:0000115 "A structured competitive event for chess games governed by ICCF rules."
    SubClassOf: sdg:CompetitionEntity, sdg:tournamentId some xsd:string, sdg:startDate some xsd:dateTime, sdg:endDate some xsd:dateTime, sdg:format some sdg:FormatKind, sdg:status some sdg:StatusKind, sdg:timeControl some xsd:string, sdg:tdId some xsd:string, sdg:tournamentName some xsd:string, sdg:location some xsd:string, sdg:managerName some xsd:string, sdg:managerAddress some xsd:string, sdg:hasPlayer min 2 sdg:Player, sdg:hasGame min 2 sdg:ChessGame, sdg:hasCaptain max 1 sdg:TeamCaptain, sdg:enforcesRule some sdg:TournamentRule, sdg:awardsPrizeTo some sdg:Prize, sdg:manages some sdg:Bowler

Class: sdg:ChessGame
    Annotations: rdfs:label "Chess Game", iao:0000115 "A single contest between two players, tracked via move cards or electronic transmission."
    SubClassOf: bfo:0000015, sdg:gameId some xsd:string, sdg:startDate some xsd:dateTime, sdg:endDate some xsd:dateTime, sdg:status some sdg:StatusKind, sdg:timeControl some xsd:string, sdg:notationType some xsd:string, sdg:transmissionMethod some xsd:string, sdg:moveCount some xsd:integer, sdg:hasPlayer1 exactly 1 sdg:Player, sdg:hasPlayer2 exactly 1 sdg:Player, sdg:partOfTournament exactly 1 sdg:Tournament, sdg:hasMoveCard min 2 sdg:MoveCard, sdg:hasDispute max 1 sdg:Dispute
    HasKey: sdg:gameId

Class: sdg:Dispute
    Annotations: rdfs:label "Dispute", iao:0000115 "A conflict or ambiguity in a game requiring resolution by the Tournament Director."
    SubClassOf: bfo:0000015, sdg:disputeId some xsd:string, sdg:gameId some xsd:string, sdg:type some sdg:TypeKind, sdg:status some sdg:StatusKind, sdg:resolution some sdg:ResolutionKind, sdg:arisesIn exactly 1 sdg:ChessGame, sdg:resolvedBy exactly 1 sdg:TournamentDirector, sdg:involvesPlayer min 2 sdg:Player

Class: sdg:RecertificationApplication
    Annotations: rdfs:label "Recertification Application", iao:0000115 "A formal record submitted by a certified professional to request renewal of their certification status, listing earned recertification units and associated fees."
    SubClassOf: sdg:Document, sdg:applicationId some xsd:string, sdg:submissionDate some xsd:dateTime, sdg:feeAmount some xsd:decimal, sdg:status some sdg:StatusKind, sdg:verificationStatus some sdg:VerificationStatusKind, sdg:ethicsPledgeSigned some xsd:boolean, sdg:ruTotalEarned some xsd:integer, sdg:ruRequired some xsd:integer, sdg:submittedBy exactly 1 sdg:CertifiedProfessional, sdg:containsRURecord min 2 sdg:RecertificationUnitRecord, sdg:hasRecertificationUnits some sdg:ProfessionalDocument

Class: sdg:CertifiedProfessional
    Annotations: rdfs:label "Certified Professional", iao:0000115 "An individual holding a professional certification who is subject to recertification requirements and ethical pledges."
    SubClassOf: bfo:0000023, sdg:professionalId some xsd:string, sdg:certificationStatus some sdg:CertificationStatusKind, sdg:currentCertificationPeriodStart some xsd:date, sdg:currentCertificationPeriodEnd some xsd:date, sdg:ruRequirement some xsd:integer, sdg:codeOfEthicsPledge some xsd:boolean, sdg:employmentType some sdg:EmploymentTypeKind, sdg:submitsApplication max 1 sdg:RecertificationApplication, sdg:holdsRoleIn some sdg:ProfessionalSocietyRole

Class: sdg:RecertificationUnitRecord
    Annotations: rdfs:label "Recertification Unit Record", iao:0000115 "A specific entry documenting a single activity or achievement that contributes to the total recertification units required for certification renewal."
    SubClassOf: cco:ont00000995, sdg:recordId some xsd:string, sdg:activityCategory some sdg:ActivityCategoryKind, sdg:subCategory some xsd:string, sdg:ruCreditsEarned some xsd:integer, sdg:activityDate some xsd:dateTime, sdg:appliesToBodyOfKnowledge some xsd:boolean, sdg:doubleCountingAllowed some xsd:boolean, sdg:verificationRequired some xsd:boolean, sdg:partOfApplication exactly 1 sdg:RecertificationApplication, sdg:linkedToActivity exactly 1 sdg:ProfessionalActivity

Class: sdg:ProfessionalActivity
    Annotations: rdfs:label "Professional Activity", iao:0000115 "A measurable professional engagement or contribution that qualifies for recertification units, such as publishing, teaching, or attending conferences."
    SubClassOf: sdg:ProgramActivity, sdg:activityId some xsd:string, sdg:activityType some sdg:ActivityTypeKind, sdg:startDate some xsd:dateTime, sdg:endDate some xsd:dateTime, sdg:authorshipRole some xsd:string, sdg:accreditationStatus some sdg:AccreditationStatusKind, sdg:isPartOfRegularDuties some xsd:boolean, sdg:creditsAwarded some xsd:integer, sdg:performedBy exactly 1 sdg:CertifiedProfessional, sdg:associatedWithDocument max 1 sdg:ProfessionalDocument, sdg:associatedWithCourse max 1 sdg:Course

Class: sdg:ProfessionalDocument
    Annotations: rdfs:label "Professional Document", iao:0000115 "A published work such as a journal article, magazine transaction, or conference proceeding that contributes to recertification units."
    SubClassOf: sdg:Document, sdg:documentId some xsd:string, sdg:title some xsd:string, sdg:publicationDate some xsd:date, sdg:publisher some xsd:string, sdg:documentType some sdg:DocumentTypeKind, sdg:appliesToBodyOfKnowledge some xsd:boolean, sdg:claimedOncePerPeriod some xsd:boolean, sdg:totalAuthors some xsd:integer, sdg:authoredBy some sdg:CertifiedProfessional, sdg:linkedToActivity exactly 1 sdg:ProfessionalActivity

Class: sdg:ProfessionalSocietyRole
    Annotations: rdfs:label "Professional Society Role", iao:0000115 "A position held within a professional society, such as officer, committee chair, or member, which contributes to recertification units on a per-year basis."
    SubClassOf: sdg:Role, sdg:roleInstanceId some xsd:string, sdg:roleTitle some sdg:RoleTitleKind, sdg:societyName some xsd:string, sdg:startDate some xsd:dateTime, sdg:endDate some xsd:dateTime, sdg:ruCreditsPerYear some xsd:integer, sdg:appliesToBodyOfKnowledge some xsd:boolean, sdg:heldBy exactly 1 sdg:CertifiedProfessional, sdg:linkedToActivity exactly 1 sdg:ProfessionalActivity
    HasKey: sdg:roleInstanceId

Class: sdg:PersonalDataRecord
    Annotations: rdfs:label "Personal Data Record", iao:0000115 "A data record containing personal information about an individual or household collected by Monro through its digital platforms and physical stores."
    SubClassOf: sdg:recordId some xsd:string, sdg:collectionDate some xsd:dateTime, sdg:dataCategory some xsd:string, sdg:isSensitive some xsd:boolean, sdg:retentionPeriodMonths some xsd:integer, sdg:disclosureStatus some xsd:string, sdg:collectedVia exactly 1 sdg:DigitalPlatform, sdg:linkedTo some sdg:CustomerProfile, sdg:sharedWith some sdg:ThirdPartyVendor

Class: sdg:TrackingSoftware
    Annotations: rdfs:label "Tracking Software", iao:0000115 "Third-party software utilities used to collect visitor behavior data and provide measurement services for digital platforms."
    SubClassOf: sdg:SecuritySystemComponent, sdg:softwareId some xsd:string, sdg:softwareName some xsd:string, sdg:providerName some xsd:string, sdg:functionType some sdg:FunctionTypeKind, sdg:dataCollected some xsd:string, sdg:installedOn some sdg:DigitalPlatform, sdg:processesDataFor some sdg:PersonalDataRecord

Class: sdg:CustomerProfile
    Annotations: rdfs:label "Customer Profile", iao:0000115 "An aggregated representation of a customer's preferences and history derived from collected personal data and commercial records."
    SubClassOf: cco:ont00000995, sdg:profileId some xsd:string, sdg:customerName some xsd:string, sdg:householdId some xsd:string, sdg:profileStatus some xsd:string, sdg:lastUpdated some xsd:dateTime, sdg:preferenceTags some xsd:string, sdg:composedOf min 2 sdg:PersonalDataRecord, sdg:linkedTo some sdg:PurchaseTransaction

Class: sdg:PurchaseTransaction
    Annotations: rdfs:label "Purchase Transaction", iao:0000115 "A commercial record detailing the purchase of goods or services by a customer, including payment and product information."
    SubClassOf: cco:ont00000995, sdg:transactionId some xsd:string, sdg:transactionDate some xsd:dateTime, sdg:totalAmount some xsd:decimal, sdg:paymentMethod some sdg:PaymentMethodKind, sdg:storeLocation some xsd:string, sdg:itemsPurchased some xsd:string, sdg:associatedWith exactly 1 sdg:CustomerProfile, sdg:processedBy some sdg:ThirdPartyVendor
    HasKey: sdg:transactionId

Class: sdg:ThirdPartyVendor
    Annotations: rdfs:label "Third Party Vendor", iao:0000115 "An external entity or service provider that receives personal data for specific purposes such as payment processing, analytics, or advertising."
    SubClassOf: cco:ont00000995, sdg:vendorId some xsd:string, sdg:vendorName some xsd:string, sdg:serviceType some sdg:ServiceTypeKind, sdg:dataAccessLevel some sdg:DataAccessLevelKind, sdg:contractStartDate some xsd:date, sdg:receivesDataFrom some sdg:PersonalDataRecord, sdg:processesTransactionFor some sdg:PurchaseTransaction
    HasKey: sdg:vendorId

Class: sdg:VehicleIdentificationRecord
    Annotations: rdfs:label "Vehicle Identification Record", iao:0000115 "A record containing vehicle details extracted from license plate images via optical character recognition software in the mobile app."
    SubClassOf: cco:ont00000995, sdg:recordId some xsd:string, sdg:licensePlateNumber some xsd:string, sdg:stateIssued some xsd:string, sdg:vehicleMake some xsd:string, sdg:vehicleModel some xsd:string, sdg:captureTimestamp some xsd:dateTime, sdg:ocrConfidenceScore some xsd:decimal, sdg:linkedTo some sdg:CustomerProfile, sdg:derivedFrom exactly 1 sdg:PersonalDataRecord

Class: sdg:MedicalPractice
    Annotations: rdfs:label "Medical Practice", iao:0000115 "A fixed administrative and physical facility providing primary healthcare services to a registered patient population."
    SubClassOf: sdg:HealthcareEntity, sdg:practiceName some xsd:string, sdg:registrationNumber some xsd:string, sdg:addressLine some xsd:string, sdg:postCode some xsd:string, sdg:telephoneNumber some xsd:string, sdg:websiteURL some xsd:string, sdg:lastUpdatedDate some xsd:dateTime, sdg:employs min 2 sdg:HealthcareProfessional, sdg:providesServiceTo min 2 sdg:Patient, sdg:locatedIn exactly 1 sdg:GeographicLocation, sdg:commissionedBy exactly 1 sdg:HealthAuthority, sdg:serviceDeliveryMode some sdg:Thing

Class: sdg:Medication
    Annotations: rdfs:label "Medication", iao:0000115 "A pharmaceutical substance prescribed to a patient for therapeutic or preventive purposes."
    SubClassOf: cco:ont00000995, sdg:medicationName some xsd:string, sdg:dosageForm some xsd:string, sdg:prescriptionStatus some sdg:PrescriptionStatusKind, sdg:transmissionDate some xsd:dateTime, sdg:medicationId some xsd:string, sdg:brandName some xsd:string, sdg:genericName some xsd:string, sdg:isFormulary some xsd:boolean, sdg:mmeLimit some xsd:decimal, sdg:controlledSubstanceSchedule some xsd:string, sdg:strength some xsd:string, sdg:administrationRoute some xsd:string, sdg:prescribedTo min 2 sdg:Patient, sdg:reviewedBy some sdg:HealthcareProfessional, sdg:hasPrescription min 2 sdg:Prescription, sdg:hasFactSheet exactly 1 sdg:MedicationFactSheet, sdg:administeredTo some sdg:Patient

Class: sdg:CodeOfConduct
    Annotations: rdfs:label "Code of Conduct", iao:0000115 "The formal document outlining the rights, responsibilities, and behavioral standards expected of students at Worcester Polytechnic Institute."
    SubClassOf: cco:ont00000958, sdg:documentId some xsd:string, sdg:title some xsd:string, sdg:effectiveDate some xsd:date, sdg:versionNumber some xsd:string, sdg:approvalDate some xsd:dateTime, sdg:issuingBody some xsd:string, sdg:governs min 2 sdg:Student, sdg:defines some sdg:InterimSuspension, sdg:defines some sdg:NoContactDirective, sdg:defines some sdg:StudentActivity

Class: sdg:InterimSuspension
    Annotations: rdfs:label "Interim Suspension", iao:0000115 "A temporary administrative action terminating a student's presence on campus prior to a formal hearing due to safety concerns."
    SubClassOf: bfo:0000015, sdg:suspensionId some xsd:string, sdg:impositionDate some xsd:dateTime, sdg:hearingDate some xsd:dateTime, sdg:issuingAuthorityDetail some xsd:string, sdg:reason some xsd:string, sdg:status some sdg:StatusKind, sdg:appliesTo exactly 1 sdg:Student, sdg:triggers exactly 1 sdg:Hearing, sdg:issuedBy exactly 1 sdg:DeanOfStudentsStaff

Class: sdg:NoContactDirective
    Annotations: rdfs:label "No Contact Directive", iao:0000115 "A directive restricting verbal, written, or third-party contact between specific students involved in a conduct matter."
    SubClassOf: cco:ont00000958, sdg:directiveId some xsd:string, sdg:issueDate some xsd:date, sdg:issuingOffice some xsd:string, sdg:contactType some sdg:ContactTypeKind, sdg:status some sdg:StatusKind, sdg:restrictsContactBetween min 2 sdg:Student, sdg:issuedBy exactly 1 sdg:DeanOfStudentsStaff

Class: sdg:StudentActivity
    Annotations: rdfs:label "Student Activity", iao:0000115 "A co-curricular or residential engagement, such as Greek life or campus organizations, governed by student contracts and agreements."
    SubClassOf: sdg:ProgramActivity, sdg:activityId some xsd:string, sdg:activityName some sdg:ActivityNameKind, sdg:category some sdg:CategoryKind, sdg:status some sdg:StatusKind, sdg:governingPolicy some xsd:string, sdg:activityCategory some sdg:ActivityCategoryKind, sdg:hasParticipant__escalated min 2 sdg:Student, sdg:subjectTo exactly 1 sdg:CodeOfConduct, sdg:managedBy exactly 1 sdg:DeanOfStudentsStaff

Class: sdg:Hearing
    Annotations: rdfs:label "Conduct Hearing", iao:0000115 "A formal proceeding conducted by the Campus Hearing Board to review matters related to interim suspensions or conduct violations."
    SubClassOf: bfo:0000015, sdg:hearingId some xsd:string, sdg:scheduledDate some xsd:dateTime, sdg:status some sdg:StatusKind, sdg:outcome some sdg:OutcomeKind, sdg:reviews exactly 1 sdg:InterimSuspension, sdg:conductedBy exactly 1 sdg:CampusHearingBoard, sdg:involves min 2 sdg:Student

Class: sdg:CampusHearingBoard
    Annotations: rdfs:label "Campus Hearing Board", iao:0000115 "A designated body authorized to conduct formal hearings regarding student conduct matters and interim suspensions."
    SubClassOf: bfo:0000040, sdg:boardId some xsd:string, sdg:boardName some xsd:string, sdg:establishedDate some xsd:date, sdg:conducts min 2 sdg:Hearing, sdg:oversees min 2 sdg:Student

Class: sdg:DeanOfStudentsStaff
    Annotations: rdfs:label "Dean of Students Staff", iao:0000115 "Administrative personnel responsible for the administration of the judicial system and authority to impose administrative sanctions."
    SubClassOf: bfo:0000040, sdg:staffId some xsd:string, sdg:roleTitle some sdg:RoleTitleKind, sdg:department some xsd:string, sdg:issues min 2 sdg:InterimSuspension, sdg:issues min 2 sdg:NoContactDirective, sdg:manages min 2 sdg:StudentActivity
    HasKey: sdg:staffId

Class: sdg:NonProfitOrganization
    Annotations: rdfs:label "Non-Profit Organization", iao:0000115 "A legally recognized entity established to pursue social, educational, or charitable purposes without distributing profits to owners."
    SubClassOf: sdg:Organization, sdg:organizationId some xsd:string, sdg:legalName some xsd:string, sdg:taxStatus some xsd:string, sdg:foundingDate some xsd:date, sdg:headquartersLocation some xsd:string, sdg:websiteUrl some xsd:string, sdg:contactPhoneNumber some xsd:string, sdg:profitDistributionPolicy some xsd:string, sdg:hasBoardAppointment some sdg:BoardAppointment, sdg:hasAffiliate some sdg:NonProfitOrganization, sdg:receivesFundingFrom some sdg:FundingSource
    HasKey: sdg:organizationId

Class: sdg:LawFirm
    Annotations: rdfs:label "Law Firm", iao:0000115 "A business entity providing legal services to clients, often specializing in specific practice areas."
    SubClassOf: bfo:0000040, sdg:firmId some xsd:string, sdg:firmName some xsd:string, sdg:foundingYear some xsd:integer, sdg:primaryPracticeAreas some xsd:string, sdg:officeLocations some xsd:string, sdg:legalEntityStatus some xsd:string, sdg:employsPartner some sdg:Person

Class: sdg:FundingSource
    Annotations: rdfs:label "Funding Source", iao:0000115 "An entity or mechanism providing financial support to a non-profit organization."
    SubClassOf: bfo:0000040, sdg:sourceId some xsd:string, sdg:sourceType some sdg:SourceTypeKind, sdg:sourceName some xsd:string, sdg:contributionAmount some xsd:decimal, sdg:contributionDate some xsd:dateTime, sdg:contributionStatus some sdg:ContributionStatusKind, sdg:fundingId some xsd:string, sdg:totalAmount some xsd:decimal, sdg:currency some xsd:string, sdg:fiscalYear some xsd:integer, sdg:allocationType some xsd:string, sdg:fundsOrganization exactly 1 sdg:NonProfitOrganization, sdg:supports min 2 sdg:TreatmentFacility, sdg:supports min 2 sdg:CoordinatingCouncil

Class: sdg:AffiliateCouncil
    Annotations: rdfs:label "Affiliate Council", iao:0000115 "A governing or advisory body comprising representatives from multiple affiliate organizations within a larger network."
    SubClassOf: bfo:0000040, sdg:councilId some xsd:string, sdg:councilName some xsd:string, sdg:networkParent some xsd:string, sdg:memberCount some xsd:integer, sdg:scopeDescription some xsd:string, sdg:hasMemberRepresentative some sdg:Person, sdg:belongsToNetwork exactly 1 sdg:NonProfitOrganization

Class: sdg:ApprovalCertificate
    Annotations: rdfs:label "Approval Certificate", iao:0000115 "A formal document issued by an approval body certifying that specific products meet defined standards."
    SubClassOf: sdg:Document, sdg:approvalId some xsd:string, sdg:approvalStandard some xsd:string, sdg:approvalGrantedDate some xsd:dateTime, sdg:dateAuthorized some xsd:dateTime, sdg:revisionRequest some xsd:string, sdg:issuingOrganizationDetail some xsd:string, sdg:issuingOfficer some xsd:string, sdg:issuingOfficerTitle some xsd:string, sdg:certifies min 2 sdg:ProductModel, sdg:issuedTo exactly 1 sdg:Manufacturer

Class: sdg:ProductModel
    Annotations: rdfs:label "Product Model", iao:0000115 "A specific design and specification of a pipe or fitting subject to approval."
    SubClassOf: cco:ont00000995, sdg:modelNumber some xsd:string, sdg:productDescription some xsd:string, sdg:nominalPipeSize some xsd:string, sdg:ratedWorkingPressurePsi some xsd:decimal, sdg:ratedWorkingPressureKpa some xsd:decimal, sdg:remarks some xsd:string, sdg:certifiedBy exactly 1 sdg:ApprovalCertificate, sdg:manufacturedBy exactly 1 sdg:Manufacturer, sdg:hasMaterialSpecification exactly 1 sdg:MaterialSpecification, sdg:hasDimensionalStandard exactly 1 sdg:DimensionalStandard

Class: sdg:DimensionalStandard
    Annotations: rdfs:label "Dimensional Standard", iao:0000115 "The standard defining the physical dimensions and pressure ratings of the product."
    SubClassOf: cco:ont00000995, sdg:standardName some xsd:string, sdg:standardVersion some xsd:string, sdg:pressureRatingBasis some sdg:PressureRatingBasisKind, sdg:appliesTo min 2 sdg:ProductModel

Class: sdg:TransportAuthorization
    Annotations: rdfs:label "Transport Authorization", iao:0000115 "A legal record of consent and indemnification by a guardian authorizing a taxi service to transport a minor."
    SubClassOf: sdg:Authority, sdg:authorizationId some xsd:string, sdg:requestDate some xsd:dateTime, sdg:faxNumber some xsd:string, sdg:emailAddress some xsd:string, sdg:serviceDate some xsd:date, sdg:paymentStatus some sdg:PaymentStatusKind, sdg:supervisionStatus some sdg:SupervisionStatusKind, sdg:serviceStatus some sdg:ServiceStatusKind, sdg:authorizesTransportFor exactly 1 sdg:MinorPassenger, sdg:authoredBy exactly 1 sdg:Guardian, sdg:referencesEmergencyContact max 1 sdg:EmergencyContact, sdg:specifiesPickupLocation exactly 1 sdg:Location, sdg:specifiesDropoffLocation exactly 1 sdg:Location

Class: sdg:MinorPassenger
    Annotations: rdfs:label "Minor Passenger", iao:0000115 "A human under the age of 18 who is the subject of the transport authorization."
    SubClassOf: bfo:0000040, sdg:passengerName some xsd:string, sdg:age some xsd:integer, sdg:minimumAge some xsd:integer, sdg:isUnaccompanied some xsd:boolean, sdg:isAuthorizedBy exactly 1 sdg:TransportAuthorization, sdg:isGuardedBy exactly 1 sdg:Guardian

Class: sdg:EmergencyContact
    Annotations: rdfs:label "Emergency Contact", iao:0000115 "An individual other than the parent/guardian designated to be contacted in case of an emergency."
    SubClassOf: bfo:0000040, sdg:contactName some xsd:string, sdg:contactPhone some xsd:string, sdg:isReferencedBy exactly 1 sdg:TransportAuthorization, sdg:isContactFor exactly 1 sdg:Parent

Class: sdg:TransportService
    Annotations: rdfs:label "Transport Service", iao:0000115 "The actual taxi ride or trip event involving the minor, pickup, and drop-off."
    SubClassOf: sdg:Entity, sdg:serviceId some xsd:string, sdg:pickupTime some xsd:dateTime, sdg:dropoffTime some xsd:dateTime, sdg:serviceStatus some sdg:ServiceStatusKind, sdg:serviceType some sdg:ServiceTypeKind, sdg:isAuthorizedBy exactly 1 sdg:TransportAuthorization, sdg:transports exactly 1 sdg:MinorPassenger, sdg:originatesAt exactly 1 sdg:Location, sdg:terminatesAt exactly 1 sdg:Location

Class: sdg:TreatmentProgram
    Annotations: rdfs:label "Treatment Program", iao:0000115 "A structured clinical intervention program providing substance use treatment for juvenile offenders, delivered via outpatient modalities."
    SubClassOf: sdg:Program, sdg:programId some xsd:string, sdg:programName some xsd:string, sdg:deliveryMode some xsd:string, sdg:riskLevel some sdg:RiskLevelKind, sdg:status some sdg:StatusKind, sdg:accreditationBody some xsd:string, sdg:deliversService some sdg:ClinicalService, sdg:locatedAt exactly 1 sdg:Facility, sdg:fundedBy some sdg:PaymentSource

Class: sdg:RiskAssessment
    Annotations: rdfs:label "Risk Assessment", iao:0000115 "A clinical evaluation determining a patient's risk level and appropriate treatment intensity based on substance use and offense history."
    SubClassOf: sdg:assessmentId some xsd:string, sdg:assessmentDate some xsd:dateTime, sdg:riskScore some xsd:decimal, sdg:assessmentType some xsd:string, sdg:result some sdg:ResultKind, sdg:assessorId some xsd:string, sdg:appliedTo exactly 1 sdg:Patient, sdg:informsProgram exactly 1 sdg:TreatmentProgram, sdg:triggersService some sdg:ClinicalService

Class: sdg:PaymentSource
    Annotations: rdfs:label "Payment Source", iao:0000115 "A financial mechanism or funding stream covering the cost of treatment services for patients."
    SubClassOf: bfo:0000040, sdg:sourceId some xsd:string, sdg:sourceName some xsd:string, sdg:sourceType some sdg:SourceTypeKind, sdg:coverageStatus some sdg:CoverageStatusKind, sdg:effectiveDate some xsd:date, sdg:coversPatient some sdg:Patient, sdg:paysForService some sdg:ClinicalService
    HasKey: sdg:sourceId

Class: sdg:Enrollee
    Annotations: rdfs:label "Health Plan Enrollee", iao:0000115 "An individual who has been enrolled in the AmeriHealth Caritas District of Columbia health plan and is eligible for covered services."
    SubClassOf: bfo:0000040, sdg:enrolleeId some xsd:string, sdg:enrollmentDate some xsd:date, sdg:planName some xsd:string, sdg:status some sdg:StatusKind, sdg:fullName some xsd:string, sdg:isDeceased some xsd:boolean, sdg:relationshipToRequester some xsd:string, sdg:hasPrescription min 2 sdg:Prescription, sdg:receivesReminder some sdg:ReminderLetter, sdg:subjectOf min 2 sdg:Enrolment, sdg:associatedWith max 1 sdg:PerpetualFolder

Class: sdg:Prescription
    Annotations: rdfs:label "Prescription Record", iao:0000115 "A formal written instruction from a provider for a patient to be administered a specific medication, including dosage and quantity details."
    SubClassOf: cco:ont00000995, sdg:prescriptionId some xsd:string, sdg:fillDate some xsd:dateTime, sdg:quantity some xsd:integer, sdg:dosage some xsd:string, sdg:requiresPriorAuthorization some xsd:boolean, sdg:isNonFormulary some xsd:boolean, sdg:schedule some xsd:string, sdg:prescribedBy exactly 1 sdg:Provider, sdg:forMedication exactly 1 sdg:Medication, sdg:forEnrollee exactly 1 sdg:Enrollee, sdg:triggersReminder some sdg:ReminderLetter
    HasKey: sdg:prescriptionId

Class: sdg:ReminderLetter
    Annotations: rdfs:label "Prior Authorization Reminder", iao:0000115 "A communication sent to an enrollee to remind them to contact their provider for prior authorization of a medication during the transition period."
    SubClassOf: cco:ont00000958, sdg:letterId some xsd:string, sdg:sentDate some xsd:dateTime, sdg:reminderType some xsd:string, sdg:sentToEnrollee exactly 1 sdg:Enrollee, sdg:relatedToPrescription exactly 1 sdg:Prescription

Class: sdg:TransitionPeriod
    Annotations: rdfs:label "Enrollee Transition Window", iao:0000115 "A 90-day coverage window during which new enrollees can continue receiving medications for existing therapy without prior authorization."
    SubClassOf: bfo:0000015, sdg:periodId some xsd:string, sdg:startDate some xsd:dateTime, sdg:endDate some xsd:dateTime, sdg:durationDays some xsd:integer, sdg:status some sdg:StatusKind, sdg:appliesToEnrollee exactly 1 sdg:Enrollee, sdg:governsPrescription min 2 sdg:Prescription
    HasKey: sdg:periodId

Class: sdg:StudyDesign
    Annotations: rdfs:label "Study Design", iao:0000115 "A conceptual plan and methodological framework for conducting nutritional anthropology research, specifying questions, data needs, and methods."
    SubClassOf: bfo:0000015, sdg:designId some xsd:string, sdg:designName some xsd:string, sdg:designType some xsd:string, sdg:startDate some xsd:dateTime, sdg:endDate some xsd:dateTime, sdg:status some sdg:StatusKind, sdg:primaryObjective some sdg:PrimaryObjectiveKind, sdg:usesMethod min 2 sdg:ResearchMethod, sdg:assessesPopulation min 2 sdg:Population, sdg:generatesData min 2 sdg:Dataset

Class: sdg:BiologicalMeasurement
    Annotations: rdfs:label "Biological Measurement", iao:0000115 "A quantified physical or physiological attribute of an individual or population, such as body mass, height, or energy expenditure, recorded during a study."
    SubClassOf: cco:ont00000995, sdg:measurementId some xsd:string, sdg:measurementValue some xsd:decimal, sdg:unitOfMeasure some sdg:UnitOfMeasureKind, sdg:measurementDate some xsd:dateTime, sdg:measurementType some sdg:MeasurementTypeKind, sdg:referenceStandard some xsd:string, sdg:status some sdg:StatusKind, sdg:recordedIn exactly 1 sdg:Dataset, sdg:measuredBy exactly 1 sdg:ResearchMethod, sdg:pertainsTo exactly 1 sdg:Individual

Class: sdg:Dataset
    Annotations: rdfs:label "Dataset", iao:0000115 "A structured collection of recorded data, including measurements, survey responses, or observational notes, generated by a research method."
    SubClassOf: sdg:DataEntity, sdg:datasetId some xsd:string, sdg:datasetName some xsd:string, sdg:format some sdg:FormatKind, sdg:creationDate some xsd:dateTime, sdg:recordCount some xsd:integer, sdg:dataQualityScore some xsd:decimal, sdg:storageLocation some xsd:string, sdg:generatedBy exactly 1 sdg:ResearchMethod, sdg:containsMeasurements min 2 sdg:BiologicalMeasurement, sdg:linkedToStudy exactly 1 sdg:StudyDesign

Class: sdg:EthicalProtocol
    Annotations: rdfs:label "Ethical Protocol", iao:0000115 "A formalized set of principles and procedures governing the conduct of research, including informed consent, recruitment, and data handling."
    SubClassOf: bfo:0000015, sdg:protocolId some xsd:string, sdg:protocolName some xsd:string, sdg:approvalDate some xsd:dateTime, sdg:reviewingBody some xsd:string, sdg:principles some xsd:string, sdg:status some sdg:StatusKind, sdg:governs min 2 sdg:StudyDesign, sdg:requiresConsentFrom min 2 sdg:Individual, sdg:appliesTo min 2 sdg:Dataset

Class: sdg:ChiefAppraiser
    Annotations: rdfs:label "Chief Appraiser", iao:0000115 "The official responsible for preparing and submitting property assessment notices and exemption applications for board review."
    SubClassOf: bfo:0000015, sdg:appraiserIdentifier some xsd:string, sdg:appointmentDate some xsd:date, sdg:currentTermEnd some xsd:date, sdg:officeLocation some xsd:string, sdg:submits some sdg:AssessmentNotice, sdg:submits some sdg:PropertyExemption, sdg:reportsTo exactly 1 sdg:BoardOfAssessors

Class: sdg:AnimalControlPatrol
    Annotations: rdfs:label "Animal Control Patrol", iao:0000115 "A scheduled or ad-hoc patrol activity conducted by an Animal Services Officer to monitor an assigned geographic area for animal-related incidents, complaints, and violations."
    SubClassOf: bfo:0000015, sdg:patrolId some xsd:string, sdg:assignedArea some xsd:string, sdg:startTime some xsd:dateTime, sdg:endTime some xsd:dateTime, sdg:patrolType some xsd:string, sdg:weatherConditions some xsd:string, sdg:officerBadgeNumber some xsd:string, sdg:conductedBy exactly 1 sdg:AnimalServicesOfficer, sdg:covers exactly 1 sdg:GeographicZone, sdg:generates some sdg:IncidentReport

Class: sdg:AnimalServicesOfficer
    Annotations: rdfs:label "Animal Services Officer", iao:0000115 "A law enforcement role performed by an individual responsible for enforcing animal control ordinances, apprehending animals, issuing citations, and providing public education and assistance."
    SubClassOf: bfo:0000015, sdg:officerId some xsd:string, sdg:fullName some xsd:string, sdg:badgeNumber some xsd:string, sdg:certificationStatus some sdg:CertificationStatusKind, sdg:driverLicenseStatus some xsd:string, sdg:drugTestStatus some sdg:DrugTestStatusKind, sdg:criminalHistoryStatus some sdg:CriminalHistoryStatusKind, sdg:issues some sdg:Citation, sdg:apprehends some sdg:Animal
    HasKey: sdg:officerId

Class: sdg:Citation
    Annotations: rdfs:label "Citation", iao:0000115 "A formal legal document issued by an Animal Services Officer to a pet owner for violating animal control ordinances, including license violations or nuisance complaints."
    SubClassOf: cco:ont00000995, sdg:citationId some xsd:string, sdg:issueDate some xsd:date, sdg:violationCode some xsd:string, sdg:fineAmount some xsd:decimal, sdg:courtDate some xsd:date, sdg:paymentStatus some sdg:PaymentStatusKind, sdg:officerNotes some xsd:string, sdg:issuedTo exactly 1 sdg:Owner, sdg:issuedBy exactly 1 sdg:AnimalServicesOfficer, sdg:relatedTo max 1 sdg:IncidentReport

Class: sdg:AdoptionAssessment
    Annotations: rdfs:label "Adoption Assessment", iao:0000115 "A structured evaluation process conducted by an Animal Services Officer to determine an animal's temperament, health, and general adoptability for placement in a permanent home."
    SubClassOf: bfo:0000015, sdg:assessmentId some xsd:string, sdg:assessmentDate some xsd:dateTime, sdg:temperamentScore some xsd:integer, sdg:healthScore some xsd:decimal, sdg:adoptabilityRating some xsd:string, sdg:specialNeeds some xsd:boolean, sdg:assessorId some xsd:string, sdg:assesses exactly 1 sdg:Animal, sdg:conductedBy exactly 1 sdg:AnimalServicesOfficer, sdg:resultsIn max 1 sdg:AdoptionRecord

Class: sdg:AdoptionRecord
    Annotations: rdfs:label "Adoption Record", iao:0000115 "A formal record documenting the transfer of an animal from the shelter or impound facility to a permanent home, including adopter details and post-adoption follow-up."
    SubClassOf: cco:ont00000995, sdg:adoptionId some xsd:string, sdg:adoptionDate some xsd:dateTime, sdg:adopterName some xsd:string, sdg:adopterContact some xsd:string, sdg:adoptionFee some xsd:decimal, sdg:followUpRequired some xsd:boolean, sdg:followUpStatus some xsd:string, sdg:records exactly 1 sdg:Animal, sdg:basedOn exactly 1 sdg:AdoptionAssessment

Class: sdg:ParticipatingEntity
    Annotations: rdfs:label "Participating Entity", iao:0000115 "A legal or informal group of farmers, such as an FPO, FPC, FIG, or Farmers' Club, or an individual farmer, that applies to participate in the Sufal Bangla Project and the Ahare Bangla Food Festival."
    SubClassOf: sdg:CommunityEntity, sdg:entityIdentifier some xsd:string, sdg:entityType some sdg:EntityTypeKind, sdg:entityName some xsd:string, sdg:contactPerson some xsd:string, sdg:contactAddress some xsd:string, sdg:contactPhone some xsd:string, sdg:enrolmentStatus some sdg:EnrolmentStatusKind, sdg:projectParticipationStatus some xsd:string, sdg:submitsApplicationFor some sdg:FestivalParticipation, sdg:displaysProductsAt some sdg:FestivalBooth

Class: sdg:FestivalParticipation
    Annotations: rdfs:label "Festival Participation", iao:0000115 "The activity of a Participating Entity enrolling in and participating in the Ahare Bangla Food Festival under the Sufal Bangla Project."
    SubClassOf: bfo:0000015, sdg:participationId some xsd:string, sdg:festivalName some xsd:string, sdg:applicationDate some xsd:dateTime, sdg:evaluationResult some xsd:string, sdg:qualityScore some xsd:decimal, sdg:standardCompliance some xsd:boolean, sdg:hasParticipatingEntity exactly 1 sdg:ParticipatingEntity, sdg:hasFestivalBooth max 1 sdg:FestivalBooth, sdg:hasProductDisplay some sdg:ProductDisplay

Class: sdg:FestivalBooth
    Annotations: rdfs:label "Festival Booth", iao:0000115 "A physical stall or space allocated at the Milan Mela Ground for a Participating Entity to display and sell their products during the Ahare Bangla Food Festival."
    SubClassOf: bfo:0000040, sdg:boothId some xsd:string, sdg:boothLocation some xsd:string, sdg:boothSize some xsd:decimal, sdg:boothStatus some xsd:string, sdg:setupDate some xsd:date, sdg:dismantleDate some xsd:date, sdg:hostedAt exactly 1 sdg:FestivalVenue, sdg:assignedToParticipation max 1 sdg:FestivalParticipation, sdg:displaysProducts some sdg:ProductDisplay

Class: sdg:FestivalVenue
    Annotations: rdfs:label "Festival Venue", iao:0000115 "The physical location, Milan Mela Ground in Kolkata, where the Ahare Bangla Food Festival is held."
    SubClassOf: bfo:0000002, sdg:venueId some xsd:string, sdg:venueName some xsd:string, sdg:city some xsd:string, sdg:district some xsd:string, sdg:state some xsd:string, sdg:pinCode some xsd:string, sdg:festivalStartDate some xsd:date, sdg:festivalEndDate some xsd:date, sdg:hostsBooths min 2 sdg:FestivalBooth
    HasKey: sdg:venueId

Class: sdg:ProductDisplay
    Annotations: rdfs:label "Product Display", iao:0000115 "The specific agricultural produce or product that a Participating Entity displays and sells at their Festival Booth."
    SubClassOf: bfo:0000040, sdg:displayId some xsd:string, sdg:productName some xsd:string, sdg:productCategory some xsd:string, sdg:quantity some xsd:integer, sdg:unitOfMeasure some sdg:UnitOfMeasureKind, sdg:pricePerUnit some xsd:decimal, sdg:qualityGrade some xsd:string, sdg:displayedBy exactly 1 sdg:FestivalParticipation, sdg:locatedAt exactly 1 sdg:FestivalBooth

Class: sdg:ReadingChallenge
    Annotations: rdfs:label "Reading Challenge", iao:0000115 "A structured reading activity where participants select and complete books from a categorized list to earn awards."
    SubClassOf: bfo:0000015, sdg:challengeId some xsd:string, sdg:startDate some xsd:dateTime, sdg:endDate some xsd:dateTime, sdg:institutionName some xsd:string, sdg:yearGroup some xsd:string, sdg:status some sdg:StatusKind, sdg:hasParticipant__escalated min 2 sdg:ReadingParticipant, sdg:hasAwardTier min 2 sdg:AwardTier

Class: sdg:ReadingParticipant
    Annotations: rdfs:label "Reading Participant", iao:0000115 "An individual student enrolled in a specific reading challenge who records their reading progress."
    SubClassOf: bfo:0000015, sdg:participantId some xsd:string, sdg:fullName some xsd:string, sdg:yearGroup some xsd:string, sdg:enrollmentDate some xsd:date, sdg:status some sdg:StatusKind, sdg:participatesIn__escalated exactly 1 sdg:ReadingChallenge, sdg:recordsReading min 2 sdg:ReadingRecord

Class: sdg:ReadingRecord
    Annotations: rdfs:label "Reading Record", iao:0000115 "A documented entry capturing the details of a single book read by a participant, including metadata and completion date."
    SubClassOf: sdg:Record, sdg:recordId some xsd:string, sdg:bookTitle some xsd:string, sdg:authorName some xsd:string, sdg:completionDate some xsd:date, sdg:category some sdg:CategoryKind, sdg:pageCount some xsd:integer, sdg:coverColor some xsd:string, sdg:isRecommended some xsd:boolean, sdg:recommendedBy some xsd:string, sdg:family some xsd:string, sdg:recordedBy exactly 1 sdg:ReadingParticipant, sdg:fulfillsCategory exactly 1 sdg:ReadingCategory, sdg:referencesBook exactly 1 sdg:Book

Class: sdg:Book
    Annotations: rdfs:label "Book", iao:0000115 "A published literary work with identifiable metadata such as title, author, and physical characteristics."
    SubClassOf: cco:ont00000995, sdg:bookId some xsd:string, sdg:title some xsd:string, sdg:authorName some xsd:string, sdg:pageCount some xsd:integer, sdg:genre some xsd:string, sdg:coverColor some xsd:string, sdg:hasAward some xsd:boolean, sdg:isPoetry some xsd:boolean, sdg:isNonFiction some xsd:boolean, sdg:isWordless some xsd:boolean, sdg:citedIn min 2 sdg:ReadingRecord, sdg:matchesCategory min 2 sdg:ReadingCategory

Class: sdg:ReadingCategory
    Annotations: rdfs:label "Reading Category", iao:0000115 "A thematic or descriptive constraint applied to book selection within a reading challenge."
    SubClassOf: bfo:0000023, sdg:categoryId some xsd:string, sdg:categoryName some xsd:string, sdg:description some xsd:string, sdg:isRequired some xsd:boolean, sdg:yearGroup some xsd:string, sdg:appliesToChallenge exactly 1 sdg:ReadingChallenge, sdg:constrainsBook min 2 sdg:Book

Class: sdg:AwardTier
    Annotations: rdfs:label "Award Tier", iao:0000115 "A recognition level granted to participants upon completing a specified number of reading records."
    SubClassOf: bfo:0000023, sdg:awardId some xsd:string, sdg:awardName some xsd:string, sdg:requiredCount some xsd:integer, sdg:ceremonyDate some xsd:date, sdg:status some sdg:StatusKind, sdg:grantedForChallenge exactly 1 sdg:ReadingChallenge, sdg:earnedBy min 2 sdg:ReadingParticipant
    HasKey: sdg:awardId

Class: sdg:BusRoute
    Annotations: rdfs:label "Bus Route", iao:0000115 "A scheduled transportation service connecting a school campus to residential pickup zones."
    SubClassOf: bfo:0000015, sdg:routeCode some xsd:string, sdg:district some xsd:string, sdg:roundTripFee some xsd:decimal, sdg:singleTripFee some xsd:decimal, sdg:academicYear some xsd:string, sdg:status some sdg:StatusKind, sdg:serves exactly 1 sdg:SchoolCampus, sdg:covers min 2 sdg:PickupZone, sdg:operatedBy exactly 1 sdg:BusOperator
    HasKey: sdg:routeCode

Class: sdg:SchoolCampus
    Annotations: rdfs:label "School Campus", iao:0000115 "An educational facility providing early childhood education and bilingual nursery services."
    SubClassOf: bfo:0000015, sdg:campusName some xsd:string, sdg:campusCode some xsd:string, sdg:campusType some xsd:string, sdg:district some xsd:string, sdg:academicYear some xsd:string, sdg:receives min 2 sdg:BusRoute, sdg:locatedIn exactly 1 sdg:District

Class: sdg:PickupZone
    Annotations: rdfs:label "Pickup Zone", iao:0000115 "A specific residential building or estate designated as a stop on a bus route."
    SubClassOf: bfo:00000995, sdg:zoneName some xsd:string, sdg:zoneCode some xsd:string, sdg:district some xsd:string, sdg:specialInstructions some xsd:string, sdg:occurrentPartOf exactly 1 sdg:BusRoute, sdg:locatedIn exactly 1 sdg:District

Class: sdg:BusOperator
    Annotations: rdfs:label "Bus Operator", iao:0000115 "A commercial entity providing transportation services for school children."
    SubClassOf: bfo:00000995, sdg:companyName some xsd:string, sdg:contactPerson some xsd:string, sdg:contactPhone some xsd:string, sdg:licenseNumber some xsd:string, sdg:operates min 2 sdg:BusRoute

Class: sdg:District
    Annotations: rdfs:label "District", iao:0000115 "A geographical administrative area within a city where bus routes and pickup zones are located."
    SubClassOf: bfo:0000015, sdg:districtName some xsd:string, sdg:districtCode some xsd:string, sdg:region some sdg:RegionKind, sdg:contains min 2 sdg:PickupZone, sdg:contains min 1 sdg:SchoolCampus
    HasKey: sdg:districtCode

Class: sdg:GamblingActivity
    Annotations: rdfs:label "Gambling Activity", iao:0000115 "A structured process or event involving chance and consideration, such as a raffle, drawing, pull-tab, bingo, or paddlewheel, regulated under state law."
    SubClassOf: bfo:0000015, sdg:activityId some xsd:string, sdg:activityName some sdg:ActivityNameKind, sdg:isConsiderationRequired some xsd:boolean, sdg:legalStatus some sdg:LegalStatusKind, sdg:startDate some xsd:dateTime, sdg:endDate some xsd:dateTime, sdg:conductedBy exactly 1 sdg:Organization, sdg:generatesFunds some sdg:GamblingFund, sdg:regulatedBy exactly 1 sdg:RegulatoryStatute
    HasKey: sdg:activityId

Class: sdg:GamblingFund
    Annotations: rdfs:label "Gambling Fund", iao:0000115 "Monetary proceeds or assets derived from lawful gambling activities, subject to legal restrictions on their use."
    SubClassOf: bfo:0000040, sdg:fundId some xsd:string, sdg:fundAmount some xsd:decimal, sdg:currencyCode some xsd:string, sdg:sourceActivityId some xsd:string, sdg:restrictionStatus some sdg:RestrictionStatusKind, sdg:derivedFrom exactly 1 sdg:GamblingActivity, sdg:allocatedTo max 1 sdg:Campaign

Class: sdg:RegulatoryStatute
    Annotations: rdfs:label "Regulatory Statute", iao:0000115 "A legal provision or code section that defines permissible activities, restrictions, and enforcement mechanisms for gambling and political financing."
    SubClassOf: sdg:RegulatoryComplianceConcept, sdg:statuteId some xsd:string, sdg:statuteTitle some xsd:string, sdg:jurisdiction some sdg:JurisdictionKind, sdg:effectiveDate some xsd:date, sdg:restrictionType some sdg:RestrictionTypeKind, sdg:regulatoryScope some xsd:string, sdg:governs some sdg:GamblingActivity, sdg:governs some sdg:Campaign

Class: sdg:OccasionCard
    Annotations: rdfs:label "Occasion Card", iao:0000115 "A pre-signed, specially designed card used to request memorial prayers or express sentiments, available for specific occasions or perpetual enrollment."
    SubClassOf: cco:ont00000995, sdg:cardType some xsd:string, sdg:referenceNumber some xsd:string, sdg:suggestedDonation some xsd:decimal, sdg:isPreSigned some xsd:boolean, sdg:isFree some xsd:boolean, sdg:requestedFor min 2 sdg:Enrolment, sdg:fulfilledBy max 1 sdg:PerpetualFolder
    HasKey: sdg:referenceNumber

Class: sdg:PerpetualFolder
    Annotations: rdfs:label "Perpetual Folder", iao:0000115 "A physical leatherette-covered folder used to maintain a perpetual enrollment of a living or deceased person in daily Masses and prayers."
    SubClassOf: cco:ont00000995, sdg:folderName some xsd:string, sdg:coverColor some xsd:string, sdg:suggestedDonation some xsd:decimal, sdg:hasSocietyLogo some xsd:boolean, sdg:containsEnrolment min 2 sdg:Enrolment, sdg:designatedFor exactly 1 sdg:Enrollee

Class: sdg:OrderRequest
    Annotations: rdfs:label "Order Request", iao:0000115 "A formal request submitted by a customer to purchase occasion cards or perpetual folders, including quantity and delivery details."
    SubClassOf: cco:ont00000995, sdg:requestId some xsd:string, sdg:submissionDate some xsd:dateTime, sdg:deliveryMethod some xsd:string, sdg:totalQuantity some xsd:integer, sdg:includesCard min 2 sdg:OccasionCard, sdg:includesFolder max 1 sdg:PerpetualFolder, sdg:submittedBy exactly 1 sdg:Enrollee

Class: sdg:DialogueUtterance
    Annotations: rdfs:label "A single spoken statement by a character in a conversation", iao:0000115 "A discrete verbal act performed by a character at a specific moment, containing quoted text and associated metadata."
    SubClassOf: bfo:0000015, sdg:utteranceId some xsd:string, sdg:quotedText some xsd:string, sdg:speakerName some xsd:string, sdg:timestamp some xsd:dateTime, sdg:isInternalThought some xsd:boolean, sdg:vocalizationMode some xsd:string, sdg:spokenBy exactly 1 sdg:Character, sdg:partOfConversation exactly 1 sdg:SocialInteractionEvent
    HasKey: sdg:utteranceId

Class: sdg:Character
    Annotations: rdfs:label "A person participating in the dialogue", iao:0000115 "A real physical entity (human) who speaks, acts, or thinks within the narrative context."
    SubClassOf: bfo:0000002, sdg:characterId some xsd:string, sdg:fullName some xsd:string, sdg:ageGroup some xsd:string, sdg:gender some sdg:GenderKind, sdg:hasGoggles some xsd:boolean, sdg:swimmingAbility some xsd:string, sdg:utters some sdg:DialogueUtterance, sdg:interactsWith some sdg:Character, sdg:purchasesItem max 1 sdg:SwimmingGoggle

Class: sdg:SocialInteractionEvent
    Annotations: rdfs:label "A structured conversation or social exchange between characters", iao:0000115 "A temporal process involving two or more characters exchanging dialogue and performing related actions."
    SubClassOf: bfo:0000015, sdg:eventId some xsd:string, sdg:location some xsd:string, sdg:startTime some xsd:dateTime, sdg:endTime some xsd:dateTime, sdg:activityType some sdg:ActivityTypeKind, sdg:weatherCondition some sdg:WeatherConditionKind, sdg:containsUtterance min 2 sdg:DialogueUtterance, sdg:involvesCharacter min 2 sdg:Character, sdg:takesPlaceAt exactly 1 sdg:Location

Class: sdg:SwimmingGoggle
    Annotations: rdfs:label "A wearable item used for eye protection in water", iao:0000115 "A manufactured artifact designed to protect the eyes from water irritation during swimming activities."
    SubClassOf: cco:ont00000995, sdg:goggleId some xsd:string, sdg:brand some xsd:string, sdg:price some xsd:decimal, sdg:comfortLevel some sdg:ComfortLevelKind, sdg:causesEyeIrritation some xsd:boolean, sdg:purchaseDate some xsd:date, sdg:purchasedBy exactly 1 sdg:Character, sdg:usedInEvent some sdg:SocialInteractionEvent, sdg:sellsItem exactly 1 sdg:Location

Class: sdg:BusinessAccount
    Annotations: rdfs:label "Business Account", iao:0000115 "A digital record representing a commercial entity's subscription and administrative profile within the timeSSD platform."
    SubClassOf: cco:ont00000995, sdg:businessIdentifier some xsd:string, sdg:vatNumber some xsd:string, sdg:registeredAddress some xsd:string, sdg:subscriptionStatus some sdg:SubscriptionStatusKind, sdg:primaryLanguage some sdg:PrimaryLanguageKind, sdg:hasAdministrator exactly 1 sdg:SoftwareAdministrator, sdg:ownsPrivateData some sdg:WorkMethod, sdg:usesSoftware exactly 1 sdg:LaborCostingSoftware

Class: sdg:SoftwareAdministrator
    Annotations: rdfs:label "Software Administrator", iao:0000115 "A role played by a user who holds exclusive administrative rights and subscription management authority for a specific business account."
    SubClassOf: sdg:Role, sdg:administratorId some xsd:string, sdg:roleStatus some sdg:RoleStatusKind, sdg:authorizationLevel some sdg:AuthorizationLevelKind, sdg:managesAccount exactly 1 sdg:BusinessAccount, sdg:authoredData some sdg:WorkMethod

Class: sdg:WorkMethod
    Annotations: rdfs:label "Work Method", iao:0000115 "A structured digital record containing operation lists, standard times, and layout planning data used for labor costing and workflow development."
    SubClassOf: cco:ont00000995, sdg:methodId some xsd:string, sdg:dataClassification some sdg:DataClassificationKind, sdg:creationDate some xsd:dateTime, sdg:exportFormat some sdg:ExportFormatKind, sdg:languageCode some xsd:string, sdg:containsElement min 2 sdg:MotionElement, sdg:ownedBy exactly 1 sdg:BusinessAccount, sdg:usesBaseData some sdg:StandardElementLibrary

Class: sdg:MotionElement
    Annotations: rdfs:label "Motion Element", iao:0000115 "A fundamental unit of work or motion within a method, which may be a predefined standard item or a custom-developed component."
    SubClassOf: sdg:System, sdg:elementId some xsd:string, sdg:elementType some xsd:string, sdg:standardTimeValue some xsd:decimal, sdg:copyrightOwner some xsd:string, sdg:partOfMethod exactly 1 sdg:WorkMethod, sdg:translatesTo some sdg:LocalizedDescription

Class: sdg:StandardElementLibrary
    Annotations: rdfs:label "Standard Element Library", iao:0000115 "The proprietary initial database content (ELF) containing predefined macros, methods, and motion elements owned by the platform company."
    SubClassOf: cco:ont00000995, sdg:libraryVersion some xsd:string, sdg:contentStatus some sdg:ContentStatusKind, sdg:lastUpdated some xsd:dateTime, sdg:providesElement min 2 sdg:MotionElement, sdg:ownedBy exactly 1 sdg:PlatformCompany

Class: sdg:LocalizedDescription
    Annotations: rdfs:label "Localized Description", iao:0000115 "A translated text record for a motion element or interface standard text, allowing multilingual access to the software content."
    SubClassOf: cco:ont00000995, sdg:localeCode some xsd:string, sdg:textContent some xsd:string, sdg:translationStatus some sdg:TranslationStatusKind, sdg:describesElement exactly 1 sdg:MotionElement
    HasKey: sdg:localeCode

Class: sdg:PlatformCompany
    Annotations: rdfs:label "Platform Company", iao:0000115 "The legal entity (Astailor Shine S.R.L.) that operates the timeSSD platform, holds copyright over the ELF database, and manages software licenses."
    SubClassOf: bfo:0000004, sdg:companyRegistrationNumber some xsd:string, sdg:vatNumber some xsd:string, sdg:registeredOffice some xsd:string, sdg:jurisdiction some sdg:JurisdictionKind, sdg:operatesSoftware exactly 1 sdg:LaborCostingSoftware, sdg:ownsLibrary exactly 1 sdg:StandardElementLibrary

Class: sdg:LaborCostingSoftware
    Annotations: rdfs:label "Labor Costing Software", iao:0000115 "The proprietary software system dedicated to labor costing, work method development, and layout planning, utilizing a pay-as-you-go licensing model."
    SubClassOf: cco:ont00000995, sdg:softwareVersion some xsd:string, sdg:licensingModel some xsd:string, sdg:ediEnabled some xsd:boolean, sdg:exportCapabilities some xsd:string, sdg:usedBy min 2 sdg:BusinessAccount, sdg:hostsLibrary exactly 1 sdg:StandardElementLibrary

Class: sdg:NonprofitOrganization
    Annotations: rdfs:label "Nonprofit Organization", iao:0000115 "A legally recognized not-for-profit entity established to provide community-based programs and services to a specific demographic."
    SubClassOf: sdg:Organization, sdg:legalName some xsd:string, sdg:taxExemptStatus some xsd:string, sdg:foundingYear some xsd:integer, sdg:operationalStatus some sdg:OperationalStatusKind, sdg:foundingLocation some xsd:string, sdg:providesProgram min 2 sdg:CommunityProgram, sdg:foundedBy exactly 1 sdg:Person

Class: sdg:EducationalCurriculum
    Annotations: rdfs:label "Educational Curriculum", iao:0000115 "A formally structured set of instructional sessions and holistic approaches designed to teach self-esteem and avoidance of at-risk behaviors."
    SubClassOf: cco:ont00000995, sdg:curriculumTitle some xsd:string, sdg:totalSessions some xsd:integer, sdg:pedagogicalApproach some xsd:string, sdg:approvalAgency some xsd:string, sdg:approvalStatus some sdg:ApprovalStatusKind, sdg:authoredBy exactly 1 sdg:Person, sdg:usedInProgram min 2 sdg:CommunityProgram, sdg:evaluatedBy some sdg:ResearchInstitution

Class: sdg:MedicationFactSheet
    Annotations: rdfs:label "Medication Fact Sheet", iao:0000115 "A structured educational document providing essential information about a specific medication, such as indications, side effects, and administration instructions."
    SubClassOf: cco:ont00000995, sdg:factSheetId some xsd:string, sdg:title some xsd:string, sdg:lastUpdated some xsd:dateTime, sdg:sourceSystem some sdg:SourceSystemKind, sdg:language some sdg:LanguageKind, sdg:readabilityLevel some xsd:string, sdg:coversMedication exactly 1 sdg:Medication, sdg:deliveredVia some sdg:DisplayEndpoint

Class: sdg:DisplayEndpoint
    Annotations: rdfs:label "Display Endpoint", iao:0000115 "A physical or virtual device used to present medication information and patient education content at the point of care."
    SubClassOf: bfo:0000040, sdg:endpointId some xsd:string, sdg:deviceType some sdg:DeviceTypeKind, sdg:ipAddress some xsd:string, sdg:status some sdg:StatusKind, sdg:locationRoom some xsd:string, sdg:lastHeartbeat some xsd:dateTime, sdg:displaysFactSheet some sdg:MedicationFactSheet, sdg:servesPatient exactly 1 sdg:Patient

Class: sdg:HCAHPSMetric
    Annotations: rdfs:label "HCAHPS Metric", iao:0000115 "A standardized measurement of patient perception of care, specifically tracking medication-related communication and understanding."
    SubClassOf: cco:ont00000995, sdg:metricId some xsd:string, sdg:surveyDate some xsd:dateTime, sdg:category some sdg:CategoryKind, sdg:score some xsd:decimal, sdg:benchmark some xsd:decimal, sdg:trend some xsd:string, sdg:linkedToPatient exactly 1 sdg:Patient, sdg:influencedBy some sdg:MedicationFactSheet

Class: sdg:CertificateProgram
    Annotations: rdfs:label "Graduate Certificate Program", iao:0000115 "A structured educational program leading to a graduate certificate in Nursing Administration and Health Systems Leadership."
    SubClassOf: sdg:Program, sdg:programId some xsd:string, sdg:programName some xsd:string, sdg:deliveryMode some xsd:string, sdg:effectiveDate some xsd:date, sdg:minimumGPA some xsd:decimal, sdg:wordLimit some xsd:integer, sdg:credentialType some sdg:CredentialTypeKind, sdg:requires min 2 sdg:AdmissionRequirement, sdg:awards exactly 1 sdg:Credential

Class: sdg:AdmissionRequirement
    Annotations: rdfs:label "Admission Requirement", iao:0000115 "A specific condition or document required for admission to the certificate program."
    SubClassOf: sdg:Document, sdg:requirementId some xsd:string, sdg:requirementType some sdg:RequirementTypeKind, sdg:description some xsd:string, sdg:isMandatory some xsd:boolean, sdg:validFrom some xsd:date, sdg:appliesTo exactly 1 sdg:CertificateProgram, sdg:hasAlternative max 1 sdg:AdmissionRequirement
    HasKey: sdg:requirementId

Class: sdg:EnglishProficiencyTest
    Annotations: rdfs:label "English Language Proficiency Test", iao:0000115 "A standardized test used to assess English language proficiency for international applicants."
    SubClassOf: bfo:0000040, sdg:testId some xsd:string, sdg:testName some xsd:string, sdg:minScore some xsd:integer, sdg:testFormat some xsd:string, sdg:satisfies exactly 1 sdg:AdmissionRequirement, sdg:hasScore exactly 1 sdg:TestScore

Class: sdg:TestScore
    Annotations: rdfs:label "Test Score Record", iao:0000115 "A recorded result from an English language proficiency test."
    SubClassOf: sdg:AssessmentTool, sdg:scoreId some xsd:string, sdg:scoreValue some xsd:decimal, sdg:testDate some xsd:dateTime, sdg:validUntil some xsd:date, sdg:belongsTo exactly 1 sdg:EnglishProficiencyTest, sdg:submittedBy exactly 1 sdg:Applicant
    HasKey: sdg:scoreId

Class: sdg:CelestialBody
    Annotations: rdfs:label "A natural astronomical object", iao:0000115 "A physical object existing in space, such as a planet, star, comet, or moon, that can be observed."
    SubClassOf: bfo:0000040, sdg:bodyIdentifier some xsd:string, sdg:bodyName some xsd:string, sdg:bodyType some xsd:string, sdg:rightAscension some xsd:decimal, sdg:declination some xsd:decimal, sdg:magnitude some xsd:decimal, sdg:discoveryDate some xsd:date, sdg:discovererName some xsd:string, sdg:observedIn some sdg:Observation

Class: sdg:Observer
    Annotations: rdfs:label "A person who conducts astronomical observations", iao:0000115 "An individual who performs or records astronomical observations, often associated with specific instruments and locations."
    SubClassOf: bfo:0000002, sdg:observerIdentifier some xsd:string, sdg:fullName some xsd:string, sdg:birthDate some xsd:date, sdg:deathDate some xsd:date, sdg:location some xsd:string, sdg:affiliation some sdg:AffiliationKind, sdg:roleDetail some sdg:RoleKind, sdg:performedObservation some sdg:Observation, sdg:ownedInstrument some sdg:Telescope

Class: sdg:LegislativeDecree
    Annotations: rdfs:label "Legislative Decree", iao:0000115 "A formal command or law issued by an authority, such as an emperor, requiring specific actions from the population."
    SubClassOf: sdg:LegalEntity, sdg:issuerName some xsd:string, sdg:issuanceDate some xsd:date, sdg:mandateDescription some xsd:string, sdg:objective some xsd:string, sdg:issuerType some xsd:string, sdg:triggered min 2 sdg:CensusRegistration

Class: sdg:WithholdingRule
    Annotations: rdfs:label "Withholding Rule", iao:0000115 "A regulatory process and legal requirement mandating the deduction of three percent of payments for supplies and services provided to governmental entities as income tax."
    SubClassOf: bfo:0000015, sdg:ruleIdentifier some xsd:string, sdg:effectiveDate some xsd:date, sdg:withholdingRate some xsd:decimal, sdg:paymentThreshold some xsd:decimal, sdg:status some sdg:StatusKind, sdg:issuingAgency some xsd:string, sdg:appliesTo min 2 sdg:Payment, sdg:governedBy exactly 1 sdg:Statute

Class: sdg:Contract
    Annotations: rdfs:label "Government Contract", iao:0000115 "A legally binding agreement between a governmental entity and a prime contractor for the provision of property or services, subject to specific withholding exceptions based on execution date."
    SubClassOf: bfo:00000995, sdg:contractIdentifier some xsd:string, sdg:executionDate some xsd:date, sdg:totalValue some xsd:decimal, sdg:contractType some xsd:string, sdg:isMateriallyModified some xsd:boolean, sdg:modificationDate some xsd:dateTime, sdg:awardedBy exactly 1 sdg:GovernmentalEntity, sdg:awardedTo exactly 1 sdg:Contractor, sdg:generates min 2 sdg:Payment

Class: sdg:GovernmentalEntity
    Annotations: rdfs:label "Governmental Entity", iao:0000115 "A federal, state, or local government, including political subdivisions and instrumentalities, that disburses funds for supplies and services."
    SubClassOf: bfo:0000040, sdg:entityIdentifier some xsd:string, sdg:entityName some xsd:string, sdg:jurisdictionLevel some sdg:JurisdictionLevelKind, sdg:annualPaymentVolume some xsd:decimal, sdg:isInstrumentality some xsd:boolean, sdg:disburses min 2 sdg:Payment, sdg:awards min 2 sdg:Contract

Class: sdg:Statute
    Annotations: rdfs:label "Statute", iao:0000115 "A legislative act or code section that mandates or modifies the withholding requirements, such as TIPRA or ARRA."
    SubClassOf: bfo:0000015, sdg:statuteIdentifier some xsd:string, sdg:statuteName some xsd:string, sdg:enactmentDate some xsd:date, sdg:sectionNumber some xsd:string, sdg:amendsDetail some xsd:string, sdg:mandates min 2 sdg:WithholdingRule
    HasKey: sdg:sectionNumber

Class: sdg:SalesActivityRecord
    Annotations: rdfs:label "Sales Activity Record", iao:0000115 "A record of a telemarketing or sales activity including calls, appointments, and client interactions."
    SubClassOf: cco:ont00000995, sdg:activityId some xsd:string, sdg:activityDate some xsd:dateTime, sdg:activityType some sdg:ActivityTypeKind, sdg:durationMinutes some xsd:integer, sdg:outcome some sdg:OutcomeKind, sdg:notes some xsd:string, sdg:conductedBy exactly 1 sdg:SalesAdministrator, sdg:targets some sdg:ProspectiveCustomer, sdg:generates some sdg:SalesReport
    HasKey: sdg:activityId

Class: sdg:ProspectiveCustomer
    Annotations: rdfs:label "Prospective Customer", iao:0000115 "A potential client identified through business directories or existing client leads."
    SubClassOf: cco:ont00000995, sdg:customerId some xsd:string, sdg:companyName some xsd:string, sdg:contactPerson some xsd:string, sdg:contactEmail some xsd:string, sdg:contactPhone some xsd:string, sdg:leadSource some xsd:string, sdg:status some sdg:StatusKind, sdg:contactedBy min 2 sdg:SalesActivityRecord, sdg:receives some sdg:Quotation
    HasKey: sdg:customerId

Class: sdg:Quotation
    Annotations: rdfs:label "Quotation", iao:0000115 "A formal proposal or price estimate prepared for new or existing clients."
    SubClassOf: cco:ont00000995, sdg:quotationId some xsd:string, sdg:issueDate some xsd:date, sdg:expiryDate some xsd:date, sdg:totalAmount some xsd:decimal, sdg:status some sdg:StatusKind, sdg:description some xsd:string, sdg:preparedFor exactly 1 sdg:ProspectiveCustomer, sdg:preparedBy exactly 1 sdg:SalesAdministrator, sdg:relatedTo some sdg:SalesActivityRecord

Class: sdg:SalesAdministrator
    Annotations: rdfs:label "Sales Administrator", iao:0000115 "An individual performing telemarketing, sales, and administrative activities for Medtech software products."
    SubClassOf: bfo:0000015, sdg:adminId some xsd:string, sdg:fullName some xsd:string, sdg:department some xsd:string, sdg:officeLocation some xsd:string, sdg:weeklyHours some xsd:integer, sdg:salaryGrade some xsd:string, sdg:reportsTo exactly 1 sdg:MarketingManager, sdg:conducts min 2 sdg:SalesActivityRecord, sdg:prepares some sdg:Quotation, sdg:generates some sdg:SalesReport

Class: sdg:MarketingManager
    Annotations: rdfs:label "Marketing Manager", iao:0000115 "The manager to whom the Sales Administrator reports and oversees the Sales team."
    SubClassOf: bfo:0000015, sdg:managerId some xsd:string, sdg:fullName some xsd:string, sdg:department some xsd:string, sdg:officeLocation some xsd:string, sdg:supervises min 2 sdg:SalesAdministrator
    HasKey: sdg:managerId

Class: sdg:GameMatch
    Annotations: rdfs:label "Game Match", iao:0000115 "A scheduled competitive contest between two affiliated teams governed by BAFA 5-on-5 rules."
    SubClassOf: bfo:0000015, sdg:matchId some xsd:string, sdg:startDate some xsd:dateTime, sdg:status some sdg:StatusKind, sdg:homeTeamId some xsd:string, sdg:awayTeamId some xsd:string, sdg:venueId some xsd:string, sdg:officialsCount some xsd:integer, sdg:playedOn exactly 1 sdg:PlayingField, sdg:supervisedBy exactly 1 sdg:OfficiatingCrew, sdg:participatesTeam min 2 sdg:Team
    HasKey: sdg:matchId

Class: sdg:PlayingField
    Annotations: rdfs:label "Playing Field", iao:0000115 "A rectangular spatial enclosure with specific dimensions and markings designated for 5-on-5 football play."
    SubClassOf: bfo:0000040, sdg:fieldId some xsd:string, sdg:lengthYards some xsd:decimal, sdg:widthYards some xsd:decimal, sdg:endZoneDepthYards some xsd:decimal, sdg:hasGoalPosts some xsd:boolean, sdg:hasHashMarks some xsd:boolean, sdg:hasNoRunZone some xsd:boolean, sdg:surfaceType some sdg:SurfaceTypeKind, sdg:hostsMatch some sdg:GameMatch

Class: sdg:OfficiatingCrew
    Annotations: rdfs:label "Officiating Crew", iao:0000115 "A group of officials supervising a match according to IFAF mechanics and BAFA rules."
    SubClassOf: bfo:0000040, sdg:crewId some xsd:string, sdg:mechanicsManualVersion some xsd:string, sdg:officialsCount some xsd:integer, sdg:supervisionStatus some sdg:SupervisionStatusKind, sdg:supervises exactly 1 sdg:GameMatch

Class: sdg:Penalty
    Annotations: rdfs:label "Penalty", iao:0000115 "A sanction applied to a team for violating a specific rule during a down."
    SubClassOf: bfo:0000015, sdg:penaltyId some xsd:string, sdg:ruleArticle some xsd:string, sdg:yardage some xsd:integer, sdg:penaltyType some xsd:string, sdg:enforcedByDetail some xsd:string, sdg:occursIn__escalated some sdg:GameMatch, sdg:assessedAgainst exactly 1 sdg:Team
    HasKey: sdg:penaltyId

Class: sdg:CustomerAccount
    Annotations: rdfs:label "Customer Account", iao:0000115 "A financial account maintained by a clearing broker for an individual client seeking personal financial services."
    SubClassOf: cco:ont00000995, sdg:accountIdentifier some xsd:string, sdg:accountStatus some sdg:AccountStatusKind, sdg:openingDate some xsd:dateTime, sdg:closingDate some xsd:dateTime, sdg:accountType some sdg:AccountTypeKind, sdg:customerID some xsd:string, sdg:companyName some xsd:string, sdg:contactEmail some xsd:string, sdg:creditLimit some xsd:decimal, sdg:registrationDate some xsd:dateTime, sdg:heldBy exactly 1 sdg:Customer, sdg:managedBy exactly 1 sdg:IntroducingFirm, sdg:hasTransaction min 2 sdg:FinancialTransaction, sdg:placedOrder some sdg:ShipmentRecord, sdg:associatedWith some sdg:MarketingCampaign

Class: sdg:IntroducingFirm
    Annotations: rdfs:label "Introducing Firm", iao:0000115 "A broker-dealer or registered investment advisor that introduces clients to a clearing broker for account servicing."
    SubClassOf: bfo:0000040, sdg:firmIdentifier some xsd:string, sdg:firmName some xsd:string, sdg:registrationNumber some xsd:string, sdg:contactEmail some xsd:string, sdg:contactPhone some xsd:string, sdg:introduces min 2 sdg:Customer, sdg:providesAccountTo min 2 sdg:CustomerAccount

Class: sdg:FinancialTransaction
    Annotations: rdfs:label "Financial Transaction", iao:0000115 "An activity or event involving the exchange of financial instruments or funds within a customer account."
    SubClassOf: bfo:0000015, sdg:transactionId some xsd:string, sdg:transactionDate some xsd:dateTime, sdg:transactionType some xsd:string, sdg:amount some xsd:decimal, sdg:currencyCode some xsd:string, sdg:status some sdg:StatusKind, sdg:occursIn__escalated exactly 1 sdg:CustomerAccount, sdg:executedBy max 1 sdg:ThirdPartyService
    HasKey: sdg:transactionId

Class: sdg:ThirdPartyService
    Annotations: rdfs:label "Third Party Service", iao:0000115 "An external company or system that performs services such as data processing, securities execution, or security safeguards for the clearing broker."
    SubClassOf: cco:ont00000995, sdg:serviceId some xsd:string, sdg:serviceName some xsd:string, sdg:serviceType some sdg:ServiceTypeKind, sdg:contractStartDate some xsd:date, sdg:contractEndDate some xsd:date, sdg:securityLevel some sdg:SecurityLevelKind, sdg:providesServiceFor min 2 sdg:CustomerAccount, sdg:handlesDataFor min 2 sdg:Customer

Class: sdg:SecuritySafeguard
    Annotations: rdfs:label "Security Safeguard", iao:0000115 "A physical or electronic measure implemented to protect non-public personal information and system integrity."
    SubClassOf: sdg:SecurityAndSafetyMeasure, sdg:safeguardId some xsd:string, sdg:safeguardName some xsd:string, sdg:safeguardType some sdg:SafeguardTypeKind, sdg:implementationDate some xsd:dateTime, sdg:lastAuditDate some xsd:date, sdg:complianceStatus some sdg:ComplianceStatusKind, sdg:protects min 2 sdg:CustomerAccount, sdg:implementedBy max 1 sdg:ThirdPartyService

Class: sdg:Proclamation
    Annotations: rdfs:label "Royal Proclamation", iao:0000115 "A formal public announcement issued by a monarch inviting eligible individuals to appear before the royal court."
    SubClassOf: cco:ont00000958, sdg:proclamationId some xsd:string, sdg:issuer some xsd:string, sdg:targetAudience some sdg:TargetAudienceKind, sdg:dateIssued some xsd:dateTime, sdg:status some sdg:StatusKind, sdg:contentSummary some xsd:string, sdg:issuedBy exactly 1 sdg:Monarch, sdg:targets min 2 sdg:EligibleIndividual

Class: sdg:EligibleIndividual
    Annotations: rdfs:label "Eligible Individual", iao:0000115 "A person who meets the criteria specified in a royal proclamation to appear before the monarch."
    SubClassOf: bfo:0000004, sdg:individualId some xsd:string, sdg:fullName some xsd:string, sdg:age some xsd:integer, sdg:residence some xsd:string, sdg:eligibilityStatus some xsd:string, sdg:dateOfBirth some xsd:date, sdg:individualIdentifier some xsd:string, sdg:firstName some xsd:string, sdg:lastName some xsd:string, sdg:relationshipToEmployee some sdg:RelationshipToEmployeeKind, sdg:isAdultDependent some xsd:boolean, sdg:coverageStatus some sdg:CoverageStatusKind, sdg:respondsTo exactly 1 sdg:Proclamation, sdg:appearsBefore exactly 1 sdg:Monarch, sdg:coveredByPlan exactly 1 sdg:HealthPlan, sdg:designatesProvider max 1 sdg:HealthcareProvider, sdg:filesClaim min 2 sdg:InsuranceClaim

Class: sdg:Monarch
    Annotations: rdfs:label "Monarch", iao:0000115 "The sovereign ruler who issues proclamations and selects individuals for royal positions."
    SubClassOf: bfo:0000004, sdg:monarchId some xsd:string, sdg:title some xsd:string, sdg:reignStartDate some xsd:date, sdg:reignEndDate some xsd:date, sdg:fairnessRating some xsd:decimal, sdg:currentStatus some sdg:CurrentStatusKind, sdg:issues min 2 sdg:Proclamation, sdg:selects min 2 sdg:EligibleIndividual

Class: sdg:Encounter
    Annotations: rdfs:label "Encounter", iao:0000115 "A specific interaction or meeting between a traveler and another entity during a journey."
    SubClassOf: bfo:0000015, sdg:encounterId some xsd:string, sdg:location some xsd:string, sdg:dateTime some xsd:dateTime, sdg:outcome some sdg:OutcomeKind, sdg:adviceGiven some xsd:string, sdg:participantRole some xsd:string, sdg:involves exactly 1 sdg:EligibleIndividual, sdg:occursAt exactly 1 sdg:Location

Class: sdg:Journey
    Annotations: rdfs:label "Journey", iao:0000115 "A sequence of travels undertaken by an individual to reach a destination."
    SubClassOf: sdg:Entity, sdg:journeyId some xsd:string, sdg:startDate some xsd:dateTime, sdg:endDate some xsd:dateTime, sdg:purpose some sdg:PurposeKind, sdg:status some sdg:StatusKind, sdg:totalDistance some xsd:decimal, sdg:undertakenBy exactly 1 sdg:EligibleIndividual, sdg:includes min 2 sdg:Encounter

Class: sdg:RemunerationEvent
    Annotations: rdfs:label "Remuneration Event", iao:0000115 "A transaction or fee payment where an authorised representative or scheme receives compensation for financial services provided to an investor."
    SubClassOf: bfo:0000015, sdg:eventId some xsd:string, sdg:eventDate some xsd:dateTime, sdg:amount some xsd:decimal, sdg:feeType some xsd:string, sdg:currency some xsd:string, sdg:paidTo exactly 1 sdg:AuthorisedRepresentative, sdg:derivedFromInvestment exactly 1 sdg:Investor

Class: sdg:OfficeStaffRole
    Annotations: rdfs:label "Office Staff Role", iao:0000115 "A role played by a person within the English Department's administrative structure, defining their specific responsibilities and access privileges."
    SubClassOf: sdg:Role, sdg:roleTitle some sdg:RoleTitleKind, sdg:officeLocation some xsd:string, sdg:phoneExtension some xsd:string, sdg:isAuthorizedOperator some xsd:boolean, sdg:hasEmergencyAuthority some xsd:boolean, sdg:departmentScope some xsd:string, sdg:performedBy exactly 1 sdg:Person, sdg:manages some sdg:OfficeProcess

Class: sdg:OfficeProcess
    Annotations: rdfs:label "Office Process", iao:0000115 "An administrative activity conducted within the department office, such as handling mail, processing copies, or managing travel."
    SubClassOf: bfo:0000015, sdg:processType some xsd:string, sdg:operatingHoursStart some xsd:dateTime, sdg:operatingHoursEnd some xsd:dateTime, sdg:isLunchBreakIncluded some xsd:boolean, sdg:lunchBreakStart some xsd:dateTime, sdg:lunchBreakEnd some xsd:dateTime, sdg:semesterRestriction some xsd:string, sdg:performedBy some sdg:OfficeStaffRole, sdg:handles some sdg:Document

Class: sdg:CopyRequestForm
    Annotations: rdfs:label "Copy Request Form", iao:0000115 "A specific administrative form required for all duplicating and photocopying requests, containing copyright and page count details."
    SubClassOf: cco:ont00000995, sdg:formId some xsd:string, sdg:copyrightInfo some xsd:string, sdg:originalPageCount some xsd:integer, sdg:copyCount some xsd:integer, sdg:isProperlyFilled some xsd:boolean, sdg:locationInOffice some xsd:string, sdg:attachedTo exactly 1 sdg:Document, sdg:completedBy exactly 1 sdg:Person

Class: sdg:PostalAddress
    Annotations: rdfs:label "Postal Address", iao:0000115 "A physical location used for mail sorting, delivery, and pickup within the department or university."
    SubClassOf: cco:ont00000995, sdg:buildingCode some xsd:string, sdg:roomNumber some xsd:string, sdg:streetAddress some xsd:string, sdg:isMailPickupLocation some xsd:boolean, sdg:mailSortDeadline some xsd:dateTime, sdg:usedBy some sdg:Document, sdg:locatedIn exactly 1 sdg:Building

Class: sdg:CognitiveTrainingProgram
    Annotations: rdfs:label "Cognitive Training Program", iao:0000115 "A structured mental exercise regimen designed to improve cognitive capacities such as memory, processing speed, or decision-making."
    SubClassOf: cco:ont00000995, sdg:programIdentifier some xsd:string, sdg:programName some xsd:string, sdg:targetCapacity some sdg:TargetCapacityKind, sdg:deliveryMode some xsd:string, sdg:targetPopulationDetail some sdg:TargetPopulationKind, sdg:evidenceLevel some sdg:EvidenceLevelKind, sdg:launchDate some xsd:date, sdg:targetsCapacity min 2 sdg:CognitiveCapacity, sdg:developedBy exactly 1 sdg:ResearchInstitution, sdg:evaluatedBy some sdg:CognitiveAssessment

Class: sdg:CognitiveCapacity
    Annotations: rdfs:label "Cognitive Capacity", iao:0000115 "A measurable mental ability or function, such as memory retention, processing speed, or executive control, that can be trained or assessed."
    SubClassOf: bfo:0000015, sdg:capacityIdentifier some xsd:string, sdg:capacityName some xsd:string, sdg:domain some sdg:DomainKind, sdg:baselineScore some xsd:decimal, sdg:improvementThreshold some xsd:decimal, sdg:assessmentMethod some sdg:AssessmentMethodKind, sdg:measuredBy min 2 sdg:CognitiveAssessment, sdg:trainedBy some sdg:CognitiveTrainingProgram

Class: sdg:CognitiveAssessment
    Annotations: rdfs:label "Cognitive Assessment", iao:0000115 "A standardized procedure or test used to evaluate an individual's current cognitive performance or capacity."
    SubClassOf: sdg:AssessmentTool, sdg:assessmentIdentifier some xsd:string, sdg:assessmentName some xsd:string, sdg:administrationDate some xsd:dateTime, sdg:administratorID some xsd:string, sdg:participantID some xsd:string, sdg:score some xsd:decimal, sdg:status some sdg:StatusKind, sdg:assessmentPurpose some xsd:string, sdg:assessesCapacity exactly 1 sdg:CognitiveCapacity, sdg:conductedBy exactly 1 sdg:ResearchInstitution
    HasKey: sdg:administratorID

Class: sdg:NeuroplasticityEvent
    Annotations: rdfs:label "Neuroplasticity Event", iao:0000115 "A biological process involving changes in neural connections or brain structure in response to experience, training, or aging."
    SubClassOf: bfo:0000015, sdg:eventID some xsd:string, sdg:eventDate some xsd:dateTime, sdg:brainRegion some xsd:string, sdg:triggerType some xsd:string, sdg:intensity some xsd:decimal, sdg:outcome some sdg:OutcomeKind, sdg:resultsInCapacityChange exactly 1 sdg:CognitiveCapacity, sdg:observedAt exactly 1 sdg:ResearchInstitution
    HasKey: sdg:eventID

Class: sdg:ReadinessBenchmark
    Annotations: rdfs:label "College Readiness Benchmark", iao:0000115 "A standardized score threshold on a specific assessment domain that indicates a student is prepared for credit-bearing coursework without developmental intervention."
    SubClassOf: bfo:0000015, sdg:benchmarkId some xsd:string, sdg:assessmentDomain some sdg:AssessmentDomainKind, sdg:minimumScore some xsd:decimal, sdg:assessmentType some xsd:string, sdg:effectiveDate some xsd:date, sdg:expirationMonths some xsd:integer, sdg:isMandatory some xsd:boolean, sdg:scoreScale some xsd:string, sdg:appliesTo min 2 sdg:CourseLevel, sdg:measuredBy exactly 1 sdg:AssessmentInstrument

Class: sdg:CourseLevel
    Annotations: rdfs:label "Postsecondary Course Level", iao:0000115 "A specific academic course or curriculum track within a public postsecondary institution that requires or grants college readiness status."
    SubClassOf: bfo:0000015, sdg:courseCode some sdg:CourseCodeKind, sdg:institutionCode some xsd:string, sdg:courseTitle some xsd:string, sdg:creditHours some xsd:integer, sdg:isDevelopmental some xsd:boolean, sdg:isCreditBearing some xsd:boolean, sdg:department some xsd:string, sdg:semesterOffered some xsd:string, sdg:requiresBenchmark min 2 sdg:ReadinessBenchmark, sdg:fulfillsOutcome min 3 sdg:LearningOutcome

Class: sdg:StudentAssessmentRecord
    Annotations: rdfs:label "Student Test Score Record", iao:0000115 "A formal record of a student's performance on a specific standardized assessment, used to determine eligibility for credit-bearing coursework."
    SubClassOf: sdg:Record, sdg:recordId some xsd:string, sdg:studentId some xsd:string, sdg:testDate some xsd:dateTime, sdg:score some xsd:decimal, sdg:percentile some xsd:integer, sdg:isExpired some xsd:boolean, sdg:testingCenter some xsd:string, sdg:scoreReportId some xsd:string, sdg:assessmentType some xsd:string, sdg:generatedBy exactly 1 sdg:AssessmentInstrument, sdg:evaluates min 2 sdg:ReadinessBenchmark, sdg:belongs exactly 1 sdg:StudentProfile
    HasKey: sdg:recordId

Class: sdg:StudentProfile
    Annotations: rdfs:label "Student Academic Profile", iao:0000115 "A comprehensive record of a student's academic history, including admission factors, test scores, and enrollment status at a public postsecondary institution."
    SubClassOf: sdg:EducationalEntity, sdg:studentId some xsd:string, sdg:admissionStatus some sdg:AdmissionStatusKind, sdg:highSchoolGPA some xsd:decimal, sdg:classRank some xsd:integer, sdg:hasGED some xsd:boolean, sdg:enrollmentDate some xsd:date, sdg:institutionCode some xsd:string, sdg:isDevelopmentalRequired some xsd:boolean, sdg:contains min 2 sdg:StudentAssessmentRecord, sdg:enrolledIn min 2 sdg:CourseLevel, sdg:meets min 2 sdg:ReadinessBenchmark
    HasKey: sdg:studentId

Class: sdg:ResearchAward
    Annotations: rdfs:label "Research Award", iao:0000115 "A formal recognition or honor bestowed upon an individual or group for excellence in research activities."
    SubClassOf: sdg:ResearchEntity, sdg:awardIdentifier some xsd:string, sdg:awardYear some xsd:integer, sdg:awardTitle some xsd:string, sdg:awardDate some xsd:date, sdg:issuingOrganizationDetail some xsd:string, sdg:awardedTo exactly 1 sdg:Researcher, sdg:issuedBy exactly 1 sdg:ResearchOrganization, sdg:issuingOrganization some sdg:ResearchAgency

Class: sdg:ResearchOrganization
    Annotations: rdfs:label "Research Organization", iao:0000115 "An entity established to conduct research, provide scientific expertise, or manage research programs."
    SubClassOf: sdg:Organization, sdg:organizationIdentifier some xsd:string, sdg:organizationName some xsd:string, sdg:foundingYear some xsd:integer, sdg:headquartersLocation some xsd:string, sdg:websiteURL some xsd:string, sdg:organizationType some sdg:OrganizationTypeKind, sdg:primaryMission some xsd:string, sdg:awards some sdg:ResearchAward, sdg:employs some sdg:Researcher, sdg:funds some sdg:ResearchProject, sdg:locatedAt exactly 1 sdg:GeographicLocation

Class: sdg:HealthCondition
    Annotations: rdfs:label "Health Condition", iao:0000115 "A medical or physiological state, disorder, or risk factor that is the subject of research or clinical observation."
    SubClassOf: sdg:conditionIdentifier some xsd:string, sdg:conditionName some xsd:string, sdg:conditionCategory some xsd:string, sdg:prevalenceRate some xsd:decimal, sdg:riskFactors some xsd:string, sdg:studiedIn some sdg:ResearchProject, sdg:associatedWith some sdg:Biomarker

Class: sdg:Biomarker
    Annotations: rdfs:label "Biomarker", iao:0000115 "A measurable biological indicator, such as a nutrient level, genetic marker, or physiological measurement, used in research to assess health status or disease risk."
    SubClassOf: bfo:0000015, sdg:biomarkerIdentifier some xsd:string, sdg:biomarkerName some xsd:string, sdg:biomarkerType some xsd:string, sdg:measurementUnit some xsd:string, sdg:normalRange some xsd:string, sdg:measuredIn some sdg:ResearchProject, sdg:associatedWith some sdg:HealthCondition

Class: sdg:AcquisitionSource
    Annotations: rdfs:label "Acquisition Source", iao:0000115 "The channel or method through which a parent or student learned about the program."
    SubClassOf: bfo:0000004, sdg:sourceType some sdg:SourceTypeKind, sdg:otherDetails some xsd:string, sdg:isSourceFor exactly 1 sdg:Enrollment

Class: sdg:ServiceTransition
    Annotations: rdfs:label "Service Transition", iao:0000115 "A process involving the movement of an older person between different health and social care settings or service providers."
    SubClassOf: bfo:0000015, sdg:transitionId some xsd:string, sdg:startDate some xsd:dateTime, sdg:endDate some xsd:dateTime, sdg:transitionType some sdg:TransitionTypeKind, sdg:status some sdg:StatusKind, sdg:description some xsd:string, sdg:involvesServiceUser exactly 1 sdg:ServiceUser, sdg:involvesCarer some sdg:Carer, sdg:originatesFrom exactly 1 sdg:HealthCareSetting, sdg:destinedFor exactly 1 sdg:HealthCareSetting

Class: sdg:Carer
    Annotations: rdfs:label "Carer", iao:0000115 "An individual providing informal or formal care support to a service user, often involved in care transitions."
    SubClassOf: bfo:0000004, sdg:carerId some xsd:string, sdg:name some sdg:NameKind, sdg:relationshipToUser some xsd:string, sdg:careLevel some sdg:CareLevelKind, sdg:contactNumber some xsd:string, sdg:supportsServiceUser exactly 1 sdg:ServiceUser, sdg:involvedInTransition some sdg:ServiceTransition
    HasKey: sdg:carerId

Class: sdg:HealthCareSetting
    Annotations: rdfs:label "Health Care Setting", iao:0000115 "A physical or organizational entity providing health and social care services, such as hospitals, community care teams, or residential care homes."
    SubClassOf: sdg:HealthcareEntity, sdg:settingId some xsd:string, sdg:name some sdg:NameKind, sdg:type some sdg:TypeKind, sdg:location some xsd:string, sdg:contactInfo some xsd:string, sdg:settingType some xsd:string, sdg:providesCareTo some sdg:ServiceUser, sdg:originatesTransition some sdg:ServiceTransition, sdg:destinedForTransition some sdg:ServiceTransition

Class: sdg:ClientEngagement
    Annotations: rdfs:label "Client Engagement", iao:0000115 "A business accounting consultancy engagement where financial services are provided to a specific client organization over a defined period."
    SubClassOf: sdg:BusinessEntity, sdg:engagementId some xsd:string, sdg:clientName some xsd:string, sdg:industrySector some sdg:IndustrySectorKind, sdg:startDate some xsd:dateTime, sdg:endDate some xsd:dateTime, sdg:status some sdg:StatusKind, sdg:assignedTo exactly 1 sdg:FinancialController, sdg:reportsTo some sdg:ManagementAccount, sdg:manages some sdg:ComplianceTask

Class: sdg:FinancialController
    Annotations: rdfs:label "Financial Controller", iao:0000115 "A senior accounting professional responsible for managing a portfolio of client engagements, overseeing financial reporting, and ensuring compliance."
    SubClassOf: bfo:0000015, sdg:controllerId some xsd:string, sdg:fullName some xsd:string, sdg:qualificationStatus some xsd:string, sdg:employmentType some sdg:EmploymentTypeKind, sdg:daysPerWeek some xsd:integer, sdg:baseLocation some xsd:string, sdg:hasDriverLicense some xsd:boolean, sdg:manages some sdg:ClientEngagement, sdg:supervises some sdg:JuniorAccountant

Class: sdg:ManagementAccount
    Annotations: rdfs:label "Management Account", iao:0000115 "A periodic financial report (typically monthly) detailing a client's financial performance, including profit and loss and balance sheet summaries."
    SubClassOf: cco:ont00000995, sdg:accountId some xsd:string, sdg:reportingPeriod some xsd:date, sdg:totalRevenue some xsd:decimal, sdg:totalExpenses some xsd:decimal, sdg:netProfit some xsd:decimal, sdg:status some sdg:StatusKind, sdg:reviewDate some xsd:dateTime, sdg:belongsToMany exactly 1 sdg:ClientEngagement, sdg:preparedBy exactly 1 sdg:FinancialController

Class: sdg:ComplianceTask
    Annotations: rdfs:label "Compliance Task", iao:0000115 "A specific regulatory or statutory obligation managed for a client, such as VAT, Corporation Tax, PAYE, or statutory accounts preparation."
    SubClassOf: sdg:RegulatoryComplianceConcept, sdg:taskId some xsd:string, sdg:taskType some sdg:TaskTypeKind, sdg:dueDate some xsd:date, sdg:filingDeadline some xsd:date, sdg:status some sdg:StatusKind, sdg:externalAdvisorId some xsd:string, sdg:assignedTo exactly 1 sdg:FinancialController, sdg:linkedTo exactly 1 sdg:ClientEngagement, sdg:supports some sdg:ManagementAccount
    HasKey: sdg:taskId

Class: sdg:FinancialForecast
    Annotations: rdfs:label "Financial Forecast", iao:0000115 "A projection of future financial performance, including profit and cash-flow forecasts, used for strategic planning and client advisory."
    SubClassOf: cco:ont00000995, sdg:forecastId some xsd:string, sdg:forecastType some xsd:string, sdg:projectionPeriod some xsd:string, sdg:projectedRevenue some xsd:decimal, sdg:projectedExpenses some xsd:decimal, sdg:projectedNetCash some xsd:decimal, sdg:confidenceLevel some sdg:ConfidenceLevelKind, sdg:createdFor exactly 1 sdg:ClientEngagement, sdg:preparedBy exactly 1 sdg:FinancialController, sdg:informs some sdg:ManagementAccount

Class: sdg:JuniorAccountant
    Annotations: rdfs:label "Junior Accountant", iao:0000115 "A trainee or junior accounting professional who supports senior controllers in delivering accounting services and learning technical skills."
    SubClassOf: bfo:0000015, sdg:accountantId some xsd:string, sdg:fullName some xsd:string, sdg:qualificationLevel some xsd:string, sdg:specialization some sdg:SpecializationKind, sdg:hoursAllocated some xsd:decimal, sdg:supervisedBy exactly 1 sdg:FinancialController, sdg:worksOn some sdg:ClientEngagement, sdg:contributesTo some sdg:ManagementAccount

Class: sdg:SchoolLibraryProgram
    Annotations: rdfs:label "School Library Program", iao:0000115 "A structured educational service and resource hub within a school designed to support student learning and information literacy."
    SubClassOf: cco:ont00000995, sdg:programId some xsd:string, sdg:name some sdg:NameKind, sdg:establishedDate some xsd:date, sdg:lastReviewDate some xsd:date, sdg:fundingLevel some xsd:decimal, sdg:operationalStatus some sdg:OperationalStatusKind, sdg:collectionSize some xsd:integer, sdg:serviceHours some xsd:integer, sdg:locatedIn exactly 1 sdg:School, sdg:staffedBy min 2 sdg:TeacherLibrarian, sdg:serves min 2 sdg:Student, sdg:meetsStandard min 3 sdg:InformationLiteracyStandard

Class: sdg:TeacherLibrarian
    Annotations: rdfs:label "Teacher-Librarian", iao:0000115 "A qualified professional who combines teaching and library science expertise to support curriculum and information literacy within a school library program."
    SubClassOf: bfo:0000023, sdg:employeeId some xsd:string, sdg:fullName some xsd:string, sdg:certificationLevel some xsd:string, sdg:yearsOfExperience some xsd:integer, sdg:employmentStatus some sdg:EmploymentStatusKind, sdg:specialization some sdg:SpecializationKind, sdg:hireDate some xsd:date, sdg:employedBy exactly 1 sdg:School, sdg:worksIn exactly 1 sdg:SchoolLibraryProgram, sdg:manages min 2 sdg:InformationResource

Class: sdg:InformationResource
    Annotations: rdfs:label "Information Resource", iao:0000115 "A physical or digital item, such as a book, database, or electronic tool, curated for educational use within a school library."
    SubClassOf: cco:ont00000995, sdg:resourceId some xsd:string, sdg:title some xsd:string, sdg:formatType some xsd:string, sdg:acquisitionDate some xsd:dateTime, sdg:conditionStatus some sdg:ConditionStatusKind, sdg:curriculumAlignment some xsd:string, sdg:accessRestriction some xsd:boolean, sdg:lastCatalogedDate some xsd:date, sdg:heldBy exactly 1 sdg:SchoolLibraryProgram, sdg:usedBy min 2 sdg:Student

Class: sdg:InformationLiteracyStandard
    Annotations: rdfs:label "Information Literacy Standard", iao:0000115 "A defined criterion or benchmark outlining the required skills and competencies for students to effectively find, evaluate, and use information."
    SubClassOf: sdg:AssessmentTool, sdg:standardId some xsd:string, sdg:standardCode some xsd:string, sdg:description some xsd:string, sdg:effectiveDate some xsd:date, sdg:reviewCycle some xsd:integer, sdg:complianceLevel some sdg:ComplianceLevelKind, sdg:targetGradeLevel some xsd:string, sdg:complianceStatus some sdg:ComplianceStatusKind, sdg:appliedTo min 3 sdg:SchoolLibraryProgram, sdg:measuredBy min 2 sdg:AssessmentMetric

Class: sdg:AssessmentMetric
    Annotations: rdfs:label "Assessment Metric", iao:0000115 "A specific measurement or evaluation procedure used to determine the extent to which a student or program meets information literacy standards."
    SubClassOf: sdg:AssessmentTool, sdg:metricId some xsd:string, sdg:metricName some xsd:string, sdg:measurementType some sdg:MeasurementTypeKind, sdg:administeredDate some xsd:date, sdg:scoreThreshold some xsd:decimal, sdg:resultStatus some sdg:ResultStatusKind, sdg:raterId some xsd:string, sdg:evaluates min 2 sdg:Student, sdg:validates exactly 1 sdg:InformationLiteracyStandard, sdg:conductedBy exactly 1 sdg:TeacherLibrarian, sdg:recordsResultIn exactly 1 sdg:AssessmentRecord

Class: sdg:AssessmentRecord
    Annotations: rdfs:label "Assessment Record", iao:0000115 "A formal document or dataset entry capturing the outcome of an assessment metric applied to a student or program."
    SubClassOf: sdg:Record, sdg:recordId some xsd:string, sdg:assessmentDate some xsd:dateTime, sdg:rawScore some xsd:decimal, sdg:normalizedScore some xsd:decimal, sdg:feedbackNotes some xsd:string, sdg:reviewStatus some sdg:ReviewStatusKind, sdg:dataIntegrityCheck some xsd:boolean, sdg:assessmentStatus some xsd:string, sdg:generatedFrom exactly 1 sdg:AssessmentMetric, sdg:documentsPerformanceOf exactly 1 sdg:Student, sdg:storedIn exactly 1 sdg:SchoolLibraryProgram

Class: sdg:PricingAddon
    Annotations: rdfs:label "Pricing Add-On", iao:0000115 "An optional modification or extra component that can be added to a base menu item for an additional fee."
    SubClassOf: cco:ont00000995, sdg:addonCode some xsd:string, sdg:addonName some xsd:string, sdg:additionalCost some xsd:decimal, sdg:addonType some xsd:string, sdg:modifies some sdg:MenuItem

Class: sdg:SubstanceAbuseSurvey
    Annotations: rdfs:label "Substance Abuse Survey", iao:0000115 "A structured data collection instrument and resulting dataset used to quantify the prevalence of substance abuse forms and the availability of treatment resources across Indiana counties."
    SubClassOf: cco:ont00000995, sdg:surveyId some xsd:string, sdg:conductedDate some xsd:dateTime, sdg:responseRate some xsd:decimal, sdg:totalCountiesResponded some xsd:integer, sdg:dataFormat some sdg:DataFormatKind, sdg:status some sdg:StatusKind, sdg:measuredBy min 2 sdg:SubstanceAbuseForm, sdg:coversJurisdiction min 2 sdg:CountyJurisdiction

Class: sdg:SubstanceAbuseForm
    Annotations: rdfs:label "Substance Abuse Form", iao:0000115 "A specific category of psychoactive substance or drug identified as a target of abuse within the population, quantified by prevalence rates in survey data."
    SubClassOf: cco:ont00000995, sdg:formCode some xsd:string, sdg:formName some xsd:string, sdg:prevalenceRate some xsd:decimal, sdg:riskCategory some sdg:RiskCategoryKind, sdg:isControlledSubstance some xsd:boolean, sdg:recordedIn exactly 1 sdg:SubstanceAbuseSurvey, sdg:treatedAt min 2 sdg:TreatmentFacility

Class: sdg:TreatmentFacility
    Annotations: rdfs:label "Treatment Facility", iao:0000115 "A physical or organizational entity providing outpatient, inpatient, or opioid-specific medical treatment and prevention services for substance use disorders."
    SubClassOf: cco:ont00000995, sdg:facilityId some xsd:string, sdg:facilityName some xsd:string, sdg:facilityType some sdg:FacilityTypeKind, sdg:countyLocation some xsd:string, sdg:capacity some xsd:integer, sdg:acceptsMedicaid some xsd:boolean, sdg:locatedIn exactly 1 sdg:CountyJurisdiction, sdg:treatsSubstance min 2 sdg:SubstanceAbuseForm, sdg:fundedBy some sdg:FundingSource

Class: sdg:CoordinatingCouncil
    Annotations: rdfs:label "Local Coordinating Council", iao:0000115 "A local community body responsible for coordinating substance abuse prevention and treatment resources, often funded by community fines and fees, and eligible for state grants."
    SubClassOf: cco:ont00000995, sdg:councilId some xsd:string, sdg:councilName some xsd:string, sdg:countyServed some xsd:string, sdg:hasFundingAvailable some xsd:boolean, sdg:utilizationRate some xsd:decimal, sdg:establishedDate some xsd:date, sdg:locatedIn exactly 1 sdg:CountyJurisdiction, sdg:receivesFundingFrom some sdg:FundingSource, sdg:coordinatesWith min 2 sdg:TreatmentFacility

Class: sdg:ReferralEvent
    Annotations: rdfs:label "Referral Event", iao:0000115 "A process activity wherein an individual is directed from a source system (such as criminal justice) to a treatment facility for substance abuse intervention and care."
    SubClassOf: bfo:0000015, sdg:referralId some xsd:string, sdg:referralDate some xsd:dateTime, sdg:monthlyVolume some xsd:integer, sdg:sourceSystem some sdg:SourceSystemKind, sdg:outcomeStatus some xsd:string, sdg:recidivismRate some xsd:decimal, sdg:directedTo exactly 1 sdg:TreatmentFacility, sdg:involvesPatient exactly 1 sdg:PatientDemographic

Class: sdg:PatientDemographic
    Annotations: rdfs:label "Patient Demographic", iao:0000115 "A statistical record or profile describing the population characteristics of individuals seeking or receiving substance abuse treatment, including race, gender, and insurance status."
    SubClassOf: cco:ont00000995, sdg:demographicId some xsd:string, sdg:primaryRace some xsd:string, sdg:primaryGender some xsd:string, sdg:hasHealthInsurance some xsd:boolean, sdg:isVeteran some xsd:boolean, sdg:isPregnant some xsd:boolean, sdg:accessToCare some xsd:string, sdg:receivesTreatmentAt min 2 sdg:TreatmentFacility, sdg:subjectOf min 2 sdg:ReferralEvent, sdg:coveredBy some sdg:FundingSource

Class: sdg:ParadeEvent
    Annotations: rdfs:label "Annual Memorial Parade Event", iao:0000115 "A scheduled public procession and commemorative event honoring military service members and those who made the ultimate sacrifice."
    SubClassOf: bfo:0000040, sdg:eventDate some xsd:dateTime, sdg:startTime some xsd:dateTime, sdg:locationCity some xsd:string, sdg:locationState some xsd:string, sdg:locationZip some xsd:string, sdg:organizingMunicipality some xsd:string, sdg:isDieselPoweredAllowed some xsd:boolean, sdg:candyThrowingProhibited some xsd:boolean, sdg:hasParticipant__escalated min 2 sdg:ParticipatingOrganization, sdg:hasEntry min 2 sdg:ParadeEntry

Class: sdg:ParadeEntry
    Annotations: rdfs:label "Parade Entry Unit", iao:0000115 "A specific unit, float, vehicle, or group registered to march or drive in the parade procession."
    SubClassOf: sdg:Entity, sdg:entryType some xsd:string, sdg:numberOfParticipants some xsd:integer, sdg:isDieselPowered some xsd:boolean, sdg:giveAwayMethod some sdg:GiveAwayMethodKind, sdg:entryStatus some sdg:EntryStatusKind, sdg:belongsToMany exactly 1 sdg:ParticipatingOrganization, sdg:usesVehicle max 1 sdg:ParadeVehicle, sdg:hasOperator exactly 1 sdg:VehicleOperator

Class: sdg:ParadeVehicle
    Annotations: rdfs:label "Parade Entry Vehicle", iao:0000115 "A motorized or non-motorized vehicle used to transport participants or display floats in the parade."
    SubClassOf: sdg:Entity, sdg:vehicleType some xsd:string, sdg:isDieselPowered some xsd:boolean, sdg:vehicleIdentifier some xsd:string, sdg:vehicleStatus some xsd:string, sdg:carriesEntry exactly 1 sdg:ParadeEntry

Class: sdg:WaitingTimeStatistic
    Annotations: rdfs:label "Waiting Time Statistic", iao:0000115 "A quantitative record of patient performance against cancer waiting time targets for a specific reporting period, including compliance percentages and percentile calculations."
    SubClassOf: cco:ont00000995, sdg:reportingPeriod some xsd:date, sdg:compliancePercentage some xsd:decimal, sdg:eligiblePatientCount some xsd:integer, sdg:treatmentStartCount some xsd:integer, sdg:percentile90 some xsd:decimal, sdg:dataQuality some xsd:string, sdg:measures exactly 1 sdg:CancerWaitingTimeTarget, sdg:reportedBy exactly 1 sdg:NHSBoard, sdg:stratifiedBy some sdg:CancerType

Class: sdg:DataTransaction
    Annotations: rdfs:label "Data Transaction", iao:0000115 "An automated business process activity involving the secure exchange or processing of confidential data between systems, suppliers, or customers."
    SubClassOf: sdg:ProgramActivity, sdg:transactionId some xsd:string, sdg:timestamp some xsd:dateTime, sdg:protocol some xsd:string, sdg:dataVolumeBytes some xsd:decimal, sdg:status some sdg:StatusKind, sdg:complianceStandard some sdg:ComplianceStandardKind, sdg:securityState some xsd:string, sdg:usesEncryptionKey exactly 1 sdg:EncryptionKey, sdg:involvesDataFile min 2 sdg:DataFile, sdg:executedByScript exactly 1 sdg:AutomatedScript, sdg:generatesAuditTrail some sdg:AuditTrail

Class: sdg:DataFile
    Annotations: rdfs:label "Data File", iao:0000115 "A digital record or sample of business-critical information, such as a file or email, that is stored on a server or transmitted between systems."
    SubClassOf: sdg:DataEntity, sdg:fileId some xsd:string, sdg:fileName some xsd:string, sdg:fileSizeBytes some xsd:integer, sdg:storageLocation some xsd:string, sdg:isEncrypted some xsd:boolean, sdg:isDeletedSecurely some xsd:boolean, sdg:compressionRatio some xsd:decimal, sdg:storedOnServer exactly 1 sdg:Server, sdg:partOfTransaction some sdg:DataTransaction, sdg:hasDigitalSignature max 1 sdg:DigitalSignature

Class: sdg:AutomatedScript
    Annotations: rdfs:label "Automated Script", iao:0000115 "A script-driven business process or program that integrates with the PGP Command Line to automatically encrypt, decrypt, or transfer data."
    SubClassOf: bfo:0000015, sdg:scriptId some xsd:string, sdg:scriptName some xsd:string, sdg:platform some sdg:PlatformKind, sdg:isLegacy some xsd:boolean, sdg:executionFrequency some xsd:string, sdg:runsOnServer exactly 1 sdg:Server, sdg:initiatesTransaction some sdg:DataTransaction

Class: sdg:AuditTrail
    Annotations: rdfs:label "Audit Trail", iao:0000115 "A digital record or dataset generated by digital signatures to provide long-term verification of the authenticity of the sender and content of a data transaction."
    SubClassOf: cco:ont00000995, sdg:trailId some xsd:string, sdg:generatedTimestamp some xsd:dateTime, sdg:senderIdentity some xsd:string, sdg:contentHash some xsd:string, sdg:isVerified some xsd:boolean, sdg:linkedToTransaction exactly 1 sdg:DataTransaction, sdg:createdBySignature exactly 1 sdg:DigitalSignature
    HasKey: sdg:trailId

Class: sdg:DigitalSignature
    Annotations: rdfs:label "Digital Signature", iao:0000115 "A cryptographic mechanism applied to a data file to ensure its authenticity and integrity, enabling the recipient to verify the sender and content."
    SubClassOf: cco:ont00000995, sdg:signatureId some xsd:string, sdg:algorithm some sdg:AlgorithmKind, sdg:signingDate some xsd:dateTime, sdg:isValid some xsd:boolean, sdg:signsDataFile exactly 1 sdg:DataFile, sdg:usesEncryptionKey exactly 1 sdg:EncryptionKey, sdg:generatesAuditTrail exactly 1 sdg:AuditTrail
    HasKey: sdg:signatureId

Class: sdg:SustainabilityProject
    Annotations: rdfs:label "Sustainability Project", iao:0000115 "A planned initiative to implement environmental improvements, such as water conservation infrastructure."
    SubClassOf: bfo:0000015, sdg:projectName some xsd:string, sdg:projectDescription some xsd:string, sdg:projectStatus some sdg:ProjectStatusKind, sdg:startDate some xsd:dateTime, sdg:endDate some xsd:dateTime, sdg:projectLocation some xsd:string, sdg:locatedAt exactly 1 sdg:Facility, sdg:implementedBy exactly 1 sdg:CommunityOrganization, sdg:usesInfrastructure min 1 sdg:WaterHarvestingSystem

Class: sdg:WaterHarvestingSystem
    Annotations: rdfs:label "Water Harvesting System", iao:0000115 "A physical infrastructure component designed to capture, store, and utilize rainwater."
    SubClassOf: sdg:Resource, sdg:systemType some xsd:string, sdg:capacityLiters some xsd:decimal, sdg:installationDate some xsd:date, sdg:materialType some sdg:MaterialTypeKind, sdg:systemStatus some sdg:SystemStatusKind, sdg:manufacturer some xsd:string, sdg:installedAt exactly 1 sdg:Facility, sdg:suppliedBy some sdg:CorporateSponsor

Class: sdg:CommunityOrganization
    Annotations: rdfs:label "Community Organization", iao:0000115 "A non-profit group or association dedicated to social or environmental causes."
    SubClassOf: sdg:Organization, sdg:organizationName some xsd:string, sdg:organizationType some sdg:OrganizationTypeKind, sdg:registrationNumber some xsd:string, sdg:foundingDate some xsd:date, sdg:membershipCount some xsd:integer, sdg:organizationStatus some xsd:string, sdg:missionFocus some xsd:string, sdg:manages some sdg:Facility, sdg:receivesGrant some sdg:GrantAward, sdg:implements some sdg:SustainabilityProject
    HasKey: sdg:registrationNumber

Class: sdg:CorporateSponsor
    Annotations: rdfs:label "Corporate Sponsor", iao:0000115 "A business entity providing financial or material support for community projects."
    SubClassOf: bfo:0000040, sdg:companyName some xsd:string, sdg:companyType some xsd:string, sdg:headquartersLocation some xsd:string, sdg:industrySector some sdg:IndustrySectorKind, sdg:sponsorshipProgramName some xsd:string, sdg:totalFundingDistributed some xsd:decimal, sdg:awards some sdg:GrantAward, sdg:supplies some sdg:WaterHarvestingSystem, sdg:partnersWith some sdg:CommunityOrganization

Class: sdg:BuildingShape
    Annotations: rdfs:label "Building Shape", iao:0000115 "A spatial entity representing the geometric configuration of a building's ground plan and vertical division."
    SubClassOf: bfo:0000040, sdg:shapeId some xsd:string, sdg:groundPlanType some xsd:string, sdg:verticalDivisionType some sdg:VerticalDivisionTypeKind, sdg:volume some xsd:decimal, sdg:surfaceArea some xsd:decimal, sdg:shapeFactor some xsd:decimal, sdg:aerodynamicCoefficient some xsd:decimal, sdg:hasEnergySimulation some sdg:EnergySimulation, sdg:hasGlazingRatio some sdg:GlazingRatio

Class: sdg:EnergySimulation
    Annotations: rdfs:label "Energy Simulation", iao:0000115 "A computational process that models the energy flows and performance of a building based on its geometric and material properties."
    SubClassOf: bfo:0000015, sdg:simulationId some xsd:string, sdg:simulationDate some xsd:dateTime, sdg:energyConsumption some xsd:decimal, sdg:heatingLoad some xsd:decimal, sdg:coolingLoad some xsd:decimal, sdg:ventilationRate some xsd:decimal, sdg:indoorTemperature some xsd:decimal, sdg:outdoorTemperature some xsd:decimal, sdg:analyzesBuildingShape exactly 1 sdg:BuildingShape, sdg:usesBuildingMaterial some sdg:BuildingMaterial
    HasKey: sdg:simulationId

Class: sdg:GlazingRatio
    Annotations: rdfs:label "Glazing Ratio", iao:0000115 "A quantitative attribute representing the percentage of glazing area relative to the total wall area of a building facade."
    SubClassOf: bfo:0000040, sdg:glazingRatioId some xsd:string, sdg:wallArea some xsd:decimal, sdg:glazingArea some xsd:decimal, sdg:ratioPercentage some xsd:decimal, sdg:orientation some xsd:string, sdg:appliedToBuildingShape exactly 1 sdg:BuildingShape

Class: sdg:BuildingMaterial
    Annotations: rdfs:label "Building Material", iao:0000115 "A physical substance used in the construction of a building's envelope or structure, characterized by its thermal and structural properties."
    SubClassOf: bfo:0000040, sdg:materialId some xsd:string, sdg:materialName some xsd:string, sdg:thermalConductivity some xsd:decimal, sdg:density some xsd:decimal, sdg:thickness some xsd:decimal, sdg:installationDate some xsd:date, sdg:usedInEnergySimulation some sdg:EnergySimulation

Class: sdg:OptimizationProcess
    Annotations: rdfs:label "Optimization Process", iao:0000115 "A methodological activity aimed at minimizing costs or maximizing efficiency in the use of auxiliary structures or building design parameters."
    SubClassOf: bfo:0000015, sdg:processId some xsd:string, sdg:startDate some xsd:dateTime, sdg:endDate some xsd:dateTime, sdg:costReduction some xsd:decimal, sdg:efficiencyGain some xsd:decimal, sdg:status some sdg:StatusKind, sdg:optimizesBuildingShape some sdg:BuildingShape, sdg:usesEnergySimulationData some sdg:EnergySimulation

Class: sdg:DemographicSurvey
    Annotations: rdfs:label "Demographic Survey", iao:0000115 "A statistical survey instrument and resulting dataset capturing population structure, age distribution, and household composition metrics for a defined territory and time period."
    SubClassOf: cco:ont00000958, sdg:surveyId some xsd:string, sdg:surveyYear some xsd:integer, sdg:territory some xsd:string, sdg:totalPopulationCount some xsd:decimal, sdg:childPopulationCount some xsd:decimal, sdg:childPopulationPercentage some xsd:decimal, sdg:underFivePercentage some xsd:decimal, sdg:fiveToNinePercentage some xsd:decimal, sdg:tenToFourteenPercentage some xsd:decimal, sdg:fifteenToSeventeenPercentage some xsd:decimal, sdg:conductedBy exactly 1 sdg:StatisticalBureau, sdg:coversTerritory exactly 1 sdg:GeographicRegion
    HasKey: sdg:surveyId

Class: sdg:HealthMortalityRecord
    Annotations: rdfs:label "Health Mortality Record", iao:0000115 "A recorded instance of infant or child death data, categorized by cause, age group, gender, and geographic region, sourced from health ministry statistics."
    SubClassOf: cco:ont00000995, sdg:recordId some xsd:string, sdg:causeOfDeath some xsd:string, sdg:causePercentage some xsd:decimal, sdg:malePercentage some xsd:decimal, sdg:femalePercentage some xsd:decimal, sdg:ageGroup some xsd:string, sdg:recordYear some xsd:integer, sdg:region some sdg:RegionKind, sdg:recordedInRegion exactly 1 sdg:GeographicRegion, sdg:categorizedByCause exactly 1 sdg:MedicalCondition

Class: sdg:EducationEnrollment
    Annotations: rdfs:label "Education Enrollment", iao:0000115 "A statistical record of student enrollment, dropout rates, and failure rates across educational levels for a specific academic year and gender."
    SubClassOf: cco:ont00000995, sdg:enrollmentId some xsd:string, sdg:academicYear some xsd:string, sdg:educationLevel some sdg:EducationLevelKind, sdg:totalStudents some xsd:integer, sdg:dropoutRate some xsd:decimal, sdg:maleDropoutRate some xsd:decimal, sdg:femaleDropoutRate some xsd:decimal, sdg:failureRate some xsd:decimal, sdg:maleFailureRate some xsd:decimal, sdg:femaleFailureRate some xsd:decimal, sdg:measuredInRegion exactly 1 sdg:GeographicRegion, sdg:partOfSurvey some sdg:DemographicSurvey

Class: sdg:ChildLaborStatistic
    Annotations: rdfs:label "Child Labor Statistic", iao:0000115 "A statistical record quantifying the participation of children in the labor market, including employment rates, wage averages, and working hours by gender and region."
    SubClassOf: cco:ont00000995, sdg:laborStatId some xsd:string, sdg:statYear some xsd:integer, sdg:employmentRate some xsd:decimal, sdg:maleEmploymentRate some xsd:decimal, sdg:femaleEmploymentRate some xsd:decimal, sdg:schoolAndWorkRate some xsd:decimal, sdg:averageDailyWage some xsd:decimal, sdg:weeklyWorkingHours some xsd:decimal, sdg:currencyCode some xsd:string, sdg:recordedInRegion exactly 1 sdg:GeographicRegion, sdg:derivedFromSurvey some sdg:DemographicSurvey

Class: sdg:PovertyIndex
    Annotations: rdfs:label "Poverty Index", iao:0000115 "A statistical measure of household and child poverty levels based on consumption patterns, disaggregated by region and household composition."
    SubClassOf: cco:ont00000995, sdg:povertyIndexId some xsd:string, sdg:indexYear some xsd:integer, sdg:householdPovertyRate some xsd:decimal, sdg:childPovertyRate some xsd:decimal, sdg:poorHouseholdsWithChildrenPercent some xsd:decimal, sdg:region some sdg:RegionKind, sdg:measuredInRegion exactly 1 sdg:GeographicRegion, sdg:derivedFromSurvey some sdg:DemographicSurvey

Class: sdg:StatisticalBureau
    Annotations: rdfs:label "Statistical Bureau", iao:0000115 "An organizational role or entity responsible for conducting surveys, collecting data, and issuing statistical press releases regarding population and social conditions."
    SubClassOf: bfo:0000040, sdg:bureauId some xsd:string, sdg:bureauName some xsd:string, sdg:location some xsd:string, sdg:contactPhone some xsd:string, sdg:contactEmail some xsd:string, sdg:conductsSurvey some sdg:DemographicSurvey, sdg:issuesPressRelease max 1 sdg:StatisticalBureau

Class: sdg:ShipmentRecord
    Annotations: rdfs:label "Shipment Record", iao:0000115 "A logistical event recording the outbound movement of inventory items to a customer or distributor."
    SubClassOf: cco:ont00000995, sdg:trackingNumber some xsd:string, sdg:shipmentDate some xsd:dateTime, sdg:carrierName some xsd:string, sdg:totalWeight some xsd:decimal, sdg:shippingMethod some xsd:string, sdg:status some sdg:StatusKind, sdg:containsItem min 2 sdg:InventoryItem, sdg:destinedFor exactly 1 sdg:CustomerAccount

Class: sdg:MarketingCampaign
    Annotations: rdfs:label "Marketing Campaign", iao:0000115 "A coordinated business activity designed to promote products, manage customer service programs, and drive sales revenue."
    SubClassOf: bfo:0000015, sdg:campaignID some xsd:string, sdg:campaignName some xsd:string, sdg:startDate some xsd:dateTime, sdg:endDate some xsd:dateTime, sdg:budget some xsd:decimal, sdg:channel some xsd:string, sdg:status some sdg:StatusKind, sdg:targetsCustomer min 3 sdg:CustomerAccount, sdg:promotesItem some sdg:InventoryItem

Class: sdg:DatabaseRecord
    Annotations: rdfs:label "Database Record", iao:0000115 "A structured digital entry within the inventory or customer management system, representing a snapshot of business data."
    SubClassOf: sdg:Record, sdg:recordID some xsd:string, sdg:tableName some xsd:string, sdg:lastModified some xsd:dateTime, sdg:modifiedBy some xsd:string, sdg:recordHash some xsd:string, sdg:isDuplicate some xsd:boolean, sdg:representsEntity max 1 sdg:InventoryItem, sdg:representsEntity max 1 sdg:CustomerAccount

Class: sdg:Bowler
    Annotations: rdfs:label "Bowler", iao:0000115 "A human participant registered to bowl in a tournament, identified by a unique book ID and tracked by their verified and declared scoring averages."
    SubClassOf: bfo:0000040, sdg:bookId some xsd:string, sdg:fullName some xsd:string, sdg:declaredAverage some xsd:decimal, sdg:verifiedAverage some xsd:decimal, sdg:residentialAddress some xsd:string, sdg:participatedIn some sdg:Tournament, sdg:subjectOf some sdg:DisqualificationLetter

Class: sdg:TournamentRule
    Annotations: rdfs:label "Tournament Rule", iao:0000115 "A normative standard or regulation governing participant conduct and scoring, identified by a specific code and description."
    SubClassOf: sdg:CompetitionEntity, sdg:ruleCode some xsd:string, sdg:ruleDescription some xsd:string, sdg:issuingBody some xsd:string, sdg:violatedBy some sdg:Bowler, sdg:governs some sdg:Tournament
    HasKey: sdg:ruleCode

Class: sdg:DisqualificationLetter
    Annotations: rdfs:label "Disqualification Letter", iao:0000115 "An official administrative document issued to a participant notifying them of their disqualification from prize consideration due to rule violations."
    SubClassOf: cco:ont00000958, sdg:issueDate some xsd:date, sdg:appealDeadlineDays some xsd:integer, sdg:appealAddress some xsd:string, sdg:appealFax some xsd:string, sdg:appealEmail some xsd:string, sdg:status some sdg:StatusKind, sdg:issuedTo exactly 1 sdg:Bowler, sdg:referencesRule exactly 1 sdg:TournamentRule, sdg:issuedBy exactly 1 sdg:Tournament

Class: sdg:Prize
    Annotations: rdfs:label "Prize", iao:0000115 "A reward or award distributed to participants based on their performance, which may be contingent on adherence to tournament rules."
    SubClassOf: bfo:0000002, sdg:prizeType some sdg:PrizeTypeKind, sdg:prizeValue some xsd:decimal, sdg:eligibilityStatus some xsd:string, sdg:awardedTo some sdg:Bowler, sdg:partOf exactly 1 sdg:Tournament

Class: sdg:Appeal
    Annotations: rdfs:label "Appeal", iao:0000115 "A formal written request submitted by a disqualified participant to a governing body to contest a disqualification decision."
    SubClassOf: bfo:0000015, sdg:submissionDate some xsd:dateTime, sdg:postmarkDate some xsd:date, sdg:isWritten some xsd:boolean, sdg:outcome some sdg:OutcomeKind, sdg:challenges exactly 1 sdg:DisqualificationLetter, sdg:submittedBy exactly 1 sdg:Bowler, sdg:receivedBy exactly 1 sdg:Tournament

Class: sdg:BreedingProgram
    Annotations: rdfs:label "Breeding Program", iao:0000115 "A structured selection and evaluation process for North American Hanoverian Jumper horses."
    SubClassOf: bfo:0000015, sdg:programId some xsd:string, sdg:programName some xsd:string, sdg:startDate some xsd:dateTime, sdg:status some sdg:StatusKind

Class: sdg:Horse
    Annotations: rdfs:label "Horse", iao:0000115 "A registered North American Hanoverian Jumper horse subject to breeding program evaluation."
    SubClassOf: cco:ont00000995, sdg:horseId some xsd:string, sdg:horseName some xsd:string, sdg:registrationNumber some xsd:string, sdg:dateOfBirth some xsd:date, sdg:sex some sdg:SexKind, sdg:breed some xsd:string, sdg:status some sdg:StatusKind, sdg:evaluatedBy exactly 1 sdg:BreedingProgram, sdg:hasOwner exactly 1 sdg:Owner, sdg:hasSire max 1 sdg:Horse, sdg:hasDam max 1 sdg:Horse

Class: sdg:PerformanceTest
    Annotations: rdfs:label "Performance Test", iao:0000115 "A formal evaluation of a horse's jumping ability and performance."
    SubClassOf: bfo:0000015, sdg:testId some xsd:string, sdg:testDate some xsd:dateTime, sdg:jumpingScore some xsd:decimal, sdg:breedingValue some xsd:decimal, sdg:testType some sdg:TestTypeKind, sdg:conductedOn exactly 1 sdg:Horse, sdg:evaluatedBy exactly 1 sdg:Evaluator

Class: sdg:Evaluator
    Annotations: rdfs:label "Evaluator", iao:0000115 "A person or organization responsible for conducting performance tests and evaluations."
    SubClassOf: bfo:0000023, sdg:evaluatorId some xsd:string, sdg:evaluatorName some xsd:string, sdg:organization some xsd:string, sdg:roleDetail some sdg:RoleKind, sdg:evaluates some sdg:PerformanceTest

Class: sdg:CompetitionRecord
    Annotations: rdfs:label "Competition Record", iao:0000115 "A documented record of a horse's participation and success in jumping competitions."
    SubClassOf: sdg:CompetitionEntity, sdg:recordId some xsd:string, sdg:competitionName some xsd:string, sdg:competitionLevel some sdg:CompetitionLevelKind, sdg:competitionDate some xsd:date, sdg:result some sdg:ResultKind, sdg:competitionType some xsd:string, sdg:participatedIn exactly 1 sdg:Horse, sdg:recordedBy exactly 1 sdg:Evaluator

Class: sdg:Pedigree
    Annotations: rdfs:label "Pedigree", iao:0000115 "A documented lineage of a horse's ancestors, focusing on jumping sires."
    SubClassOf: cco:ont00000995, sdg:pedigreeId some xsd:string, sdg:sireName some xsd:string, sdg:damName some xsd:string, sdg:grandSireName some xsd:string, sdg:grandDamName some xsd:string, sdg:jumpingSireCount some xsd:integer, sdg:describes exactly 1 sdg:Horse, sdg:includesSire exactly 1 sdg:Horse, sdg:includesDam exactly 1 sdg:Horse

Class: sdg:VpnServer
    Annotations: rdfs:label "VPN Server Device", iao:0000115 "A physical micro-server appliance that terminates VPN tunnels and manages network access policies for connected clients."
    SubClassOf: bfo:0000040, sdg:serialNumber some xsd:string, sdg:firmwareVersion some xsd:string, sdg:maxConcurrentConnections some xsd:integer, sdg:powerConsumptionWatts some xsd:decimal, sdg:formFactor some xsd:string, sdg:status some sdg:StatusKind, sdg:enforcesPolicy exactly 1 sdg:SecurityPolicy, sdg:supportsProtocol min 2 sdg:VpnProtocol, sdg:servesClient min 2 sdg:VpnClient

Class: sdg:VpnClient
    Annotations: rdfs:label "VPN Hardware Client", iao:0000115 "A hardware gateway device that routes local device traffic through a secure VPN tunnel to a remote server."
    SubClassOf: bfo:0000040, sdg:serialNumber some xsd:string, sdg:firmwareVersion some xsd:string, sdg:connectionMode some sdg:ConnectionModeKind, sdg:routingMode some sdg:RoutingModeKind, sdg:macAddress some xsd:string, sdg:status some sdg:StatusKind, sdg:connectsToServer exactly 1 sdg:VpnServer, sdg:supportsProtocol min 2 sdg:VpnProtocol, sdg:routesTrafficFor min 2 sdg:NetworkDevice

Class: sdg:VpnProtocol
    Annotations: rdfs:label "VPN Protocol", iao:0000115 "A standardized set of rules and encryption methods used to establish secure point-to-point connections over the Internet."
    SubClassOf: bfo:0000040, sdg:protocolName some xsd:string, sdg:encryptionStandard some sdg:EncryptionStandardKind, sdg:portNumber some xsd:integer, sdg:transportLayer some xsd:string, sdg:isDeprecated some xsd:boolean, sdg:securityRating some xsd:string, sdg:implementedBy min 2 sdg:VpnServer, sdg:implementedBy min 2 sdg:VpnClient

Class: sdg:DataPacket
    Annotations: rdfs:label "Encrypted Data Packet", iao:0000115 "A discrete unit of data transmitted across the Internet, encapsulated and encrypted within a VPN tunnel to prevent industrial espionage."
    SubClassOf: bfo:0000040, sdg:packetId some xsd:string, sdg:payloadSizeBytes some xsd:integer, sdg:timestamp some xsd:dateTime, sdg:encryptionAlgorithm some xsd:string, sdg:protocolType some xsd:string, sdg:isEncrypted some xsd:boolean, sdg:integrityCheckHash some xsd:string, sdg:routedBy exactly 1 sdg:VpnClient, sdg:terminatedBy exactly 1 sdg:VpnServer, sdg:originatesFrom exactly 1 sdg:NetworkDevice

Class: sdg:FlightServiceStation
    Annotations: rdfs:label "Flight Service Station", iao:0000115 "A physical facility or organizational unit providing aeronautical information services, air traffic services, and communications to aircraft in flight."
    SubClassOf: bfo:0000040, sdg:stationIdentifier some sdg:StationIdentifierKind, sdg:stationName some xsd:string, sdg:establishmentDate some xsd:date, sdg:operationalStatus some sdg:OperationalStatusKind, sdg:coverageArea some xsd:string, sdg:primaryCommunicationMode some xsd:string, sdg:parentOrganization some xsd:string, sdg:locationCity some xsd:string, sdg:locationProvince some xsd:string, sdg:covers min 1 sdg:FlightInformationRegion, sdg:employs min 2 sdg:AirTrafficController, sdg:uses min 1 sdg:CommunicationSystem, sdg:locatedIn exactly 1 sdg:GeographicLocation

Class: sdg:FlightInformationRegion
    Annotations: rdfs:label "Flight Information Region", iao:0000115 "A defined volume of airspace within which flight information service and alerting service are provided."
    SubClassOf: bfo:0000040, sdg:firIdentifier some xsd:string, sdg:firName some xsd:string, sdg:firType some sdg:FirTypeKind, sdg:areaSize some xsd:decimal, sdg:upperLimit some xsd:string, sdg:lowerLimit some xsd:string, sdg:controllingAuthority some xsd:string, sdg:coveredBy min 1 sdg:FlightServiceStation, sdg:overlaps some sdg:FlightInformationRegion

Class: sdg:AirTrafficController
    Annotations: rdfs:label "Air Traffic Controller", iao:0000115 "A qualified professional responsible for providing air traffic services, including separation, sequencing, and information to aircraft."
    SubClassOf: bfo:0000040, sdg:controllerId some xsd:string, sdg:firstName some xsd:string, sdg:lastName some xsd:string, sdg:shiftType some xsd:string, sdg:yearsOfExperience some xsd:integer, sdg:certificationLevel some xsd:string, sdg:currentAssignment some xsd:string, sdg:contactMethod some sdg:ContactMethodKind, sdg:worksAt exactly 1 sdg:FlightServiceStation, sdg:monitors min 1 sdg:CommunicationSystem, sdg:serves min 1 sdg:FlightInformationRegion
    HasKey: sdg:controllerId

Class: sdg:CommunicationSystem
    Annotations: rdfs:label "Communication System", iao:0000115 "A technical infrastructure enabling voice and data transmission between ground stations and aircraft, including HF, VHF, and digital networks."
    SubClassOf: bfo:0000040, sdg:systemId some xsd:string, sdg:systemName some xsd:string, sdg:frequencyBand some xsd:string, sdg:coverageRange some xsd:decimal, sdg:signalQuality some xsd:string, sdg:dataFormat some sdg:DataFormatKind, sdg:encryptionStatus some xsd:boolean, sdg:lastMaintenanceDate some xsd:date, sdg:usedBy min 1 sdg:FlightServiceStation, sdg:supports min 1 sdg:AirTrafficController, sdg:transmitsTo min 1 sdg:Aircraft

Class: sdg:Aircraft
    Annotations: rdfs:label "Aircraft", iao:0000115 "A vehicle capable of flight, including commercial airliners, cargo planes, and private aircraft operating within controlled airspace."
    SubClassOf: sdg:Entity, sdg:registrationNumber some xsd:string, sdg:aircraftType some xsd:string, sdg:operator some xsd:string, sdg:flightNumber some xsd:string, sdg:departureAirport some xsd:string, sdg:arrivalAirport some xsd:string, sdg:passengerCount some xsd:integer, sdg:cargoWeight some xsd:decimal, sdg:currentAltitude some xsd:integer, sdg:currentSpeed some xsd:integer, sdg:flightStatus some sdg:FlightStatusKind, sdg:monitoredBy min 1 sdg:FlightServiceStation, sdg:communicatesWith min 1 sdg:CommunicationSystem, sdg:operatesIn min 1 sdg:FlightInformationRegion

Class: sdg:HealthPlan
    Annotations: rdfs:label "Health Plan", iao:0000115 "An organized arrangement of health benefits and coverage terms established by an employer or insurer for eligible individuals."
    SubClassOf: cco:ont00000995, sdg:planIdentifier some xsd:string, sdg:planName some xsd:string, sdg:insuranceType some xsd:string, sdg:grandfatheredStatus some xsd:string, sdg:effectiveDate some xsd:date, sdg:terminationDate some xsd:date, sdg:isCafeteriaPlan some xsd:boolean, sdg:employerSize some xsd:integer, sdg:hasComplianceObligation min 2 sdg:ComplianceObligation, sdg:coversIndividual min 2 sdg:EligibleIndividual

Class: sdg:ComplianceObligation
    Annotations: rdfs:label "Compliance Obligation", iao:0000115 "A regulatory requirement or action mandated by health care reform law that an employer or plan administrator must fulfill within a specified timeframe."
    SubClassOf: sdg:RegulatoryComplianceConcept, sdg:obligationIdentifier some xsd:string, sdg:description some xsd:string, sdg:complianceDeadline some xsd:dateTime, sdg:status some sdg:StatusKind, sdg:applicableYear some xsd:integer, sdg:requiresAmendment some xsd:boolean, sdg:guidanceStatus some xsd:string, sdg:obligationType some xsd:string, sdg:appliesToPlan exactly 1 sdg:HealthPlan, sdg:requiresDocument min 2 sdg:PlanDocument, sdg:triggersReporting max 1 sdg:ReportingRequirement

Class: sdg:PlanDocument
    Annotations: rdfs:label "Plan Document", iao:0000115 "A formal written record that defines the terms, conditions, and modifications of a health benefit plan, including SPDs, plan documents, and notices."
    SubClassOf: cco:ont00000958, sdg:documentIdentifier some xsd:string, sdg:documentType some sdg:DocumentTypeKind, sdg:versionNumber some xsd:string, sdg:issueDate some xsd:date, sdg:distributionStatus some sdg:DistributionStatusKind, sdg:containsGrandfatherStatus some xsd:boolean, sdg:requiresAmendment some xsd:boolean, sdg:definesPlan exactly 1 sdg:HealthPlan, sdg:supportsObligation min 2 sdg:ComplianceObligation, sdg:distributedToIndividual min 2 sdg:EligibleIndividual

Class: sdg:ReportingRequirement
    Annotations: rdfs:label "Reporting Requirement", iao:0000115 "A mandatory disclosure or data submission obligation imposed on employers or plans by health care reform regulations, such as W-2 reporting or quality of care reports."
    SubClassOf: bfo:0000015, sdg:requirementIdentifier some xsd:string, sdg:reportType some sdg:ReportTypeKind, sdg:effectiveDate some xsd:date, sdg:isVoluntary some xsd:boolean, sdg:applicableEntitySize some xsd:string, sdg:status some sdg:StatusKind, sdg:reportedByPlan exactly 1 sdg:HealthPlan

Class: sdg:InsuranceClaim
    Annotations: rdfs:label "Insurance Claim", iao:0000115 "A formal request submitted by an individual or provider for reimbursement of covered health care expenses under a health plan."
    SubClassOf: cco:ont00000995, sdg:claimIdentifier some xsd:string, sdg:claimDate some xsd:date, sdg:claimAmount some xsd:decimal, sdg:claimStatus some xsd:string, sdg:coversOverTheCounter some xsd:boolean, sdg:requiresPreAuthorization some xsd:boolean, sdg:filedByIndividual exactly 1 sdg:EligibleIndividual, sdg:processedByPlan exactly 1 sdg:HealthPlan, sdg:relatedToProvider max 1 sdg:HealthcareProvider

Class: sdg:AccreditedOrganization
    Annotations: rdfs:label "Accredited Organization", iao:0000115 "A legal entity or facility authorized to perform specific calibration activities under an accreditation scheme."
    SubClassOf: sdg:Authority, sdg:legalName some xsd:string, sdg:streetAddress some xsd:string, sdg:city some xsd:string, sdg:state some xsd:string, sdg:postalCode some xsd:string, sdg:contactPhone some xsd:string, sdg:activityScope some xsd:string, sdg:holdsCertificate some sdg:AccreditationCertificate
    HasKey: sdg:postalCode

Class: sdg:AccreditationScope
    Annotations: rdfs:label "Accreditation Scope", iao:0000115 "A detailed specification of the specific technical parameters, ranges, and equipment types an organization is authorized to calibrate."
    SubClassOf: cco:ont00000958, sdg:scopeTitle some xsd:string, sdg:technicalDomain some xsd:string, sdg:isOnSiteAvailable some xsd:boolean, sdg:scopeVersion some xsd:string, sdg:partOfCertificate exactly 1 sdg:AccreditationCertificate, sdg:definesCapability min 3 sdg:CalibrationCapability

Class: sdg:CalibrationCapability
    Annotations: rdfs:label "Calibration Capability", iao:0000115 "A specific, authorized technical ability to calibrate a particular parameter within a defined range with a stated uncertainty."
    SubClassOf: sdg:AssessmentTool, sdg:parameterName some xsd:string, sdg:equipmentType some xsd:string, sdg:measurementRangeMin some xsd:decimal, sdg:measurementRangeMax some xsd:decimal, sdg:unitOfMeasurement some xsd:string, sdg:expandedUncertaintyValue some xsd:decimal, sdg:coverageFactor some xsd:decimal, sdg:definedInScope exactly 1 sdg:AccreditationScope, sdg:usesStandard some sdg:MeasurementStandard

Class: sdg:MeasurementStandard
    Annotations: rdfs:label "Measurement Standard", iao:0000115 "A physical artifact, reference material, or reference software used to realize a unit of measurement or to calibrate other devices."
    SubClassOf: bfo:0000040, sdg:standardIdentifier some xsd:string, sdg:standardType some xsd:string, sdg:manufacturer some xsd:string, sdg:calibrationDueDate some xsd:date, sdg:status some sdg:StatusKind, sdg:supportsCapability some sdg:CalibrationCapability

Class: sdg:AccreditationStandard
    Annotations: rdfs:label "Accreditation Standard", iao:0000115 "A published normative document specifying requirements for competence, impartiality, and consistent operation of calibration laboratories."
    SubClassOf: cco:ont00000958, sdg:standardNumber some xsd:string, sdg:standardTitle some xsd:string, sdg:publicationYear some xsd:integer, sdg:issuingOrganizationDetail some xsd:string, sdg:mandatesCertificate some sdg:AccreditationCertificate

Class: sdg:HousingAdvisoryCase
    Annotations: rdfs:label "Housing Advisory Case", iao:0000115 "A specific housing or homelessness matter requiring expert consultation, casework, or advisory support from the NHAS."
    SubClassOf: bfo:0000040, sdg:caseId some xsd:string, sdg:caseType some sdg:CaseTypeKind, sdg:status some sdg:StatusKind, sdg:priorityLevel some sdg:PriorityLevelKind, sdg:referralSource some sdg:ReferralSourceKind, sdg:dateOpened some xsd:dateTime, sdg:dateClosed some xsd:dateTime, sdg:handledBy exactly 1 sdg:HousingSpecialist, sdg:servesClient exactly 1 sdg:HousingClient, sdg:requiresTraining some sdg:TrainingModule

Class: sdg:HousingSpecialist
    Annotations: rdfs:label "Housing Specialist", iao:0000115 "A professional housing adviser or caseworker employed by or contracted to the NHAS to provide expert consultancy and casework."
    SubClassOf: bfo:0000040, sdg:specialistId some xsd:string, sdg:fullName some xsd:string, sdg:specialization some sdg:SpecializationKind, sdg:employmentStatus some sdg:EmploymentStatusKind, sdg:certificationLevel some xsd:string, sdg:contactEmail some xsd:string, sdg:contactPhone some xsd:string, sdg:providesAdviceFor min 2 sdg:HousingAdvisoryCase, sdg:deliversTrainingFor some sdg:TrainingModule, sdg:worksFor exactly 1 sdg:NHAS

Class: sdg:HousingClient
    Annotations: rdfs:label "Housing Client", iao:0000115 "An individual or household seeking or receiving housing advice, support, or casework services from the NHAS."
    SubClassOf: bfo:0000040, sdg:clientId some xsd:string, sdg:householdSize some xsd:integer, sdg:currentHousingStatus some sdg:CurrentHousingStatusKind, sdg:primaryNeed some sdg:PrimaryNeedKind, sdg:dateOfReferral some xsd:dateTime, sdg:hasDependents some xsd:boolean, sdg:receivesAdviceFrom some sdg:HousingAdvisoryCase, sdg:residesIn exactly 1 sdg:GeographicArea

Class: sdg:TrainingModule
    Annotations: rdfs:label "Training Module", iao:0000115 "A structured educational session or course designed to upskill housing advisers on homelessness law, policy, and best practices."
    SubClassOf: sdg:EducationalEntity, sdg:moduleId some xsd:string, sdg:title some xsd:string, sdg:deliveryMode some xsd:string, sdg:level some sdg:LevelKind, sdg:durationHours some xsd:decimal, sdg:isFree some xsd:boolean, sdg:lastUpdated some xsd:dateTime, sdg:deliveredBy exactly 1 sdg:HousingSpecialist, sdg:attends min 2 sdg:HousingAdviser, sdg:coversTopic some sdg:LegalTopic

Class: sdg:HousingAdviser
    Annotations: rdfs:label "Housing Adviser", iao:0000115 "A frontline professional working for a Local Citizens Advice, voluntary agency, or local authority who receives training and consultancy from the NHAS."
    SubClassOf: bfo:0000040, sdg:adviserId some xsd:string, sdg:fullName some xsd:string, sdg:employerType some xsd:string, sdg:yearsExperience some xsd:integer, sdg:lastTrainingDate some xsd:date, sdg:contactEmail some xsd:string, sdg:attendsTraining some sdg:TrainingModule, sdg:submitsCase some sdg:HousingAdvisoryCase, sdg:worksFor exactly 1 sdg:NHAS

Class: sdg:NHAS
    Annotations: rdfs:label "National Homelessness Advice Service", iao:0000115 "The central organizational entity providing consultancy, training, and casework support for housing and homelessness advice in England."
    SubClassOf: bfo:0000040, sdg:serviceId some xsd:string, sdg:fundingSource some sdg:FundingSourceKind, sdg:operatingHours some xsd:string, sdg:isFree some xsd:boolean, sdg:establishedYear some xsd:integer, sdg:employs min 2 sdg:HousingSpecialist, sdg:supports min 2 sdg:HousingAdviser, sdg:funds some sdg:TrainingModule

Class: sdg:LegalTopic
    Annotations: rdfs:label "Legal Topic", iao:0000115 "A specific area of housing law, policy, or case law that is covered in training modules or advisory consultations."
    SubClassOf: sdg:LegalEntity, sdg:topicId some xsd:string, sdg:topicName some xsd:string, sdg:category some sdg:CategoryKind, sdg:lastReviewed some xsd:date, sdg:isCurrent some xsd:boolean, sdg:coveredIn some sdg:TrainingModule, sdg:appliedTo some sdg:HousingAdvisoryCase

Class: sdg:DecisionMaker
    Annotations: rdfs:label "Decision Maker", iao:0000115 "A stakeholder or individual within an organization who utilizes analytical information systems to make informed business decisions."
    SubClassOf: bfo:0000004, sdg:stakeholderIdentifier some xsd:string, sdg:roleTitle some sdg:RoleTitleKind, sdg:decisionFrequency some sdg:DecisionFrequencyKind, sdg:informationRequirementLevel some xsd:string, sdg:satisfactionScore some xsd:decimal, sdg:utilizes min 2 sdg:AnalyticalInformationSystem, sdg:belongsTo exactly 1 sdg:OrganizationalUnit, sdg:influencedBy min 3 sdg:SuccessFactor, sdg:evaluatedBy some sdg:PerformanceMetric

