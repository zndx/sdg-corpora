Class: sdg:PrescribedEntity
    Annotations: rdfs:label "Prescribed Entity", iao:0000115 "An organization or entity prescribed under the Personal Health Information Protection Act to receive personal health information without consent for analysis, statistical compilation, or health system management."
    SubClassOf: cco:ont00000958, sdg:entityIdentifier some xsd:string, sdg:entityName some xsd:string, sdg:prescriptionDate some xsd:dateTime, sdg:approvalStatus some sdg:ApprovalStatusKind, sdg:reviewCycle some xsd:integer, sdg:hasReview some sdg:PrivacyReview, sdg:receivesDataFrom some sdg:HealthInformationCustodian, sdg:maintainsRegistry some sdg:HealthRegistry

Class: sdg:PrivacyReview
    Annotations: rdfs:label "Privacy Review", iao:0000115 "A statutory review process conducted by the Information and Privacy Commissioner to evaluate whether a prescribed entity's practices and procedures meet privacy protection requirements."
    SubClassOf: bfo:0000015, sdg:reviewId some xsd:string, sdg:reviewDate some xsd:dateTime, sdg:reviewType some xsd:string, sdg:reviewOutcome some sdg:ReviewOutcomeKind, sdg:reviewerName some xsd:string, sdg:evaluatesEntity exactly 1 sdg:PrescribedEntity, sdg:documentsRecommendations some sdg:ComplianceRecommendation

Class: sdg:HealthInformationCustodian
    Annotations: rdfs:label "Health Information Custodian", iao:0000115 "A person or organization that has custody or control of personal health information and is authorized to disclose it to prescribed entities under the Act."
    SubClassOf: cco:ont00000958, sdg:custodianId some xsd:string, sdg:custodianName some xsd:string, sdg:custodianType some xsd:string, sdg:registrationDate some xsd:dateTime, sdg:complianceStatus some sdg:ComplianceStatusKind, sdg:disclosesTo some sdg:PrescribedEntity

Class: sdg:ComplianceRecommendation
    Annotations: rdfs:label "Compliance Recommendation", iao:0000115 "A formal recommendation issued by the IPC to a prescribed entity to enhance privacy protection practices and procedures."
    SubClassOf: sdg:RegulatoryComplianceConcept, sdg:recommendationId some xsd:string, sdg:issueDate some xsd:date, sdg:priorityLevel some sdg:PriorityLevelKind, sdg:status some sdg:StatusKind, sdg:description some xsd:string, sdg:issuedByReview exactly 1 sdg:PrivacyReview, sdg:targetedAtEntity exactly 1 sdg:PrescribedEntity

Class: sdg:HealthRegistry
    Annotations: rdfs:label "Health Registry", iao:0000115 "A structured collection of personal health information maintained by a prescribed entity for analysis, statistical compilation, or health system management."
    SubClassOf: sdg:HealthcareEntity, sdg:registryId some xsd:string, sdg:registryName some xsd:string, sdg:dataCategory some xsd:string, sdg:lastUpdated some xsd:dateTime, sdg:recordCount some xsd:integer, sdg:maintainedBy exactly 1 sdg:PrescribedEntity, sdg:storesPatientData some sdg:PatientRecord

