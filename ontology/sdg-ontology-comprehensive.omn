    Annotations: rdfs:label "EYE Partner Organization", iao:0000115 "An institution or enterprise that has joined forces to achieve the goals of the EYE project."
    SubClassOf: bfo:0000040, sdg:partnerId some xsd:string, sdg:organizationName some xsd:string, sdg:organizationType some sdg:OrganizationTypeKind, sdg:country some sdg:CountryKind, sdg:isCoordinator some xsd:boolean, sdg:orgId some xsd:string, sdg:orgName some xsd:string, sdg:orgType some sdg:OrgTypeKind, sdg:countryCode some sdg:CountryCodeKind, sdg:isOriginator some xsd:boolean, sdg:sector some sdg:SectorKind, sdg:contractStartDate some xsd:date, sdg:contractEndDate some xsd:date, sdg:partnerName some xsd:string, sdg:partnershipType some xsd:string, sdg:membershipLevel some xsd:string, sdg:startDate some xsd:dateTime, sdg:organizes some sdg:Event, sdg:coordinates max 1 sdg:PartnerOrganization, sdg:coordinatesProject exactly 1 sdg:PartnerOrganization, sdg:hostsEvent some sdg:Event, sdg:establishesLocalNetworkIn some sdg:Country, sdg:funds some sdg:ClinicalProgram, sdg:licenses some sdg:GenomicDataset, sdg:partnersWith some sdg:Organization, sdg:providesServiceTo some sdg:IndustrySector

