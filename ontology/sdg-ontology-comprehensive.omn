Class: sdg:Participant
    Annotations: rdfs:label "Participant", iao:0000115 "An individual (child or supervisor) registered for or attending a program session."
    SubClassOf: bfo:00000995, sdg:participantIdentifier some xsd:string, sdg:firstName some xsd:string, sdg:lastName some xsd:string, sdg:ageGroup some xsd:string, sdg:hasPhotoID some xsd:boolean, sdg:isSupervisor some xsd:boolean, sdg:registrationDate some xsd:dateTime, sdg:participantId some xsd:string, sdg:fullName some xsd:string, sdg:age some xsd:integer, sdg:isCPRCertified some xsd:boolean, sdg:drugScreenStatus some xsd:string, sdg:criminalCheckStatus some xsd:string, sdg:email some xsd:string, sdg:attendanceStatus some xsd:string, sdg:priorKnowledgeLevel some sdg:PriorKnowledgeLevelKind, sdg:isMinor some xsd:boolean, sdg:waiverSigned some xsd:boolean, sdg:assumptionOfRiskSigned some xsd:boolean, sdg:attends min 2 sdg:ProgramSession, sdg:isSupervisedBy max 1 sdg:Participant, sdg:registeredFor some sdg:AthleticEvent, sdg:subjectToDiscipline some sdg:DisciplineReport, sdg:attends some sdg:WorkshopSession, sdg:experiences some sdg:MotivationType, sdg:demonstrates some sdg:PracticeActivity, sdg:attendsEvent exactly 1 sdg:Event, sdg:coveredByPolicy some sdg:CoveragePolicy, sdg:experiences min 1 sdg:LearningEnvironment

Class: sdg:Equipment
    Annotations: rdfs:label "Equipment", iao:0000115 "Physical items used within a room, such as mats or changing tables."
    SubClassOf: bfo:00000995, sdg:equipmentIdentifier some xsd:string, sdg:equipmentName some xsd:string, sdg:equipmentType some xsd:string, sdg:isSkidFree some xsd:boolean, sdg:isChangingTable some xsd:boolean, sdg:equipmentId some xsd:string, sdg:condition some sdg:ConditionKind, sdg:quantity some xsd:integer, sdg:lastMaintenanceDate some xsd:date, sdg:name some sdg:NameKind, sdg:type some sdg:TypeKind, sdg:weightKg some xsd:decimal, sdg:designer some xsd:string, sdg:status some sdg:StatusKind, sdg:isLocatedIn exactly 1 sdg:Room, sdg:usedInEvent some sdg:AthleticEvent, sdg:storedAt exactly 1 sdg:Facility, sdg:usedIn some sdg:Expedition

Class: sdg:LegalCase
    Annotations: rdfs:label "Legal Case", iao:0000115 "A specific legal proceeding or dispute involving parties, charges, and outcomes."
    SubClassOf: bfo:0000040, sdg:caseIdentifier some xsd:string, sdg:courtName some xsd:string, sdg:caseType some sdg:CaseTypeKind, sdg:dateFiled some xsd:dateTime, sdg:status some sdg:StatusKind, sdg:jurisdiction some sdg:JurisdictionKind, sdg:yearFiled some xsd:integer, sdg:judgmentDate some xsd:date, sdg:citation some xsd:string, sdg:caseNumber some xsd:string, sdg:filingDate some xsd:date, sdg:hasDefendant some sdg:LegalPerson, sdg:hasProsecutor some sdg:LegalPerson, sdg:hasOutcome some sdg:LegalOutcome, sdg:isRelatedTo some sdg:LegalStatute, sdg:hasJudge min 1 sdg:LegalPerson, sdg:hasOutcome max 1 sdg:Judgment, sdg:namesDefendant some sdg:GovernmentAgency, sdg:usesProtocol some sdg:CaseReviewProtocol

Class: sdg:LegalPerson
    Annotations: rdfs:label "Legal Person", iao:0000115 "A natural or legal entity involved in legal proceedings, including barristers, judges, and parties."
    SubClassOf: bfo:0000002, sdg:fullName some xsd:string, sdg:roleDetail some sdg:RoleKind, sdg:qualification some xsd:string, sdg:barCircuit some xsd:string, sdg:specialization some sdg:SpecializationKind, sdg:personId some xsd:string, sdg:jurisdiction some sdg:JurisdictionKind, sdg:qualificationYear some xsd:integer, sdg:represents some sdg:LegalCase, sdg:isMemberOf some sdg:ProfessionalBody, sdg:judges some sdg:LegalCase
