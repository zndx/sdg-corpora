, sdg:parentGuardianContact some xsd:string, sdg:currentGradeLevel some xsd:string, sdg:schoolNumber some xsd:string, sdg:studyLevel some xsd:string, sdg:residenceStatus some xsd:string, sdg:admissionNotificationDate some xsd:date, sdg:disabilityType some xsd:string, sdg:iepStatus some sdg:IepStatusKind, sdg:primaryLanguage some sdg:PrimaryLanguageKind, sdg:major some xsd:string, sdg:startDate some xsd:dateTime, sdg:residencyPercentage some xsd:decimal, sdg:financialObligationsMet some xsd:boolean, sdg:ggpa some xsd:decimal, sdg:givenName some xsd:string, sdg:literacyProficiency some xsd:string, sdg:attendanceRate some xsd:decimal, sdg:specialNeedsFlag some xsd:boolean, sdg:residesWith exactly 1 sdg:Residence, sdg:attended some sdg:School, sdg:participatedIn some sdg:AthleticHistory, sdg:submitsResponse min 2 sdg:StudentResponse, sdg:enrolledIn min 2 sdg:CurriculumTopic, sdg:belongsFromClass exactly 1 sdg:StudentClass, sdg:placesOrder min 1 sdg:StudentOrder, sdg:hasEnrollment exactly 1 sdg:Enrollment, sdg:hasParent min 2 sdg:Parent, sdg:enrolledIn some sdg:Course, sdg:learnsConcept min 2 sdg:MathematicalConcept, sdg:subjectOf some sdg:StudentSearchEvent, sdg:attends some sdg:SchoolZone, sdg:hasAdvisor exactly 1 sdg:AcademicAdvisor, sdg:enrolledIn exactly 1 sdg:DegreeProgram, sdg:hasTransferCredits some sdg:TransferCreditRecord, sdg:hasPlacement some sdg:StudentPlacement, sdg:hasEHCP exactly 1 sdg:EducationHealthCarePlan, sdg:requiresRiskAssessment some sdg:HealthSafetyRiskAssessment, sdg:enrolledInProgramme exactly 1 sdg:AcademicProgramme, sdg:takesCourse min 2 sdg:Course, sdg:supervisedBy max 1 sdg:FacultyMember, sdg:enrolledIn exactly 1 sdg:AcademicProgram, sdg:submittedApplication some sdg:FinancialAidApplication, sdg:meetsSAP exactly 1 sdg:SatisfactoryAcademicProgress, sdg:hasAccessTo min 2 sdg:InstructionalResource, sdg:usesAuthenticationMethod min 2 sdg:AuthenticationMethod, sdg:hasDiagnosis some sdg:SpecialEducationalNeed, sdg:assignedToClass exactly 1 sdg:Cl