 exactly 1 sdg:CommunityOrganization, sdg:contains some sdg:WaterHarvestingSystem, sdg:locatedIn exactly 1 sdg:Municipality

Class: sdg:Room
    Annotations: rdfs:label "Room", iao:0000115 "A specific functional space within a facility, such as a gym, kitchen, or bathroom."
    SubClassOf: bfo:00000995, sdg:roomIdentifier some xsd:string, sdg:roomName some xsd:string, sdg:roomType some xsd:string, sdg:hasChangingTables some xsd:boolean, sdg:allowsFood some xsd:boolean, sdg:requiresShoeRemoval some xsd:boolean, sdg:isPartOf exactly 1 sdg:Facility, sdg:hasEquipment some sdg:Equipment

Class: sdg:PricingTier
    Annotations: rdfs:label "Pricing Tier", iao:0000115 "A defined cost structure for participating in a program, including single-session and multi-session options."
