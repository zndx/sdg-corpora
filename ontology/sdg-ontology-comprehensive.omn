Class: sdg:PlanningApplication
    Annotations: rdfs:label "Planning Application", iao:0000115 "A formal proposal submitted to a local authority for the development or change of use of land or buildings."
    SubClassOf: cco:ont00000958, sdg:applicationId some xsd:string, sdg:status some sdg:StatusKind, sdg:submissionDate some xsd:dateTime, sdg:proposalType some xsd:string, sdg:totalFloorArea some xsd:decimal, sdg:totalHeight some xsd:integer, sdg:targets exactly 1 sdg:LandParcel, sdg:submittedBy exactly 1 sdg:Developer, sdg:assessedBy exactly 1 sdg:LocalAuthority, sdg:hasObjection min 2 sdg:PublicObjection

Class: sdg:LandParcel
    Annotations: rdfs:label "Land Parcel", iao:0000115 "A specific, bounded area of land designated for a particular planning purpose or development."
    SubClassOf: bfo:0000040, sdg:parcelId some xsd:string, sdg:zoningDistrict some sdg:ZoningDistrictKind, sdg:areaHectares some xsd:decimal, sdg:currentLandUse some xsd:string, sdg:topography some xsd:string, sdg:acreage some xsd:decimal, sdg:location some xsd:string, sdg:developmentStatus some sdg:DevelopmentStatusKind, sdg:areaName some xsd:string, sdg:parcelIdentifier some xsd:string, sdg:countyName some xsd:string, sdg:stateName some xsd:string, sdg:totalAreaAcres some xsd:decimal, sdg:zoningClassification some xsd:string, sdg:surfaceOwnerName some xsd:string, sdg:locatedIn exactly 1 sdg:Municipality, sdg:subjectTo max 1 sdg:PlanningApplication, sdg:isSoldIn min 2 sdg:AssetDivestment, sdg:contains min 2 sdg:ExtractionWell, sdg:subjectTo min 2 sdg:LeaseAgreement, sdg:locatedIn exactly 1 sdg:JurisdictionalStatute

Class: sdg:HousingUnit
    Annotations: rdfs:label "Housing Unit", iao:0000115 "A residential dwelling unit, either a standalone house or a flat within a multi-story building."
    SubClassOf: sdg:unitId some xsd:string, sdg:unitType some sdg:UnitTypeKind, sdg:bedrooms some xsd:integer, sdg:hasGarden some xsd:boolean, sdg:floorLevel some xsd:integer, sdg:buildingHeight some xsd:integer, sdg:address some xsd:string, sdg:monthlyRent some xsd:decimal, sdg:occupancyStatus some sdg:OccupancyStatusKind, sdg:partOf__escalated exactly 1 sdg:DevelopmentProject, sdg:requires min 2 sdg:ParkingSpace, sdg:occupiedBy some sdg:HouseholdMember

Class: sdg:DevelopmentProject
    Annotations: rdfs:label "Development Project", iao:0000115 "The planned construction and assembly of housing units and associated infrastructure on a specific site."
    SubClassOf: bfo:0000015, sdg:projectId some xsd:string, sdg:projectName some xsd:string, sdg:totalUnits some xsd:integer, sdg:totalFloors some xsd:integer, sdg:estimatedCost some xsd:decimal, sdg:startDate some xsd:dateTime, sdg:projectType some sdg:ProjectTypeKind, sdg:locationCountry some xsd:string, sdg:fundingInstitution some xsd:string, sdg:endDate some xsd:dateTime, sdg:totalBudget some xsd:decimal, sdg:locatedOn exactly 1 sdg:LandParcel, sdg:includes min 3 sdg:HousingUnit, sdg:requires min 2 sdg:Infrastructure, sdg:fundedBy exactly 1 sdg:InternationalFinancialInstitution, sdg:impactsCommunity min 2 sdg:AffectedCommunity, sdg:subjectToReview some sdg:AccountabilityMechanism

Class: sdg:Infrastructure
    Annotations: rdfs:label "Infrastructure", iao:0000115 "Physical systems and facilities required to support the population and operations of a development area."
    SubClassOf: bfo:0000040, sdg:infraId some xsd:string, sdg:infraType some sdg:InfraTypeKind, sdg:capacity some xsd:integer, sdg:currentUtilization some xsd:decimal, sdg:condition some sdg:ConditionKind, sdg:serves exactly 1 sdg:Municipality, sdg:supports min 2 sdg:DevelopmentProject, sdg:locatedIn max 1 sdg:LandParcel

Class: sdg:PublicObjection
    Annotations: rdfs:label "Public Objection", iao:0000115 "A formal or informal expression of opposition to a proposed development plan by residents or stakeholders."
    SubClassOf: cco:ont00000958, sdg:objectionId some xsd:string, sdg:submissionDate some xsd:dateTime, sdg:objectionReason some sdg:ObjectionReasonKind, sdg:severity some sdg:SeverityKind, sdg:isFormal some xsd:boolean, sdg:targets exactly 1 sdg:PlanningApplication, sdg:raisedBy exactly 1 sdg:Resident, sdg:citesConcern min 2 sdg:Infrastructure

Class: sdg:Municipality
    Annotations: rdfs:label "Municipality", iao:0000115 "A defined geographic area governed by a local authority, containing residential, commercial, and green zones."
    SubClassOf: sdg:GeographicEntity, sdg:municipalityId some xsd:string, sdg:name some sdg:NameKind, sdg:population some xsd:integer, sdg:density some xsd:decimal, sdg:gardenCityStatus some xsd:boolean, sdg:administrativeLevel some xsd:string, sdg:municipalityID some xsd:string, sdg:municipalityName some xsd:string, sdg:state some xsd:string, sdg:areaSqKm some xsd:decimal, sdg:incorporationDate some xsd:date, sdg:municipalityCode some xsd:string, sdg:stateProvince some xsd:string, sdg:country some sdg:CountryKind, sdg:contains min 3 sdg:LandParcel, sdg:governedBy exactly 1 sdg:LocalAuthority, sdg:hosts min 2 sdg:Infrastructure, sdg:hosts min 2 sdg:FirstResponderOrganization, sdg:participatesIn__escalated some sdg:QualityImprovementProgram, sdg:contains some sdg:Facility
    HasKey: sdg:municipalityId

Class: sdg:LocalAuthority
    Annotations: rdfs:label "Local Authority", iao:0000115 "A governmental body responsible for planning, zoning, and regulating development within a municipality."
    SubClassOf: sdg:Authority, sdg:authorityId some xsd:string, sdg:authorityName some xsd:string, sdg:jurisdiction some sdg:JurisdictionKind, sdg:decision some xsd:string, sdg:regulates min 2 sdg:PlanningApplication, sdg:governs exactly 1 sdg:Municipality

Class: sdg:DrugApplication
    Annotations: rdfs:label "Drug Application", iao:0000115 "A regulatory submission document filed with a health authority to obtain marketing authorization for a pharmaceutical product."
    SubClassOf: sdg:Document, sdg:applicationId some xsd:string, sdg:applicationType some sdg:ApplicationTypeKind, sdg:drugSubstance some xsd:string, sdg:approvalStatus some sdg:ApprovalStatusKind, sdg:filingDate some xsd:date, sdg:approvalDate some xsd:dateTime, sdg:therapeuticIndication some xsd:string, sdg:dosageForm some xsd:string, sdg:strength some xsd:string, sdg:regulatoryAuthority some xsd:string, sdg:transferredTo exactly 1 sdg:PharmaceuticalCompany, sdg:transferredFrom exactly 1 sdg:PharmaceuticalCompany, sdg:coversDrugSubstance exactly 1 sdg:ActivePharmaceuticalIngredient, sdg:approvedForMarket some sdg:GeographicRegion, sdg:hasTransactionRecord some sdg:AssetTransfer

Class: sdg:PharmaceuticalCompany
    Annotations: rdfs:label "Pharmaceutical Company", iao:0000115 "A legal entity engaged in the research, development, manufacturing, or marketing of pharmaceutical products."
    SubClassOf: bfo:0000040, sdg:companyId some xsd:string, sdg:companyName some xsd:string, sdg:stockTicker some xsd:string, sdg:stockExchange some xsd:string, sdg:isIncorporated some xsd:boolean, sdg:headquartersLocation some xsd:string, sdg:primaryTherapeuticArea some xsd:string, sdg:manufacturingCapacity some xsd:integer, sdg:apiSupplier some xsd:boolean, sdg:finishedDosageManufacturer some xsd:boolean, sdg:ownsApplication some sdg:DrugApplication, sdg:transfersApplication some sdg:DrugApplication, sdg:receivesApplication some sdg:DrugApplication, sdg:suppliesApi some sdg:ActivePharmaceuticalIngredient, sdg:operatesInRegion some sdg:GeographicRegion, sdg:hasSubsidiary some sdg:PharmaceuticalCompany, sdg:hasRnDLocation some sdg:GeographicRegion

Class: sdg:ActivePharmaceuticalIngredient
    Annotations: rdfs:label "Active Pharmaceutical Ingredient", iao:0000115 "A substance intended to furnish pharmacological activity or other direct effect in the diagnosis, cure, mitigation, treatment, or prevention of disease."
    SubClassOf: cco:ont00000995, sdg:apiId some xsd:string, sdg:apiName some xsd:string, sdg:chemicalClass some xsd:string, sdg:therapeuticClass some xsd:string, sdg:molecularWeight some xsd:decimal, sdg:solubility some xsd:string, sdg:storageCondition some xsd:string, sdg:shelfLifeMonths some xsd:integer, sdg:regulatoryStatus some sdg:RegulatoryStatusKind, sdg:firstLineTherapy some xsd:boolean, sdg:includedInApplication some sdg:DrugApplication, sdg:manufacturedBy some sdg:PharmaceuticalCompany, sdg:suppliedTo some sdg:PharmaceuticalCompany, sdg:treatsCondition some sdg:Disease

Class: sdg:AssetTransfer
    Annotations: rdfs:label "Asset Transfer", iao:0000115 "A transactional process involving the conveyance of intellectual property rights, regulatory approvals, or commercial assets between entities."
    SubClassOf: bfo:0000015, sdg:transferId some xsd:string, sdg:transferDate some xsd:dateTime, sdg:transferValue some xsd:decimal, sdg:paymentStructure some xsd:string, sdg:status some sdg:StatusKind, sdg:currency some xsd:string, sdg:effectiveDate some xsd:date, sdg:expirationDate some xsd:date, sdg:governingLaw some xsd:string, sdg:confidentialityLevel some xsd:string, sdg:involvesAsset exactly 1 sdg:DrugApplication, sdg:initiatedBy exactly 1 sdg:PharmaceuticalCompany, sdg:receivedBy exactly 1 sdg:PharmaceuticalCompany, sdg:coversRegion some sdg:GeographicRegion, sdg:includesPayment some sdg:Payment, sdg:relatedToTransaction some sdg:AssetTransfer
    HasKey: sdg:transferId

Class: sdg:Payment
    Annotations: rdfs:label "Payment", iao:0000115 "A financial transaction representing consideration exchanged as part of a commercial or regulatory agreement."
    SubClassOf: bfo:0000015, sdg:paymentId some xsd:string, sdg:paymentAmount some xsd:decimal, sdg:paymentDate some xsd:dateTime, sdg:paymentType some xsd:string, sdg:currency some xsd:string, sdg:status some sdg:StatusKind, sdg:triggerCondition some xsd:string, sdg:recipient some xsd:string, sdg:payer some xsd:string, sdg:taxWithheld some xsd:boolean, sdg:paymentIdentifier some xsd:string, sdg:amount some xsd:decimal, sdg:disbursementDate some xsd:dateTime, sdg:isWithheld some xsd:boolean, sdg:withholdingAmount some xsd:decimal, sdg:partOfTransfer exactly 1 sdg:AssetTransfer, sdg:paidTo exactly 1 sdg:PharmaceuticalCompany, sdg:paidBy exactly 1 sdg:PharmaceuticalCompany, sdg:calculatedForRegion some sdg:GeographicRegion, sdg:madeBy exactly 1 sdg:GovernmentalEntity, sdg:madeTo exactly 1 sdg:Contractor, sdg:derivedFrom exactly 1 sdg:Contract
    HasKey: sdg:paymentId

Class: sdg:Disease
    Annotations: rdfs:label "Disease", iao:0000115 "A pathological condition of a part, organ, or system of an organism characterized by a distinctive set of symptoms and signs."
    SubClassOf: bfo:0000002, sdg:diseaseId some xsd:string, sdg:diseaseName some xsd:string, sdg:icdCode some xsd:string, sdg:prevalence some xsd:decimal, sdg:incidence some xsd:decimal, sdg:mortalityRate some xsd:decimal, sdg:chronicStatus some xsd:boolean, sdg:transmissionRoute some xsd:string, sdg:primaryTreatment some xsd:string, sdg:globalBurden some xsd:string, sdg:treatedByDrug some sdg:ActivePharmaceuticalIngredient, sdg:affectsRegion some sdg:GeographicRegion, sdg:hasCarrierCount some sdg:GeographicRegion, sdg:monitoredBy some sdg:HealthAuthority

Class: sdg:LibraryStaffMember
    Annotations: rdfs:label "Library Staff Member", iao:0000115 "A person employed by Oesterle Library in a professional or support capacity."
    SubClassOf: bfo:0000040, sdg:staffId some xsd:string, sdg:fullName some xsd:string, sdg:startDate some xsd:dateTime, sdg:endDate some xsd:dateTime, sdg:currentRole some xsd:string, sdg:employmentStatus some sdg:EmploymentStatusKind, sdg:employedAt exactly 1 sdg:Library, sdg:holdsRole some sdg:LibraryRole, sdg:supervised some sdg:LibraryStaffMember

Class: sdg:LibraryRole
    Annotations: rdfs:label "Library Role", iao:0000115 "A functional position or job title held by a staff member within the library."
    SubClassOf: bfo:0000023, sdg:roleCode some xsd:string, sdg:roleTitle some sdg:RoleTitleKind, sdg:department some xsd:string, sdg:responsibilityLevel some xsd:string, sdg:heldBy some sdg:LibraryStaffMember, sdg:partOfDepartment exactly 1 sdg:LibraryDepartment

Class: sdg:LibraryDepartment
    Annotations: rdfs:label "Library Department", iao:0000115 "A functional subdivision within the library organization."
    SubClassOf: bfo:0000040, sdg:deptCode some xsd:string, sdg:deptName some xsd:string, sdg:location some xsd:string, sdg:containsRole some sdg:LibraryRole, sdg:locatedIn exactly 1 sdg:Library

Class: sdg:Library
    Annotations: rdfs:label "Library", iao:0000115 "The physical and organizational entity of Oesterle Library."
    SubClassOf: bfo:0000040, sdg:libraryId some xsd:string, sdg:libraryName some xsd:string, sdg:institution some xsd:string, sdg:establishedDate some xsd:date, sdg:employs some sdg:LibraryStaffMember, sdg:containsDepartment__escalated some sdg:LibraryDepartment, sdg:hostsEvent some sdg:LibraryEvent

Class: sdg:LibraryEvent
    Annotations: rdfs:label "Library Event", iao:0000115 "A scheduled activity or presentation hosted by the library."
    SubClassOf: sdg:Event, sdg:eventId some xsd:string, sdg:eventName some xsd:string, sdg:eventDate some xsd:dateTime, sdg:eventTime some xsd:string, sdg:location some xsd:string, sdg:seriesName some xsd:string, sdg:hostedBy exactly 1 sdg:Library, sdg:featuresSpeaker some sdg:ExternalSpeaker, sdg:partOfSeries exactly 1 sdg:EventSeries, sdg:organizerRole some sdg:Thing

Class: sdg:ExternalSpeaker
    Annotations: rdfs:label "External Speaker", iao:0000115 "A person invited to present at a library event who is not a staff member."
    SubClassOf: sdg:speakerId some xsd:string, sdg:fullName some xsd:string, sdg:affiliation some sdg:AffiliationKind, sdg:expertise some xsd:string, sdg:presentedAt some sdg:LibraryEvent, sdg:affiliatedWith exactly 1 sdg:Institution

Class: sdg:EventSeries
    Annotations: rdfs:label "Event Series", iao:0000115 "A recurring collection of library events under a common theme."
    SubClassOf: bfo:0000015, sdg:seriesId some xsd:string, sdg:seriesName some xsd:string, sdg:frequency some sdg:FrequencyKind, sdg:includesEvent some sdg:LibraryEvent, sdg:organizedBy exactly 1 sdg:Library

Class: sdg:StudentAssistant
    Annotations: rdfs:label "Student Assistant", iao:0000115 "A student employed by the library in a support role."
