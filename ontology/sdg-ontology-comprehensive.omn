Class: sdg:PreventionInitiative
    Annotations: rdfs:label "Prevention Initiative", iao:0000115 "A specific campaign or program component designed to promote awareness and teach actionable steps for suicide prevention and mental health advocacy."
    SubClassOf: sdg:SecurityAndSafetyMeasure, sdg:initiativeIdentifier some xsd:string, sdg:initiativeName some xsd:string, sdg:launchDate some xsd:date, sdg:targetBehavior some xsd:string, sdg:isBestPractice some xsd:boolean, sdg:qualifiesForTraining some xsd:boolean, sdg:advocacyFocus some xsd:string, sdg:supportsProgram some sdg:MentalHealthEducationProgram, sdg:targetsIssue exactly 1 sdg:MentalHealthIssue

Class: sdg:ProgramSession
    Annotations: rdfs:label "Program Session", iao:0000115 "A scheduled time block during which a specific ACT program (e.g., PlayStation) is offered to participants."
    SubClassOf: bfo:0000015, sdg:sessionIdentifier some xsd:string, sdg:programName some xsd:string, sdg:dayOfWeek some xsd:string, sdg:startTime some xsd:dateTime, sdg:endTime some xsd:dateTime, sdg:seasonEndDate some xsd:date, sdg:isClosed some xsd:boolean, sdg:hasLocation exactly 1 sdg:Facility, sdg:hasPricingTier exactly 1 sdg:PricingTier

