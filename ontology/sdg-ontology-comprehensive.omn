    HasKey: sdg:toolId

Class: sdg:RetirementPlanMember
    Annotations: rdfs:label "Retirement Plan Member", iao:0000115 "A person who is enrolled in the Timber Operators Council Retirement Plan and Trust and is eligible for retirement benefits."
    SubClassOf: cco:ont00000995, sdg:memberId some xsd:string, sdg:fullName some xsd:string, sdg:ssn some xsd:string, sdg:dateOfBirth some xsd:date, sdg:gender some sdg:GenderKind, sdg:address some xsd:string, sdg:telephone some xsd:string, sdg:emailAddress some xsd:string, sdg:hasApplication min 1 sdg:RetirementBenefitApplication, sdg:hasBeneficiary min 2 sdg:Beneficiary, sdg:hasSpouse max 1 sdg:RetirementPlanMember, sdg:isEmployedBy exactly 1 sdg:ParticipatingEmployer
    HasKey: sdg:memberId

Class: sdg:RetirementBenefitApplication
    Annotations: rdfs:label "Retirement Benefit Application", iao:0000115 "A formal request submitted by a plan member to commence the payment of retirement benefits under a specific benefit option."
    SubClassOf: cco:ont00000958, sdg:applicationId some xsd:string, sdg:applicationDate some xsd:dateTime, sdg:benefitType some sdg:BenefitTypeKind, sdg:benefitOption some xsd:string, sdg:benefitStartDate some xsd:date, sdg:maritalStatus some xsd:string, sdg:spouseConsentStatus some xsd:string, sdg:applicationStatus some sdg:ApplicationStatusKind, sdg:submittedBy exactly 1 sdg:RetirementPlanMember, sdg:referencesBenefitOption exactly 1 sdg:BenefitOption, sdg:hasSpousalConsent max 1 sdg:SpousalConsent

Class: sdg:BenefitOption
    Annotations: rdfs:label "Benefit Option", iao:0000115 "A defined structure for the payment of retirement benefits, specifying duration, survivorship, and guarantee periods."
    SubClassOf: cco:ont00000995, sdg:optionId some xsd:string, sdg:optionName some xsd:string, sdg:paymentDuration some xsd:string, sdg:hasGuaranteePeriod some xsd:boolean, sdg:guaranteeMonths some xsd:integer, sdg:survivorBenefitPercentage some xsd:decimal, sdg:isElectedBy min 1 sdg:RetirementBenefitApplication

Class: sdg:SpousalConsent
    Annotations: rdfs:label "Spousal Consent", iao:0000115 "A legally binding declaration by a spouse consenting to the member's chosen benefit option and beneficiary designation."
    SubClassOf: cco:ont00000958, sdg:consentId some xsd:string, sdg:consentDate some xsd:dateTime, sdg:spouseSsn some xsd:string, sdg:notaryName some xsd:string, sdg:notaryCommissionExpiry some xsd:date, sdg:witnessedByPlanRep some xsd:boolean, sdg:pertainsToApplication exactly 1 sdg:RetirementBenefitApplication, sdg:givenBy exactly 1 sdg:RetirementPlanMember

Class: sdg:ParticipatingEmployer
    Annotations: rdfs:label "Participating Employer", iao:0000115 "An organization that participates in the Timber Operators Council Retirement Plan and Trust, employing members eligible for benefits."
    SubClassOf: cco:ont00000995, sdg:employerId some xsd:string, sdg:employerName some xsd:string, sdg:ein some xsd:string, sdg:planStartDate some xsd:dateTime, sdg:employsMember min 2 sdg:RetirementPlanMember
    HasKey: sdg:employerId

Class: sdg:Enrollment
    Annotations: rdfs:label "Enrollment", iao:0000115 "A contractual record of a student's participation in the April Rain Chinese Dance & Education program, capturing fee obligations and parental consent."
    SubClassOf: cco:ont00000995, sdg:enrollmentId some xsd:string, sdg:registrationFee some xsd:decimal, sdg:monthlyTuition some xsd:decimal, sdg:lateFee some xsd:decimal, sdg:enrollmentDate some xsd:date, sdg:programPeriodStart some xsd:date, sdg:programPeriodEnd some xsd:date, sdg:isRefundable some xsd:boolean, sdg:lateFeeAmount some xsd:decimal, sdg:paymentDueDay some xsd:integer, sdg:lateFeeDeadlineDay some xsd:integer, sdg:programMonths some xsd:string, sdg:consentGiven some xsd:boolean, sdg:waiverSigned some xsd:boolean, sdg:covers exactly 1 sdg:Student, sdg:authorizedBy min 2 sdg:Parent, sdg:documentsConsentFor exactly 1 sdg:MediaRelease, sdg:enrollsStudent exactly 1 sdg:Student, sdg:hasParent min 2 sdg:Parent, sdg:hasAcquisitionSource max 1 sdg:AcquisitionSource

Class: sdg:Parent
    Annotations: rdfs:label "Parent", iao:0000115 "A guardian or legal parent of a student who provides consent and contact information for the program."
    SubClassOf: bfo:0000040, sdg:parentId some xsd:string, sdg:firstName some xsd:string, sdg:chineseName some xsd:string, sdg:homePhone some xsd:string, sdg:cellPhone some xsd:string, sdg:email some xsd:string, sdg:homeAddress some xsd:string, sdg:city some xsd:string, sdg:zipCode some xsd:string, sdg:fullLegalName some xsd:string, sdg:relationshipToChild some xsd:string, sdg:homeTelephone some xsd:string, sdg:mobileTelephone some xsd:string, sdg:workTelephone some xsd:string, sdg:emailAddress some xsd:string, sdg:residentialAddress some xsd:string, sdg:residentialPostalCode some xsd:string, sdg:fullName some xsd:string, sdg:contactNumber some xsd:string, sdg:relationshipToStudent some sdg:RelationshipToStudentKind, sdg:givenName some xsd:string, sdg:authorizes min 2 sdg:Enrollment, sdg:hasChild some sdg:Student, sdg:hasChild some sdg:Child, sdg:hasEnrolment some sdg:Enrolment, sdg:notifiedOfIncident some sdg:BullyingIncident, sdg:participatesInConciliation__escalated some sdg:BullyingIncident, sdg:hasEmergencyContact max 1 sdg:EmergencyContact

Class: sdg:MediaRelease
    Annotations: rdfs:label "MediaRelease", iao:0000115 "A legal authorization document granting the organization permission to record and use media of participants for promotional purposes."
    SubClassOf: cco:ont00000958, sdg:releaseId some xsd:string, sdg:allowsVideoRecording some xsd:boolean, sdg:allowsAudioRecording some xsd:boolean, sdg:allowsPhotography some xsd:boolean, sdg:allowsPromotionalUse some xsd:boolean, sdg:waivesRightToSue some xsd:boolean, sdg:holdHarmlessAgreement some xsd:boolean, sdg:signedDate some xsd:dateTime, sdg:linkedTo exactly 1 sdg:Enrollment, sdg:signedBy min 2 sdg:Parent
    HasKey: sdg:releaseId

Class: sdg:ReferralSource
    Annotations: rdfs:label "ReferralSource", iao:0000115 "The channel or method through which a prospective student or parent learned about the dance program."
    SubClassOf: bfo:0000040, sdg:sourceId some xsd:string, sdg:sourceName some xsd:string, sdg:otherDetails some xsd:string, sdg:attributedTo some sdg:Enrollment

Class: sdg:QualityImprovementProgram
    Annotations: rdfs:label "Quality Improvement Program", iao:0000115 "A structured organizational activity designed to evaluate and enhance clinical performance and patient outcomes using systematic improvement models."
    SubClassOf: bfo:0000015, sdg:programIdentifier some xsd:string, sdg:programName some xsd:string, sdg:startDate some xsd:dateTime, sdg:status some sdg:StatusKind, sdg:methodology some xsd:string, sdg:targetPopulationDetail some sdg:TargetPopulationKind, sdg:operatedBy exactly 1 sdg:FirstResponderOrganization, sdg:evaluates some sdg:ClinicalPerformanceData, sdg:improves some sdg:PatientOutcome, sdg:implementedBy exactly 1 sdg:Organization, sdg:governedBy max 1 sdg:PolicyInstrument

Class: sdg:FirstResponderOrganization
    Annotations: rdfs:label "First Responder Organization", iao:0000115 "A municipal or organizational entity providing emergency medical services and first-response capabilities within a defined jurisdiction."
    SubClassOf: bfo:0000015, sdg:organizationID some xsd:string, sdg:organizationName some xsd:string, sdg:jurisdiction some sdg:JurisdictionKind, sdg:establishedDate some xsd:date, sdg:serviceType some sdg:ServiceTypeKind, sdg:participationStatus some sdg:ParticipationStatusKind, sdg:participatesIn__escalated some sdg:QualityImprovementProgram, sdg:serves exactly 1 sdg:Municipality

Class: sdg:ClinicalPerformanceData
    Annotations: rdfs:label "Clinical Performance Data", iao:0000115 "Quantitative records and metrics capturing individual and system-level clinical performance indicators used for evaluation and improvement."
    SubClassOf: sdg:HealthcareEntity, sdg:dataRecordID some xsd:string, sdg:collectionDate some xsd:dateTime, sdg:metricType some sdg:MetricTypeKind, sdg:value some xsd:decimal, sdg:unitOfMeasure some sdg:UnitOfMeasureKind, sdg:dataQuality some xsd:string, sdg:dataRecordId some xsd:string, sdg:dataQualityScore some xsd:decimal, sdg:collectedBy exactly 1 sdg:FirstResponderOrganization, sdg:analyzedBy some sdg:QuantitativeAnalyticTool, sdg:usedIn some sdg:QualityImprovementProgram, sdg:collectedBy exactly 1 sdg:MeasurementActivity, sdg:analyzedBy some sdg:AnalyticTool

Class: sdg:QuantitativeAnalyticTool
    Annotations: rdfs:label "Quantitative Analytic Tool", iao:0000115 "A software or methodological instrument used to process, evaluate, and derive insights from clinical performance and patient outcome data."
    SubClassOf: cco:ont00000995, sdg:toolID some xsd:string, sdg:toolName some xsd:string, sdg:toolType some sdg:ToolTypeKind, sdg:version some xsd:string, sdg:lastUpdated some xsd:dateTime, sdg:validationStatus some sdg:ValidationStatusKind, sdg:processes min 3 sdg:ClinicalPerformanceData, sdg:generates some sdg:PatientOutcome, sdg:supports exactly 1 sdg:QualityImprovementProgram

Class: sdg:PatientOutcome
    Annotations: rdfs:label "Patient Outcome", iao:0000115 "A measurable result or effect on a patient's health status resulting from clinical interventions or system-level care improvements."
    SubClassOf: bfo:0000015, sdg:outcomeID some xsd:string, sdg:measurementDate some xsd:dateTime, sdg:outcomeType some sdg:OutcomeTypeKind, sdg:value some xsd:decimal, sdg:unitOfMeasure some sdg:UnitOfMeasureKind, sdg:improvementDirection some sdg:ImprovementDirectionKind, sdg:influencedBy some sdg:QualityImprovementProgram, sdg:measuredBy some sdg:QuantitativeAnalyticTool, sdg:associatedWith exactly 1 sdg:FirstResponderOrganization

Class: sdg:SelectboardMember
    Annotations: rdfs:label "Selectboard Member", iao:0000115 "A person holding an elected or appointed role on the municipal Selectboard, exercising governance authority."
    SubClassOf: bfo:0000040, sdg:memberId some xsd:string, sdg:fullName some xsd:string, sdg:roleTitle some sdg:RoleTitleKind, sdg:appointmentDate some xsd:date, sdg:termEndDate some xsd:date, sdg:isExOfficio some xsd:boolean, sdg:holdsRoleIn exactly 1 sdg:MunicipalBoard, sdg:represents some sdg:Committee, sdg:votesOn some sdg:Motion

Class: sdg:MunicipalBoard
    Annotations: rdfs:label "Municipal Board", iao:0000115 "A formal governing body of a municipality, such as a Selectboard, responsible for administrative and policy decisions."
    SubClassOf: bfo:0000002, sdg:boardId some xsd:string, sdg:boardName some xsd:string, sdg:jurisdictionName some xsd:string, sdg:meetingSchedule some xsd:string, sdg:officialNewspaper some xsd:string, sdg:hasMember min 2 sdg:SelectboardMember, sdg:adoptsPolicy some sdg:Policy, sdg:managesFund some sdg:MunicipalFund

Class: sdg:Motion
    Annotations: rdfs:label "Motion", iao:0000115 "A formal proposal made by a member of a governing body for the body to take a specific action or adopt a policy."
    SubClassOf: bfo:0000015, sdg:motionId some xsd:string, sdg:motionText some xsd:string, sdg:voteResult some xsd:string, sdg:meetingDate some xsd:dateTime, sdg:isAdopted some xsd:boolean, sdg:proposedBy exactly 1 sdg:SelectboardMember, sdg:secondedBy exactly 1 sdg:SelectboardMember, sdg:addresses some sdg:Policy, sdg:addresses some sdg:License
    HasKey: sdg:motionId

Class: sdg:License
    Annotations: rdfs:label "License", iao:0000115 "An official permit issued by a municipality authorizing a business to operate or sell specific regulated goods."
    SubClassOf: bfo:0000016, sdg:licenseId some xsd:string, sdg:businessName some xsd:string, sdg:licenseClass some xsd:string, sdg:issueDate some xsd:date, sdg:expiryDate some xsd:date, sdg:status some sdg:StatusKind, sdg:issuedBy exactly 1 sdg:MunicipalBoard, sdg:approvedVia exactly 1 sdg:Motion, sdg:heldBy exactly 1 sdg:BusinessEntity

Class: sdg:BusinessEntity
    Annotations: rdfs:label "Business Entity", iao:0000115 "A commercial organization or proprietorship operating within the municipality's jurisdiction."
    SubClassOf: bfo:0000002, sdg:businessId some xsd:string, sdg:legalName some xsd:string, sdg:dbaName some xsd:string, sdg:businessType some xsd:string, sdg:industrySector some sdg:IndustrySectorKind, sdg:registrationNumber some xsd:string, sdg:legalForm some xsd:string, sdg:registrationDate some xsd:dateTime, sdg:jurisdiction some sdg:JurisdictionKind, sdg:status some sdg:StatusKind, sdg:taxIdentificationNumber some xsd:string, sdg:holdsLicense some sdg:License, sdg:locatedIn some sdg:Parcel, sdg:receivesFundingFrom some sdg:MunicipalFund, sdg:registeredIn exactly 1 sdg:Jurisdiction, sdg:operatesInMarketStructure some sdg:MarketStructure, sdg:employs some sdg:Employee, sdg:generates some sdg:FinancialStatement

Class: sdg:MunicipalFund
    Annotations: rdfs:label "Municipal Fund", iao:0000115 "A designated pool of municipal financial resources, such as tax revenue or grants, allocated for specific public purposes."
    SubClassOf: bfo:0000016, sdg:fundId some xsd:string, sdg:fundName some xsd:string, sdg:fiscalYear some xsd:integer, sdg:totalAllocation some xsd:decimal, sdg:currentBalance some xsd:decimal, sdg:spendingThreshold some xsd:decimal, sdg:managedBy exactly 1 sdg:MunicipalBoard, sdg:funds some sdg:Project, sdg:supports some sdg:BusinessEntity

Class: sdg:Project
    Annotations: rdfs:label "Project", iao:0000115 "A planned municipal initiative or infrastructure improvement funded by public resources."
    SubClassOf: bfo:0000015, sdg:projectId some xsd:string, sdg:projectName some xsd:string, sdg:estimatedCost some xsd:decimal, sdg:approvalLevel some xsd:string, sdg:status some sdg:StatusKind, sdg:startDate some xsd:dateTime, sdg:endDate some xsd:dateTime, sdg:projectTitle some xsd:string, sdg:projectType some sdg:ProjectTypeKind, sdg:description some xsd:string, sdg:fundingSource some sdg:FundingSourceKind, sdg:projectStatus some sdg:ProjectStatusKind, sdg:budgetAmount some xsd:decimal, sdg:primaryObjective some sdg:PrimaryObjectiveKind, sdg:fundedBy some sdg:MunicipalFund, sdg:locatedOn some sdg:Parcel, sdg:requiresApprovalFrom exactly 1 sdg:MunicipalBoard, sdg:supports exactly 1 sdg:StrategicObjective, sdg:executedBy some sdg:Person, sdg:produces min 2 sdg:DigitalAsset, sdg:uses min 2 sdg:SoftwareTool, sdg:references some sdg:ExternalResource, sdg:initiatedBy exactly 1 sdg:ALPARC, sdg:involvesPartner min 2 sdg:ProtectedArea, sdg:involvesPartner min 2 sdg:ManagementUnit, sdg:executedBy exactly 1 sdg:ProjectLeader
    HasKey: sdg:projectId

Class: sdg:Parcel
    Annotations: rdfs:label "Parcel", iao:0000115 "A defined piece of land within the municipality, used for zoning, ownership, or infrastructure purposes."
    SubClassOf: bfo:0000002, sdg:parcelId some xsd:string, sdg:address some xsd:string, sdg:zoningDistrict some sdg:ZoningDistrictKind, sdg:landUse some xsd:string, sdg:ownerName some xsd:string, sdg:isPubliclyAccessible some xsd:boolean, sdg:hostedBy some sdg:BusinessEntity, sdg:siteFor some sdg:Project, sdg:maintainedBy exactly 1 sdg:MunicipalBoard
    HasKey: sdg:parcelId

Class: sdg:DirectorAppointment
    Annotations: rdfs:label "Director Appointment", iao:0000115 "A formal organizational role assignment granting an individual authority and responsibilities within a corporate division."
    SubClassOf: bfo:0000015, sdg:appointmentId some xsd:string, sdg:appointmentDate some xsd:date, sdg:divisionName some xsd:string, sdg:status some sdg:StatusKind, sdg:terminationDate some xsd:date, sdg:assignedTo exactly 1 sdg:ProfessionalAdvisor, sdg:assignedToDivision exactly 1 sdg:CorporateDivision
    HasKey: sdg:appointmentId

Class: sdg:ProfessionalAdvisor
    Annotations: rdfs:label "Professional Advisor", iao:0000115 "A qualified individual holding a specific corporate role, possessing specialized education and access to firm-wide financial products."
    SubClassOf: sdg:Role, sdg:advisorId some xsd:string, sdg:firstName some xsd:string, sdg:lastName some xsd:string, sdg:corporateTitle some xsd:string, sdg:specialization some sdg:SpecializationKind, sdg:educationProgramCompleted some xsd:boolean, sdg:contactEmail some xsd:string, sdg:contactPhone some xsd:string, sdg:specializationDomain some xsd:string, sdg:holdsAppointment exactly 1 sdg:DirectorAppointment, sdg:affiliatedWith exactly 1 sdg:CorporateDivision

Class: sdg:CorporateDivision
    Annotations: rdfs:label "Corporate Division", iao:0000115 "A distinct organizational unit within a larger financial firm established to serve specific client demographics."
    SubClassOf: sdg:BusinessEntity, sdg:divisionId some xsd:string, sdg:divisionName some xsd:string, sdg:parentOrganization some xsd:string, sdg:foundingDate some xsd:date, sdg:targetClientele some xsd:string, sdg:employsDirectors min 2 sdg:ProfessionalAdvisor

Class: sdg:ClientProfile
    Annotations: rdfs:label "Client Profile", iao:0000115 "A structured record representing a high-net-worth individual or professional entity requiring specialized financial services."
    SubClassOf: sdg:clientId some xsd:string, sdg:clientType some xsd:string, sdg:assetProtectionStatus some xsd:string, sdg:careerPhase some sdg:CareerPhaseKind, sdg:financialFootingStatus some xsd:string, sdg:assignedAdvisor exactly 1 sdg:ProfessionalAdvisor, sdg:receivesServiceFrom min 2 sdg:FinancialProduct
    HasKey: sdg:clientId

Class: sdg:FinancialProduct
    Annotations: rdfs:label "Financial Product", iao:0000115 "A specific financial offering or service instrument designed to meet the unique wealth management needs of specialized client segments."
    SubClassOf: sdg:productId some xsd:string, sdg:productName some xsd:string, sdg:productCategory some xsd:string, sdg:availabilityScope some xsd:string, sdg:targetSegment some xsd:string, sdg:productType some xsd:string, sdg:productCode some xsd:string, sdg:issuePrice some xsd:decimal, sdg:minimumInvestment some xsd:decimal, sdg:riskRating some sdg:RiskRatingKind, sdg:managementFee some xsd:decimal, sdg:providedByAdvisor exactly 1 sdg:ProfessionalAdvisor, sdg:servesClient min 2 sdg:ClientProfile, sdg:issuedByScheme exactly 1 sdg:ManagedInvestmentScheme, sdg:subjectToAdvice min 2 sdg:AuthorisedRepresentative, sdg:documentedByPDS exactly 1 sdg:ProductDisclosureStatement, sdg:issuedBy exactly 1 sdg:ManagedInvestmentScheme, sdg:coveredByPDS exactly 1 sdg:ProductDisclosureStatement

Class: sdg:HotlineService
    Annotations: rdfs:label "Hotline Service", iao:0000115 "A telephonic or text-based process or activity providing immediate information, treatment referral, or crisis intervention for specific social or health issues."
    SubClassOf: bfo:0000015, sdg:hotlineIdentifier some xsd:string, sdg:phoneNumber some xsd:string, sdg:textKeyword some xsd:string, sdg:availabilitySchedule some xsd:string, sdg:isFree some xsd:boolean, sdg:isConfidential some xsd:boolean, sdg:managedBy exactly 1 sdg:ServiceOrganization, sdg:addressesIssue some sdg:SocialIssue, sdg:providesReferralTo some sdg:SocialServiceResource

Class: sdg:SocialIssue
    Annotations: rdfs:label "Social Issue", iao:0000115 "A specific problem, crisis, or condition affecting individuals or families that requires intervention, treatment, or assistance."
    SubClassOf: bfo:0000015, sdg:issueCategory some xsd:string, sdg:severityLevel some sdg:SeverityLevelKind, sdg:requiresLawEnforcement some xsd:boolean, sdg:reportedVia some sdg:HotlineService, sdg:addressedByResource some sdg:SocialServiceResource

Class: sdg:ServiceLocation
    Annotations: rdfs:label "Service Location", iao:0000115 "A physical or virtual geographic area, community, or jurisdiction where social services are delivered or accessible."
    SubClassOf: sdg:GeographicEntity, sdg:locationName some xsd:string, sdg:locationType some sdg:LocationTypeKind, sdg:geographicScope some xsd:string, sdg:supportedLanguages some sdg:SupportedLanguagesKind, sdg:serviceDeliveryModeDetail some xsd:string, sdg:hostsResource some sdg:SocialServiceResource, sdg:accessibleVia some sdg:HotlineService

Class: sdg:Course
    Annotations: rdfs:label "Course", iao:0000115 "A formally cataloged academic unit with a unique identifier, title, and credit value offered by an institution."
