Class: sdg:Residence
    Annotations: rdfs:label "Residence", iao:0000115 "A physical location where a student resides, used to determine school district boundaries and athletic eligibility."
    SubClassOf: sdg:GeographicEntity, sdg:address some xsd:string, sdg:dateMovedIn some xsd:date, sdg:durationMonths some xsd:integer, sdg:schoolDistrict some xsd:string, sdg:isPrimaryResidence some xsd:boolean, sdg:hasStudent some sdg:Student, sdg:hasGuardian some sdg:Guardian

Class: sdg:Guardian
    Annotations: rdfs:label "Guardian", iao:0000115 "A parent or other person with whom a student has resided for at least six months, responsible for the student's residency status."
    SubClassOf: bfo:0000004, sdg:fullName some xsd:string, sdg:relationship some sdg:RelationshipKind, sdg:telephone some xsd:string, sdg:isParent some xsd:boolean, sdg:guardianId some xsd:string, sdg:homePhone some xsd:string, sdg:mobilePhone some xsd:string, sdg:workPhone some xsd:string, sdg:email some xsd:string, sdg:guardianName some xsd:string, sdg:contactPhone some xsd:string, sdg:signatureDate some xsd:dateTime, sdg:residesAt exactly 1 sdg:Residence, sdg:hasStudent some sdg:Student, sdg:submitsApplicationFor some sdg:AdmissionApplication, sdg:residesAt exactly 1 sdg:Address, sdg:hasParentalResponsibilityFor exactly 1 sdg:Child, sdg:authoredAuthorization exactly 1 sdg:TransportAuthorization, sdg:hasGuardianshipOver exactly 1 sdg:MinorPassenger

Class: sdg:School
    Annotations: rdfs:label "School", iao:0000115 "An educational institution, either public or private, where a student attends classes and participates in interscholastic athletics."
    SubClassOf: bfo:0000004, sdg:schoolName some xsd:string, sdg:schoolType some sdg:SchoolTypeKind, sdg:district some xsd:string, sdg:hasOpenEnrollment some xsd:boolean, sdg:schoolId some xsd:string, sdg:address some xsd:string, sdg:boardId some xsd:string, sdg:riskLevel some sdg:RiskLevelKind, sdg:ipacCompliant some xsd:boolean, sdg:lastAssessmentDate some xsd:date, sdg:legalName some xsd:string, sdg:streetAddress some xsd:string, sdg:postalCode some xsd:string, sdg:telephone some xsd:string, sdg:email some xsd:string, sdg:website some xsd:string, sdg:schoolCode some xsd:string, sdg:allocatedPlaces some xsd:integer, sdg:officeLocation some xsd:string, sdg:websiteUrl some xsd:string, sdg:name some sdg:NameKind, sdg:countryCode some sdg:CountryCodeKind, sdg:latitude some xsd:decimal, sdg:longitude some xsd:decimal, sdg:enrollmentCount some xsd:integer, sdg:connectivityStatus some xsd:string, sdg:postCode some xsd:string, sdg:hasStudent some sdg:Student, sdg:hasAthleticHistory some sdg:AthleticHistory, sdg:assignedNurse exactly 1 sdg:PublicHealthNurse, sdg:partOf__escalated exactly 1 sdg:SchoolBoard, sdg:hasOutbreak some sdg:Outbreak, sdg:admits min 1 sdg:Enrolment, sdg:receivesApplications some sdg:DiscretionaryPlaceApplication, sdg:managesCommittee exactly 1 sdg:AdmissionCommittee, sdg:hasDevice some sdg:EducationalDevice, sdg:locatedIn exactly 1 sdg:Country, sdg:servedBy some sdg:ConnectivityProvider, sdg:enrollsChild some sdg:Child, sdg:isLocatedAt exactly 1 sdg:Address

Class: sdg:AthleticHistory
    Annotations: rdfs:label "Athletic History", iao:0000115 "A record of a student's participation in interscholastic sports, including season, year, sport, and level."
    SubClassOf: cco:ont00000995, sdg:season some sdg:SeasonKind, sdg:year some xsd:integer, sdg:sport some xsd:string, sdg:level some sdg:LevelKind, sdg:practicesCompleted some xsd:integer, sdg:isEligible some xsd:boolean, sdg:hasStudent exactly 1 sdg:Student, sdg:hasSchool exactly 1 sdg:School

Class: sdg:TransferWaiver
    Annotations: rdfs:label "Transfer Waiver", iao:0000115 "A formal exemption from the standard one-year ineligibility period for a student transferring schools without a change in residence."
    SubClassOf: cco:ont00000995, sdg:waiverType some xsd:string, sdg:approvalDate some xsd:dateTime, sdg:approvedByDetail some xsd:string, sdg:isOneTimeOnly some xsd:boolean, sdg:hasStudent exactly 1 sdg:Student, sdg:hasSchool exactly 1 sdg:School

Class: sdg:UPRReviewCycle
    Annotations: rdfs:label "Universal Periodic Review Cycle", iao:0000115 "A periodic assessment process conducted by the UN Human Rights Council to review the human rights records of member states."
    SubClassOf: bfo:0000015, sdg:cycleId some xsd:string, sdg:sessionDate some xsd:dateTime, sdg:reviewingState some xsd:string, sdg:reviewStatus some sdg:ReviewStatusKind, sdg:reviewOutcome some sdg:ReviewOutcomeKind, sdg:includesRecommendation min 2 sdg:UPRRecommendation, sdg:conductedForState exactly 1 sdg:State

Class: sdg:UPRRecommendation
    Annotations: rdfs:label "UPR Recommendation", iao:0000115 "A formal suggestion or directive issued during a UPR review to improve human rights practices in a specific area."
    SubClassOf: cco:ont00000995, sdg:recommendationId some xsd:string, sdg:recommendationText some xsd:string, sdg:topicArea some xsd:string, sdg:acceptanceStatus some xsd:string, sdg:priorityLevel some sdg:PriorityLevelKind, sdg:issuedDuringReview exactly 1 sdg:UPRReviewCycle, sdg:targetsState exactly 1 sdg:State, sdg:addressesVulnerableGroup some sdg:VulnerableGroup

Class: sdg:VulnerableGroup
    Annotations: rdfs:label "Vulnerable Group", iao:0000115 "A demographic population facing systemic discrimination or barriers to rights realization, such as indigenous children or girls."
    SubClassOf: bfo:0000004, sdg:groupIdentifier some xsd:string, sdg:groupName some xsd:string, sdg:riskCategory some sdg:RiskCategoryKind, sdg:geographicDistribution some xsd:string, sdg:populationSize some xsd:integer, sdg:affectedByRecommendation some sdg:UPRRecommendation, sdg:residesInState exactly 1 sdg:State, sdg:experiencesBarrier min 2 sdg:RightsBarrier

Class: sdg:RightsBarrier
    Annotations: rdfs:label "Rights Barrier", iao:0000115 "A systemic obstacle preventing a vulnerable group from accessing or exercising their fundamental rights, such as discrimination or funding disparities."
    SubClassOf: bfo:0000015, sdg:barrierId some xsd:string, sdg:barrierType some sdg:BarrierTypeKind, sdg:severityLevel some sdg:SeverityLevelKind, sdg:documentedEvidence some xsd:string, sdg:mitigationStatus some sdg:MitigationStatusKind, sdg:impactsGroup exactly 1 sdg:VulnerableGroup, sdg:addressedByRecommendation some sdg:UPRRecommendation, sdg:occursInState exactly 1 sdg:State

Class: sdg:NGOCoalition
    Annotations: rdfs:label "NGO Coalition", iao:0000115 "A formal alliance of non-governmental organizations submitting joint statements or recommendations during UPR processes."
    SubClassOf: cco:ont00000995, sdg:coalitionId some xsd:string, sdg:coalitionName some xsd:string, sdg:submissionDate some xsd:dateTime, sdg:submissionType some xsd:string, sdg:signatoryCount some xsd:integer, sdg:submitsToReview exactly 1 sdg:UPRReviewCycle, sdg:includesMemberOrg min 2 sdg:NGOMember, sdg:addressesTopic some sdg:UPRRecommendation
    HasKey: sdg:coalitionId

Class: sdg:NGOMember
    Annotations: rdfs:label "NGO Member", iao:0000115 "An individual non-governmental organization that is part of a coalition submitting UPR recommendations."
    SubClassOf: cco:ont00000995, sdg:orgId some xsd:string, sdg:orgName some xsd:string, sdg:orgType some sdg:OrgTypeKind, sdg:focusArea some sdg:FocusAreaKind, sdg:registrationCountry some xsd:string, sdg:memberOfCoalition exactly 1 sdg:NGOCoalition, sdg:submitsRecommendation some sdg:UPRRecommendation, sdg:operatesInState exactly 1 sdg:State
    HasKey: sdg:orgId

Class: sdg:DigitalTechnology
    Annotations: rdfs:label "Digital Technology Platform", iao:0000115 "A digital platform or application operated by Principal Financial Group that collects personal information from users."
    SubClassOf: bfo:0000040, sdg:platformIdentifier some xsd:string, sdg:platformName some xsd:string, sdg:platformType some sdg:PlatformTypeKind, sdg:effectiveDate some xsd:date, sdg:privacyPolicyURL some xsd:string, sdg:collects min 2 sdg:PersonalInformation

Class: sdg:PersonalInformation
    Annotations: rdfs:label "Personal Information Record", iao:0000115 "A record of data that can be used to identify an individual, collected through digital technologies."
    SubClassOf: sdg:DataEntity, sdg:informationType some xsd:string, sdg:dataField some sdg:DataFieldKind, sdg:collectionMethod some xsd:string, sdg:isSensitive some xsd:boolean, sdg:retentionPeriod some xsd:string, sdg:collectedBy exactly 1 sdg:DigitalTechnology, sdg:pertainsTo exactly 1 sdg:Individual

Class: sdg:Individual
    Annotations: rdfs:label "Individual", iao:0000115 "A human being to whom personal information pertains."
    SubClassOf: bfo:0000004, sdg:individualID some xsd:string, sdg:name some sdg:NameKind, sdg:dateOfBirth some xsd:date, sdg:nationality some xsd:string, sdg:gender some sdg:GenderKind, sdg:accountType some sdg:AccountTypeKind, sdg:individualId some xsd:string, sdg:sex some sdg:SexKind, sdg:enrollmentStatus some sdg:EnrollmentStatusKind, sdg:insuranceProvider some xsd:string, sdg:ethnicity some xsd:string, sdg:enrollmentDate some xsd:date, sdg:status some sdg:StatusKind, sdg:personIdentifier some xsd:string, sdg:fullName some xsd:string, sdg:birthCountry some xsd:string, sdg:currentResidence some xsd:string, sdg:formerAffiliation some xsd:string, sdg:currentStance some xsd:string, sdg:publicationsCount some xsd:integer, sdg:individualIdentifier some xsd:string, sdg:firstName some xsd:string, sdg:lastName some xsd:string, sdg:roleDetail some sdg:RoleKind, sdg:needsComplexCommunication some xsd:boolean, sdg:legalStatus some sdg:LegalStatusKind, sdg:primaryLanguage some sdg:PrimaryLanguageKind, sdg:communicationNeeds some xsd:string, sdg:participantId some xsd:string, sdg:age some xsd:integer, sdg:consentStatus some sdg:ConsentStatusKind, sdg:hasPersonalInformation min 2 sdg:PersonalInformation, sdg:consentsTo exactly 1 sdg:PrivacyPolicy, sdg:hasSample min 2 sdg:GenomicSample, sdg:hasHealthRecord some sdg:HealthRecord, sdg:enrolledIn some sdg:ClinicalProgram, sdg:linkedTo some sdg:HealthRecord, sdg:wasMemberOf some sdg:ReligiousOrganization, sdg:residesInRegion exactly 1 sdg:GeopoliticalRegion, sdg:authoredDocument some sdg:Publication, sdg:servedBy some sdg:Organization, sdg:uses some sdg:AssistiveTechnology, sdg:subjectOf min 2 sdg:CapacityAssessment, sdg:beneficiaryOf min 2 sdg:BestInterestDetermination, sdg:representedBy max 1 sdg:LegalRepresentative, sdg:participatesIn__escalated min 2 sdg:StudyDesign, sdg:providesMeasurement min 2 sdg:BiologicalMeasurement, sdg:belongsToList min 2 sdg:Population

Class: sdg:PrivacyPolicy
    Annotations: rdfs:label "Privacy Policy Document", iao:0000115 "A document outlining the data collection, use, and protection practices of Principal Financial Group."
    SubClassOf: sdg:GovernmentPolicy, sdg:policyID some xsd:string, sdg:policyTitle some xsd:string, sdg:effectiveDate some xsd:date, sdg:issuingEntity some xsd:string, sdg:jurisdiction some sdg:JurisdictionKind, sdg:governs min 2 sdg:DigitalTechnology, sdg:acceptedBy min 2 sdg:Individual

Class: sdg:SocialMediaPlatform
    Annotations: rdfs:label "Social Media Platform", iao:0000115 "An external online platform where users interact and share content, which may collect personal information."
    SubClassOf: sdg:CommunityEntity, sdg:platformName some xsd:string, sdg:platformURL some xsd:string, sdg:dataCollectionPolicy some xsd:string, sdg:isExternal some xsd:boolean, sdg:primaryFunctionDetail some xsd:string, sdg:platformIdentifier some xsd:string, sdg:adoptionStatus some sdg:AdoptionStatusKind, sdg:usageFrequency some xsd:string, sdg:isEnterpriseGrade some xsd:boolean, sdg:platformUrl some xsd:string, sdg:isOfficial some xsd:boolean, sdg:approvalDate some xsd:dateTime, sdg:monitoringSection some xsd:string, sdg:contactInfo some xsd:string, sdg:collectsFrom min 2 sdg:Individual, sdg:linkedTo max 1 sdg:DigitalTechnology, sdg:usedBy min 2 sdg:Employee, sdg:supportsCommunicationType min 2 sdg:InternalCommunicationEvent, sdg:maintainedBy some sdg:PersonnelRole, sdg:subjectTo some sdg:PolicyDocument, sdg:contains some sdg:SocialMediaPost

Class: sdg:ConsentRecord
    Annotations: rdfs:label "Consent Record", iao:0000115 "A record indicating an individual's agreement to the terms of a privacy policy."
    SubClassOf: cco:ont00000995, sdg:consentID some xsd:string, sdg:consentDate some xsd:dateTime, sdg:consentMethod some xsd:string, sdg:isWithdrawable some xsd:boolean, sdg:withdrawalDate some xsd:dateTime, sdg:consentTimestamp some xsd:dateTime, sdg:consentStatus some sdg:ConsentStatusKind, sdg:consentScope some sdg:ConsentScopeKind, sdg:withdrawalTimestamp some xsd:dateTime, sdg:consentId some xsd:string, sdg:scopeOfConsent some xsd:string, sdg:givenBy exactly 1 sdg:Individual, sdg:relatesTo exactly 1 sdg:PrivacyPolicy, sdg:givenBy exactly 1 sdg:DataSubject, sdg:relatesToProcessing min 2 sdg:DataProcessingRecord, sdg:givenBy exactly 1 sdg:ClientRecord, sdg:relatesTo some sdg:ServiceDelivery

Class: sdg:CurriculumTopic
    Annotations: rdfs:label "Curriculum Topic", iao:0000115 "A distinct area of mathematical study or skill within the Year 8 curriculum, such as Geometry or Algebra."
    SubClassOf: bfo:0000040, sdg:topicId some xsd:string, sdg:topicName some xsd:string, sdg:bfoGenus some xsd:string, sdg:complexityLevel some xsd:string, sdg:isCore some xsd:boolean, sdg:containsSubtopic min 2 sdg:CurriculumSubtopic, sdg:requiresPrerequisite some sdg:CurriculumTopic

Class: sdg:CurriculumSubtopic
    Annotations: rdfs:label "Curriculum Subtopic", iao:0000115 "A specific, granular skill or concept within a broader Curriculum Topic, such as 'Pythagoras' Theorem' or 'Standard Form'."
    SubClassOf: sdg:EducationalEntity, sdg:subtopicId some xsd:string, sdg:subtopicName some xsd:string, sdg:bfoGenus some xsd:string, sdg:isAbstract some xsd:boolean, sdg:difficultyRating some xsd:decimal, sdg:isPartOfTopic exactly 1 sdg:CurriculumTopic, sdg:isMeasuredBy min 2 sdg:AssessmentItem
    HasKey: sdg:subtopicId

Class: sdg:AssessmentItem
    Annotations: rdfs:label "Assessment Item", iao:0000115 "A specific problem, question, or task used to evaluate a student's mastery of a Curriculum Subtopic."
    SubClassOf: sdg:AssessmentTool, sdg:itemId some xsd:string, sdg:itemText some xsd:string, sdg:itemType some sdg:ItemTypeKind, sdg:maxScore some xsd:decimal, sdg:timeLimitSeconds some xsd:integer, sdg:isPublic some xsd:boolean, sdg:itemStatus some xsd:string, sdg:sectionDesignation some sdg:SectionDesignationKind, sdg:questionNumber some xsd:integer, sdg:subQuestionLabel some xsd:string, sdg:marksAllotted some xsd:decimal, sdg:questionType some xsd:string, sdg:status some sdg:StatusKind, sdg:itemIdentifier some xsd:string, sdg:subQuestionIndex some xsd:integer, sdg:allocatedMarks some xsd:decimal, sdg:targetsSubtopic exactly 1 sdg:CurriculumSubtopic, sdg:isAttemptedBy min 2 sdg:StudentResponse, sdg:partOf__escalated exactly 1 sdg:ExaminationPaper, sdg:referencesSource exactly 1 sdg:SourceMaterial, sdg:testsConcept some sdg:Concept, sdg:referencedBy some sdg:SourceMaterial, sdg:assessedBy exactly 1 sdg:MarkingScheme
    HasKey: sdg:itemId

Class: sdg:StudentResponse
    Annotations: rdfs:label "Student Response", iao:0000115 "A recorded answer or solution provided by a student in response to a specific Assessment Item."
    SubClassOf: sdg:responseId some xsd:string, sdg:responseValue some xsd:string, sdg:isCorrect some xsd:boolean, sdg:scoreEarned some xsd:decimal, sdg:responseTimestamp some xsd:dateTime, sdg:attemptNumber some xsd:integer, sdg:isForItem exactly 1 sdg:AssessmentItem, sdg:isSubmittedBy exactly 1 sdg:Student

Class: sdg:Athlete
    Annotations: rdfs:label "Athlete", iao:0000115 "A human participant in USA Taekwondo competitions who holds a specific membership and rank."
    SubClassOf: sdg:CompetitionEntity, sdg:athleteId some xsd:string, sdg:firstName some xsd:string, sdg:lastName some xsd:string, sdg:dateOfBirth some xsd:date, sdg:membershipStatus some sdg:MembershipStatusKind, sdg:citizenshipStatus some xsd:string, sdg:blackBeltRank some xsd:integer, sdg:backgroundCheckStatus some xsd:string, sdg:holdsMembership exactly 1 sdg:Membership, sdg:competesIn some sdg:Competition, sdg:verifiedBy max 1 sdg:BlackBeltVerification

Class: sdg:Membership
    Annotations: rdfs:label "Membership", iao:0000115 "A paid subscription granting access to USA Taekwondo events and services."
    SubClassOf: sdg:membershipId some xsd:string, sdg:membershipType some sdg:MembershipTypeKind, sdg:registrationDate some xsd:dateTime, sdg:feeAmount some xsd:decimal, sdg:expirationDate some xsd:date, sdg:isEligibleForCompetition some xsd:boolean, sdg:heldBy exactly 1 sdg:Athlete, sdg:requiresBackgroundCheck max 1 sdg:BackgroundCheck

Class: sdg:Competition
    Annotations: rdfs:label "Competition", iao:0000115 "A scheduled event where athletes compete in specific divisions."
    SubClassOf: sdg:CompetitionEntity, sdg:competitionId some xsd:string, sdg:competitionName some xsd:string, sdg:competitionLevel some sdg:CompetitionLevelKind, sdg:startDate some xsd:dateTime, sdg:endDate some xsd:dateTime, sdg:location some xsd:string, sdg:isOnSiteRegistration some xsd:boolean, sdg:hostedBy exactly 1 sdg:StateAssociation, sdg:qualifiesFor max 1 sdg:Competition, sdg:hasDivision min 2 sdg:CompetitionDivision

Class: sdg:CompetitionDivision
    Annotations: rdfs:label "Competition Division", iao:0000115 "A specific category within a competition defined by age, rank, and rules."
    SubClassOf: sdg:CompetitionEntity, sdg:divisionId some xsd:string, sdg:divisionName some xsd:string, sdg:ageCategory some xsd:string, sdg:rankRequirement some xsd:string, sdg:eventType some sdg:EventTypeKind, sdg:ruleSet some sdg:RuleSetKind, sdg:headContactAllowed some xsd:boolean, sdg:partOf exactly 1 sdg:Competition, sdg:hasParticipant__escalated min 2 sdg:Athlete

Class: sdg:StateAssociation
    Annotations: rdfs:label "State Association", iao:0000115 "A regional organization responsible for hosting state championships and managing athlete registrations."
    SubClassOf: bfo:0000040, sdg:associationId some xsd:string, sdg:associationName some xsd:string, sdg:stateCode some xsd:string, sdg:contactEmail some xsd:string, sdg:contactPhone some xsd:string, sdg:hosts min 2 sdg:Competition, sdg:verifies some sdg:BlackBeltVerification

Class: sdg:BlackBeltVerification
    Annotations: rdfs:label "Black Belt Verification", iao:0000115 "A document or process confirming an athlete's black belt rank."
    SubClassOf: bfo:0000040, sdg:verificationId some xsd:string, sdg:verificationDate some xsd:dateTime, sdg:verificationMethod some sdg:VerificationMethodKind, sdg:isVerified some xsd:boolean, sdg:issuingOrganizationDetail some xsd:string, sdg:forAthlete exactly 1 sdg:Athlete, sdg:verifiedBy exactly 1 sdg:StateAssociation

Class: sdg:BackgroundCheck
    Annotations: rdfs:label "Background Check", iao:0000115 "A safety screening required for members in supervisory positions."
    SubClassOf: bfo:0000040, sdg:checkId some xsd:string, sdg:checkDate some xsd:dateTime, sdg:checkStatus some sdg:CheckStatusKind, sdg:requiredForRoleDetail some xsd:string, sdg:forMember exactly 1 sdg:Membership, sdg:conductedBy exactly 1 sdg:StateAssociation

Class: sdg:YouthEmpowermentSummit
    Annotations: rdfs:label "Youth Empowerment Summit", iao:0000115 "An annual conference event focused on youth leadership development, activist training, and community building for LGBT and allied youth."
    SubClassOf: bfo:0000015, sdg:summitIdentifier some xsd:string, sdg:editionNumber some xsd:integer, sdg:startDate some xsd:dateTime, sdg:endDate some xsd:dateTime, sdg:totalAttendance some xsd:integer, sdg:currentTheme some xsd:string, sdg:hostedBy exactly 1 sdg:EducationalInstitution, sdg:organizedBy exactly 1 sdg:YouthOrganization, sdg:includes min 2 sdg:ConferenceWorkshop, sdg:includes min 2 sdg:PanelDiscussion

Class: sdg:EducationalInstitution
    Annotations: rdfs:label "Educational Institution", iao:0000115 "A physical or organizational entity providing formal education, serving as a venue for conferences or a site of study for participants."
    SubClassOf: sdg:EducationalEntity, sdg:institutionId some xsd:string, sdg:institutionName some xsd:string, sdg:city some xsd:string, sdg:state some xsd:string, sdg:schoolLevel some xsd:string, sdg:isSafeSpace some xsd:boolean, sdg:institutionType some sdg:InstitutionTypeKind, sdg:location some xsd:string, sdg:accreditationBody some xsd:string, sdg:address some xsd:string, sdg:principalName some xsd:string, sdg:dateEstablished some xsd:date, sdg:foundingYear some xsd:integer, sdg:locationCity some xsd:string, sdg:locationState some xsd:string, sdg:accreditationStatus some sdg:AccreditationStatusKind, sdg:hosts some sdg:YouthEmpowermentSummit, sdg:enrolls min 2 sdg:YouthParticipant, sdg:trainedProfessional min 2 sdg:NursingProfessional, sdg:locatedIn exactly 1 sdg:GeographicRegion, sdg:maintainsRegister exactly 1 sdg:AccountRegister, sdg:employsStaff min 2 sdg:StaffMember, sdg:governsByPolicy exactly 1 sdg:SocialMediaPolicy, sdg:awardedDegreeTo some sdg:Professional, sdg:awardedDegreeTo some sdg:Person, sdg:offersProgram some sdg:DegreeProgram

Class: sdg:YouthOrganization
    Annotations: rdfs:label "Youth Organization", iao:0000115 "A formal group or network dedicated to youth leadership, social justice advocacy, and community support."
    SubClassOf: sdg:Organization, sdg:orgId some xsd:string, sdg:orgName some xsd:string, sdg:headquartersCity some xsd:string, sdg:headquartersState some xsd:string, sdg:operatingModel some xsd:string, sdg:youthBoardProportion some xsd:decimal, sdg:targetAudience some sdg:TargetAudienceKind, sdg:organizes some sdg:YouthEmpowermentSummit, sdg:employs min 2 sdg:StaffMember, sdg:supports min 2 sdg:YouthParticipant

Class: sdg:YouthParticipant
    Annotations: rdfs:label "Youth Participant", iao:0000115 "An individual youth attending or participating in the summit, workshops, or organizational activities."
    SubClassOf: sdg:participantId some xsd:string, sdg:fullName some xsd:string, sdg:gradeLevel some xsd:integer, sdg:schoolAffiliation some xsd:string, sdg:identityGroup some xsd:string, sdg:roleDetail some sdg:RoleKind, sdg:attends some sdg:YouthEmpowermentSummit, sdg:enrolledAt exactly 1 sdg:EducationalInstitution, sdg:participatesIn__escalated min 2 sdg:ConferenceWorkshop, sdg:discusses some sdg:PanelDiscussion
    HasKey: sdg:participantId

Class: sdg:ConferenceWorkshop
    Annotations: rdfs:label "Conference Workshop", iao:0000115 "A structured educational or training session offered during the summit to develop skills or discuss specific topics."
    SubClassOf: bfo:0000015, sdg:workshopId some xsd:string, sdg:workshopTitle some xsd:string, sdg:topic some xsd:string, sdg:durationMinutes some xsd:integer, sdg:isYouthOnly some xsd:boolean, sdg:isComprehensive some xsd:boolean, sdg:partOf__escalated exactly 1 sdg:YouthEmpowermentSummit, sdg:attendedBy min 2 sdg:YouthParticipant, sdg:facilitatedBy some sdg:StaffMember

Class: sdg:PanelDiscussion
    Annotations: rdfs:label "Panel Discussion", iao:0000115 "A structured group conversation featuring multiple speakers and a moderator to discuss a specific theme or issue."
    SubClassOf: bfo:0000015, sdg:panelId some xsd:string, sdg:panelTheme some xsd:string, sdg:numberOfPanelists some xsd:integer, sdg:moderatorName some xsd:string, sdg:isRecorded some xsd:boolean, sdg:discussionFocus some xsd:string, sdg:partOf__escalated exactly 1 sdg:YouthEmpowermentSummit, sdg:features min 2 sdg:StaffMember, sdg:attendedBy min 2 sdg:YouthParticipant

Class: sdg:UserAccount
    Annotations: rdfs:label "User Account", iao:0000115 "A digital record representing a user's registered profile and authentication credentials on the Oversight Games platform."
    SubClassOf: cco:ont00000995, sdg:accountId some xsd:string, sdg:emailAddress some xsd:string, sdg:passwordHash some xsd:string, sdg:accountStatus some sdg:AccountStatusKind, sdg:createdAt some xsd:dateTime, sdg:lastLoginAt some xsd:dateTime, sdg:fullName some xsd:string, sdg:homeAddress some xsd:string, sdg:workAddress some xsd:string, sdg:telephoneNumber some xsd:string, sdg:dateCreated some xsd:dateTime, sdg:username some xsd:string, sdg:temporaryPassword some xsd:string, sdg:status some sdg:StatusKind, sdg:enrollmentDate some xsd:date, sdg:lastLoginTimestamp some xsd:dateTime, sdg:lastPasswordChangeDate some xsd:dateTime, sdg:passwordExpiryDays some xsd:integer, sdg:hasSession some sdg:UserSession, sdg:consentsTo some sdg:DataProcessingConsent, sdg:initiatedBy some sdg:WebSession, sdg:receives some sdg:SurveyResponse, sdg:provides exactly 1 sdg:DemographicProfile, sdg:hasCredential exactly 1 sdg:AuthenticationCredential, sdg:accessesService some sdg:DigitalService, sdg:usesDevice some sdg:UserDevice, sdg:hasCredential min 1 sdg:PasswordCredential, sdg:managesDevice some sdg:MacBookPro

Class: sdg:UserSession
    Annotations: rdfs:label "User Session", iao:0000115 "A temporary process instance representing a user's active interaction with the services, capturing device and network metadata."
    SubClassOf: bfo:0000015, sdg:sessionId some xsd:string, sdg:ipAddress some xsd:string, sdg:userAgent some xsd:string, sdg:operatingSystem some xsd:string, sdg:deviceName some xsd:string, sdg:countryCode some sdg:CountryCodeKind, sdg:sessionStart some xsd:dateTime, sdg:sessionEnd some xsd:dateTime, sdg:isCurrent some xsd:boolean, sdg:belongsToMany some sdg:UserAccount, sdg:belongsToMany exactly 1 sdg:AuthorisedUser, sdg:countsTowards exactly 1 sdg:ActivationKey

Class: sdg:DataProcessingConsent
    Annotations: rdfs:label "Data Processing Consent", iao:0000115 "A formal record of a user's permission or legal basis for the processing of their personal data under specific business purposes."
    SubClassOf: cco:ont00000958, sdg:consentId some xsd:string, sdg:legalBasis some xsd:string, sdg:purposeDescription some xsd:string, sdg:grantedAt some xsd:dateTime, sdg:revokedAt some xsd:dateTime, sdg:isRevoked some xsd:boolean, sdg:grantedBy some sdg:UserAccount

Class: sdg:MarketingCommunication
    Annotations: rdfs:label "Marketing Communication", iao:0000115 "A promotional message or email sent to users for business purposes, contingent upon their consent status."
