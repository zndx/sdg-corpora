    Annotations: rdfs:label "Patient", iao:0000115 "An individual who is the subject of personal health information and whose data is collected, used, or disclosed by health information custodians and prescribed entities."
    SubClassOf: sdg:patientId some xsd:string, sdg:dateOfBirth some xsd:date, sdg:gender some sdg:GenderKind, sdg:residenceCode some xsd:string, sdg:sex some sdg:SexKind, sdg:diagnosisDate some xsd:date, sdg:status some sdg:StatusKind, sdg:isMinor some xsd:boolean, sdg:age some xsd:integer, sdg:diagnosis some xsd:string, sdg:diseaseDuration some xsd:decimal, sdg:baselineVisualAcuity some xsd:decimal, sdg:baselineVisualField some xsd:decimal, sdg:baselineVEP some xsd:decimal, sdg:baselinePRCST some xsd:decimal, sdg:treatmentGroup some xsd:string, sdg:patientName some xsd:string, sdg:ageAtDiagnosis some xsd:integer, sdg:patientAge some xsd:integer, sdg:patientGender some xsd:string, sdg:consultationFrequency some xsd:string, sdg:feedbackRating some xsd:string, sdg:riskScreeningStatus some sdg:RiskScreeningStatusKind, sdg:preferredContactMethod some xsd:string, sdg:preferredContactLocation some xsd:string, sdg:consentStatus some sdg:ConsentStatusKind, sdg:fullName some xsd:string, sdg:ageGroup some xsd:string, sdg:insuranceProvider some xsd:string, sdg:hasCaregiverDetail some xsd:boolean, sdg:enrolledInProgram some xsd:boolean, sdg:patientID some xsd:string, sdg:registrationStatus some sdg:RegistrationStatusKind, sdg:hasOnlineAccess some xsd:boolean, sdg:admissionDate some xsd:dateTime, sdg:dischargeDate some xsd:dateTime, sdg:riskCategory some sdg:RiskCategoryKind, sdg:substanceHistory some xsd:string, sdg:offenseHistory some xsd:string, sdg:priorityStatus some xsd:boolean, sdg:demographicGroup some sdg:DemographicGroupKind, sdg:roomNumber some xsd:string, sdg:bedNumber some xsd:string, sdg:hcahpsScore some xsd:decimal, sdg:hasRecord some sdg:PatientRecord, sdg:hasHealthcareProfessional some sdg:HealthcareProfessional, sdg:hasSexualPartner some sdg:Person, sdg:hasFamilyMember some sdg:Person, sdg:hasCloseFriend some sdg:Person, sdg:undergoes min 2 sdg:OzoneTherapySession, sdg:has min 2 sdg:OphthalmologicalExam, sdg:has exactly 1 sdg:OzoneTherapyProtocol, sdg:hasClinicalProfile exactly 1 sdg:ClinicalProfile, sdg:undergoesTreatment some sdg:DialysisSession, sdg:receivesCareFrom some sdg:HealthcareProvider, sdg:receivesCareFrom exactly 1 sdg:ClinicalService, sdg:consultedBy min 1 sdg:Clinician, sdg:providesFeedbackFor some sdg:RegulatoryFinding, sdg:undergoes some sdg:TreatmentEvent, sdg:treatedBy min 2 sdg:Provider, sdg:hasCaregiver max 1 sdg:Provider, sdg:participatesIn__escalated some sdg:Program, sdg:registeredAt exactly 1 sdg:MedicalPractice, sdg:receivesService some sdg:ClinicalService, sdg:prescribedMedication some sdg:Medication, sdg:enrolledIn some sdg:TreatmentProgram, sdg:subjectToAssessment some sdg:RiskAssessment, sdg:coveredBy some sdg:PaymentSource, sdg:receivesMedication some sdg:Medication, sdg:viewsFactSheet some sdg:MedicationFactSheet, sdg:locatedIn exactly 1 sdg:DisplayEndpoint

Class: sdg:ProductionReport
    Annotations: rdfs:label "Production Report", iao:0000115 "A quantitative record of hydrocarbon extraction volumes over a specified period, typically aggregated by organization or region."
    SubClassOf: cco:ont00000995, sdg:reportId some xsd:string, sdg:reportDate some xsd:dateTime, sdg:organizationName some xsd:string, sdg:regionName some xsd:string, sdg:volumeBpd some xsd:decimal, sdg:unitOfMeasure some sdg:UnitOfMeasureKind, sdg:dataSource some xsd:string, sdg:coversRegion exactly 1 sdg:GeographicRegion, sdg:coversOrganization exactly 1 sdg:CorporateEntity
    HasKey: sdg:reportId

Class: sdg:CorporateEntity
    Annotations: rdfs:label "Corporate Entity", iao:0000115 "A legally recognized organization engaged in the exploration, production, or trade of hydrocarbons."
    SubClassOf: sdg:BusinessEntity, sdg:entityId some xsd:string, sdg:entityName some xsd:string, sdg:headquartersLocation some xsd:string, sdg:entityType some sdg:EntityTypeKind, sdg:marketCap some xsd:decimal, sdg:legalName some xsd:string, sdg:tickerSymbol some xsd:string, sdg:marketListing some xsd:string, sdg:headquartersCountry some xsd:string, sdg:marketSegment some xsd:string, sdg:incorporationDate some xsd:date, sdg:jurisdiction some sdg:JurisdictionKind, sdg:stockCode some xsd:string, sdg:industrySector some sdg:IndustrySectorKind, sdg:countryOfOperation some xsd:string, sdg:unDatabaseListed some xsd:boolean, sdg:entityIdentifier some xsd:string, sdg:entityStatus some xsd:string, sdg:regulatoryOversight some sdg:RegulatoryBody, sdg:hasExecutive some sdg:CorporateExecutive, sdg:employsConsultant some sdg:Consultant, sdg:engagesFinancialAdvisor some sdg:FinancialAdvisor, sdg:engagesCommunicationsAdvisor some sdg:CommunicationsAdvisor, sdg:governedBy exactly 1 sdg:Board, sdg:investedInBy some sdg:FinancialInstitution, sdg:operatesIn some sdg:Territory, sdg:finances some sdg:SettlementProject, sdg:employsExecutive some sdg:ExecutivePerson, sdg:hasSubsidiary some sdg:CorporateEntity, sdg:operatesInRegion some sdg:GeographicRegion

Class: sdg:PriceForecast
    Annotations: rdfs:label "Price Forecast", iao:0000115 "A projected monetary value for a commodity at a future date, issued by an analytical institution."
    SubClassOf: cco:ont00000995, sdg:forecastId some xsd:string, sdg:issueDate some xsd:date, sdg:targetYear some xsd:integer, sdg:priceValue some xsd:decimal, sdg:currencyCode some xsd:string, sdg:forecastSource some xsd:string, sdg:commodityName some xsd:string, sdg:targetPrice some xsd:decimal, sdg:currency some xsd:string, sdg:year some xsd:integer, sdg:commodity some xsd:string, sdg:issuingBody some xsd:string, sdg:issuedBy exactly 1 sdg:CorporateEntity, sdg:issuedBy exactly 1 sdg:Institution, sdg:appliesTo exactly 1 sdg:Commodity

Class: sdg:TradeShipment
    Annotations: rdfs:label "Trade Shipment", iao:0000115 "The physical movement of hydrocarbon commodities from a source region to a destination market."
    SubClassOf: bfo:0000015, sdg:shipmentId some xsd:string, sdg:shipmentDate some xsd:dateTime, sdg:volumeTonnes some xsd:decimal, sdg:commodityType some xsd:string, sdg:originCountry some xsd:string, sdg:destinationCountry some xsd:string, sdg:originatesIn exactly 1 sdg:GeographicRegion, sdg:destinedFor exactly 1 sdg:GeographicRegion

Class: sdg:RigCount
    Annotations: rdfs:label "Rig Count", iao:0000115 "A statistical count of active drilling rigs operating within a specific geographic area at a given time."
    SubClassOf: cco:ont00000995, sdg:countId some xsd:string, sdg:countDate some xsd:date, sdg:activeRigCount some xsd:integer, sdg:regionName some xsd:string, sdg:dataProvider some xsd:string, sdg:locatedIn exactly 1 sdg:GeographicRegion

Class: sdg:CompetitionEvent
    Annotations: rdfs:label "Competition Event", iao:0000115 "A scheduled competitive event for industrial maintenance mechanics involving written and practical assessments."
    SubClassOf: sdg:Event, sdg:eventId some xsd:string, sdg:eventTitle some xsd:string, sdg:eventYear some xsd:integer, sdg:eventStatus some xsd:string, sdg:registrationDeadline some xsd:dateTime, sdg:totalScoreWeight some xsd:decimal, sdg:assessmentMode some xsd:string, sdg:hasParticipant__escalated min 2 sdg:Competitor, sdg:hasAssessment min 2 sdg:Assessment, sdg:hasScoreSheet min 1 sdg:ScoreSheet
    HasKey: sdg:eventId

Class: sdg:Competitor
    Annotations: rdfs:label "Competitor", iao:0000115 "An individual registered to participate in a millwright competition, possessing required skills and tools."
    SubClassOf: sdg:competitorId some xsd:string, sdg:firstName some xsd:string, sdg:lastName some xsd:string, sdg:apprenticeLevel some sdg:ApprenticeLevelKind, sdg:registrationStatus some sdg:RegistrationStatusKind, sdg:contactEmail some xsd:string, sdg:contactPhone some xsd:string, sdg:participatesIn__escalated exactly 1 sdg:CompetitionEvent, sdg:submitsScore min 1 sdg:ScoreSheet, sdg:usesTool min 2 sdg:Tool
    HasKey: sdg:competitorId

Class: sdg:Assessment
    Annotations: rdfs:label "Assessment", iao:0000115 "A structured evaluation component of the competition, either written or practical, with defined scoring criteria."
    SubClassOf: sdg:AssessmentTool, sdg:assessmentId some xsd:string, sdg:assessmentType some xsd:string, sdg:durationMinutes some xsd:integer, sdg:scoreWeightPercentage some xsd:decimal, sdg:maxScore some xsd:decimal, sdg:assessmentStatus some xsd:string, sdg:dateGiven some xsd:date, sdg:passingScore some xsd:decimal, sdg:assessmentName some xsd:string, sdg:targetSkill some xsd:string, sdg:isDigital some xsd:boolean, sdg:lastAdministered some xsd:date, sdg:partOfEvent exactly 1 sdg:CompetitionEvent, sdg:takenBy min 2 sdg:Competitor, sdg:hasCriteria min 1 sdg:ScoreSheet, sdg:testsConcept min 2 sdg:MathematicalConcept, sdg:takenBy some sdg:Student, sdg:usedIn some sdg:LibraryProgram, sdg:evaluates some sdg:Student, sdg:alignsWith some sdg:FutureReadyGoal
    HasKey: sdg:assessmentId

Class: sdg:Tool
    Annotations: rdfs:label "Tool", iao:0000115 "A physical instrument or device required or provided for use during the competition's practical performance test."
    SubClassOf: bfo:0000040, sdg:toolId some xsd:string, sdg:toolName some xsd:string, sdg:toolCategory some xsd:string, sdg:brandReference some xsd:string, sdg:specification some xsd:string, sdg:toolStatus some xsd:string, sdg:usedBy min 2 sdg:Competitor, sdg:requiredFor exactly 1 sdg:Assessment
    HasKey: sdg:toolId

Class: sdg:ScoreSheet
    Annotations: rdfs:label "Score Sheet", iao:0000115 "A structured document recording judging criteria and maximum points for competition assessments."
    SubClassOf: bfo:0000040, sdg:scoreSheetId some xsd:string, sdg:scoreSheetVersion some xsd:string, sdg:totalMaxPoints some xsd:decimal, sdg:safetyScopeIncluded some xsd:boolean, sdg:isSample some xsd:boolean, sdg:lastUpdated some xsd:dateTime, sdg:usedFor exactly 1 sdg:Assessment, sdg:completedBy min 2 sdg:Competitor, sdg:partOfEvent exactly 1 sdg:CompetitionEvent

Class: sdg:VehicleModel
    Annotations: rdfs:label "Vehicle Model", iao:0000115 "A specific commercial vehicle model defined by its manufacturer specifications and market designation."
    SubClassOf: cco:ont00000995, sdg:modelIdentifier some xsd:string, sdg:modelDisplayName some xsd:string, sdg:manufacturerCode some xsd:string, sdg:colorVariant some xsd:string, sdg:trimLevel some xsd:string, sdg:hasEngine exactly 1 sdg:Powertrain, sdg:hasFrame exactly 1 sdg:ChassisFrame, sdg:hasSuspension some sdg:SuspensionSystem, sdg:hasBrakeSystem some sdg:BrakeSystem, sdg:hasWheelAssembly some sdg:WheelAssembly, sdg:hasCapacity some sdg:CapacitySpecification

Class: sdg:Powertrain
    Annotations: rdfs:label "Powertrain", iao:0000115 "The complete system of components responsible for generating and transmitting motive power to the vehicle."
    SubClassOf: cco:ont00000995, sdg:engineType some xsd:string, sdg:displacement some xsd:decimal, sdg:horsepower some xsd:decimal, sdg:coolingMethod some xsd:string, sdg:fuelDeliverySystem some xsd:string, sdg:transmissionType some xsd:string, sdg:gearPositions some xsd:string, sdg:driveMode some xsd:string, sdg:drivesWheels some sdg:WheelAssembly

Class: sdg:ChassisFrame
    Annotations: rdfs:label "Chassis Frame", iao:0000115 "The rigid structural framework that supports the vehicle body and connects the suspension and powertrain components."
    SubClassOf: cco:ont00000995, sdg:frameDesignation some xsd:string, sdg:technologyName some xsd:string, sdg:geometryControl some xsd:string, sdg:wheelbase some xsd:decimal, sdg:groundClearance some xsd:decimal, sdg:supportsSuspension some sdg:SuspensionSystem, sdg:mountsBrakes some sdg:BrakeSystem, sdg:supportsRack some sdg:CapacitySpecification

Class: sdg:SuspensionSystem
    Annotations: rdfs:label "Suspension System", iao:0000115 "The assembly of mechanical components that connects the vehicle to its wheels and absorbs road shocks."
    SubClassOf: cco:ont00000995, sdg:frontType some xsd:string, sdg:rearType some xsd:string, sdg:seatHeight some xsd:decimal, sdg:diveControl some xsd:boolean, sdg:connectsToFrame exactly 1 sdg:ChassisFrame, sdg:mountsWheel some sdg:WheelAssembly

Class: sdg:BrakeSystem
    Annotations: rdfs:label "Brake System", iao:0000115 "The mechanical assembly used to slow or stop the vehicle's motion through friction."
    SubClassOf: sdg:System, sdg:frontDiscDiameter some xsd:decimal, sdg:rearDiscDiameter some xsd:decimal, sdg:caliperType some xsd:string, sdg:ventilation some xsd:boolean, sdg:primaryFunctionDetail some xsd:string, sdg:mountedOn exactly 1 sdg:ChassisFrame, sdg:actsOn some sdg:WheelAssembly

Class: sdg:WheelAssembly
    Annotations: rdfs:label "Wheel Assembly", iao:0000115 "The complete rotating unit comprising the tire, rim, and hub, responsible for vehicle traction and support."
    SubClassOf: sdg:System, sdg:position some xsd:string, sdg:tireWidth some xsd:decimal, sdg:tireHeight some xsd:decimal, sdg:rimDiameter some xsd:decimal, sdg:rimMaterial some xsd:string, sdg:tireModel some xsd:string, sdg:attachedTo some sdg:SuspensionSystem, sdg:rotatesOn some sdg:BrakeSystem

Class: sdg:CapacitySpecification
    Annotations: rdfs:label "Capacity Specification", iao:0000115 "A defined limit or volume for carrying loads, towing, or storing fluids within the vehicle."
    SubClassOf: cco:ont00000995, sdg:capacityType some xsd:string, sdg:value some xsd:decimal, sdg:unit some sdg:UnitKind, sdg:location some xsd:string, sdg:appliesTo exactly 1 sdg:ChassisFrame, sdg:limits exactly 1 sdg:Powertrain

Class: sdg:AcademicCourse
    Annotations: rdfs:label "Academic Course", iao:0000115 "A structured educational program or subject area offered within the primary school curriculum, such as Mathematics, Chinese Language, or Character and Citizenship Education."
    SubClassOf: bfo:0000040, sdg:courseCode some sdg:CourseCodeKind, sdg:courseName some xsd:string, sdg:gradeLevel some xsd:integer, sdg:isMotherTongue some xsd:boolean, sdg:isCompulsory some xsd:boolean, sdg:usesMaterial min 2 sdg:EducationalMaterial, sdg:assignedToClass exactly 1 sdg:StudentClass

Class: sdg:EducationalMaterial
    Annotations: rdfs:label "Educational Material", iao:0000115 "A physical or digital resource used in the delivery of an academic course, including textbooks, workbooks, exercise books, stationery, and supplementary readers."
    SubClassOf: sdg:Book, sdg:materialCode some xsd:string, sdg:title some xsd:string, sdg:publisher some xsd:string, sdg:unitPrice some xsd:decimal, sdg:category some sdg:CategoryKind, sdg:isOptional some xsd:boolean, sdg:requiredQuantity some xsd:integer, sdg:materialType some sdg:MaterialTypeKind, sdg:suppliesCourse some sdg:AcademicCourse, sdg:orderedBy some sdg:StudentOrder
    HasKey: sdg:materialCode

Class: sdg:StudentClass
    Annotations: rdfs:label "Student Class", iao:0000115 "A cohort of students enrolled in a specific grade and section within the primary school for a given academic year."
    SubClassOf: bfo:0000002, sdg:classCode some xsd:string, sdg:gradeLevel some xsd:integer, sdg:academicYear some xsd:string, sdg:schoolName some xsd:string, sdg:enrollsStudent min 2 sdg:Student, sdg:usesMaterial min 2 sdg:EducationalMaterial

Class: sdg:StudentOrder
    Annotations: rdfs:label "Student Order", iao:0000115 "A formal request or transaction record for purchasing educational materials, linking a specific student to the items they wish to acquire."
    SubClassOf: cco:ont00000995, sdg:orderDate some xsd:dateTime, sdg:totalAmount some xsd:decimal, sdg:sectionA some xsd:decimal, sdg:sectionB some xsd:decimal, sdg:sectionC some xsd:decimal, sdg:collectionStatus some sdg:CollectionStatusKind, sdg:initiatedBy exactly 1 sdg:Student, sdg:includesMaterial min 2 sdg:EducationalMaterial

Class: sdg:ConversionMoment
    Annotations: rdfs:label "Conversion Moment", iao:0000115 "A dramatic and personal encounter with Jesus that initiates a transformative spiritual conversion in a Christian's life."
    SubClassOf: bfo:0000015, sdg:momentId some xsd:string, sdg:encounterDate some xsd:dateTime, sdg:impactDescription some xsd:string, sdg:responseAction some sdg:ResponseActionKind, sdg:isDramatic some xsd:boolean, sdg:initiatedBy exactly 1 sdg:DivinePhysician, sdg:triggeredBy some sdg:ScripturalReference

Class: sdg:ScripturalReference
    Annotations: rdfs:label "Scriptural Reference", iao:0000115 "A specific citation from sacred texts used to illustrate or ground a theological concept or narrative."
    SubClassOf: sdg:Book, sdg:referenceId some xsd:string, sdg:bookName some xsd:string, sdg:chapterNumber some xsd:integer, sdg:verseStart some xsd:integer, sdg:verseEnd some xsd:integer, sdg:textExcerpt some xsd:string, sdg:cites some sdg:BiblicalCharacter, sdg:illustrates some sdg:ConversionMoment

Class: sdg:BiblicalCharacter
    Annotations: rdfs:label "Biblical Character", iao:0000115 "A named individual from sacred narratives who serves as an exemplar of faith or spiritual response."
    SubClassOf: sdg:TheologicalConcept, sdg:characterId some xsd:string, sdg:name some sdg:NameKind, sdg:roleDetail some sdg:RoleKind, sdg:isDisciple some xsd:boolean, sdg:occupation some xsd:string, sdg:respondedTo exactly 1 sdg:DivinePhysician, sdg:appearsIn some sdg:ScripturalReference

Class: sdg:DivinePhysician
    Annotations: rdfs:label "Divine Physician", iao:0000115 "A theological designation for Jesus Christ in his role as healer of spiritual sickness and initiator of conversion."
    SubClassOf: sdg:TheologicalConcept, sdg:physicianId some xsd:string, sdg:title some xsd:string, sdg:healsSpiritualSickness some xsd:boolean, sdg:callsAllMen some xsd:boolean, sdg:heals some sdg:ConversionMoment, sdg:calls some sdg:BiblicalCharacter
    HasKey: sdg:physicianId

Class: sdg:SpiritualNeed
    Annotations: rdfs:label "Spiritual Need", iao:0000115 "An identified area of spiritual deficiency or sickness in a believer's life requiring divine healing and conversion."
    SubClassOf: bfo:0000015, sdg:needId some xsd:string, sdg:needType some xsd:string, sdg:severityLevel some sdg:SeverityLevelKind, sdg:isAddressedByPhysician some xsd:boolean, sdg:requiresConversion some xsd:boolean, sdg:addressedBy exactly 1 sdg:DivinePhysician, sdg:manifestsIn some sdg:ConversionMoment
    HasKey: sdg:needId

Class: sdg:BrandStrategy
    Annotations: rdfs:label "Brand Strategy", iao:0000115 "A strategic process that defines a brand's unique story, positioning, and identity to differentiate it from competitors and attract customers."
    SubClassOf: bfo:0000015, sdg:strategyId some xsd:string, sdg:brandName some xsd:string, sdg:positioningStatement some xsd:string, sdg:targetAudience some sdg:TargetAudienceKind, sdg:status some sdg:StatusKind, sdg:createdDate some xsd:dateTime, sdg:lastModified some xsd:dateTime, sdg:includes min 2 sdg:BrandIdentity

Class: sdg:CampaignStrategy
    Annotations: rdfs:label "Campaign Strategy", iao:0000115 "A coordinated plan for advertising campaigns that aligns online and offline efforts to engage audiences and build around a brand story."
    SubClassOf: bfo:0000015, sdg:campaignId some xsd:string, sdg:campaignName some xsd:string, sdg:startDate some xsd:dateTime, sdg:endDate some xsd:dateTime, sdg:budget some xsd:decimal, sdg:status some sdg:StatusKind, sdg:channel some xsd:string, sdg:targetEngagementRate some xsd:decimal, sdg:basedOn exactly 1 sdg:BrandStrategy
    HasKey: sdg:campaignId

Class: sdg:ContentStrategy
    Annotations: rdfs:label "Content Strategy", iao:0000115 "A framework for creating, publishing, and managing content that unifies brand messaging and drives audience engagement across media."
    SubClassOf: bfo:0000015, sdg:contentId some xsd:string, sdg:contentTitle some xsd:string, sdg:contentType some sdg:ContentTypeKind, sdg:publishDate some xsd:date, sdg:status some sdg:StatusKind, sdg:conversionRate some xsd:decimal, sdg:platform some sdg:PlatformKind, sdg:supports some sdg:CampaignStrategy, sdg:publishedOn exactly 1 sdg:DigitalPlatform

Class: sdg:ResponsiveWebsite
    Annotations: rdfs:label "Responsive Website", iao:0000115 "A digital property designed to display optimally across multiple devices, increasing conversion rates and traffic."
    SubClassOf: cco:ont00000995, sdg:websiteId some xsd:string, sdg:domainName some xsd:string, sdg:launchDate some xsd:date, sdg:conversionRate some xsd:decimal, sdg:trafficSource some xsd:string, sdg:mobileOptimized some xsd:boolean, sdg:cmsPlatform some xsd:string

Class: sdg:MobileApp
    Annotations: rdfs:label "Mobile App", iao:0000115 "A software application designed for mobile devices to engage customers and drive business growth."
    SubClassOf: cco:ont00000995, sdg:appId some xsd:string, sdg:appName some xsd:string, sdg:platform some sdg:PlatformKind, sdg:launchDate some xsd:date, sdg:loadTime some xsd:decimal, sdg:activeUsers some xsd:integer, sdg:status some sdg:StatusKind, sdg:integratesWith min 2 sdg:SocialMediaPlatform

Class: sdg:EcommerceWebsite
    Annotations: rdfs:label "E-commerce Website", iao:0000115 "A digital storefront designed to convert visitors into customers through optimized design and social media integration."
    SubClassOf: cco:ont00000995, sdg:ecommerceId some xsd:string, sdg:storeName some xsd:string, sdg:conversionRate some xsd:decimal, sdg:paymentGateway some xsd:string, sdg:inventorySystem some xsd:string, sdg:socialIntegration some xsd:boolean, sdg:lastAuditDate some xsd:date
    HasKey: sdg:ecommerceId

Class: sdg:BrandIdentity
    Annotations: rdfs:label "Brand Identity", iao:0000115 "A set of visual and verbal elements including logos, style guides, and standards that define a brand's unique presence."
    SubClassOf: cco:ont00000995, sdg:identityId some xsd:string, sdg:brandName some xsd:string, sdg:logoUrl some xsd:string, sdg:primaryColor some xsd:string, sdg:secondaryColor some xsd:string, sdg:fontFamily some xsd:string, sdg:version some xsd:string, sdg:createdFor exactly 1 sdg:BrandStrategy, sdg:usedIn min 2 sdg:PrintMaterial
    HasKey: sdg:identityId

Class: sdg:PrintMaterial
    Annotations: rdfs:label "Print Material", iao:0000115 "Physical marketing collateral such as business cards, brochures, and billboards that leave a lasting impression."
    SubClassOf: cco:ont00000995, sdg:materialId some xsd:string, sdg:materialType some sdg:MaterialTypeKind, sdg:printDate some xsd:date, sdg:quantity some xsd:integer, sdg:paperType some xsd:string, sdg:finish some xsd:string, sdg:status some sdg:StatusKind, sdg:features exactly 1 sdg:BrandIdentity
    HasKey: sdg:materialId

Class: sdg:CrownDependency
    Annotations: rdfs:label "Crown Dependency", iao:0000115 "A self-governing possession of the Crown that is not part of the United Kingdom but for which the UK is responsible for international relations and defence."
    SubClassOf: cco:ont00000995, sdg:identifier some xsd:string, sdg:name some sdg:NameKind, sdg:location some xsd:string, sdg:population some xsd:integer, sdg:economicStatus some sdg:EconomicStatusKind, sdg:historicalLink some sdg:HistoricalLinkKind, sdg:hasDepartmentResponsible exactly 1 sdg:GovernmentDepartment, sdg:hasHumanRightsFramework some sdg:HumanRightsInstrument

Class: sdg:OverseasTerritory
    Annotations: rdfs:label "Overseas Territory", iao:0000115 "A territory under the jurisdiction and sovereignty of the United Kingdom that is not part of the UK itself, often former colonial acquisitions."
    SubClassOf: cco:ont00000995, sdg:identifier some xsd:string, sdg:name some sdg:NameKind, sdg:location some xsd:string, sdg:population some xsd:integer, sdg:economicStatus some sdg:EconomicStatusKind, sdg:historicalLink some sdg:HistoricalLinkKind, sdg:nonSelfGoverning some xsd:boolean, sdg:hasDepartmentResponsible exactly 1 sdg:GovernmentDepartment, sdg:hasHumanRightsFramework some sdg:HumanRightsInstrument, sdg:receivesDevelopmentFunding some sdg:DevelopmentFunding

Class: sdg:GovernmentDepartment
    Annotations: rdfs:label "Government Department", iao:0000115 "A ministry or department of the UK government responsible for specific policy areas or territories."
    SubClassOf: cco:ont00000995, sdg:identifier some xsd:string, sdg:name some sdg:NameKind, sdg:responsibilityArea some xsd:string, sdg:departmentId some xsd:string, sdg:departmentName some xsd:string, sdg:departmentCode some xsd:string, sdg:ministerialLead some xsd:string, sdg:establishedDate some xsd:date, sdg:overseesTerritory some sdg:CrownDependency, sdg:overseesTerritory some sdg:OverseasTerritory, sdg:oversees some sdg:PolicyInstrument, sdg:coordinatesWith some sdg:GovernmentDepartment
    HasKey: sdg:departmentId

Class: sdg:HumanRightsInstrument
    Annotations: rdfs:label "Human Rights Instrument", iao:0000115 "A legal document or treaty that establishes standards for the protection of human rights."
    SubClassOf: cco:ont00000995, sdg:identifier some xsd:string, sdg:name some sdg:NameKind, sdg:type some sdg:TypeKind, sdg:status some sdg:StatusKind, sdg:appliesToTerritory some sdg:CrownDependency, sdg:appliesToTerritory some sdg:OverseasTerritory

Class: sdg:DevelopmentFunding
    Annotations: rdfs:label "Development Funding", iao:0000115 "Financial assistance provided by the UK government to support economic and social development in Overseas Territories."
    SubClassOf: cco:ont00000995, sdg:identifier some xsd:string, sdg:amount some xsd:decimal, sdg:currency some xsd:string, sdg:startDate some xsd:dateTime, sdg:endDate some xsd:dateTime, sdg:purpose some sdg:PurposeKind, sdg:providedToTerritory some sdg:OverseasTerritory

Class: sdg:InternationalFinancialInstitution
    Annotations: rdfs:label "International Financial Institution", iao:0000115 "A multilateral development institution that provides financing and policy advice for development projects, such as the World Bank Group."
    SubClassOf: cco:ont00000958, sdg:institutionId some xsd:string, sdg:name some sdg:NameKind, sdg:foundingYear some xsd:integer, sdg:governanceStructure some xsd:string, sdg:primaryMission some xsd:string, sdg:establishedAccountabilityMechanism some sdg:AccountabilityMechanism, sdg:financesProject some sdg:DevelopmentProject

Class: sdg:AccountabilityMechanism
    Annotations: rdfs:label "Accountability Mechanism", iao:0000115 "An independent process or body established to investigate public concerns, ensure transparency, and provide redress for impacts of development projects."
    SubClassOf: bfo:0000015, sdg:mechanismId some xsd:string, sdg:mechanismName some xsd:string, sdg:establishmentYear some xsd:integer, sdg:independenceLevel some xsd:string, sdg:scopeOfAuthority some sdg:ScopeOfAuthorityKind, sdg:currentStatus some sdg:CurrentStatusKind, sdg:belongsToInstitution exactly 1 sdg:InternationalFinancialInstitution, sdg:investigatesProject some sdg:DevelopmentProject, sdg:servesAffectedCommunity some sdg:AffectedCommunity
    HasKey: sdg:mechanismId

Class: sdg:AffectedCommunity
    Annotations: rdfs:label "Affected Community", iao:0000115 "A local population group directly impacted by the social, environmental, or economic consequences of a development project."
    SubClassOf: sdg:CommunityEntity, sdg:communityId some xsd:string, sdg:communityName some xsd:string, sdg:region some sdg:RegionKind, sdg:populationSize some xsd:integer, sdg:vulnerabilityIndex some xsd:decimal, sdg:primaryLanguage some sdg:PrimaryLanguageKind, sdg:impactedByProject some sdg:DevelopmentProject, sdg:raisesConcernVia some sdg:AccountabilityMechanism, sdg:impactSource some sdg:InfrastructureProject

Class: sdg:PolicyReform
    Annotations: rdfs:label "Policy Reform", iao:0000115 "A structural or procedural change proposed or enacted to enhance transparency, accountability, or responsiveness within an international financial institution."
    SubClassOf: bfo:0000015, sdg:reformId some xsd:string, sdg:reformTitle some xsd:string, sdg:proposedYear some xsd:integer, sdg:targetMechanism some xsd:string, sdg:reformType some xsd:string, sdg:implementationStatus some sdg:ImplementationStatusKind, sdg:targetsInstitution exactly 1 sdg:InternationalFinancialInstitution, sdg:enhancesMechanism some sdg:AccountabilityMechanism

Class: sdg:ManagementSystemStandard
    Annotations: rdfs:label "Management System Standard", iao:0000115 "A formalized set of requirements and guidelines for a specific management system, such as ISO 9001 or ISO 14001."
    SubClassOf: cco:ont00000958, sdg:standardIdentifier some xsd:string, sdg:publicationDate some xsd:date, sdg:issuingBody some xsd:string, sdg:standardType some xsd:string, sdg:versionNumber some xsd:string, sdg:status some sdg:StatusKind, sdg:hasCertificate some sdg:CertificationRecord, sdg:appliesTo some sdg:Organization

Class: sdg:CertificationRecord
    Annotations: rdfs:label "Certification Record", iao:0000115 "A formal record documenting the issuance of a management system certificate to an organization, including the standard, date, and scope."
    SubClassOf: sdg:Record, sdg:certificateId some xsd:string, sdg:issueDate some xsd:date, sdg:expiryDate some xsd:date, sdg:scopeDescription some xsd:string, sdg:certificationBody some xsd:string, sdg:status some sdg:StatusKind, sdg:certificateStatus some xsd:string, sdg:certificateIdentityNumber some xsd:string, sdg:currentIssueDate some xsd:dateTime, sdg:approvalNumber some xsd:string, sdg:certifies exactly 1 sdg:Organization, sdg:basedOnStandard exactly 1 sdg:ManagementSystemStandard, sdg:certifies exactly 1 sdg:CertifiedOrganization, sdg:specifiesStandard exactly 1 sdg:ManagementStandard, sdg:definesScope exactly 1 sdg:CertificationScope, sdg:recordsApproval min 1 sdg:ApprovalEvent, sdg:certifiesOrganization exactly 1 sdg:CertifiedOrganization, sdg:conformsToStandard exactly 1 sdg:ManagementStandard, sdg:issuedBy exactly 1 sdg:CertificationBody, sdg:recordedBy exactly 1 sdg:Auditor, sdg:derivedFrom some sdg:CertificationRecord

Class: sdg:CertificationStatistic
    Annotations: rdfs:label "Certification Statistic", iao:0000115 "A quantitative record of the number of certificates issued for a specific standard within a defined geographic region and time period."
    SubClassOf: cco:ont00000995, sdg:statisticId some xsd:string, sdg:reportDate some xsd:dateTime, sdg:totalCertificates some xsd:integer, sdg:standardSpecificCount some xsd:integer, sdg:describesRegion exactly 1 sdg:GeographicRegion, sdg:referencesStandard exactly 1 sdg:ManagementSystemStandard

Class: sdg:MentalHealthEducationProgram
    Annotations: rdfs:label "Mental Health Education Program", iao:0000115 "An organized educational activity designed to reduce stigma and promote help-seeking behavior regarding mental health issues among youth."
    SubClassOf: bfo:0000015, sdg:programIdentifier some xsd:string, sdg:programTitle some xsd:string, sdg:targetAgeGroup some xsd:string, sdg:deliveryMode some xsd:string, sdg:isEvidenceBased some xsd:boolean, sdg:startDate some xsd:dateTime, sdg:endDate some xsd:dateTime, sdg:status some sdg:StatusKind, sdg:deliveredBy exactly 1 sdg:TrainedSpeaker, sdg:targetsAudience some sdg:YouthDemographic, sdg:addressesIssue min 2 sdg:MentalHealthIssue, sdg:takesPlaceAt some sdg:EducationalVenue

Class: sdg:TrainedSpeaker
    Annotations: rdfs:label "Trained Speaker", iao:0000115 "A young adult who has received specific training to deliver mental health education presentations and share personal recovery stories."
    SubClassOf: bfo:0000015, sdg:speakerIdentifier some xsd:string, sdg:fullName some xsd:string, sdg:trainingCompletionDate some xsd:date, sdg:specialization some sdg:SpecializationKind, sdg:presentationCount some xsd:integer, sdg:isAvailable some xsd:boolean, sdg:bioUrl some xsd:string, sdg:deliversProgram min 2 sdg:MentalHealthEducationProgram, sdg:represents some sdg:MentalHealthIssue

Class: sdg:YouthDemographic
    Annotations: rdfs:label "Youth Demographic", iao:0000115 "A defined group of students or community members targeted by mental health education programs, categorized by age and role."
    SubClassOf: cco:ont00000995, sdg:demographicIdentifier some xsd:string, sdg:ageRangeStart some xsd:integer, sdg:ageRangeEnd some xsd:integer, sdg:roleDetail some sdg:RoleKind, sdg:institutionType some sdg:InstitutionTypeKind, sdg:totalReached some xsd:integer, sdg:participatesIn some sdg:MentalHealthEducationProgram, sdg:isTargetOf some sdg:MentalHealthIssue

Class: sdg:MentalHealthIssue
    Annotations: rdfs:label "Mental Health Issue", iao:0000115 "A specific mental health condition, behavior, or social issue addressed by the educational programs, such as suicide, bullying, or substance abuse."
    SubClassOf: bfo:0000015, sdg:issueCode some xsd:string, sdg:issueName some xsd:string, sdg:severityLevel some sdg:SeverityLevelKind, sdg:isTreatable some xsd:boolean, sdg:prevalenceInTeens some xsd:decimal, sdg:barrierToTreatment some xsd:string, sdg:addressedBy min 2 sdg:MentalHealthEducationProgram, sdg:affects some sdg:YouthDemographic

Class: sdg:EducationalVenue
    Annotations: rdfs:label "Educational Venue", iao:0000115 "A physical or organizational location where mental health education programs are delivered, such as schools, community centers, or conferences."
