Class: sdg:ProfessionalBody
    Annotations: rdfs:label "Professional Body", iao:0000115 "An organization representing legal professionals, such as associations or societies."
    SubClassOf: bfo:0000040, sdg:bodyName some xsd:string, sdg:foundingYear some xsd:integer, sdg:membershipType some sdg:MembershipTypeKind, sdg:focusArea some sdg:FocusAreaKind, sdg:bodyId some xsd:string, sdg:name some sdg:NameKind, sdg:jurisdiction some sdg:JurisdictionKind, sdg:hasMember some sdg:LegalPerson, sdg:publishesGuidance some sdg:LegalDocument

Class: sdg:LegalDocument
    Annotations: rdfs:label "Legal Document", iao:0000115 "A formal written record, such as a publication, report, or submission, related to legal matters."
    SubClassOf: sdg:LegalEntity, sdg:documentTitle some xsd:string, sdg:publicationDate some xsd:date, sdg:publisher some xsd:string, sdg:documentType some sdg:DocumentTypeKind, sdg:coAuthor some xsd:string, sdg:discusses some sdg:LegalCase, sdg:isRelatedTo some sdg:LegalStatute, sdg:isPublishedBy some sdg:ProfessionalBody

Class: sdg:AutoRepairShop
    Annotations: rdfs:label "Auto Repair Shop", iao:0000115 "A material entity that is a business establishment providing automotive repair and maintenance services."
    SubClassOf: bfo:0000040, sdg:shopId some xsd:string, sdg:shopName some xsd:string, sdg:establishedDate some xsd:date, sdg:shopType some xsd:string, sdg:dailyProductionTarget some xsd:decimal, sdg:currentDailyProduction some xsd:decimal, sdg:isProfitable some xsd:boolean, sdg:customerSatisfactionScore some xsd:decimal, sdg:employs min 2 sdg:Technician, sdg:serves some sdg:Customer, sdg:uses some sdg:DiagnosticTool

Class: sdg:Technician
    Annotations: rdfs:label "Technician", iao:0000115 "A material entity that is a person employed by an auto repair shop to perform automotive repair and maintenance tasks."
    SubClassOf: bfo:0000004, sdg:technicianId some xsd:string, sdg:firstName some xsd:string, sdg:lastName some xsd:string, sdg:hourlyRate some xsd:decimal, sdg:skillLevel some sdg:SkillLevelKind, sdg:isAssignedToRepair some xsd:boolean, sdg:techId some xsd:string, sdg:fullName some xsd:string, sdg:isOwner some xsd:boolean, sdg:dailyTasksCompleted some xsd:integer, sdg:worksAt exactly 1 sdg:AutoRepairShop, sdg:performs some sdg:RepairTask, sdg:performs some sdg:RepairJob
    HasKey: sdg:technicianId

Class: sdg:RepairTask
    Annotations: rdfs:label "Repair Task", iao:0000115 "A process that involves diagnosing, repairing, or maintaining a vehicle component or system."
    SubClassOf: bfo:0000015, sdg:taskId some xsd:string, sdg:taskDescription some xsd:string, sdg:estimatedDuration some xsd:integer, sdg:actualDuration some xsd:integer, sdg:taskStatus some xsd:string, sdg:laborCost some xsd:decimal, sdg:performedBy exactly 1 sdg:Technician, sdg:relatedTo exactly 1 sdg:Customer, sdg:uses some sdg:DiagnosticTool

Class: sdg:Customer
    Annotations: rdfs:label "Customer", iao:0000115 "A material entity that is a person or entity that receives automotive repair and maintenance services from an auto repair shop."
    SubClassOf: sdg:customerId some xsd:string, sdg:firstName some xsd:string, sdg:lastName some xsd:string, sdg:contactNumber some xsd:string, sdg:satisfactionScore some xsd:decimal, sdg:isRavingFan some xsd:boolean, sdg:totalVisits some xsd:string, sdg:customerType some xsd:string, sdg:legalName some xsd:string, sdg:registrationNumber some xsd:string, sdg:registeredAddress some xsd:string, sdg:fullName some xsd:string, sdg:contactPhone some xsd:string, sdg:emailAddress some xsd:string, sdg:satisfactionRating some xsd:decimal, sdg:customerIdentifier some xsd:string, sdg:ssn some xsd:string, sdg:dateOfBirth some xsd:date, sdg:occupation some xsd:string, sdg:annualIncome some xsd:decimal, sdg:address some xsd:string, sdg:telephoneNumber some xsd:string, sdg:receivesServiceFrom exactly 1 sdg:AutoRepairShop, sdg:hasRepairTask min 2 sdg:RepairTask, sdg:holdsActivationKey some sdg:ActivationKey, sdg:employsOrEnrolls some sdg:AuthorisedUser, sdg:submits some sdg:Vehicle, sdg:paysFor some sdg:Invoice, sdg:hasAccount min 1 sdg:CustomerAccount

