Class: sdg:SpatialPlanningParadigm
    Annotations: rdfs:label "Spatial Planning Paradigm", iao:0000115 "A theoretical and methodological framework guiding the territorial organization of land use and functional relations to balance environmental protection and development."
    SubClassOf: bfo:0000015, sdg:paradigmId some xsd:string, sdg:name some sdg:NameKind, sdg:theoreticalFocus some xsd:string, sdg:methodologicalFocus some xsd:string, sdg:status some sdg:StatusKind, sdg:appliesTo some sdg:LandUse, sdg:addresses some sdg:EcologicalSystem, sdg:informs some sdg:PolicyInstrument

Class: sdg:LandUse
    Annotations: rdfs:label "Land Use", iao:0000115 "The human modification and utilization of land for specific purposes such as residential, commercial, agricultural, or conservation activities."
    SubClassOf: bfo:0000015, sdg:landUseId some xsd:string, sdg:zoningDistrict some sdg:ZoningDistrictKind, sdg:densityClass some sdg:DensityClassKind, sdg:primaryFunctionDetail some xsd:string, sdg:lastSurveyDate some xsd:date, sdg:locatedIn exactly 1 sdg:SpatialPlanningZone, sdg:associatedWith some sdg:TransitOrientedDevelopment, sdg:influencedBy some sdg:SpatialPlanningParadigm
    HasKey: sdg:landUseId

Class: sdg:TransitOrientedDevelopment
    Annotations: rdfs:label "Transit-Oriented Development", iao:0000115 "A planning strategy that maximizes the amount of residential, business, and leisure space within walking distance of public transport."
    SubClassOf: bfo:0000015, sdg:todId some xsd:string, sdg:name some sdg:NameKind, sdg:conurbation some xsd:string, sdg:coverageRadius some xsd:decimal, sdg:implementationStatus some sdg:ImplementationStatusKind, sdg:spatiallyAssociatedWith min 2 sdg:LandUse, sdg:locatedIn exactly 1 sdg:SpatialPlanningZone

Class: sdg:EcologicalSystem
    Annotations: rdfs:label "Ecological System", iao:0000115 "A community of living organisms interacting with their physical environment, including urban parks and natural features."
    SubClassOf: bfo:0000015, sdg:ecologicalSystemId some xsd:string, sdg:name some sdg:NameKind, sdg:type some sdg:TypeKind, sdg:areaHectares some xsd:decimal, sdg:conservationStatus some xsd:string, sdg:contains min 2 sdg:NaturalFeature, sdg:locatedIn exactly 1 sdg:SpatialPlanningZone

Class: sdg:NaturalFeature
    Annotations: rdfs:label "Natural Feature", iao:0000115 "A distinct physical element of the natural environment, such as a specific tree species, water body, or landform within an ecological system."
    SubClassOf: bfo:0000015, sdg:featureId some xsd:string, sdg:name some sdg:NameKind, sdg:category some sdg:CategoryKind, sdg:perceivedValue some xsd:decimal, sdg:partOf__escalated exactly 1 sdg:EcologicalSystem, sdg:subjectOfPerception some sdg:PublicPerception
    HasKey: sdg:featureId

Class: sdg:PublicPerception
    Annotations: rdfs:label "Public Perception", iao:0000115 "Subjective views and perceptions of individuals regarding natural features or environmental conditions, often gathered through methodologies like Q methodology."
    SubClassOf: cco:ont00000995, sdg:perceptionId some xsd:string, sdg:methodology some xsd:string, sdg:subject some xsd:string, sdg:sentimentScore some xsd:decimal, sdg:surveyDate some xsd:dateTime, sdg:about some sdg:NaturalFeature, sdg:gatheredIn exactly 1 sdg:SpatialPlanningZone

Class: sdg:PolicyInstrument
    Annotations: rdfs:label "Policy Instrument", iao:0000115 "A tool or mechanism used by public sector entities to influence spatial distribution, land use, and environmental outcomes."
    SubClassOf: bfo:0000015, sdg:policyId some xsd:string, sdg:name some sdg:NameKind, sdg:jurisdiction some sdg:JurisdictionKind, sdg:effectiveDate some xsd:date, sdg:status some sdg:StatusKind, sdg:instrumentId some xsd:string, sdg:instrumentName some xsd:string, sdg:instrumentType some sdg:InstrumentTypeKind, sdg:issuingAuthorityDetail some xsd:string, sdg:enforcementLevel some sdg:EnforcementLevelKind, sdg:issuingBody some xsd:string, sdg:targetSector some xsd:string, sdg:policyTitle some xsd:string, sdg:policyType some sdg:PolicyTypeKind, sdg:version some xsd:string, sdg:launchDate some xsd:date, sdg:targetGroup some xsd:string, sdg:title some xsd:string, sdg:enactmentDate some xsd:date, sdg:scope some sdg:ScopeKind, sdg:isStatutory some xsd:boolean, sdg:type some sdg:TypeKind, sdg:description some xsd:string, sdg:informedBy some sdg:PublicPerception, sdg:targets some sdg:LandUse, sdg:appliesTo exactly 1 sdg:SpatialPlanningZone, sdg:targets some sdg:IndoorPollutant, sdg:appliesTo some sdg:IndoorEnvironment, sdg:implementedBy exactly 1 sdg:GovernmentDepartment, sdg:targets some sdg:SMEEmployer, sdg:addresses some sdg:FinanceAccess, sdg:governs some sdg:QualityImprovementProgram, sdg:references some sdg:ClinicalPerformanceData, sdg:issuedBy exactly 1 sdg:Organization, sdg:targetedAt some sdg:Researcher, sdg:informedBy some sdg:SurveyResponse, sdg:informedBy some sdg:TelephoneInterview, sdg:governs some sdg:ServiceDomain, sdg:guides some sdg:NeedsAssessment, sdg:appliesTo some sdg:ServiceUser, sdg:implementedBy some sdg:HealthCareSetting, sdg:influencesTransition some sdg:ServiceTransition

Class: sdg:SpatialPlanningZone
    Annotations: rdfs:label "Spatial Planning Zone", iao:0000115 "A defined geographical area subject to specific spatial planning regulations, zoning laws, and development guidelines."
    SubClassOf: sdg:GeographicEntity, sdg:zoneId some xsd:string, sdg:name some sdg:NameKind, sdg:region some sdg:RegionKind, sdg:country some sdg:CountryKind, sdg:areaKm2 some xsd:decimal, sdg:regulatoryPurpose some xsd:string, sdg:contains min 2 sdg:LandUse, sdg:contains some sdg:TransitOrientedDevelopment, sdg:contains some sdg:EcologicalSystem

Class: sdg:VideoManagementSystem
    Annotations: rdfs:label "Enterprise Video Management System", iao:0000115 "A software system that manages, records, and controls video feeds from surveillance cameras and analytics engines."
    SubClassOf: sdg:SecuritySystemComponent, sdg:systemIdentifier some xsd:string, sdg:versionNumber some xsd:string, sdg:deploymentMode some xsd:string, sdg:isScalable some xsd:boolean, sdg:lastMaintenanceDate some xsd:date, sdg:manufacturerId some xsd:string, sdg:integratesWith min 2 sdg:VideoAnalyticsModule, sdg:manages min 2 sdg:SurveillanceCamera, sdg:operatesIn exactly 1 sdg:ControlCenter

Class: sdg:VideoAnalyticsModule
    Annotations: rdfs:label "Integrated Video Analytics Module", iao:0000115 "A software component providing rule-based detection and classification of events within video streams."
    SubClassOf: sdg:SecuritySystemComponent, sdg:analyticsId some xsd:string, sdg:ruleCount some xsd:integer, sdg:isMultiRuleEnabled some xsd:boolean, sdg:detectionType some xsd:string, sdg:sdkVersion some xsd:string, sdg:processingLocation some sdg:ProcessingLocationKind, sdg:runsOn exactly 1 sdg:VideoManagementSystem, sdg:analyzes min 2 sdg:VideoStream, sdg:generates min 2 sdg:ForensicEvidence
    HasKey: sdg:analyticsId

Class: sdg:SurveillanceCamera
    Annotations: rdfs:label "Surveillance Camera Unit", iao:0000115 "A physical imaging device capturing video feeds for security and transportation monitoring."
    SubClassOf: sdg:SecuritySystemComponent, sdg:cameraSerialNumber some xsd:string, sdg:cameraType some sdg:CameraTypeKind, sdg:resolution some sdg:ResolutionKind, sdg:isEmbeddedAnalytics some xsd:boolean, sdg:installationDate some xsd:date, sdg:firmwareVersion some xsd:string, sdg:cameraId some xsd:string, sdg:location some xsd:string, sdg:isActive some xsd:boolean, sdg:coverageArea some xsd:string, sdg:feeds exactly 1 sdg:VideoStream, sdg:managedBy exactly 1 sdg:VideoManagementSystem, sdg:monitors some sdg:SchoolZone
    HasKey: sdg:cameraSerialNumber

Class: sdg:VideoStream
    Annotations: rdfs:label "Video Data Stream", iao:0000115 "A continuous digital data flow containing visual information from a camera or analytics source."
    SubClassOf: cco:ont00000995, sdg:streamId some xsd:string, sdg:bitrate some xsd:decimal, sdg:frameRate some xsd:decimal, sdg:codecType some xsd:string, sdg:encryptionStatus some xsd:boolean, sdg:recordingStatus some xsd:string, sdg:originatesFrom exactly 1 sdg:SurveillanceCamera, sdg:processedBy some sdg:VideoAnalyticsModule

Class: sdg:ControlCenter
    Annotations: rdfs:label "Multi-System Control Center", iao:0000115 "A centralized facility housing operators, displays, and management software for surveillance operations."
    SubClassOf: cco:ont00000995, sdg:centerId some xsd:string, sdg:centerName some xsd:string, sdg:hasVideoWall some xsd:boolean, sdg:has25DMaps some xsd:boolean, sdg:operatorCapacity some xsd:integer, sdg:operationalStatus some sdg:OperationalStatusKind, sdg:hosts exactly 1 sdg:VideoManagementSystem

Class: sdg:ForensicEvidence
    Annotations: rdfs:label "Forensic Evidence Record", iao:0000115 "A recorded data artifact generated by analytics to support investigation and legal proceedings."
    SubClassOf: cco:ont00000995, sdg:evidenceId some xsd:string, sdg:eventTimestamp some xsd:dateTime, sdg:evidenceType some xsd:string, sdg:confidenceScore some xsd:decimal, sdg:isVerified some xsd:boolean, sdg:storageLocation some xsd:string, sdg:generatedBy exactly 1 sdg:VideoAnalyticsModule, sdg:storedIn exactly 1 sdg:VideoManagementSystem

Class: sdg:BiodieselGrade
    Annotations: rdfs:label "Biodiesel Fuel Grade", iao:0000115 "A specific commercial grade of pure biodiesel fuel (B100) defined by its sulfur content limit and other ASTM D6751 properties."
    SubClassOf: cco:ont00000995, sdg:gradeCode some xsd:string, sdg:sulfurLimit some xsd:decimal, sdg:flashPointMin some xsd:decimal, sdg:cetaneMin some xsd:integer, sdg:cloudPointMax some xsd:decimal, sdg:acidNumberMax some xsd:decimal, sdg:freeGlycerinMax some xsd:decimal, sdg:totalGlycerinMax some xsd:decimal, sdg:testedBy exactly 1 sdg:ASTMTestMethod, sdg:hasProperty some sdg:FuelProperty

Class: sdg:FuelProperty
    Annotations: rdfs:label "Biodiesel Quality Property", iao:0000115 "A measurable physical or chemical characteristic of a biodiesel fuel sample that must conform to ASTM D6751 specifications."
    SubClassOf: sdg:Resource, sdg:propertyName some xsd:string, sdg:specificationLimit some xsd:decimal, sdg:unitOfMeasure some sdg:UnitOfMeasureKind, sdg:isCritical some xsd:boolean, sdg:testCondition some xsd:string, sdg:conformsTo some sdg:BiodieselGrade, sdg:measuredIn some sdg:FuelSample

Class: sdg:FuelSample
    Annotations: rdfs:label "Biodiesel Fuel Sample", iao:0000115 "A physical aliquot of pure biodiesel (B100) collected from a production batch or storage tank for quality testing."
    SubClassOf: sdg:Resource, sdg:sampleId some xsd:string, sdg:collectionDate some xsd:dateTime, sdg:sourceBatchId some xsd:string, sdg:storageTemperature some xsd:decimal, sdg:sampleVolume some xsd:decimal, sdg:sampleStatus some xsd:string, sdg:materialComposition some xsd:string, sdg:testedFor some sdg:FuelProperty, sdg:belongsBatch exactly 1 sdg:ProductionBatch, sdg:testedBy exactly 1 sdg:ASTMTestMethod

Class: sdg:ProductionBatch
    Annotations: rdfs:label "Biodiesel Production Batch", iao:0000115 "A discrete quantity of biodiesel fuel produced in a single manufacturing run or process cycle."
    SubClassOf: cco:ont00000995, sdg:batchId some xsd:string, sdg:productionDate some xsd:dateTime, sdg:productionFacilityId some xsd:string, sdg:totalVolume some xsd:decimal, sdg:feedstockType some xsd:string, sdg:batchStatus some sdg:BatchStatusKind, sdg:yieldsSample min 2 sdg:FuelSample, sdg:meetsGrade exactly 1 sdg:BiodieselGrade, sdg:storedIn max 1 sdg:StorageTank

Class: sdg:ASTMTestMethod
    Annotations: rdfs:label "ASTM Standard Test Method", iao:0000115 "A standardized laboratory procedure defined by ASTM International for measuring a specific fuel property."
    SubClassOf: cco:ont00000958, sdg:astmNumber some xsd:string, sdg:methodDescription some xsd:string, sdg:applicableGrade some xsd:string, sdg:isBQ9000Critical some xsd:boolean, sdg:measuresProperty exactly 1 sdg:FuelProperty, sdg:appliesToSample some sdg:FuelSample

Class: sdg:StorageTank
    Annotations: rdfs:label "Fuel Storage Tank", iao:0000115 "A physical container used for storing bulk biodiesel fuel (B100) or petroleum diesel blends."
    SubClassOf: cco:ont00000995, sdg:tankId some xsd:string, sdg:tankCapacity some xsd:decimal, sdg:currentFillLevel some xsd:decimal, sdg:tankMaterial some xsd:string, sdg:lastInspectionDate some xsd:date, sdg:tankStatus some xsd:string, sdg:holdsBatch some sdg:ProductionBatch, sdg:holdsSample some sdg:FuelSample

Class: sdg:ServiceInspection
    Annotations: rdfs:label "Service Inspection", iao:0000115 "A statutory evaluation process conducted by the Social Services Inspectorate to assess the quality of social care services experienced by users and carers."
    SubClassOf: bfo:0000015, sdg:inspectionId some xsd:string, sdg:inspectionDate some xsd:dateTime, sdg:inspectionStatus some sdg:InspectionStatusKind, sdg:inspectionScope some xsd:string, sdg:findingsSummary some xsd:string, sdg:evaluates min 2 sdg:SocialCareService, sdg:informs some sdg:PolicyDocument
    HasKey: sdg:inspectionId

Class: sdg:SocialCareService
    Annotations: rdfs:label "Social Care Service", iao:0000115 "A designed provision of support, such as personal care, child care, or family support, delivered by local councils, voluntary organizations, or private agencies to meet the needs of service users."
    SubClassOf: cco:ont00000995, sdg:serviceCode some xsd:string, sdg:serviceName some xsd:string, sdg:serviceType some sdg:ServiceTypeKind, sdg:deliveryMode some xsd:string, sdg:isIntegrated some xsd:boolean, sdg:eligibilityCriteria some xsd:string, sdg:providedBy exactly 1 sdg:ServiceAgency, sdg:serves min 2 sdg:ServiceUser, sdg:assessedBy some sdg:NeedsAssessment

Class: sdg:ServiceUser
    Annotations: rdfs:label "Service User", iao:0000115 "An individual receiving social care support, specifically including disabled adults in their parenting role and their children."
    SubClassOf: bfo:0000002, sdg:userId some xsd:string, sdg:userType some xsd:string, sdg:hasDisability some xsd:boolean, sdg:disabilityType some xsd:string, sdg:parentingStatus some xsd:string, sdg:needsAcknowledged some xsd:boolean, sdg:name some sdg:NameKind, sdg:dateOfBirth some xsd:date, sdg:ageGroup some xsd:string, sdg:gender some sdg:GenderKind, sdg:primaryCondition some xsd:string, sdg:receives min 2 sdg:SocialCareService, sdg:hasChild some sdg:ServiceUser, sdg:undergoes some sdg:NeedsAssessment, sdg:receivesCareFrom some sdg:HealthCareSetting, sdg:hasCarer some sdg:Carer, sdg:participatesIn__escalated some sdg:ServiceTransition

Class: sdg:NeedsAssessment
    Annotations: rdfs:label "Holistic Needs Led Assessment", iao:0000115 "A multi-professional evaluation process that covers the needs of all individuals within a family against eligibility criteria to determine access to a range of services."
    SubClassOf: bfo:0000015, sdg:assessmentId some xsd:string, sdg:assessmentDate some xsd:dateTime, sdg:assessmentType some xsd:string, sdg:isServiceLed some xsd:boolean, sdg:needsIdentified some xsd:integer, sdg:assessmentOutcome some sdg:AssessmentOutcomeKind, sdg:familySize some xsd:integer, sdg:status some sdg:StatusKind, sdg:assesses min 2 sdg:ServiceUser, sdg:conductedBy exactly 1 sdg:ServiceAgency, sdg:triggers some sdg:SocialCareService, sdg:conductedFor exactly 1 sdg:FamilyUnit

Class: sdg:ServiceAgency
    Annotations: rdfs:label "Service Agency", iao:0000115 "An organization, such as a local council, voluntary organization, or private agency, responsible for planning and delivering social care services."
    SubClassOf: bfo:0000040, sdg:agencyId some xsd:string, sdg:agencyName some xsd:string, sdg:agencyType some sdg:AgencyTypeKind, sdg:hasSpecificPolicy some xsd:boolean, sdg:jurisdiction some sdg:JurisdictionKind, sdg:adoptionOfSocialModel some xsd:boolean, sdg:delivers min 2 sdg:SocialCareService, sdg:conducts min 2 sdg:NeedsAssessment, sdg:collaboratesWith min 2 sdg:ServiceAgency
    HasKey: sdg:agencyId

Class: sdg:PolicyDocument
    Annotations: rdfs:label "Policy Document", iao:0000115 "A formal record of government policy, statutory guidance, or internal agency protocols that dictates the rights, responsibilities, and operational standards for social care provision."
    SubClassOf: cco:ont00000958, sdg:policyRef some xsd:string, sdg:policyTitle some xsd:string, sdg:publishDate some xsd:date, sdg:policyScope some xsd:string, sdg:legislationReference some xsd:string, sdg:isMandatory some xsd:boolean, sdg:documentId some xsd:string, sdg:title some xsd:string, sdg:version some xsd:string, sdg:effectiveDate some xsd:date, sdg:expiryDate some xsd:date, sdg:status some sdg:StatusKind, sdg:policyNumber some xsd:string, sdg:lastUpdated some xsd:dateTime, sdg:issuedByDetail some xsd:string, sdg:approvedByDetail some xsd:string, sdg:policyId some xsd:string, sdg:documentIdentifier some xsd:string, sdg:documentTitle some xsd:string, sdg:publicationDate some xsd:date, sdg:issuingAuthorityDetail some xsd:string, sdg:complianceStandard some sdg:ComplianceStandardKind, sdg:documentStatus some sdg:DocumentStatusKind, sdg:guides min 2 sdg:ServiceAgency, sdg:defines some sdg:SocialCareService, sdg:monitoredBy some sdg:ServiceInspection, sdg:updatedBy some sdg:PolicyReview, sdg:supersedes some sdg:PolicyDocument, sdg:isSupersededBy some sdg:PolicyDocument, sdg:references some sdg:PolicyDocument, sdg:appliesTo some sdg:PersonnelRole, sdg:governs some sdg:ElectronicCommunication, sdg:governs some sdg:SocialMediaAccount, sdg:governs some sdg:BusinessUnit, sdg:enforcedBy some sdg:GovernanceBody, sdg:referencedBy some sdg:Meeting

Class: sdg:HealthInformationTechnologySystem
    Annotations: rdfs:label "Health Information Technology System", iao:0000115 "A software-based information system deployed in clinical settings for data collection, documentation, retrieval, and order entry."
    SubClassOf: sdg:HealthcareEntity, sdg:systemIdentifier some xsd:string, sdg:systemName some xsd:string, sdg:deploymentDate some xsd:dateTime, sdg:systemType some xsd:string, sdg:usabilityScore some xsd:decimal, sdg:interoperabilityStandard some xsd:string, sdg:isStandardized some xsd:boolean, sdg:deployedIn some sdg:EmergencyDepartment, sdg:usedBy some sdg:Clinician, sdg:designedBy some sdg:ITParticipant, sdg:testedFor some sdg:UsabilityAssessment, sdg:primaryFunction some sdg:HealthInformationTechnologySystemFunction

Class: sdg:EmergencyDepartment
    Annotations: rdfs:label "Emergency Department", iao:0000115 "A high-volume, high-risk clinical unit within a hospital providing immediate medical care."
    SubClassOf: bfo:0000015, sdg:departmentCode some xsd:string, sdg:locationName some xsd:string, sdg:patientVolume some xsd:integer, sdg:averageWaitTime some xsd:decimal, sdg:staffingLevel some xsd:integer, sdg:operationalStatus some sdg:OperationalStatusKind, sdg:employs min 2 sdg:Clinician, sdg:uses some sdg:HealthInformationTechnologySystem

Class: sdg:Clinician
    Annotations: rdfs:label "Clinician", iao:0000115 "A medical professional providing direct patient care and interacting with health information technology systems."
    SubClassOf: sdg:HealthcareEntity, sdg:clinicianID some xsd:string, sdg:specialty some xsd:string, sdg:yearsOfExperience some xsd:integer, sdg:moraleLevel some xsd:decimal, sdg:productivityMetric some xsd:decimal, sdg:isCertified some xsd:boolean, sdg:supervisionStatus some sdg:SupervisionStatusKind, sdg:clinicianId some xsd:string, sdg:clinicianName some xsd:string, sdg:specialization some sdg:SpecializationKind, sdg:trainingCompleted some xsd:boolean, sdg:safeguardingAwareness some xsd:boolean, sdg:worksIn some sdg:EmergencyDepartment, sdg:uses some sdg:HealthInformationTechnologySystem, sdg:supervisedBy max 1 sdg:HospitalManager, sdg:employedBy exactly 1 sdg:ClinicalService, sdg:supervisedBy exactly 1 sdg:RegisteredManager, sdg:prescribes min 2 sdg:Medicine, sdg:consultsWith min 2 sdg:Patient

Class: sdg:HospitalManager
    Annotations: rdfs:label "Hospital Manager", iao:0000115 "An administrative role responsible for hospital operations, data collection requirements, and resource allocation."
    SubClassOf: bfo:0000023, sdg:managerID some xsd:string, sdg:departmentAssigned some xsd:string, sdg:yearsInRole some xsd:integer, sdg:focusArea some sdg:FocusAreaKind, sdg:manages some sdg:EmergencyDepartment, sdg:requires some sdg:HealthInformationTechnologySystem

Class: sdg:UsabilityAssessment
    Annotations: rdfs:label "Usability Assessment", iao:0000115 "A measurement process evaluating the effectiveness, efficiency, and satisfaction of a health information technology system."
    SubClassOf: bfo:0000015, sdg:assessmentID some xsd:string, sdg:assessmentDate some xsd:dateTime, sdg:score some xsd:decimal, sdg:testSubjectGroup some xsd:string, sdg:isCompleted some xsd:boolean, sdg:assesses exactly 1 sdg:HealthInformationTechnologySystem, sdg:conductedBy some sdg:ITParticipant

Class: sdg:ITParticipant
    Annotations: rdfs:label "IT Participant", iao:0000115 "A technical professional involved in the design, implementation, or assessment of health information technology systems."
    SubClassOf: bfo:0000023, sdg:participantID some xsd:string, sdg:skillLevel some sdg:SkillLevelKind, sdg:roleInProject some xsd:string, sdg:affiliatedOrganization some xsd:string, sdg:designed some sdg:HealthInformationTechnologySystem, sdg:conductedAssessment some sdg:UsabilityAssessment

Class: sdg:ApplicationDocument
    Annotations: rdfs:label "Application Document", iao:0000115 "A physical or digital document containing the application materials, comments, and certificates to be submitted."
    SubClassOf: bfo:0000040, sdg:documentId some xsd:string, sdg:fileName some xsd:string, sdg:fileSizeBytes some xsd:integer, sdg:pageCount some xsd:integer, sdg:creationDate some xsd:dateTime, sdg:format some sdg:FormatKind, sdg:contains min 2 sdg:ApplicationPage, sdg:generatedBy exactly 1 sdg:ScanningProcess

Class: sdg:ApplicationPage
    Annotations: rdfs:label "Application Page", iao:0000115 "A single page within the application document, containing specific content such as a form, comment sheet, or certificate."
    SubClassOf: bfo:0000040, sdg:pageNumber some xsd:integer, sdg:contentType some sdg:ContentTypeKind, sdg:imageResolution some xsd:decimal, sdg:isColor some xsd:boolean, sdg:orientation some xsd:string, sdg:partOf exactly 1 sdg:ApplicationDocument, sdg:capturedBy exactly 1 sdg:ScanningProcess

Class: sdg:ScanningProcess
    Annotations: rdfs:label "Scanning Process", iao:0000115 "The activity of capturing physical documents using a mobile device or scanner to create digital representations."
    SubClassOf: sdg:SecuritySystemComponent, sdg:processId some xsd:string, sdg:startDate some xsd:dateTime, sdg:endDate some xsd:dateTime, sdg:deviceType some sdg:DeviceTypeKind, sdg:appUsed some xsd:string, sdg:status some sdg:StatusKind, sdg:produced max 1 sdg:ApplicationDocument, sdg:captured min 2 sdg:ApplicationPage, sdg:usedDevice exactly 1 sdg:MobileDevice

Class: sdg:MobileDevice
    Annotations: rdfs:label "Mobile Device", iao:0000115 "A handheld computing device used to capture images of documents, such as an iPhone or Android phone."
    SubClassOf: bfo:0000040, sdg:deviceId some xsd:string, sdg:manufacturer some xsd:string, sdg:model some xsd:string, sdg:osVersion some xsd:string, sdg:cameraResolution some xsd:decimal, sdg:usedIn some sdg:ScanningProcess

Class: sdg:ExportProcess
    Annotations: rdfs:label "Export Process", iao:0000115 "The activity of converting scanned images or documents into a final PDF format and transferring them to a computer."
    SubClassOf: bfo:0000015, sdg:exportId some xsd:string, sdg:exportDate some xsd:dateTime, sdg:method some sdg:MethodKind, sdg:targetFileSizeMB some xsd:decimal, sdg:status some sdg:StatusKind, sdg:transforms exactly 1 sdg:ApplicationDocument, sdg:usesMethod exactly 1 sdg:ExportMethod

Class: sdg:ExportMethod
    Annotations: rdfs:label "Export Method", iao:0000115 "A specific technique or tool used to transfer or convert documents, such as AirDrop, Email, or Microsoft Word."
    SubClassOf: bfo:0000040, sdg:methodId some xsd:string, sdg:methodName some sdg:MethodNameKind, sdg:supportsCompression some xsd:boolean, sdg:maxFileSizeGB some xsd:decimal, sdg:usedIn some sdg:ExportProcess

Class: sdg:DomiciliaryCareAgency
    Annotations: rdfs:label "Domiciliary Care Agency", iao:0000115 "A registered care service organization that provides in-home support to individuals living in their own residences."
    SubClassOf: cco:ont00000995, sdg:registrationNumber some xsd:string, sdg:legalName some xsd:string, sdg:physicalAddress some xsd:string, sdg:telephone some xsd:string, sdg:website some xsd:string, sdg:operationalStatus some sdg:OperationalStatusKind, sdg:hasRegisteredManager exactly 1 sdg:RegisteredManager, sdg:conductedInspection some sdg:RegulatoryInspection

Class: sdg:RegisteredManager
    Annotations: rdfs:label "Registered Manager", iao:0000115 "A person legally responsible for the management and operation of a care service, registered with the regulatory authority."
    SubClassOf: bfo:0000023, sdg:managerId some xsd:string, sdg:fullName some xsd:string, sdg:registrationDate some xsd:dateTime, sdg:legalResponsibilityScope some xsd:string, sdg:manages exactly 1 sdg:DomiciliaryCareAgency

Class: sdg:RegulatoryInspection
    Annotations: rdfs:label "Regulatory Inspection", iao:0000115 "A formal evaluation process conducted by a regulatory body to assess compliance with health and social care standards."
    SubClassOf: sdg:RegulatoryComplianceConcept, sdg:inspectionId some xsd:string, sdg:inspectionDate some xsd:dateTime, sdg:publicationDate some xsd:date, sdg:noticePeriod some xsd:integer, sdg:inspectionType some xsd:string, sdg:overallComplianceStatus some xsd:string, sdg:inspectionStatus some sdg:InspectionStatusKind, sdg:evaluated exactly 1 sdg:DomiciliaryCareAgency, sdg:assignedRating some sdg:ServiceRating

Class: sdg:ServiceRating
    Annotations: rdfs:label "Service Rating", iao:0000115 "A scored assessment of a care service's performance across specific quality domains."
    SubClassOf: cco:ont00000995, sdg:ratingId some xsd:string, sdg:safetyRating some xsd:string, sdg:effectivenessRating some sdg:EffectivenessRatingKind, sdg:caringRating some xsd:string, sdg:responsivenessRating some xsd:string, sdg:wellLedRating some xsd:string, sdg:partOfInspection exactly 1 sdg:RegulatoryInspection

Class: sdg:CarePlan
    Annotations: rdfs:label "Care Plan", iao:0000115 "A documented record outlining the specific support, medical, and personal needs of an individual receiving care."
    SubClassOf: cco:ont00000958, sdg:planId some xsd:string, sdg:lastReviewDate some xsd:date, sdg:dietaryRequirements some xsd:string, sdg:medicationRegimen some xsd:string, sdg:riskAssessmentStatus some sdg:RiskAssessmentStatusKind, sdg:carePlanId some xsd:string, sdg:planStartDate some xsd:dateTime, sdg:planEndDate some xsd:dateTime, sdg:reviewFrequency some xsd:string, sdg:nutritionMonitoring some xsd:boolean, sdg:hydrationMonitoring some xsd:boolean, sdg:medicationManagement some xsd:boolean, sdg:assignedToPerson exactly 1 sdg:CareRecipient, sdg:monitoredByStaff min 2 sdg:CareStaff, sdg:belongsToOne exactly 1 sdg:CareRecipient, sdg:specifiesTasks some sdg:CareTask

Class: sdg:CareRecipient
    Annotations: rdfs:label "Care Recipient", iao:0000115 "An individual receiving domiciliary care services in their own home."
    SubClassOf: bfo:0000004, sdg:recipientId some xsd:string, sdg:dateOfBirth some xsd:date, sdg:mentalCapacityStatus some xsd:string, sdg:primaryLanguage some sdg:PrimaryLanguageKind, sdg:firstName some xsd:string, sdg:lastName some xsd:string, sdg:address some xsd:string, sdg:supportNeedsAssessmentDate some xsd:dateTime, sdg:dietaryPreferences some xsd:string, sdg:receivesCareFrom exactly 1 sdg:DomiciliaryCareAgency, sdg:hasCarePlan some sdg:CarePlan, sdg:receivesCareFrom exactly 1 sdg:CareAgency, sdg:hasStaffAssignment some sdg:StaffAssignment

Class: sdg:CareStaff
    Annotations: rdfs:label "Care Staff", iao:0000115 "Personnel employed by the agency to provide direct support and care to recipients."
    SubClassOf: bfo:0000004, sdg:staffId some xsd:string, sdg:securityClearanceStatus some sdg:SecurityClearanceStatusKind, sdg:trainingCompletionDate some xsd:date, sdg:employmentStatus some sdg:EmploymentStatusKind, sdg:employedBy exactly 1 sdg:DomiciliaryCareAgency, sdg:supports min 2 sdg:CareRecipient

Class: sdg:ParasiticWeedSpecies
    Annotations: rdfs:label "Parasitic Weed Species", iao:0000115 "A distinct taxonomic species of parasitic plant that infects host crops in agricultural systems."
    SubClassOf: bfo:0000040, sdg:speciesCode some xsd:string, sdg:commonName some xsd:string, sdg:parasiticType some xsd:string, sdg:chlorophyllPresence some xsd:boolean, sdg:seedProductionRate some xsd:decimal, sdg:seedLongevityYears some xsd:decimal, sdg:seedSizeMicrograms some xsd:decimal, sdg:germinationCueRequired some xsd:boolean, sdg:parasitises min 2 sdg:CropSpecies, sdg:infects some sdg:AgriculturalField, sdg:exhibits exactly 1 sdg:GerminationRequirement

Class: sdg:CropSpecies
    Annotations: rdfs:label "Crop Species", iao:0000115 "A cultivated plant species grown for agricultural production in African farming systems."
    SubClassOf: bfo:0000040, sdg:scientificName some xsd:string, sdg:cropType some xsd:string, sdg:growthRegion some xsd:string, sdg:isHostForStriga some xsd:boolean, sdg:isHostForRhamphicarpa some xsd:boolean, sdg:isParasitizedBy some sdg:ParasiticWeedSpecies, sdg:growsIn some sdg:AgriculturalField

Class: sdg:AgriculturalField
    Annotations: rdfs:label "Agricultural Field", iao:0000115 "A specific parcel of land used for crop cultivation with defined soil and hydrological characteristics."
    SubClassOf: bfo:0000004, sdg:fieldId some xsd:string, sdg:landscapePosition some sdg:LandscapePositionKind, sdg:soilDrainage some sdg:SoilDrainageKind, sdg:soilMoistureLevel some xsd:string, sdg:primaryCrop some xsd:string, sdg:affectedHouseholds some xsd:integer, sdg:hosts exactly 1 sdg:CropSpecies, sdg:infestedBy some sdg:ParasiticWeedSpecies, sdg:locatedIn exactly 1 sdg:GeographicRegion

Class: sdg:GerminationRequirement
    Annotations: rdfs:label "Germination Requirement", iao:0000115 "The specific biochemical or environmental conditions necessary for a parasitic weed seed to initiate germination."
    SubClassOf: bfo:0000015, sdg:requirementType some sdg:RequirementTypeKind, sdg:cueSubstance some xsd:string, sdg:moistureThreshold some xsd:decimal, sdg:hostRootProximityRequired some xsd:boolean, sdg:requiredBy exactly 1 sdg:ParasiticWeedSpecies

Class: sdg:GeographicRegion
    Annotations: rdfs:label "Geographic Region", iao:0000115 "A defined geographical area in Africa where specific agricultural and ecological conditions prevail."
    SubClassOf: sdg:GeographicEntity, sdg:regionCode some xsd:string, sdg:regionName some xsd:string, sdg:climateZone some sdg:ClimateZoneKind, sdg:dominantSoilType some xsd:string, sdg:businessContext some xsd:string, sdg:regionId some xsd:string, sdg:countryCode some sdg:CountryCodeKind, sdg:regionType some sdg:RegionTypeKind, sdg:regulatoryAuthority some xsd:string, sdg:marketSize some xsd:decimal, sdg:prevalenceRate some xsd:decimal, sdg:currencyCode some xsd:string, sdg:languageCode some xsd:string, sdg:timeZone some xsd:string, sdg:latitude some xsd:decimal, sdg:longitude some xsd:decimal, sdg:continent some xsd:string, sdg:name some sdg:NameKind, sdg:type some sdg:TypeKind, sdg:coordinatesDetail some xsd:string, sdg:politicalAffiliation some xsd:string, sdg:stateProvince some xsd:string, sdg:totalAgriculturalAcreage some xsd:decimal, sdg:averageLandPrice some xsd:decimal, sdg:dominantCrops some xsd:string, sdg:regionIdentifier some xsd:string, sdg:hurricaneVulnerability some xsd:boolean, sdg:population some xsd:integer, sdg:socialEnterpriseDensity some xsd:decimal, sdg:isRural some xsd:boolean, sdg:populationDensity some xsd:decimal, sdg:areaSqKm some xsd:decimal, sdg:administrativeLevel some xsd:string, sdg:areaHectares some xsd:decimal, sdg:averageAnnualRainfall some xsd:decimal, sdg:climateClassification some xsd:string, sdg:elevationMeters some xsd:decimal, sdg:primaryLanguage some sdg:PrimaryLanguageKind, sdg:regionStatus some xsd:string, sdg:country some sdg:CountryKind, sdg:contains min 2 sdg:AgriculturalField, sdg:hostsCompany some sdg:PharmaceuticalCompany, sdg:hostsRnD some sdg:PharmaceuticalCompany, sdg:marketForDrug some sdg:DrugApplication, sdg:affectedByDisease some sdg:Disease, sdg:jurisdictionForRegulation some sdg:DrugApplication, sdg:contains some sdg:Organization, sdg:hasCertificationData some sdg:CertificationStatistic, sdg:isExporterIn min 2 sdg:TradeTransaction, sdg:isImporterIn min 2 sdg:TradeTransaction, sdg:containsField min 2 sdg:ProductionRecord, sdg:contains some sdg:ManufacturingFacility, sdg:contains min 2 sdg:FarmlandParcel, sdg:receivesWebinar some sdg:WebinarSession, sdg:containsSocialEnterprises some sdg:SocialEnterprise, sdg:isPartOf exactly 1 sdg:Country, sdg:containsPopulation min 2 sdg:PopulationGroup, sdg:hostsSurveyData some sdg:HealthSurvey, sdg:contains min 2 sdg:PastoralTerritory, sdg:contains min 2 sdg:WaterSource, sdg:contains min 2 sdg:PastoralCommunity, sdg:contains some sdg:BusinessUnit, sdg:hostsProgramme some sdg:CSRComponent, sdg:containsOperations some sdg:CorporateEntity, sdg:containsDemographicData some sdg:DemographicSurvey, sdg:containsHealthData some sdg:HealthMortalityRecord, sdg:containsEducationData some sdg:EducationEnrollment, sdg:containsLaborData some sdg:ChildLaborStatistic, sdg:containsPovertyData some sdg:PovertyIndex

Class: sdg:SpecialInterestGroup
    Annotations: rdfs:label "Special Interest Group", iao:0000115 "A formally organized community of researchers dedicated to advancing a specific academic field, such as logic and computation."
    SubClassOf: bfo:0000040, sdg:identifier some xsd:string, sdg:name some sdg:NameKind, sdg:foundingYear some xsd:integer, sdg:status some sdg:StatusKind, sdg:missionStatement some xsd:string, sdg:hasOfficer min 1 sdg:Officer, sdg:hasCommittee some sdg:Committee, sdg:publishes some sdg:Newsletter, sdg:organizes some sdg:Conference, sdg:collaboratesWith some sdg:SpecialInterestGroup

Class: sdg:Officer
    Annotations: rdfs:label "Officer", iao:0000115 "An individual holding a formal leadership or administrative role within a Special Interest Group."
    SubClassOf: bfo:0000040, sdg:roleDetail some sdg:RoleKind, sdg:appointmentDate some xsd:date, sdg:termEndDate some xsd:date, sdg:status some sdg:StatusKind, sdg:officerId some xsd:string, sdg:fullName some xsd:string, sdg:roleTitle some sdg:RoleTitleKind, sdg:isInsuranceCoordinator some xsd:boolean, sdg:servesIn exactly 1 sdg:SpecialInterestGroup, sdg:servesIn exactly 1 sdg:Organization, sdg:holdsRole exactly 1 sdg:OfficerRole

Class: sdg:Conference
    Annotations: rdfs:label "Conference", iao:0000115 "A formal gathering of researchers to present and discuss findings, often organized under a specific cluster or by a Special Interest Group."
    SubClassOf: bfo:0000040, sdg:name some sdg:NameKind, sdg:location some xsd:string, sdg:startDate some xsd:dateTime, sdg:endDate some xsd:dateTime, sdg:expectedAttendance some xsd:integer, sdg:cluster some xsd:string, sdg:conferenceIdentifier some xsd:string, sdg:conferenceName some xsd:string, sdg:frequency some sdg:FrequencyKind, sdg:organizedBy some sdg:SpecialInterestGroup, sdg:hostedBy exactly 1 sdg:Organization, sdg:attends some sdg:Individual, sdg:covers some sdg:CommunicationGoal

Class: sdg:ResearchArea
    Annotations: rdfs:label "Research Area", iao:0000115 "A distinct field of academic inquiry, such as modal logic or computability theory, that falls under the purview of a Special Interest Group."
    SubClassOf: bfo:0000040, sdg:name some sdg:NameKind, sdg:classification some sdg:ClassificationKind, sdg:description some xsd:string, sdg:coveredBy some sdg:SpecialInterestGroup, sdg:taughtIn some sdg:Curriculum

Class: sdg:Newsletter
    Annotations: rdfs:label "Newsletter", iao:0000115 "A periodic electronic publication containing community news, technical columns, and feedback, published by a Special Interest Group."
    SubClassOf: bfo:0000040, sdg:frequency some sdg:FrequencyKind, sdg:format some sdg:FormatKind, sdg:startDate some xsd:dateTime, sdg:status some sdg:StatusKind, sdg:publishedBy exactly 1 sdg:SpecialInterestGroup

Class: sdg:Curriculum
    Annotations: rdfs:label "Curriculum", iao:0000115 "An educational program or syllabus, such as an undergraduate computer science curriculum, that advocates for the inclusion of specific research areas."
    SubClassOf: sdg:level some sdg:LevelKind, sdg:institutionType some sdg:InstitutionTypeKind, sdg:status some sdg:StatusKind, sdg:advocatedBy some sdg:SpecialInterestGroup, sdg:includesTopic some sdg:ResearchArea

Class: sdg:RegulatoryViolation
    Annotations: rdfs:label "Regulatory Violation", iao:0000115 "A documented instance of non-compliance with a specific regulatory requirement identified during an inspection."
    SubClassOf: sdg:RegulatoryComplianceConcept, sdg:violationId some xsd:string, sdg:description some xsd:string, sdg:regulatoryReference some xsd:string, sdg:severityLevel some sdg:SeverityLevelKind, sdg:status some sdg:StatusKind, sdg:inspectionReportId some xsd:string, sdg:dateIdentified some xsd:dateTime, sdg:reportedIn exactly 1 sdg:InspectionReport, sdg:addressedBy some sdg:CorrectiveActionPlan

Class: sdg:InspectionReport
    Annotations: rdfs:label "Inspection Report", iao:0000115 "An official document generated by a regulatory body detailing findings from a site inspection."
    SubClassOf: sdg:reportNumber some xsd:string, sdg:issueDate some xsd:date, sdg:issuingAgency some xsd:string, sdg:docketNumber some xsd:string, sdg:classification some sdg:ClassificationKind, sdg:adamsAccessionNumber some xsd:string, sdg:inspectionType some xsd:string, sdg:reportId some xsd:string, sdg:publicationDate some xsd:date, sdg:referenceCode some xsd:string, sdg:publisher some xsd:string, sdg:status some sdg:StatusKind, sdg:reportTitle some xsd:string, sdg:summaryOfFindings some xsd:string, sdg:complianceStatus some sdg:ComplianceStatusKind, sdg:previousInspectionDate some xsd:dateTime, sdg:previousComplianceStatus some sdg:PreviousComplianceStatusKind, sdg:citesViolation min 2 sdg:RegulatoryViolation, sdg:issuedTo exactly 1 sdg:Licensee, sdg:conductedBy exactly 1 sdg:InspectionBody, sdg:focusesOn exactly 1 sdg:ServiceDomain, sdg:documentsInspection exactly 1 sdg:InspectionEvent

Class: sdg:CorrectiveActionPlan
    Annotations: rdfs:label "Corrective Action Plan", iao:0000115 "A formal plan detailing steps taken or to be taken to resolve a regulatory violation and ensure future compliance."
    SubClassOf: cco:ont00000995, sdg:planId some xsd:string, sdg:submissionDate some xsd:dateTime, sdg:complianceDeadline some xsd:dateTime, sdg:status some sdg:StatusKind, sdg:correctiveStepsTaken some xsd:string, sdg:preventiveMeasures some xsd:string, sdg:addressesViolation exactly 1 sdg:RegulatoryViolation, sdg:submittedBy exactly 1 sdg:Licensee

Class: sdg:Licensee
    Annotations: rdfs:label "Licensee", iao:0000115 "An individual or organization holding a license to possess or use regulated materials."
    SubClassOf: bfo:0000040, sdg:licenseNumber some xsd:string, sdg:licenseeName some xsd:string, sdg:licenseType some xsd:string, sdg:docketNumber some xsd:string, sdg:address some xsd:string, sdg:radiationSafetyOfficer some xsd:string, sdg:holdsLicense some sdg:RegulatoryViolation, sdg:submitsResponse min 2 sdg:CorrectiveActionPlan

Class: sdg:RadiationSurvey
    Annotations: rdfs:label "Radiation Survey", iao:0000115 "A measurement process conducted to assess radiation levels in controlled or unrestricted areas."
    SubClassOf: bfo:0000015, sdg:surveyId some xsd:string, sdg:surveyDate some xsd:dateTime, sdg:areaType some xsd:string, sdg:measuredDoseRate some xsd:decimal, sdg:unitOfMeasure some sdg:UnitOfMeasureKind, sdg:complianceStatus some sdg:ComplianceStatusKind, sdg:performedBy exactly 1 sdg:Licensee, sdg:supportsCompliance some sdg:RegulatoryViolation

Class: sdg:LectureSession
    Annotations: rdfs:label "Lecture Session", iao:0000115 "A scheduled instructional event where lecture notes and computational examples are delivered to students."
    SubClassOf: bfo:0000015, sdg:sessionIdentifier some xsd:string, sdg:scheduledDate some xsd:dateTime, sdg:durationMinutes some xsd:integer, sdg:topic some xsd:string, sdg:status some sdg:StatusKind, sdg:uses some sdg:LectureNote, sdg:delivers min 2 sdg:ComputationalExample, sdg:uses min 1 sdg:ComputationalExample

Class: sdg:LectureNote
    Annotations: rdfs:label "Lecture Note", iao:0000115 "A structured document containing textual explanations, diagrams, and theoretical content for a specific lecture."
    SubClassOf: sdg:Book, sdg:noteId some xsd:string, sdg:title some xsd:string, sdg:versionNumber some xsd:string, sdg:pageCount some xsd:integer, sdg:lastModified some xsd:dateTime, sdg:format some sdg:FormatKind, sdg:noteIdentifier some xsd:string, sdg:belongsTo exactly 1 sdg:LectureSession, sdg:references some sdg:ComputationalExample

Class: sdg:ComputationalExample
    Annotations: rdfs:label "Computational Example", iao:0000115 "A reusable computational artifact, such as a Mathematica notebook, demonstrating a specific scientific or engineering concept."
    SubClassOf: cco:ont00000995, sdg:exampleId some xsd:string, sdg:title some xsd:string, sdg:fileFormat some sdg:FileFormatKind, sdg:fileSizeBytes some xsd:integer, sdg:creationDate some xsd:dateTime, sdg:author some xsd:string, sdg:license some xsd:string, sdg:exampleIdentifier some xsd:string, sdg:softwareVersion some xsd:string, sdg:status some sdg:StatusKind, sdg:demonstrates min 2 sdg:MathematicalConcept, sdg:storedIn exactly 1 sdg:DigitalRepository, sdg:deliveredIn exactly 1 sdg:LectureSession, sdg:storedAs min 1 sdg:NotebookFile

Class: sdg:MathematicalConcept
    Annotations: rdfs:label "Mathematical Concept", iao:0000115 "An abstract theoretical construct or method, such as a function type or differential equation, used in scientific computation."
    SubClassOf: sdg:conceptId some xsd:string, sdg:name some sdg:NameKind, sdg:category some sdg:CategoryKind, sdg:complexityLevel some xsd:string, sdg:prerequisiteConcepts some xsd:string, sdg:conceptName some xsd:string, sdg:conceptType some xsd:string, sdg:difficultyLevel some sdg:DifficultyLevelKind, sdg:prerequisiteConceptId some xsd:string, sdg:domain some sdg:DomainKind, sdg:isAbstract some xsd:boolean, sdg:appliedIn some sdg:ComputationalExample, sdg:taughtIn some sdg:LectureSession, sdg:prerequisiteFor some sdg:MathematicalConcept, sdg:taughtIn some sdg:Course, sdg:isSubjectOf min 1 sdg:DidacticalSituation, sdg:requires some sdg:MathematicalConcept

Class: sdg:DigitalRepository
    Annotations: rdfs:label "Digital Repository", iao:0000115 "A persistent storage system or file directory where computational artifacts and lecture materials are archived."
    SubClassOf: sdg:DataEntity, sdg:repositoryId some xsd:string, sdg:name some sdg:NameKind, sdg:storagePath some xsd:string, sdg:totalCapacityGB some xsd:decimal, sdg:lastBackup some xsd:dateTime, sdg:accessLevel some sdg:AccessLevelKind, sdg:hosts min 2 sdg:ComputationalExample, sdg:hosts min 2 sdg:LectureNote

Class: sdg:SocialServiceResource
    Annotations: rdfs:label "Social Service Resource", iao:0000115 "A made thing or record representing a community service, facility, or program designed to assist individuals and families with needs such as food, housing, childcare, and emergency shelter."
    SubClassOf: sdg:CommunityEntity, sdg:resourceIdentifier some xsd:string, sdg:resourceName some xsd:string, sdg:serviceCategory some sdg:ServiceCategoryKind, sdg:isConfidential some xsd:boolean, sdg:isFree some xsd:boolean, sdg:operatingHours some xsd:string, sdg:serviceType some sdg:ServiceTypeKind, sdg:serviceStatus some sdg:ServiceStatusKind, sdg:languageAvailability some xsd:integer, sdg:providesTo min 2 sdg:Beneficiary, sdg:managedBy exactly 1 sdg:ServiceOrganization, sdg:accessedVia min 2 sdg:AccessChannel, sdg:providedBy exactly 1 sdg:ServiceOrganization, sdg:servesLocation some sdg:ServiceLocation

Class: sdg:ServiceOrganization
    Annotations: rdfs:label "Service Organization", iao:0000115 "A made thing or record representing an entity, such as United Way, SAMHSA, or ICE, that administers, funds, or operates social services and hotlines."
    SubClassOf: sdg:Organization, sdg:organizationIdentifier some xsd:string, sdg:organizationName some xsd:string, sdg:jurisdiction some sdg:JurisdictionKind, sdg:isGovernmentAgency some xsd:boolean, sdg:websiteUrl some xsd:string, sdg:jurisdictionLevel some sdg:JurisdictionLevelKind, sdg:contactPhoneNumber some xsd:string, sdg:isTollFree some xsd:boolean, sdg:operates min 2 sdg:SocialServiceResource, sdg:operates min 2 sdg:Hotline, sdg:managesResource some sdg:SocialServiceResource, sdg:operatesHotline some sdg:HotlineService

Class: sdg:Hotline
    Annotations: rdfs:label "Hotline", iao:0000115 "A made thing or record representing a dedicated telephonic or text-based communication channel for reporting, referral, or information regarding specific social or health issues."
    SubClassOf: cco:ont00000995, sdg:phoneNumber some xsd:string, sdg:smsKeyword some xsd:string, sdg:hotlineType some sdg:HotlineTypeKind, sdg:isAvailable247 some xsd:boolean, sdg:isConfidential some xsd:boolean, sdg:operatedBy exactly 1 sdg:ServiceOrganization, sdg:handlesReportFor min 2 sdg:Incident, sdg:providesReferralFor min 2 sdg:SocialServiceResource

Class: sdg:Incident
    Annotations: rdfs:label "Incident", iao:0000115 "A process or activity representing a specific event of human trafficking, sexual assault, or substance abuse that requires reporting, investigation, or intervention."
    SubClassOf: bfo:0000015, sdg:incidentIdentifier some xsd:string, sdg:incidentType some sdg:IncidentTypeKind, sdg:reportedDateTime some xsd:dateTime, sdg:isConfirmed some xsd:boolean, sdg:severityLevel some sdg:SeverityLevelKind, sdg:incidentId some xsd:string, sdg:reportedDate some xsd:dateTime, sdg:incidentDate some xsd:dateTime, sdg:location some xsd:string, sdg:severityRating some xsd:integer, sdg:status some sdg:StatusKind, sdg:riskLevel some sdg:RiskLevelKind, sdg:reportedVia exactly 1 sdg:Hotline, sdg:involvesVictim min 2 sdg:Beneficiary, sdg:investigatedBy max 1 sdg:ServiceOrganization, sdg:involves min 1 sdg:Student, sdg:involves max 1 sdg:StaffMember, sdg:classifiedAs min 1 sdg:AbuseType, sdg:referencedIn exactly 1 sdg:IncidentReport

Class: sdg:Beneficiary
    Annotations: rdfs:label "Beneficiary", iao:0000115 "A real entity representing an individual or family receiving assistance, information, or protection from social services, hotlines, or incident interventions."
    SubClassOf: bfo:0000002, sdg:beneficiaryIdentifier some xsd:string, sdg:primaryLanguage some sdg:PrimaryLanguageKind, sdg:immigrationStatus some xsd:string, sdg:needsAssistance some xsd:boolean, sdg:requiresInterpreter some xsd:boolean, sdg:beneficiaryId some xsd:string, sdg:fullName some xsd:string, sdg:relationship some sdg:RelationshipKind, sdg:ssn some xsd:string, sdg:dateOfBirth some xsd:date, sdg:address some xsd:string, sdg:telephone some xsd:string, sdg:emailAddress some xsd:string, sdg:beneficiaryType some xsd:string, sdg:age some xsd:integer, sdg:gender some sdg:GenderKind, sdg:location some xsd:string, sdg:vulnerabilityStatus some sdg:VulnerabilityStatusKind, sdg:householdId some xsd:string, sdg:receivesServiceFrom min 2 sdg:SocialServiceResource, sdg:contactedByVia max 1 sdg:Hotline, sdg:involvedIn max 1 sdg:Incident, sdg:designatedBy exactly 1 sdg:RetirementPlanMember, sdg:receivesFrom exactly 1 sdg:BenefitOption, sdg:receivesSupportFrom some sdg:Program, sdg:participatesIn__escalated some sdg:Activity, sdg:belongsHouseholdTo exactly 1 sdg:Household

Class: sdg:AccessChannel
    Annotations: rdfs:label "Access Channel", iao:0000115 "A made thing or record representing a digital or physical medium through which beneficiaries access information about or apply for social services."
    SubClassOf: cco:ont00000995, sdg:channelIdentifier some xsd:string, sdg:channelType some sdg:ChannelTypeKind, sdg:urlOrEndpoint some xsd:string, sdg:supportsMultilingual some xsd:boolean, sdg:isFree some xsd:boolean, sdg:providesAccessTo min 2 sdg:SocialServiceResource, sdg:maintainedBy exactly 1 sdg:ServiceOrganization

Class: sdg:ComputationalMaterialRecord
    Annotations: rdfs:label "Computational Material Record", iao:0000115 "A digital record representing the input and output data generated by a computational materials science program for a specific material system."
    SubClassOf: cco:ont00000995, sdg:recordId some xsd:string, sdg:creationDate some xsd:dateTime, sdg:fileSizeBytes some xsd:integer, sdg:fileFormat some sdg:FileFormatKind, sdg:status some sdg:StatusKind, sdg:checksum some xsd:string, sdg:generatedBy exactly 1 sdg:ComputationalCode, sdg:describes exactly 1 sdg:MaterialSystem, sdg:processedBy some sdg:ParsingPipeline

Class: sdg:ComputationalCode
    Annotations: rdfs:label "Computational Code", iao:0000115 "A high-quality computational materials science software program used to generate input and output files for materials discovery."
    SubClassOf: cco:ont00000995, sdg:codeId some xsd:string, sdg:codeName some xsd:string, sdg:version some xsd:string, sdg:licenseType some xsd:string, sdg:developerGroup some xsd:string, sdg:produces min 2 sdg:ComputationalMaterialRecord, sdg:runsOn some sdg:HighPerformanceComputerCenter

Class: sdg:MaterialSystem
    Annotations: rdfs:label "Material System", iao:0000115 "A specific combination of chemical elements and structural configurations that is the subject of computational analysis."
    SubClassOf: sdg:System, sdg:systemId some xsd:string, sdg:chemicalFormula some xsd:string, sdg:crystalSystem some xsd:string, sdg:spaceGroupNumber some xsd:integer, sdg:latticeParameterA some xsd:decimal, sdg:latticeParameterB some xsd:decimal, sdg:latticeParameterC some xsd:decimal, sdg:formationEnergy some xsd:decimal, sdg:hasRecord min 2 sdg:ComputationalMaterialRecord, sdg:exhibitsProperty some sdg:MaterialProperty

Class: sdg:MaterialProperty
    Annotations: rdfs:label "Material Property", iao:0000115 "A measurable or computable characteristic of a material system, such as electronic band gap or thermal conductivity."
    SubClassOf: bfo:0000016, sdg:propertyId some xsd:string, sdg:propertyName some xsd:string, sdg:numericValue some xsd:decimal, sdg:unitOfMeasure some sdg:UnitOfMeasureKind, sdg:confidenceInterval some xsd:decimal, sdg:measurementMethod some xsd:string, sdg:propertyType some sdg:PropertyTypeKind, sdg:measuredValue some xsd:decimal, sdg:conditionLocation some xsd:string, sdg:moistureContent some xsd:decimal, sdg:characterizes exactly 1 sdg:MaterialSystem, sdg:derivedFrom some sdg:ComputationalMaterialRecord, sdg:measuredFor exactly 1 sdg:ProductSpecification, sdg:appliesTo some sdg:ProductVariant

Class: sdg:ParsingPipeline
    Annotations: rdfs:label "Parsing Pipeline", iao:0000115 "A computational process that converts inhomogeneous input and output files into a code-independent database format for analytics."
    SubClassOf: bfo:0000015, sdg:pipelineId some xsd:string, sdg:pipelineName some xsd:string, sdg:startDateTime some xsd:dateTime, sdg:endDateTime some xsd:dateTime, sdg:status some sdg:StatusKind, sdg:recordsProcessed some xsd:integer, sdg:processes min 2 sdg:ComputationalMaterialRecord, sdg:runsOn exactly 1 sdg:HighPerformanceComputerCenter, sdg:produces exactly 1 sdg:ParsedDataStore

Class: sdg:HighPerformanceComputerCenter
    Annotations: rdfs:label "High-Performance Computer Center", iao:0000115 "A physical or virtual facility providing the computational infrastructure for running materials science simulations and analytics."
    SubClassOf: bfo:0000004, sdg:centerId some xsd:string, sdg:centerName some xsd:string, sdg:location some xsd:string, sdg:totalComputeNodes some xsd:integer, sdg:peakPerformanceFlops some xsd:decimal, sdg:operationalStatus some sdg:OperationalStatusKind, sdg:hosts some sdg:ComputationalCode, sdg:executes min 2 sdg:ParsingPipeline, sdg:supports some sdg:BigDataAnalyticsTool

Class: sdg:BigDataAnalyticsTool
    Annotations: rdfs:label "Big Data Analytics Tool", iao:0000115 "A computational process employing data mining, statistical analysis, or machine learning to extract hidden structures, correlations, and novel materials from the materials data pool."
    SubClassOf: bfo:0000015, sdg:toolId some xsd:string, sdg:toolName some xsd:string, sdg:algorithmType some sdg:AlgorithmTypeKind, sdg:startDate some xsd:dateTime, sdg:endDate some xsd:dateTime, sdg:status some sdg:StatusKind, sdg:novelMaterialsDiscovered some xsd:integer, sdg:analyzes exactly 1 sdg:ParsedDataStore, sdg:discovers min 2 sdg:MaterialSystem, sdg:runsOn some sdg:HighPerformanceComputerCenter

Class: sdg:ParsedDataStore
    Annotations: rdfs:label "Parsed Data Store", iao:0000115 "A code-independent database structure containing normalized and converted materials data ready for analytics and visualization."
    SubClassOf: sdg:DataEntity, sdg:storeId some xsd:string, sdg:storeName some xsd:string, sdg:totalRecords some xsd:integer, sdg:lastUpdated some xsd:dateTime, sdg:storageSizeGB some xsd:decimal, sdg:dataIntegrityStatus some xsd:string, sdg:verificationStatus some sdg:VerificationStatusKind, sdg:contains min 2 sdg:ComputationalMaterialRecord, sdg:feeds some sdg:BigDataAnalyticsTool, sdg:supports some sdg:VisualizationService

Class: sdg:VisualizationService
    Annotations: rdfs:label "Visualization Service", iao:0000115 "A centralized computational service enabling users to interactively perform data visualization on materials data without local hardware dependencies."
    SubClassOf: bfo:0000015, sdg:serviceId some xsd:string, sdg:serviceName some xsd:string, sdg:endpointUrl some xsd:string, sdg:uptimePercentage some xsd:decimal, sdg:maxConcurrentUsers some xsd:integer, sdg:activeStatus some xsd:boolean, sdg:visualizes exactly 1 sdg:ParsedDataStore, sdg:runsOn exactly 1 sdg:HighPerformanceComputerCenter

Class: sdg:TrafficControlSign
    Annotations: rdfs:label "Traffic Control Sign", iao:0000115 "A physical or digital device placed or erected by the state or city to regulate, warn, or guide traffic participants."
    SubClassOf: cco:ont00000995, sdg:signIdentifier some xsd:string, sdg:signType some xsd:string, sdg:installationDate some xsd:date, sdg:lastInspectionDate some xsd:date, sdg:complianceStatus some sdg:ComplianceStatusKind, sdg:manualRevision some xsd:string, sdg:locatedOn exactly 1 sdg:StreetSegment, sdg:regulates some sdg:TrafficRule

Class: sdg:TrafficRule
    Annotations: rdfs:label "Traffic Rule", iao:0000115 "A legally binding regulation governing the operation of vehicles and pedestrians within the municipal jurisdiction."
    SubClassOf: bfo:0000015, sdg:ruleCode some xsd:string, sdg:ruleDescription some xsd:string, sdg:enforcementLevel some sdg:EnforcementLevelKind, sdg:effectiveDate some xsd:date, sdg:repealDate some xsd:date, sdg:governedBy exactly 1 sdg:MunicipalCode, sdg:appliesTo some sdg:VehicleClass
    HasKey: sdg:ruleCode

Class: sdg:StreetSegment
    Annotations: rdfs:label "Street Segment", iao:0000115 "A defined portion of a roadway within the municipal limits, characterized by its physical boundaries and traffic control features."
    SubClassOf: bfo:0000015, sdg:segmentId some xsd:string, sdg:streetName some xsd:string, sdg:laneCount some xsd:integer, sdg:isOneWay some xsd:boolean, sdg:isClosedForRepairs some xsd:boolean, sdg:surfaceType some sdg:SurfaceTypeKind, sdg:contains some sdg:TrafficControlSign, sdg:hasTrafficRule some sdg:TrafficRule

Class: sdg:VehicleClass
    Annotations: rdfs:label "Vehicle Class", iao:0000115 "A category of motor vehicles defined by their operational characteristics and regulatory requirements."
    SubClassOf: cco:ont00000995, sdg:vehicleClassCode some xsd:string, sdg:classDescription some xsd:string, sdg:requiresMuffler some xsd:boolean, sdg:requiresBrakes some xsd:boolean, sdg:requiresLights some xsd:boolean, sdg:subjectTo some sdg:TrafficRule, sdg:operatedBy some sdg:VehicleOperator
    HasKey: sdg:vehicleClassCode

Class: sdg:VehicleOperator
    Annotations: rdfs:label "Vehicle Operator", iao:0000115 "A person who operates a motor vehicle within the municipal jurisdiction."
    SubClassOf: sdg:Entity, sdg:operatorId some xsd:string, sdg:licenseNumber some xsd:string, sdg:licenseStatus some sdg:LicenseStatusKind, sdg:lastViolationDate some xsd:date, sdg:operatorStatus some xsd:string, sdg:fullName some xsd:string, sdg:driversLicenseNumber some xsd:string, sdg:operatorSignature some xsd:string, sdg:operates exactly 1 sdg:VehicleClass, sdg:violates some sdg:TrafficRule, sdg:operatesEntry exactly 1 sdg:ParadeEntry, sdg:isMemberOf exactly 1 sdg:ParticipatingOrganization

Class: sdg:MunicipalCode
    Annotations: rdfs:label "Municipal Code", iao:0000115 "The codified set of laws and regulations enacted by the municipality governing traffic and parking."
    SubClassOf: cco:ont00000958, sdg:codeTitle some xsd:string, sdg:codeChapter some xsd:string, sdg:codeSection some xsd:string, sdg:enactmentDate some xsd:date, sdg:amendmentDate some xsd:date, sdg:contains some sdg:TrafficRule

Class: sdg:StaffPosition
    Annotations: rdfs:label "Staff Position", iao:0000115 "A designated role within an organization that specifies responsibilities, required qualifications, and reporting relationships for a specific job function."
    SubClassOf: cco:ont00000995, sdg:positionId some xsd:string, sdg:title some xsd:string, sdg:department some xsd:string, sdg:supervisorTitle some xsd:string, sdg:educationRequired some xsd:string, sdg:experienceRequired some xsd:string, sdg:status some sdg:StatusKind, sdg:heldBy some sdg:StaffMember, sdg:reportsTo max 1 sdg:StaffPosition

Class: sdg:StaffMember
    Annotations: rdfs:label "Staff Member", iao:0000115 "A human being employed by the organization who performs duties associated with one or more staff positions."
    SubClassOf: sdg:staffId some xsd:string, sdg:firstName some xsd:string, sdg:lastName some xsd:string, sdg:hireDate some xsd:date, sdg:employmentStatus some sdg:EmploymentStatusKind, sdg:contactEmail some xsd:string, sdg:jobTitle some xsd:string, sdg:fullName some xsd:string, sdg:isYouth some xsd:boolean, sdg:isTrainer some xsd:boolean, sdg:isModerator some xsd:boolean, sdg:roleDetail some sdg:RoleKind, sdg:department some xsd:string, sdg:isQualified some xsd:boolean, sdg:employer some sdg:EmployerKind, sdg:trainingCompletionDate some xsd:date, sdg:performanceRating some xsd:decimal, sdg:motivationLevel some sdg:MotivationLevelKind, sdg:yearsOfExperience some xsd:integer, sdg:dateOfCommencement some xsd:date, sdg:emailAddress some xsd:string, sdg:cybersafetyTrained some xsd:boolean, sdg:roleTitle some sdg:RoleTitleKind, sdg:educationLevel some sdg:EducationLevelKind, sdg:employmentType some sdg:EmploymentTypeKind, sdg:salary some xsd:decimal, sdg:isSupervisor some xsd:boolean, sdg:lastTrainingDate some xsd:date, sdg:backgroundCheckStatus some xsd:string, sdg:accessLevel some sdg:AccessLevelKind, sdg:staffName some xsd:string, sdg:specialism some xsd:string, sdg:yearsOfService some xsd:integer, sdg:workloadWellbeing some xsd:string, sdg:holdsPosition some sdg:StaffPosition, sdg:assignedToDepartment exactly 1 sdg:Department, sdg:employedBy exactly 1 sdg:YouthOrganization, sdg:facilitates some sdg:ConferenceWorkshop, sdg:moderates some sdg:PanelDiscussion, sdg:receivesTraining some sdg:StaffProfessionalDevelopment, sdg:completesTraining some sdg:StaffTrainingModule, sdg:supervisesStudent some sdg:Student, sdg:reportsSafetyIssue some sdg:HealthSafetyRiskAssessment, sdg:trainedIn some sdg:TrainingProgram, sdg:worksFor exactly 1 sdg:FundingAgency, sdg:supervises some sdg:BeneficiaryGroup, sdg:participatesIn__escalated some sdg:ResearchStudy, sdg:holdsAccount some sdg:SocialMediaAccount, sdg:worksAt exactly 1 sdg:EducationalInstitution, sdg:subjectToCodeOfConduct exactly 1 sdg:TeachingCouncilCode, sdg:reportsIncident some sdg:BullyingIncident, sdg:providesSupportTo some sdg:Student, sdg:assignedToClassroom max 1 sdg:Classroom, sdg:worksAtFacility exactly 1 sdg:WasteProcessingFacility, sdg:reportsTo max 1 sdg:StaffMember, sdg:managesSystem max 1 sdg:IntegratedWasteSystem, sdg:worksFor exactly 1 sdg:Organization, sdg:supervisedBy exactly 1 sdg:ExecutiveDirector, sdg:assignedTo exactly 1 sdg:Facility, sdg:manages some sdg:Event, sdg:employedBy exactly 1 sdg:School, sdg:investigates some sdg:Incident, sdg:trainedIn min 1 sdg:SafeguardingProtocol, sdg:accesses some sdg:VideoSurveillanceData, sdg:investigates some sdg:SecurityIncident, sdg:employedAt exactly 1 sdg:SchoolSite, sdg:delivers some sdg:CurriculumProgramme, sdg:supports some sdg:StudentEnrolment, sdg:supports some sdg:StudentOutcome

Class: sdg:PatientAppointment
    Annotations: rdfs:label "Patient Appointment", iao:0000115 "A scheduled interaction between a patient and a healthcare provider at a specific time and location for medical consultation or service."
    SubClassOf: sdg:HealthcareEntity, sdg:appointmentId some xsd:string, sdg:scheduledDateTime some xsd:dateTime, sdg:status some sdg:StatusKind, sdg:providerId some xsd:string, sdg:patientId some xsd:string, sdg:serviceType some sdg:ServiceTypeKind, sdg:reminderSent some xsd:boolean, sdg:confirmedBy some sdg:StaffMember, sdg:relatedToPatient exactly 1 sdg:PatientRecord

Class: sdg:PatientRecord
    Annotations: rdfs:label "Patient Record", iao:0000115 "A structured document containing demographic, insurance, and medical history data for an individual receiving care."
    SubClassOf: sdg:Record, sdg:recordId some xsd:string, sdg:dateOfBirth some xsd:date, sdg:insuranceProvider some xsd:string, sdg:policyNumber some xsd:string, sdg:lastUpdated some xsd:dateTime, sdg:hipaaCompliant some xsd:boolean, sdg:consentStatus some sdg:ConsentStatusKind, sdg:patientId some xsd:string, sdg:diagnosisCode some xsd:string, sdg:treatmentDate some xsd:dateTime, sdg:patientName some xsd:string, sdg:dateOfService some xsd:dateTime, sdg:recordStatus some sdg:RecordStatusKind, sdg:accessLevel some sdg:AccessLevelKind, sdg:hasAppointment min 2 sdg:PatientAppointment, sdg:hasPaymentRecord some sdg:PaymentTransaction, sdg:partOfRegistry exactly 1 sdg:HealthRegistry, sdg:linkedToPatient exactly 1 sdg:Patient, sdg:hasRecord exactly 1 sdg:Patient, sdg:contains some sdg:BillingRecord, sdg:contains some sdg:TreatmentEvent
    HasKey: sdg:recordId

Class: sdg:PaymentTransaction
    Annotations: rdfs:label "Payment Transaction", iao:0000115 "A financial exchange event recording the receipt of payment from a patient or insurance company for services rendered."
    SubClassOf: bfo:0000015, sdg:transactionId some xsd:string, sdg:amount some xsd:decimal, sdg:transactionDate some xsd:dateTime, sdg:paymentMethod some sdg:PaymentMethodKind, sdg:status some sdg:StatusKind, sdg:processedByDetail some xsd:string, sdg:linkedToPatient exactly 1 sdg:PatientRecord, sdg:linkedToAppointment some sdg:PatientAppointment

Class: sdg:InventoryItem
    Annotations: rdfs:label "Inventory Item", iao:0000115 "A physical good or supply managed within the office, such as medical contacts, office supplies, or cleaning materials."
    SubClassOf: cco:ont00000995, sdg:itemId some xsd:string, sdg:itemName some xsd:string, sdg:category some sdg:CategoryKind, sdg:quantityOnHand some xsd:integer, sdg:reorderLevel some xsd:integer, sdg:lastRestocked some xsd:dateTime, sdg:sku some xsd:string, sdg:itemType some sdg:ItemTypeKind, sdg:unitCost some xsd:decimal, sdg:locationCode some xsd:string, sdg:status some sdg:StatusKind, sdg:managedBy some sdg:StaffMember, sdg:usedInAppointment some sdg:PatientAppointment, sdg:shippedVia some sdg:ShipmentRecord

Class: sdg:RetreatProgram
    Annotations: rdfs:label "Retreat Program", iao:0000115 "A designed event or program offering spiritual instruction and community immersion."
    SubClassOf: cco:ont00000995, sdg:programIdentifier some xsd:string, sdg:programName some xsd:string, sdg:startDate some xsd:dateTime, sdg:endDate some xsd:dateTime, sdg:location some xsd:string, sdg:isAnnual some xsd:boolean, sdg:hostedBy exactly 1 sdg:SpiritualOrganization, sdg:requiresDonation some sdg:Donation

Class: sdg:Donation
    Annotations: rdfs:label "Donation", iao:0000115 "A voluntary transfer of resources or funds to support a spiritual mission or organization."
    SubClassOf: cco:ont00000995, sdg:donationId some xsd:string, sdg:amount some xsd:decimal, sdg:currencyCode some xsd:string, sdg:donationDate some xsd:dateTime, sdg:status some sdg:StatusKind, sdg:isAnonymous some xsd:boolean, sdg:donationIdentifier some xsd:string, sdg:isMemorial some xsd:boolean, sdg:isHonor some xsd:boolean, sdg:isDeferred some xsd:boolean, sdg:givenBy exactly 1 sdg:SpiritualSeeker, sdg:supports exactly 1 sdg:SpiritualOrganization, sdg:funds some sdg:RetreatProgram, sdg:madeBy exactly 1 sdg:Donor, sdg:directedTo exactly 1 sdg:Program, sdg:honors max 1 sdg:Honoree, sdg:notifies max 1 sdg:ContactRecipient, sdg:directedTo some sdg:Fund

Class: sdg:SpiritualSeeker
    Annotations: rdfs:label "Spiritual Seeker", iao:0000115 "A person engaged in spiritual practice, seeking connection with the Divine through generosity and self-giving."
    SubClassOf: sdg:TheologicalConcept, sdg:seekerId some xsd:string, sdg:firstName some xsd:string, sdg:lastName some xsd:string, sdg:emailAddress some xsd:string, sdg:memberSince some xsd:dateTime, sdg:isAnonymous some xsd:boolean, sdg:makesDonation some sdg:Donation, sdg:attends some sdg:RetreatProgram, sdg:commitsTo exactly 1 sdg:SpiritualPath
    HasKey: sdg:seekerId

Class: sdg:SpiritualPath
    Annotations: rdfs:label "Spiritual Path", iao:0000115 "A structured practice or tradition focused on self-giving (kenosis) and connection with the Divine."
    SubClassOf: bfo:0000015, sdg:pathId some xsd:string, sdg:pathName some xsd:string, sdg:corePrinciple some xsd:string, sdg:originTradition some xsd:string, sdg:isUniversal some xsd:boolean, sdg:practicedBy some sdg:SpiritualSeeker, sdg:instructedAt some sdg:RetreatProgram

Class: sdg:SpiritualOrganization
    Annotations: rdfs:label "Spiritual Organization", iao:0000115 "An entity or community dedicated to spiritual practice, teaching, and community support."
    SubClassOf: bfo:0000040, sdg:orgId some xsd:string, sdg:orgName some xsd:string, sdg:foundingDate some xsd:date, sdg:missionStatement some xsd:string, sdg:isNonProfit some xsd:boolean, sdg:hosts some sdg:RetreatProgram, sdg:receivesDonations some sdg:Donation, sdg:supports some sdg:SpiritualSeeker

Class: sdg:InternationalEnvironmentalConference
    Annotations: rdfs:label "International Environmental Conference", iao:0000115 "A formal global or regional gathering of states, NGOs, and civil society to negotiate and adopt environmental principles, declarations, and action plans."
    SubClassOf: bfo:0000015, sdg:conferenceId some xsd:string, sdg:startDate some xsd:dateTime, sdg:endDate some xsd:dateTime, sdg:hostCity some xsd:string, sdg:hostCountry some xsd:string, sdg:declarationTitle some xsd:string, sdg:actionPlanTitle some xsd:string, sdg:totalRecommendations some xsd:integer, sdg:hasNGOForum some xsd:boolean, sdg:produced max 1 sdg:EnvironmentalDeclaration, sdg:produced max 1 sdg:ActionPlan, sdg:created max 1 sdg:InternationalEnvironmentalInstitution, sdg:preceded max 1 sdg:InternationalEnvironmentalConference

Class: sdg:EnvironmentalDeclaration
    Annotations: rdfs:label "Environmental Declaration", iao:0000115 "A formal document establishing principles of behavior and responsibility to serve as the basis for future legally binding multilateral accords."
    SubClassOf: cco:ont00000958, sdg:declarationId some xsd:string, sdg:title some xsd:string, sdg:adoptionDate some xsd:dateTime, sdg:totalPrinciples some xsd:integer, sdg:issuingConference some xsd:string, sdg:adoptedAt exactly 1 sdg:InternationalEnvironmentalConference

Class: sdg:ActionPlan
    Annotations: rdfs:label "Action Plan", iao:0000115 "A comprehensive set of specific recommendations in areas of environmental assessment, management, and institutional measures."
    SubClassOf: cco:ont00000958, sdg:planId some xsd:string, sdg:title some xsd:string, sdg:totalRecommendations some xsd:integer, sdg:adoptionDate some xsd:dateTime, sdg:adoptedAt exactly 1 sdg:InternationalEnvironmentalConference

Class: sdg:InternationalEnvironmentalInstitution
    Annotations: rdfs:label "International Environmental Institution", iao:0000115 "A formal organization or agency established to monitor, regulate, or promote environmental protection and sustainable development."
    SubClassOf: bfo:0000015, sdg:institutionId some xsd:string, sdg:name some sdg:NameKind, sdg:headquartersCity some xsd:string, sdg:headquartersCountry some xsd:string, sdg:establishmentDate some xsd:date, sdg:status some sdg:StatusKind, sdg:createdBy exactly 1 sdg:InternationalEnvironmentalConference, sdg:promotes some sdg:MultilateralEnvironmentalAgreement
    HasKey: sdg:institutionId

Class: sdg:MultilateralEnvironmentalAgreement
    Annotations: rdfs:label "Multilateral Environmental Agreement", iao:0000115 "A legally binding international treaty or accord addressing transboundary and global pollution threats."
    SubClassOf: cco:ont00000958, sdg:agreementId some xsd:string, sdg:title some xsd:string, sdg:entryIntoForceDate some xsd:dateTime, sdg:status some sdg:StatusKind, sdg:scope some sdg:ScopeKind, sdg:informedBy some sdg:EnvironmentalDeclaration, sdg:monitoredBy some sdg:InternationalEnvironmentalInstitution

Class: sdg:EnvironmentalPolicyInstrument
    Annotations: rdfs:label "Environmental Policy Instrument", iao:0000115 "A regulatory mechanism, market-based tool, or institutional expectation used to influence state actions and reduce environmental degradation."
    SubClassOf: bfo:0000015, sdg:instrumentId some xsd:string, sdg:name some sdg:NameKind, sdg:type some sdg:TypeKind, sdg:implementationDate some xsd:dateTime, sdg:targetSector some xsd:string, sdg:derivedFrom some sdg:MultilateralEnvironmentalAgreement, sdg:implementedBy some sdg:State

Class: sdg:State
    Annotations: rdfs:label "State", iao:0000115 "A sovereign political entity with jurisdiction over a defined territory and population, participating in international environmental governance."
    SubClassOf: sdg:stateCode some xsd:string, sdg:name some sdg:NameKind, sdg:developmentStatus some sdg:DevelopmentStatusKind, sdg:primaryEnvironmentalConcern some sdg:PrimaryEnvironmentalConcernKind, sdg:stateName some xsd:string, sdg:governmentType some xsd:string, sdg:hrcMembershipStatus some xsd:string, sdg:lastReviewDate some xsd:date, sdg:population some xsd:integer, sdg:gdp some xsd:decimal, sdg:pesticideBanStatus some xsd:boolean, sdg:happyPlanetRank some xsd:integer, sdg:stateId some xsd:string, sdg:stateIndex some xsd:integer, sdg:isInitialState some xsd:boolean, sdg:satisfiedAtoms some xsd:string, sdg:timestamp some xsd:dateTime, sdg:implements some sdg:EnvironmentalPolicyInstrument, sdg:partyTo some sdg:MultilateralEnvironmentalAgreement, sdg:receives some sdg:FinancialAssistance, sdg:undergoesReview some sdg:UPRReviewCycle, sdg:implementsRecommendation min 2 sdg:UPRRecommendation, sdg:hasVulnerablePopulation some sdg:VulnerableGroup, sdg:hasGovernor exactly 1 sdg:Governor, sdg:subjectTo some sdg:LegislativeAct, sdg:rankedIn some sdg:HealthIndex, sdg:partOf__escalated exactly 1 sdg:PhysicalTransitionSystem, sdg:transitionsTo some sdg:State, sdg:satisfies some sdg:Norm

Class: sdg:FinancialAssistance
    Annotations: rdfs:label "Financial Assistance", iao:0000115 "Monetary contributions from industrialized states to developing countries to fund pollution control and sustainable development projects."
    SubClassOf: sdg:FinancialEntity, sdg:assistanceId some xsd:string, sdg:amount some xsd:decimal, sdg:currency some xsd:string, sdg:disbursementDate some xsd:dateTime, sdg:purpose some sdg:PurposeKind, sdg:fundingPurpose some xsd:string, sdg:providedBy exactly 1 sdg:State, sdg:receivedBy exactly 1 sdg:State, sdg:funds some sdg:EnvironmentalPolicyInstrument
    HasKey: sdg:assistanceId

Class: sdg:Researcher
    Annotations: rdfs:label "Young Researcher", iao:0000115 "A person holding a PhD degree awarded within the last six years who participates in the EYE project's activities."
    SubClassOf: sdg:researcherId some xsd:string, sdg:fullName some xsd:string, sdg:phdAwardDate some xsd:date, sdg:institution some xsd:string, sdg:discipline some xsd:string, sdg:isSelected some xsd:boolean, sdg:roleDetail some sdg:RoleKind, sdg:affiliation some sdg:AffiliationKind, sdg:credentials some xsd:string, sdg:researcherIdentifier some xsd:string, sdg:fullLegalName some xsd:string, sdg:primaryDegree some xsd:string, sdg:secondaryDegree some xsd:string, sdg:currentInstitution some xsd:string, sdg:currentTitle some xsd:string, sdg:researchFocus some xsd:string, sdg:currentAffiliation some xsd:string, sdg:emailAddress some xsd:string, sdg:isSelectedForFunding some xsd:boolean, sdg:nationality some xsd:string, sdg:careerStage some xsd:string, sdg:gender some sdg:GenderKind, sdg:sector some sdg:SectorKind, sdg:primaryField some xsd:string, sdg:department some xsd:string, sdg:professionalTitle some xsd:string, sdg:militaryRank some xsd:string, sdg:yearsOfExperience some xsd:integer, sdg:specialization some sdg:SpecializationKind, sdg:participatesIn__escalated min 2 sdg:Event, sdg:collaboratesWith some sdg:Researcher, sdg:submitsTo max 1 sdg:ProjectProposal, sdg:leadsStudy some sdg:ClinicalStudy, sdg:receivedAward some sdg:AcademicAward, sdg:holdsLeadershipRole some sdg:LeadershipPosition, sdg:affiliatedWith exactly 1 sdg:AcademicInstitution, sdg:participatedIn some sdg:Event, sdg:belongsTo exactly 1 sdg:ResearchTeam, sdg:submittedIdeaTo some sdg:ResearchIdea, sdg:residesIn exactly 1 sdg:GeographicLocation, sdg:participatedIn some sdg:SurveyResponse, sdg:participatedIn some sdg:TelephoneInterview, sdg:affiliatedWith exactly 1 sdg:Institution, sdg:conducts min 2 sdg:ResearchProject, sdg:authored min 2 sdg:Publication, sdg:awarded some sdg:ResearchAward, sdg:affiliatedWith some sdg:ResearchOrganization, sdg:mentors some sdg:Researcher, sdg:conductsResearch some sdg:ResearchProject
    HasKey: sdg:researcherId

Class: sdg:Event
    Annotations: rdfs:label "EYE Activity Event", iao:0000115 "A regional or European brainstorming, networking, or training event organized under the EYE project."
    SubClassOf: bfo:0000015, sdg:eventId some xsd:string, sdg:eventName some xsd:string, sdg:eventType some sdg:EventTypeKind, sdg:startDate some xsd:dateTime, sdg:endDate some xsd:dateTime, sdg:region some sdg:RegionKind, sdg:status some sdg:StatusKind, sdg:locationRegion some xsd:string, sdg:isFunded some xsd:boolean, sdg:locationName some xsd:string, sdg:estimatedDate some xsd:date, sdg:expectedAttendance some xsd:integer, sdg:isMinorParticipantEvent some xsd:boolean, sdg:coverageRequested some xsd:string, sdg:eventDate some xsd:dateTime, sdg:isRentalShow some xsd:boolean, sdg:attendeeCount some xsd:integer, sdg:revenueGenerated some xsd:decimal, sdg:date some xsd:dateTime, sdg:minParticipants some xsd:integer, sdg:isSpecialMenu some xsd:boolean, sdg:location some xsd:string, sdg:organizer some xsd:string, sdg:attendanceCount some xsd:integer, sdg:eventIdentifier some xsd:string, sdg:eventDateTime some xsd:dateTime, sdg:participants some xsd:string, sdg:description some xsd:string, sdg:attendedBy min 2 sdg:Researcher, sdg:followedBy max 1 sdg:Event, sdg:supports some sdg:ProjectProposal, sdg:hostedBy exactly 1 sdg:PartnerOrganization, sdg:attractsParticipants min 2 sdg:Researcher, sdg:focusesOnThemes some sdg:ResearchTheme, sdg:organizedBy exactly 1 sdg:Organization, sdg:coveredBy some sdg:CoveragePolicy, sdg:hasParticipants__escalated min 2 sdg:Participant, sdg:hostedAt exactly 1 sdg:Facility, sdg:bookedBy exactly 1 sdg:StaffMember, sdg:partOf__escalated some sdg:Program, sdg:hostedBy exactly 1 sdg:Restaurant, sdg:featuresWine some sdg:Wine, sdg:featuresWinemaker some sdg:Person, sdg:organizedBy exactly 1 sdg:ALPARC, sdg:attendedBy some sdg:ManagementUnit, sdg:attendedBy some sdg:ProjectLeader, sdg:involvedCelestialBody some sdg:CelestialBody, sdg:observedBy some sdg:Observer

Class: sdg:ProjectProposal
    Annotations: rdfs:label "FET Project Proposal", iao:0000115 "A substantive research proposal developed by young researchers to participate in Horizon 2020 funding."
    SubClassOf: cco:ont00000995, sdg:proposalId some xsd:string, sdg:title some xsd:string, sdg:thematicArea some xsd:string, sdg:fundingProgram some xsd:string, sdg:status some sdg:StatusKind, sdg:submissionDate some xsd:dateTime, sdg:createdBy min 2 sdg:Researcher, sdg:derivedFrom some sdg:Event, sdg:addresses some sdg:SocietalChallenge

Class: sdg:SocietalChallenge
    Annotations: rdfs:label "Horizon 2020 Societal Challenge", iao:0000115 "A broad societal problem or area of focus targeted by Horizon 2020 funding programs."
