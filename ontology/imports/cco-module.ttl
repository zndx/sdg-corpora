<https://www.commoncoreontologies.org/ont00000243> a owl:Class ;
    rdfs:label "Heat Sink"@en ;
    rdfs:subClassOf <https://www.commoncoreontologies.org/ont00000995> ;
    skos:definition "A Material Artifact that is designed to regulate the temperature of a computer by the passive transfer of heat away from other components in the computer."@en .

<https://www.commoncoreontologies.org/ont00000244> a owl:Class ;
    rdfs:label "Fragmentation Artifact Function"@en ;
    rdfs:subClassOf <https://www.commoncoreontologies.org/ont00001153> ;
    skos:definition "A Damaging Artifact Function that is realized in a process in which the structural integrity of an entity is impaired because of a detonation which causes fragmentation."@en .

<https://www.commoncoreontologies.org/ont00000245> a owl:Class ;
    rdfs:label "Petroleum Manufacturing Facility"@en ;
    rdfs:subClassOf <https://www.commoncoreontologies.org/ont00000782> ;
    skos:definition "A Factory that is designed to manufacture petroleum-based products."@en .

<https://www.commoncoreontologies.org/ont00000248> a owl:Class ;
    rdfs:label "Chemical Manufacturing Facility"@en ;
    rdfs:subClassOf <https://www.commoncoreontologies.org/ont00000782> ;
    skos:definition "A Factory that is designed to manufacture or process chemicals."@en .

<https://www.commoncoreontologies.org/ont00000249> a owl:Class ;
    rdfs:label "Shaft"@en ;
    rdfs:subClassOf <https://www.commoncoreontologies.org/ont00000995> ;
    skos:definition "A Material Artifact that is designed to rotate and transmit Torque, Power, or Rotational Motion from one machine element to another."@en .

<https://www.commoncoreontologies.org/ont00000251> a owl:Class ;
    rdfs:label "Continent"@en ;
    rdfs:subClassOf <https://www.commoncoreontologies.org/ont00000472> ;
    skos:definition "A Geospatial Region that is bounded by any of the Earth's main continuous expanses of land."@en .

<https://www.commoncoreontologies.org/ont00000257> a owl:Class ;
    rdfs:label "Radiopaque"@en ;
    rdfs:subClassOf <https://www.commoncoreontologies.org/ont00000620> ;
    skos:definition "A Radiopacity that inheres in a bearer in virtue of its capacity to prevent most X-rays from passing through it."@en .

<https://www.commoncoreontologies.org/ont00000259> a owl:Class ;
    rdfs:label "Calendar Month"@en ;
    rdfs:subClassOf <https://www.commoncoreontologies.org/ont00000225> ;
    skos:definition "A Month that begins and ends concurrently with the Days specified by a Calendar System to be the first and last Days of the Month."@en .

<https://www.commoncoreontologies.org/ont00000260> a owl:Class ;
    rdfs:label "Muzzle Blast"@en ;
    rdfs:subClassOf <https://www.commoncoreontologies.org/ont00000675> ;
    skos:definition "A Sound Wave Process that is caused by a projectile being pushed from the barrel of a firearm by an explosive charge."@en .

<https://www.commoncoreontologies.org/ont00000261> a owl:Class ;
    rdfs:label "Gamma Ray Frequency"@en ;
    rdfs:subClassOf <https://www.commoncoreontologies.org/ont00000754> ;
    skos:definition "An Electromagnetic Radiation Frequency of some Electromagnetic Wave that is above 30 exahertz."@en .

<https://www.commoncoreontologies.org/ont00000262> a owl:Class ;
    rdfs:label "Shop"@en ;
    rdfs:subClassOf <https://www.commoncoreontologies.org/ont00001102> ;
    skos:definition "A Commercial Facility designed to sell small lots of goods to consumers."@en .

<https://www.commoncoreontologies.org/ont00000263> a owl:Class ;
    rdfs:label "Clock Time System"@en ;
    rdfs:subClassOf <https://www.commoncoreontologies.org/ont00001328> ;
    skos:definition "A Temporal Reference System that is a convention for keeping and displaying the Time of Day."@en .

<https://www.commoncoreontologies.org/ont00000264> a owl:Class ;
    rdfs:label "Hydraulic Fluid Reservoir"@en ;
    rdfs:subClassOf <https://www.commoncoreontologies.org/ont00000020> ;
    skos:definition "A Container that is designed to store some hydraulic fluid for use in some Hyrdraulic Power Source."@en .

<https://www.commoncoreontologies.org/ont00000265> a owl:Class ;
    rdfs:label "Election"@en ;
    rdfs:subClassOf <https://www.commoncoreontologies.org/ont00001327> ;
    skos:definition "A Social Act by which a population chooses an individual to hold public office."@en .

<https://www.commoncoreontologies.org/ont00000266> a owl:Class ;
    rdfs:label "Hearing Aid"@en ;
    rdfs:subClassOf <https://www.commoncoreontologies.org/ont00001381> ;
    skos:definition "A Medical Artifact that is designed to improve hearing for its user."@en .

<https://www.commoncoreontologies.org/ont00000267> a owl:Class ;
    rdfs:label "Catalyst Artifact Function"@en ;
    rdfs:subClassOf <https://www.commoncoreontologies.org/ont00000791> ;
    skos:definition "A Chemical Reaction Artifact Function that is realized in a process in which the rate of a chemical reaction is increased due to the participation of an additional substance, without that substance being consumed in the reaction."@en .

<https://www.commoncoreontologies.org/ont00000271> a owl:Class ;
    rdfs:label "Underground Mine"@en ;
    rdfs:subClassOf <https://www.commoncoreontologies.org/ont00000639> ;
    skos:definition "A Mine that is designed to support the extraction of materials from the ground using underground tunnels and shafts."@en .

<https://www.commoncoreontologies.org/ont00000272> a owl:Class ;
    rdfs:label "Combustion"@en ;
    rdfs:subClassOf <https://www.commoncoreontologies.org/ont00000007> ;
    skos:definition "A Natural Process in which a Portion of Fuel or other Material Entity is burned."@en .

<https://www.commoncoreontologies.org/ont00000276> a owl:Class ;
    rdfs:label "Solar Calendar System"@en ;
    rdfs:subClassOf <https://www.commoncoreontologies.org/ont00000891> ;
    skos:definition "A Calendar System that is designed to organize and identify dates based on the cycles of an Astronomical Body's Orbit around the Sun."@en .

<https://www.commoncoreontologies.org/ont00000277> a owl:Class ;
    rdfs:label "Nuclear Weapon"@en ;
    rdfs:subClassOf <https://www.commoncoreontologies.org/ont00000445> ;
    skos:definition "A Weapon that is designed to inflict harm, damage, or incapacity by means of a destructive nuclear reaction, either through fission or through a combination of fission and fusion."@en .

<https://www.commoncoreontologies.org/ont00000279> a owl:Class ;
    rdfs:label "Enemy Role"@en ;
    rdfs:subClassOf <https://www.commoncoreontologies.org/ont00000392> ;
    skos:definition "An Allegiance Role that inheres in an Agent by virtue of that Agent having committed offensive Acts or exhibited intent to perform such Acts towards a particular Agent or Group of Agents or has been declared as hostile by some appropriate authority."@en .

<https://www.commoncoreontologies.org/ont00000280> a owl:Class ;
    rdfs:label "Torpedo"@en ;
    rdfs:subClassOf <https://www.commoncoreontologies.org/ont00001124> ;
    skos:definition "A Precision-Guided Missile that is designed to be fired into a body of water, be self-propelled through the water, and carry an explosive payload."@en .

<https://www.commoncoreontologies.org/ont00000281> a owl:Class ;
    rdfs:label "Albedo"@en ;
    rdfs:subClassOf <https://www.commoncoreontologies.org/ont00001137> ;
    skos:definition "A Radiation Reflectivity that inheres in a bearer in virtue of the capacity of its surface to reflect incident electromagnetic radiation of a particular wavelength."@en .

<https://www.commoncoreontologies.org/ont00000282> a owl:Class ;
    rdfs:label "Counterfeit Financial Instrument"@en ;
    rdfs:subClassOf <https://www.commoncoreontologies.org/ont00000719> ;
    skos:definition "A Counterfeit Instrument that is designed to be a fake replica of some legally sanctioned Financial Instrument."@en .

<https://www.commoncoreontologies.org/ont00000283> a owl:Class ;
    rdfs:label "Cylindrical"@en ;
    rdfs:subClassOf <https://www.commoncoreontologies.org/ont00001360> ;
    skos:definition "A Three Dimensional Shape inhering in a bearer in virtue of the bearer having an elongated shape with round bases."@en .

<https://www.commoncoreontologies.org/ont00000284> a owl:Class ;
    rdfs:label "Strength"@en ;
    rdfs:subClassOf <http://purl.obolibrary.org/obo/BFO_0000017> ;
    skos:definition "A Realizable Entity that is realized when its bearer exerts or resists some power, influence, or force."@en .

<https://www.commoncoreontologies.org/ont00000285> a owl:Class ;
    rdfs:label "Emergency Locator Transmitter"@en ;
    rdfs:subClassOf <https://www.commoncoreontologies.org/ont00000269> ;
    skos:definition "A Radio Transmitter that is designed to signal distress and provide positional data for the entity it is located on."@en .

<https://www.commoncoreontologies.org/ont00000286> a owl:Class ;
    rdfs:label "Stasis of Partially Mission Capable Maintenance"@en ;
    rdfs:subClassOf <https://www.commoncoreontologies.org/ont00000100> ;
    skos:definition "A Stasis of Partially Mission Capable during which the participating Continuant is not capable of performing some of its primary functions for the specified Mission due to participating in an Act Of Maintenance."@en .

<https://www.commoncoreontologies.org/ont00000291> a owl:Class ;
    rdfs:label "Act of Decoy Use"@en ;
    rdfs:subClassOf <https://www.commoncoreontologies.org/ont00000566> ;
    skos:definition "An Act of Artifact Employment in which some Agent uses some Decoy."@en .

<https://www.commoncoreontologies.org/ont00000292> a owl:Class ;
    rdfs:label "Artifact Identifier"@en ;
    rdfs:subClassOf <https://www.commoncoreontologies.org/ont00000686> ;
    skos:definition "A Designative Information Content Entity which designates some Material Artifact."@en .

<https://www.commoncoreontologies.org/ont00000295> a owl:Class ;
    rdfs:label "Wetness"@en ;
    rdfs:subClassOf <http://purl.obolibrary.org/obo/BFO_0000019> ;
    skos:definition "A Quality that inheres in a bearer in virtue of the degree to which the bearer is covered by a liquid, typically on a continuum of dry to wet."@en .

<https://www.commoncoreontologies.org/ont00000296> a owl:Class ;
    rdfs:label "Angular Velocity"@en ;
    rdfs:subClassOf <https://www.commoncoreontologies.org/ont00000763> ;
    skos:definition "A Velocity that is characterized by both the angular Speed of an object and the Axis about which the object is Rotating."@en .

<https://www.commoncoreontologies.org/ont00000297> a owl:Class ;
    rdfs:label "Portion of Hydrosphere"@en ;
    rdfs:subClassOf <http://purl.obolibrary.org/obo/BFO_0000024> ;
    skos:definition "A fiat object part of the combined mass of water found on, under, and above the surface of a natural satellite"@en .

<https://www.commoncoreontologies.org/ont00000298> a owl:Class ;
    rdfs:label "Shoulder-Fired Rocket Launcher"@en ;
    rdfs:subClassOf <https://www.commoncoreontologies.org/ont00001173> ;
    skos:definition "A Rocket Launcher that is designed to be small enough to be carried by a single person and fired while supported on the person's shoulder."@en .

<https://www.commoncoreontologies.org/ont00000299> a owl:Class ;
    rdfs:label "Prosthetic Leg"@en ;
    rdfs:subClassOf <https://www.commoncoreontologies.org/ont00000715> ;
    skos:definition "A Prosthesis that is designed to replace a missing leg."@en .

<https://www.commoncoreontologies.org/ont00000301> a owl:Class ;
    rdfs:label "Vehicle Transmission"@en ;
    rdfs:subClassOf <https://www.commoncoreontologies.org/ont00000663> ;
    skos:definition "A Power Transmission Artifact that is designed to vary the output speed and torque in a rotating power transfer system."@en .

<https://www.commoncoreontologies.org/ont00000302> a owl:Class ;
    rdfs:label "Alternating Current Power Source"@en ;
    rdfs:subClassOf <https://www.commoncoreontologies.org/ont00001049> ;
    skos:definition "An Electrical Power Source that is designed to transfer electrical power in the form of alternating current."@en .

<https://www.commoncoreontologies.org/ont00000305> a owl:Class ;
    rdfs:label "Sound Pressure"@en ;
    rdfs:subClassOf <https://www.commoncoreontologies.org/ont00000380> ;
    skos:definition "A Pressure that is caused by a Sound Wave and is a local deviation from the ambient Pressure."@en .

<https://www.commoncoreontologies.org/ont00000306> a owl:Class ;
    rdfs:label "Hinge"@en ;
    rdfs:subClassOf <https://www.commoncoreontologies.org/ont00001370> ;
    skos:definition "A Machine Bearing that is designed to limit the angle of Rotation between two solid objects."@en .

<https://www.commoncoreontologies.org/ont00000307> a owl:Class ;
    rdfs:label "Portion of Food"@en ;
    rdfs:subClassOf <https://www.commoncoreontologies.org/ont00001084> ;
    skos:definition "A Portion of Processed Material that is designed to be consumed and ingested for nutrition or taste."@en .

<https://www.commoncoreontologies.org/ont00000308> a owl:Class ;
    rdfs:label "Act of Military Service"@en ;
    rdfs:subClassOf <https://www.commoncoreontologies.org/ont00001226> ;
    skos:definition "An Act of Employment by an Organization wherein a Person serves as a member of a Military Force, whether voluntarily or by conscription."@en .

<https://www.commoncoreontologies.org/ont00000309> a owl:Class ;
    rdfs:label "Healthcare Artifact Function"@en ;
    rdfs:subClassOf <https://www.commoncoreontologies.org/ont00001301> ;
    skos:definition "A Service Artifact Function that is realized in processes of treating and preventing illness."@en .

<https://www.commoncoreontologies.org/ont00000310> a owl:Class ;
    rdfs:label "Grenade"@en ;
    rdfs:subClassOf <https://www.commoncoreontologies.org/ont00000552> ;
    skos:definition "An Explosive Weapon that is designed to be relatively small and to be thrown by hand."@en .

<https://www.commoncoreontologies.org/ont00000311> a owl:Class ;
    rdfs:label "Filtration Artifact Function"@en ;
    rdfs:subClassOf <https://www.commoncoreontologies.org/ont00001999> ;
    skos:definition "A Filter Function that is realized in a process in which some solid entity is prevented from moving along with some quantity of liquid."@en .

<https://www.commoncoreontologies.org/ont00000312> a owl:Class ;
    rdfs:label "Propulsion Process"@en ;
    rdfs:subClassOf <https://www.commoncoreontologies.org/ont00000007> ;
    skos:definition "A Natural Process in which one or more Forces are generated and applied to a participating Object such that the Object is set in Motion or has the direction or magnitude of its Motion altered."@en .

<https://www.commoncoreontologies.org/ont00000314> a owl:Class ;
    rdfs:label "Information Quality Entity"@en ;
    rdfs:subClassOf <http://purl.obolibrary.org/obo/BFO_0000019> ;
    skos:definition "A Quality that concretizes some Information Content Entity."@en .

<https://www.commoncoreontologies.org/ont00000315> a owl:Class ;
    rdfs:label "Telecommunication Switching Node"@en ;
    rdfs:subClassOf <https://www.commoncoreontologies.org/ont00000918> ;
    skos:definition "A Telecommunication Network Node that is capable of redirecting a communication transmission to another Telecommunication Network Node."@en .

<https://www.commoncoreontologies.org/ont00000316> a owl:Class ;
    rdfs:label "Portion of Liquid Helium"@en ;
    rdfs:subClassOf <https://www.commoncoreontologies.org/ont00000255> ;
    skos:definition "A Portion of Cryogenic Material that is composed (almost) entirely of liquid helium."@en .

<https://www.commoncoreontologies.org/ont00000317> a owl:Class ;
    rdfs:label "Electronic Signal Processing Artifact Function"@en ;
    rdfs:subClassOf <https://www.commoncoreontologies.org/ont00001218> ;
    skos:definition "A Signal Processing Artifact Function that inheres in Material Artifacts that are designed to process or transfer information contained in electronic signals."@en .

<https://www.commoncoreontologies.org/ont00000318> a owl:Class ;
    rdfs:label "Disease"@en ;
    rdfs:subClassOf <http://purl.obolibrary.org/obo/BFO_0000016> ;
    skos:definition "A Disposition to undergo pathological processes that exists in an organism because of one or more disorders in that organism."@en .

<https://www.commoncoreontologies.org/ont00000320> a owl:Class ;
    rdfs:label "Act of Reconnaissance"@en ;
    rdfs:subClassOf <https://www.commoncoreontologies.org/ont00001251> ;
    skos:definition "An Act of Intelligence Gathering used to determine an Agent's disposition and intention; the composition and capabilities of Equipment and Facilities, and the surrounding landforms and weather conditions."@en .

<https://www.commoncoreontologies.org/ont00000321> a owl:Class ;
    rdfs:label "Residential Artifact Function"@en ;
    rdfs:subClassOf <https://www.commoncoreontologies.org/ont00001301> ;
    skos:definition "A Service Artifact Function that is realized in processes of residing in a dwelling or home."@en .

<https://www.commoncoreontologies.org/ont00000322> a owl:Class ;
    rdfs:label "Act of Funding"@en ;
    rdfs:subClassOf <https://www.commoncoreontologies.org/ont00000836> ;
    skos:definition "An Act of Financial Instrument Use in which an Agent (the Funder) provides some Financial Instrument to another Agent (the recipient of the funds) as a resource pool that is earmarked by the Funder for a future transaction."@en .

<https://www.commoncoreontologies.org/ont00000324> a owl:Class ;
    rdfs:label "Width"@en ;
    rdfs:subClassOf <https://www.commoncoreontologies.org/ont00001367> ;
    skos:definition "A One Dimensional Extent that inheres in a bearer in virtue of the bearer's extension in a horizontal direction."@en .

<https://www.commoncoreontologies.org/ont00000327> a owl:Class ;
    rdfs:label "Texture"@en ;
    rdfs:subClassOf <http://purl.obolibrary.org/obo/BFO_0000019> ;
    skos:definition "A Quality that inheres in a bearer in virtue of the size, shape, and distribution of features on its surface, typically on a continuum from smooth to rough."@en .

<https://www.commoncoreontologies.org/ont00000328> a owl:Class ;
    rdfs:label "Transportation Infrastructure"@en ;
    rdfs:subClassOf <https://www.commoncoreontologies.org/ont00000870> ;
    skos:definition "An Infrastructure System that has continuant part one or more Transportation Artifacts and bears a function that, if realized, is realized in Acts of Cargo Transportation"@en .

<https://www.commoncoreontologies.org/ont00000329> a owl:Class ;
    rdfs:label "Multi-Month Temporal Interval"@en ;
    rdfs:subClassOf <http://purl.obolibrary.org/obo/BFO_0000038> ;
    skos:definition "A one-dimensional temporal region that is measured in Months and spans at least one Month."@en .

<https://www.commoncoreontologies.org/ont00000331> a owl:Class ;
    rdfs:label "House"@en ;
    rdfs:subClassOf <https://www.commoncoreontologies.org/ont00000410> ;
    skos:definition "A Residential Facility that is designed to provide a self-standing, permanent residence for an individual, family, household, multiple families, or similar-sized group."@en .

<https://www.commoncoreontologies.org/ont00000333> a owl:Class ;
    rdfs:label "Gas Turbine"@en ;
    rdfs:subClassOf <https://www.commoncoreontologies.org/ont00000394> ;
    skos:definition "An Internal Combustion Engine that has a rotating compressor and a turbine and is designed to operate utilizing continous Combustion to produce Thrust, either directly via exhaust or indirectly via a prop."@en .

<https://www.commoncoreontologies.org/ont00000334> a owl:Class ;
    rdfs:label "Interphone"@en ;
    rdfs:subClassOf <https://www.commoncoreontologies.org/ont00000303> ;
    skos:definition "An Intercommunication System that that is designed to facilitate some Act of Communication between agents by means of audio messages."@en .

<https://www.commoncoreontologies.org/ont00000336> a owl:Class ;
    rdfs:label "Apartment Building"@en ;
    rdfs:subClassOf <https://www.commoncoreontologies.org/ont00000410> ;
    skos:definition "A Residential Facility that is designed to contain multiple permanent residences comprised of a suite of rooms."@en .

<https://www.commoncoreontologies.org/ont00000337> a owl:Class ;
    rdfs:label "Rocket-Propelled Grenade"@en ;
    rdfs:subClassOf <https://www.commoncoreontologies.org/ont00001029> ;
    skos:definition "An Unguided Rocket that is designed to contain an explosive warhead, be fired from a Shoulder-Fired Rocket Launcher, and be used against Tanks."@en .

<https://www.commoncoreontologies.org/ont00000338> a owl:Class ;
    rdfs:label "Fan"@en ;
    rdfs:subClassOf <https://www.commoncoreontologies.org/ont00000256> ;
    skos:definition "A Fluid Control Artifact that consists of a rotating arrangement of vanes or blades that are designed to act on a portion of fluid to create flow within it."@en .

<https://www.commoncoreontologies.org/ont00000340> a owl:Class ;
    rdfs:label "Mortar"@en ;
    rdfs:subClassOf <https://www.commoncoreontologies.org/ont00000268> ;
    skos:definition "A Cannon that is designed to fire projectiles at relatively low velocities over relatively short ranges."@en .

<https://www.commoncoreontologies.org/ont00000341> a owl:Class ;
    rdfs:label "Prosthetic Arm"@en ;
    rdfs:subClassOf <https://www.commoncoreontologies.org/ont00000715> ;
    skos:definition "A Prosthesis that is designed to replace a missing arm."@en .

<https://www.commoncoreontologies.org/ont00000342> a owl:Class ;
    rdfs:label "Brake"@en ;
    rdfs:subClassOf <https://www.commoncoreontologies.org/ont00000995> ;
    skos:definition "A Material Artifact that is designed to inhibit the Vehicle's Motion by absorbing energy from a moving system."@en .

<https://www.commoncoreontologies.org/ont00000343> a owl:Class ;
    rdfs:label "Reciprocating Steam Engine"@en ;
    rdfs:subClassOf <https://www.commoncoreontologies.org/ont00000634> ;
    skos:definition "A Steam Engine that is designed to use one or more reciprocating pistons to convert pressure into a rotating motion."@en .

<https://www.commoncoreontologies.org/ont00000347> a owl:Class ;
    rdfs:label "Electronic Bond"@en ;
    rdfs:subClassOf <https://www.commoncoreontologies.org/ont00001159> ;
    skos:definition "A Bond that consists of Bytes."@en .

<https://www.commoncoreontologies.org/ont00000348> a owl:Class ;
    rdfs:label "Filter"@en ;
    rdfs:subClassOf <https://www.commoncoreontologies.org/ont00000995> ;
    skos:definition "A Material Artifact that bears a Filter Function."@en .

<https://www.commoncoreontologies.org/ont00000349> a owl:Class ;
    rdfs:label "Police Station"@en ;
    rdfs:subClassOf <https://www.commoncoreontologies.org/ont00000479> ;
    skos:definition "A Public Safety Facility that is designed for the professional and clerical processes of a local police force."@en .

<https://www.commoncoreontologies.org/ont00000351> a owl:Class ;
    rdfs:label "Act of Commanding"@en ;
    rdfs:subClassOf <https://www.commoncoreontologies.org/ont00000133> ;
    skos:definition "An Act of Directive Communication through which an Agent exercises authoritative control or power over another Agent's actions."@en .

<https://www.commoncoreontologies.org/ont00000352> a owl:Class ;
    rdfs:label "Satellite Artifact"@en ;
    rdfs:subClassOf <https://www.commoncoreontologies.org/ont00001139> ;
    skos:definition "A Spacecraft that is designed to Orbit a Space Object (typically Earth)."@en .

<https://www.commoncoreontologies.org/ont00000353> a owl:Class ;
    rdfs:label "Research Artifact Function"@en ;
    rdfs:subClassOf <https://www.commoncoreontologies.org/ont00000323> ;
    skos:definition "An Artifact Function that is realized during events in which a Material Artifact is used to perform research on a specified entity or class of entities."@en .

<https://www.commoncoreontologies.org/ont00000354> a owl:Class ;
    rdfs:label "Act of Testifying"@en ;
    rdfs:subClassOf <https://www.commoncoreontologies.org/ont00000379> ;
    skos:definition "An Act of Representative Communication performed by stating one's personal knowledge or belief."@en .

<https://www.commoncoreontologies.org/ont00000355> a owl:Class ;
    rdfs:label "Refracting Optical Telescope"@en ;
    rdfs:subClassOf <https://www.commoncoreontologies.org/ont00001009> ;
