@prefix dc: <http://purl.org/dc/elements/1.1/> .
@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix geo: <http://www.opengis.net/ont/geosparql#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

<http://purl.obolibrary.org/obo/BFO_0000009> a owl:Class ;
    rdfs:label "two-dimensional spatial region"@en ;
    rdfs:subClassOf <http://purl.obolibrary.org/obo/BFO_0000006> ;
    owl:disjointWith <http://purl.obolibrary.org/obo/BFO_0000018>,
        <http://purl.obolibrary.org/obo/BFO_0000026>,
        <http://purl.obolibrary.org/obo/BFO_0000028> ;
    skos:definition "(Elucidation) A two-dimensional spatial region is a spatial region that is a whole consisting of a surface together with zero or more surfaces which may have spatial regions of lower dimension as parts"@en .

<http://purl.obolibrary.org/obo/BFO_0000054> a owl:ObjectProperty ;
    rdfs:label "has realization"@en ;
    rdfs:domain <http://purl.obolibrary.org/obo/BFO_0000017> ;
    rdfs:range <http://purl.obolibrary.org/obo/BFO_0000015> ;
    skos:definition "b has realization c =Def c realizes b"@en .

<http://purl.obolibrary.org/obo/BFO_0000055> a owl:ObjectProperty ;
    rdfs:label "realizes"@en ;
    rdfs:domain <http://purl.obolibrary.org/obo/BFO_0000015> ;
    rdfs:range <http://purl.obolibrary.org/obo/BFO_0000017> ;
    skos:definition "(Elucidation) realizes is a relation between a process b and realizable entity c such that c inheres in some d & for all t, if b has participant d then c exists & the type instantiated by b is correlated with the type instantiated by c"@en .

<http://purl.obolibrary.org/obo/BFO_0000056> a owl:ObjectProperty ;
    rdfs:label "participates in"@en ;
    rdfs:range <http://purl.obolibrary.org/obo/BFO_0000015> ;
    skos:definition "(Elucidation) participates in holds between some b that is either a specifically dependent continuant or generically dependent continuant or independent continuant that is not a spatial region & some process p such that b participates in p some way"@en .

<http://purl.obolibrary.org/obo/BFO_0000057> a owl:ObjectProperty ;
    rdfs:label "has participant"@en ;
    rdfs:domain <http://purl.obolibrary.org/obo/BFO_0000015> ;
    skos:definition "p has participant c =Def c participates in p"@en .

<http://purl.obolibrary.org/obo/BFO_0000058> a owl:ObjectProperty ;
    rdfs:label "is concretized by"@en ;
    rdfs:domain <http://purl.obolibrary.org/obo/BFO_0000031> ;
    skos:definition "c is concretized by b =Def b concretizes c"@en .

<http://purl.obolibrary.org/obo/BFO_0000059> a owl:ObjectProperty ;
    rdfs:label "concretizes"@en ;
    rdfs:range <http://purl.obolibrary.org/obo/BFO_0000031> ;
    skos:definition "b concretizes c =Def b is a process or a specifically dependent continuant & c is a generically dependent continuant & there is some time t such that c is the pattern or content which b shares at t with actual or potential copies"@en .

<http://purl.obolibrary.org/obo/BFO_0000062> a owl:ObjectProperty ;
    rdfs:label "preceded by"@en ;
    rdfs:domain <http://purl.obolibrary.org/obo/BFO_0000003> ;
    rdfs:range <http://purl.obolibrary.org/obo/BFO_0000003> ;
    skos:definition "b preceded by c =Def b precedes c"@en .

<http://purl.obolibrary.org/obo/BFO_0000063> a owl:ObjectProperty ;
    rdfs:label "precedes"@en ;
    rdfs:domain <http://purl.obolibrary.org/obo/BFO_0000003> ;
    rdfs:range <http://purl.obolibrary.org/obo/BFO_0000003> ;
    skos:definition "(Elucidation) precedes is a relation between occurrents o, o' such that if t is the temporal extent of o & t' is the temporal extent of o' then either the last instant of o is before the first instant of o' or the last instant of o is the first instant of o' & neither o nor o' are temporal instants"@en .

<http://purl.obolibrary.org/obo/BFO_0000066> a owl:ObjectProperty ;
    rdfs:label "occurs in"@en ;
    skos:definition "b occurs in c =Def b is a process or a process boundary & c is a material entity or site & there exists a spatiotemporal region r & b occupies spatiotemporal region r & for all time t, if b exists at t then c exists at t & there exist spatial regions s and s' where b spatially projects onto s at t & c occupies spatial region s' at t & s is a continuant part of s' at t"@en .

<http://purl.obolibrary.org/obo/BFO_0000084> a owl:ObjectProperty ;
    rdfs:label "generically depends on"@en ;
    rdfs:domain <http://purl.obolibrary.org/obo/BFO_0000031> ;
    skos:definition "b generically depends on c =Def b is a generically dependent continuant & c is an independent continuant that is not a spatial region & at some time t there inheres in c a specifically dependent continuant which concretizes b at t"@en .

<http://purl.obolibrary.org/obo/BFO_0000101> a owl:ObjectProperty ;
    rdfs:label "is carrier of"@en ;
    rdfs:range <http://purl.obolibrary.org/obo/BFO_0000031> ;
    skos:definition "b is carrier of c =Def there is some time t such that c generically depends on b at t"@en .

<http://purl.obolibrary.org/obo/BFO_0000108> a owl:ObjectProperty ;
    rdfs:label "exists at"@en ;
    rdfs:domain <http://purl.obolibrary.org/obo/BFO_0000001> ;
    rdfs:range <http://purl.obolibrary.org/obo/BFO_0000008> ;
    skos:definition "(Elucidation) exists at is a relation between a particular and some temporal region at which the particular exists"@en .

<http://purl.obolibrary.org/obo/BFO_0000115> a owl:ObjectProperty ;
    rdfs:label "has member part"@en ;
    rdfs:domain <http://purl.obolibrary.org/obo/BFO_0000040> ;
    rdfs:range <http://purl.obolibrary.org/obo/BFO_0000040> ;
    skos:definition "b has member part c =Def c member part of b"@en .

<http://purl.obolibrary.org/obo/BFO_0000117> a owl:ObjectProperty ;
    rdfs:label "has occurrent part"@en ;
    rdfs:domain <http://purl.obolibrary.org/obo/BFO_0000003> ;
    rdfs:range <http://purl.obolibrary.org/obo/BFO_0000003> ;
    skos:definition "b has occurrent part c =Def c occurrent part of b"@en .

<http://purl.obolibrary.org/obo/BFO_0000121> a owl:ObjectProperty ;
    rdfs:label "has temporal part"@en ;
    rdfs:domain <http://purl.obolibrary.org/obo/BFO_0000003> ;
    rdfs:range <http://purl.obolibrary.org/obo/BFO_0000003> ;
    skos:definition "b has temporal part c =Def c temporal part of b"@en .

<http://purl.obolibrary.org/obo/BFO_0000124> a owl:ObjectProperty ;
    rdfs:label "location of"@en ;
    skos:definition "b location of c =Def c located in b"@en .

<http://purl.obolibrary.org/obo/BFO_0000127> a owl:ObjectProperty ;
    rdfs:label "material basis of"@en ;
    rdfs:domain <http://purl.obolibrary.org/obo/BFO_0000040> ;
    rdfs:range <http://purl.obolibrary.org/obo/BFO_0000016> ;
    skos:definition "b material basis of c =Def c has material basis b"@en .

<http://purl.obolibrary.org/obo/BFO_0000129> a owl:ObjectProperty ;
    rdfs:label "member part of"@en ;
    rdfs:domain <http://purl.obolibrary.org/obo/BFO_0000040> ;
    rdfs:range <http://purl.obolibrary.org/obo/BFO_0000040> ;
    skos:definition "b member part of c =Def b is an object & c is a material entity & there is some time t such that b continuant part of c at t & there is a mutually exhaustive and pairwise disjoint partition of c into objects x1, ..., xn (for some n ≠ 1) with b = xi (for some 1 <= i <= n)"@en .

<http://purl.obolibrary.org/obo/BFO_0000132> a owl:ObjectProperty ;
    rdfs:label "occurrent part of"@en ;
    rdfs:domain <http://purl.obolibrary.org/obo/BFO_0000003> ;
    rdfs:range <http://purl.obolibrary.org/obo/BFO_0000003> ;
    skos:definition "(Elucidation) occurrent part of is a relation between occurrents b and c when b is part of c"@en .

<http://purl.obolibrary.org/obo/BFO_0000139> a owl:ObjectProperty ;
    rdfs:label "temporal part of"@en ;
    rdfs:domain <http://purl.obolibrary.org/obo/BFO_0000003> ;
    rdfs:range <http://purl.obolibrary.org/obo/BFO_0000003> ;
    skos:definition "b temporal part of c =Def b occurrent part of c & (b and c are temporal regions) or (b and c are spatiotemporal regions & b temporally projects onto an occurrent part of the temporal region that c temporally projects onto) or (b and c are processes or process boundaries & b occupies a temporal region that is an occurrent part of the temporal region that c occupies)"@en .

<http://purl.obolibrary.org/obo/BFO_0000153> a owl:ObjectProperty ;
    rdfs:label "temporally projects onto"@en ;
    rdfs:domain <http://purl.obolibrary.org/obo/BFO_0000011> ;
    rdfs:range <http://purl.obolibrary.org/obo/BFO_0000008> ;
    skos:definition "(Elucidation) temporally projects onto is a relation between a spatiotemporal region s and some temporal region which is the temporal extent of s"@en .

<http://purl.obolibrary.org/obo/BFO_0000171> a owl:ObjectProperty ;
    rdfs:label "located in"@en ;
    skos:definition "b located in c =Def b is an independent continuant & c is an independent & neither is a spatial region & there is some time t such that the spatial region which b occupies at t is continuant part of the spatial region which c occupies at t"@en .

<http://purl.obolibrary.org/obo/BFO_0000176> a owl:ObjectProperty ;
    rdfs:label "continuant part of"@en ;
    rdfs:domain <http://purl.obolibrary.org/obo/BFO_0000002> ;
    rdfs:range <http://purl.obolibrary.org/obo/BFO_0000002> ;
    skos:definition "b continuant part of c =Def b and c are continuants & there is some time t such that b and c exist at t & b continuant part of c at t"@en .

<http://purl.obolibrary.org/obo/BFO_0000178> a owl:ObjectProperty ;
    rdfs:label "has continuant part"@en ;
    rdfs:domain <http://purl.obolibrary.org/obo/BFO_0000002> ;
    rdfs:range <http://purl.obolibrary.org/obo/BFO_0000002> ;
    skos:definition "b has continuant part c =Def c continuant part of b"@en .

<http://purl.obolibrary.org/obo/BFO_0000183> a owl:ObjectProperty ;
    rdfs:label "environs"@en ;
    skos:definition "b environs c =Def c occurs in b"@en .

<http://purl.obolibrary.org/obo/BFO_0000184> a owl:ObjectProperty ;
    rdfs:label "history of"@en ;
    rdfs:domain <http://purl.obolibrary.org/obo/BFO_0000182> ;
    rdfs:range <http://purl.obolibrary.org/obo/BFO_0000040> ;
    skos:definition "(Elucidation) history of is a relation between history b and material entity c such that b is the unique history of c"@en .

<http://purl.obolibrary.org/obo/BFO_0000185> a owl:ObjectProperty ;
    rdfs:label "has history"@en ;
    rdfs:domain <http://purl.obolibrary.org/obo/BFO_0000040> ;
    rdfs:range <http://purl.obolibrary.org/obo/BFO_0000182> ;
    skos:definition "b has history c =Def c history of b"@en .

<http://purl.obolibrary.org/obo/BFO_0000194> a owl:ObjectProperty ;
    rdfs:label "specifically depended on by"@en ;
    rdfs:range <http://purl.obolibrary.org/obo/BFO_0000020> ;
    skos:definition "b specifically depended on by c =Def c specifically depends on b"@en .

<http://purl.obolibrary.org/obo/BFO_0000195> a owl:ObjectProperty ;
    rdfs:label "specifically depends on"@en ;
    rdfs:domain <http://purl.obolibrary.org/obo/BFO_0000020> ;
    skos:definition "(Elucidation) specifically depends on is a relation between a specifically dependent continuant b and specifically dependent continuant or independent continuant that is not a spatial region c such that b and c share no parts in common & b is of a nature such that at all times t it cannot exist unless c exists & b is not a boundary of c"@en .

<http://purl.obolibrary.org/obo/BFO_0000196> a owl:ObjectProperty ;
    rdfs:label "bearer of"@en ;
    rdfs:range <http://purl.obolibrary.org/obo/BFO_0000020> ;
    skos:definition "b bearer of c =Def c inheres in b"@en .

<http://purl.obolibrary.org/obo/BFO_0000197> a owl:ObjectProperty ;
    rdfs:label "inheres in"@en ;
    rdfs:domain <http://purl.obolibrary.org/obo/BFO_0000020> ;
    skos:definition "b inheres in c =Def b is a specifically dependent continuant & c is an independent continuant that is not a spatial region & b specifically depends on c"@en .

<http://purl.obolibrary.org/obo/BFO_0000199> a owl:ObjectProperty ;
    rdfs:label "occupies temporal region"@en ;
    rdfs:range <http://purl.obolibrary.org/obo/BFO_0000008> ;
    skos:definition "p occupies temporal region t =Def p is a process or process boundary & the spatiotemporal region occupied by p temporally projects onto t"@en .

<http://purl.obolibrary.org/obo/BFO_0000200> a owl:ObjectProperty ;
    rdfs:label "occupies spatiotemporal region"@en ;
    rdfs:range <http://purl.obolibrary.org/obo/BFO_0000011> ;
    skos:definition "(Elucidation) occupies spatiotemporal region is a relation between a process or process boundary p and the spatiotemporal region s which is its spatiotemporal extent"@en .

<http://purl.obolibrary.org/obo/BFO_0000210> a owl:ObjectProperty ;
    rdfs:label "occupies spatial region"@en ;
    rdfs:range <http://purl.obolibrary.org/obo/BFO_0000006> ;
    skos:definition "b occupies spatial region r =Def b is an independent continuant that is not a spatial region & r is a spatial region & there is some time t such that every continuant part of b occupies some continuant part of r at t and no continuant part of b occupies any spatial region that is not a continuant part of r at t"@en .

<http://purl.obolibrary.org/obo/BFO_0000216> a owl:ObjectProperty ;
    rdfs:label "spatially projects onto"@en ;
    rdfs:domain <http://purl.obolibrary.org/obo/BFO_0000011> ;
    rdfs:range <http://purl.obolibrary.org/obo/BFO_0000006> ;
    skos:definition "(Elucidation) spatially projects onto is a relation between some spatiotemporal region b and spatial region c such that at some time t, c is the spatial extent of b at t"@en .

<http://purl.obolibrary.org/obo/BFO_0000218> a owl:ObjectProperty ;
    rdfs:label "has material basis"@en ;
    rdfs:domain <http://purl.obolibrary.org/obo/BFO_0000016> ;
    rdfs:range <http://purl.obolibrary.org/obo/BFO_0000040> ;
    skos:definition "b has material basis c =Def b is a disposition & c is a material entity & there is some d bearer of b & there is some time t such that c is a continuant part of d at t & d has disposition b because c is a continuant part of d at t"@en .

<http://purl.obolibrary.org/obo/BFO_0000221> a owl:ObjectProperty ;
    rdfs:label "first instant of"@en ;
    rdfs:domain <http://purl.obolibrary.org/obo/BFO_0000203> ;
    rdfs:range <http://purl.obolibrary.org/obo/BFO_0000008> ;
    skos:definition "t first instant of t' =Def t is a temporal instant & t' is a temporal region t' & t precedes all temporal parts of t' other than t"@en .

<http://purl.obolibrary.org/obo/BFO_0000222> a owl:ObjectProperty ;
    rdfs:label "has first instant"@en ;
    rdfs:domain <http://purl.obolibrary.org/obo/BFO_0000008> ;
    rdfs:range <http://purl.obolibrary.org/obo/BFO_0000203> ;
    skos:definition "t has first instant t' =Def t' first instant of t"@en .

<http://purl.obolibrary.org/obo/BFO_0000223> a owl:ObjectProperty ;
    rdfs:label "last instant of"@en ;
    rdfs:domain <http://purl.obolibrary.org/obo/BFO_0000203> ;
    rdfs:range <http://purl.obolibrary.org/obo/BFO_0000008> ;
    skos:definition "t last instant of t' =Def t is a temporal instant & t' is a temporal region & all temporal parts of t' other than t precede t"@en .

<http://purl.obolibrary.org/obo/BFO_0000224> a owl:ObjectProperty ;
    rdfs:label "has last instant"@en ;
    rdfs:domain <http://purl.obolibrary.org/obo/BFO_0000008> ;
    rdfs:range <http://purl.obolibrary.org/obo/BFO_0000203> ;
    skos:definition "t has last instant t' =Def t' last instant of t"@en .

dc:contributor a owl:AnnotationProperty .

dc:identifier a owl:AnnotationProperty .

dc:license a owl:AnnotationProperty .

dcterms:bibliographicCitation a owl:AnnotationProperty .

dcterms:contributor a owl:AnnotationProperty .

dcterms:created a owl:AnnotationProperty .

dcterms:creator a owl:AnnotationProperty .

dcterms:description a owl:AnnotationProperty .

dcterms:license a owl:AnnotationProperty .

dcterms:rights a owl:AnnotationProperty .

dcterms:title a owl:AnnotationProperty .

geo:asWKT a owl:DatatypeProperty ;
    rdfs:label "as WKT"@en ;
    skos:definition "A Data Property that has as its range a string formated according to the Well-known text standardization for geometric objects."@en .

rdfs:altLabel a owl:AnnotationProperty .

skos:altLabel a owl:AnnotationProperty .

skos:definition a owl:AnnotationProperty .

skos:editorialNote a owl:AnnotationProperty .

skos:example a owl:AnnotationProperty .

skos:prefLabel a owl:AnnotationProperty .

skos:scopeNote a owl:AnnotationProperty .

<https://www.commoncoreontologies.org/CommonCoreOntologiesMerged> rdfs:label "Common Core Ontologies Merged"@en .

<https://www.commoncoreontologies.org/ont00000001> a owl:Class ;
    rdfs:label "Deflecting Prism"@en ;
    rdfs:subClassOf <https://www.commoncoreontologies.org/ont00000804> ;
    skos:definition "A Prism designed to deflect a beam of light entering the Prism by a fixed angle."@en .

<https://www.commoncoreontologies.org/ont00000002> a owl:Class ;
    rdfs:label "Cooling Artifact Function"@en ;
    rdfs:subClassOf <https://www.commoncoreontologies.org/ont00000323> ;
    skos:definition "An Artifact Function that is realized in a process in which the thermal energy of a system decreases."@en .

<https://www.commoncoreontologies.org/ont00000006> a owl:Class ;
    rdfs:label "Upper Midrange Frequency"@en ;
    rdfs:subClassOf <https://www.commoncoreontologies.org/ont00000530> ;
    skos:definition "A Sonic Frequency that is between 2 and 4 kHz."@en .

<https://www.commoncoreontologies.org/ont00000009> a owl:Class ;
    rdfs:label "Mass Density"@en ;
    rdfs:subClassOf <http://purl.obolibrary.org/obo/BFO_0000019> ;
    skos:definition "A Quality that inheres in a bearer in virtue of that bearer's mass per unit volume."@en .

<https://www.commoncoreontologies.org/ont00000010> a owl:Class ;
    rdfs:label "Incorporated Organization"@en ;
    rdfs:subClassOf <https://www.commoncoreontologies.org/ont00001180> ;
    skos:definition "An Organization formed by an Act of Incorporation that consists of an association of individuals, created by law or under authority of law, having a continuous existence independent of the existences of its members and owners, and having powers and liabilities distinct from those of its members and owners."@en .

<https://www.commoncoreontologies.org/ont00000011> a owl:Class ;
    rdfs:label "Nominal Stasis"@en ;
    rdfs:subClassOf <https://www.commoncoreontologies.org/ont00000135> ;
    skos:definition "A Stasis of Specifically Dependent Continuant in which some Independent Continuant bears a Quality or Realizable Entity that has a level of intensity or functionality that falls within the designed, expected, or acceptable range such that the Independent Continuant is of normal value, usefulness, or functionality."@en .

<https://www.commoncoreontologies.org/ont00000012> a owl:Class ;
    rdfs:label "Propulsion Control System"@en ;
    rdfs:subClassOf <https://www.commoncoreontologies.org/ont00000781> ;
    skos:definition "A Control System that consists of control devices, displays, indicators, or modules designed to control a Propulsion System."@en .

<https://www.commoncoreontologies.org/ont00000013> a owl:Class ;
    rdfs:label "Gain of Generically Dependent Continuant"@en ;
    rdfs:subClassOf <https://www.commoncoreontologies.org/ont00000554> ;
    skos:definition "A Gain of Dependent Continuant wherein some Independent Continuant becomes the carrier of some Generically Dependent Continuant."@en .

<https://www.commoncoreontologies.org/ont00000015> a owl:Class ;
    rdfs:label "Shotgun"@en ;
    rdfs:subClassOf <https://www.commoncoreontologies.org/ont00001104> ;
    skos:definition "A Long Gun that fires packets of shot, a single slug, a sabot, or a specialty round (such as tear gas, bolo shell, or a breaching round) over shorter ranges than that of Rifles and with less accuracy."@en .

<https://www.commoncoreontologies.org/ont00000016> a owl:Class ;
    rdfs:label "Triangular Waveform"@en ;
    rdfs:subClassOf <https://www.commoncoreontologies.org/ont00001286> ;
    skos:definition "A Waveform that is characterized by a triangular shape due to the continuous linear zig-zag transitions between minimum and maximum Amplitudes of the Wave Cycle."@en .

<https://www.commoncoreontologies.org/ont00000017> a owl:Class ;
    rdfs:label "Minor Axis"@en ;
    rdfs:subClassOf <http://purl.obolibrary.org/obo/BFO_0000026> ;
    skos:definition "A One-Dimensional Spatial Region that is the longest line segment perpendicular to the Major Axis that connects two points on the edge of an Ellipse."@en .

<https://www.commoncoreontologies.org/ont00000018> a owl:Class ;
    rdfs:label "Title Document"@en ;
    rdfs:subClassOf <https://www.commoncoreontologies.org/ont00001346> ;
    skos:definition "A Legal Instrument that is designed as evidence of ownership."@en .

<https://www.commoncoreontologies.org/ont00000019> a owl:Class ;
    rdfs:label "Power Inverting Artifact Function"@en ;
    rdfs:subClassOf <https://www.commoncoreontologies.org/ont00000961> ;
    skos:definition "A Current Conversion Artifact Function that is realized by processes in which some Material Artifact is used to convert direct current (DC) to alternating current (AC)."@en .

<https://www.commoncoreontologies.org/ont00000021> a owl:Class ;
    rdfs:label "Sensor Platform"@en ;
    rdfs:subClassOf <http://purl.obolibrary.org/obo/BFO_0000040> ;
    skos:definition "A Material Entity that bears a Sensor Platform Artifact Function or Sensor Platform Role."@en .

<https://www.commoncoreontologies.org/ont00000022> a owl:Class ;
    rdfs:label "Radio Communication Reception Artifact Function"@en ;
    rdfs:subClassOf <https://www.commoncoreontologies.org/ont00000422> ;
    skos:definition "A Communication Reception Artifact Function that is realized during events in which a Material Artifact receives information transmitted from another Material Artifact, where the transmission of information occurs using radio waves."@en .

<https://www.commoncoreontologies.org/ont00000023> a owl:Class ;
    rdfs:label "Sensor Deployment Artifact Function"@en ;
    rdfs:subClassOf <https://www.commoncoreontologies.org/ont00000323> ;
    skos:definition "An Artifact Function that inheres in Material Artifacts that are designed to support or convey one or more Sensors while the Sensors are realizing their own Artifact Functions."@en .

<https://www.commoncoreontologies.org/ont00000024> a owl:Class ;
    rdfs:label "Act of Advising"@en ;
    rdfs:subClassOf <https://www.commoncoreontologies.org/ont00000133> ;
    skos:definition "An Act of Directive Communication performed by providing advice or counsel to another agent."@en .

<https://www.commoncoreontologies.org/ont00000025> a owl:Class ;
    rdfs:label "Electronic Stock"@en ;
    rdfs:subClassOf <https://www.commoncoreontologies.org/ont00001278> ;
    skos:definition "Stock that consists of Bytes."@en .

<https://www.commoncoreontologies.org/ont00000026> a owl:Class ;
    rdfs:label "Hair Color"@en ;
    rdfs:subClassOf <http://purl.obolibrary.org/obo/BFO_0000019> ;
    skos:definition "A Quality inhering in a portion of Hair by virtue of its color."@en .

<https://www.commoncoreontologies.org/ont00000027> a owl:Class ;
    rdfs:label "Mailing"@en ;
    rdfs:subClassOf <https://www.commoncoreontologies.org/ont00000517> ;
    skos:definition "An Act of Communication by Media in which information and tangible objects, usually written documents, are delivered to destinations around the world."@en .

<https://www.commoncoreontologies.org/ont00000028> a owl:Class ;
    rdfs:label "Dispersive Prism"@en ;
    rdfs:subClassOf <https://www.commoncoreontologies.org/ont00000804> ;
    skos:definition "A Prism designed to break up a beam of light entering the Prism into its constituent spectral colors by leveraging the refractive index of light based on its Frequency."@en .

<https://www.commoncoreontologies.org/ont00000029> a owl:Class ;
    rdfs:label "Median Point Estimate Information Content Entity"@en ;
    rdfs:subClassOf <https://www.commoncoreontologies.org/ont00000745> ;
    skos:definition "A Point Estimate Information Content Entity that is a measurement of a set of values and is equal to either the middle value or the average of the two values which separate the set into two equally populated upper and lower sets."@en .

<https://www.commoncoreontologies.org/ont00000030> a owl:Class ;
    rdfs:label "Nuclear Reactor"@en ;
    rdfs:subClassOf <https://www.commoncoreontologies.org/ont00000288> ;
    skos:definition "A Power Source that is designed to initiate and control a self-sustained nuclear chain reaction to produce power in the form of heat, which can be transferred to a working fluid for further conversion to mechanical or electrical energy."@en .

<https://www.commoncoreontologies.org/ont00000031> a owl:Class ;
    rdfs:label "Atmospheric Feature"@en ;
    rdfs:subClassOf <https://www.commoncoreontologies.org/ont00001081> ;
    skos:definition "A Geographic Feature that is part of the atmosphere (including the atmosphere itself as a non-proper part) having a relatively stable lifecycle and which has a location that can be distinguished from the surrounding portion of the atmosphere."@en .

<https://www.commoncoreontologies.org/ont00000032> a owl:Class ;
    rdfs:label "Church"@en ;
    rdfs:subClassOf <https://www.commoncoreontologies.org/ont00000052> ;
    skos:definition "A Religious Facility that is designed for Christian worship and prayer."@en .

<https://www.commoncoreontologies.org/ont00000033> a owl:Class ;
    rdfs:label "Decrease of Role"@en ;
    rdfs:subClassOf <https://www.commoncoreontologies.org/ont00000854> ;
    skos:definition "A Decrease of Realizable Entity in which some Independent Continuant has a decrease of some Role that it bears."@en .

<https://www.commoncoreontologies.org/ont00000034> a owl:Class ;
    rdfs:label "Conveyance Artifact Function"@en ;
    rdfs:subClassOf <https://www.commoncoreontologies.org/ont00000448> ;
    skos:definition "A Motion Artifact Function that is realized in a process in which the bearer of the function conveys entities from one location to another."@en .

<https://www.commoncoreontologies.org/ont00000035> a owl:Class ;
    rdfs:label "Soft X-ray Frequency"@en ;
    rdfs:subClassOf <https://www.commoncoreontologies.org/ont00000490> ;
    skos:definition "An X-Ray Frequency that is between 30 petahertz and 3 exahertz."@en .

<https://www.commoncoreontologies.org/ont00000036> a owl:Class ;
    rdfs:label "Waste Management Artifact Function"@en ;
    rdfs:subClassOf <https://www.commoncoreontologies.org/ont00001301> ;
    skos:definition "A Service Artifact Function that is realized in processes of collecting, transporting, processing, recycling, monitoring, or disposing of waste materials."@en .

<https://www.commoncoreontologies.org/ont00000038> a owl:Class ;
    rdfs:label "System Role"@en ;
    rdfs:subClassOf <http://purl.obolibrary.org/obo/BFO_0000023> ;
    skos:definition "A Role that inheres in an entity in virtue of its parts or elements being arranged in such a way that they together exhibit behavior or meaning that they do not exhibit individually."@en .

<https://www.commoncoreontologies.org/ont00000039> a owl:Class ;
    rdfs:label "Portion of Solid Fuel"@en ;
    rdfs:subClassOf <https://www.commoncoreontologies.org/ont00000838> ;
    skos:definition "A Portion of Fuel that is stored in a solid state."@en .

<https://www.commoncoreontologies.org/ont00000040> a owl:Class ;
    rdfs:label "Grocery Store"@en ;
    rdfs:subClassOf <https://www.commoncoreontologies.org/ont00001102> ;
    skos:definition "A Commercial Facility that is designed to sell food."@en .

<https://www.commoncoreontologies.org/ont00000041> a owl:Class ;
    rdfs:label "Hostel"@en ;
    rdfs:subClassOf <https://www.commoncoreontologies.org/ont00000410> ;
    skos:definition "A Residential Facility that is designed to temporarily lodge guests in a sociable environment for relatively low costs."@en .

<https://www.commoncoreontologies.org/ont00000042> a owl:Class ;
    rdfs:label "Semicircular"@en ;
    rdfs:subClassOf <https://www.commoncoreontologies.org/ont00001059> ;
    skos:definition "A Shape quality inhering in a bearer in virtue of the bearer having the shape of half a circle."@en .

<https://www.commoncoreontologies.org/ont00000043> a owl:Class ;
    rdfs:label "Portion of Solid Propellant"@en ;
    rdfs:subClassOf <https://www.commoncoreontologies.org/ont00000593> ;
    skos:definition "A Portion of Propellant that is stored in a solid state."@en .

<https://www.commoncoreontologies.org/ont00000044> a owl:Class ;
    rdfs:label "Eye Color"@en ;
    rdfs:subClassOf <http://purl.obolibrary.org/obo/BFO_0000019> ;
    skos:definition "A Quality inhering in an Eye by virtue of the color of the Eye's Iris."@en .

<https://www.commoncoreontologies.org/ont00000045> a owl:Class ;
    rdfs:label "Petroleum Depot"@en ;
    rdfs:subClassOf <https://www.commoncoreontologies.org/ont00000881> ;
    skos:definition "A Storage Facility that is designed to store petroleum, oil, or lubricants."@en .

<https://www.commoncoreontologies.org/ont00000046> a owl:Class ;
    rdfs:label "Province"@en ;
    rdfs:subClassOf <https://www.commoncoreontologies.org/ont00000126> ;
    skos:definition "A First-Order Administrative Region that is part of a Country and delimits the authority of a magistrate who holds constitutionally-defined administrative jurisdiction over the defined geographic territory that bounds the Province."@en .

<https://www.commoncoreontologies.org/ont00000047> a owl:Class ;
    rdfs:label "Flow Control Valve"@en ;
    rdfs:subClassOf <https://www.commoncoreontologies.org/ont00000598> ;
    skos:definition "A Valve that is designed to regulate the flow or Pressure of a fluid."@en .

<https://www.commoncoreontologies.org/ont00000048> a owl:Class ;
    rdfs:label "Random Wire Antenna"@en ;
    rdfs:subClassOf <https://www.commoncoreontologies.org/ont00000499> ;
    skos:definition "A Wire Antenna that consists of a long wire suspended above the ground with a length that does not bear a relation to the wavelength of the radio waves used and which is typically used as a receiving antenna on the long, medium, and short wave bands."@en .

<https://www.commoncoreontologies.org/ont00000049> a owl:Class ;
    rdfs:label "Banknote"@en ;
    rdfs:subClassOf <https://www.commoncoreontologies.org/ont00000475> ;
    skos:definition "A Portion of Cash that consists of a portable slips of paper or fabric designed to bear some specified Financial Value."@en .

<https://www.commoncoreontologies.org/ont00000050> a owl:Class ;
    rdfs:label "Very High Frequency Communication Instrument"@en ;
    rdfs:subClassOf <https://www.commoncoreontologies.org/ont00000903> ;
    skos:definition "A Radio Communication Instrument that is designed to participate in some process that has process part some Very High Frequency."@en .

<https://www.commoncoreontologies.org/ont00000051> a owl:Class ;
    rdfs:label "Act of Construction"@en ;
    rdfs:subClassOf <https://www.commoncoreontologies.org/ont00000908> ;
    skos:definition "An Act of Material Artifact Processing wherein Material Artifacts are built on site as prescribed by some contract."@en .

<https://www.commoncoreontologies.org/ont00000054> a owl:Class ;
    rdfs:label "Stirling Engine"@en ;
    rdfs:subClassOf <https://www.commoncoreontologies.org/ont00000431> ;
    skos:definition "An External Combusion Engine that is designed to compress and expand some working fluid at different temperatures, such that there is a net conversion of heat energy to mechanical work."@en .

<https://www.commoncoreontologies.org/ont00000057> a owl:Class ;
    rdfs:label "Mobile Telephone"@en ;
    rdfs:subClassOf <https://www.commoncoreontologies.org/ont00000907> ;
    skos:definition "A Telephone that is connected to a Telephone Network by radio waves."@en .

<https://www.commoncoreontologies.org/ont00000058> a owl:Class ;
    rdfs:label "Scalp Hair"@en ;
    rdfs:subClassOf <https://www.commoncoreontologies.org/ont00000084> ;
    skos:definition "A Bodily Component that consists of a portion of hair that grows on the scalp of a human or other animal."@en .

<https://www.commoncoreontologies.org/ont00000060> a owl:Class ;
    rdfs:label "Open Pit Mine"@en ;
    rdfs:subClassOf <https://www.commoncoreontologies.org/ont00000639> ;
    skos:definition "A Mine that is designed to support the extraction of materials from the ground directly without using tunnels."@en .

<https://www.commoncoreontologies.org/ont00000062> a owl:Class ;
    rdfs:label "Frequency Measurement Artifact Function"@en ;
    rdfs:subClassOf <https://www.commoncoreontologies.org/ont00001100> ;
    skos:definition "A Measurement Artifact Function that is realized during events in which a Material Artifact is used to measure the Frequency of a specified object or class of objects."@en .

<https://www.commoncoreontologies.org/ont00000063> a owl:Class ;
    rdfs:label "Multi-Hour Temporal Interval"@en ;
    rdfs:subClassOf <http://purl.obolibrary.org/obo/BFO_0000038> ;
    skos:definition "A one-dimensional temporal region that is measured in Hours and spans at least one Hour."@en .

<https://www.commoncoreontologies.org/ont00000064> a owl:Class ;
    rdfs:label "Material Copy of a Book"@en ;
    rdfs:subClassOf <https://www.commoncoreontologies.org/ont00001298> ;
    skos:definition "A Material Copy of a Document that is designed to carry some specific Information Content Entity by means of ink, paper, parchment, or other materials fastened together to hinge at one side."@en .

<https://www.commoncoreontologies.org/ont00000066> a owl:Class ;
    rdfs:label "Military Artifact Function"@en ;
    rdfs:subClassOf <https://www.commoncoreontologies.org/ont00001301> ;
    skos:definition "A Service Artifact Function that is realized in processes related to the armed services."@en .

<https://www.commoncoreontologies.org/ont00000067> a owl:Class ;
    rdfs:label "Civil Time Reference System"@en ;
    rdfs:subClassOf <https://www.commoncoreontologies.org/ont00001328> ;
    skos:definition "A Temporal Reference System that is a statutory time scale as designated by civilian authorities to determine local time(s)."@en .

<https://www.commoncoreontologies.org/ont00000068> a owl:Class ;
    rdfs:label "Three-Dimensional Path"@en ;
    rdfs:subClassOf <http://purl.obolibrary.org/obo/BFO_0000028> ;
    skos:definition "A Three-Dimensional Spatial Region that encompasses the spatial region through which some Object travels."@en .

<https://www.commoncoreontologies.org/ont00000069> a owl:Class ;
    rdfs:label "Material Copy of a Transcript"@en ;
    rdfs:subClassOf <https://www.commoncoreontologies.org/ont00001298> ;
    skos:definition "A Material Copy of a Document that is designed to carry some specific Information Content Entity that was originally recorded in a different medium."@en .

<https://www.commoncoreontologies.org/ont00000070> a owl:Class ;
    rdfs:label "Ground Track Point"@en ;
    rdfs:subClassOf <http://purl.obolibrary.org/obo/BFO_0000018> ;
    skos:definition "A Zero-Dimensional Spatial Region that is an idealized point located on the surface of an Astronomical Body directly below an Object Track Point."@en .

<https://www.commoncoreontologies.org/ont00000071> a owl:Class ;
    rdfs:label "Town"@en ;
    rdfs:subClassOf <https://www.commoncoreontologies.org/ont00000460> ;
    skos:definition "A Local Administrative Region in which a human population permanently resides that is typically larger than the population of a Village but smaller than that of a City; is designated as a town based on a particular administrative, legal, or historical status; and which delimits a local Government that typically exercises less power than that of a City Government."@en .

<https://www.commoncoreontologies.org/ont00000072> a owl:Class ;
    rdfs:label "Low Density Residential Area"@en ;
    rdfs:subClassOf <https://www.commoncoreontologies.org/ont00000224> ;
    skos:definition "A Populated Place where houses are on lots of more than one acre."@en .

<https://www.commoncoreontologies.org/ont00000074> a owl:Class ;
    rdfs:label "Measurement Unit of Acceleration"@en ;
    rdfs:subClassOf <https://www.commoncoreontologies.org/ont00000120> ;
    skos:definition "A Measurement Unit that is used as a standard for measurement of the rate at which objects change their velocities per unit of time."@en .

<https://www.commoncoreontologies.org/ont00000075> a owl:Class ;
    rdfs:label "Optical Microscope"@en ;
    rdfs:subClassOf <https://www.commoncoreontologies.org/ont00000304> ;
    skos:definition "A Microscope that is designed to use visible light and a system of Optical Lenses to produce a significantly enlarged image of the Object."@en .

<https://www.commoncoreontologies.org/ont00000076> a owl:Class ;
    rdfs:label "Wired Communication Artifact Function"@en ;
    rdfs:subClassOf <https://www.commoncoreontologies.org/ont00000727> ;
    skos:definition "A Communication Artifact Function that is realized in a process that conveys meaningful signs by means of a (usually cylindrical) flexible strand or rod of metal."@en .

<https://www.commoncoreontologies.org/ont00000078> a owl:Class ;
    rdfs:label "Act of Estimation"@en ;
    rdfs:subClassOf <https://www.commoncoreontologies.org/ont00000345> ;
    skos:definition "An Act of Measuring that involves the comparison of a measurement of a similar Entity or of a portion of the Entity being estimated to produce an approximated measurement of the target Entity."@en .

<https://www.commoncoreontologies.org/ont00000079> a owl:Class ;
    rdfs:label "Act of Social Movement"@en ;
    rdfs:subClassOf <https://www.commoncoreontologies.org/ont00001327> ;
    skos:definition "A Social Act composed of a series of performances, displays and campaigns directed at implementing, resisting or undoing a change in society."@en .

<https://www.commoncoreontologies.org/ont00000080> a owl:Class ;
    rdfs:label "Standard Time of Day Identifier"@en ;
    rdfs:subClassOf <https://www.commoncoreontologies.org/ont00000827> ;
    skos:definition "A Time of Day Identifier that designates an approximate Temporal Instant that is part of some Day and is specified using the Hours, Minutes, and Seconds of the Day that preceded the Temporal Instant."@en .

<https://www.commoncoreontologies.org/ont00000081> a owl:Class ;
    rdfs:label "Cutting Weapon"@en ;
    rdfs:subClassOf <https://www.commoncoreontologies.org/ont00000445> ;
    skos:definition "A Weapon that is designed to inflict harm, damage, or incapacity by means of separating some portion of its target into two or more portions through the application of acutely directed force."@en .

<https://www.commoncoreontologies.org/ont00000082> a owl:Class ;
    rdfs:label "Green"@en ;
    rdfs:subClassOf <https://www.commoncoreontologies.org/ont00000378> ;
    skos:definition "A Color that is between Yellow and Cyan with a wavelength in the visible spectrum, typically between 520 to 560 nanometers."@en .

<https://www.commoncoreontologies.org/ont00000083> a owl:Class ;
    rdfs:label "Process Ending"@en ;
    rdfs:subClassOf <http://purl.obolibrary.org/obo/BFO_0000035> ;
    skos:definition "A Process Boundary that occupies a Zero-Dimensional Temporal Region that is the ending instant of the One-Dimensional Temporal Region that the Process, of which the Process Boundary is a part, occupies."@en .

<https://www.commoncoreontologies.org/ont00000085> a owl:Class ;
    rdfs:label "Minute"@en ;
    rdfs:subClassOf <http://purl.obolibrary.org/obo/BFO_0000202> ;
    skos:definition "A Temporal Interval that is equal to sixty consecutive Seconds."@en .

<https://www.commoncoreontologies.org/ont00000086> a owl:Class ;
    rdfs:label "Autopilot System"@en ;
    rdfs:subClassOf <https://www.commoncoreontologies.org/ont00000723> ;
    skos:definition "A Vehicle Control System that is designed to enable some Agent to control the trajectory of a Vehicle without constant 'hands-on' control."@en .

<https://www.commoncoreontologies.org/ont00000087> a owl:Class ;
    rdfs:label "Ordinal Date Identifier"@en ;
    rdfs:subClassOf <https://www.commoncoreontologies.org/ont00000894> ;
    skos:definition "A Decimal Date Identifier that designates some Day by using a number to indicate the sequential ordering of the Day since the beginning of the Year."@en .

<https://www.commoncoreontologies.org/ont00000090> a owl:Class ;
    rdfs:label "Infrared Telescope"@en ;
    rdfs:subClassOf <https://www.commoncoreontologies.org/ont00000547> ;
    skos:definition "A Telescope that is designed to aid in the observation of spatially distant Objects by means of collecting and focusing infrared light to form an enhanced image of the Object."@en .

<https://www.commoncoreontologies.org/ont00000091> a owl:Class ;
    rdfs:label "Portion of Coolant"@en ;
    rdfs:subClassOf <https://www.commoncoreontologies.org/ont00000457> ;
    skos:definition "A Portion of Material that is designed to be used in a thermal control system to reduce or maintain the temperature of an object to or at a specified level."@en .

<https://www.commoncoreontologies.org/ont00000093> a owl:Class ;
    rdfs:label "Preferred Stock"@en ;
    rdfs:subClassOf <https://www.commoncoreontologies.org/ont00001278> ;
    skos:definition "Stock that entitles its holder to receive a certain level of dividend payments before any dividends can be issued to other holders."@en .

<https://www.commoncoreontologies.org/ont00000094> a owl:Class ;
    rdfs:label "Seat of National Government"@en ;
    rdfs:subClassOf <https://www.commoncoreontologies.org/ont00000946> ;
    skos:definition "A Government Building that is designed for the administration of a sovereign nation."@en .

<https://www.commoncoreontologies.org/ont00000096> a owl:Class ;
    rdfs:label "Propulsion System"@en ;
    rdfs:subClassOf <https://www.commoncoreontologies.org/ont00000995> ;
    skos:definition "A Material Artifact that is designed to facilitate the movement of material entities from one location to another and which consists of a source of mechanical power and a means of converting this power into propulsive force to generate the movement."@en .

<https://www.commoncoreontologies.org/ont00000097> a owl:Class ;
    rdfs:label "Complex Optical Lens"@en ;
    rdfs:subClassOf <https://www.commoncoreontologies.org/ont00001207> ;
    skos:definition "An Optical Lens consisting of more than one Simple Optical Lenses."@en .

<https://www.commoncoreontologies.org/ont00000101> a owl:Class ;
    rdfs:label "Portion of Liquid Oxygen"@en ;
    rdfs:subClassOf <https://www.commoncoreontologies.org/ont00000255> ;
    skos:definition "A Portion of Cryogenic Material that is composed (almost) entirely of liquid oxygen."@en .

<https://www.commoncoreontologies.org/ont00000102> a owl:Class ;
    rdfs:label "Skin Type"@en ;
    rdfs:subClassOf <http://purl.obolibrary.org/obo/BFO_0000019> ;
    skos:definition "A Quality inhering in a portion of skin by virtue of its color and natural tendency to respond to ultraviolet light."@en .

<https://www.commoncoreontologies.org/ont00000104> a owl:Class ;
    rdfs:label "Underwater Mine"@en ;
    rdfs:subClassOf <https://www.commoncoreontologies.org/ont00000639> ;
    skos:definition "A Mine that is designed to support the extraction of materials from the ocean floor."@en .

<https://www.commoncoreontologies.org/ont00000105> a owl:Class ;
    rdfs:label "Square"@en ;
    rdfs:subClassOf <https://www.commoncoreontologies.org/ont00001369> ;
    skos:definition "A Rectangular shape which has four equal length sides and four 90 degree angles."@en .

<https://www.commoncoreontologies.org/ont00000106> a owl:Class ;
    rdfs:label "End of Life Stasis"@en ;
    rdfs:subClassOf <https://www.commoncoreontologies.org/ont00001213> ;
    skos:definition "A Stasis of Artifact Operationality that holds during a Temporal Interval when the participating Material Artifact is no longer capable of realizing all of its designed primary Artifact Functions."@en .

<https://www.commoncoreontologies.org/ont00000107> a owl:Class ;
    rdfs:label "Increase of Generically Dependent Continuant"@en ;
    rdfs:subClassOf <https://www.commoncoreontologies.org/ont00001048> ;
    skos:definition "An Increase of Dependent Continuant in which some Independent Continuant has an increase of some Generically Dependent Continuant that it bears."@en .

<https://www.commoncoreontologies.org/ont00000108> a owl:Class ;
    rdfs:label "Rail Facility"@en ;
    rdfs:subClassOf <https://www.commoncoreontologies.org/ont00000226> ;
    skos:definition "A Transportation Facility that is designed for transferring people or cargo to and from Trains."@en .

<https://www.commoncoreontologies.org/ont00000109> a owl:Class ;
    rdfs:label "Act of Military Force"@en ;
    rdfs:subClassOf <https://www.commoncoreontologies.org/ont00000228> ;
    skos:definition "A Planned Act of employing a Military Force to achieve some desired result."@en .

<https://www.commoncoreontologies.org/ont00000111> a owl:Class ;
    rdfs:label "Air Inlet"@en ;
    rdfs:subClassOf <https://www.commoncoreontologies.org/ont00000256> ;
    skos:definition "A Fluid Control Artifact that consists of an opening that is designed to capture and direct the flow of air into the system it is part of."@en .

<https://www.commoncoreontologies.org/ont00000112> a owl:Class ;
    rdfs:label "Translucent"@en ;
    rdfs:subClassOf <https://www.commoncoreontologies.org/ont00001384> ;
    skos:definition "An Opacity that inheres in a bearer in virtue of that bearer's capacity to transmit some but not all electromagnetic radiation of a given frequency through the bearer such that the bearer reflects, scatters, or absorbs some but not all electromagnetic radiation of that frequency."@en .

<https://www.commoncoreontologies.org/ont00000114> a owl:Class ;
    rdfs:label "Unix Temporal Instant"@en ;
    rdfs:subClassOf <http://purl.obolibrary.org/obo/BFO_0000203> ;
    skos:definition "A Temporal Instant as specified by the number of Seconds that have elapsed since the specified Epoch Time as described by an implementation of Unix Time."@en .

<https://www.commoncoreontologies.org/ont00000115> a owl:Class ;
    rdfs:label "Stasis of Disposition"@en ;
    rdfs:subClassOf <https://www.commoncoreontologies.org/ont00000246> ;
    skos:definition "A Stasis of Realizable Entity in which some Independent Continuant bears some Disposition that remains unchanged during a Temporal Interval."@en .

<https://www.commoncoreontologies.org/ont00000116> a owl:Class ;
    rdfs:label "Pump"@en ;
    rdfs:subClassOf <https://www.commoncoreontologies.org/ont00000256> ;
    skos:definition "A Fluid Control Artifact that is designed to impart motion to a portion of fluid to transport it within a system through the use of mechanical action."@en .

<https://www.commoncoreontologies.org/ont00000118> a owl:Class ;
    rdfs:label "Artifact Function Specification"@en ;
    rdfs:subClassOf <https://www.commoncoreontologies.org/ont00000965> ;
    skos:definition "A Prescriptive Information Content Entity that prescribes some Material Artifact Function and which is part of some Material Artifact Model."@en .

<https://www.commoncoreontologies.org/ont00000121> a owl:Class ;
    rdfs:label "Act of Conducting Mass Media Interview"@en ;
    rdfs:subClassOf <https://www.commoncoreontologies.org/ont00000588> ;
    skos:definition "An Act of Mass Media Communication involving a conversation between a reporter and a person of public interest, used as a basis of a broadcast or publication."@en .

<https://www.commoncoreontologies.org/ont00000122> a owl:Class ;
    rdfs:label "Vehicle Track Point"@en ;
    rdfs:subClassOf <https://www.commoncoreontologies.org/ont00000170> ;
    skos:definition "An Object Track Point that is where a Vehicle is or was located during some motion."@en .

<https://www.commoncoreontologies.org/ont00000125> a owl:Class ;
    rdfs:label "Bounding Box Point"@en ;
    rdfs:subClassOf <https://www.commoncoreontologies.org/ont00000373> ;
    skos:definition "A Geospatial Position that is a proper part of some Geospatial Region Bounding Box."@en .

<https://www.commoncoreontologies.org/ont00000128> a owl:Class ;
    rdfs:label "Portion of Liquid Hydrogen"@en ;
    rdfs:subClassOf <https://www.commoncoreontologies.org/ont00000255> ;
    skos:definition "A Portion of Cryogenic Material that is composed (almost) entirely of liquid hydrogen."@en .

<https://www.commoncoreontologies.org/ont00000129> a owl:Class ;
    rdfs:label "Tattoo"@en ;
    rdfs:subClassOf <https://www.commoncoreontologies.org/ont00000084> ;
    skos:definition "A Bodily Component that consists of a typically permanent mark or design on a portion of skin that is created by a process of pricking and ingraining an indelible pigment or by raising scars."@en .

<https://www.commoncoreontologies.org/ont00000130> a owl:Class ;
    rdfs:label "Power Transformer"@en ;
    rdfs:subClassOf <https://www.commoncoreontologies.org/ont00000995> ;
    skos:definition "A Material Artifact that is designed to transfer electrical energy between two or more circuits through electromagnetic induction."@en .

<https://www.commoncoreontologies.org/ont00000131> a owl:Class ;
    rdfs:label "Increase of Quality"@en ;
    rdfs:subClassOf <https://www.commoncoreontologies.org/ont00001214> ;
    skos:definition "An Increase of Specifically Dependent Continuant in which some Indpendent Continuant has an increase of some Quality that it bears."@en .

<https://www.commoncoreontologies.org/ont00000132> a owl:Class ;
    rdfs:label "Recording Device"@en ;
    rdfs:subClassOf <https://www.commoncoreontologies.org/ont00000117> ;
    skos:definition "An Information Processing Artifact that is designed to capture some information and store it in some recording format on some storage medium."@en .

<https://www.commoncoreontologies.org/ont00000134> a owl:Class ;
    rdfs:label "Third-Order Administrative Region"@en ;
    rdfs:subClassOf <https://www.commoncoreontologies.org/ont00001152> ;
    skos:definition "A Government Domain that is a subdivision of a Second-Order Administrative Region."@en .

<https://www.commoncoreontologies.org/ont00000137> a owl:Class ;
    rdfs:label "Act of Financial Deposit"@en ;
    rdfs:subClassOf <https://www.commoncoreontologies.org/ont00000836> ;
    skos:definition "An Act of Financial Instrument Use wherein a Financial Instrument is transferred by an Agent (the Depositor) to another Agent to create a liability to be repaid to the Depositor through an Act of Financial Withdrawal."@en .

<https://www.commoncoreontologies.org/ont00000138> a owl:Class ;
    rdfs:label "Maximum Power"@en ;
    rdfs:subClassOf <https://www.commoncoreontologies.org/ont00000503> ;
    skos:definition "A Power that is characterized by the maximum rate of Work, or Energy consumed, done in a given time period."@en .

<https://www.commoncoreontologies.org/ont00000139> a owl:Class ;
    rdfs:label "Domain of a Country"@en ;
    rdfs:subClassOf <https://www.commoncoreontologies.org/ont00001152> ;
    skos:definition "A Government Domain that is associated with certain distinct political, ethnic, or cultural characteristics, and which delimits a Government that has legitimate authority over a Populace."@en .

<https://www.commoncoreontologies.org/ont00000140> a owl:Class ;
    rdfs:label "Measurement Unit of Amount of Substance"@en ;
    rdfs:subClassOf <https://www.commoncoreontologies.org/ont00000120> ;
    skos:definition "A Measurement Unit that is used as a standard for measurement of the number of a specified type of particle in a portion of matter."@en .

<https://www.commoncoreontologies.org/ont00000141> a owl:Class ;
    rdfs:label "Populace"@en ;
    rdfs:subClassOf <https://www.commoncoreontologies.org/ont00000914> ;
    skos:definition "A Group of Persons forming the total population of some Government Domain."@en .

<https://www.commoncoreontologies.org/ont00000142> a owl:Class ;
    rdfs:label "Act of Government"@en ;
    rdfs:subClassOf <https://www.commoncoreontologies.org/ont00000228> ;
    skos:definition "A Planned Act that is initiated or supported by some Geopolitical Entity and enforced by some Government Agent."@en .

<https://www.commoncoreontologies.org/ont00000143> a owl:Class ;
    rdfs:label "Cargo Cabin"@en ;
    rdfs:subClassOf <https://www.commoncoreontologies.org/ont00000103> ;
    skos:definition "A Vehicle Compartment that is used to store goods or materials during transportation."@en .

<https://www.commoncoreontologies.org/ont00000144> a owl:Class ;
    rdfs:label "Act of Meeting"@en ;
    rdfs:subClassOf <https://www.commoncoreontologies.org/ont00000433> ;
    skos:definition "An Act of Association wherein two or more Persons assemble for some common purpose."@en .

<https://www.commoncoreontologies.org/ont00000145> a owl:Class ;
    rdfs:label "Incendiary Weapon"@en ;
    rdfs:subClassOf <https://www.commoncoreontologies.org/ont00000445> ;
    skos:definition "A Weapon that is designed to inflict harm, damage, or incapacity by means of starting a fire."@en .

<https://www.commoncoreontologies.org/ont00000146> a owl:Class ;
    rdfs:label "Artificial Language"@en ;
    rdfs:subClassOf <https://www.commoncoreontologies.org/ont00001175> ;
    owl:disjointWith <https://www.commoncoreontologies.org/ont00000496> ;
    skos:definition "A Language that is developed through conscious planning and premeditation, rather than one that was developed through use and repetition."@en .

<https://www.commoncoreontologies.org/ont00000147> a owl:Class ;
    rdfs:label "Flight Transponder"@en ;
    rdfs:subClassOf <https://www.commoncoreontologies.org/ont00000325> ;
    skos:definition "A Radio Transponder that is designed to produce a specified response (typically for identification, location, or status update purposes) when it receives a radio-frequency interrogation."@en .

<https://www.commoncoreontologies.org/ont00000148> a owl:Class ;
    rdfs:label "Clockwise Rotational Motion"@en ;
    rdfs:subClassOf <https://www.commoncoreontologies.org/ont00000368> ;
    skos:definition "A Rotational Motion in which the direction of rotation is toward the right as seen relative to the designated side of the plane of rotation."@en .

<https://www.commoncoreontologies.org/ont00000149> a owl:Class ;
    rdfs:label "Instant Messaging"@en ;
    rdfs:subClassOf <https://www.commoncoreontologies.org/ont00000517> ;
    skos:definition "An Act of Communication by Media in which real-time direct text-based communication occurs between two or more people using personal computers or other devices, along with shared Instant Messaging Client Software conveyed over a network, such as the Internet."@en .

<https://www.commoncoreontologies.org/ont00000151> a owl:Class ;
    rdfs:label "Act of Reporting"@en ;
    rdfs:subClassOf <https://www.commoncoreontologies.org/ont00000379> ;
    skos:definition "An Act of Representative Communication performed by giving a detailed account or statement."@en .

<https://www.commoncoreontologies.org/ont00000152> a owl:Class ;
    rdfs:label "Telephone Network"@en ;
    rdfs:subClassOf <https://www.commoncoreontologies.org/ont00000998> ;
    skos:definition "A Telecommunication Network that is designed to allow telephone calls to be made between two or more parties connected to the network."@en .

<https://www.commoncoreontologies.org/ont00000153> a owl:Class ;
    rdfs:label "Generator Control Unit"@en ;
    rdfs:subClassOf <https://www.commoncoreontologies.org/ont00000781> ;
    skos:definition "A Control System that is designed to regulate the voltage of some Electrical Power Source."@en .

<https://www.commoncoreontologies.org/ont00000154> a owl:Class ;
    rdfs:label "Mode Point Estimate Information Content Entity"@en ;
    rdfs:subClassOf <https://www.commoncoreontologies.org/ont00000745> ;
    skos:definition "A Point Estimate Information Content Entity that is a measurement of a set of values and is equal to the value or values that occur most often in the set."@en .

<https://www.commoncoreontologies.org/ont00000155> a owl:Class ;
    rdfs:label "Near Infrared Light Frequency"@en ;
    rdfs:subClassOf <https://www.commoncoreontologies.org/ont00001337> ;
    skos:definition "An Infrared Light Frequency that is between 214 and 400 terahertz."@en .

<https://www.commoncoreontologies.org/ont00000157> a owl:Class ;
    rdfs:label "Facial Hair"@en ;
    rdfs:subClassOf <https://www.commoncoreontologies.org/ont00000084> ;
    skos:definition "A Bodily Component that consists of a portion of hair that grows on the face of a human (typically male) or other animal."@en .

<https://www.commoncoreontologies.org/ont00000158> a owl:Class ;
    rdfs:label "Lithium-ion Electric Battery"@en ;
    rdfs:subClassOf <https://www.commoncoreontologies.org/ont00001105> ;
    skos:definition "A Secondary Cell Electric Battery that produces electricity when lithium ions move from anode to cathode."@en .

<https://www.commoncoreontologies.org/ont00000160> a owl:Class ;
    rdfs:label "Manual Tool"@en ;
    rdfs:subClassOf <https://www.commoncoreontologies.org/ont00000581> ;
    skos:definition "A Tool that is designed to be powered by manual labor rather than by an engine."@en .

<https://www.commoncoreontologies.org/ont00000162> a owl:Class ;
    rdfs:label "Electrical Connector Artifact Function"@en ;
    rdfs:subClassOf <https://www.commoncoreontologies.org/ont00000795> ;
    skos:definition "An Electrical Conduction Artifact Function that is realized by processes in which some Material Artifact is used to join electrical terminations to create an electrical circuit."@en .

<https://www.commoncoreontologies.org/ont00000163> a owl:Class ;
    rdfs:label "z-Axis"@en ;
    rdfs:subClassOf <https://www.commoncoreontologies.org/ont00000161> ;
    skos:definition "A Coordinate System Axis designated by the variable 'z'."@en .

<https://www.commoncoreontologies.org/ont00000164> a owl:Class ;
    rdfs:label "Minimum Ordinal Measurement Information Content Entity"@en ;
    rdfs:subClassOf <https://www.commoncoreontologies.org/ont00001010> ;
    skos:definition "An Ordinal Measurement Information Content Entity that is a measurement of some entity in virtue of it being the smallest or having the least amount relative to a nominally described set of like entities."@en .

<https://www.commoncoreontologies.org/ont00000165> a owl:Class ;
    rdfs:label "Criminal Act"@en ;
    rdfs:subClassOf <https://www.commoncoreontologies.org/ont00000228> ;
    skos:definition "A Planned Act committed in violation of rules or laws for which some governing authority (via mechanisms such as legal systems) can prescribe a conviction."@en .

<https://www.commoncoreontologies.org/ont00000166> a owl:Class ;
    rdfs:label "Wave Cycle"@en ;
    rdfs:subClassOf <https://www.commoncoreontologies.org/ont00000099> ;
    skos:definition "A Wave Process that consists of a portion of a Wave Process that begins at an arbitrary point of the Wave Process and ends at the next point when the pattern of the Wave Process begins to repeat."@en .

<https://www.commoncoreontologies.org/ont00000167> a owl:Class ;
    rdfs:label "Large-Scale Rocket Launcher"@en ;
    rdfs:subClassOf <https://www.commoncoreontologies.org/ont00001173> ;
    skos:definition "A Rocket Launcher that is designed to contain multiple Rocket Launchers."@en .

<https://www.commoncoreontologies.org/ont00000168> a owl:Class ;
    rdfs:label "Act of Interpersonal Relationship"@en ;
    rdfs:subClassOf <https://www.commoncoreontologies.org/ont00000433> ;
    skos:definition "An Act of Association between two or more Persons that may range from fleeting to enduring."@en .

<https://www.commoncoreontologies.org/ont00000171> a owl:Class ;
    rdfs:label "Detergent Artifact Function"@en ;
    rdfs:subClassOf <https://www.commoncoreontologies.org/ont00000344> ;
    skos:definition "A Surfactant Artifact Function that is realized in a process that cleans substances in dilute solutions."@en .

<https://www.commoncoreontologies.org/ont00000172> a owl:Class ;
    rdfs:label "Base of Operations"@en ;
    rdfs:subClassOf <https://www.commoncoreontologies.org/ont00000483> ;
    skos:definition "A Military Base with permanently stationed operating forces, robust Infrastructure, and strengthened force protection measures such that it is designed to launch and support large-scale operations, support smaller or less-permanent bases, and organize supply facilities."@en .

<https://www.commoncoreontologies.org/ont00000173> a owl:Class ;
    rdfs:label "Civilian Role"@en ;
    rdfs:subClassOf <http://purl.obolibrary.org/obo/BFO_0000023> ;
    skos:definition "A Role that inheres in an Agent or Group of Agents by virtue of that Agent or Group of Agents not being part of either an Armed Force or police force."@en .

<https://www.commoncoreontologies.org/ont00000174> a owl:Class ;
    rdfs:label "Ultraviolet Telescope"@en ;
    rdfs:subClassOf <https://www.commoncoreontologies.org/ont00000547> ;
    skos:definition "A Telescope that is designed to aid in the observation of spatially distant Objects by means of collecting and focusing ultraviolet light to form an enhanced image of the Object."@en .

<https://www.commoncoreontologies.org/ont00000175> a owl:Class ;
    rdfs:label "Organization Member Role"@en ;
    rdfs:subClassOf <http://purl.obolibrary.org/obo/BFO_0000023> ;
    skos:definition "A Role that inheres in an Agent in virtue of the responsibilities that Agent is expected to fulfill as a member of some Organization."@en .

<https://www.commoncoreontologies.org/ont00000176> a owl:Class ;
    rdfs:label "Geopolitical Organization"@en ;
    rdfs:subClassOf <https://www.commoncoreontologies.org/ont00001180> ;
    skos:definition "An Organization that bears a Geopolitical Power Role."@en .

<https://www.commoncoreontologies.org/ont00000177> a owl:Class ;
    rdfs:label "Affordance"@en ;
    rdfs:subClassOf <http://purl.obolibrary.org/obo/BFO_0000017> ;
    skos:definition "A Realizable Entity of an Independent Continuant that creates an opportunity for an Agent to realize some Agent Capability or Disposition in some Act."@en .

<https://www.commoncoreontologies.org/ont00000178> a owl:Class ;
    rdfs:label "Arrow"@en ;
    rdfs:subClassOf <https://www.commoncoreontologies.org/ont00001150> ;
    skos:definition "A Portion of Ammunition that is designed to be fired from a Bow and consists of a long straight stiff shaft with stabilizers (fletchings) and a slot (the nock) on one end and a weighted tip (the arrowhead) on the other end."@en .

<https://www.commoncoreontologies.org/ont00000179> a owl:Class ;
    rdfs:label "Thrust"@en ;
    rdfs:subClassOf <https://www.commoncoreontologies.org/ont00000570> ;
    skos:definition "A Force that is equal in magnitude to but in the opposite direction of an exerted Force and which is used to describe the forward Force of a Jet or Rocket Engine in reaction to the Acceleration of its Reaction Mass in the opposite direction."@en .

<https://www.commoncoreontologies.org/ont00000181> a owl:Class ;
    rdfs:label "Language Skill"@en ;
    rdfs:subClassOf <https://www.commoncoreontologies.org/ont00000089> ;
    skos:definition "A Skill that is realized by an Act which is prescribed by a Language."@en .

<https://www.commoncoreontologies.org/ont00000182> a owl:Class ;
    rdfs:label "Act of Thanking"@en ;
    rdfs:subClassOf <https://www.commoncoreontologies.org/ont00000123> ;
    skos:definition "An Act of Expressive Communication performed by expressing gratitude."@en .

<https://www.commoncoreontologies.org/ont00000183> a owl:Class ;
    rdfs:label "Fragrance Artifact Function"@en ;
    rdfs:subClassOf <https://www.commoncoreontologies.org/ont00000323> ;
    skos:definition "An Artifact Function that is realized in processes of emitting a pleasant or sweet odor."@en .

<https://www.commoncoreontologies.org/ont00000184> a owl:Class ;
    rdfs:label "Axial Rotation Period"@en ;
    rdfs:subClassOf <http://purl.obolibrary.org/obo/BFO_0000202> ;
    skos:definition "A Temporal Interval that is equal to the length of time required for a spinning Object to complete one rotation around its Axis of Rotation."@en .

<https://www.commoncoreontologies.org/ont00000185> a owl:Class ;
    rdfs:label "Blunt"@en ;
    rdfs:subClassOf <https://www.commoncoreontologies.org/ont00001059> ;
    skos:definition "A Shape Quality inhering in a bearer in virtue of the bearer not having a sharp edge or point."@en .

<https://www.commoncoreontologies.org/ont00000186> a owl:Class ;
    rdfs:label "Artifact Version Ordinality"@en ;
    rdfs:subClassOf <https://www.commoncoreontologies.org/ont00001010> ;
    skos:definition "An Ordinal Measurement Information Content Entity that is about the form of a Material Artifact which differs in some respects from previous or future forms of that Material Artifact."@en .

<https://www.commoncoreontologies.org/ont00000187> a owl:Class ;
    rdfs:label "Authority Role"@en ;
    rdfs:subClassOf <http://purl.obolibrary.org/obo/BFO_0000023> ;
    skos:definition "A Role that is realized by Processes which create, modify, transfer, or eliminate Process Regulations or other Authority Roles, and inheres in an Agent in virtue of collective acceptance of that Agent's ability to issue binding directives."@en .

<https://www.commoncoreontologies.org/ont00000188> a owl:Class ;
    rdfs:label "Ground Track"@en ;
    rdfs:subClassOf <http://purl.obolibrary.org/obo/BFO_0000026> ;
    skos:definition "A One-Dimensional Spatial Region defined by the line formed on the surface of an Astronomical Body by projecting an imaginary line from the center of the tracked Object to the center of the Astronomical Body as the Object travels above the surface."@en .

<https://www.commoncoreontologies.org/ont00000190> a owl:Class ;
    rdfs:label "Minimum Speed Artifact Function"@en ;
    rdfs:subClassOf <https://www.commoncoreontologies.org/ont00001353> ;
    skos:definition "A Speed Artifact Function that is realized in some process in which the Material Artifact bearing the Artifact Function attains the lowest speed at which that Material Artifact is designed to operate."@en .

<https://www.commoncoreontologies.org/ont00000193> a owl:Class ;
    rdfs:label "Telephone Subscriber Line"@en ;
    rdfs:subClassOf <https://www.commoncoreontologies.org/ont00000059> ;
    skos:definition "A Telephone Line that connects a Communication Endpoint to another node in a Telecommunication Network to enable service to a user's Telephone."@en .

<https://www.commoncoreontologies.org/ont00000194> a owl:Class ;
    rdfs:label "Electrical Contact Artifact Function"@en ;
    rdfs:subClassOf <https://www.commoncoreontologies.org/ont00000795> ;
    skos:definition "An Electrical Conduction Artifact Function that is realized by processes in which some Material Artifact is used as an endpoint of an electrical circuit from which an electrical current is passed via physical contact with the endpoint."@en .

<https://www.commoncoreontologies.org/ont00000195> a owl:Class ;
    rdfs:label "Heliport"@en ;
    rdfs:subClassOf <https://www.commoncoreontologies.org/ont00001078> ;
    skos:definition "An Airport that is designed for launching, receiving, and housing Rotorcraft."@en .

<https://www.commoncoreontologies.org/ont00000196> a owl:Class ;
    rdfs:label "Purple"@en ;
    rdfs:subClassOf <https://www.commoncoreontologies.org/ont00000378> ;
    skos:definition "A Color that is aproximately midway between Red and Blue."@en .

<https://www.commoncoreontologies.org/ont00000197> a owl:Class ;
    rdfs:label "Process Beginning"@en ;
    rdfs:subClassOf <http://purl.obolibrary.org/obo/BFO_0000035> ;
    skos:definition "A Process Boundary that occupies a Zero-Dimensional Temporal Region that is the starting instant of the One-Dimensional Temporal Region that the Process, of which the Process Boundary is a part, occupies."@en .

<https://www.commoncoreontologies.org/ont00000198> a owl:Class ;
    rdfs:label "Measurement Unit of Sound Level"@en ;
    rdfs:subClassOf <https://www.commoncoreontologies.org/ont00000120> ;
    skos:definition "A Measurement Unit that is used as a standard for measurement of the level (the loudness) of sounds."@en .

<https://www.commoncoreontologies.org/ont00000200> a owl:Class ;
    rdfs:label "Act of Pilgrimage"@en ;
    rdfs:subClassOf <https://www.commoncoreontologies.org/ont00000890> ;
    skos:definition "An Act of Travel to a location of importance to a person's beliefs and faith."@en .

<https://www.commoncoreontologies.org/ont00000201> a owl:Class ;
    rdfs:label "Act of Change of Residence"@en ;
    rdfs:subClassOf <https://www.commoncoreontologies.org/ont00000065> ;
    skos:definition "An Act of Location Change involving one or more Persons moving from one place of residence to another."@en .

<https://www.commoncoreontologies.org/ont00000202> a owl:Class ;
    rdfs:label "Act of Terrorist Training Instruction"@en ;
    rdfs:subClassOf <https://www.commoncoreontologies.org/ont00001075> ;
    skos:definition "An Act of Training Instruction performed by an Agent who realizes a capacity derived from the Agent's affiliation with some Terrorist Organization by imparting knowledge of the tactics, techniques, and/or strategies of the use of violence against civilians in order to attain goals that are political, religous, or ideological in nature to an Agent either directly or indirectly through some communication medium."@en .

<https://www.commoncoreontologies.org/ont00000203> a owl:Class ;
    rdfs:label "Event Status Nominal Information Content Entity"@en ;
    rdfs:subClassOf <https://www.commoncoreontologies.org/ont00000293> ;
    skos:definition "A Nominal Measurement Information Content Entity that is a measurement of the current state of a process."@en .

<https://www.commoncoreontologies.org/ont00000206> a owl:Class ;
    rdfs:label "Friction Reduction Artifact Function"@en ;
    rdfs:subClassOf <https://www.commoncoreontologies.org/ont00000323> ;
    skos:definition "An Artifact Function that is realized in processes of reducing the force resisting the relative motion of surfaces in contact."@en .

<https://www.commoncoreontologies.org/ont00000208> a owl:Class ;
    rdfs:label "Act of Congratulating"@en ;
    rdfs:subClassOf <https://www.commoncoreontologies.org/ont00000123> ;
    skos:definition "An Act of Expressive Communication performed by expressing vicarious pleasure to a person on the occasion of their success or good fortune."@en .

<https://www.commoncoreontologies.org/ont00000209> a owl:Class ;
    rdfs:label "Sound Wavelength"@en ;
    rdfs:subClassOf <https://www.commoncoreontologies.org/ont00000313> ;
    skos:definition "A Wavelength that is the distance a Sound Wave traverses during one Wave Cycle."@en .

<https://www.commoncoreontologies.org/ont00000211> a owl:Class ;
    rdfs:label "Multi-Day Temporal Interval"@en ;
    rdfs:subClassOf <http://purl.obolibrary.org/obo/BFO_0000038> ;
    skos:definition "A one-dimensional temporal region that is measured in Days and spans at least one Day."@en .

<https://www.commoncoreontologies.org/ont00000212> a owl:Class ;
    rdfs:label "Chemical Weapon"@en ;
    rdfs:subClassOf <https://www.commoncoreontologies.org/ont00000445> ;
    skos:definition "A Weapon that is designed to inflict harm, damage, or incapacity by means of releasing toxic chemicals."@en .

<https://www.commoncoreontologies.org/ont00000213> a owl:Class ;
    rdfs:label "Subcontinent"@en ;
    rdfs:subClassOf <https://www.commoncoreontologies.org/ont00000472> ;
    skos:definition "A Geospatial Region that is bounded by a large, relatively self-contained landmass forming a subdivision of a Continent."@en .

<https://www.commoncoreontologies.org/ont00000216> a owl:Class ;
    rdfs:label "Shell"@en ;
    rdfs:subClassOf <https://www.commoncoreontologies.org/ont00001150> ;
    skos:definition "A Portion of Ammunition that is designed to be a non-self-propelled projectile and to carry a payload (explosive or other) over a relatively short distance."@en .

<https://www.commoncoreontologies.org/ont00000217> a owl:Class ;
    rdfs:label "Measurement Unit of Area"@en ;
    rdfs:subClassOf <https://www.commoncoreontologies.org/ont00000120> ;
    skos:definition "A Measurement Unit that is used as a standard for measurement of two-dimensional regions or Geospatial Regions."@en .

<https://www.commoncoreontologies.org/ont00000218> a owl:Class ;
    rdfs:label "Major Axis"@en ;
    rdfs:subClassOf <http://purl.obolibrary.org/obo/BFO_0000026> ;
    skos:definition "A One-Dimensional Spatial Region that is the longest line segment that connects two points on the edge of an Ellipse."@en .

<https://www.commoncoreontologies.org/ont00000219> a owl:Class ;
    rdfs:label "Reflecting Optical Telescope"@en ;
    rdfs:subClassOf <https://www.commoncoreontologies.org/ont00001009> ;
    skos:definition "An Optical Telescope that is designed to aid in the observation of spatially distant Objects by means of collecting and focusing visible light via reflection through the use of one or more curved Mirrors to form an enhanced image of the Object."@en .

<https://www.commoncoreontologies.org/ont00000220> a owl:Class ;
    rdfs:label "Ammunition Depot"@en ;
    rdfs:subClassOf <https://www.commoncoreontologies.org/ont00000881> ;
    skos:definition "A Storage Facility that is designed to store Portions of Ammunition."@en .

<https://www.commoncoreontologies.org/ont00000221> a owl:Class ;
    rdfs:label "Semi-Minor Axis"@en ;
    rdfs:subClassOf <http://purl.obolibrary.org/obo/BFO_0000026> ;
    skos:definition "A One-Dimensional Spatial Region that is equal to half the length of the Minor Axis of an Ellipse."@en .

<https://www.commoncoreontologies.org/ont00000222> a owl:Class ;
    rdfs:label "Presence Frequency"@en ;
    rdfs:subClassOf <https://www.commoncoreontologies.org/ont00000530> ;
    skos:definition "A Sonic Frequency that is between 4 and 6 kHz."@en .

<https://www.commoncoreontologies.org/ont00000227> a owl:Class ;
    rdfs:label "Julian Year"@en ;
    rdfs:subClassOf <https://www.commoncoreontologies.org/ont00000674> ;
    skos:definition "A Calendar Year in the Julian Calendar."@en .

<https://www.commoncoreontologies.org/ont00000229> a owl:Class ;
    rdfs:label "Measurement Unit of Power"@en ;
    rdfs:subClassOf <https://www.commoncoreontologies.org/ont00000120> ;
    skos:definition "A Measurement Unit that is used as a standard for measurement of rates of work."@en .

<https://www.commoncoreontologies.org/ont00000230> a owl:Class ;
    rdfs:label "Diffraction Grating"@en ;
    rdfs:subClassOf <https://www.commoncoreontologies.org/ont00000136> ;
    skos:definition "An Optical Instrument with a periodic structure that is designed to split and defract a beam of light into several beams travelling in different directions."@en .

<https://www.commoncoreontologies.org/ont00000231> a owl:Class ;
    rdfs:label "Torpedo Tube"@en ;
    rdfs:subClassOf <https://www.commoncoreontologies.org/ont00001051> ;
    skos:definition "A Projectile Launcher that is designed to launch Torpedoes."@en .

<https://www.commoncoreontologies.org/ont00000232> a owl:Class ;
    rdfs:label "Pumping Station"@en ;
    rdfs:subClassOf <https://www.commoncoreontologies.org/ont00000677> ;
    skos:definition "A Product Transport Facility that is designed to pump fluids from one place to another."@en .

<https://www.commoncoreontologies.org/ont00000233> a owl:Class ;
    rdfs:label "Stock Certificate"@en ;
    rdfs:subClassOf <https://www.commoncoreontologies.org/ont00001278> ;
    skos:definition "Stock that consists of a Certificate."@en .

<https://www.commoncoreontologies.org/ont00000235> a owl:Class ;
    rdfs:label "Act of Vocational Training Acquisition"@en ;
    rdfs:subClassOf <https://www.commoncoreontologies.org/ont00000687> ;
    skos:definition "An Act of Training Acquisition performed by an Agent by acquiring skills required for a specific occupation in industry, agriculture or trade from an Agent or communication medium that realizes a capacity derived from its affiliation with a Vocational School, Technical School, Trade Organization, or Industry Educational Program Provider."@en .

<https://www.commoncoreontologies.org/ont00000237> a owl:Class ;
    rdfs:label "Act of Terrorist Training Acquisition"@en ;
    rdfs:subClassOf <https://www.commoncoreontologies.org/ont00000687> ;
    skos:definition "An Act of Training Acquisition performed by an Agent by acquiring knowledge of the tactics, techniques, and/or strategies of the use of violence against civilians in order to attain goals that are political, religous, or ideological in nature from an Agent or communication medium that realizes a capacity derived from its affiliation with a Terrorist Organization."@en .

<https://www.commoncoreontologies.org/ont00000239> a owl:Class ;
    rdfs:label "Measurement Unit of Mass"@en ;
    rdfs:subClassOf <https://www.commoncoreontologies.org/ont00000120> ;
    skos:definition "A Measurement Unit that is used as a standard for measurement of an object's resistance to Acceleration when a Force is applied to the object."@en .

<https://www.commoncoreontologies.org/ont00000240> a owl:Class ;
    rdfs:label "Act of Oath Taking"@en ;
    rdfs:subClassOf <https://www.commoncoreontologies.org/ont00001162> ;
