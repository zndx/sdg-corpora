    rdfs:label "has altitude value"@en .

<https://www.commoncoreontologies.org/ont00001764> a owl:DatatypeProperty ;
    rdfs:label "has longitude value"@en ;
    rdfs:range xsd:decimal ;
    skos:definition "A Data Property that has as its range the longitude value from some Geospatial Location coordinates set expressed in decimal degrees."@en .

<https://www.commoncoreontologies.org/ont00001765> a owl:DatatypeProperty ;
    rdfs:label "has text value"@en ;
    rdfs:domain <https://www.commoncoreontologies.org/ont00000253> ;
    skos:definition "A data property that has as its range a string value."@en .

<https://www.commoncoreontologies.org/ont00001766> a owl:DatatypeProperty ;
    rdfs:label "has latitude value"@en ;
    rdfs:range xsd:decimal ;
    skos:definition "A Data Property that has as its range the latitude value from some Geospatial Location coordinates set expressed in decimal degrees."@en .

<https://www.commoncoreontologies.org/ont00001767> a owl:DatatypeProperty ;
    rdfs:label "has datetime value"@en ;
    rdfs:domain <https://www.commoncoreontologies.org/ont00000253> ;
    rdfs:range xsd:dateTime ;
    skos:definition "A data property that has as its value a datetime value."@en .

<https://www.commoncoreontologies.org/ont00001768> a owl:DatatypeProperty ;
    rdfs:label "has URI value"@en ;
    rdfs:domain <https://www.commoncoreontologies.org/ont00000253> ;
    rdfs:range xsd:anyURI ;
    skos:definition "A data property that has as its range a URI value."@en .

<https://www.commoncoreontologies.org/ont00001769> a owl:DatatypeProperty ;
    rdfs:label "has decimal value"@en ;
    rdfs:domain <https://www.commoncoreontologies.org/ont00000253> ;
    rdfs:range xsd:decimal ;
    skos:definition "A data property that has as its range a decimal value."@en .

<https://www.commoncoreontologies.org/ont00001770> a owl:DatatypeProperty ;
    rdfs:label "has double value"@en ;
    rdfs:domain <https://www.commoncoreontologies.org/ont00000253> ;
    rdfs:range xsd:double ;
    skos:definition "A data property that has as its range a double value."@en .

<https://www.commoncoreontologies.org/ont00001771> a owl:DatatypeProperty ;
    rdfs:label "has date value"@en ;
    rdfs:domain <https://www.commoncoreontologies.org/ont00000253> ;
    skos:definition "A data property that has as its range a date value."@en .

<https://www.commoncoreontologies.org/ont00001772> a owl:DatatypeProperty ;
    rdfs:label "has boolean value"@en ;
    rdfs:domain <https://www.commoncoreontologies.org/ont00000253> ;
    rdfs:range xsd:boolean ;
    skos:definition "A data property that has as its range a boolean value."@en .

<https://www.commoncoreontologies.org/ont00001773> a owl:DatatypeProperty ;
    rdfs:label "has integer value"@en ;
    rdfs:domain <https://www.commoncoreontologies.org/ont00000253> ;
    rdfs:range xsd:integer ;
    skos:definition "A data property that has as its range an integer value."@en .

<https://www.commoncoreontologies.org/ont00001775> a owl:ObjectProperty ;
    rdfs:label "is successor of"@en ;
    rdfs:domain <http://purl.obolibrary.org/obo/BFO_0000004> ;
    rdfs:range <http://purl.obolibrary.org/obo/BFO_0000004> ;
    skos:definition "x is successor of y =Def y is predecessor of x"@en .

<https://www.commoncoreontologies.org/ont00001777> a owl:ObjectProperty ;
    rdfs:label "has process part"@en ;
    rdfs:domain <http://purl.obolibrary.org/obo/BFO_0000015> ;
    rdfs:range <http://purl.obolibrary.org/obo/BFO_0000015> ;
    skos:definition "x has process part y =Def y is part of process x"@en .

<https://www.commoncoreontologies.org/ont00001778> a owl:ObjectProperty ;
    rdfs:label "has object"@en ;
    rdfs:domain <http://purl.obolibrary.org/obo/BFO_0000015> ;
    skos:definition "x has object y =Def y is object of x"@en .

<https://www.commoncoreontologies.org/ont00001779> a owl:ObjectProperty ;
    rdfs:label "has inside instant"@en ;
    rdfs:domain <http://purl.obolibrary.org/obo/BFO_0000038> ;
    rdfs:range <http://purl.obolibrary.org/obo/BFO_0000203> ;
    skos:definition "x has_inside_instant y iff x is an instance of One Dimensional Temporal Region and y is an instance of Temporal Instant and y is_inside_instant_of x."@en .

<https://www.commoncoreontologies.org/ont00001782> a owl:ObjectProperty ;
    rdfs:label "has all members located in"@en ;
    rdfs:domain <http://purl.obolibrary.org/obo/BFO_0000027> ;
    skos:definition "x has all members located in y iff x is an instance of Object Aggregate and y is an instance of independent continuant but not a spatial region, and every member of x is located in y."@en .

<https://www.commoncoreontologies.org/ont00001787> a owl:ObjectProperty ;
    rdfs:label "agent in"@en ;
    rdfs:domain <https://www.commoncoreontologies.org/ont00001017> ;
    rdfs:range <http://purl.obolibrary.org/obo/BFO_0000015> ;
    skos:definition "x agent_in y iff y is an instance of Process and x is an instance of Agent, such that x is causally active in y."@en .

<https://www.commoncoreontologies.org/ont00001791> a owl:ObjectProperty ;
    rdfs:label "coincides with"@en ;
    rdfs:domain <http://purl.obolibrary.org/obo/BFO_0000141> ;
    rdfs:range <http://purl.obolibrary.org/obo/BFO_0000141> ;
    skos:definition "x coincides_with y iff x and y are both instances of Immaterial Entity and x is a spatial part of y and y is a spatial part of x."@en .

<https://www.commoncoreontologies.org/ont00001794> a owl:ObjectProperty ;
    rdfs:label "has subsidiary"@en ;
    rdfs:domain <https://www.commoncoreontologies.org/ont00001180> ;
    rdfs:range <https://www.commoncoreontologies.org/ont00001180> ;
    skos:definition "x has subsidiary y =Def y is subsidiary of x"@en .

<https://www.commoncoreontologies.org/ont00001795> a owl:ObjectProperty ;
    rdfs:label "has inside interval"@en ;
    rdfs:domain <http://purl.obolibrary.org/obo/BFO_0000202> ;
    rdfs:range <http://purl.obolibrary.org/obo/BFO_0000202> ;
    skos:definition "x has inside interval y =Def y interval during x"@en .

<https://www.commoncoreontologies.org/ont00001796> a owl:ObjectProperty ;
    rdfs:label "tangential part of"@en ;
    rdfs:domain <http://purl.obolibrary.org/obo/BFO_0000141> ;
    rdfs:range <http://purl.obolibrary.org/obo/BFO_0000141> ;
    skos:definition "x tangential_part_of y iff x and y are both instances of Immaterial Entity and x is a spatial part of y and there exists an instance of Immaterial Entity z such that z externally connects with x and z externally connects with y."@en .

<https://www.commoncoreontologies.org/ont00001797> a owl:ObjectProperty ;
    rdfs:label "partially overlaps with"@en ;
    rdfs:domain <http://purl.obolibrary.org/obo/BFO_0000141> ;
    rdfs:range <http://purl.obolibrary.org/obo/BFO_0000141> ;
    skos:definition "x partially overlaps with y iff x and y are both instances of Immaterial Entity and x overlaps with y and x is not a spatial part of y and y is not a spatial part of x."@en .

<https://www.commoncoreontologies.org/ont00001798> a owl:ObjectProperty ;
    rdfs:label "is supervised by"@en ;
    rdfs:domain <https://www.commoncoreontologies.org/ont00001262> ;
    rdfs:range <https://www.commoncoreontologies.org/ont00001262> ;
    skos:definition "x is_supervised_by y iff x and y are both instances of Person and y supervises x."@en .

<https://www.commoncoreontologies.org/ont00001799> a owl:ObjectProperty ;
    rdfs:label "role of aggregate"@en ;
    rdfs:domain <http://purl.obolibrary.org/obo/BFO_0000023> ;
    rdfs:range <http://purl.obolibrary.org/obo/BFO_0000027> ;
    skos:definition "x role_of_aggregate y iff y is an instance of Object Aggregate and x is an instance of Role, and x inheres_in_aggregate y."@en .

<https://www.commoncoreontologies.org/ont00001800> a owl:ObjectProperty ;
    rdfs:label "prohibits"@en ;
    rdfs:domain <https://www.commoncoreontologies.org/ont00001324> ;
    rdfs:range <http://purl.obolibrary.org/obo/BFO_0000015> ;
    skos:definition "x prohibits y at t iff: x is an instance of Process Regulation at time t, and y is an instance of Process at time t, and x prescribes that some y must not occur."@en .

<https://www.commoncoreontologies.org/ont00001801> a owl:ObjectProperty ;
    rdfs:label "is subject of"@en ;
    rdfs:domain <http://purl.obolibrary.org/obo/BFO_0000001> ;
    rdfs:range <https://www.commoncoreontologies.org/ont00000958> ;
    skos:definition "x is subject of y =Def y is about x"@en .

<https://www.commoncoreontologies.org/ont00001803> a owl:ObjectProperty ;
    rdfs:label "is cause of"@en ;
    rdfs:domain <http://purl.obolibrary.org/obo/BFO_0000015> ;
    rdfs:range <http://purl.obolibrary.org/obo/BFO_0000015> ;
    skos:definition "x is_cause_of y iff x and y are instances of Process, and y is a consequence of x."@en .

<https://www.commoncoreontologies.org/ont00001805> a owl:ObjectProperty ;
    rdfs:label "is disrupted by"@en ;
    rdfs:domain <http://purl.obolibrary.org/obo/BFO_0000015> ;
    rdfs:range <http://purl.obolibrary.org/obo/BFO_0000015> ;
    skos:definition "x is disrupted by y =Def y disrupts x" .

<https://www.commoncoreontologies.org/ont00001807> a owl:ObjectProperty ;
    rdfs:label "is required by"@en ;
    rdfs:domain <http://purl.obolibrary.org/obo/BFO_0000015> ;
    rdfs:range <https://www.commoncoreontologies.org/ont00001324> ;
    skos:definition "x is required by y =Def y requires x"@en .

<https://www.commoncoreontologies.org/ont00001808> a owl:ObjectProperty ;
    rdfs:label "is about"@en ;
    rdfs:domain <https://www.commoncoreontologies.org/ont00000958> ;
    rdfs:range <http://purl.obolibrary.org/obo/BFO_0000001> ;
    skos:definition "x is_about y is a primitive relationship between an instance of Information Content Entity x and an instance of Entity y."@en .

<https://www.commoncoreontologies.org/ont00001809> a owl:ObjectProperty ;
    rdfs:label "inheres in aggregate"@en ;
    rdfs:range <http://purl.obolibrary.org/obo/BFO_0000027> ;
    skos:definition "x inheres_in_aggregate y iff x is an instance of Specifically Dependent Continuant or Generically Dependent Continuant and y is an instance of Object Aggregate and y aggregate_bearer_of x."@en .

<https://www.commoncoreontologies.org/ont00001810> a owl:ObjectProperty ;
    rdfs:label "connected with"@en ;
    rdfs:domain <http://purl.obolibrary.org/obo/BFO_0000141> ;
    rdfs:range <http://purl.obolibrary.org/obo/BFO_0000141> ;
    skos:definition "x is_connected_with y iff x and y are both instances of Immaterial Entity and there exists an instance of Immaterial Entity z that is part of both x and y."@en .

<https://www.commoncoreontologies.org/ont00001811> a owl:ObjectProperty ;
    rdfs:label "is an ordinal measurement of"@en ;
    rdfs:domain <https://www.commoncoreontologies.org/ont00001010> ;
    rdfs:range <http://purl.obolibrary.org/obo/BFO_0000001> ;
    skos:definition "x is_an_ordinal_measurement_of y iff x is an instance of Ordinal Measurement Information Content Entity and y is an instance of Entity and y is_measured_by_ordinal x."@en .

<https://www.commoncoreontologies.org/ont00001813> a owl:ObjectProperty ;
    rdfs:label "uses"@en ;
    rdfs:domain <https://www.commoncoreontologies.org/ont00001017> ;
    rdfs:range <http://purl.obolibrary.org/obo/BFO_0000040> ;
    skos:definition "x uses y iff x is an instance of an Agent and y is an instance of a Material Entity, such that both x and y participate in some instance of a Process wherein x attempts to accomplish a goal by manipulating, deploying, or leveraging some attribute of y."@en .

<https://www.commoncoreontologies.org/ont00001814> a owl:ObjectProperty ;
    rdfs:label "interval finishes"@en ;
    rdfs:domain <http://purl.obolibrary.org/obo/BFO_0000202> ;
    rdfs:range <http://purl.obolibrary.org/obo/BFO_0000202> ;
    skos:definition "x interval_finishes y iff x and y are both instances of Temporal Interval and there exist instances of Temporal Instant v, w, and z such that v is the starting instant of x, w is the ending instant of both x and y, z is the starting instant of y, and z is before v."@en .

<https://www.commoncoreontologies.org/ont00001815> a owl:ObjectProperty ;
    rdfs:label "is subsidiary of"@en ;
    rdfs:domain <https://www.commoncoreontologies.org/ont00001180> ;
    rdfs:range <https://www.commoncoreontologies.org/ont00001180> ;
    skos:definition "x is_subsidiary_of y iff x and y are both instances of Organization and y controls x by having the capacity to determine the outcome of decisions about the financial and operating policies of x. "@en .

<https://www.commoncoreontologies.org/ont00001816> a owl:ObjectProperty ;
    rdfs:label "is output of"@en ;
    rdfs:range <http://purl.obolibrary.org/obo/BFO_0000015> ;
    skos:definition "x is output of y =Def x participates in y, x is an Independent Continuant (but not a Spatial Region), y is a Process, and the presence of x at the end of y is a necessary condition for the completion of y."@en .

<https://www.commoncoreontologies.org/ont00001817> a owl:ObjectProperty ;
    rdfs:label "is prohibited by"@en ;
    rdfs:domain <http://purl.obolibrary.org/obo/BFO_0000015> ;
    rdfs:range <https://www.commoncoreontologies.org/ont00001324> ;
    skos:definition "x is prohibited by y =Def y prohibits x"@en .

<https://www.commoncoreontologies.org/ont00001819> a owl:ObjectProperty ;
    rdfs:label "caused by"@en ;
    rdfs:domain <http://purl.obolibrary.org/obo/BFO_0000003> ;
    rdfs:range <http://purl.obolibrary.org/obo/BFO_0000003> ;
    skos:definition "x caused by y =Def y is cause of x"@en .

<https://www.commoncoreontologies.org/ont00001821> a owl:ObjectProperty ;
    rdfs:label "interval finished by"@en ;
    rdfs:domain <http://purl.obolibrary.org/obo/BFO_0000202> ;
    rdfs:range <http://purl.obolibrary.org/obo/BFO_0000202> ;
    skos:definition "x interval finished by y =Def y interval finishes x"@en .

<https://www.commoncoreontologies.org/ont00001822> a owl:ObjectProperty ;
    rdfs:label "interval equals"@en ;
    rdfs:domain <http://purl.obolibrary.org/obo/BFO_0000202> ;
    rdfs:range <http://purl.obolibrary.org/obo/BFO_0000202> ;
    skos:definition "x interval_equals y iff x and y are both instances of Temporal Interval and there exist instances of Temporal Instant w and z such that w is the starting instant of both x and y and z is the ending instant of both x and y."@en .

<https://www.commoncoreontologies.org/ont00001824> a owl:ObjectProperty ;
    rdfs:label "is excerpted from"@en ;
    rdfs:domain <https://www.commoncoreontologies.org/ont00000253> ;
    rdfs:range <https://www.commoncoreontologies.org/ont00000253> ;
    skos:definition "An Information Bearing Entity b1 is excerpted from another Information Bearing Entity B2 iff b1 is part of some Information Bearing Entity B1 that is carrier of some Information Content Entity C1, B2 is carrier of some Information Content Entity C2, C1 is not identical with C2, b1 is carrier of some Information Content Entity c1, b2 is an Information Bearing Entity that is part of B2 and b2 is carrier of c1 (i.e. the same Information Content Entity as borne by b1)."@en .

<https://www.commoncoreontologies.org/ont00001825> a owl:ObjectProperty ;
    rdfs:label "interval overlaps"@en ;
    rdfs:domain <http://purl.obolibrary.org/obo/BFO_0000202> ;
    rdfs:range <http://purl.obolibrary.org/obo/BFO_0000202> ;
    skos:definition "x interval overlaps y =Def y interval overlapped by x"@en .

<https://www.commoncoreontologies.org/ont00001827> a owl:ObjectProperty ;
    rdfs:label "nontangential part of"@en ;
    rdfs:domain <http://purl.obolibrary.org/obo/BFO_0000141> ;
    rdfs:range <http://purl.obolibrary.org/obo/BFO_0000141> ;
    skos:definition "x nontangential_part_of y iff x and y are both instances of Immaterial Entity and x is a spatial part of y and there does not exist an instance of Immaterial Entity z such that z externally connects with x and z externally connects with y."@en .

<https://www.commoncoreontologies.org/ont00001829> a owl:ObjectProperty ;
    rdfs:label "disposition of aggregate"@en ;
    rdfs:domain <http://purl.obolibrary.org/obo/BFO_0000016> ;
    rdfs:range <http://purl.obolibrary.org/obo/BFO_0000027> ;
    skos:definition "x disposition_of_aggregate y iff y is an instance of Object Aggregate and x is an instance of Disposition, and x inheres_in_aggregate y."@en .

<https://www.commoncoreontologies.org/ont00001830> a owl:ObjectProperty ;
    rdfs:label "has accomplice"@en ;
    rdfs:domain <http://purl.obolibrary.org/obo/BFO_0000015> ;
    rdfs:range <https://www.commoncoreontologies.org/ont00001017> ;
    skos:definition "x has accomplice y =Def y accomplice in x"@en .

<https://www.commoncoreontologies.org/ont00001831> a owl:ObjectProperty ;
    rdfs:label "is subordinate role to"@en ;
    rdfs:domain <http://purl.obolibrary.org/obo/BFO_0000023> ;
    rdfs:range <http://purl.obolibrary.org/obo/BFO_0000023> ;
    skos:definition "For all x,y,t: y is subordinate role to x at t iff: x is an instance of Role at time t, and y is an instance of Role at time t, and there is some z such that x is realized by z and z is an instance of Process which creates, modifies, transfers, or eliminates some u such that u is a Process Regulation at time t, and u is addressed to the bearer of y."@en .

<https://www.commoncoreontologies.org/ont00001832> a owl:ObjectProperty ;
    rdfs:label "has some member located in"@en ;
    rdfs:domain <http://purl.obolibrary.org/obo/BFO_0000027> ;
    skos:definition "x has some member located in y iff x is an instance of Object Aggregate and y is an instance of independent continuant but not a spatial region, and at least one member of x is located in y."@en .

<https://www.commoncoreontologies.org/ont00001833> a owl:ObjectProperty ;
    rdfs:label "has agent"@en ;
    rdfs:domain <http://purl.obolibrary.org/obo/BFO_0000015> ;
    rdfs:range <https://www.commoncoreontologies.org/ont00001017> ;
    skos:definition "x has agent y =Def y agent in x"@en .

<https://www.commoncoreontologies.org/ont00001834> a owl:ObjectProperty ;
    rdfs:label "affects"@en ;
    rdfs:domain <http://purl.obolibrary.org/obo/BFO_0000015> ;
    skos:definition "x affects y =Def y is affected by x"@en .

<https://www.commoncoreontologies.org/ont00001836> a owl:ObjectProperty ;
    rdfs:label "aggregate bearer of"@en ;
    rdfs:domain <http://purl.obolibrary.org/obo/BFO_0000027> ;
    skos:definition "x aggregate bearer of y =Def y inheres in aggregate x"@en .

<https://www.commoncoreontologies.org/ont00001837> a owl:ObjectProperty ;
    rdfs:label "time zone identifier used by"@en ;
    rdfs:domain <https://www.commoncoreontologies.org/ont00000829> ;
    rdfs:range <https://www.commoncoreontologies.org/ont00000253> ;
    skos:definition "x time_zone_identifier_used_by y iff y is an instance of Information Bearing Entity and x is an instance of Time Zone Identifier, such that x designates the spatial region associated with the time zone mentioned in y."@en .

<https://www.commoncoreontologies.org/ont00001838> a owl:ObjectProperty ;
    rdfs:label "disconnected with"@en ;
    rdfs:domain <http://purl.obolibrary.org/obo/BFO_0000141> ;
    rdfs:range <http://purl.obolibrary.org/obo/BFO_0000141> ;
    skos:definition "x disconnected_with y iff x and y are both instances of Immaterial Entity and there does not exist some immaterial entity z that is part of both x and y."@en .

<https://www.commoncoreontologies.org/ont00001841> a owl:ObjectProperty ;
    rdfs:label "is input of"@en ;
    rdfs:range <http://purl.obolibrary.org/obo/BFO_0000015> ;
    skos:definition "x is input of y =Def x participates in y, x is an Independent Continuant (but not a Spatial Region), y is a Process, and the presence of x at the beginning of y is a necessary condition for the start of y."@en .

<https://www.commoncoreontologies.org/ont00001844> a owl:ObjectProperty ;
    rdfs:label "has sender"@en ;
    rdfs:domain <https://www.commoncoreontologies.org/ont00000402> ;
    rdfs:range <https://www.commoncoreontologies.org/ont00001017> ;
    skos:definition "x has sender y =Def y sends x"@en .

<https://www.commoncoreontologies.org/ont00001845> a owl:ObjectProperty ;
    rdfs:label "is site of"@en ;
    rdfs:domain <http://purl.obolibrary.org/obo/BFO_0000029> ;
    rdfs:range <http://purl.obolibrary.org/obo/BFO_0000015> ;
    skos:definition "x is site of y =Def y occurs at x"@en .

<https://www.commoncoreontologies.org/ont00001846> a owl:ObjectProperty ;
    rdfs:label "is organizational context of"@en ;
    rdfs:domain <https://www.commoncoreontologies.org/ont00001180> ;
    rdfs:range <http://purl.obolibrary.org/obo/BFO_0000023> ;
    skos:definition "x is_organizational_context_of y iff x is an instance of an Organization and y is an instance of a Role and z is an instance of a Person, such that z's affiliation with x is a prerequisite for z bearing y, or x ascribes y to the bearer of y."@en .

<https://www.commoncoreontologies.org/ont00001847> a owl:ObjectProperty ;
    rdfs:label "interval is after"@en ;
    rdfs:domain <http://purl.obolibrary.org/obo/BFO_0000202> ;
    rdfs:range <http://purl.obolibrary.org/obo/BFO_0000202> ;
    skos:definition "x interval is after y =Def y interval is before x"@en .

<https://www.commoncoreontologies.org/ont00001848> a owl:ObjectProperty ;
    rdfs:label "is inside instant of"@en ;
    rdfs:domain <http://purl.obolibrary.org/obo/BFO_0000203> ;
    rdfs:range <http://purl.obolibrary.org/obo/BFO_0000038> ;
    skos:definition "x is_inside_instant of y iff x is an instance of Temporal Instant and y is an instance of One-Dimensional Temporal Region and there are instances of Temporal Instant w and z that are part of y and non-identical to x such that w precedes x and z is preceded by x."@en .

<https://www.commoncoreontologies.org/ont00001852> a owl:ObjectProperty ;
    rdfs:label "accessory in"@en ;
    rdfs:domain <https://www.commoncoreontologies.org/ont00001017> ;
    rdfs:range <http://purl.obolibrary.org/obo/BFO_0000015> ;
    skos:definition "x is_accessory_in y iff x is an instance of Agent and y is an instance of Process such that x assists another instance of Agent z in the commission of y, and x was not located at the location of y when y occurred, and x is not an agent_in y."@en .

<https://www.commoncoreontologies.org/ont00001855> a owl:ObjectProperty ;
    rdfs:label "has spatial part"@en ;
    rdfs:domain <http://purl.obolibrary.org/obo/BFO_0000141> ;
    rdfs:range <http://purl.obolibrary.org/obo/BFO_0000141> ;
    skos:definition "x has spatial part y =Def y spatial part of x"@en .

<https://www.commoncoreontologies.org/ont00001857> a owl:ObjectProperty ;
    rdfs:label "is part of process"@en ;
    skos:definition "x is part of process y iff x is occurrent part of y, x and y are Processes, and x occupies a temporal region that is a proper occurrent part of the temporal interval of y."@en .

<https://www.commoncoreontologies.org/ont00001859> a owl:ObjectProperty ;
    rdfs:label "is delimited by"@en ;
    rdfs:domain <https://www.commoncoreontologies.org/ont00001180> ;
    rdfs:range <https://www.commoncoreontologies.org/ont00001203> ;
    skos:definition "x is_delimited_by y iff x is an instance of Organization and y is an instance of Delimiting Domain and y delimits x."@en .

<https://www.commoncoreontologies.org/ont00001862> a owl:ObjectProperty ;
    rdfs:label "interval disjoint"@en ;
    rdfs:domain <http://purl.obolibrary.org/obo/BFO_0000202> ;
    rdfs:range <http://purl.obolibrary.org/obo/BFO_0000202> ;
    skos:definition "x interval_disjoint y iff x and y are both instances of Temporal Interval and have no parts in common."@en .

<https://www.commoncoreontologies.org/ont00001863> a owl:ObjectProperty ;
    rdfs:label "uses measurement unit"@en ;
    rdfs:domain <https://www.commoncoreontologies.org/ont00000253> ;
    rdfs:range <https://www.commoncoreontologies.org/ont00000120> ;
    skos:definition "x uses measurement unit y =Def y is measurement unit of x"@en .

<https://www.commoncoreontologies.org/ont00001864> a owl:ObjectProperty ;
    rdfs:label "delimits"@en ;
    rdfs:domain <https://www.commoncoreontologies.org/ont00001203> ;
    rdfs:range <https://www.commoncoreontologies.org/ont00001180> ;
    skos:definition "x delimits y =Def y is delimited by x"@en .

<https://www.commoncoreontologies.org/ont00001866> a owl:ObjectProperty ;
    rdfs:label "is interest of"@en ;
    rdfs:domain <http://purl.obolibrary.org/obo/BFO_0000015> ;
    rdfs:range <https://www.commoncoreontologies.org/ont00001017> ;
    skos:definition "x is interest of y =Def y has interest in x" .

<https://www.commoncoreontologies.org/ont00001868> a owl:ObjectProperty ;
    rdfs:label "is a nominal measurement of"@en ;
    rdfs:domain <https://www.commoncoreontologies.org/ont00000293> ;
    rdfs:range <http://purl.obolibrary.org/obo/BFO_0000001> ;
    skos:definition "x is_a_nominal_measurement_of y iff x is an instance of Nominal Measurement Information Content Entity and y is an instance of Entity, such that x classifies y relative to some set of shared, possibly arbitrary, characteristics."@en .

<https://www.commoncoreontologies.org/ont00001869> a owl:ObjectProperty ;
    rdfs:label "interval during"@en ;
    rdfs:domain <http://purl.obolibrary.org/obo/BFO_0000202> ;
    rdfs:range <http://purl.obolibrary.org/obo/BFO_0000202> ;
    skos:definition "x interval_during y iff x and y are both instances of Temporal Interval and there exist instances of Temporal Instant u, v, w, and z such that u is the starting instant of x, v is the ending instant of x, w is the starting instant of y, z is the ending instant of y, w is before u, and v is before z."@en .

<https://www.commoncoreontologies.org/ont00001870> a owl:ObjectProperty ;
    rdfs:label "interval overlapped by"@en ;
    rdfs:domain <http://purl.obolibrary.org/obo/BFO_0000202> ;
    rdfs:range <http://purl.obolibrary.org/obo/BFO_0000202> ;
    skos:definition "x is_overlapped_by y iff x and y are both instances of Temporal Interval and y interval_overlaps x."@en .

<https://www.commoncoreontologies.org/ont00001873> a owl:ObjectProperty ;
    rdfs:label "represented by"@en ;
    rdfs:domain <http://purl.obolibrary.org/obo/BFO_0000001> ;
    rdfs:range <https://www.commoncoreontologies.org/ont00001069> ;
    skos:definition "x represented by y =Def y represents x"@en .

<https://www.commoncoreontologies.org/ont00001874> a owl:ObjectProperty ;
    rdfs:label "is temporal region of"@en ;
    rdfs:domain <http://purl.obolibrary.org/obo/BFO_0000008> ;
    skos:definition "x is temporal region of y =Def y occupies temporal region x"@en .

<https://www.commoncoreontologies.org/ont00001875> a owl:ObjectProperty ;
    rdfs:label "interval started by"@en ;
    rdfs:domain <http://purl.obolibrary.org/obo/BFO_0000202> ;
    rdfs:range <http://purl.obolibrary.org/obo/BFO_0000202> ;
    skos:definition "x interval started by y =Def y interval starts x"@en .

<https://www.commoncoreontologies.org/ont00001877> a owl:ObjectProperty ;
    rdfs:label "is an interval measurement of"@en ;
    rdfs:domain <https://www.commoncoreontologies.org/ont00001364> ;
    rdfs:range <http://purl.obolibrary.org/obo/BFO_0000001> ;
    skos:definition "x is_an_interval_measurement_of y iff x is an instance of Interval Measurement Information Content Entity and y is an instance of Entity and y is_measured_by_interval x."@en .

<https://www.commoncoreontologies.org/ont00001878> a owl:ObjectProperty ;
    rdfs:label "is mention of"@en ;
    rdfs:domain <https://www.commoncoreontologies.org/ont00000253> ;
    rdfs:range <http://purl.obolibrary.org/obo/BFO_0000001> ;
    skos:definition "x is mention of y =Def y is mentioned by x"@en .

<https://www.commoncoreontologies.org/ont00001879> a owl:ObjectProperty ;
    rdfs:label "designated by"@en ;
    rdfs:domain <http://purl.obolibrary.org/obo/BFO_0000001> ;
    rdfs:range <https://www.commoncoreontologies.org/ont00000686> ;
    skos:definition "x designated by y =Def y designates x"@en .

<https://www.commoncoreontologies.org/ont00001880> a owl:ObjectProperty ;
    rdfs:label "capability of aggregate"@en ;
    rdfs:domain <https://www.commoncoreontologies.org/ont00001379> ;
    rdfs:range <http://purl.obolibrary.org/obo/BFO_0000027> ;
    skos:definition "x capability_of_aggregate y iff y is an instance of Object Aggregate and x is an instance of Agent Capability, such that x inheres in aggregate y."@en .

<https://www.commoncoreontologies.org/ont00001884> a owl:ObjectProperty ;
    rdfs:label "condition described by"@en ;
    rdfs:domain <http://purl.obolibrary.org/obo/BFO_0000001> ;
    rdfs:range <https://www.commoncoreontologies.org/ont00000127> ;
    skos:definition "x condition described by y =Def y describes condition x"@en .

<https://www.commoncoreontologies.org/ont00001886> a owl:ObjectProperty ;
    rdfs:label "is affected by"@en ;
    rdfs:range <http://purl.obolibrary.org/obo/BFO_0000015> ;
    skos:definition "x is affected by y =Def x participates in y, x is an Independent Continuant (but not a Spatial Region), y is a Process, and y influences x in some manner, most often by producing a change in x."@en .

<https://www.commoncoreontologies.org/ont00001888> a owl:ObjectProperty ;
    rdfs:label "disrupts"@en ;
    rdfs:domain <http://purl.obolibrary.org/obo/BFO_0000015> ;
    rdfs:range <http://purl.obolibrary.org/obo/BFO_0000015> ;
    skos:definition "A relation where one process disrupts another process from occurring as it would have."@en .

<https://www.commoncoreontologies.org/ont00001889> a owl:ObjectProperty ;
    rdfs:label "capability of"@en ;
    rdfs:domain <https://www.commoncoreontologies.org/ont00001379> ;
    rdfs:range <https://www.commoncoreontologies.org/ont00001017> ;
    skos:definition "x capability_of y iff y is an instance of Agent and x is an instance of Agent Capability, such that x inheres in y."@en .

<https://www.commoncoreontologies.org/ont00001893> a owl:ObjectProperty ;
    rdfs:label "instant is after"@en ;
    rdfs:domain <http://purl.obolibrary.org/obo/BFO_0000203> ;
    rdfs:range <http://purl.obolibrary.org/obo/BFO_0000203> ;
    skos:definition "x instant_is_after y iff x and y are both instances of Temporal Instant and there exists some instance of Temporal Interval z such that y is the starting instant of z and x is the ending instant of z."@en .

<https://www.commoncoreontologies.org/ont00001895> a owl:ObjectProperty ;
    rdfs:label "accomplice in"@en ;
    rdfs:domain <https://www.commoncoreontologies.org/ont00001017> ;
    rdfs:range <http://purl.obolibrary.org/obo/BFO_0000015> ;
    skos:definition "Agent x is accomplice_in Process y iff x assists in the commission of y, is located at the location of y, but is not agent_in y."@en .

<https://www.commoncoreontologies.org/ont00001896> a owl:ObjectProperty ;
    rdfs:label "interval meets"@en ;
    rdfs:domain <http://purl.obolibrary.org/obo/BFO_0000202> ;
    rdfs:range <http://purl.obolibrary.org/obo/BFO_0000202> ;
    skos:definition "x interval meets y =Def y interval met by x"@en .

<https://www.commoncoreontologies.org/ont00001898> a owl:ObjectProperty ;
    rdfs:label "aggregate has capability"@en ;
    rdfs:domain <http://purl.obolibrary.org/obo/BFO_0000027> ;
    rdfs:range <https://www.commoncoreontologies.org/ont00001379> ;
    skos:definition "x aggregate has capability y =Def y capability of aggregate x"@en .

<https://www.commoncoreontologies.org/ont00001899> a owl:ObjectProperty ;
    rdfs:label "language used in"@en ;
    rdfs:domain <https://www.commoncoreontologies.org/ont00001175> ;
    rdfs:range <https://www.commoncoreontologies.org/ont00000253> ;
    skos:definition "x language_used_by y iff y is an instance of Information Bearing Entity and x is an instance of Language, such that the literal value of y is a string that is encoded according to the syntax of x."@en .

<https://www.commoncoreontologies.org/ont00001900> a owl:ObjectProperty ;
    rdfs:label "is geospatial coordinate reference system of"@en ;
    rdfs:domain <https://www.commoncoreontologies.org/ont00000469> ;
    rdfs:range <https://www.commoncoreontologies.org/ont00000253> ;
    skos:definition "x is_geospatial_coordinate_reference_system_of y iff y is an instance of Information Bearing Entity and x is an instance of Geospatial Coordinate Reference System, such that x describes the set of standards mentioned in y."@en .

<https://www.commoncoreontologies.org/ont00001901> a owl:ObjectProperty ;
    rdfs:label "aggregate has role"@en ;
    rdfs:domain <http://purl.obolibrary.org/obo/BFO_0000027> ;
    rdfs:range <http://purl.obolibrary.org/obo/BFO_0000023> ;
    skos:definition "x aggregate_has_role y iff x is an instance of Object Aggregate and y is an instance of Role, such that x aggregate_bearer_of y."@en .

<https://www.commoncoreontologies.org/ont00001904> a owl:ObjectProperty ;
    rdfs:label "is measured by"@en ;
    rdfs:domain <http://purl.obolibrary.org/obo/BFO_0000001> ;
    rdfs:range <https://www.commoncoreontologies.org/ont00001163> ;
    skos:definition "x is measured by y =Def y is a measurement of x"@en .

<https://www.commoncoreontologies.org/ont00001907> a owl:ObjectProperty ;
    rdfs:label "aggregate has quality"@en ;
    rdfs:domain <http://purl.obolibrary.org/obo/BFO_0000027> ;
    rdfs:range <http://purl.obolibrary.org/obo/BFO_0000019> ;
    skos:definition "x aggregate_has_quality y iff x is an instance of Object Aggregate and y is an instance of Quality, such that x aggregate_bearer_of y."@en .

<https://www.commoncoreontologies.org/ont00001908> a owl:ObjectProperty ;
    rdfs:label "uses time zone identifier"@en ;
    rdfs:domain <https://www.commoncoreontologies.org/ont00000253> ;
    rdfs:range <https://www.commoncoreontologies.org/ont00000829> ;
    skos:definition "x uses time zone identifier y =Def y time zone identifier used by x"@en .

<https://www.commoncoreontologies.org/ont00001909> a owl:ObjectProperty ;
    rdfs:label "has tangential part"@en ;
    rdfs:domain <http://purl.obolibrary.org/obo/BFO_0000141> ;
    rdfs:range <http://purl.obolibrary.org/obo/BFO_0000141> ;
    skos:definition "x has tangential part y =Def y tangential part of x"@en .

<https://www.commoncoreontologies.org/ont00001910> a owl:ObjectProperty ;
    rdfs:label "permits"@en ;
    rdfs:domain <https://www.commoncoreontologies.org/ont00001324> ;
    rdfs:range <http://purl.obolibrary.org/obo/BFO_0000015> ;
    skos:definition "x permits y at t iff: x is an instance of Process Regulation at time t, and y is an instance of Process at time t, and x prescribes that y may occur."@en .

<https://www.commoncoreontologies.org/ont00001912> a owl:ObjectProperty ;
    rdfs:label "uses reference system"@en ;
    rdfs:domain <https://www.commoncoreontologies.org/ont00000253> ;
    rdfs:range <https://www.commoncoreontologies.org/ont00000398> ;
    skos:definition "x uses reference system y =Def y is reference system of x"@en .

<https://www.commoncoreontologies.org/ont00001913> a owl:ObjectProperty ;
    rdfs:label "uses geospatial coordinate reference system"@en ;
    rdfs:domain <https://www.commoncoreontologies.org/ont00000253> ;
    rdfs:range <https://www.commoncoreontologies.org/ont00000469> ;
    skos:definition "x uses geospatial coordinate reference system y =Def y is geospatial coordinate reference system of x"@en .

<https://www.commoncoreontologies.org/ont00001914> a owl:ObjectProperty ;
    rdfs:label "is measured by nominal"@en ;
    rdfs:domain <http://purl.obolibrary.org/obo/BFO_0000001> ;
    rdfs:range <https://www.commoncoreontologies.org/ont00000293> ;
    skos:definition "x is measured by nominal y =Def y is a nominal measurement of x"@en .

<https://www.commoncoreontologies.org/ont00001915> a owl:ObjectProperty ;
    rdfs:label "interval met by"@en ;
    rdfs:domain <http://purl.obolibrary.org/obo/BFO_0000202> ;
    rdfs:range <http://purl.obolibrary.org/obo/BFO_0000202> ;
    skos:definition "x interval_met_by y iff x and y are both instances of Temporal Interval and y interval_meets x."@en .

<https://www.commoncoreontologies.org/ont00001916> a owl:ObjectProperty ;
    rdfs:label "designates"@en ;
    rdfs:domain <https://www.commoncoreontologies.org/ont00000686> ;
    rdfs:range <http://purl.obolibrary.org/obo/BFO_0000001> ;
    skos:definition "x designates y iff x is an instance of a Designative Information Content Entity, and y is an instance of an Entity, such that given some context, x uniquely distinguishes y from other entities."@en .

<https://www.commoncoreontologies.org/ont00001917> a owl:ObjectProperty ;
    rdfs:label "described by"@en ;
    rdfs:domain <http://purl.obolibrary.org/obo/BFO_0000001> ;
    rdfs:range <https://www.commoncoreontologies.org/ont00000853> ;
    skos:definition "x described by y =Def y describes x"@en .

<https://www.commoncoreontologies.org/ont00001918> a owl:ObjectProperty ;
    rdfs:label "occurs at"@en ;
    rdfs:domain <http://purl.obolibrary.org/obo/BFO_0000015> ;
    rdfs:range <http://purl.obolibrary.org/obo/BFO_0000029> ;
    skos:definition "x occurs_at y iff x is an instance of Process and y is an instance of Site, such that x occurs in y."@en .

<https://www.commoncoreontologies.org/ont00001919> a owl:ObjectProperty ;
    rdfs:label "is mentioned by"@en ;
    rdfs:domain <http://purl.obolibrary.org/obo/BFO_0000001> ;
    rdfs:range <https://www.commoncoreontologies.org/ont00000253> ;
    skos:definition "x is_mentioned_by y iff y is an instance of Information Bearing Entity and x is an instance of Entity, such that y is used as a reference to x."@en .

<https://www.commoncoreontologies.org/ont00001920> a owl:ObjectProperty ;
    rdfs:label "prescribed by"@en ;
    rdfs:domain <http://purl.obolibrary.org/obo/BFO_0000001> ;
    rdfs:range <https://www.commoncoreontologies.org/ont00000965> ;
    skos:definition "x prescribed by y =Def y prescribes x"@en .

<https://www.commoncoreontologies.org/ont00001921> a owl:ObjectProperty ;
    rdfs:label "has input"@en ;
    rdfs:domain <http://purl.obolibrary.org/obo/BFO_0000015> ;
    skos:definition "x has input y =Def y is input of x"@en .

<https://www.commoncoreontologies.org/ont00001922> a owl:ObjectProperty ;
    rdfs:label "has recipient"@en ;
    rdfs:domain <https://www.commoncoreontologies.org/ont00000402> ;
    rdfs:range <https://www.commoncoreontologies.org/ont00001017> ;
    skos:definition "x has recipient y =Def y receives x"@en .

<https://www.commoncoreontologies.org/ont00001923> a owl:ObjectProperty ;
    rdfs:label "interval starts"@en ;
    rdfs:domain <http://purl.obolibrary.org/obo/BFO_0000202> ;
    rdfs:range <http://purl.obolibrary.org/obo/BFO_0000202> ;
    skos:definition "x interval_starts y iff x and y are both instances of Temporal Interval and there exist instances of Temporal Instant v, w, and z such that v is the starting instant of both x and y, w is the ending instant of x, z is the ending instant of y and w is before z."@en .

<https://www.commoncoreontologies.org/ont00001924> a owl:ObjectProperty ;
    rdfs:label "interval contains"@en ;
    rdfs:domain <http://purl.obolibrary.org/obo/BFO_0000202> ;
    rdfs:range <http://purl.obolibrary.org/obo/BFO_0000202> ;
    skos:definition "x interval contains y =Def y interval contained by x"@en .

<https://www.commoncoreontologies.org/ont00001925> a owl:ObjectProperty ;
    rdfs:label "is used by"@en ;
    rdfs:domain <http://purl.obolibrary.org/obo/BFO_0000040> ;
    rdfs:range <https://www.commoncoreontologies.org/ont00001017> ;
    skos:definition "x is used by y =Def y uses x"@en .

<https://www.commoncoreontologies.org/ont00001928> a owl:ObjectProperty ;
    rdfs:label "is predecessor of"@en ;
    rdfs:domain <http://purl.obolibrary.org/obo/BFO_0000004> ;
    rdfs:range <http://purl.obolibrary.org/obo/BFO_0000004> ;
    skos:definition "x is_predecessor_of y iff x and y are both instances of Independent Continuant and there is some process p and x is an input to p and y is an output of p."@en .

<https://www.commoncoreontologies.org/ont00001931> a owl:ObjectProperty ;
    rdfs:label "externally connects with"@en ;
    rdfs:domain <http://purl.obolibrary.org/obo/BFO_0000141> ;
    rdfs:range <http://purl.obolibrary.org/obo/BFO_0000141> ;
    skos:definition "x externally_connects_with y iff x and y are both instances of Immaterial Entity and x connects with y and x does not overlap y."@en .

<https://www.commoncoreontologies.org/ont00001933> a owl:ObjectProperty ;
    rdfs:label "process starts"@en ;
    rdfs:domain <http://purl.obolibrary.org/obo/BFO_0000015> ;
    rdfs:range <http://purl.obolibrary.org/obo/BFO_0000015> ;
    skos:definition "x process_starts y iff x and y are instances of processes, and x is_cause_of y, and i is an instance of a temporal instant, and r is an instance of a temporal interval, and y has starting instance i, and x occupies temporal region r, and r has inside instant i."@en .

<https://www.commoncoreontologies.org/ont00001936> a owl:ObjectProperty ;
    rdfs:label "is object of"@en ;
    rdfs:range <http://purl.obolibrary.org/obo/BFO_0000015> ;
    skos:definition "x is object of y =Def x participates in y, x is an Independent Continuant (but not a Spatial Region), y is a Process, and y is performed by Agent z and x is part of the projected state that z intends to achieve by performing y."@en .

<https://www.commoncoreontologies.org/ont00001938> a owl:ObjectProperty ;
    rdfs:label "represents"@en ;
    rdfs:domain <https://www.commoncoreontologies.org/ont00001069> ;
    rdfs:range <http://purl.obolibrary.org/obo/BFO_0000001> ;
    skos:definition "x represents y iff x is an instance of Representational Information Content Entity, y is an instance of Entity, and z is carrier of x, such that x is about y in virtue of there existing an isomorphism between characteristics of z and y."@en .

<https://www.commoncoreontologies.org/ont00001939> a owl:ObjectProperty ;
    rdfs:label "is affiliated with"@en ;
    rdfs:domain <https://www.commoncoreontologies.org/ont00001017> ;
    rdfs:range <https://www.commoncoreontologies.org/ont00001017> ;
    skos:definition "x is_affiliated_with y iff x and y are instances of Agent, such that they have any kind of social or business relationship."@en .

<https://www.commoncoreontologies.org/ont00001940> a owl:ObjectProperty ;
    rdfs:label "interval is before"@en ;
    rdfs:domain <http://purl.obolibrary.org/obo/BFO_0000202> ;
    rdfs:range <http://purl.obolibrary.org/obo/BFO_0000202> ;
    skos:definition "x interval_is_before y iff x and y are both instances of Temporal Interval and there exist instances of Temporal Instant w, z such that w is the ending instant of x and z is the starting instant of y and w is before z."@en .

<https://www.commoncoreontologies.org/ont00001942> a owl:ObjectProperty ;
    rdfs:label "prescribes"@en ;
    rdfs:domain <https://www.commoncoreontologies.org/ont00000965> ;
    rdfs:range <http://purl.obolibrary.org/obo/BFO_0000001> ;
    skos:definition "x prescribes y iff x is an instance of Information Content Entity and y is an instance of Entity, such that x serves as a rule or guide for y if y an Occurrent, or x serves as a model for y if y is a Continuant."@en .

<https://www.commoncoreontologies.org/ont00001943> a owl:ObjectProperty ;
    rdfs:label "supervises"@en ;
    rdfs:domain <https://www.commoncoreontologies.org/ont00001262> ;
    rdfs:range <https://www.commoncoreontologies.org/ont00001262> ;
    skos:definition "x supervises y =Def y is supervised by x"@en .

<https://www.commoncoreontologies.org/ont00001944> a owl:ObjectProperty ;
    rdfs:label "spatial part of"@en ;
    rdfs:domain <http://purl.obolibrary.org/obo/BFO_0000141> ;
    rdfs:range <http://purl.obolibrary.org/obo/BFO_0000141> ;
    skos:definition "x spatial_part_of y iff x, y, z, and q are instances of Immaterial Entity, such that for any z connected with x, z is also connected with y, and q is connected with y but not connected with x."@en .

<https://www.commoncoreontologies.org/ont00001947> a owl:ObjectProperty ;
    rdfs:label "quality of aggregate"@en ;
    rdfs:domain <http://purl.obolibrary.org/obo/BFO_0000019> ;
    rdfs:range <http://purl.obolibrary.org/obo/BFO_0000027> ;
    skos:definition "x quality_of_aggregate y iff y is an instance of Object Aggregate and x is an instance of Quality, and x inheres_in_aggregate y."@en .

<https://www.commoncoreontologies.org/ont00001949> a owl:ObjectProperty ;
    rdfs:label "has accessory"@en ;
    rdfs:domain <http://purl.obolibrary.org/obo/BFO_0000015> ;
    rdfs:range <https://www.commoncoreontologies.org/ont00001017> ;
    skos:definition "x has accessory y =Def y accessory in x"@en .

<https://www.commoncoreontologies.org/ont00001951> a owl:ObjectProperty ;
    rdfs:label "has subordinate role"@en ;
    rdfs:domain <http://purl.obolibrary.org/obo/BFO_0000023> ;
    rdfs:range <http://purl.obolibrary.org/obo/BFO_0000023> ;
    skos:definition "x has subordinate role y =Def y is subordinate role to x"@en .

<https://www.commoncoreontologies.org/ont00001954> a owl:ObjectProperty ;
    rdfs:label "has capability"@en ;
    rdfs:domain <https://www.commoncoreontologies.org/ont00001017> ;
    rdfs:range <https://www.commoncoreontologies.org/ont00001379> ;
    skos:definition "x has capability y =Def y capability of x"@en .

<https://www.commoncoreontologies.org/ont00001956> a owl:ObjectProperty ;
    rdfs:label "aggregate has disposition"@en ;
    rdfs:domain <http://purl.obolibrary.org/obo/BFO_0000027> ;
    rdfs:range <http://purl.obolibrary.org/obo/BFO_0000016> ;
    skos:definition "x aggregate has disposition y =Def y disposition of aggregate x"@en .

<https://www.commoncoreontologies.org/ont00001959> a owl:ObjectProperty ;
    rdfs:label "inhibits"@en ;
    rdfs:domain <http://purl.obolibrary.org/obo/BFO_0000015> ;
    rdfs:range <http://purl.obolibrary.org/obo/BFO_0000015> ;
    skos:definition "x inhibits y =Def y is inhibited by x"@en .

<https://www.commoncoreontologies.org/ont00001961> a owl:ObjectProperty ;
    rdfs:label "is measurement unit of"@en ;
    rdfs:domain <https://www.commoncoreontologies.org/ont00000120> ;
    rdfs:range <https://www.commoncoreontologies.org/ont00000253> ;
    skos:definition "x is_measurement_unit_of y iff y is an instance of Information Bearing Entity and x is an instance of Measurement Unit, such that x describes the magnitude of measured physical quantity mentioned in y."@en .

<https://www.commoncoreontologies.org/ont00001962> a owl:ObjectProperty ;
    rdfs:label "process started by"@en ;
    rdfs:domain <http://purl.obolibrary.org/obo/BFO_0000015> ;
    rdfs:range <http://purl.obolibrary.org/obo/BFO_0000015> ;
    skos:definition "x process started by y =Def y process starts x"@en .

<https://www.commoncoreontologies.org/ont00001963> a owl:ObjectProperty ;
    rdfs:label "is measured by ordinal"@en ;
    rdfs:domain <http://purl.obolibrary.org/obo/BFO_0000001> ;
    rdfs:range <https://www.commoncoreontologies.org/ont00001010> ;
    skos:definition "x is measured by ordinal y =Def y is a ordinal measurement of x"@en .

<https://www.commoncoreontologies.org/ont00001964> a owl:ObjectProperty ;
    rdfs:label "is measured by interval"@en ;
    rdfs:domain <http://purl.obolibrary.org/obo/BFO_0000001> ;
    rdfs:range <https://www.commoncoreontologies.org/ont00001364> ;
    skos:definition "x is measured by interval y =Def y is a interval measurement of x"@en .

<https://www.commoncoreontologies.org/ont00001965> a owl:ObjectProperty ;
    rdfs:label "is measured by ratio"@en ;
    rdfs:domain <http://purl.obolibrary.org/obo/BFO_0000001> ;
    rdfs:range <https://www.commoncoreontologies.org/ont00001022> ;
    skos:definition "x is measured by ratio y =Def y is a ratio measurement of x"@en .

<https://www.commoncoreontologies.org/ont00001966> a owl:ObjectProperty ;
    rdfs:label "is a measurement of"@en ;
    rdfs:domain <https://www.commoncoreontologies.org/ont00001163> ;
    rdfs:range <http://purl.obolibrary.org/obo/BFO_0000001> ;
    skos:definition "x is_a_measurement_of y iff x is an instance of Measurement Information Content Entity and y is an instance of Entity, such that x describes some attribute of y relative to some scale or classification scheme."@en .

<https://www.commoncoreontologies.org/ont00001970> a owl:ObjectProperty ;
    rdfs:label "inhibited by"@en ;
    rdfs:domain <http://purl.obolibrary.org/obo/BFO_0000015> ;
    rdfs:range <http://purl.obolibrary.org/obo/BFO_0000015> ;
    skos:definition "y inhibited_by x iff x and y are non-identical Processes, d is a Decrease of Realizable Entity, and x is_cause_of d, and r is a Realizable Entity, and d has_participant r, and r realized_in y."@en .

<https://www.commoncoreontologies.org/ont00001971> a owl:ObjectProperty ;
    rdfs:label "interval contained by"@en ;
    rdfs:domain <http://purl.obolibrary.org/obo/BFO_0000202> ;
    rdfs:range <http://purl.obolibrary.org/obo/BFO_0000202> ;
    skos:definition "x interval_contained_by y iff x and y are both instances of Temporal Interval and y interval_contains x."@en .

<https://www.commoncoreontologies.org/ont00001974> a owl:ObjectProperty ;
    rdfs:label "requires"@en ;
    rdfs:domain <https://www.commoncoreontologies.org/ont00001324> ;
    rdfs:range <http://purl.obolibrary.org/obo/BFO_0000015> ;
    skos:definition "x requires y at t iff: x is an instance of Process Regulation at time t, and y is an instance of Process at time t, and x prescribes that some y must occur."@en .

<https://www.commoncoreontologies.org/ont00001976> a owl:ObjectProperty ;
    rdfs:label "uses language"@en ;
    rdfs:domain <https://www.commoncoreontologies.org/ont00000253> ;
    rdfs:range <https://www.commoncoreontologies.org/ont00001175> ;
    skos:definition "x uses language y =Def y language used in x"@en .

<https://www.commoncoreontologies.org/ont00001977> a owl:ObjectProperty ;
    rdfs:label "has affiliate"@en ;
    rdfs:domain <https://www.commoncoreontologies.org/ont00001017> ;
    rdfs:range <https://www.commoncoreontologies.org/ont00001017> ;
    skos:definition "x has affiliate y =Def y is affiliated with x"@en .

<https://www.commoncoreontologies.org/ont00001978> a owl:ObjectProperty ;
    rdfs:label "receives"@en ;
    rdfs:domain <https://www.commoncoreontologies.org/ont00001017> ;
    rdfs:range <https://www.commoncoreontologies.org/ont00000402> ;
    skos:definition "x receives y iff x is an instance of Agent and y is an instance of Act Of Communication, such that x is the recipient and decoder of the InformationContentEntity intended for communication in y."@en .

<https://www.commoncoreontologies.org/ont00001980> a owl:ObjectProperty ;
    rdfs:label "describes condition"@en ;
    rdfs:domain <https://www.commoncoreontologies.org/ont00000127> ;
    rdfs:range <http://purl.obolibrary.org/obo/BFO_0000001> ;
    skos:definition "p describes_condition c iff p is an instance of a Performance Specification and c is an instance of Entity and p has part d, and d is an instance of a Descriptive Information Content Entity, and p prescribes an entity s, and d describes c, and c is an entity that is causally relevant to s existing as prescribed by p."@en .

<https://www.commoncoreontologies.org/ont00001982> a owl:ObjectProperty ;
    rdfs:label "describes"@en ;
    rdfs:domain <https://www.commoncoreontologies.org/ont00000853> ;
    rdfs:range <http://purl.obolibrary.org/obo/BFO_0000001> ;
    skos:definition "x describes y iff x is an instance of Descriptive Information Content Entity, and y is an instance of Entity, such that x is_about the characteristics that identify y."@en .

<https://www.commoncoreontologies.org/ont00001983> a owl:ObjectProperty ;
    rdfs:label "is a ratio measurement of"@en ;
    rdfs:domain <https://www.commoncoreontologies.org/ont00001022> ;
    rdfs:range <http://purl.obolibrary.org/obo/BFO_0000001> ;
    skos:definition "x is_a_ratio_measurement_of y iff x is an instance of Ratio Measurement Information Content Entity and y is an instance of Entity and x describes some attribute of y relative to a scale having equal unit values and a zero value that corresponds to the absence of the attribute being measured."@en .

<https://www.commoncoreontologies.org/ont00001984> a owl:ObjectProperty ;
    rdfs:label "has interest in"@en ;
    rdfs:domain <https://www.commoncoreontologies.org/ont00001017> ;
    rdfs:range <http://purl.obolibrary.org/obo/BFO_0000015> ;
    skos:definition "A relation between an Agent and some Process where the Agent has an interest in that Process."@en .

<https://www.commoncoreontologies.org/ont00001986> a owl:ObjectProperty ;
    rdfs:label "has output"@en ;
    rdfs:domain <http://purl.obolibrary.org/obo/BFO_0000015> ;
    skos:definition "x has output y =Def y is output of x"@en .

<https://www.commoncoreontologies.org/ont00001989> a owl:ObjectProperty ;
    rdfs:label "has nontangential part"@en ;
    rdfs:domain <http://purl.obolibrary.org/obo/BFO_0000141> ;
    rdfs:range <http://purl.obolibrary.org/obo/BFO_0000141> ;
    skos:definition "x has nontangential part y =Def y nontangential part of x"@en .

<https://www.commoncoreontologies.org/ont00001990> a owl:ObjectProperty ;
    rdfs:label "instant is before"@en ;
    rdfs:domain <http://purl.obolibrary.org/obo/BFO_0000203> ;
    rdfs:range <http://purl.obolibrary.org/obo/BFO_0000203> ;
    skos:definition "x instant_is_before y iff x and y are both instances of Zero Dimensional Temporal Region and there exists some instance of Temporal Interval z such that x is the starting instant of z and y is the ending instant of z."@en .

<https://www.commoncoreontologies.org/ont00001992> a owl:ObjectProperty ;
    rdfs:label "has organizational context"@en ;
    rdfs:domain <http://purl.obolibrary.org/obo/BFO_0000023> ;
    rdfs:range <https://www.commoncoreontologies.org/ont00001180> ;
    skos:definition "x has organizational context y =Def y is organizational context of x"@en .

<https://www.commoncoreontologies.org/ont00001993> a owl:ObjectProperty ;
    rdfs:label "sends"@en ;
    rdfs:domain <https://www.commoncoreontologies.org/ont00001017> ;
    rdfs:range <https://www.commoncoreontologies.org/ont00000402> ;
    skos:definition "x sends y iff x is an instance of Agent and y is an instance of Act Of Communication, such that x is the initiator and encoder of the InformationContentEntity intended for communication in y."@en .

<https://www.commoncoreontologies.org/ont00001997> a owl:ObjectProperty ;
    rdfs:label "is reference system of"@en ;
    rdfs:domain <https://www.commoncoreontologies.org/ont00000398> ;
    rdfs:range <https://www.commoncoreontologies.org/ont00000253> ;
    skos:definition "x is_reference_system_of y iff y is an instance of Information Bearing Entity and x is an instance of Reference System, such that x describes the set of standards mentioned in y."@en .

<https://www.commoncoreontologies.org/ont00001998> a owl:ObjectProperty ;
    rdfs:label "is permitted by"@en ;
    rdfs:domain <http://purl.obolibrary.org/obo/BFO_0000015> ;
    rdfs:range <https://www.commoncoreontologies.org/ont00001324> ;
    skos:definition "x is permitted by y =Def y permits x"@en .

<https://www.commoncoreontologies.org/ont00002000> a owl:Class ;
    rdfs:label "Center of Mass"@en ;
    rdfs:subClassOf <http://purl.obolibrary.org/obo/BFO_0000147> ;
    skos:definition "A Fiat Point that is where the weighted position vectors of the distributed Mass of a Material Entity relative to this point sum to zero."@en .

<https://www.commoncoreontologies.org/ont00002003> a owl:Class ;
    rdfs:label "Academic Degree"@en ;
    rdfs:subClassOf <https://www.commoncoreontologies.org/ont00002002> ;
    skos:definition "A Certificate issued by an Educational Organization to a Person to indicate that the Person has satisfactorily completed a course of study, or as an honorary recognition of the Person's achievement."@en .

<https://www.commoncoreontologies.org/ont00002005> a owl:Class ;
    rdfs:label "Chart"@en ;
    rdfs:subClassOf <https://www.commoncoreontologies.org/ont00002004> ;
    skos:definition "An Image that is prescribed by some canonical visual format."@en .

<https://www.commoncoreontologies.org/ont00002006> a owl:Class ;
    rdfs:label "Database"@en ;
    rdfs:subClassOf <https://www.commoncoreontologies.org/ont00002001> ;
    skos:definition "A Media Content Entity that is designed to be rapidly searchable and retrievable."@en .

<https://www.commoncoreontologies.org/ont00002008> a owl:Class ;
    rdfs:label "Code List"@en ;
    rdfs:subClassOf <https://www.commoncoreontologies.org/ont00002007> ;
    skos:definition "A List whose parts are Code Identifiers."@en .

<https://www.commoncoreontologies.org/ont00002009> a owl:Class ;
    rdfs:label "Video"@en ;
    rdfs:subClassOf <https://www.commoncoreontologies.org/ont00002001> ;
    skos:definition "A Media Content Entity that contains a sequence of representations that are presented sufficiently rapidly to create the appearance of motion and continuity."@en .

<https://www.commoncoreontologies.org/ont00002011> a owl:Class ;
    rdfs:label "Warning Message"@en ;
    rdfs:subClassOf <https://www.commoncoreontologies.org/ont00002010> ;
    skos:definition "A Message that describes a possible or impending threat."@en .

<https://www.commoncoreontologies.org/ont00002012> a owl:Class ;
    rdfs:label "Email Message"@en ;
    rdfs:subClassOf <https://www.commoncoreontologies.org/ont00002010> ;
    skos:definition "A Message that is transmitted to the recipient's Email Box."@en .

<https://www.commoncoreontologies.org/ont00002013> a owl:Class ;
    rdfs:label "Notification Message"@en ;
    rdfs:subClassOf <https://www.commoncoreontologies.org/ont00002010> ;
    skos:definition "A Message that describes a scenario that has been determined to merit attention by the recipient."@en .

<https://www.commoncoreontologies.org/ont00002014> a owl:Class ;
    rdfs:label "Barcode"@en ;
    rdfs:subClassOf <https://www.commoncoreontologies.org/ont00002001> ;
    skos:definition "A Media Content Entity that represents one or more geometric shapes that have, as part, some Prescriptive Information Content Entity."@en .

<https://www.commoncoreontologies.org/ont00002037> a owl:Class ;
    rdfs:label "Information Line"@en ;
    rdfs:subClassOf <https://www.commoncoreontologies.org/ont00002001> ;
    skos:definition "A Media Content entity consisting of a single line or row in some Document Content entity of which it is a part."@en .

<https://www.commoncoreontologies.org/ont00002038> a owl:Class ;
    rdfs:label "Document Field Content"@en ;
    rdfs:subClassOf <https://www.commoncoreontologies.org/ont00002001> ;
    skos:definition "A Media Content Entity that is a part of some document content entity, and which  prescribes the eliciation of information to be written or selected within the document content entity."@en .

<https://www.commoncoreontologies.org/ont00002040> a owl:Class ;
    rdfs:label "Book"@en ;
    rdfs:subClassOf <https://www.commoncoreontologies.org/ont00002039> ;
    skos:definition "A Document Content Entity that canonically appears as ink on paper or parchment, or other materials fastened together to hinge at one side."@en .

<https://www.commoncoreontologies.org/ont00002041> a owl:Class ;
    rdfs:label "Transcript"@en ;
    rdfs:subClassOf <https://www.commoncoreontologies.org/ont00002039> ;
    skos:definition "A Document Content Entity that was originally recorded in a different medium."@en .

<https://www.commoncoreontologies.org/ont00002042> a owl:Class ;
    rdfs:label "Spreadsheet"@en ;
    rdfs:subClassOf <https://www.commoncoreontologies.org/ont00002039> ;
    skos:definition "A Document Content Entity that canonically appears as a interactive, tabular form."@en .

<https://www.commoncoreontologies.org/ont00002043> a owl:Class ;
    rdfs:label "Report"@en ;
    rdfs:subClassOf <https://www.commoncoreontologies.org/ont00002039> ;
    skos:definition "A Document Content entity that conveys an account of some event, situation, or the result of some observation or inquiry."@en .

<https://www.commoncoreontologies.org/ont00002044> a owl:Class ;
    rdfs:label "Form Document"@en ;
    rdfs:subClassOf <https://www.commoncoreontologies.org/ont00002039> ;
    skos:definition "A Document Content Entity that has Document Field Contents as parts."@en .

<https://www.commoncoreontologies.org/ont00002045> a owl:Class ;
    rdfs:label "Journal Article"@en ;
    rdfs:subClassOf <https://www.commoncoreontologies.org/ont00002039> ;
    skos:definition "A Document Content Entity that is part of a Journal Issue."@en .

<https://www.commoncoreontologies.org/ont00002067> a owl:Class ;
    rdfs:label "Explosive Naval Mine"@en ;
    rdfs:subClassOf <https://www.commoncoreontologies.org/ont00002066> ;
    skos:definition "An Explosive Mine that is designed to be concealed on or under water."@en .

<https://www.commoncoreontologies.org/ont00002068> a owl:Class ;
    rdfs:label "Display Instrument"@en ;
    rdfs:subClassOf <https://www.commoncoreontologies.org/ont00000995> ;
    skos:definition "A Material Artifact that is designed to bear an Image Display Artifact Function."@en .

<https://www.commoncoreontologies.org/ont00002069> a owl:Class ;
    rdfs:label "Image Display Artifact Function"@en ;
    rdfs:subClassOf <https://www.commoncoreontologies.org/ont00000323> ;
    skos:definition "An Artifact Function that inheres in Material Artifacts that are designed to display an Image."@en .

<https://www.commoncoreontologies.org/ont00002070> a owl:Class ;
    rdfs:label "Email Address"@en ;
    rdfs:subClassOf <https://www.commoncoreontologies.org/ont00000003> ;
    skos:definition "A Designative Name created in order to identify some Email Box as the destination of an email message for the purpose of Email Messaging."@en .

<https://www.commoncoreontologies.org/ont00002073> a owl:Class ;
    rdfs:label "Sensor Role"@en ;
    rdfs:subClassOf <http://purl.obolibrary.org/obo/BFO_0000023> ;
    skos:definition "A Role that inheres in an entity in virtue of it being used in a process wherein an attribute of its bearer acts as a proxy for some aspect of its sensing environment."@en .

<https://www.commoncoreontologies.org/ont00002074> a owl:Class ;
    rdfs:label "Sensor Platform Role"@en ;
    rdfs:subClassOf <http://purl.obolibrary.org/obo/BFO_0000023> ;
    skos:definition "A Role that inheres in an entity in virtue of it being used to support or convey a Sensor during its deployment and functioning."@en .

<https://www.commoncoreontologies.org/ont00002075> a owl:Class ;
    rdfs:label "Sensing Process"@en ;
    rdfs:subClassOf <http://purl.obolibrary.org/obo/BFO_0000015> ;
    skos:definition "A Process that realizes a Sensor Function or Sensor Role."@en .

<http://purl.obolibrary.org/obo/BFO_0000142> a owl:Class ;
    rdfs:label "fiat line"@en ;
    rdfs:subClassOf <http://purl.obolibrary.org/obo/BFO_0000140> ;
    owl:disjointWith <http://purl.obolibrary.org/obo/BFO_0000146>,
        <http://purl.obolibrary.org/obo/BFO_0000147> ;
    skos:definition "(Elucidation) A fiat line is a one-dimensional continuant fiat boundary that is continuous"@en .

<https://www.commoncoreontologies.org/ont00000037> a owl:Class ;
    rdfs:label "Act of Observation"@en ;
    rdfs:subClassOf <https://www.commoncoreontologies.org/ont00000228> ;
    skos:definition "A Planned Act of acquiring information from a source via the use of one or more senses."@en .

<https://www.commoncoreontologies.org/ont00000055> a owl:Class ;
    rdfs:label "Healthcare Facility"@en ;
    rdfs:subClassOf <https://www.commoncoreontologies.org/ont00000192> ;
    skos:definition "A Facility that is designed for the diagnosis, treatment, and prevention of disease."@en .

<https://www.commoncoreontologies.org/ont00000059> a owl:Class ;
    rdfs:label "Telephone Line"@en ;
    rdfs:subClassOf <https://www.commoncoreontologies.org/ont00000825> ;
    skos:definition "A Telecommunication Network Line that consists of a physical wire or other signaling medium that is designed to be part of a Telephone Network."@en .

<https://www.commoncoreontologies.org/ont00000073> a owl:Class ;
    rdfs:label "Temporal Interval Identifier"@en ;
    rdfs:subClassOf <https://www.commoncoreontologies.org/ont00000399> ;
    skos:definition "A Temporal Region Identifier that designates some Temporal Interval."@en .

<https://www.commoncoreontologies.org/ont00000089> a owl:Class ;
    rdfs:label "Skill"@en ;
    rdfs:subClassOf <https://www.commoncoreontologies.org/ont00001379> ;
    skos:definition "An Agent Capability that inheres in a Person to the extent of that Person's capacity to realize it in Intentional Acts of a certain type."@en .

<https://www.commoncoreontologies.org/ont00000092> a owl:Class ;
    rdfs:label "Bidirectional Transducer"@en ;
    rdfs:subClassOf <https://www.commoncoreontologies.org/ont00000736> ;
    skos:definition "A Transducer that is designed to receive a signal in the form of physical phenomena and convert it into an electrical signal, and vice versa."@en .

<https://www.commoncoreontologies.org/ont00000095> a owl:Class ;
    rdfs:label "Control Surface"@en ;
    rdfs:subClassOf <https://www.commoncoreontologies.org/ont00000995> ;
    skos:definition "A Material Artifact that is designed to deflect air, water, or another medium around its surface in order to change the Attitude of a Vehicle by rotating the Vehicle on one or more of its Axes of Rotation."@en .

<https://www.commoncoreontologies.org/ont00000100> a owl:Class ;
    rdfs:label "Stasis of Partially Mission Capable"@en ;
    rdfs:subClassOf <https://www.commoncoreontologies.org/ont00001132> ;
    skos:definition "A Stasis of Mission Capability during which the participating Continuant is capable of performing some but not all of its primary functions for the specified Mission."@en .

<https://www.commoncoreontologies.org/ont00000103> a owl:Class ;
    rdfs:label "Vehicle Compartment"@en ;
    rdfs:subClassOf <https://www.commoncoreontologies.org/ont00000995> ;
    skos:definition "A Material Artifact that is designed to partition a Vehicle into subdivisions for various purposes."@en .

<https://www.commoncoreontologies.org/ont00000110> a owl:Class ;
    rdfs:label "Mechanical Process"@en ;
    rdfs:subClassOf <http://purl.obolibrary.org/obo/BFO_0000015> ;
    skos:definition "A Process that is the realization of some Disposition of a Material Artifact"@en .

<https://www.commoncoreontologies.org/ont00000113> a owl:Class ;
    rdfs:label "Ventilation Control Artifact Function"@en ;
    rdfs:subClassOf <https://www.commoncoreontologies.org/ont00000323> ;
    skos:definition "An Artifact Function that is realized in processes in which some Material Artifact is used to control the quality of air in some space."@en .

<https://www.commoncoreontologies.org/ont00000124> a owl:Class ;
    rdfs:label "Solar Time Reference System"@en ;
    rdfs:subClassOf <https://www.commoncoreontologies.org/ont00001328> ;
    skos:definition "A Temporal Reference System that is based on the position of the Sun in the sky."@en .

<https://www.commoncoreontologies.org/ont00000159> a owl:Class ;
    rdfs:label "Material Copy of a Timekeeping Instrument"@en ;
    rdfs:subClassOf <https://www.commoncoreontologies.org/ont00000798> ;
    skos:definition "An Information Bearing Artifact that is designed to carry some specific Information Content Entity that is about some temporal region."@en .

<https://www.commoncoreontologies.org/ont00000169> a owl:Class ;
    rdfs:label "Very High Frequency"@en ;
    rdfs:subClassOf <https://www.commoncoreontologies.org/ont00000150> ;
    skos:definition "A Radio Frequency that is between 30 and 300 MHz."@en .

<https://www.commoncoreontologies.org/ont00000170> a owl:Class ;
    rdfs:label "Object Track Point"@en ;
    rdfs:subClassOf <http://purl.obolibrary.org/obo/BFO_0000018> ;
    skos:definition "A Zero-Dimensional Spatial Region that is an idealized point where an Object is or was located during some motion."@en .

<https://www.commoncoreontologies.org/ont00000180> a owl:Class ;
    rdfs:label "Hotel"@en ;
    rdfs:subClassOf <https://www.commoncoreontologies.org/ont00000410> ;
    skos:definition "A Residential Facility that is designed to provide lodging that is paid for on a short-term basis."@en .

<https://www.commoncoreontologies.org/ont00000189> a owl:Class ;
    rdfs:label "Material Copy of a Certificate"@en ;
    rdfs:subClassOf <https://www.commoncoreontologies.org/ont00000798> ;
    skos:definition "An Information Bearing Artifact that bears an Information Content Entity which attests to certain demonstrated characteristics of an Object, Person, or Organization."@en .

<https://www.commoncoreontologies.org/ont00000191> a owl:Class ;
    rdfs:label "Act of Homicide"@en ;
    rdfs:subClassOf <https://www.commoncoreontologies.org/ont00001147> ;
    skos:definition "An Act of Violence which causes the unlawful killing of another person."@en .

<https://www.commoncoreontologies.org/ont00000205> a owl:Class ;
    rdfs:label "Object Track"@en ;
    rdfs:subClassOf <http://purl.obolibrary.org/obo/BFO_0000026> ;
    skos:definition "A One-Dimensional Spatial Region that consists of the idealized line along which an Object has traversed during some motion."@en .

<https://www.commoncoreontologies.org/ont00000214> a owl:Class ;
    rdfs:label "Moving Target Indication Artifact Function"@en ;
    rdfs:subClassOf <https://www.commoncoreontologies.org/ont00000289> ;
    skos:definition "A Radar Imaging Artifact Function that inheres in Material Artifacts that are designed to identify and produce visual representations of moving entities by using a radar to emit successive phase coherent pulses, which are sampled and added to the subsequent pulse to cancel out signals from non-moving entities such that only signals from moving entities remain and are displayed."@en .

<https://www.commoncoreontologies.org/ont00000215> a owl:Class ;
    rdfs:label "Radio Telescope"@en ;
    rdfs:subClassOf <https://www.commoncoreontologies.org/ont00000547> ;
    skos:definition "A Telescope that is designed to aid in the observation of spatially distant Objects by means of collecting and focusing radio waves to form an enhanced image of the Object."@en .

<https://www.commoncoreontologies.org/ont00000225> a owl:Class ;
    rdfs:label "Month"@en ;
    rdfs:subClassOf <http://purl.obolibrary.org/obo/BFO_0000202> ;
    skos:definition "A Temporal Interval that is based on the approximate length of time required for a Natural Satellite to complete one cycle of its rotational motion around its Primary Body."@en .

<https://www.commoncoreontologies.org/ont00000238> a owl:Class ;
    rdfs:label "Propeller"@en ;
    rdfs:subClassOf <https://www.commoncoreontologies.org/ont00000995> ;
    skos:definition "A Material Artifact that is designed to convert rotary motion from an Engine or other mechanical Power Source into propulsive Force."@en .

<https://www.commoncoreontologies.org/ont00000247> a owl:Class ;
    rdfs:label "Road"@en ;
    rdfs:subClassOf <https://www.commoncoreontologies.org/ont00001326> ;
    skos:definition "A Land Transportation Artifact that is designed to enable Ground Vehicles to travel from one location to another."@en .

<https://www.commoncoreontologies.org/ont00000269> a owl:Class ;
    rdfs:label "Radio Transmitter"@en ;
    rdfs:subClassOf <https://www.commoncoreontologies.org/ont00000903> ;
    skos:definition "A Radio Communication Instrument that is an electronic device that is designed to generate a radio frequency alternating current, which can be applied to a Radio Antenna to be transmitted as radio waves."@en .

<https://www.commoncoreontologies.org/ont00000270> a owl:Class ;
    rdfs:label "Educational Facility"@en ;
    rdfs:subClassOf <https://www.commoncoreontologies.org/ont00000192> ;
    skos:definition "A Facility that is designed for facilitating learning, or the acquisition of knowledge, skills, values, beliefs, and habits."@en .

<https://www.commoncoreontologies.org/ont00000273> a owl:Class ;
    rdfs:label "Communication Interference Artifact Function"@en ;
    rdfs:subClassOf <https://www.commoncoreontologies.org/ont00000323> ;
    skos:definition "An Artifact Function that is realized during events in which a Material Artifact is used to interfere with the transmission of information for the purpose of preventing communication."@en .

<https://www.commoncoreontologies.org/ont00000278> a owl:Class ;
    rdfs:label "Momentum"@en ;
    rdfs:subClassOf <http://purl.obolibrary.org/obo/BFO_0000144> ;
    skos:definition "A Process Profile of an object in Motion that is the product of its Mass and Velocity with respect to a frame of reference."@en .

<https://www.commoncoreontologies.org/ont00000287> a owl:Class ;
    rdfs:label "Inertial Navigation System"@en ;
    rdfs:subClassOf <https://www.commoncoreontologies.org/ont00001187> ;
    skos:definition "A Navigation System that is designed to continuously calculate via dead reckoning the position, orientation, and velocity of a moving object without the need for external references."@en .

<https://www.commoncoreontologies.org/ont00000303> a owl:Class ;
    rdfs:label "Intercommunication System"@en ;
    rdfs:subClassOf <https://www.commoncoreontologies.org/ont00001036> ;
    skos:definition "A Communication System that is designed to enable some Act of Communication between end points within a building, small collection of buildings, or within a small area of service."@en .

<https://www.commoncoreontologies.org/ont00000313> a owl:Class ;
    rdfs:label "Wavelength"@en ;
    rdfs:subClassOf <https://www.commoncoreontologies.org/ont00000752> ;
    skos:definition "A Wave Process Profile that is the distance the Wave Process traverses during one Wave Cycle."@en .

<https://www.commoncoreontologies.org/ont00000319> a owl:Class ;
    rdfs:label "Artifact Design"@en ;
    rdfs:subClassOf <https://www.commoncoreontologies.org/ont00000965> ;
    skos:definition "A Prescriptive Information Content Entity that is a specification of an object, manifested by an agent, intended to accomplish goals, in a particular environment, using a set of primitive components, satisfying a set of requirements, subject to constraints."@en .

<https://www.commoncoreontologies.org/ont00000330> a owl:Class ;
    rdfs:label "Thermal Power Plant"@en ;
    rdfs:subClassOf <https://www.commoncoreontologies.org/ont00001076> ;
    skos:definition "An Electric Power Station that is designed to convert heat energy into electrical energy."@en .

<https://www.commoncoreontologies.org/ont00000332> a owl:Class ;
    rdfs:label "Training Camp"@en ;
    rdfs:subClassOf <https://www.commoncoreontologies.org/ont00000192> ;
    skos:definition "A Facility that is designed for rigorous and focused training in order to learn or improve skills, usually involving physical actions."@en .

<https://www.commoncoreontologies.org/ont00000335> a owl:Class ;
    rdfs:label "Stasis of Generically Dependent Continuant"@en ;
    rdfs:subClassOf <https://www.commoncoreontologies.org/ont00000819> ;
    skos:definition "A Stasis in which some Independent Continuant bears some Generically Dependent Continuant that remains unchanged during a Temporal Interval."@en .

<https://www.commoncoreontologies.org/ont00000339> a owl:Class ;
    rdfs:label "Agricultural Facility"@en ;
    rdfs:subClassOf <https://www.commoncoreontologies.org/ont00000192> ;
    skos:definition "A Facility that is designed as a building or campus for agricultural processes with the aim of cultivating animals, plants, or fungi for food, fiber, biofuel, medicinal plants, or other products to sustain and enhance human life."@en .

<https://www.commoncoreontologies.org/ont00000363> a owl:Class ;
    rdfs:label "Wireless Telecommunication Network"@en ;
    rdfs:subClassOf <https://www.commoncoreontologies.org/ont00000998> ;
    skos:definition "A Telecommunication Network that uses wireless connections to connect Telecommunication Network Nodes."@en .

<https://www.commoncoreontologies.org/ont00000366> a owl:Class ;
    rdfs:label "Act of Information Processing"@en ;
    rdfs:subClassOf <https://www.commoncoreontologies.org/ont00000228> ;
    skos:definition "A Planned Act in which one or more input Information Content Entities are received, manipulated, transferred, or stored by an Agent."@en .

<https://www.commoncoreontologies.org/ont00000373> a owl:Class ;
    rdfs:label "Geospatial Position"@en ;
    rdfs:subClassOf <http://purl.obolibrary.org/obo/BFO_0000147> ;
    skos:definition "A Fiat Point that is at or near the surface of the Earth and fixed according to some Geospatial Coordinate Reference System."@en .

<https://www.commoncoreontologies.org/ont00000380> a owl:Class ;
    rdfs:label "Pressure"@en ;
    rdfs:subClassOf <https://www.commoncoreontologies.org/ont00000570> ;
    skos:definition "A Force that is applied perpendicular to the surface of an Object per unit area over which that Force is distributed."@en .

<https://www.commoncoreontologies.org/ont00000390> a owl:Class ;
    rdfs:label "Spatial Region Identifier"@en ;
    rdfs:subClassOf <https://www.commoncoreontologies.org/ont00000686> ;
    skos:definition "A Designative Information Content Entity that designates some Spatial Region."@en .

<https://www.commoncoreontologies.org/ont00000406> a owl:Class ;
    rdfs:label "Measurement Unit of Geocoordinate"@en ;
    rdfs:subClassOf <https://www.commoncoreontologies.org/ont00000120> ;
    skos:definition "A Measurement Unit specifying the geospatial coordinates of a location."@en .

<https://www.commoncoreontologies.org/ont00000426> a owl:Class ;
    rdfs:label "Military Personnel Force"@en ;
    rdfs:subClassOf <https://www.commoncoreontologies.org/ont00000274> ;
    skos:definition "An Armed Force authorized to use deadly force, and weapons, to support the interests of the Government and some or all of its Citizens."@en .

<https://www.commoncoreontologies.org/ont00000437> a owl:Class ;
    rdfs:label "Enhancing Artifact Function"@en ;
    rdfs:subClassOf <https://www.commoncoreontologies.org/ont00000323> ;
    skos:definition "An Artifact Function that is realized in processes of intensifying, increainsg, or further improving the quality, value, or extent of some entity."@en .

<https://www.commoncoreontologies.org/ont00000478> a owl:Class ;
    rdfs:label "Cuboidal"@en ;
    rdfs:subClassOf <https://www.commoncoreontologies.org/ont00001360> ;
    skos:definition "A Three Dimensional Shape that inheres in a bearer in virtue of it having six Rectangular faces."@en .

<https://www.commoncoreontologies.org/ont00000487> a owl:Class ;
    rdfs:label "Geospatial Location"@en ;
    rdfs:subClassOf <https://www.commoncoreontologies.org/ont00000472> ;
    skos:definition "A Geospatial Region that is the location of an Independent Continuant (that is not a Spatial Region) or that environs some Process."@en .

<https://www.commoncoreontologies.org/ont00000496> a owl:Class ;
    rdfs:label "Natural Language"@en ;
    rdfs:subClassOf <https://www.commoncoreontologies.org/ont00001175> ;
    skos:definition "A Language that is developed and evolves through use and repetition, rather than through conscious planning or premeditation."@en .

<https://www.commoncoreontologies.org/ont00000503> a owl:Class ;
    rdfs:label "Power"@en ;
    rdfs:subClassOf <http://purl.obolibrary.org/obo/BFO_0000144> ;
    skos:definition "A Process Profile that is characterized by the rate of Work, or Energy consumed, done in a given time period."@en .

<https://www.commoncoreontologies.org/ont00000504> a owl:Class ;
    rdfs:label "Optical Processing Artifact Function"@en ;
    rdfs:subClassOf <https://www.commoncoreontologies.org/ont00000323> ;
    skos:definition "An Artifact Function that is realized by a Material Artifact participating in a visible light processing event."@en .

<https://www.commoncoreontologies.org/ont00000531> a owl:Class ;
    rdfs:label "Communications Facility"@en ;
    rdfs:subClassOf <https://www.commoncoreontologies.org/ont00000192> ;
    skos:definition "A Facility that is designed to support processes of receiving or transmitting information."@en .

<https://www.commoncoreontologies.org/ont00000540> a owl:Class ;
    rdfs:label "Temporal Instant Identifier"@en ;
    rdfs:subClassOf <https://www.commoncoreontologies.org/ont00000399> ;
    skos:definition "A Temporal Region Identifier that designates some Temporal Instant."@en .

<https://www.commoncoreontologies.org/ont00000543> a owl:Class ;
    rdfs:label "Decrease of Disposition"@en ;
    rdfs:subClassOf <https://www.commoncoreontologies.org/ont00000854> ;
    skos:definition "A Decrease of Realizable Entity in which some Independent Continuant has a decrease of some Disposition it bears."@en .

<https://www.commoncoreontologies.org/ont00000549> a owl:Class ;
    rdfs:label "Water Transportation Artifact"@en ;
    rdfs:subClassOf <https://www.commoncoreontologies.org/ont00000254> ;
    skos:definition "A Transportation Artifact that facilitates the movement of Agents and Vehicles via water."@en .

<https://www.commoncoreontologies.org/ont00000557> a owl:Class ;
    rdfs:label "Stasis of Non-Mission Capable"@en ;
    rdfs:subClassOf <https://www.commoncoreontologies.org/ont00001132> ;
    skos:definition "A Stasis of Mission Capability during which the participating Continuant is not capable of performing any of its primary functions for the specified Mission."@en .

<https://www.commoncoreontologies.org/ont00000562> a owl:Class ;
    rdfs:label "Animal"@en ;
    rdfs:subClassOf <https://www.commoncoreontologies.org/ont00000551> ;
    skos:definition "An Organism that is multicellular, eukaryotic, heterotrophic, and capable of motility for part of its life."@en .

<https://www.commoncoreontologies.org/ont00000608> a owl:Class ;
    rdfs:label "Financial Value"@en ;
    rdfs:subClassOf <http://purl.obolibrary.org/obo/BFO_0000019> ;
    skos:definition "A quality that inheres in an independent continuant to the degree that that independent continuant can serve as a medium of exchange in an economic system at a particular time."@en .

<https://www.commoncoreontologies.org/ont00000609> a owl:Class ;
    rdfs:label "Gain of Disposition"@en ;
    rdfs:subClassOf <https://www.commoncoreontologies.org/ont00000642> ;
    skos:definition "A Gain of Realizable Entity in which some Independent Continuant becomes the bearer of some Disposition."@en .

<https://www.commoncoreontologies.org/ont00000619> a owl:Class ;
    rdfs:label "Week"@en ;
    rdfs:subClassOf <http://purl.obolibrary.org/obo/BFO_0000202> ;
    skos:definition "A Temporal Interval that is equal to seven consecutive Days."@en .

<https://www.commoncoreontologies.org/ont00000638> a owl:Class ;
    rdfs:label "Heat Engine"@en ;
    rdfs:subClassOf <https://www.commoncoreontologies.org/ont00000210> ;
    skos:definition "An Engine that is designed to convert thermal energy into mechanical energy."@en .

<https://www.commoncoreontologies.org/ont00000641> a owl:Class ;
    rdfs:label "Entertainment Facility"@en ;
    rdfs:subClassOf <https://www.commoncoreontologies.org/ont00000192> ;
    skos:definition "A Facility that is designed to host activities that are intended to hold the interest of, or give pleasure or delight to, an audience."@en .

<https://www.commoncoreontologies.org/ont00000646> a owl:Class ;
    rdfs:label "Highway"@en ;
    rdfs:subClassOf <https://www.commoncoreontologies.org/ont00000247> ;
    skos:definition "A Road that is designed to enable Ground Vehicles to travel on routes that connect relatively major destinations."@en .

<https://www.commoncoreontologies.org/ont00000655> a owl:Class ;
    rdfs:label "Mailing Facility"@en ;
    rdfs:subClassOf <https://www.commoncoreontologies.org/ont00000192> ;
    skos:definition "A Facility that is designed for the systematic physical transportation of documents and packages."@en .

<https://www.commoncoreontologies.org/ont00000660> a owl:Class ;
    rdfs:label "Effect"@en ;
    rdfs:subClassOf <http://purl.obolibrary.org/obo/BFO_0000015> ;
    skos:definition "A Process that follows and is caused by some previous Process."@en .

<https://www.commoncoreontologies.org/ont00000662> a owl:Class ;
    rdfs:label "Material Territory of a Government Domain"@en ;
    rdfs:subClassOf <https://www.commoncoreontologies.org/ont00001341> ;
    skos:definition "The portions of lithosphere, hydrosphere, or atmosphere that together exactly occupy a Government Domain"@en .

<https://www.commoncoreontologies.org/ont00000663> a owl:Class ;
    rdfs:label "Power Transmission Artifact"@en ;
    rdfs:subClassOf <https://www.commoncoreontologies.org/ont00000995> ;
    skos:definition "A Material Artifact that is designed to transfer and regulate Power flow from a Power Source to an application point."@en .

<https://www.commoncoreontologies.org/ont00000675> a owl:Class ;
    rdfs:label "Sound Wave Process"@en ;
    rdfs:subClassOf <https://www.commoncoreontologies.org/ont00001028> ;
    skos:definition "A Mechanical Wave Process of Pressure and displacement that is parallel to the propogation direction of the Wave Process through a medium."@en .

<https://www.commoncoreontologies.org/ont00000696> a owl:Class ;
    rdfs:label "Ideology"@en ;
    rdfs:subClassOf <https://www.commoncoreontologies.org/ont00000958> ;
    skos:definition "An Information Content Entity that consists of a collection of claims about how some part of the world is or should be and which is accepted as true by an Agent or Group of Agents such that it forms the basis of their beliefs, goals, expectations, and motivations."@en .

<https://www.commoncoreontologies.org/ont00000702> a owl:Class ;
    rdfs:label "Material Copy of an Image"@en ;
    rdfs:subClassOf <https://www.commoncoreontologies.org/ont00000798> ;
    skos:definition "An Information Bearing Artifact that is designed to carry an Information Content Entity that represents some entity owing to a visual isomorphism between the carrying artifact and the entity."@en .

<https://www.commoncoreontologies.org/ont00000712> a owl:Class ;
    rdfs:label "Acceleration"@en ;
    rdfs:subClassOf <http://purl.obolibrary.org/obo/BFO_0000144> ;
    skos:definition "A Process Profile that is the rate of change of the Velocity of an object."@en .

<https://www.commoncoreontologies.org/ont00000763> a owl:Class ;
    rdfs:label "Velocity"@en ;
    rdfs:subClassOf <http://purl.obolibrary.org/obo/BFO_0000144> ;
    skos:definition "A Process Profile of an object's Motion that is characterized by its Speed and direction with respect to a frame of reference."@en .

<https://www.commoncoreontologies.org/ont00000765> a owl:Class ;
    rdfs:label "Wave Production"@en ;
    rdfs:subClassOf <https://www.commoncoreontologies.org/ont00000007> ;
    skos:definition "A Natural Process in which a Wave Process is generated."@en .

<https://www.commoncoreontologies.org/ont00000774> a owl:Class ;
    rdfs:label "Video Camera"@en ;
    rdfs:subClassOf <https://www.commoncoreontologies.org/ont00000199> ;
    skos:definition "A Camera that is designed to form and digitally or physically record a continuous stream of subsequent images of an entity or scene such that the images can be played back in succession as a video."@en .

<https://www.commoncoreontologies.org/ont00000799> a owl:Class ;
    rdfs:label "Material Copy of a List"@en ;
    rdfs:subClassOf <https://www.commoncoreontologies.org/ont00000798> ;
    skos:definition "An Information Bearing Artifact that consists of one or more Information Bearing Artifacts that carry Information Content Entities and are the subjects of some Sequence Position Ordinality."@en .

<https://www.commoncoreontologies.org/ont00000800> a owl:Class ;
    rdfs:label "Day"@en ;
    rdfs:subClassOf <http://purl.obolibrary.org/obo/BFO_0000202> ;
    skos:definition "A Temporal Interval that is equal to the approximate length of time required for an Astronomical Body to complete one rotation around its Rotational Axis as specified relative to a particular Temporal Reference System."@en .

<https://www.commoncoreontologies.org/ont00000821> a owl:Class ;
    rdfs:label "Act of Promising"@en ;
    rdfs:subClassOf <https://www.commoncoreontologies.org/ont00001162> ;
    skos:definition "An Act of Commissive Communication performed by declaring that the promising agent will do, or refrain from doing, the specified action."@en .

<https://www.commoncoreontologies.org/ont00000825> a owl:Class ;
    rdfs:label "Telecommunication Network Line"@en ;
    rdfs:subClassOf <https://www.commoncoreontologies.org/ont00000346> ;
    skos:definition "A Communication Artifact that is designed to be the physical transmission medium that connects two or more Telecommunication Network Nodes within a Telecommunication Network to facilitate communication between the Nodes."@en .

<https://www.commoncoreontologies.org/ont00000831> a owl:Class ;
    rdfs:label "Herbicide Artifact Function"@en ;
    rdfs:subClassOf <https://www.commoncoreontologies.org/ont00000828> ;
    skos:definition "A Pesticide Artifact Function that is realized in a process which causes harm to, or the death to, unwanted plants."@en .

<https://www.commoncoreontologies.org/ont00000832> a owl:Class ;
    rdfs:label "Year"@en ;
    rdfs:subClassOf <http://purl.obolibrary.org/obo/BFO_0000202> ;
    skos:definition "A Temporal Interval that is equal to the approximate length of time required for an Astronomical Body to complete one Orbital Revolution around its Primary Body as specified relative to a particular Temporal Reference System."@en .

<https://www.commoncoreontologies.org/ont00000837> a owl:Class ;
    rdfs:label "Family"@en ;
    rdfs:subClassOf <https://www.commoncoreontologies.org/ont00000914> ;
    skos:definition "A Group of Persons related to one another by ancestry or marriage."@en .

<https://www.commoncoreontologies.org/ont00000847> a owl:Class ;
    rdfs:label "Active Stasis"@en ;
    rdfs:subClassOf <https://www.commoncoreontologies.org/ont00001213> ;
    owl:disjointWith <https://www.commoncoreontologies.org/ont00000936> ;
    skos:definition "A Stasis of Artifact Operationality that holds during a Temporal Interval when a Material Artifact is realizing one or more of its designed Artifact Functions (especially one of its primary functions)."@en .

<https://www.commoncoreontologies.org/ont00000850> a owl:Class ;
    rdfs:label "Stasis of Quality"@en ;
    rdfs:subClassOf <https://www.commoncoreontologies.org/ont00000135> ;
    skos:definition "A Stasis of Specifically Dependent Continuant in which some Independent Continuant bears some Quality that remains unchanged during a Temporal Interval."@en .

<https://www.commoncoreontologies.org/ont00000892> a owl:Class ;
    rdfs:label "Depth"@en ;
    rdfs:subClassOf <https://www.commoncoreontologies.org/ont00001367> ;
    skos:definition "A One Dimensional Extent that inheres in a bearer in virtue of the bearer's extension in a downward, backward, or inward direction."@en .

<https://www.commoncoreontologies.org/ont00000923> a owl:Class ;
    rdfs:label "Arbitrary Identifier"@en ;
    rdfs:subClassOf <https://www.commoncoreontologies.org/ont00000649> ;
    skos:definition "A Non-Name Identifier that consists of a string of characters that does not follow an encoding system."@en .

<https://www.commoncoreontologies.org/ont00000936> a owl:Class ;
    rdfs:label "Deactivated Stasis"@en ;
    rdfs:subClassOf <https://www.commoncoreontologies.org/ont00001213> ;
    skos:definition "A Stasis of Artifact Operationality that holds during a Temporal Interval when a Material Artifact is not realizing any of its designed Artifact Functions (or at least not realizing any of its primary functions)."@en .

<https://www.commoncoreontologies.org/ont00000951> a owl:Class ;
    rdfs:label "Electromagnetic Wave Process"@en ;
    rdfs:subClassOf <https://www.commoncoreontologies.org/ont00000099> ;
    skos:definition "A Wave Process that is produced by charged particles, involves the periodic Oscillation of electric and magnetic fields at right angles to each other and the direction of wave propogation such that it has a Transverse Wave Profile, and which transfers electromagnetic radiant energy through a portion of space or matter."@en .

<https://www.commoncoreontologies.org/ont00000967> a owl:Class ;
    rdfs:label "Height"@en ;
    rdfs:subClassOf <https://www.commoncoreontologies.org/ont00001367> ;
    skos:definition "A One Dimensional Extent that inheres in a bearer in virtue of the bearer's extension in a vertical direction."@en .

<https://www.commoncoreontologies.org/ont00000970> a owl:Class ;
    rdfs:label "Act of Artifact Modification"@en ;
    rdfs:subClassOf <https://www.commoncoreontologies.org/ont00000908> ;
    skos:definition "An Act of Material Artifact Processing in which an existing Material Artifact is acted upon in a manner that changes, adds, or removes one or more of its Qualities, Dispositions, or Functions."@en .

<https://www.commoncoreontologies.org/ont00000971> a owl:Class ;
    rdfs:label "Act of Deceptive Communication"@en ;
    rdfs:subClassOf <https://www.commoncoreontologies.org/ont00000402> ;
    skos:definition "Ac Act of Communication intended to mislead the audience by distortion or falsification of evidence and induce a reaction that is prejudicial to the interests of the audience."@en .

<https://www.commoncoreontologies.org/ont00000980> a owl:Class ;
    rdfs:label "Portion of Waste Material"@en ;
    rdfs:subClassOf <https://www.commoncoreontologies.org/ont00001084> ;
    skos:definition "A Portion of Processed Material that serves no further use in terms of the initial user's own purposes of production, transformation, or consumption such that the Agent wants to dispose of it."@en .

<https://www.commoncoreontologies.org/ont00000997> a owl:Class ;
    rdfs:label "Disrupting Disposition"@en ;
    rdfs:subClassOf <http://purl.obolibrary.org/obo/BFO_0000016> ;
    skos:definition "A disposition the realization of which would disrupt a process some entity has an interest in."@en .

<https://www.commoncoreontologies.org/ont00001014> a owl:Class ;
    rdfs:label "Proper Name"@en ;
    rdfs:subClassOf <https://www.commoncoreontologies.org/ont00000003> ;
    skos:definition "A Designative Name that is an official name for a particular entity."@en .

<https://www.commoncoreontologies.org/ont00001029> a owl:Class ;
    rdfs:label "Unguided Rocket"@en ;
    rdfs:subClassOf <https://www.commoncoreontologies.org/ont00001150> ;
    skos:definition "A Portion of Ammunition that is designed to be a self-propelled, but unguided, projectile that delivers some payload (explosive or other) over relatively long distances through the use of a Rocket Engine."@en .

<https://www.commoncoreontologies.org/ont00001042> a owl:Class ;
    rdfs:label "Equipment Mount"@en ;
    rdfs:subClassOf <https://www.commoncoreontologies.org/ont00000995> ;
    skos:definition "A Material Artifact that is designed to support a Material Artifact."@en .

<https://www.commoncoreontologies.org/ont00001046> a owl:Class ;
    rdfs:label "Material Copy of a Notification Message"@en ;
    rdfs:subClassOf <https://www.commoncoreontologies.org/ont00001002> ;
    skos:definition "A Material Copy of a Message that is designed to carry an Information Content Entity that describes a scenario that has been determined to merit attention by the recipient."@en .

<https://www.commoncoreontologies.org/ont00001050> a owl:Class ;
    rdfs:label "Primary Cell Electric Battery"@en ;
    rdfs:subClassOf <https://www.commoncoreontologies.org/ont00000716> ;
    skos:definition "A Electric Battery that is designed for one-time use and not to be recharged."@en .

<https://www.commoncoreontologies.org/ont00001066> a owl:Class ;
    rdfs:label "Loss of Disposition"@en ;
    rdfs:subClassOf <https://www.commoncoreontologies.org/ont00000250> ;
    skos:definition "A Loss of Realizable Entity in which some Independent Continuant ceases to be the bearer of some Disposition."@en .

<https://www.commoncoreontologies.org/ont00001078> a owl:Class ;
    rdfs:label "Airport"@en ;
    rdfs:subClassOf <https://www.commoncoreontologies.org/ont00000226> ;
    skos:definition "A Transportation Facility that is designed for launching, receiving, and housing Aircraft."@en .

<https://www.commoncoreontologies.org/ont00001086> a owl:Class ;
    rdfs:label "Road Junction"@en ;
    rdfs:subClassOf <https://www.commoncoreontologies.org/ont00001326> ;
    skos:definition "A Land Transportation Artifact that is designed to enable Ground Vehicles to exit one Road and enter another."@en .

<https://www.commoncoreontologies.org/ont00001101> a owl:Class ;
    rdfs:label "Interval Estimate Information Content Entity"@en ;
    rdfs:subClassOf <https://www.commoncoreontologies.org/ont00001176> ;
    skos:definition "An Estimate Information Content Entity that consists of an interval of possible (or probable) values for the measured entity."@en .

<https://www.commoncoreontologies.org/ont00001123> a owl:Class ;
    rdfs:label "Poison Artifact Function"@en ;
    rdfs:subClassOf <https://www.commoncoreontologies.org/ont00001153> ;
    skos:definition "A Damaging Artifact Function that is realized in a process which causes illness in, or the death of, a living thing."@en .

<https://www.commoncoreontologies.org/ont00001124> a owl:Class ;
    rdfs:label "Precision-Guided Missile"@en ;
    rdfs:subClassOf <https://www.commoncoreontologies.org/ont00001150> ;
    skos:definition "A Portion of Ammunition that is designed to be a self-propelled and precision-guided projectile that delivers some payload (explosive or other) over relatively long distances."@en .

<https://www.commoncoreontologies.org/ont00001130> a owl:Class ;
    rdfs:label "Geospatial Polygon"@en ;
    rdfs:subClassOf <https://www.commoncoreontologies.org/ont00000817> ;
    skos:definition "A Geospatial Line String that has at least three vertices where the connecting lines form a closed loop."@en .

<https://www.commoncoreontologies.org/ont00001139> a owl:Class ;
    rdfs:label "Spacecraft"@en ;
    rdfs:subClassOf <https://www.commoncoreontologies.org/ont00000713> ;
    skos:definition "A Vehicle that is designed to convey passengers, cargo, or equipment from one location to another by Spaceflight."@en .

<https://www.commoncoreontologies.org/ont00001187> a owl:Class ;
    rdfs:label "Navigation System"@en ;
    rdfs:subClassOf <https://www.commoncoreontologies.org/ont00000995> ;
    skos:definition "A Material Artifact that is designed to enable an Agent or Material Artifact to determine the position or direction of some object, usually for the purpose of monitoring or controlling the movement of some Vehicle from one place to another."@en .

<https://www.commoncoreontologies.org/ont00001218> a owl:Class ;
    rdfs:label "Signal Processing Artifact Function"@en ;
    rdfs:subClassOf <https://www.commoncoreontologies.org/ont00000323> ;
    skos:definition "An Artifact Function that is realized in the process of transferring or processing information contained in signals."@en .

<https://www.commoncoreontologies.org/ont00001226> a owl:Class ;
    rdfs:label "Act of Employment by an Organization"@en ;
    rdfs:subClassOf <https://www.commoncoreontologies.org/ont00002071> ;
    skos:definition "An Act of Employment wherein an Organization assigns a set of activities to some Person to be performed in exchange for financial compensation."@en .

<https://www.commoncoreontologies.org/ont00001232> a owl:Class ;
    rdfs:label "Act of Possession"@en ;
    rdfs:subClassOf <https://www.commoncoreontologies.org/ont00000228> ;
    skos:definition "A Planned Act in which an agent intentionally exercises control towards a thing."@en .

<https://www.commoncoreontologies.org/ont00001258> a owl:Class ;
    rdfs:label "Port"@en ;
    rdfs:subClassOf <https://www.commoncoreontologies.org/ont00000226> ;
    skos:definition "A Transportation Facility that is designed to contain harbors for docking Watercraft and for transfering people or cargo to and from land."@en .

<https://www.commoncoreontologies.org/ont00001272> a owl:Class ;
    rdfs:label "Act of Murder"@en ;
    rdfs:subClassOf <https://www.commoncoreontologies.org/ont00000191> ;
    skos:definition "An Act of Homicide with malice aforethought."@en .

<https://www.commoncoreontologies.org/ont00001281> a owl:Class ;
    rdfs:label "Emulsifier Artifact Function"@en ;
    rdfs:subClassOf <https://www.commoncoreontologies.org/ont00000791> ;
    skos:definition "A Chemical Reaction Artifact Function that is realized in a process in which two or more liquids that are normally immiscible are mixed."@en .

<https://www.commoncoreontologies.org/ont00001289> a owl:Class ;
    rdfs:label "Damaged Stasis"@en ;
    rdfs:subClassOf <https://www.commoncoreontologies.org/ont00000135> ;
    skos:definition "A Stasis of Specifically Dependent Continuant in which some Independent Continuant bears a Quality or Realizable Entity that has suffered impairment (i.e., a decrease or loss) due to a previous action or event such that the Independent Continuant is now of lesser value, usefulness, or functionality."@en .

<https://www.commoncoreontologies.org/ont00001293> a owl:Class ;
    rdfs:label "Perimeter"@en ;
    rdfs:subClassOf <https://www.commoncoreontologies.org/ont00001367> ;
    skos:definition "A One Dimensional Extent that inheres in a bearer in virtue of the extent of a boundary which encloses the bearer."@en .

<https://www.commoncoreontologies.org/ont00001320> a owl:Class ;
    rdfs:label "Radio Transceiver"@en ;
    rdfs:subClassOf <https://www.commoncoreontologies.org/ont00000903> ;
    skos:definition "A Radio Communication Instrument that is an electronic device composed of both a Radio Transmitter and a Radio Receiver that share common circuitry or a single housing."@en .

<https://www.commoncoreontologies.org/ont00001335> a owl:Class ;
    rdfs:label "Government"@en ;
    rdfs:subClassOf <https://www.commoncoreontologies.org/ont00001180> ;
    skos:definition "An Organization that is the highest legitimate authority delimited by some Delimiting Domain and that exercises executive, legislative, or judicial authority in that Domain."@en .

<https://www.commoncoreontologies.org/ont00001341> a owl:Class ;
    rdfs:label "Portion of Geosphere"@en ;
    rdfs:subClassOf <http://purl.obolibrary.org/obo/BFO_0000024> ;
    skos:definition "A fiat object part that is composed of one or more portions of the atmosphere, cryosphere, hydrosphere, or lithosphere"@en .

<https://www.commoncoreontologies.org/ont00001346> a owl:Class ;
    rdfs:label "Legal Instrument"@en ;
    rdfs:subClassOf <https://www.commoncoreontologies.org/ont00000995> ;
    skos:definition "A Material Artifact that is designed as a formally executed written document that can be formally attributed to its author, records and formally expresses a legally enforceable act, process, or contractual duty, obligation, or right, and therefore evidences that act, process, or agreement."@en .

<https://www.commoncoreontologies.org/ont00001350> a owl:Class ;
    rdfs:label "Thermal Control Artifact Function"@en ;
    rdfs:subClassOf <https://www.commoncoreontologies.org/ont00000323> ;
    skos:definition "An Artifact Function that is realized by a Material Artifact increasing, decreasing, or maintaining the temperature of itself, a part of itself, or another object."@en .

<https://www.commoncoreontologies.org/ont00001356> a owl:Class ;
    rdfs:label "Increase of Disposition"@en ;
    rdfs:subClassOf <https://www.commoncoreontologies.org/ont00000611> ;
    skos:definition "An Increase of Realizable Entity in which some Independent Continuant has an increase of some Disposition that it bears."@en .

<https://www.commoncoreontologies.org/ont00001369> a owl:Class ;
    rdfs:label "Rectangular"@en ;
    rdfs:subClassOf <https://www.commoncoreontologies.org/ont00001059> ;
    skos:definition "A Shape Quality inhering in a bearer in virtue of having four sides and four 90 degree angles."@en .

<https://www.commoncoreontologies.org/ont00001370> a owl:Class ;
    rdfs:label "Machine Bearing"@en ;
    rdfs:subClassOf <https://www.commoncoreontologies.org/ont00000995> ;
    skos:definition "A Material Artifact that is designed to constrain relative motion to only desired motion and reduces friction between moving parts."@en .

<https://www.commoncoreontologies.org/ont00001375> a owl:Class ;
    rdfs:label "Washing Facility"@en ;
    rdfs:subClassOf <https://www.commoncoreontologies.org/ont00000192> ;
    skos:definition "A Facility that is designed to wash personnel or equipment."@en .

<https://www.commoncoreontologies.org/ont00001999> a owl:Class ;
    rdfs:label "Filter Function"@en ;
    rdfs:subClassOf <https://www.commoncoreontologies.org/ont00000323> ;
    skos:definition "An Artifact Function that is realized in a process where entities of a specific type or which have specified properties enter it or pass through it."@en .

<https://www.commoncoreontologies.org/ont00002002> a owl:Class ;
    rdfs:label "Certificate"@en ;
    rdfs:subClassOf <https://www.commoncoreontologies.org/ont00002001> ;
    skos:definition "A Media Content Entity that attests to certain demonstrated characteristics of an Object, Person, or Organization."@en .

<https://www.commoncoreontologies.org/ont00002004> a owl:Class ;
    rdfs:label "Image"@en ;
    rdfs:subClassOf <https://www.commoncoreontologies.org/ont00002001> ;
    skos:definition "A Media Content Entity represents some entity owing to a visual isomorphism between the carrying artifact and the entity."@en .

<https://www.commoncoreontologies.org/ont00002007> a owl:Class ;
    rdfs:label "List"@en ;
    rdfs:subClassOf <https://www.commoncoreontologies.org/ont00002001> ;
    skos:definition "A Media Content Entity whose parts are the subject of some Sequence Position Ordinality."@en .

<https://www.commoncoreontologies.org/ont00002071> a owl:Class ;
    rdfs:label "Act of Employment"@en ;
    rdfs:subClassOf <https://www.commoncoreontologies.org/ont00000433> ;
    skos:definition "An Act of Association wherein an Agent assigns a set of activities to some Person to be performed in exchange for financial compensation."@en .

<http://purl.obolibrary.org/obo/BFO_0000030> a owl:Class ;
    rdfs:label "object"@en ;
    rdfs:subClassOf <http://purl.obolibrary.org/obo/BFO_0000040> ;
    skos:definition "(Elucidation) An object is a material entity which manifests causal unity & is of a type instances of which are maximal relative to the sort of causal unity manifested"@en .

<http://purl.obolibrary.org/obo/BFO_0000034> a owl:Class ;
    rdfs:label "function"@en ;
    rdfs:subClassOf <http://purl.obolibrary.org/obo/BFO_0000016> ;
    skos:definition "(Elucidation) A function is a disposition that exists in virtue of its bearer's physical make-up & this physical make-up is something the bearer possesses because it came into being either through evolution (in the case of natural biological entities) or through intentional design (in the case of artefacts) in order to realize processes of a certain sort"@en .

<http://purl.obolibrary.org/obo/BFO_0000145> a owl:Class ;
    rdfs:label "relational quality"@en ;
    rdfs:subClassOf <http://purl.obolibrary.org/obo/BFO_0000019> ;
    skos:definition "b is a relational quality =Def b is a quality & there exists c and d such that c and d are not identical & b specifically depends on c & b specifically depends on d"@en .

<http://purl.obolibrary.org/obo/BFO_0000146> a owl:Class ;
    rdfs:label "fiat surface"@en ;
    rdfs:subClassOf <http://purl.obolibrary.org/obo/BFO_0000140> ;
    owl:disjointWith <http://purl.obolibrary.org/obo/BFO_0000147> ;
    skos:definition "(Elucidation) A fiat surface is a two-dimensional continuant fiat boundary that is self-connected"@en .

<http://purl.obolibrary.org/obo/BFO_0000148> a owl:Class ;
    rdfs:label "zero-dimensional temporal region"@en ;
    rdfs:subClassOf <http://purl.obolibrary.org/obo/BFO_0000008> ;
    skos:definition "(Elucidation) A zero-dimensional temporal region is a temporal region that is a whole consisting of one or more separated temporal instants as parts"@en .

<https://www.commoncoreontologies.org/ont00000056> a owl:Class ;
    rdfs:label "Reaction Engine"@en ;
    rdfs:subClassOf <https://www.commoncoreontologies.org/ont00000210> ;
    skos:definition "An Engine that provides propulsion by expelling Reaction Mass."@en .

<https://www.commoncoreontologies.org/ont00000061> a owl:Class ;
    rdfs:label "Measurement Unit of Flow"@en ;
    rdfs:subClassOf <https://www.commoncoreontologies.org/ont00000120> ;
    skos:definition "A Measurement Unit that is used as a standard for measurement of the rate at which portions of a substance pass per unit of time."@en .

<https://www.commoncoreontologies.org/ont00000077> a owl:Class ;
    rdfs:label "Code Identifier"@en ;
    rdfs:subClassOf <https://www.commoncoreontologies.org/ont00000649> ;
    owl:disjointWith <https://www.commoncoreontologies.org/ont00000923> ;
    skos:definition "A Non-Name Identifier that consists of a string of characters that was created and assigned according to an encoding system such that metadata can be derived from the identifier."@en .

<https://www.commoncoreontologies.org/ont00000117> a owl:Class ;
    rdfs:label "Information Processing Artifact"@en ;
    rdfs:subClassOf <https://www.commoncoreontologies.org/ont00000995> ;
    skos:definition "A Material Artifact that is designed to use algorithms to transform some Information Content Entity into another Information Content Entity."@en .

<https://www.commoncoreontologies.org/ont00000126> a owl:Class ;
    rdfs:label "First-Order Administrative Region"@en ;
    rdfs:subClassOf <https://www.commoncoreontologies.org/ont00001152> ;
    skos:definition "A Government Domain that is a primary administrative division of a Country."@en .

<https://www.commoncoreontologies.org/ont00000127> a owl:Class ;
    rdfs:label "Performance Specification"@en ;
    rdfs:subClassOf <https://www.commoncoreontologies.org/ont00000965> ;
    skos:definition "A Prescriptive Information Content Entity that prescribes some aspect of the behavior of a participant in a Process given one or more operating conditions."@en .

<https://www.commoncoreontologies.org/ont00000156> a owl:Class ;
    rdfs:label "Hand Gun"@en ;
    rdfs:subClassOf <https://www.commoncoreontologies.org/ont00000088> ;
    skos:definition "A Firearm that is designed to have a relatively short barrel and to be held in one or two hands and to be fired without being braced against the shoulder."@en .

<https://www.commoncoreontologies.org/ont00000204> a owl:Class ;
    rdfs:label "Rifle"@en ;
    rdfs:subClassOf <https://www.commoncoreontologies.org/ont00001104> ;
    skos:definition "A Long Gun that is designed to have a rifled barrel and to fire single Bullets over long ranges with high accuracy."@en .

<https://www.commoncoreontologies.org/ont00000223> a owl:Class ;
    rdfs:label "Time of Day"@en ;
    rdfs:subClassOf <http://purl.obolibrary.org/obo/BFO_0000203> ;
    skos:definition "A Temporal Instant that is part of a Day."@en .

<https://www.commoncoreontologies.org/ont00000224> a owl:Class ;
    rdfs:label "Populated place"@en ;
    rdfs:subClassOf <https://www.commoncoreontologies.org/ont00001197> ;
    skos:definition "An Anthropogenic Feature at which people live or have lived."@en .

<https://www.commoncoreontologies.org/ont00000234> a owl:Class ;
    rdfs:label "Act of Training"@en ;
    rdfs:subClassOf <https://www.commoncoreontologies.org/ont00000228> ;
    skos:definition "A Planned Act in which knowledge, skills or values are imparted from one or more Agents to at least one other Agent."@en .

<https://www.commoncoreontologies.org/ont00000236> a owl:Class ;
    rdfs:label "Lighting System"@en ;
    rdfs:subClassOf <https://www.commoncoreontologies.org/ont00000995> ;
    skos:definition "A Material Artifact that is designed to emit light within some area."@en .

<https://www.commoncoreontologies.org/ont00000250> a owl:Class ;
    rdfs:label "Loss of Realizable Entity"@en ;
    rdfs:subClassOf <https://www.commoncoreontologies.org/ont00000865> ;
    skos:definition "A Loss of Specifically Dependent Continuant in which some Independent Continuant ceases to be the bearer of some Realizable Entity."@en .

<https://www.commoncoreontologies.org/ont00000268> a owl:Class ;
    rdfs:label "Cannon"@en ;
    rdfs:subClassOf <https://www.commoncoreontologies.org/ont00001051> ;
    skos:definition "A Projectile Launcher that is designed to use a controlled explosion to launch a relatively large Portion of Ammunition, such as a Round Shot or a Shell, at a significant Velocity."@en .

<https://www.commoncoreontologies.org/ont00000274> a owl:Class ;
    rdfs:label "Armed Force"@en ;
    rdfs:subClassOf <https://www.commoncoreontologies.org/ont00001180> ;
    skos:definition "An Organization having the Objective to further the foreign and domestic policies of a Government and to defend that body and the nation it represents from external and internal aggressors."@en .

<https://www.commoncoreontologies.org/ont00000289> a owl:Class ;
    rdfs:label "Radar Imaging Artifact Function"@en ;
    rdfs:subClassOf <https://www.commoncoreontologies.org/ont00000601> ;
    skos:definition "An Imaging Artifact Function that inheres in Material Artifacts that are designed to produce visual representations of entities using radio waves."@en .

<https://www.commoncoreontologies.org/ont00000290> a owl:Class ;
    rdfs:label "Decrease of Specifically Dependent Continuant"@en ;
    rdfs:subClassOf <https://www.commoncoreontologies.org/ont00000726> ;
    skos:definition "A Decrease of Dependent Continuant in which some Independent Continuant has a decrease in some Specifically Dependent Continuant that it bears."@en .

<https://www.commoncoreontologies.org/ont00000325> a owl:Class ;
    rdfs:label "Radio Transponder"@en ;
    rdfs:subClassOf <https://www.commoncoreontologies.org/ont00000903> ;
    skos:definition "A Radio Communication Instrument that is an electronic device that acts as both a Radio Transmitter and responder and is used to wirelessly receive and transmit electrical signals."@en .

<https://www.commoncoreontologies.org/ont00000344> a owl:Class ;
    rdfs:label "Surfactant Artifact Function"@en ;
    rdfs:subClassOf <https://www.commoncoreontologies.org/ont00001281> ;
    skos:definition "An Emulsifier Artifact Function that is realized in a process that lowers the surface tension between two liquids or between a liquid and a solid."@en .

<https://www.commoncoreontologies.org/ont00000345> a owl:Class ;
    rdfs:label "Act of Measuring"@en ;
    rdfs:subClassOf <https://www.commoncoreontologies.org/ont00000228> ;
    skos:definition "A Planned Act that involves determining the extent, dimensions, quanity, or quality of an Entity relative to some standard."@en .

<https://www.commoncoreontologies.org/ont00000350> a owl:Class ;
    rdfs:label "Cooling System"@en ;
    rdfs:subClassOf <https://www.commoncoreontologies.org/ont00000453> ;
    skos:definition "An Environment Control System that is designed to cool the air or objects in a Site."@en .

<https://www.commoncoreontologies.org/ont00000357> a owl:Class ;
    rdfs:label "Act of Motion"@en ;
    rdfs:subClassOf <https://www.commoncoreontologies.org/ont00000228> ;
    skos:definition "A Planned Act by which an Agent causes the position or location of some Object to change."@en .

<https://www.commoncoreontologies.org/ont00000395> a owl:Class ;
    rdfs:label "Gain of Specifically Dependent Continuant"@en ;
    rdfs:subClassOf <https://www.commoncoreontologies.org/ont00000554> ;
    skos:definition "A Gain of Dependent Continuant in which some Independent Continuant becomes the bearer of some Specifically Dependent Continuant."@en .

<https://www.commoncoreontologies.org/ont00000399> a owl:Class ;
    rdfs:label "Temporal Region Identifier"@en ;
    rdfs:subClassOf <https://www.commoncoreontologies.org/ont00000686> ;
    skos:definition "A Designative Information Content Entity that designates some Temporal Region."@en .

<https://www.commoncoreontologies.org/ont00000415> a owl:Class ;
    rdfs:label "Anti-Microbial Artifact Function"@en ;
    rdfs:subClassOf <https://www.commoncoreontologies.org/ont00000828> ;
    skos:definition "A Pesticide Artifact Function that is realized in a process which causes illness in, or the death of, a microorganism."@en .

<https://www.commoncoreontologies.org/ont00000422> a owl:Class ;
    rdfs:label "Communication Reception Artifact Function"@en ;
    rdfs:subClassOf <https://www.commoncoreontologies.org/ont00000323> ;
    skos:definition "An Artifact Function that is realized during events in which a Material Artifact is used to receive information that has been transmitted for the purpose of communiction."@en .

<https://www.commoncoreontologies.org/ont00000431> a owl:Class ;
    rdfs:label "External Combustion Engine"@en ;
    rdfs:subClassOf <https://www.commoncoreontologies.org/ont00000746> ;
    skos:definition "A Combustion Engine that is designed to have an external Combustion Chamber where portions of Fuel and Oxidizer mixture are burned to generate thermal energy to heat the working fluid, which transfers energy to the Engine where it is converted into mechanical energy."@en .

<https://www.commoncoreontologies.org/ont00000469> a owl:Class ;
    rdfs:label "Geospatial Coordinate Reference System"@en ;
    rdfs:subClassOf <https://www.commoncoreontologies.org/ont00000275> ;
    skos:definition "A Spatial Reference System that is used to determine and identify the location of a point or object at or near the surface of the Earth."@en .

<https://www.commoncoreontologies.org/ont00000479> a owl:Class ;
    rdfs:label "Public Safety Facility"@en ;
    rdfs:subClassOf <https://www.commoncoreontologies.org/ont00000192> ;
    skos:definition "A Facility that is designed for the prevention of and protection from events that could endanger, injure, or damage the general public."@en .

<https://www.commoncoreontologies.org/ont00000483> a owl:Class ;
    rdfs:label "Military Base"@en ;
    rdfs:subClassOf <https://www.commoncoreontologies.org/ont00001052> ;
    skos:definition "A Military Facility that is designed to shelter military equipment and personnel and to facilitate training and operations."@en .

<https://www.commoncoreontologies.org/ont00000490> a owl:Class ;
    rdfs:label "X-ray Frequency"@en ;
    rdfs:subClassOf <https://www.commoncoreontologies.org/ont00000754> ;
    skos:definition "An Electromagnetic Radiation Frequency of some Electromagnetic Wave that is between 30 petahertz and 30 exahertz."@en .

<https://www.commoncoreontologies.org/ont00000529> a owl:Class ;
    rdfs:label "Date Identifier"@en ;
    rdfs:subClassOf <https://www.commoncoreontologies.org/ont00000073> ;
    skos:definition "A Temporal Interval Identifier that designates some Day."@en .

<https://www.commoncoreontologies.org/ont00000533> a owl:Class ;
    rdfs:label "Jet Engine"@en ;
    rdfs:subClassOf <https://www.commoncoreontologies.org/ont00000056> ;
    skos:definition "A Reaction Engine that discharges a fast moving jet that generates Thrust by jet propulsion."@en .

<https://www.commoncoreontologies.org/ont00000551> a owl:Class ;
    rdfs:label "Organism"@en ;
    rdfs:subClassOf <http://purl.obolibrary.org/obo/BFO_0000030> ;
    skos:definition "An Object that is an Animal or Plant."@en .

<https://www.commoncoreontologies.org/ont00000554> a owl:Class ;
    rdfs:label "Gain of Dependent Continuant"@en ;
    rdfs:subClassOf <https://www.commoncoreontologies.org/ont00000004> ;
    skos:definition "A Change in which an Independent Continuant becomes the bearer or carrier of some Dependent Continuant."@en .

<https://www.commoncoreontologies.org/ont00000574> a owl:Class ;
    rdfs:label "Environmental Feature"@en ;
    rdfs:subClassOf <http://purl.obolibrary.org/obo/BFO_0000040> ;
    skos:definition "A Material Entity that is either a natural or man-made feature of the environment."@en .

<https://www.commoncoreontologies.org/ont00000581> a owl:Class ;
    rdfs:label "Tool"@en ;
    rdfs:subClassOf <https://www.commoncoreontologies.org/ont00000995> ;
    skos:definition "A Material Artifact that is designed to assist in the performance of manual or mechanical work and not to be consumed in that process."@en .

<https://www.commoncoreontologies.org/ont00000598> a owl:Class ;
    rdfs:label "Valve"@en ;
    rdfs:subClassOf <https://www.commoncoreontologies.org/ont00000256> ;
    skos:definition "A Fluid Control Artifact that is designed to regulate, direct, or control the flow of fluid by opening, closing, or partially obstructing the fluid from moving along a passageway."@en .

<https://www.commoncoreontologies.org/ont00000610> a owl:Class ;
    rdfs:label "Ultraviolet Light Frequency"@en ;
    rdfs:subClassOf <https://www.commoncoreontologies.org/ont00000754> ;
    skos:definition "An Electromagnetic Radiation Frequency of some Electromagnetic Wave that is between 750 terahertz and 30 petahertz."@en .

<https://www.commoncoreontologies.org/ont00000611> a owl:Class ;
    rdfs:label "Increase of Realizable Entity"@en ;
    rdfs:subClassOf <https://www.commoncoreontologies.org/ont00001214> ;
    skos:definition "An Increase of Specifically Dependent Continuant in which some Independent Continuant has an increase of some Realizable Entity that it bears."@en .

<https://www.commoncoreontologies.org/ont00000620> a owl:Class ;
    rdfs:label "Radiopacity"@en ;
    rdfs:subClassOf <https://www.commoncoreontologies.org/ont00001384> ;
    skos:definition "An Opacity that inheres in a bearer in virtue of its capacity to allow or prevent X-rays to pass through it."@en .

<https://www.commoncoreontologies.org/ont00000634> a owl:Class ;
    rdfs:label "Steam Engine"@en ;
    rdfs:subClassOf <https://www.commoncoreontologies.org/ont00000431> ;
    skos:definition "An External Combustion Engine that is designed to use steam as its working fluid."@en .

<https://www.commoncoreontologies.org/ont00000642> a owl:Class ;
    rdfs:label "Gain of Realizable Entity"@en ;
    rdfs:subClassOf <https://www.commoncoreontologies.org/ont00000395> ;
    skos:definition "A Gain of Specifically Dependent Continuant in which some Independent Continuant becomes the bearer of some Realizable Entity."@en .

<https://www.commoncoreontologies.org/ont00000674> a owl:Class ;
    rdfs:label "Calendar Year"@en ;
    rdfs:subClassOf <https://www.commoncoreontologies.org/ont00000832> ;
    skos:definition "A Year that begins and ends concurrently with the Days specified by a Calendar System to be the first and last Days of the Year."@en .

<https://www.commoncoreontologies.org/ont00000676> a owl:Class ;
    rdfs:label "Act of Inhabitancy"@en ;
    rdfs:subClassOf <https://www.commoncoreontologies.org/ont00000228> ;
    skos:definition "A Planned Act in which a Person lives at a Site for a period of time that may be as short as 1 day/night or as long as the Person's entire life."@en .

<https://www.commoncoreontologies.org/ont00000690> a owl:Class ;
    rdfs:label "Telecommunication Instrument"@en ;
    rdfs:subClassOf <https://www.commoncoreontologies.org/ont00000346> ;
    skos:definition "A Communication Instrument that is designed for use by some Agent in some Act of Communication where the recipient of that communication is potentially a significant distance away from the Agent."@en .

<https://www.commoncoreontologies.org/ont00000716> a owl:Class ;
    rdfs:label "Electric Battery"@en ;
    rdfs:subClassOf <https://www.commoncoreontologies.org/ont00001049> ;
    skos:definition "An Electrical Power Source that is designed to produce electric power by converting chemical energy to electrical energy."@en .

<https://www.commoncoreontologies.org/ont00000719> a owl:Class ;
    rdfs:label "Counterfeit Instrument"@en ;
    rdfs:subClassOf <https://www.commoncoreontologies.org/ont00000995> ;
    skos:definition "A Material Artifact that is designed to be a fake replica of some genuine Material Artifact."@en .

<https://www.commoncoreontologies.org/ont00000726> a owl:Class ;
    rdfs:label "Decrease of Dependent Continuant"@en ;
    rdfs:subClassOf <https://www.commoncoreontologies.org/ont00000004> ;
    skos:definition "A Change in which some Independent Continuant has a decrease in the level of some Dependent Continuant that it bears."@en .

<https://www.commoncoreontologies.org/ont00000727> a owl:Class ;
    rdfs:label "Communication Artifact Function"@en ;
    rdfs:subClassOf <https://www.commoncoreontologies.org/ont00000323> ;
    skos:definition "An Artifact Function that is realized in a process in which meaningful signs are conveyed from one entity to another."@en .

<https://www.commoncoreontologies.org/ont00000736> a owl:Class ;
    rdfs:label "Transducer"@en ;
    rdfs:subClassOf <https://www.commoncoreontologies.org/ont00000995> ;
    skos:definition "A Material Artifact that is designed to convert one form of energy to another."@en .

<https://www.commoncoreontologies.org/ont00000742> a owl:Class ;
    rdfs:label "Ignition System"@en ;
    rdfs:subClassOf <https://www.commoncoreontologies.org/ont00000995> ;
    skos:definition "A Material Artifact that is designed to produce an Ignition process."@en .

<https://www.commoncoreontologies.org/ont00000746> a owl:Class ;
    rdfs:label "Combustion Engine"@en ;
    rdfs:subClassOf <https://www.commoncoreontologies.org/ont00000638> ;
    skos:definition "A Heat Engine that is designed to convert thermal energy that is generated through a local Combustion process into mechanical energy."@en .

<https://www.commoncoreontologies.org/ont00000789> a owl:Class ;
    rdfs:label "Translational Motion"@en ;
    rdfs:subClassOf <https://www.commoncoreontologies.org/ont00001133> ;
    skos:definition "A Motion Process in which the participating Object changes its position from one portion of space to another."@en .

<https://www.commoncoreontologies.org/ont00000795> a owl:Class ;
    rdfs:label "Electrical Conduction Artifact Function"@en ;
    rdfs:subClassOf <https://www.commoncoreontologies.org/ont00000098> ;
    skos:definition "An Electrical Artifact Function that is realized by a Material Artifact being used to conduct an electric current."@en .

<https://www.commoncoreontologies.org/ont00000817> a owl:Class ;
    rdfs:label "Geospatial Line String"@en ;
    rdfs:subClassOf <https://www.commoncoreontologies.org/ont00000207> ;
    skos:definition "A One-Dimensional Geospatial Boundary that has two or more Geospatial Positions as vertices, where each vertex is connected to only one other vertex by a straight line."@en .

<https://www.commoncoreontologies.org/ont00000819> a owl:Class ;
    rdfs:label "Stasis"@en ;
    rdfs:subClassOf <http://purl.obolibrary.org/obo/BFO_0000015> ;
    skos:definition "A Process in which one or more Independent Continuants endure in an unchanging condition."@en .

<https://www.commoncoreontologies.org/ont00000827> a owl:Class ;
    rdfs:label "Time of Day Identifier"@en ;
    rdfs:subClassOf <https://www.commoncoreontologies.org/ont00000540> ;
    skos:definition "A Temporal Instant Identifier that designates some Time of Day."@en .

<https://www.commoncoreontologies.org/ont00000848> a owl:Class ;
    rdfs:label "Mounted Gun"@en ;
    rdfs:subClassOf <https://www.commoncoreontologies.org/ont00000088> ;
    skos:definition "A Firearm that is designed to be fired while mounted."@en .

<https://www.commoncoreontologies.org/ont00000854> a owl:Class ;
    rdfs:label "Decrease of Realizable Entity"@en ;
    rdfs:subClassOf <https://www.commoncoreontologies.org/ont00000290> ;
    skos:definition "A Decrease of Specifically Dependent Continuant in which some Independent Continuant has a decrease of some Realizable Entity that it bears."@en .

<https://www.commoncoreontologies.org/ont00000865> a owl:Class ;
    rdfs:label "Loss of Specifically Dependent Continuant"@en ;
    rdfs:subClassOf <https://www.commoncoreontologies.org/ont00000876> ;
    skos:definition "A Loss of Dependent Continuant in which some Independent Continuant ceases to be the bearer of some Specifically Dependent Continuant."@en .

<https://www.commoncoreontologies.org/ont00000870> a owl:Class ;
    rdfs:label "Infrastructure System"@en ;
    rdfs:subClassOf <http://purl.obolibrary.org/obo/BFO_0000040> ;
    skos:definition "A Material Entity that is composed of elements bearing Infrastructure Roles and is by itself sufficient to provide a planned service or benefit to some organization that maintains its elements."@en .

<https://www.commoncoreontologies.org/ont00000876> a owl:Class ;
    rdfs:label "Loss of Dependent Continuant"@en ;
    rdfs:subClassOf <https://www.commoncoreontologies.org/ont00000004> ;
    skos:definition "A Change in which some Independent Continuant ceases to be the bearer or carrier of some Dependent Continuant."@en .

<https://www.commoncoreontologies.org/ont00000890> a owl:Class ;
    rdfs:label "Act of Travel"@en ;
    rdfs:subClassOf <https://www.commoncoreontologies.org/ont00000065> ;
    skos:definition "An Act of Location Change wherein one or more Persons move between relatively distant geographical locations for any purpose and any duration, with or without any means of transport."@en .

<https://www.commoncoreontologies.org/ont00000891> a owl:Class ;
    rdfs:label "Calendar System"@en ;
    rdfs:subClassOf <https://www.commoncoreontologies.org/ont00001328> ;
    skos:definition "A Temporal Reference System that is designed to organize and identify dates."@en .

<https://www.commoncoreontologies.org/ont00000893> a owl:Class ;
    rdfs:label "Information Medium Artifact"@en ;
    rdfs:subClassOf <https://www.commoncoreontologies.org/ont00000995> ;
    skos:definition "A Material Artifact that is designed to have some Information Bearing Artifact as part."@en .

<https://www.commoncoreontologies.org/ont00000894> a owl:Class ;
    rdfs:label "Decimal Date Identifier"@en ;
    rdfs:subClassOf <https://www.commoncoreontologies.org/ont00000529> ;
    skos:definition "A Date Identifier that designates some Day by using a number to indicate the sequential ordering of the Day since a specified Reference Time."@en .

<https://www.commoncoreontologies.org/ont00000907> a owl:Class ;
    rdfs:label "Telephone"@en ;
    rdfs:subClassOf <https://www.commoncoreontologies.org/ont00000690> ;
    skos:definition "A Telecommunication Instrument that is designed to provide point-to-point communication between agents by means of audio messages."@en .

<https://www.commoncoreontologies.org/ont00000918> a owl:Class ;
    rdfs:label "Telecommunication Network Node"@en ;
    rdfs:subClassOf <https://www.commoncoreontologies.org/ont00000346> ;
    skos:definition "A Communication Artifact that consists of a connection point, redistribution point, or endpoint that is designed to be part of a Telecommunication Network and can be either active or passive."@en .

<https://www.commoncoreontologies.org/ont00000921> a owl:Class ;
    rdfs:label "Calendar Day"@en ;
    rdfs:subClassOf <https://www.commoncoreontologies.org/ont00000800> ;
    skos:definition "A Day that begins and ends concurrently with the Seconds specified by a Calendar System to be the first and last Seconds of the Day."@en .

<https://www.commoncoreontologies.org/ont00000928> a owl:Class ;
    rdfs:label "Train Car"@en ;
    rdfs:subClassOf <https://www.commoncoreontologies.org/ont00000796> ;
    skos:definition "A Rail Transport Vehicle that consists of a single Vehicle that is not a Train but is designed to be connected to other Train Cars along with at least one Locomotive to form a Train."@en .

<https://www.commoncoreontologies.org/ont00000946> a owl:Class ;
    rdfs:label "Government Building"@en ;
    rdfs:subClassOf <https://www.commoncoreontologies.org/ont00000192> ;
    skos:definition "A Facility that is designed for the administration of a community."@en .

<https://www.commoncoreontologies.org/ont00000961> a owl:Class ;
    rdfs:label "Current Conversion Artifact Function"@en ;
    rdfs:subClassOf <https://www.commoncoreontologies.org/ont00000098> ;
    skos:definition "An Electrical Artifact Function that is realized by processes in which some Material Artifact is used to convert some electrical current."@en .

<https://www.commoncoreontologies.org/ont00000973> a owl:Class ;
    rdfs:label "Decimal Time of Day Identifier"@en ;
    rdfs:subClassOf <https://www.commoncoreontologies.org/ont00000827> ;
    skos:definition "A Time of Day Identifier that designates an approximate Temporal Instant that is part of some Day and is specified using a decimal value for the portion of the Day that preceded the Temporal Instant."@en .

<https://www.commoncoreontologies.org/ont00001002> a owl:Class ;
    rdfs:label "Material Copy of a Message"@en ;
    rdfs:subClassOf <https://www.commoncoreontologies.org/ont00000798> ;
    skos:definition "An Information Bearing Artifact that is designed to carry some specific Information Content Entity that is relatively brief and to be transmitted from a sender to a recipient."@en .

<https://www.commoncoreontologies.org/ont00001028> a owl:Class ;
    rdfs:label "Mechanical Wave Process"@en ;
    rdfs:subClassOf <https://www.commoncoreontologies.org/ont00000099> ;
    skos:definition "A Wave Process that involves Oscillation of a portion of matter such that energy is transferred through the material medium."@en .

<https://www.commoncoreontologies.org/ont00001033> a owl:Class ;
    rdfs:label "Biological Sex"@en ;
    rdfs:subClassOf <http://purl.obolibrary.org/obo/BFO_0000019> ;
    skos:definition "A Quality inhering in a bearer by virtue of the bearer's ability to undergo sexual reproduction in order to differentiate the individuals or types involved."@en .

<https://www.commoncoreontologies.org/ont00001047> a owl:Class ;
    rdfs:label "Frequency"@en ;
    rdfs:subClassOf <http://purl.obolibrary.org/obo/BFO_0000144> ;
    skos:definition "A Process Profile that is characterized by the number of repetitive processes during a particular time period."@en .

<https://www.commoncoreontologies.org/ont00001048> a owl:Class ;
    rdfs:label "Increase of Dependent Continuant"@en ;
    rdfs:subClassOf <https://www.commoncoreontologies.org/ont00000004> ;
    skos:definition "A Change in which some Independent Continuant has an increase in the level of some Dependent Continuant that it bears."@en .

<https://www.commoncoreontologies.org/ont00001069> a owl:Class ;
    rdfs:label "Representational Information Content Entity"@en ;
    rdfs:subClassOf <https://www.commoncoreontologies.org/ont00000958> ;
    owl:disjointWith <https://www.commoncoreontologies.org/ont00001163> ;
    skos:definition "An Information Content Entity that represents some Entity."@en .

<https://www.commoncoreontologies.org/ont00001126> a owl:Class ;
    rdfs:label "Luminescent Property"@en ;
    rdfs:subClassOf <https://www.commoncoreontologies.org/ont00000784> ;
    skos:definition "An Optical Property that inheres in a bearer in virtue of that bearer's capacity to emit visible light, but which isn't the result of the bearer being heated."@en .

<https://www.commoncoreontologies.org/ont00001137> a owl:Class ;
    rdfs:label "Radiation Reflectivity"@en ;
    rdfs:subClassOf <https://www.commoncoreontologies.org/ont00000628> ;
    skos:definition "A Disposition to Interact with Electromagnetic Radiation that inheres in a bearer in virtue of the capacity of that bearer to scatter or reflect electromagnetic radiation of a given frequency."@en .

<https://www.commoncoreontologies.org/ont00001148> a owl:Class ;
    rdfs:label "Electromagnetic Communication Artifact Function"@en ;
    rdfs:subClassOf <https://www.commoncoreontologies.org/ont00000727> ;
    skos:definition "A Communication Artifact Function that is realized in a process that conveys meaningful signs by means of electromagnetic radiation."@en .

<https://www.commoncoreontologies.org/ont00001159> a owl:Class ;
    rdfs:label "Bond"@en ;
    rdfs:subClassOf <https://www.commoncoreontologies.org/ont00000537> ;
    skos:definition "A Financial Instrument that is designed to secure an Agent's debt for the holders of that debt."@en .

<https://www.commoncoreontologies.org/ont00001169> a owl:Class ;
    rdfs:label "Communication Relay Artifact Function"@en ;
    rdfs:subClassOf <https://www.commoncoreontologies.org/ont00000323> ;
    skos:definition "An Artifact Function that is realized during events in which a Material Artifact is used to first receive and then transmit information from one Material Artifact to another for the purpose of communiction."@en .

<https://www.commoncoreontologies.org/ont00001176> a owl:Class ;
    rdfs:label "Estimate Information Content Entity"@en ;
    rdfs:subClassOf <https://www.commoncoreontologies.org/ont00001163> ;
    skos:definition "A Measurement Information Content Entity that is a measurement of an entity based on partial information about that entity or an appropriately similar entity."@en .

<https://www.commoncoreontologies.org/ont00001191> a owl:Class ;
    rdfs:label "Operational Stasis"@en ;
    rdfs:subClassOf <https://www.commoncoreontologies.org/ont00001213> ;
    skos:definition "A Stasis of Artifact Operationality that holds during a Temporal Interval when a Material Artifact maintains its designed set of Artifact Functions (or at least maintains its primary functions)."@en .

<https://www.commoncoreontologies.org/ont00001207> a owl:Class ;
    rdfs:label "Optical Lens"@en ;
    rdfs:subClassOf <https://www.commoncoreontologies.org/ont00000136> ;
    skos:definition "An Optical Instrument that is designed to focus or disperse a beam of light entering the lens by means of refraction."@en .

<https://www.commoncoreontologies.org/ont00001214> a owl:Class ;
    rdfs:label "Increase of Specifically Dependent Continuant"@en ;
    rdfs:subClassOf <https://www.commoncoreontologies.org/ont00001048> ;
    skos:definition "An Increase of Dependent Continuant in which some Independent Continuant has an increase of some Specifically Dependent Continuant that it bears."@en .

<https://www.commoncoreontologies.org/ont00001221> a owl:Class ;
    rdfs:label "Physically Powered Engine"@en ;
    rdfs:subClassOf <https://www.commoncoreontologies.org/ont00000210> ;
    skos:definition "An Engine that is designed to convert potential or kinetic energy into mechanical energy."@en .

<https://www.commoncoreontologies.org/ont00001248> a owl:Class ;
    rdfs:label "Artificial Eye"@en ;
    rdfs:subClassOf <https://www.commoncoreontologies.org/ont00000715> ;
    skos:definition "A Prosthesis that is designed to replace a missing eye."@en .

<https://www.commoncoreontologies.org/ont00001251> a owl:Class ;
    rdfs:label "Act of Intelligence Gathering"@en ;
    rdfs:subClassOf <https://www.commoncoreontologies.org/ont00000228> ;
    skos:definition "A Planned Act of producing and/or gathering information by a government or other Organization to guide decisions and actions by answering questions or obtaining advance warning of events and movements deemed to be important or otherwise relevant."@en .

<https://www.commoncoreontologies.org/ont00001283> a owl:Class ;
    rdfs:label "Refinery"@en ;
    rdfs:subClassOf <https://www.commoncoreontologies.org/ont00000782> ;
    skos:definition "A Factory that is designed for refining raw materials into products of value."@en .

<https://www.commoncoreontologies.org/ont00001315> a owl:Class ;
    rdfs:label "Waste Management Facility"@en ;
    rdfs:subClassOf <https://www.commoncoreontologies.org/ont00000192> ;
    skos:definition "A Facility that is designed for managing waste for some portion of the waste's existence."@en .

<https://www.commoncoreontologies.org/ont00001374> a owl:Class ;
    rdfs:label "Act of Declarative Communication"@en ;
    rdfs:subClassOf <https://www.commoncoreontologies.org/ont00000402> ;
    skos:definition "An Act of Communication that changes the reality in accord with the proposition of the declaration."@en .

<https://www.commoncoreontologies.org/ont00001381> a owl:Class ;
    rdfs:label "Medical Artifact"@en ;
    rdfs:subClassOf <https://www.commoncoreontologies.org/ont00000995> ;
    skos:definition "A Material Artifact that is designed for diagnosing, treating, or preventing disease, disability, or death."@en .

<https://www.commoncoreontologies.org/ont00002066> a owl:Class ;
    rdfs:label "Explosive Mine"@en ;
    rdfs:subClassOf <https://www.commoncoreontologies.org/ont00000552> ;
    skos:definition "An Explosive Weapon that is designed to be concealed and to detonate as its target passes near it."@en .

<http://purl.obolibrary.org/obo/BFO_0000018> a owl:Class ;
    rdfs:label "zero-dimensional spatial region"@en ;
    rdfs:subClassOf <http://purl.obolibrary.org/obo/BFO_0000006> ;
    owl:disjointWith <http://purl.obolibrary.org/obo/BFO_0000026>,
        <http://purl.obolibrary.org/obo/BFO_0000028> ;
    skos:definition "(Elucidation) A zero-dimensional spatial region is one or a collection of more than one spatially disjoint points in space"@en .

<http://purl.obolibrary.org/obo/BFO_0000182> a owl:Class ;
    rdfs:label "history"@en ;
    rdfs:subClassOf <http://purl.obolibrary.org/obo/BFO_0000015> ;
    skos:definition "(Elucidation) A history is a process that is the sum of the totality of processes taking place in the spatiotemporal region occupied by the material part of a material entity"@en .

<https://www.commoncoreontologies.org/ont00000020> a owl:Class ;
    rdfs:label "Container"@en ;
    rdfs:subClassOf <https://www.commoncoreontologies.org/ont00000995> ;
    skos:definition "A Material Artifact that is designed to contain (wholly or partially) some material entity."@en .

<https://www.commoncoreontologies.org/ont00000052> a owl:Class ;
    rdfs:label "Religious Facility"@en ;
    rdfs:subClassOf <https://www.commoncoreontologies.org/ont00000192> ;
    skos:definition "A Facility that is designed for worship and prayer."@en .

<https://www.commoncoreontologies.org/ont00000088> a owl:Class ;
    rdfs:label "Firearm"@en ;
    rdfs:subClassOf <https://www.commoncoreontologies.org/ont00001051> ;
    skos:definition "A Projectile Launcher that is designed to launch Bullets or Cartridges."@en .

<https://www.commoncoreontologies.org/ont00000161> a owl:Class ;
    rdfs:label "Coordinate System Axis"@en ;
    rdfs:subClassOf <http://purl.obolibrary.org/obo/BFO_0000026> ;
    skos:definition "A One-Dimensional Spatial Region defined by a Coordinate System for the purpose of identifying the position of entities along one dimension of the Coordinate System's spatial framework."@en .

<https://www.commoncoreontologies.org/ont00000199> a owl:Class ;
    rdfs:label "Camera"@en ;
    rdfs:subClassOf <https://www.commoncoreontologies.org/ont00000771> ;
    skos:definition "An Imaging Instrument that is designed to form and digitally or physically record an image of an entity."@en .

<https://www.commoncoreontologies.org/ont00000252> a owl:Class ;
    rdfs:label "Nozzle"@en ;
    rdfs:subClassOf <https://www.commoncoreontologies.org/ont00000256> ;
    skos:definition "A Fluid Control Artifact that is designed to control the speed, direction, rate, shape, or pressure of the flow of fluid exiting it."@en .

<https://www.commoncoreontologies.org/ont00000254> a owl:Class ;
    rdfs:label "Transportation Artifact"@en ;
    rdfs:subClassOf <https://www.commoncoreontologies.org/ont00000995> ;
    skos:definition "A Material Artifact that is fixed in place and designed to enable the movement of Vehicles and Agents from one location to another."@en .

<https://www.commoncoreontologies.org/ont00000275> a owl:Class ;
    rdfs:label "Spatial Reference System"@en ;
    rdfs:subClassOf <https://www.commoncoreontologies.org/ont00000398> ;
    skos:definition "A Reference System that describes a set of standards for uniquely identifying the position of an entity or the direction of a vector within a defined spatial region by means of measurements along one or more Coordinate System Axes."@en .

<https://www.commoncoreontologies.org/ont00000293> a owl:Class ;
    rdfs:label "Nominal Measurement Information Content Entity"@en ;
    rdfs:subClassOf <https://www.commoncoreontologies.org/ont00001163> ;
    owl:disjointWith <https://www.commoncoreontologies.org/ont00001010>,
        <https://www.commoncoreontologies.org/ont00001022>,
        <https://www.commoncoreontologies.org/ont00001364> ;
    skos:definition "A Measurement Information Content Entity that consists of a symbol that classifies Entities according to some shared, possibly arbitrary, characteristic."@en .

<https://www.commoncoreontologies.org/ont00000304> a owl:Class ;
    rdfs:label "Microscope"@en ;
    rdfs:subClassOf <https://www.commoncoreontologies.org/ont00000771> ;
    skos:definition "An Imaging Instrument that is designed to enable users to see Objects that are otherwise too small to be seen by the naked eye by producing a significantly enlarged image of the Object."@en .

<https://www.commoncoreontologies.org/ont00000387> a owl:Class ;
    rdfs:label "Axis of Rotation"@en ;
    rdfs:subClassOf <http://purl.obolibrary.org/obo/BFO_0000026> ;
    skos:definition "A One-Dimensional Spatial Region defined by the line around which a spinning body rotates."@en .

<https://www.commoncoreontologies.org/ont00000392> a owl:Class ;
    rdfs:label "Allegiance Role"@en ;
    rdfs:subClassOf <http://purl.obolibrary.org/obo/BFO_0000023> ;
    skos:definition "A Role that inheres in an Agent by virtue of the support it has committed to provide to another Agent when that Agent is involved in a conflict."@en .

<https://www.commoncoreontologies.org/ont00000394> a owl:Class ;
    rdfs:label "Internal Combustion Engine"@en ;
    rdfs:subClassOf <https://www.commoncoreontologies.org/ont00000746> ;
    skos:definition "A Combustion Engine that is designed to have an internal Combustion Chamber where portions of Fuel and Oxidizer mixture are burned to generate thermal energy that is then converted into mechanical energy."@en .

<https://www.commoncoreontologies.org/ont00000427> a owl:Class ;
    rdfs:label "Armored Fighting Vehicle"@en ;
    rdfs:subClassOf <https://www.commoncoreontologies.org/ont00000053> ;
    skos:definition "A Ground Motor Vehicle that is designed to be armored and used to transport and support military personal in combat missions."@en .

<https://www.commoncoreontologies.org/ont00000448> a owl:Class ;
    rdfs:label "Motion Artifact Function"@en ;
    rdfs:subClassOf <https://www.commoncoreontologies.org/ont00000323> ;
    skos:definition "An Artifact Function that is realized in a process in which an entity changes its position with respect to time."@en .

<https://www.commoncoreontologies.org/ont00000453> a owl:Class ;
    rdfs:label "Environment Control System"@en ;
    rdfs:subClassOf <https://www.commoncoreontologies.org/ont00000995> ;
    skos:definition "A Material Artifact that is designed to control the temperature, air quality, or other feature of a Site that is relevant to the comfort or operation of entities located within that Site."@en .

<https://www.commoncoreontologies.org/ont00000455> a owl:Class ;
    rdfs:label "Act of Ceremony"@en ;
    rdfs:subClassOf <https://www.commoncoreontologies.org/ont00001327> ;
    skos:definition "A Social Act of ritual significance, performed on a special occasion."@en .

<https://www.commoncoreontologies.org/ont00000460> a owl:Class ;
    rdfs:label "Local Administrative Region"@en ;
    rdfs:subClassOf <https://www.commoncoreontologies.org/ont00001152> ;
    skos:definition "A Government Domain that delimits a local Government."@en .

<https://www.commoncoreontologies.org/ont00000475> a owl:Class ;
    rdfs:label "Portion of Cash"@en ;
    rdfs:subClassOf <https://www.commoncoreontologies.org/ont00000537> ;
    skos:definition "A Financial Instrument that is designed to be a ready medium of exchange."@en .

<https://www.commoncoreontologies.org/ont00000537> a owl:Class ;
    rdfs:label "Financial Instrument"@en ;
    rdfs:subClassOf <https://www.commoncoreontologies.org/ont00000995> ;
    skos:definition "A Material Artifact that is designed to be a tradeable asset and that is legally sanctioned."@en .

<https://www.commoncoreontologies.org/ont00000552> a owl:Class ;
    rdfs:label "Explosive Weapon"@en ;
    rdfs:subClassOf <https://www.commoncoreontologies.org/ont00000445> ;
    skos:definition "A Weapon that is designed to inflict harm, damage, or incapacity by means of a violent release of energy caused by the exothermic reaction of an explosive material."@en .

<https://www.commoncoreontologies.org/ont00000570> a owl:Class ;
    rdfs:label "Force"@en ;
    rdfs:subClassOf <http://purl.obolibrary.org/obo/BFO_0000144> ;
    skos:definition "A Process Profile that is the rate of change of an object's Momentum, is the product of an object's Mass and Acceleration with respect to an inertial frame of reference, and is measured in units of Newtons (N)."@en .

<https://www.commoncoreontologies.org/ont00000575> a owl:Class ;
    rdfs:label "Quality Specification"@en ;
    rdfs:subClassOf <https://www.commoncoreontologies.org/ont00000965> ;
    skos:definition "A Prescriptive Information Content Entity that prescribes some Quality."@en .

<https://www.commoncoreontologies.org/ont00000601> a owl:Class ;
    rdfs:label "Imaging Artifact Function"@en ;
    rdfs:subClassOf <https://www.commoncoreontologies.org/ont00000323> ;
    skos:definition "An Artifact Function that inheres in Material Artifacts that are designed to create one or more new Images."@en .

<https://www.commoncoreontologies.org/ont00000605> a owl:Class ;
    rdfs:label "Abbreviated Name"@en ;
    rdfs:subClassOf <https://www.commoncoreontologies.org/ont00000003> ;
    skos:definition "A Designative Name that is a shortened form of a Proper Name."@en .

<https://www.commoncoreontologies.org/ont00000618> a owl:Class ;
    rdfs:label "Ground Vehicle"@en ;
    rdfs:subClassOf <https://www.commoncoreontologies.org/ont00000713> ;
    skos:definition "A Vehicle that is designed to convey passengers, cargo, or equipment from one location to another by some form of ground travel."@en .

<https://www.commoncoreontologies.org/ont00000639> a owl:Class ;
    rdfs:label "Mine"@en ;
    rdfs:subClassOf <https://www.commoncoreontologies.org/ont00000192> ;
    skos:definition "A Facility that is designed to support the extraction of minerals or other geological materials from an orebody, lode, vein, seam, reef, or placer deposit within the earth."@en .

<https://www.commoncoreontologies.org/ont00000649> a owl:Class ;
    rdfs:label "Non-Name Identifier"@en ;
    rdfs:subClassOf <https://www.commoncoreontologies.org/ont00000686> ;
    skos:definition "A Designative Information Content Entity that consists of a string of characters that designates an entity within a specified namespace or context, is not a Designative Name, may be automatically or randomly generated, and typically has no preexisting cultural or social significance."@en .

<https://www.commoncoreontologies.org/ont00000677> a owl:Class ;
    rdfs:label "Product Transport Facility"@en ;
    rdfs:subClassOf <https://www.commoncoreontologies.org/ont00000192> ;
    skos:definition "A Facility that is designed to transport some product."@en .

<https://www.commoncoreontologies.org/ont00000723> a owl:Class ;
    rdfs:label "Vehicle Control System"@en ;
    rdfs:subClassOf <https://www.commoncoreontologies.org/ont00000781> ;
    skos:definition "A Control System that is designed to enable some Agent to control some Vehicle."@en .

<https://www.commoncoreontologies.org/ont00000732> a owl:Class ;
    rdfs:label "Microwave Frequency"@en ;
    rdfs:subClassOf <https://www.commoncoreontologies.org/ont00000150> ;
    skos:definition "A Radio Frequency that is between 300 MHz and 300 GHz."@en .

<https://www.commoncoreontologies.org/ont00000745> a owl:Class ;
    rdfs:label "Point Estimate Information Content Entity"@en ;
    rdfs:subClassOf <https://www.commoncoreontologies.org/ont00001176> ;
    skos:definition "An Estimate Information Content Entity that consists of a single value for the measured entity."@en .

<https://www.commoncoreontologies.org/ont00000771> a owl:Class ;
    rdfs:label "Imaging Instrument"@en ;
    rdfs:subClassOf <https://www.commoncoreontologies.org/ont00000995> ;
    skos:definition "A Material Artifact that is designed to bear an Imaging Artifact Function."@en .

<https://www.commoncoreontologies.org/ont00000781> a owl:Class ;
    rdfs:label "Control System"@en ;
    rdfs:subClassOf <https://www.commoncoreontologies.org/ont00000995> ;
    skos:definition "A Material Artifact that is designed to manage, command, direct, or regulate the behavior of at least one other Material Artifact."@en .

<https://www.commoncoreontologies.org/ont00000828> a owl:Class ;
    rdfs:label "Pesticide Artifact Function"@en ;
    rdfs:subClassOf <https://www.commoncoreontologies.org/ont00001123> ;
    skos:definition "A Poison Artifact Function that is realized in a process which causes illness in, or the death of, a living thing that is detrimental to humans or human concerns."@en .

<https://www.commoncoreontologies.org/ont00000838> a owl:Class ;
    rdfs:label "Portion of Fuel"@en ;
    rdfs:subClassOf <https://www.commoncoreontologies.org/ont00000457> ;
    skos:definition "A Portion of Material that is designed to release thermal energy when reacted with other substances."@en .

<https://www.commoncoreontologies.org/ont00000862> a owl:Class ;
    rdfs:label "Sound Process Profile"@en ;
    rdfs:subClassOf <http://purl.obolibrary.org/obo/BFO_0000144> ;
    skos:definition "A Process Profile that is part of a sound reception process and is characterized by properties of incoming sound waves as they are translated by some sensory system."@en .

<https://www.commoncoreontologies.org/ont00000998> a owl:Class ;
    rdfs:label "Telecommunication Network"@en ;
    rdfs:subClassOf <https://www.commoncoreontologies.org/ont00001036> ;
    skos:definition "A Communication System that is designed to enable the transmission of information over significant distances between Telecommunication Endpoints via Telecommunication Network Nodes and Lines."@en .

<https://www.commoncoreontologies.org/ont00001009> a owl:Class ;
    rdfs:label "Optical Telescope"@en ;
    rdfs:subClassOf <https://www.commoncoreontologies.org/ont00000547> ;
    skos:definition "A Telescope that is designed to aid in the observation of spatially distant Objects by means of collecting and focusing visible light to form an enhanced image of the Object."@en .

<https://www.commoncoreontologies.org/ont00001036> a owl:Class ;
    rdfs:label "Communication System"@en ;
    rdfs:subClassOf <https://www.commoncoreontologies.org/ont00000995> ;
    skos:definition "A Material Artifact that is designed to enable some Act of Communication by means of transmission systems, relay stations, tributary stations, and data terminal equipment, usually capable of interconnection and interoperation to form an integrated whole."@en .

<https://www.commoncoreontologies.org/ont00001081> a owl:Class ;
    rdfs:label "Geographic Feature"@en ;
    rdfs:subClassOf <https://www.commoncoreontologies.org/ont00000574> ;
    skos:definition "An Environmental Feature that is a natural (i.e. not human made) topographical feature having a (relatively) stable location in some Geospatial Region which can be designated by location-specific data."@en .

<https://www.commoncoreontologies.org/ont00001084> a owl:Class ;
    rdfs:label "Portion of Processed Material"@en ;
    rdfs:subClassOf <https://www.commoncoreontologies.org/ont00000995> ;
    skos:definition "A Material Artifact that is the output of an Act of Material Artifact Processing."@en .

<https://www.commoncoreontologies.org/ont00001102> a owl:Class ;
    rdfs:label "Commercial Facility"@en ;
    rdfs:subClassOf <https://www.commoncoreontologies.org/ont00000192> ;
    skos:definition "A Facility that is designed for buying and selling goods and services, especially on a large scale."@en .

<https://www.commoncoreontologies.org/ont00001132> a owl:Class ;
    rdfs:label "Stasis of Mission Capability"@en ;
    rdfs:subClassOf <https://www.commoncoreontologies.org/ont00000246> ;
    skos:definition "A Stasis of Realizable Entity that holds during a temporal interval when a Continuant's capability (or lack thereof) to perform its intended Functions, tasks, or Objectives remains at a relatively constant level."@en .

<https://www.commoncoreontologies.org/ont00001133> a owl:Class ;
    rdfs:label "Motion"@en ;
    rdfs:subClassOf <https://www.commoncoreontologies.org/ont00000007> ;
    skos:definition "A Natural Process in which a Continuant changes its Location or Spatial Orientation over some Temporal Interval."@en .

<https://www.commoncoreontologies.org/ont00001145> a owl:Class ;
    rdfs:label "Radio Receiver"@en ;
    rdfs:subClassOf <https://www.commoncoreontologies.org/ont00000903> ;
    skos:definition "A Radio Communication Instrument that is an electronic device that is designed to extract information from radio waves intercepted by a Radio Antenna by using electronic filters to separate the desired radio frequency signal from other signals, an electronic amplifier to increase the power of the signal, and demodulation to recover the desired information."@en .

<https://www.commoncoreontologies.org/ont00001147> a owl:Class ;
    rdfs:label "Act of Violence"@en ;
    rdfs:subClassOf <https://www.commoncoreontologies.org/ont00000228> ;
    skos:definition "A Planned Act of causing harm to oneself or to another through the use of physical or verbal force."@en .

<https://www.commoncoreontologies.org/ont00001173> a owl:Class ;
    rdfs:label "Rocket Launcher"@en ;
    rdfs:subClassOf <https://www.commoncoreontologies.org/ont00001051> ;
    skos:definition "A Projectile Launcher that is designed to launch one or more Unguided Rockets."@en .

<https://www.commoncoreontologies.org/ont00001190> a owl:Class ;
    rdfs:label "Telephone Call"@en ;
    rdfs:subClassOf <https://www.commoncoreontologies.org/ont00000517> ;
    skos:definition "An Act of Communciation by Media transmitted over a telephone network to two or more Persons."@en .

<https://www.commoncoreontologies.org/ont00001197> a owl:Class ;
    rdfs:label "Anthropogenic Feature"@en ;
    rdfs:subClassOf <https://www.commoncoreontologies.org/ont00000574> ;
    skos:definition "An Environmental Feature that is related to or is the result of the influence of human beings on the environment."@en .

<https://www.commoncoreontologies.org/ont00001202> a owl:Class ;
    rdfs:label "Size Quality"@en ;
    rdfs:subClassOf <http://purl.obolibrary.org/obo/BFO_0000019> ;
    skos:definition "A Quality that inheres in a bearer in virtue of the bearer's extension in one or more dimensions."@en .

<https://www.commoncoreontologies.org/ont00001306> a owl:Class ;
    rdfs:label "Observation Artifact Function"@en ;
    rdfs:subClassOf <https://www.commoncoreontologies.org/ont00000323> ;
    skos:definition "An Artifact Function that is realized during events in which a Material Artifact is used to collect information about a specified object or class of objects."@en .

<https://www.commoncoreontologies.org/ont00001334> a owl:Class ;
    rdfs:label "Act of Purchasing"@en ;
    rdfs:subClassOf <https://www.commoncoreontologies.org/ont00000836> ;
    skos:definition "An Act of Financial Instrument Use wherein a Financial Instrument is used by an Agent (the Purchaser) to acquire a good or service from another Agent (the Provider)."@en .

<https://www.commoncoreontologies.org/ont00001337> a owl:Class ;
    rdfs:label "Infrared Light Frequency"@en ;
    rdfs:subClassOf <https://www.commoncoreontologies.org/ont00000754> ;
    skos:definition "An Electromagnetic Radiation Frequency of some Electromagnetic Wave that is between 300 gigahertz and 430 tetrahertz."@en .

<https://www.commoncoreontologies.org/ont00001353> a owl:Class ;
    rdfs:label "Speed Artifact Function"@en ;
    rdfs:subClassOf <https://www.commoncoreontologies.org/ont00000448> ;
    skos:definition "A Motion Artifact Function that is realized in some process in which its bearer has some speed."@en .

<https://www.commoncoreontologies.org/ont00002010> a owl:Class ;
    rdfs:label "Message"@en ;
    rdfs:subClassOf <https://www.commoncoreontologies.org/ont00002001> ;
    skos:definition "A Media Content Entity that is relatively brief and designed to be transmitted from a sender to a recipient."@en .

<http://purl.obolibrary.org/obo/BFO_0000011> a owl:Class ;
    rdfs:label "spatiotemporal region"@en ;
    rdfs:subClassOf <http://purl.obolibrary.org/obo/BFO_0000003> ;
    owl:disjointWith <http://purl.obolibrary.org/obo/BFO_0000015>,
        <http://purl.obolibrary.org/obo/BFO_0000035> ;
    skos:definition "(Elucidation) A spatiotemporal region is an occurrent that is an occurrent part of spacetime"@en .

<http://purl.obolibrary.org/obo/BFO_0000147> a owl:Class ;
    rdfs:label "fiat point"@en ;
    rdfs:subClassOf <http://purl.obolibrary.org/obo/BFO_0000140> ;
    skos:definition "(Elucidation) A fiat point is a zero-dimensional continuant fiat boundary that consists of a single point"@en .

<https://www.commoncoreontologies.org/ont00000003> a owl:Class ;
    rdfs:label "Designative Name"@en ;
    rdfs:subClassOf <https://www.commoncoreontologies.org/ont00000686> ;
    owl:disjointWith <https://www.commoncoreontologies.org/ont00000649> ;
    skos:definition "A Designative Information Content Entity that consists of a string of characters that designates an entity within a specified cultural or social namespace and which is typically a word or phrase in a natural language that has an accepted cultural or social significance."@en .

<https://www.commoncoreontologies.org/ont00000005> a owl:Class ;
    rdfs:label "Act"@en ;
    rdfs:subClassOf <http://purl.obolibrary.org/obo/BFO_0000015> ;
    skos:definition "A Process in which at least one Agent plays a causative role."@en .

<https://www.commoncoreontologies.org/ont00000008> a owl:Class ;
    rdfs:label "Sound Frequency"@en ;
    rdfs:subClassOf <https://www.commoncoreontologies.org/ont00001047> ;
    skos:definition "A Frequency that is the rate of Oscillations per second of a Sound Wave."@en .

<https://www.commoncoreontologies.org/ont00000099> a owl:Class ;
    rdfs:label "Wave Process"@en ;
    rdfs:subClassOf <https://www.commoncoreontologies.org/ont00000007> ;
    skos:definition "A Natural Process that involves Oscillation accompanied by a transfer of energy that travels through a portion of matter or spatial region."@en .

<https://www.commoncoreontologies.org/ont00000119> a owl:Class ;
    rdfs:label "Spatial Orientation"@en ;
    rdfs:subClassOf <http://purl.obolibrary.org/obo/BFO_0000145> ;
    skos:definition "A Relational Quality that is the angle of Rotation of an Object relative to one or more Plane of Reference or Axis of Rotation."@en .

<https://www.commoncoreontologies.org/ont00000123> a owl:Class ;
    rdfs:label "Act of Expressive Communication"@en ;
    rdfs:subClassOf <https://www.commoncoreontologies.org/ont00000402> ;
    skos:definition "An Act of Communication in which an Agent expresses their attitudes or emotions towards some entity."@en .

<https://www.commoncoreontologies.org/ont00000133> a owl:Class ;
    rdfs:label "Act of Directive Communication"@en ;
    rdfs:subClassOf <https://www.commoncoreontologies.org/ont00000402> ;
    skos:definition "An Act of Communication that is intended to cause the hearer to take a particular action."@en .

<https://www.commoncoreontologies.org/ont00000207> a owl:Class ;
    rdfs:label "One-Dimensional Geospatial Boundary"@en ;
    rdfs:subClassOf <http://purl.obolibrary.org/obo/BFO_0000142> ;
    skos:definition "A Fiat Line that is a boundary of some Geospatial Region."@en .

<https://www.commoncoreontologies.org/ont00000210> a owl:Class ;
    rdfs:label "Engine"@en ;
    rdfs:subClassOf <https://www.commoncoreontologies.org/ont00000995> ;
    skos:definition "A Material Artifact that is designed to convert one form of energy into mechanical energy."@en .

<https://www.commoncoreontologies.org/ont00000226> a owl:Class ;
    rdfs:label "Transportation Facility"@en ;
    rdfs:subClassOf <https://www.commoncoreontologies.org/ont00000192> ;
    skos:definition "A Facility that is designed for commencing or concluding the transportation of transportation artifacts, or for housing transportation artifacts."@en .

<https://www.commoncoreontologies.org/ont00000255> a owl:Class ;
    rdfs:label "Portion of Cryogenic Material"@en ;
    rdfs:subClassOf <https://www.commoncoreontologies.org/ont00000457> ;
    skos:definition "A Portion of Material that has been reduced to a very low temperature (below -180 degrees Celcius)."@en .

<https://www.commoncoreontologies.org/ont00000288> a owl:Class ;
    rdfs:label "Power Source"@en ;
    rdfs:subClassOf <https://www.commoncoreontologies.org/ont00000995> ;
    skos:definition "A Material Artifact that is designed to supply power to some other Material Artifact."@en .

<https://www.commoncoreontologies.org/ont00000346> a owl:Class ;
    rdfs:label "Communication Instrument"@en ;
    rdfs:subClassOf <https://www.commoncoreontologies.org/ont00000995> ;
    skos:definition "A Material Artifact that is designed to facilitate communication between at least two entities."@en .

<https://www.commoncoreontologies.org/ont00000368> a owl:Class ;
    rdfs:label "Rotational Motion"@en ;
    rdfs:subClassOf <https://www.commoncoreontologies.org/ont00001133> ;
    skos:definition "A Motion Process in which an Object moves in a Circular or Elliptical Path around an Axis of Rotation."@en .

<https://www.commoncoreontologies.org/ont00000410> a owl:Class ;
    rdfs:label "Residential Facility"@en ;
    rdfs:subClassOf <https://www.commoncoreontologies.org/ont00000192> ;
    skos:definition "A Facility that is designed to house one or more Persons."@en .

<https://www.commoncoreontologies.org/ont00000499> a owl:Class ;
    rdfs:label "Wire Antenna"@en ;
    rdfs:subClassOf <https://www.commoncoreontologies.org/ont00001192> ;
    skos:definition "A Radio Antenna that consists primarily of a length of wire."@en .

<https://www.commoncoreontologies.org/ont00000593> a owl:Class ;
    rdfs:label "Portion of Propellant"@en ;
    rdfs:subClassOf <https://www.commoncoreontologies.org/ont00000457> ;
    skos:definition "A Portion of Material that is designed to be used as an input in a Propulsion Process to produce Thrust."@en .

<https://www.commoncoreontologies.org/ont00000796> a owl:Class ;
    rdfs:label "Rail Transport Vehicle"@en ;
    rdfs:subClassOf <https://www.commoncoreontologies.org/ont00000618> ;
    skos:definition "A Ground Vehicle that is designed to convey cargo, passengers, or equipment by Railway."@en .

<https://www.commoncoreontologies.org/ont00000804> a owl:Class ;
    rdfs:label "Prism"@en ;
    rdfs:subClassOf <https://www.commoncoreontologies.org/ont00000136> ;
    skos:definition "An Optical Instrument that is designed to refract light and which consists of a transparent material with flat polished surfaces where at least two of these surfaces have an angle between them."@en .

<https://www.commoncoreontologies.org/ont00000829> a owl:Class ;
    rdfs:label "Time Zone Identifier"@en ;
    rdfs:subClassOf <https://www.commoncoreontologies.org/ont00000390> ;
    skos:definition "A Spatial Region Identifier that designates the region associated with some uniform standard time for legal, commercial, or social purposes."@en .

<https://www.commoncoreontologies.org/ont00000908> a owl:Class ;
    rdfs:label "Act of Material Artifact Processing"@en ;
    rdfs:subClassOf <https://www.commoncoreontologies.org/ont00000228> ;
    skos:definition "A Planned Act of performing a series of physical operations on a material artifact in order to change or preserve the artifact."@en .

<https://www.commoncoreontologies.org/ont00000914> a owl:Class ;
    rdfs:label "Group of Persons"@en ;
    rdfs:subClassOf <https://www.commoncoreontologies.org/ont00000300> ;
    skos:definition "A Group of Agents that has only Persons as member parts."@en .

<https://www.commoncoreontologies.org/ont00001076> a owl:Class ;
    rdfs:label "Electric Power Station"@en ;
    rdfs:subClassOf <https://www.commoncoreontologies.org/ont00000192> ;
    skos:definition "A Facility that is designed to generate electrical power."@en .

<https://www.commoncoreontologies.org/ont00001100> a owl:Class ;
    rdfs:label "Measurement Artifact Function"@en ;
    rdfs:subClassOf <https://www.commoncoreontologies.org/ont00000323> ;
    skos:definition "An Artifact Function that is realized during events in which a Material Artifact is used to measure one or more features of a specified object or class of objects."@en .

<https://www.commoncoreontologies.org/ont00001104> a owl:Class ;
    rdfs:label "Long Gun"@en ;
    rdfs:subClassOf <https://www.commoncoreontologies.org/ont00000088> ;
    skos:definition "A Firearm that is designed to have a longer barrel than a Hand Gun and to be fired while braced against the shoulder."@en .

<https://www.commoncoreontologies.org/ont00001105> a owl:Class ;
    rdfs:label "Secondary Cell Electric Battery"@en ;
    rdfs:subClassOf <https://www.commoncoreontologies.org/ont00000716> ;
    skos:definition "An Electric Battery that is designed to be recharged."@en .

<https://www.commoncoreontologies.org/ont00001162> a owl:Class ;
    rdfs:label "Act of Commissive Communication"@en ;
    rdfs:subClassOf <https://www.commoncoreontologies.org/ont00000402> ;
    skos:definition "An Act of Communication in which an Agent commits themselves to doing, or refraining from doing, some future action."@en .

<https://www.commoncoreontologies.org/ont00001175> a owl:Class ;
    rdfs:label "Language"@en ;
    rdfs:subClassOf <https://www.commoncoreontologies.org/ont00000965> ;
    skos:definition "A Prescriptive Information Content Entity that prescribes a canonical format for communication."@en .

<https://www.commoncoreontologies.org/ont00001192> a owl:Class ;
    rdfs:label "Radio Antenna"@en ;
    rdfs:subClassOf <https://www.commoncoreontologies.org/ont00000092> ;
    skos:definition "A Bidirectional Transducer that is designed to convert electric power into radio waves, and radio waves into electric power."@en .

<https://www.commoncoreontologies.org/ont00001203> a owl:Class ;
    rdfs:label "Delimiting Domain"@en ;
    rdfs:subClassOf <https://www.commoncoreontologies.org/ont00000472> ;
    skos:definition "A Geospatial Region that delimits the authority of an Organization to exercise its control within the bounded area."@en .

<https://www.commoncoreontologies.org/ont00001278> a owl:Class ;
    rdfs:label "Stock"@en ;
    rdfs:subClassOf <https://www.commoncoreontologies.org/ont00000537> ;
    skos:definition "A Financial Instrument that entitles holders to an ownership interest (equity) in the specified Incorporated Organization."@en .

<https://www.commoncoreontologies.org/ont00001327> a owl:Class ;
    rdfs:label "Social Act"@en ;
    rdfs:subClassOf <https://www.commoncoreontologies.org/ont00000228> ;
    skos:definition "A Planned Act having an objective that affects, is performed by, or is performed on behalf of, a community or group of Persons."@en .

<https://www.commoncoreontologies.org/ont00001384> a owl:Class ;
    rdfs:label "Opacity"@en ;
    rdfs:subClassOf <https://www.commoncoreontologies.org/ont00000628> ;
    skos:definition "A Disposition to Interact with Electromagnetic Radiation that inheres in a bearer in virtue of that bearer's capacity to transmit electromagnetic radiation of a given frequency through the bearer instead of reflecting, scattering, or absorbing electromangentic radiation of that frequency."@en .

<http://purl.obolibrary.org/obo/BFO_0000028> a owl:Class ;
    rdfs:label "three-dimensional spatial region"@en ;
    rdfs:subClassOf <http://purl.obolibrary.org/obo/BFO_0000006> ;
    skos:definition "(Elucidation) A three-dimensional spatial region is a whole consisting of a spatial volume together with zero or more spatial volumes which may have spatial regions of lower dimension as parts"@en .

<http://purl.obolibrary.org/obo/BFO_0000029> a owl:Class ;
    rdfs:label "site"@en ;
    rdfs:subClassOf <http://purl.obolibrary.org/obo/BFO_0000141> ;
    owl:disjointWith <http://purl.obolibrary.org/obo/BFO_0000140> ;
    skos:definition "(Elucidation) A site is a three-dimensional immaterial entity whose boundaries either (partially or wholly) coincide with the boundaries of one or more material entities or have locations determined in relation to some material entity"@en .

<http://purl.obolibrary.org/obo/BFO_0000035> a owl:Class ;
    rdfs:label "process boundary"@en ;
    rdfs:subClassOf <http://purl.obolibrary.org/obo/BFO_0000003> ;
    skos:definition "p is a process boundary =Def p is a temporal part of a process & p has no proper temporal parts"@en .

<http://purl.obolibrary.org/obo/BFO_0000140> a owl:Class ;
    rdfs:label "continuant fiat boundary"@en ;
    rdfs:subClassOf <http://purl.obolibrary.org/obo/BFO_0000141> ;
    skos:definition "(Elucidation) A continuant fiat boundary b is an immaterial entity that is of zero, one or two dimensions & such that there is no time t when b has a spatial region as continuant part & whose location is determined in relation to some material entity"@en .

<https://www.commoncoreontologies.org/ont00000004> a owl:Class ;
    rdfs:label "Change"@en ;
    rdfs:subClassOf <http://purl.obolibrary.org/obo/BFO_0000015> ;
    skos:definition "A Process in which some independent continuant endures and 1) one or more of the dependent entities it bears increase or decrease in intensity, 2) the entity begins to bear some dependent entity or 3) the entity ceases to bear some dependent entity."@en .

<https://www.commoncoreontologies.org/ont00000053> a owl:Class ;
    rdfs:label "Ground Motor Vehicle"@en ;
    rdfs:subClassOf <https://www.commoncoreontologies.org/ont00000618> ;
    skos:definition "A Ground Vehicle that is designed to receive its motive power from an Engine and is not designed to travel on rails."@en .

<https://www.commoncoreontologies.org/ont00000135> a owl:Class ;
    rdfs:label "Stasis of Specifically Dependent Continuant"@en ;
    rdfs:subClassOf <https://www.commoncoreontologies.org/ont00000819> ;
    skos:definition "A Stasis in which some Independent Continuant bears some Specifically Dependent Continuant that remains unchanged during a Temporal Interval."@en .

<https://www.commoncoreontologies.org/ont00000136> a owl:Class ;
    rdfs:label "Optical Instrument"@en ;
    rdfs:subClassOf <https://www.commoncoreontologies.org/ont00000995> ;
    skos:definition "A Material Artifact that is designed to process light waves."@en .

<https://www.commoncoreontologies.org/ont00000246> a owl:Class ;
    rdfs:label "Stasis of Realizable Entity"@en ;
    rdfs:subClassOf <https://www.commoncoreontologies.org/ont00000135> ;
    skos:definition "A Stasis of Specifically Dependent Continuant in which some Independent Continuant bears some Realizable Entity that remains unchanged during a Temporal Interval."@en .

<https://www.commoncoreontologies.org/ont00000294> a owl:Class ;
    rdfs:label "Air-Breathing Jet Engine"@en ;
    rdfs:subClassOf <https://www.commoncoreontologies.org/ont00000533> ;
    skos:definition "A Jet Engine that is propelled by a jet of hot exhaust gases formed from air that is drawn into the Engine via an Air Inlet."@en .

<https://www.commoncoreontologies.org/ont00000300> a owl:Class ;
    rdfs:label "Group of Agents"@en ;
    rdfs:subClassOf <http://purl.obolibrary.org/obo/BFO_0000027> ;
    skos:definition "An Object Aggregate that has only Agents as member parts."@en .

<https://www.commoncoreontologies.org/ont00000379> a owl:Class ;
    rdfs:label "Act of Representative Communication"@en ;
    rdfs:subClassOf <https://www.commoncoreontologies.org/ont00000402> ;
    skos:definition "An Act of Communication that commits a speaker to the truth of the expressed proposition."@en .

<https://www.commoncoreontologies.org/ont00000398> a owl:Class ;
    rdfs:label "Reference System"@en ;
    rdfs:subClassOf <https://www.commoncoreontologies.org/ont00000853> ;
    skos:definition "A Descriptive Information Content Entity that describes a set of standards for organizing and understanding data of the specified type or domain."@en .

<https://www.commoncoreontologies.org/ont00000472> a owl:Class ;
    rdfs:label "Geospatial Region"@en ;
    rdfs:subClassOf <http://purl.obolibrary.org/obo/BFO_0000029> ;
    skos:definition "A Site that is at or near the surface of the Earth."@en .

<https://www.commoncoreontologies.org/ont00000628> a owl:Class ;
    rdfs:label "Disposition to Interact with Electromagnetic Radiation"@en ;
    rdfs:subClassOf <http://purl.obolibrary.org/obo/BFO_0000016> ;
    skos:definition "A Disposition that inheres in a bearer in virtue of how that bearer interacts with electromagnetic radiation."@en .

<https://www.commoncoreontologies.org/ont00000687> a owl:Class ;
    rdfs:label "Act of Training Acquisition"@en ;
    rdfs:subClassOf <https://www.commoncoreontologies.org/ont00000234> ;
    skos:definition "An Act of Training performed by an Agent by acquiring knowledge from another Agent."@en .

<https://www.commoncoreontologies.org/ont00000713> a owl:Class ;
    rdfs:label "Vehicle"@en ;
    rdfs:subClassOf <https://www.commoncoreontologies.org/ont00000995> ;
    skos:definition "A Material Artifact that is designed to facilitate the movement of material entities from one location to another by conveying them there."@en .

<https://www.commoncoreontologies.org/ont00000752> a owl:Class ;
    rdfs:label "Wave Process Profile"@en ;
    rdfs:subClassOf <http://purl.obolibrary.org/obo/BFO_0000144> ;
    skos:definition "A Process Profile of a Wave Process."@en .

<https://www.commoncoreontologies.org/ont00000784> a owl:Class ;
    rdfs:label "Optical Property"@en ;
    rdfs:subClassOf <https://www.commoncoreontologies.org/ont00000628> ;
    skos:definition "A Disposition to Interact with Electromagnetic Radiation that is realized when its bearer interacts with electromagnetic waves within the visible light spectrum."@en .

<https://www.commoncoreontologies.org/ont00001075> a owl:Class ;
    rdfs:label "Act of Training Instruction"@en ;
    rdfs:subClassOf <https://www.commoncoreontologies.org/ont00000234> ;
    skos:definition "An Act of Training performed by an Agent by imparting knowledge to another Agent."@en .

<https://www.commoncoreontologies.org/ont00001153> a owl:Class ;
    rdfs:label "Damaging Artifact Function"@en ;
    rdfs:subClassOf <https://www.commoncoreontologies.org/ont00000323> ;
    skos:definition "An Artifact Function that is realized in a process in which the structural integrity of an entity is impaired."@en .

<https://www.commoncoreontologies.org/ont00001213> a owl:Class ;
    rdfs:label "Stasis of Artifact Operationality"@en ;
    rdfs:subClassOf <https://www.commoncoreontologies.org/ont00000246> ;
    skos:definition "A Stasis of Realizable Entity that holds during a Temporal Interval when a Material Artifact's designed set of Artifact Functions (or at least its primary functions) or the realizations of those functions remain unchanged."@en .

<https://www.commoncoreontologies.org/ont00001286> a owl:Class ;
    rdfs:label "Waveform"@en ;
    rdfs:subClassOf <https://www.commoncoreontologies.org/ont00000752> ;
    skos:definition "A Wave Process Profile that is the shape of the Wave Cycles of the Wave Process when depicted in a visual graph."@en .

<https://www.commoncoreontologies.org/ont00001328> a owl:Class ;
    rdfs:label "Temporal Reference System"@en ;
    rdfs:subClassOf <https://www.commoncoreontologies.org/ont00000398> ;
    skos:definition "A Reference System that describes a set of standards for measuring time as well as understanding the context of and organizing temporal data."@en .

<https://www.commoncoreontologies.org/ont00001360> a owl:Class ;
    rdfs:label "Three Dimensional Shape"@en ;
    rdfs:subClassOf <https://www.commoncoreontologies.org/ont00001059> ;
    skos:definition "A Shape Quality that inheres only in a three dimensional entity."@en .

<https://www.commoncoreontologies.org/ont00001364> a owl:Class ;
    rdfs:label "Interval Measurement Information Content Entity"@en ;
    rdfs:subClassOf <https://www.commoncoreontologies.org/ont00001163> ;
    skos:definition "A Measurement Information Content Entity that places a Quality of an Entity onto some interval scale having no true zero value."@en .

<http://purl.obolibrary.org/obo/BFO_0000004> a owl:Class ;
    rdfs:label "independent continuant"@en ;
    rdfs:subClassOf <http://purl.obolibrary.org/obo/BFO_0000002> ;
    owl:disjointWith <http://purl.obolibrary.org/obo/BFO_0000020>,
        <http://purl.obolibrary.org/obo/BFO_0000031> ;
    skos:definition "b is an independent continuant =Def b is a continuant & there is no c such that b specifically depends on c or b generically depends on c"@en .

<http://purl.obolibrary.org/obo/BFO_0000006> a owl:Class ;
    rdfs:label "spatial region"@en ;
    rdfs:subClassOf <http://purl.obolibrary.org/obo/BFO_0000141> ;
    owl:disjointWith <http://purl.obolibrary.org/obo/BFO_0000029>,
        <http://purl.obolibrary.org/obo/BFO_0000140> ;
    skos:definition "(Elucidation) A spatial region is a continuant entity that is a continuant part of the spatial projection of a portion of spacetime at a given time"@en .

<http://purl.obolibrary.org/obo/BFO_0000024> a owl:Class ;
    rdfs:label "fiat object part"@en ;
    rdfs:subClassOf <http://purl.obolibrary.org/obo/BFO_0000040> ;
    skos:definition "(Elucidation) A fiat object part b is a material entity & such that if b exists then it is continuant part of some object c & demarcated from the remainder of c by one or more fiat surfaces"@en .

<https://www.commoncoreontologies.org/ont00000065> a owl:Class ;
    rdfs:label "Act of Location Change"@en ;
    rdfs:subClassOf <https://www.commoncoreontologies.org/ont00000357> ;
    skos:definition "An Act of Motion in which the location of some Object is changed by some Agent."@en .

<https://www.commoncoreontologies.org/ont00000098> a owl:Class ;
    rdfs:label "Electrical Artifact Function"@en ;
    rdfs:subClassOf <https://www.commoncoreontologies.org/ont00000323> ;
    skos:definition "An Artifact Function that is realized during events in which a Material Artifact is used to perform a process involving electrical power."@en .

<https://www.commoncoreontologies.org/ont00000433> a owl:Class ;
    rdfs:label "Act of Association"@en ;
    rdfs:subClassOf <https://www.commoncoreontologies.org/ont00001327> ;
    skos:definition "A Social Act wherein an Agent unites with some other Agent in a Planned Act, enterprise or business."@en .

<https://www.commoncoreontologies.org/ont00000547> a owl:Class ;
    rdfs:label "Telescope"@en ;
    rdfs:subClassOf <https://www.commoncoreontologies.org/ont00000771> ;
    skos:definition "An Imaging Instrument that is designed to aid in the observation of spatially distant Objects by means of collecting and focusing Electromagnetic Radiation to form an enhanced image of the Object."@en .

<https://www.commoncoreontologies.org/ont00000715> a owl:Class ;
    rdfs:label "Prosthesis"@en ;
    rdfs:subClassOf <https://www.commoncoreontologies.org/ont00001381> ;
    skos:definition "A Medical Artifact that is designed to replace a missing body part."@en .

<https://www.commoncoreontologies.org/ont00000782> a owl:Class ;
    rdfs:label "Factory"@en ;
    rdfs:subClassOf <https://www.commoncoreontologies.org/ont00000192> ;
    skos:definition "A Facility that is designed for manufacturing or refining material products."@en .

<https://www.commoncoreontologies.org/ont00000791> a owl:Class ;
    rdfs:label "Chemical Reaction Artifact Function"@en ;
    rdfs:subClassOf <https://www.commoncoreontologies.org/ont00000323> ;
    skos:definition "An Artifact Function that is realized in a process that leads to the transformation of one set of chemical substances to another."@en .

<https://www.commoncoreontologies.org/ont00001051> a owl:Class ;
    rdfs:label "Projectile Launcher"@en ;
    rdfs:subClassOf <https://www.commoncoreontologies.org/ont00000445> ;
    skos:definition "A Weapon that is designed to inflict damage or harm by means of launching a high-velocity projectile at a target."@en .

<https://www.commoncoreontologies.org/ont00001052> a owl:Class ;
    rdfs:label "Military Facility"@en ;
    rdfs:subClassOf <https://www.commoncoreontologies.org/ont00000192> ;
    skos:definition "A Facility that is designed to support a Military Force."@en .

<https://www.commoncoreontologies.org/ont00001298> a owl:Class ;
    rdfs:label "Material Copy of a Document"@en ;
    rdfs:subClassOf <https://www.commoncoreontologies.org/ont00000798> ;
    skos:definition "An Information Bearing Artifact that is designed to carry some specific Information Content Entity in a series of paragraphs of text or diagrams in the form of physical pieces of paper or an electronic word processor file."@en .

<https://www.commoncoreontologies.org/ont00001367> a owl:Class ;
    rdfs:label "One Dimensional Extent"@en ;
    rdfs:subClassOf <https://www.commoncoreontologies.org/ont00001202> ;
    skos:definition "A Size Quality that inheres in a bearer in virtue of the bearer's extension in one dimension."@en .

<https://www.commoncoreontologies.org/ont00001379> a owl:Class ;
    rdfs:label "Agent Capability"@en ;
    rdfs:subClassOf <http://purl.obolibrary.org/obo/BFO_0000017> ;
    skos:definition "A Realizable Entity that inheres in a Material Entity in virtue of that Material Entity's capacity to realize it in some Planned Act."@en .

<https://www.commoncoreontologies.org/ont00002039> a owl:Class ;
    rdfs:label "Document Content Entity"@en ;
    rdfs:subClassOf <https://www.commoncoreontologies.org/ont00002001> ;
    skos:definition "A Media Content Entity that consists of a series of paragraphs of text or diagrams that are intended to be carried by physical pieces of paper or an electronic word processor file."@en .

<http://purl.obolibrary.org/obo/BFO_0000020> a owl:Class ;
    rdfs:label "specifically dependent continuant"@en ;
    rdfs:subClassOf <http://purl.obolibrary.org/obo/BFO_0000002> ;
    owl:disjointWith <http://purl.obolibrary.org/obo/BFO_0000031> ;
    skos:definition "b is a specifically dependent continuant =Def b is a continuant & there is some independent continuant c which is not a spatial region & which is such that b specifically depends on c"@en .

<http://purl.obolibrary.org/obo/BFO_0000031> a owl:Class ;
    rdfs:label "generically dependent continuant"@en ;
    rdfs:subClassOf <http://purl.obolibrary.org/obo/BFO_0000002> ;
    skos:definition "(Elucidation) A generically dependent continuant is an entity that exists in virtue of the fact that there is at least one of what may be multiple copies which is the content or the pattern that multiple copies would share"@en .

<https://www.commoncoreontologies.org/ont00000457> a owl:Class ;
    rdfs:label "Portion of Material"@en ;
    rdfs:subClassOf <https://www.commoncoreontologies.org/ont00001084> ;
    skos:definition "A Portion of Processed Material that was produced to be used as the input for another Act of Material Artifact Processing."@en .

<https://www.commoncoreontologies.org/ont00000530> a owl:Class ;
    rdfs:label "Sonic Frequency"@en ;
    rdfs:subClassOf <https://www.commoncoreontologies.org/ont00000008> ;
    skos:definition "A Sound Frequency that is between 20 Hz and 20 kHz."@en .

<https://www.commoncoreontologies.org/ont00000588> a owl:Class ;
    rdfs:label "Act of Mass Media Communication"@en ;
    rdfs:subClassOf <https://www.commoncoreontologies.org/ont00000402> ;
    skos:definition "An Act of Communication intended to reach a large audience using a medium such as the internet, television, radio, newspaper, and magazine."@en .

<https://www.commoncoreontologies.org/ont00000754> a owl:Class ;
    rdfs:label "Electromagnetic Radiation Frequency"@en ;
    rdfs:subClassOf <https://www.commoncoreontologies.org/ont00001047> ;
    skos:definition "A Frequency that is characterized by the rate of Oscillations per second of an Electromagnetic Wave."@en .

<https://www.commoncoreontologies.org/ont00000836> a owl:Class ;
    rdfs:label "Act of Financial Instrument Use"@en ;
    rdfs:subClassOf <https://www.commoncoreontologies.org/ont00000566> ;
    skos:definition "An Act of Artifact Employment in which some Agent uses some Financial Instrument."@en .

<https://www.commoncoreontologies.org/ont00000853> a owl:Class ;
    rdfs:label "Descriptive Information Content Entity"@en ;
    rdfs:subClassOf <https://www.commoncoreontologies.org/ont00000958> ;
    owl:disjointWith <https://www.commoncoreontologies.org/ont00000965> ;
    skos:definition "An Information Content Entity that consists of a set of propositions that describe some Entity."@en .

<https://www.commoncoreontologies.org/ont00000903> a owl:Class ;
    rdfs:label "Radio Communication Instrument"@en ;
    rdfs:subClassOf <https://www.commoncoreontologies.org/ont00000346> ;
    skos:definition "A Communication Instrument that is designed to enable communication between two or more entities via the use of radio waves."@en .

<https://www.commoncoreontologies.org/ont00001022> a owl:Class ;
    rdfs:label "Ratio Measurement Information Content Entity"@en ;
    rdfs:subClassOf <https://www.commoncoreontologies.org/ont00001163> ;
    owl:disjointWith <https://www.commoncoreontologies.org/ont00001364> ;
    skos:definition "A Measurement Information Content Entity that consists of a symbol that places a Quality of an Entity onto an interval scale having a true zero value."@en .

<https://www.commoncoreontologies.org/ont00001150> a owl:Class ;
    rdfs:label "Portion of Ammunition"@en ;
    rdfs:subClassOf <https://www.commoncoreontologies.org/ont00000445> ;
    skos:definition "A Weapon that is designed to inflict harm, damage, or incapacity by being projected toward its target at a significant Velocity."@en .

<https://www.commoncoreontologies.org/ont00001152> a owl:Class ;
    rdfs:label "Government Domain"@en ;
    rdfs:subClassOf <https://www.commoncoreontologies.org/ont00001203> ;
    skos:definition "A Delimiting Domain that delimits the authority of a Government to exercise its control within the bounded area."@en .

<https://www.commoncoreontologies.org/ont00001326> a owl:Class ;
    rdfs:label "Land Transportation Artifact"@en ;
    rdfs:subClassOf <https://www.commoncoreontologies.org/ont00000254> ;
    skos:definition "A Transportation Artifact that facilitates the movement of Agents and Vehicles via land"@en .

<http://purl.obolibrary.org/obo/BFO_0000002> a owl:Class ;
    rdfs:label "continuant"@en ;
    rdfs:subClassOf <http://purl.obolibrary.org/obo/BFO_0000001> ;
    owl:disjointWith <http://purl.obolibrary.org/obo/BFO_0000003> ;
    skos:definition "(Elucidation) A continuant is an entity that persists, endures, or continues to exist through time while maintaining its identity"@en .

<http://purl.obolibrary.org/obo/BFO_0000017> a owl:Class ;
    rdfs:label "realizable entity"@en ;
    rdfs:subClassOf <http://purl.obolibrary.org/obo/BFO_0000020> ;
    owl:disjointWith <http://purl.obolibrary.org/obo/BFO_0000019> ;
    skos:definition "(Elucidation) A realizable entity is a specifically dependent continuant that inheres in some independent continuant which is not a spatial region & which is of a type some instances of which are realized in processes of a correlated type"@en .

<https://www.commoncoreontologies.org/ont00000084> a owl:Class ;
    rdfs:label "Bodily Component"@en ;
    rdfs:subClassOf <http://purl.obolibrary.org/obo/BFO_0000024> ;
    skos:definition "A Fiat Object Part located within or on the surface of an Agent."@en .

<https://www.commoncoreontologies.org/ont00000566> a owl:Class ;
    rdfs:label "Act of Artifact Employment"@en ;
    rdfs:subClassOf <https://www.commoncoreontologies.org/ont00000228> ;
    skos:definition "A Planned Act of using a Material Artifact."@en .

<https://www.commoncoreontologies.org/ont00000686> a owl:Class ;
    rdfs:label "Designative Information Content Entity"@en ;
    rdfs:subClassOf <https://www.commoncoreontologies.org/ont00000958> ;
    owl:disjointWith <https://www.commoncoreontologies.org/ont00000853>,
        <https://www.commoncoreontologies.org/ont00000965> ;
    skos:definition "An Information Content Entity that consists of a set of symbols that designate some Entity."@en .

<https://www.commoncoreontologies.org/ont00001010> a owl:Class ;
    rdfs:label "Ordinal Measurement Information Content Entity"@en ;
    rdfs:subClassOf <https://www.commoncoreontologies.org/ont00001163> ;
    owl:disjointWith <https://www.commoncoreontologies.org/ont00001022>,
        <https://www.commoncoreontologies.org/ont00001364> ;
    skos:definition "A Measurement Information Content Entity that consists of a symbol that places an Entity into some rank order."@en .

<https://www.commoncoreontologies.org/ont00001049> a owl:Class ;
    rdfs:label "Electrical Power Source"@en ;
    rdfs:subClassOf <https://www.commoncoreontologies.org/ont00000288> ;
    skos:definition "A Power Source that is designed to generate, control, and transfer power in the form of electrical energy."@en .

<https://www.commoncoreontologies.org/ont00000007> a owl:Class ;
    rdfs:label "Natural Process"@en ;
    rdfs:subClassOf <http://purl.obolibrary.org/obo/BFO_0000015> ;
    skos:definition "A Process existing in or produced by nature; rather than by the intent of human beings."@en .

<https://www.commoncoreontologies.org/ont00000150> a owl:Class ;
    rdfs:label "Radio Frequency"@en ;
    rdfs:subClassOf <https://www.commoncoreontologies.org/ont00000754> ;
    skos:definition "An Electromagnetic Radiation Frequency of some Electromagnetic Wave that is between 3 kHz and 300 GHz."@en .

<https://www.commoncoreontologies.org/ont00000256> a owl:Class ;
    rdfs:label "Fluid Control Artifact"@en ;
    rdfs:subClassOf <https://www.commoncoreontologies.org/ont00000995> ;
    skos:definition "A Material Artifact that is designed to manipulate the flow of a fluid (i.e. a liquid or a gas)."@en .

<https://www.commoncoreontologies.org/ont00000445> a owl:Class ;
    rdfs:label "Weapon"@en ;
    rdfs:subClassOf <https://www.commoncoreontologies.org/ont00000995> ;
    skos:definition "A Material Artifact that is designed to destroy or inflict damage to structures or systems, or to kill or wound living things by creating specific lethal or nonlethal effects."@en .

<https://www.commoncoreontologies.org/ont00000517> a owl:Class ;
    rdfs:label "Act of Communication by Media"@en ;
    rdfs:subClassOf <https://www.commoncoreontologies.org/ont00000402> ;
    skos:definition "An Act of Communication in which some Material Artifact is used to transfer an Information Bearing Entity from sender(s) to receiver(s)."@en .

<https://www.commoncoreontologies.org/ont00000881> a owl:Class ;
    rdfs:label "Storage Facility"@en ;
    rdfs:subClassOf <https://www.commoncoreontologies.org/ont00000192> ;
    skos:definition "A Facility that is designed to store materials or goods."@en .

<https://www.commoncoreontologies.org/ont00000958> a owl:Class ;
    rdfs:label "Information Content Entity"@en ;
    rdfs:subClassOf <http://purl.obolibrary.org/obo/BFO_0000031> ;
    skos:definition "A Generically Dependent Continuant that generically depends on some Information Bearing Entity and stands in relation of aboutness to some Entity."@en .

<https://www.commoncoreontologies.org/ont00001324> a owl:Class ;
    rdfs:label "Process Regulation"@en ;
    rdfs:subClassOf <https://www.commoncoreontologies.org/ont00000965> ;
    skos:definition "A Prescriptive Information Content Entity that prescribes an Process as required, prohibited, or permitted, and is the output of an Process which realizes some Authority Role."@en .

<http://purl.obolibrary.org/obo/BFO_0000008> a owl:Class ;
    rdfs:label "temporal region"@en ;
    rdfs:subClassOf <http://purl.obolibrary.org/obo/BFO_0000003> ;
    owl:disjointWith <http://purl.obolibrary.org/obo/BFO_0000011>,
        <http://purl.obolibrary.org/obo/BFO_0000015>,
        <http://purl.obolibrary.org/obo/BFO_0000035> ;
    skos:definition "(Elucidation) A temporal region is an occurrent over which processes can unfold"@en .

<http://purl.obolibrary.org/obo/BFO_0000016> a owl:Class ;
    rdfs:label "disposition"@en ;
    rdfs:subClassOf <http://purl.obolibrary.org/obo/BFO_0000017> ;
    owl:disjointWith <http://purl.obolibrary.org/obo/BFO_0000023> ;
    skos:definition "(Elucidation) A disposition b is a realizable entity such that if b ceases to exist then its bearer is physically changed & b's realization occurs when and because this bearer is in some special physical circumstances & this realization occurs in virtue of the bearer's physical make-up"@en .

<http://purl.obolibrary.org/obo/BFO_0000038> a owl:Class ;
    rdfs:label "one-dimensional temporal region"@en ;
    rdfs:subClassOf <http://purl.obolibrary.org/obo/BFO_0000008> ;
    owl:disjointWith <http://purl.obolibrary.org/obo/BFO_0000148> ;
    skos:definition "(Elucidation) A one-dimensional temporal region is a temporal region that is a whole that has a temporal interval and zero or more temporal intervals and temporal instants as parts"@en .

<https://www.commoncoreontologies.org/ont00001262> a owl:Class ;
    rdfs:label "Person"@en ;
    rdfs:subClassOf <https://www.commoncoreontologies.org/ont00000562> ;
    skos:definition "An Animal that is a member of the species Homo sapiens."@en .

<https://www.commoncoreontologies.org/ont00002001> a owl:Class ;
    rdfs:label "Media Content Entity" ;
    rdfs:subClassOf <https://www.commoncoreontologies.org/ont00000958> ;
    skos:definition "An information content entity presented in a canonical media format."@en .

<http://purl.obolibrary.org/obo/BFO_0000026> a owl:Class ;
    rdfs:label "one-dimensional spatial region"@en ;
    rdfs:subClassOf <http://purl.obolibrary.org/obo/BFO_0000006> ;
    owl:disjointWith <http://purl.obolibrary.org/obo/BFO_0000028> ;
    skos:definition "(Elucidation) A one-dimensional spatial region is a whole consisting of a line together with zero or more lines which may have points as parts"@en .

<http://purl.obolibrary.org/obo/BFO_0000144> a owl:Class ;
    rdfs:label "Process Profile"@en ;
    rdfs:subClassOf <http://purl.obolibrary.org/obo/BFO_0000003> ;
    skos:definition "An occurrent that is an occurrent part of some process by virtue of the rate, or pattern, or amplitude of change in an attribute of one or more participants of said process."@en .

<https://www.commoncoreontologies.org/ont00000798> a owl:Class ;
    rdfs:label "Information Bearing Artifact"@en ;
    rdfs:subClassOf <https://www.commoncoreontologies.org/ont00000995> ;
    skos:definition "A Material Artifact that carries an Information Content Entity and is designed to do so using a particular format or structure."@en .

<https://www.commoncoreontologies.org/ont00001163> a owl:Class ;
    rdfs:label "Measurement Information Content Entity"@en ;
    rdfs:subClassOf <https://www.commoncoreontologies.org/ont00000853> ;
    skos:definition "A Descriptive Information Content Entity that describes the extent, dimensions, quantity, or quality of an Entity relative to some standard."@en .

<http://purl.obolibrary.org/obo/BFO_0000027> a owl:Class ;
    rdfs:label "object aggregate"@en ;
    rdfs:subClassOf <http://purl.obolibrary.org/obo/BFO_0000040> ;
    skos:definition "(Elucidation) An object aggregate is a material entity consisting exactly of a plurality (≥1) of objects as member parts which together form a unit"@en .

<http://purl.obolibrary.org/obo/BFO_0000203> a owl:Class ;
    rdfs:label "temporal instant"@en ;
    rdfs:subClassOf <http://purl.obolibrary.org/obo/BFO_0000148> ;
    skos:definition "(Elucidation) A temporal instant is a zero-dimensional temporal region that has no proper temporal part"@en .

<https://www.commoncoreontologies.org/ont00000402> a owl:Class ;
    rdfs:label "Act of Communication"@en ;
    rdfs:subClassOf <https://www.commoncoreontologies.org/ont00000228> ;
    skos:definition "A Planned Act in which some Information Content Entity is transferred from some Agent to Another."@en .

<https://www.commoncoreontologies.org/ont00000965> a owl:Class ;
    rdfs:label "Prescriptive Information Content Entity"@en ;
    rdfs:subClassOf <https://www.commoncoreontologies.org/ont00000958> ;
    skos:definition "An Information Content Entity that consists of a set of propositions or images (as in the case of a blueprint) that prescribe some Entity."@en .

<https://www.commoncoreontologies.org/ont00001301> a owl:Class ;
    rdfs:label "Service Artifact Function"@en ;
    rdfs:subClassOf <https://www.commoncoreontologies.org/ont00000323> ;
    skos:definition "An Artifact Function that is realized in a process of providing intangible goods to consumers."@en .

<https://www.commoncoreontologies.org/ont00001180> a owl:Class ;
    rdfs:label "Organization"@en ;
    rdfs:subClassOf <https://www.commoncoreontologies.org/ont00000300> ;
    skos:definition "A Group of Agents which can be the bearer of roles, has members, and has a set of organization rules."@en .

<http://purl.obolibrary.org/obo/BFO_0000003> a owl:Class ;
    rdfs:label "occurrent"@en ;
    rdfs:subClassOf <http://purl.obolibrary.org/obo/BFO_0000001> ;
    skos:definition "(Elucidation) An occurrent is an entity that unfolds itself in time or it is the start or end of such an entity or it is a temporal or spatiotemporal region"@en .

<https://www.commoncoreontologies.org/ont00000378> a owl:Class ;
    rdfs:label "Color"@en ;
    rdfs:subClassOf <https://www.commoncoreontologies.org/ont00000784> ;
    skos:definition "An Optical Property that inheres in a bearer in virtue of that bearer's Color Hue, Color Saturation and Color Brightness."@en .

<https://www.commoncoreontologies.org/ont00001017> a owl:Class ;
    rdfs:label "Agent"@en ;
    rdfs:subClassOf <http://purl.obolibrary.org/obo/BFO_0000040> ;
    skos:definition "A Material Entity that bears an Agent Capability."@en .

<https://www.commoncoreontologies.org/ont00000228> a owl:Class ;
    rdfs:label "Planned Act"@en ;
    rdfs:subClassOf <https://www.commoncoreontologies.org/ont00000005> ;
    skos:definition "An Act in which at least one Agent plays a causative role and which is prescribed by some Prescriptive Information Content Entity held by at least one of the Agents."@en .

<https://www.commoncoreontologies.org/ont00000253> a owl:Class ;
    rdfs:label "Information Bearing Entity"@en ;
    rdfs:subClassOf <http://purl.obolibrary.org/obo/BFO_0000030> ;
    skos:definition "An Object upon which an Information Content Entity generically depends."@en .

<http://purl.obolibrary.org/obo/BFO_0000040> a owl:Class ;
    rdfs:label "material entity"@en ;
    rdfs:subClassOf <http://purl.obolibrary.org/obo/BFO_0000004> ;
    owl:disjointWith <http://purl.obolibrary.org/obo/BFO_0000141> ;
    skos:definition "(Elucidation) A material entity is an independent continuant has some portion of matter as continuant part"@en .

<http://purl.obolibrary.org/obo/BFO_0000019> a owl:Class ;
    rdfs:label "quality"@en ;
    rdfs:subClassOf <http://purl.obolibrary.org/obo/BFO_0000020> ;
    skos:definition "(Elucidation) A quality is a specifically dependent continuant that, in contrast to roles and dispositions, does not require any further process in order to be realized"@en .

<https://www.commoncoreontologies.org/ont00000192> a owl:Class ;
    rdfs:label "Facility"@en ;
    rdfs:subClassOf <https://www.commoncoreontologies.org/ont00000995> ;
    skos:definition "A Material Artifact that is designed as a building or campus dedicated to some specific purpose."@en .

<http://purl.obolibrary.org/obo/BFO_0000141> a owl:Class ;
    rdfs:label "immaterial entity"@en ;
    rdfs:subClassOf <http://purl.obolibrary.org/obo/BFO_0000004> ;
    skos:definition "b is an immaterial entity =Def b is an independent continuant which is such that there is no time t when it has a material entity as continuant part"@en .

<https://www.commoncoreontologies.org/ont00001059> a owl:Class ;
    rdfs:label "Shape Quality"@en ;
    rdfs:subClassOf <http://purl.obolibrary.org/obo/BFO_0000019> ;
    skos:definition "A Quality that inheres in a bearer in virtue of the ratios between dimensions of external features of that bearer."@en .

<http://purl.obolibrary.org/obo/BFO_0000001> a owl:Class ;
    rdfs:label "entity"@en ;
    skos:definition "(Elucidation) An entity is anything that exists or has existed or will exist"@en .

<http://purl.obolibrary.org/obo/BFO_0000023> a owl:Class ;
    rdfs:label "role"@en ;
    rdfs:subClassOf <http://purl.obolibrary.org/obo/BFO_0000017> ;
    skos:definition "(Elucidation) A role b is a realizable entity such that b exists because there is some single bearer that is in some special physical, social, or institutional set of circumstances in which this bearer does not have to be & b is not such that, if it ceases to exist, then the physical make-up of the bearer is thereby changed"@en .

<https://www.commoncoreontologies.org/ont00000120> a owl:Class ;
    rdfs:label "Measurement Unit"@en ;
    rdfs:subClassOf <https://www.commoncoreontologies.org/ont00000853> ;
    skos:definition "A Descriptive Information Content Entity that describes a definite magnitude of a physical quantity, defined and adopted by convention and/or by law, that is used as a standard for measurement of the same physical quantity."@en .

<http://purl.obolibrary.org/obo/BFO_0000202> a owl:Class ;
    rdfs:label "temporal interval"@en ;
    rdfs:subClassOf <http://purl.obolibrary.org/obo/BFO_0000038> ;
    skos:definition "(Elucidation) A temporal interval is a one-dimensional temporal region that is continuous, thus without gaps or breaks"@en .

<http://purl.obolibrary.org/obo/BFO_0000015> a owl:Class ;
    rdfs:label "process"@en ;
    rdfs:subClassOf <http://purl.obolibrary.org/obo/BFO_0000003> ;
    owl:disjointWith <http://purl.obolibrary.org/obo/BFO_0000035> ;
    skos:definition "(Elucidation) p is a process means p is an occurrent that has some temporal proper part and for some time t, p has some material entity as participant"@en .

<https://www.commoncoreontologies.org/ont00000323> a owl:Class ;
    rdfs:label "Artifact Function"@en ;
    rdfs:subClassOf <http://purl.obolibrary.org/obo/BFO_0000034> ;
    skos:definition "A Function that inheres in some Material Artifact in virtue of that Material Artifact being designed to be used in processes that require that Function to be realized."@en .

<https://www.commoncoreontologies.org/ont00000995> a owl:Class ;
    rdfs:label "Material Artifact"@en ;
    rdfs:subClassOf <http://purl.obolibrary.org/obo/BFO_0000040> ;
    skos:definition "A Material Entity that was designed by some Agent to realize a certain Function."@en .

