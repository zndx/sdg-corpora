<https://www.commoncoreontologies.org/ont00000356> a owl:Class ;
    rdfs:label "Act of Publishing Mass Media Article"@en ;
    rdfs:subClassOf <https://www.commoncoreontologies.org/ont00000588> ;
    skos:definition "An Act of Mass Media Communication involving the preparation and public issuance of a non-fictional essay, especially one included with others in a newspaper, magazine, journal, etc."@en .

<https://www.commoncoreontologies.org/ont00000358> a owl:Class ;
    rdfs:label "Geospatial Region Bounding Box"@en ;
    rdfs:subClassOf <https://www.commoncoreontologies.org/ont00001130> ;
    skos:definition "A Geospatial Polygon that has some Geospatial Region as a non-tangential proper part."@en .

<https://www.commoncoreontologies.org/ont00000359> a owl:Class ;
    rdfs:label "Julian Date"@en ;
    rdfs:subClassOf <https://www.commoncoreontologies.org/ont00000223> ;
    skos:definition "A Time of Day as specified according to the Julian Calendar using the Julian Date epoch."@en .

<https://www.commoncoreontologies.org/ont00000360> a owl:Class ;
    rdfs:label "Wounded Stasis"@en ;
    rdfs:subClassOf <https://www.commoncoreontologies.org/ont00001289> ;
    skos:definition "A Damaged Stasis in which a Person or other organism is the bearer of a Quality or Realizable Entity that has suffered impairment (i.e., a decrease or loss) due to an injuring event."@en .

<https://www.commoncoreontologies.org/ont00000361> a owl:Class ;
    rdfs:label "Increase of Function"@en ;
    rdfs:subClassOf <https://www.commoncoreontologies.org/ont00001356> ;
    skos:definition "An Increase of Disposition in which some Independent Continuant has an increase of some Function that it bears."@en .

<https://www.commoncoreontologies.org/ont00000362> a owl:Class ;
    rdfs:label "Rocket Engine"@en ;
    rdfs:subClassOf <https://www.commoncoreontologies.org/ont00000533> ;
    skos:definition "A Jet Engine that is designed to use only stored Rocket Propellant to form a high speed propulsive jet in order to generate Thrust."@en .

<https://www.commoncoreontologies.org/ont00000364> a owl:Class ;
    rdfs:label "Pneumatic Motor"@en ;
    rdfs:subClassOf <https://www.commoncoreontologies.org/ont00001221> ;
    skos:definition "A Physically Powered Engine that converts potential energy stored in a portion of compressed air into mechanical energy."@en .

<https://www.commoncoreontologies.org/ont00000365> a owl:Class ;
    rdfs:label "x-Axis"@en ;
    rdfs:subClassOf <https://www.commoncoreontologies.org/ont00000161> ;
    skos:definition "A Coordinate System Axis designated by the variable 'x'."@en .

<https://www.commoncoreontologies.org/ont00000367> a owl:Class ;
    rdfs:label "Act of Military Training Instruction"@en ;
    rdfs:subClassOf <https://www.commoncoreontologies.org/ont00001075> ;
    skos:definition "An Act of Training Instruction performed by an Agent who realizes a capacity derived from the Agent's affiliation with some Military Organization by imparting knowledge of the tactics, techniques, and/or strategies of Military Operations to an Agent either directly or indirectly through some communication medium."@en .

<https://www.commoncoreontologies.org/ont00000369> a owl:Class ;
    rdfs:label "Priority Measurement Information Content Entity"@en ;
    rdfs:subClassOf <https://www.commoncoreontologies.org/ont00001010> ;
    skos:definition "An Ordinal Measurement Information Content Entity that is a measurement of the relative importance of an entity."@en .

<https://www.commoncoreontologies.org/ont00000370> a owl:Class ;
    rdfs:label "Act of Condoling"@en ;
    rdfs:subClassOf <https://www.commoncoreontologies.org/ont00000123> ;
    skos:definition "An Act of Expressive Communication performed by expressing sympathy or sorrow."@en .

<https://www.commoncoreontologies.org/ont00000371> a owl:Class ;
    rdfs:label "Act of Prediction"@en ;
    rdfs:subClassOf <https://www.commoncoreontologies.org/ont00000228> ;
    skos:definition "A Planned Act that involves the generation of a Predictive Information Content entity that is intended to describe an uncertain possible future event, value, entity, or attribute of an entity."@en .

<https://www.commoncoreontologies.org/ont00000372> a owl:Class ;
    rdfs:label "Power Transformer Rectifier Unit"@en ;
    rdfs:subClassOf <https://www.commoncoreontologies.org/ont00000995> ;
    skos:definition "A Material Artifact that is designed to perform the functions of both a Rectifier and a Transformer."@en .

<https://www.commoncoreontologies.org/ont00000374> a owl:Class ;
    rdfs:label "Measurement Unit of Volumetric Flow Rate"@en ;
    rdfs:subClassOf <https://www.commoncoreontologies.org/ont00000061> ;
    skos:definition "A Measurement Unit of Flow that is used as a standard for measurement of the rate at which volumes of fluid pass per unit time."@en .

<https://www.commoncoreontologies.org/ont00000375> a owl:Class ;
    rdfs:label "Warehouse"@en ;
    rdfs:subClassOf <https://www.commoncoreontologies.org/ont00000881> ;
    skos:definition "A Storage Facility that is designed to store commercial goods."@en .

<https://www.commoncoreontologies.org/ont00000376> a owl:Class ;
    rdfs:label "Portion of Gallium Arsenide"@en ;
    rdfs:subClassOf <https://www.commoncoreontologies.org/ont00000457> ;
    skos:definition "A Portion of Material that is composed of a compound of the elements gallium and arsenic."@en .

<https://www.commoncoreontologies.org/ont00000377> a owl:Class ;
    rdfs:label "Disability"@en ;
    rdfs:subClassOf <http://purl.obolibrary.org/obo/BFO_0000019> ;
    skos:definition "A Quality inhering in an Agent by virtue a physical or mental condition that limits the Agent's movements, senses, or activities."@en .

<https://www.commoncoreontologies.org/ont00000381> a owl:Class ;
    rdfs:label "Weapon Manufacturing Facility"@en ;
    rdfs:subClassOf <https://www.commoncoreontologies.org/ont00000782> ;
    skos:definition "A Factory that is designed to produce or assemble weapons."@en .

<https://www.commoncoreontologies.org/ont00000382> a owl:Class ;
    rdfs:label "Material Copy of a Spreadsheet"@en ;
    rdfs:subClassOf <https://www.commoncoreontologies.org/ont00001298> ;
    skos:definition "A Material Copy of a Document that is designed to carry some Information Content Entity in an interactive, tabular form."@en .

<https://www.commoncoreontologies.org/ont00000383> a owl:Class ;
    rdfs:label "Nuclear Family"@en ;
    rdfs:subClassOf <https://www.commoncoreontologies.org/ont00000837> ;
    skos:definition "A Family composed of parents and their children."@en .

<https://www.commoncoreontologies.org/ont00000384> a owl:Class ;
    rdfs:label "Rectilinear Motion"@en ;
    rdfs:subClassOf <https://www.commoncoreontologies.org/ont00000789> ;
    skos:definition "A Translational Motion process in which an Object moves along a straight path."@en .

<https://www.commoncoreontologies.org/ont00000385> a owl:Class ;
    rdfs:label "Wide"@en ;
    rdfs:subClassOf <https://www.commoncoreontologies.org/ont00001059> ;
    skos:definition "A Shape Quality inhering in a bearer in virtue of the bearer having a width or depth which is significantly larger in proportion to its length or height."@en .

<https://www.commoncoreontologies.org/ont00000386> a owl:Class ;
    rdfs:label "Webcast"@en ;
    rdfs:subClassOf <https://www.commoncoreontologies.org/ont00000517> ;
    skos:definition "An Act of Communciation by Media transmitted to an audience over the Internet using streaming media technology to distribute a single content source that may be distributed live or on demand."@en .

<https://www.commoncoreontologies.org/ont00000388> a owl:Class ;
    rdfs:label "Citizen"@en ;
    rdfs:subClassOf <https://www.commoncoreontologies.org/ont00001262> ;
    skos:definition "A Person who is the bearer of some Citizen Role."@en .

<https://www.commoncoreontologies.org/ont00000389> a owl:Class ;
    rdfs:label "Act of Buying"@en ;
    rdfs:subClassOf <https://www.commoncoreontologies.org/ont00001334> ;
    skos:definition "An Act of Purchasing wherein a Financial Instrument is used by an Agent (the Buyer) to acquire ownership of a good from another Agent (the Seller)."@en .

<https://www.commoncoreontologies.org/ont00000391> a owl:Class ;
    rdfs:label "Tremendously High Frequency"@en ;
    rdfs:subClassOf <https://www.commoncoreontologies.org/ont00000754> ;
    skos:definition "An Electromagnetic Radiation Frequency of some Electromagnetic Wave that is between 300 GHz and 3 THz."@en .

<https://www.commoncoreontologies.org/ont00000393> a owl:Class ;
    rdfs:label "Yaw Axis"@en ;
    rdfs:subClassOf <https://www.commoncoreontologies.org/ont00000387> ;
    skos:definition "An Axis of Rotation that passes through the center of an object's Mass from the top to the bottom and is perpendicular to the direction of the object's motion. For objects in Orbit, the Yaw Axis passes through the Barycenter of its Orbit."@en .

<https://www.commoncoreontologies.org/ont00000396> a owl:Class ;
    rdfs:label "Extremely Low Frequency"@en ;
    rdfs:subClassOf <https://www.commoncoreontologies.org/ont00000150> ;
    skos:definition "A Radio Frequency that is between 3 and 30 Hz."@en .

<https://www.commoncoreontologies.org/ont00000397> a owl:Class ;
    rdfs:label "Combustion Chamber"@en ;
    rdfs:subClassOf <https://www.commoncoreontologies.org/ont00000995> ;
    skos:definition "A Material Artifact that is designed to wholly or partially bound an internal Site where a Combustion process is intended to occur."@en .

<https://www.commoncoreontologies.org/ont00000400> a owl:Class ;
    rdfs:label "Park"@en ;
    rdfs:subClassOf <https://www.commoncoreontologies.org/ont00001197> ;
    skos:definition "An Anthropogenic Feature that is a bounded area of land, or water, usually in its natural or semi-natural (landscaped) state and set aside for some purpose, usually to do with recreation or conservation."@en .

<https://www.commoncoreontologies.org/ont00000401> a owl:Class ;
    rdfs:label "Fundamental Frequency"@en ;
    rdfs:subClassOf <https://www.commoncoreontologies.org/ont00000008> ;
    skos:definition "A Sound Frequency that is the lowest Frequency of a Sound Wave."@en .

<https://www.commoncoreontologies.org/ont00000403> a owl:Class ;
    rdfs:label "Diffraction Artifact Function"@en ;
    rdfs:subClassOf <https://www.commoncoreontologies.org/ont00000323> ;
    skos:definition "An Artifact Function that is realized by a Material Artifact participating in a diffraction event in which the Material Artifact forces a wave to bend around the corners of an obstacle or aperture into the region of geometrical shadow of the obstacle."@en .

<https://www.commoncoreontologies.org/ont00000404> a owl:Class ;
    rdfs:label "Iris"@en ;
    rdfs:subClassOf <https://www.commoncoreontologies.org/ont00000084> ;
    skos:definition "A Bodily Component that consists of the part of an Eye that is a pigmented, round, contractile membrane, suspended between the cornea and lens and perforated by the pupil, and which canonically regulates the amount of light entering the Eye."@en .

<https://www.commoncoreontologies.org/ont00000405> a owl:Class ;
    rdfs:label "Second-Order Administrative Region"@en ;
    rdfs:subClassOf <https://www.commoncoreontologies.org/ont00001152> ;
    skos:definition "A Government Domain that is a subdivision of a First-Order Administrative Region."@en .

<https://www.commoncoreontologies.org/ont00000407> a owl:Class ;
    rdfs:label "Electrical Resistance Artifact Function"@en ;
    rdfs:subClassOf <https://www.commoncoreontologies.org/ont00000098> ;
    skos:definition "An Electrical Artifact Function that is realized in processes in which a Material Artifact opposes the flow of an electric current."@en .

<https://www.commoncoreontologies.org/ont00000408> a owl:Class ;
    rdfs:label "Government Organization"@en ;
    rdfs:subClassOf <https://www.commoncoreontologies.org/ont00001180> ;
    skos:definition "An Organization that is part of a Government and is responsible for the oversight or administration of specific governmental functions."@en .

<https://www.commoncoreontologies.org/ont00000409> a owl:Class ;
    rdfs:label "Spark Ignition System"@en ;
    rdfs:subClassOf <https://www.commoncoreontologies.org/ont00000742> ;
    skos:definition "An Ignition System that is designed to produce a spark in order to initiate an Ignition process."@en .

<https://www.commoncoreontologies.org/ont00000411> a owl:Class ;
    rdfs:label "Speed Measurement Artifact Function"@en ;
    rdfs:subClassOf <https://www.commoncoreontologies.org/ont00001100> ;
    skos:definition "A Measurement Artifact Function that is realized during events in which a Material Artifact is used to measure the Speed of a specified object's or class of objects' Motion."@en .

<https://www.commoncoreontologies.org/ont00000412> a owl:Class ;
    rdfs:label "Oxidizer Artifact Function"@en ;
    rdfs:subClassOf <https://www.commoncoreontologies.org/ont00000791> ;
    skos:definition "A Chemical Reaction Artifact Function that is realized in a process in which electrons are removed from a reactant in a redox reaction."@en .

<https://www.commoncoreontologies.org/ont00000413> a owl:Class ;
    rdfs:label "Electron Microscope"@en ;
    rdfs:subClassOf <https://www.commoncoreontologies.org/ont00000304> ;
    skos:definition "A Microscope that is designed to use a beam of accelerated electrons to illuminate the target and produce a significantly enlarged image of the Object."@en .

<https://www.commoncoreontologies.org/ont00000414> a owl:Class ;
    rdfs:label "Square Waveform"@en ;
    rdfs:subClassOf <https://www.commoncoreontologies.org/ont00001286> ;
    skos:definition "A Waveform that is characterized by a square shape due to the near-instantaneous transitions between minimum and maximum Amplitudes of the Wave Cycle."@en .

<https://www.commoncoreontologies.org/ont00000416> a owl:Class ;
    rdfs:label "Act of Publishing Mass Media Press Release"@en ;
    rdfs:subClassOf <https://www.commoncoreontologies.org/ont00000588> ;
    skos:definition "An Act of Mass Media Communication involving the preparation and public issuance of an official statement issued to one or more members of the media for the purpose of announcing newsworthy information."@en .

<https://www.commoncoreontologies.org/ont00000417> a owl:Class ;
    rdfs:label "Prosthetic Hand"@en ;
    rdfs:subClassOf <https://www.commoncoreontologies.org/ont00000715> ;
    skos:definition "A Prosthesis that is designed to replace a missing hand."@en .

<https://www.commoncoreontologies.org/ont00000418> a owl:Class ;
    rdfs:label "Biographical Life"@en ;
    rdfs:subClassOf <https://www.commoncoreontologies.org/ont00000005> ;
    skos:definition "An Act composed of the Life Events that occur during the course of existence of an Agent (i.e. Person or Organization)."@en .

<https://www.commoncoreontologies.org/ont00000419> a owl:Class ;
    rdfs:label "Part Number"@en ;
    rdfs:subClassOf <https://www.commoncoreontologies.org/ont00000077> ;
    skos:definition "A Code Identifier that designates a type of part whose instances are designed to be part of some Material Artifact."@en .

<https://www.commoncoreontologies.org/ont00000420> a owl:Class ;
    rdfs:label "Computer"@en ;
    rdfs:subClassOf <https://www.commoncoreontologies.org/ont00000117> ;
    skos:definition "An Information Processing Artifact that is designed to execute an arbitrary set of arithmetic or logical operations automatically."@en .

<https://www.commoncoreontologies.org/ont00000421> a owl:Class ;
    rdfs:label "Nuclear Power Plant"@en ;
    rdfs:subClassOf <https://www.commoncoreontologies.org/ont00000330> ;
    skos:definition "A Thermal Power Plant that is designed to produce heat by means of a nuclear reactor, which is then converted to electrical energy."@en .

<https://www.commoncoreontologies.org/ont00000423> a owl:Class ;
    rdfs:label "Motor Vehicle Manufacturing Facility"@en ;
    rdfs:subClassOf <https://www.commoncoreontologies.org/ont00000782> ;
    skos:definition "A Factory that is designed to manufacture automobiles."@en .

<https://www.commoncoreontologies.org/ont00000424> a owl:Class ;
    rdfs:label "Sharp"@en ;
    rdfs:subClassOf <https://www.commoncoreontologies.org/ont00001059> ;
    skos:definition "A Shape Quality inhering in a bearer in virtue of the bearer having a fine point or thin edge."@en .

<https://www.commoncoreontologies.org/ont00000425> a owl:Class ;
    rdfs:label "Gregorian Year"@en ;
    rdfs:subClassOf <https://www.commoncoreontologies.org/ont00000674> ;
    skos:definition "A Calendar Year in the Gregorian Calendar."@en .

<https://www.commoncoreontologies.org/ont00000428> a owl:Class ;
    rdfs:label "Railway Junction"@en ;
    rdfs:subClassOf <https://www.commoncoreontologies.org/ont00001326> ;
    skos:definition "A Land Transportation Artifact that is designed to enable a Train to switch between the tracks of two routes."@en .

<https://www.commoncoreontologies.org/ont00000430> a owl:Class ;
    rdfs:label "Stable Orientation"@en ;
    rdfs:subClassOf <https://www.commoncoreontologies.org/ont00000850> ;
    skos:definition "A Stasis of Quality that holds during a Temporal Interval when an object maintains the same Spatial Orientation."@en .

<https://www.commoncoreontologies.org/ont00000432> a owl:Class ;
    rdfs:label "Missile Launch Site"@en ;
    rdfs:subClassOf <https://www.commoncoreontologies.org/ont00001052> ;
    skos:definition "A Military Facility that is designed for storing and launching missiles."@en .

<https://www.commoncoreontologies.org/ont00000434> a owl:Class ;
    rdfs:label "Simple Optical Lens"@en ;
    rdfs:subClassOf <https://www.commoncoreontologies.org/ont00001207> ;
    skos:definition "An Optical Lens consisting of a single piece of transparent material."@en .

<https://www.commoncoreontologies.org/ont00000435> a owl:Class ;
    rdfs:label "Gregorian Day"@en ;
    rdfs:subClassOf <https://www.commoncoreontologies.org/ont00000921> ;
    skos:definition "A Calendar Day in the Gregorian Calendar."@en .

<https://www.commoncoreontologies.org/ont00000436> a owl:Class ;
    rdfs:label "X-ray Microscope"@en ;
    rdfs:subClassOf <https://www.commoncoreontologies.org/ont00000304> ;
    skos:definition "A Microscope that is designed to use Electromagnetic Radiation in the soft X-ray band to produce a significantly enlarged image of the Object."@en .

<https://www.commoncoreontologies.org/ont00000438> a owl:Class ;
    rdfs:label "Act of Official Documentation"@en ;
    rdfs:subClassOf <https://www.commoncoreontologies.org/ont00001374> ;
    skos:definition "An Act of Declarative Communication in which an Agent records some information for official use by another Agent."@en .

<https://www.commoncoreontologies.org/ont00000439> a owl:Class ;
    rdfs:label "Black"@en ;
    rdfs:subClassOf <https://www.commoncoreontologies.org/ont00000378> ;
    skos:definition "A Color that lacks any hues as parts."@en .

<https://www.commoncoreontologies.org/ont00000440> a owl:Class ;
    rdfs:label "Watercraft"@en ;
    rdfs:subClassOf <https://www.commoncoreontologies.org/ont00000713> ;
    skos:definition "A Vehicle that is designed to convey passengers, cargo, or equipment from one location to another by water travel."@en .

<https://www.commoncoreontologies.org/ont00000441> a owl:Class ;
    rdfs:label "Temperature"@en ;
    rdfs:subClassOf <http://purl.obolibrary.org/obo/BFO_0000019> ;
    skos:definition "A Quality that inheres in a bearer in virtue of its thermal energy."@en .

<https://www.commoncoreontologies.org/ont00000442> a owl:Class ;
    rdfs:label "Radioactive"@en ;
    rdfs:subClassOf <http://purl.obolibrary.org/obo/BFO_0000019> ;
    skos:definition "A Quality that inheres in a bearer in virtue of that bearer exhibiting or being caused by radioactivity."@en .

<https://www.commoncoreontologies.org/ont00000443> a owl:Class ;
    rdfs:label "Commercial Organization"@en ;
    rdfs:subClassOf <https://www.commoncoreontologies.org/ont00001180> ;
    skos:definition "An Organization that is the bearer of a Commercial Role and whose primary objective is to make a profit from the provision of goods or services."@en .

<https://www.commoncoreontologies.org/ont00000444> a owl:Class ;
    rdfs:label "Measurement Unit of Energy"@en ;
    rdfs:subClassOf <https://www.commoncoreontologies.org/ont00000120> ;
    skos:definition "A Measurement Unit that is used as a standard for measurement of the Amount of work that is available in an object."@en .

<https://www.commoncoreontologies.org/ont00000446> a owl:Class ;
    rdfs:label "Circumference"@en ;
    rdfs:subClassOf <https://www.commoncoreontologies.org/ont00001293> ;
    skos:definition "A Perimeter that inheres in a circle or ellipse."@en .

<https://www.commoncoreontologies.org/ont00000447> a owl:Class ;
    rdfs:label "Triangular"@en ;
    rdfs:subClassOf <https://www.commoncoreontologies.org/ont00001059> ;
    skos:definition "A Shape Quality inhering in a bearer in virtue of it having exactly three angles and exactly three sides."@en .

<https://www.commoncoreontologies.org/ont00000449> a owl:Class ;
    rdfs:label "Act of Remuneration"@en ;
    rdfs:subClassOf <https://www.commoncoreontologies.org/ont00001334> ;
    skos:definition "An Act of Purchasing wherein a Financial Instrument is used by an Agent (the Employer) to compensate another Agent (the Employee) for the services they perform for the Employer."@en .

<https://www.commoncoreontologies.org/ont00000450> a owl:Class ;
    rdfs:label "Silver Color"@en ;
    rdfs:subClassOf <https://www.commoncoreontologies.org/ont00000378> ;
    skos:definition "A Color that resembles Grey with the added feature of having a metallic shine."@en .

<https://www.commoncoreontologies.org/ont00000451> a owl:Class ;
    rdfs:label "Collimation Artifact Function"@en ;
    rdfs:subClassOf <https://www.commoncoreontologies.org/ont00000323> ;
    skos:definition "An Artifact Function that is realized by a Material Artifact participating in a collimation event in which the Material Artifact narrows a beam of particles or waves by either causing the spatial cross-section of the beam to become smaller or by causing the directions of motion of the beam's constituents to be aligned in a specifc direction of Motion."@en .

<https://www.commoncoreontologies.org/ont00000452> a owl:Class ;
    rdfs:label "Timekeeping Artifact Function"@en ;
    rdfs:subClassOf <https://www.commoncoreontologies.org/ont00000323> ;
    skos:definition "An Artifact Function that is realized during events in which a Material Artifact is used to keep track of and report the current time."@en .

<https://www.commoncoreontologies.org/ont00000454> a owl:Class ;
    rdfs:label "Compression Ignition System"@en ;
    rdfs:subClassOf <https://www.commoncoreontologies.org/ont00000742> ;
    skos:definition "An Ignition System that is designed to generate heat by compressing a portion of fuel and oxidizer mixture in order to initiate an Ignition process."@en .

<https://www.commoncoreontologies.org/ont00000456> a owl:Class ;
    rdfs:label "Railway"@en ;
    rdfs:subClassOf <https://www.commoncoreontologies.org/ont00001326> ;
    skos:definition "A Land Transportation Artifact that is designed to enable Trains to transport passengers and goods."@en .

<https://www.commoncoreontologies.org/ont00000458> a owl:Class ;
    rdfs:label "Coupling"@en ;
    rdfs:subClassOf <https://www.commoncoreontologies.org/ont00000995> ;
    skos:definition "A Material Artifact that is designed to connect two Shafts together at their ends for the purpose of transmitting power."@en .

<https://www.commoncoreontologies.org/ont00000459> a owl:Class ;
    rdfs:label "Fluorescence"@en ;
    rdfs:subClassOf <https://www.commoncoreontologies.org/ont00001126> ;
    skos:definition "A Luminescent Property that inheres in a bearer in virtue of that bearer's capacity to emit visible light while absorbing shorter wavelength radiation, but not after."@en .

<https://www.commoncoreontologies.org/ont00000462> a owl:Class ;
    rdfs:label "Gain of Function"@en ;
    rdfs:subClassOf <https://www.commoncoreontologies.org/ont00000609> ;
    skos:definition "A Gain of Disposition in which some Independent Continuant becomes the bearer of some Function."@en .

<https://www.commoncoreontologies.org/ont00000463> a owl:Class ;
    rdfs:label "Act of Educational Training Instruction"@en ;
    rdfs:subClassOf <https://www.commoncoreontologies.org/ont00001075> ;
    skos:definition "An Act of Training Instruction performed by an Agent who realizes a capacity derived from the Agent's affiliation with some Educational Organization by imparting knowledge of a curriculum to an Agent either directly or indirectly through some communication medium."@en .

<https://www.commoncoreontologies.org/ont00000464> a owl:Class ;
    rdfs:label "Oblong"@en ;
    rdfs:subClassOf <https://www.commoncoreontologies.org/ont00001059> ;
    skos:definition "A Shape Quality inhering in a bearer in virtue of the bearer having an long thin shape with approximately parallel sides."@en .

<https://www.commoncoreontologies.org/ont00000465> a owl:Class ;
    rdfs:label "Modified Julian Date"@en ;
    rdfs:subClassOf <https://www.commoncoreontologies.org/ont00000223> ;
    skos:definition "A Time of Day as specified according to the Julian Calendar using the Modified Julian Date epoch."@en .

<https://www.commoncoreontologies.org/ont00000466> a owl:Class ;
    rdfs:label "Orientation Control Artifact Function"@en ;
    rdfs:subClassOf <https://www.commoncoreontologies.org/ont00000323> ;
    skos:definition "An Artifact Function that is realized by processes in which some Material Artifact is used to control the Orientation of some object."@en .

<https://www.commoncoreontologies.org/ont00000467> a owl:Class ;
    rdfs:label "Armored Personnel Carrier"@en ;
    rdfs:subClassOf <https://www.commoncoreontologies.org/ont00000427> ;
    skos:definition "An Armored Fighting Vehicle that is designed to transport infantry to the battlefield but which are not usually designed to take part in a direct-fire battle."@en .

<https://www.commoncoreontologies.org/ont00000468> a owl:Class ;
    rdfs:label "Office Building"@en ;
    rdfs:subClassOf <https://www.commoncoreontologies.org/ont00001102> ;
    skos:definition "A Commercial Facility that is designed as an environment for conducting commercial, professional, or bureaucratic work."@en .

<https://www.commoncoreontologies.org/ont00000470> a owl:Class ;
    rdfs:label "Material Copy of a Academic Degree"@en ;
    rdfs:subClassOf <https://www.commoncoreontologies.org/ont00000189> ;
    skos:definition "A Material Copy of a Certificate that is issued by an Educational Organization to a Person to indicate that the Person has satisfactorily completed a course of study, or as an honorary recognition of the Person's achievement."@en .

<https://www.commoncoreontologies.org/ont00000471> a owl:Class ;
    rdfs:label "Material Copy of a Warning Message"@en ;
    rdfs:subClassOf <https://www.commoncoreontologies.org/ont00001046> ;
    skos:definition "A Material Copy of a Notification Message that is designed to carry an Information Content Entity that describes a possible or impending threat."@en .

<https://www.commoncoreontologies.org/ont00000473> a owl:Class ;
    rdfs:label "Fourth-Order Administrative Region"@en ;
    rdfs:subClassOf <https://www.commoncoreontologies.org/ont00001152> ;
    skos:definition "A Government Domain that is a subdivision of a Third-Order Administrative Region."@en .

<https://www.commoncoreontologies.org/ont00000474> a owl:Class ;
    rdfs:label "Curved"@en ;
    rdfs:subClassOf <https://www.commoncoreontologies.org/ont00001059> ;
    skos:definition "A Shape Quality inhering in a bearer in virtue of the bearer having borders which are smoothly rounded."@en .

<https://www.commoncoreontologies.org/ont00000476> a owl:Class ;
    rdfs:label "Objective"@en ;
    rdfs:subClassOf <https://www.commoncoreontologies.org/ont00000965> ;
    skos:definition "A Prescriptive Information Content Entity that prescribes some projected state that some Agent intends to achieve."@en .

<https://www.commoncoreontologies.org/ont00000477> a owl:Class ;
    rdfs:label "Fuel Cell"@en ;
    rdfs:subClassOf <https://www.commoncoreontologies.org/ont00001049> ;
    skos:definition "An Electrical Power Source that consists in part of an anode, a cathode, and an electrolyte; converts chemical energy from a fuel into electricity through a chemical reaction of positively charged hydrogen ions with an oxidizing agent (typically oxygen); and, if given a continuous source of fuel and oxidizing agent, can continuously produce electricity."@en .

<https://www.commoncoreontologies.org/ont00000480> a owl:Class ;
    rdfs:label "Life Support Artifact Function"@en ;
    rdfs:subClassOf <https://www.commoncoreontologies.org/ont00000323> ;
    skos:definition "An Artifact Function that is realized during events in which a Material Artifact materially affects an organism, where this causes that organism to continue living in a situation where death would otherwise occur."@en .

<https://www.commoncoreontologies.org/ont00000481> a owl:Class ;
    rdfs:label "Research and Development Artifact Function"@en ;
    rdfs:subClassOf <https://www.commoncoreontologies.org/ont00001301> ;
    skos:definition "A Service Artifact Function that is realized in processes of producing new knowledge or of devising new applications of existing knowledge."@en .

<https://www.commoncoreontologies.org/ont00000482> a owl:Class ;
    rdfs:label "Synthetic Aperture Radar Imaging Artifact Function"@en ;
    rdfs:subClassOf <https://www.commoncoreontologies.org/ont00000289> ;
    skos:definition "A Radar Imaging Artifact Function that inheres in Material Artifacts that are designed to produce visual representations of entities using the motion of a radar antenna over a targeted region to create a synthetic aperture."@en .

<https://www.commoncoreontologies.org/ont00000484> a owl:Class ;
    rdfs:label "Concave Shape"@en ;
    rdfs:subClassOf <https://www.commoncoreontologies.org/ont00001059> ;
    skos:definition "A Shape Quality that inheres in a bearer in virtue of the bearer having one or more cavities, such that at least one line connecting a pair of points on the surface of the bearer will lie outside."@en .

<https://www.commoncoreontologies.org/ont00000485> a owl:Class ;
    rdfs:label "Commercial Role"@en ;
    rdfs:subClassOf <http://purl.obolibrary.org/obo/BFO_0000023> ;
    skos:definition "A Role that inheres in an Organization by virtue of its establishment as a for-profit business."@en .

<https://www.commoncoreontologies.org/ont00000486> a owl:Class ;
    rdfs:label "Neutral Role"@en ;
    rdfs:subClassOf <https://www.commoncoreontologies.org/ont00000392> ;
    skos:definition "An Allegiance Role that inheres in an Agent by virtue of that Agent not performing or being committed to performing Acts that have as their Objective to either support or undermine the Objectives of an Agent or Group of Agents involved in some conflict."@en .

<https://www.commoncoreontologies.org/ont00000488> a owl:Class ;
    rdfs:label "Tripod"@en ;
    rdfs:subClassOf <https://www.commoncoreontologies.org/ont00000995> ;
    skos:definition "A Material Artifact that consists of three legs and a platform that joins them and which is designed to support the weight and maintain the stability of objects that are attached to or rested on the platform."@en .

<https://www.commoncoreontologies.org/ont00000489> a owl:Class ;
    rdfs:label "High Density Residential Area"@en ;
    rdfs:subClassOf <https://www.commoncoreontologies.org/ont00000224> ;
    skos:definition "A Populated Place which is characterized by densely contained multiple-unit living structures."@en .

<https://www.commoncoreontologies.org/ont00000491> a owl:Class ;
    rdfs:label "Detonating Artifact Function"@en ;
    rdfs:subClassOf <https://www.commoncoreontologies.org/ont00000323> ;
    skos:definition "An Artifact Function that is realized in processes of combustion involving a supersonic exothermic front accelerating through a medium that eventually drives a shock front propagating directly in front of it."@en .

<https://www.commoncoreontologies.org/ont00000492> a owl:Class ;
    rdfs:label "Email Messaging"@en ;
    rdfs:subClassOf <https://www.commoncoreontologies.org/ont00000517> ;
    skos:definition "An Act of Communication by Media in which text-based communication occurs between two or more people using personal computers or other devices using some Email Client Software conveyed over the Internet."@en .

<https://www.commoncoreontologies.org/ont00000493> a owl:Class ;
    rdfs:label "Material Copy of a Code List"@en ;
    rdfs:subClassOf <https://www.commoncoreontologies.org/ont00000799> ;
    skos:definition "A Material Copy of a List that contains an ordered sequence of Information Bearing Entities that carry Code Identifiers."@en .

<https://www.commoncoreontologies.org/ont00000494> a owl:Class ;
    rdfs:label "Serrated"@en ;
    rdfs:subClassOf <https://www.commoncoreontologies.org/ont00001059> ;
    skos:definition "A Shape Quality inhering in a bearer in virtue of the bearer having multiple sharp points along a edge."@en .

<https://www.commoncoreontologies.org/ont00000495> a owl:Class ;
    rdfs:label "Radio Communication Interference Artifact Function"@en ;
    rdfs:subClassOf <https://www.commoncoreontologies.org/ont00000273> ;
    skos:definition "A Communication Interference Artifact Function that is realized during events in which a Material Artifact is used to interfere with the transmission of information via radio waves."@en .

<https://www.commoncoreontologies.org/ont00000497> a owl:Class ;
    rdfs:label "Measurement Unit of Force"@en ;
    rdfs:subClassOf <https://www.commoncoreontologies.org/ont00000120> ;
    skos:definition "A Measurement Unit that is used as a standard for measurement of interactions in which the Motion or Velocity of an object is changed, unless the interaction is opposed."@en .

<https://www.commoncoreontologies.org/ont00000498> a owl:Class ;
    rdfs:label "Julian Day"@en ;
    rdfs:subClassOf <https://www.commoncoreontologies.org/ont00000921> ;
    skos:definition "A Calendar Day in the Julian Calendar."@en .

<https://www.commoncoreontologies.org/ont00000500> a owl:Class ;
    rdfs:label "Eye"@en ;
    rdfs:subClassOf <https://www.commoncoreontologies.org/ont00000084> ;
    skos:definition "A Bodily Component that consists of an organ that canonically affords the Agent it is part of with the ability to receive visual stimuli necessary for sight."@en .

<https://www.commoncoreontologies.org/ont00000501> a owl:Class ;
    rdfs:label "Act of Financial Withdrawal"@en ;
    rdfs:subClassOf <https://www.commoncoreontologies.org/ont00000836> ;
    skos:definition "An Act of Financial Instrument Use wherein a Financial Instrument is transferred by an Agent to another Agent (the Depositor) from an account created by an earlier Act of Financial Deposit performed by the Depositor."@en .

<https://www.commoncoreontologies.org/ont00000502> a owl:Class ;
    rdfs:label "Measurement Unit of Area Moment of Inertia"@en ;
    rdfs:subClassOf <https://www.commoncoreontologies.org/ont00000120> ;
    skos:definition "A Measurement Unit that is used as a standard for measurement of the distribution of Mass of an object with respect to an axis."@en .

<https://www.commoncoreontologies.org/ont00000506> a owl:Class ;
    rdfs:label "Contractor Role"@en ;
    rdfs:subClassOf <http://purl.obolibrary.org/obo/BFO_0000023> ;
    skos:definition "A Role that inheres in an Agent or Group of Agents by virtue of that Agent or Group of Agents entering into a Contract to provide materials or labor to perform a service or complete a task."@en .

<https://www.commoncoreontologies.org/ont00000507> a owl:Class ;
    rdfs:label "Ethnic Group"@en ;
    rdfs:subClassOf <https://www.commoncoreontologies.org/ont00000914> ;
    skos:definition "A Group of Persons who identify with one another based on one or more shared inherited characteristics such as language, ancestry, nationality, culture, customs, religion, or social experiences."@en .

<https://www.commoncoreontologies.org/ont00000508> a owl:Class ;
    rdfs:label "Near Ultraviolet Light Frequency"@en ;
    rdfs:subClassOf <https://www.commoncoreontologies.org/ont00000610> ;
    skos:definition "An Ultraviolet Light Frequency that is between 750 terahertz and 3 petahertz."@en .

<https://www.commoncoreontologies.org/ont00000509> a owl:Class ;
    rdfs:label "Service Provider"@en ;
    rdfs:subClassOf <https://www.commoncoreontologies.org/ont00001180> ;
    skos:definition "An Organization whose purpose is to provide a service to other Agents."@en .

<https://www.commoncoreontologies.org/ont00000510> a owl:Class ;
    rdfs:label "Mosque"@en ;
    rdfs:subClassOf <https://www.commoncoreontologies.org/ont00000052> ;
    skos:definition "A Religious Facility that is designed for Islamic worship and prayer."@en .

<https://www.commoncoreontologies.org/ont00000511> a owl:Class ;
    rdfs:label "Act of Planning"@en ;
    rdfs:subClassOf <https://www.commoncoreontologies.org/ont00000228> ;
    skos:definition "A Planned Act that involves making a Plan to achieve some specified Objective."@en .

<https://www.commoncoreontologies.org/ont00000512> a owl:Class ;
    rdfs:label "Radiation Emissivity"@en ;
    rdfs:subClassOf <https://www.commoncoreontologies.org/ont00000628> ;
    skos:definition "A Disposition to Interact with Electromagnetic Radiation that inheres in a bearer in virtue of the capacity of that bearer to emit electromagnetic radiation of a given frequency."@en .

<https://www.commoncoreontologies.org/ont00000513> a owl:Class ;
    rdfs:label "Act of Tool Use"@en ;
    rdfs:subClassOf <https://www.commoncoreontologies.org/ont00000566> ;
    skos:definition "An Act of Artifact Employment in which some Agent uses some Tool."@en .

<https://www.commoncoreontologies.org/ont00000514> a owl:Class ;
    rdfs:label "Transverse Wave Profile"@en ;
    rdfs:subClassOf <https://www.commoncoreontologies.org/ont00000752> ;
    skos:definition "A Wave Process Profile in which the displacement of participating particles is perpendicular to the direction of the Wave Process' propogation."@en .

<https://www.commoncoreontologies.org/ont00000515> a owl:Class ;
    rdfs:label "Act of Vehicle Use"@en ;
    rdfs:subClassOf <https://www.commoncoreontologies.org/ont00000566> ;
    skos:definition "An Act of Artifact Employment in which some Agent uses some Vehicle."@en .

<https://www.commoncoreontologies.org/ont00000516> a owl:Class ;
    rdfs:label "Pneumatic Power Source"@en ;
    rdfs:subClassOf <https://www.commoncoreontologies.org/ont00000288> ;
    skos:definition "A Power Source that is designed to generate, control, or transmit power by means of compressed air or compressed inert gases."@en .

<https://www.commoncoreontologies.org/ont00000518> a owl:Class ;
    rdfs:label "Measurement Unit of Currency"@en ;
    rdfs:subClassOf <https://www.commoncoreontologies.org/ont00000120> ;
    skos:definition "A Measurement Unit used in measurements of financial values."@en .

<https://www.commoncoreontologies.org/ont00000519> a owl:Class ;
    rdfs:label "Extremely High Frequency"@en ;
    rdfs:subClassOf <https://www.commoncoreontologies.org/ont00000732> ;
    skos:definition "A Microwave Frequency that is between 30 and 300 GHz."@en .

<https://www.commoncoreontologies.org/ont00000520> a owl:Class ;
    rdfs:label "Act of Departure"@en ;
    rdfs:subClassOf <https://www.commoncoreontologies.org/ont00000065> ;
    skos:definition "An Act of Location Change that consists of the participating entity leaving its starting location such that the larger Act of Location Change is initiated."@en .

<https://www.commoncoreontologies.org/ont00000521> a owl:Class ;
    rdfs:label "Act of Assassination"@en ;
    rdfs:subClassOf <https://www.commoncoreontologies.org/ont00001272> ;
    skos:definition "An Act of Murder of a prominent person."@en .

<https://www.commoncoreontologies.org/ont00000522> a owl:Class ;
    rdfs:label "Pulsejet Engine"@en ;
    rdfs:subClassOf <https://www.commoncoreontologies.org/ont00000294> ;
    skos:definition "An Air-Breathing Jet Engine that is capable of operating statically and uses intermittent (pulsing) Combustion of the fuel-oxidizer mixture before expelling the exhaust out through the rear Propelling Nozzle to generate Thrust."@en .

<https://www.commoncoreontologies.org/ont00000523> a owl:Class ;
    rdfs:label "Loudness"@en ;
    rdfs:subClassOf <https://www.commoncoreontologies.org/ont00000862> ;
    skos:definition "A Sound Process Profile that is characterized by the amplitude and total energy of translated sound waves, typically on a continuum from soft to loud."@en .

<https://www.commoncoreontologies.org/ont00000524> a owl:Class ;
    rdfs:label "Air Conditioning Unit"@en ;
    rdfs:subClassOf <https://www.commoncoreontologies.org/ont00000350> ;
    skos:definition "A Cooling System that is designed to remove excess heat and humidity from the air in an enclosed space."@en .

<https://www.commoncoreontologies.org/ont00000525> a owl:Class ;
    rdfs:label "Transparent"@en ;
    rdfs:subClassOf <https://www.commoncoreontologies.org/ont00001384> ;
    skos:definition "An Opacity that inheres in a bearer in virtue of that bearer's capacity to transmit all or nearly all electromagnetic radiation of a given frequency through the bearer such that the bearer reflects, scatters, or absorbs little or no electromagnetic radiation of that frequency."@en .

<https://www.commoncoreontologies.org/ont00000526> a owl:Class ;
    rdfs:label "Gamma-ray Telescope"@en ;
    rdfs:subClassOf <https://www.commoncoreontologies.org/ont00000547> ;
    skos:definition "A Telescope that is designed to aid in the observation of spatially distant Objects by means of collecting and focusing Gamma-rays to form an enhanced image of the Object."@en .

<https://www.commoncoreontologies.org/ont00000527> a owl:Class ;
    rdfs:label "Measurement Unit of Rotational Inertia"@en ;
    rdfs:subClassOf <https://www.commoncoreontologies.org/ont00000120> ;
    skos:definition "A Measurement Unit that is used as a standard for measurement of the distribution of Mass of an object with respect to its axis of rotation."@en .

<https://www.commoncoreontologies.org/ont00000528> a owl:Class ;
    rdfs:label "White"@en ;
    rdfs:subClassOf <https://www.commoncoreontologies.org/ont00000378> ;
    skos:definition "A Color of maximum brightness, the color of objects that reflect nearly all wavelengths of the visible light spectrum, thus considered achromatic."@en .

<https://www.commoncoreontologies.org/ont00000532> a owl:Class ;
    rdfs:label "Government of a Country"@en ;
    rdfs:subClassOf <https://www.commoncoreontologies.org/ont00001335> ;
    skos:definition "A Government that has legitimate authority within and is delimited by a Domain of a Country."@en .

<https://www.commoncoreontologies.org/ont00000534> a owl:Class ;
    rdfs:label "Cutting Artifact Function"@en ;
    rdfs:subClassOf <https://www.commoncoreontologies.org/ont00001153> ;
    skos:definition "A Damaging Artifact Function that is realized in a process in which the structural integrity of an entity is impaired by being opened or divided."@en .

<https://www.commoncoreontologies.org/ont00000535> a owl:Class ;
    rdfs:label "Decrease of Quality"@en ;
    rdfs:subClassOf <https://www.commoncoreontologies.org/ont00000290> ;
    skos:definition "A Decrease of Specifically Dependent Continuant in which some Independent Continuant has a decrease of some Quality that it bears."@en .

<https://www.commoncoreontologies.org/ont00000536> a owl:Class ;
    rdfs:label "Bond Certificate"@en ;
    rdfs:subClassOf <https://www.commoncoreontologies.org/ont00001159> ;
    skos:definition "A Bond that consists of a Certificate."@en .

<https://www.commoncoreontologies.org/ont00000538> a owl:Class ;
    rdfs:label "Defoliant Artifact Function"@en ;
    rdfs:subClassOf <https://www.commoncoreontologies.org/ont00000831> ;
    skos:definition "An Herbicide Artifact Function that is realized in a process that causes a plant to lose its leaves."@en .

<https://www.commoncoreontologies.org/ont00000539> a owl:Class ;
    rdfs:label "Count Measurement Information Content Entity"@en ;
    rdfs:subClassOf <https://www.commoncoreontologies.org/ont00001022> ;
    skos:definition "A Ratio Measurement Information Content Entity that is a measurement of the number of members of some aggregate."@en .

<https://www.commoncoreontologies.org/ont00000541> a owl:Class ;
    rdfs:label "Diameter"@en ;
    rdfs:subClassOf <https://www.commoncoreontologies.org/ont00001367> ;
    skos:definition "A One Dimensional Extent that inheres in a circle in virtue of the extent of a straight line that passes through the center of the circle and starts and ends on the circle's boundary."@en .

<https://www.commoncoreontologies.org/ont00000542> a owl:Class ;
    rdfs:label "Loss of Generically Dependent Continuant"@en ;
    rdfs:subClassOf <https://www.commoncoreontologies.org/ont00000876> ;
    skos:definition "A Loss of Dependent Continuant in which some Independent Continuant ceases to be the carrier of some Generically Dependent Continuant."@en .

<https://www.commoncoreontologies.org/ont00000544> a owl:Class ;
    rdfs:label "Target"@en ;
    rdfs:subClassOf <http://purl.obolibrary.org/obo/BFO_0000040> ;
    skos:definition "A Material Entity that is the object of an Act of Targeting."@en .

<https://www.commoncoreontologies.org/ont00000545> a owl:Class ;
    rdfs:label "Seat of Local Government"@en ;
    rdfs:subClassOf <https://www.commoncoreontologies.org/ont00000946> ;
    skos:definition "A Government Building that is designed for the administration of a local community."@en .

<https://www.commoncoreontologies.org/ont00000546> a owl:Class ;
    rdfs:label "Unplanned Act"@en ;
    rdfs:subClassOf <https://www.commoncoreontologies.org/ont00000005> ;
    skos:definition "An Act in which at least one Agent plays a causative role and which is not prescribed by some Objective held by any of the Agents."@en .

<https://www.commoncoreontologies.org/ont00000548> a owl:Class ;
    rdfs:label "Vulnerability"@en ;
    rdfs:subClassOf <https://www.commoncoreontologies.org/ont00000997> ;
    skos:definition "A Disrupting Disposition the realization of which would disrupt a process that the bearer of the Disrupting Disposition has an interest in."@en .

<https://www.commoncoreontologies.org/ont00000550> a owl:Class ;
    rdfs:label "Morning"@en ;
    rdfs:subClassOf <http://purl.obolibrary.org/obo/BFO_0000202> ;
    skos:definition "A Temporal Interval that consists of the temporal regions between when the sun dawns (approximately 6:00am) and reaches its apex (approximately 12:00pm)."@en .

<https://www.commoncoreontologies.org/ont00000553> a owl:Class ;
    rdfs:label "Process Prohibition"@en ;
    rdfs:subClassOf <https://www.commoncoreontologies.org/ont00001324> ;
    skos:definition "A Process Regulation that prohibits some Process."@en .

<https://www.commoncoreontologies.org/ont00000555> a owl:Class ;
    rdfs:label "Enhanced Stasis"@en ;
    rdfs:subClassOf <https://www.commoncoreontologies.org/ont00000135> ;
    skos:definition "A Stasis of Specifically Dependent Continuant in which some Independent Continuant bears a Quality or Realizable Entity that has undergone improvement (i.e., an increase or gain) due to a previous action or event such that the Independent Continuant is now of greater value, usefulness, or functionality."@en .

<https://www.commoncoreontologies.org/ont00000556> a owl:Class ;
    rdfs:label "Payload"@en ;
    rdfs:subClassOf <http://purl.obolibrary.org/obo/BFO_0000040> ;
    skos:definition "A Material Entity that is transported by a Vehicle during an Act of Location Change for the purpose of being delivered to or performing one or more functions at a predefined location."@en .

<https://www.commoncoreontologies.org/ont00000558> a owl:Class ;
    rdfs:label "Visible Light Reflection Process"@en ;
    rdfs:subClassOf <https://www.commoncoreontologies.org/ont00000099> ;
    skos:definition "A Wave Process in which an Electromagnetic Wave with a Visible Light Frequency is reflected off a portion of matter."@en .

<https://www.commoncoreontologies.org/ont00000560> a owl:Class ;
    rdfs:label "Cone Shape"@en ;
    rdfs:subClassOf <https://www.commoncoreontologies.org/ont00001360> ;
    skos:definition "A Three Dimensional Shape that inheres in a bearer in virtue of it having a Round base that tapers smoothly to an apex."@en .

<https://www.commoncoreontologies.org/ont00000561> a owl:Class ;
    rdfs:label "Dam"@en ;
    rdfs:subClassOf <https://www.commoncoreontologies.org/ont00000995> ;
    skos:definition "A Material Artifact that is designed to impound surface water or underground streams."@en .

<https://www.commoncoreontologies.org/ont00000563> a owl:Class ;
    rdfs:label "Hydrographic Feature"@en ;
    rdfs:subClassOf <https://www.commoncoreontologies.org/ont00001081> ;
    skos:definition "A Geographic Feature associated with water."@en .

<https://www.commoncoreontologies.org/ont00000564> a owl:Class ;
    rdfs:label "Educational Organization"@en ;
    rdfs:subClassOf <https://www.commoncoreontologies.org/ont00001180> ;
    skos:definition "An Organization whose primary purpose is to provide training or otherwise facilitate learning or the acquisition of knowledge, Skills, values, beliefs, or habits."@en .

<https://www.commoncoreontologies.org/ont00000565> a owl:Class ;
    rdfs:label "Cube Shape"@en ;
    rdfs:subClassOf <https://www.commoncoreontologies.org/ont00000478> ;
    skos:definition "A Cuboidal shape inhering in a bearer in virtue of it having six Square faces."@en .

<https://www.commoncoreontologies.org/ont00000567> a owl:Class ;
    rdfs:label "Operational Area"@en ;
    rdfs:subClassOf <https://www.commoncoreontologies.org/ont00000487> ;
    skos:definition "A Geospatial Location in which an Agent conducts some activity."@en .

<https://www.commoncoreontologies.org/ont00000568> a owl:Class ;
    rdfs:label "Organization Capability"@en ;
    rdfs:subClassOf <https://www.commoncoreontologies.org/ont00001379> ;
    skos:definition "An Agent Capability that inheres in an Organization to the extent of that Organization's capacity to realize it in Intentional Acts of a certain type."@en .

<https://www.commoncoreontologies.org/ont00000569> a owl:Class ;
    rdfs:label "Sensor"@en ;
    rdfs:subClassOf <http://purl.obolibrary.org/obo/BFO_0000040> ;
    skos:definition "A Material Entity that bears a Sensor Function or Sensor Role."@en .

<https://www.commoncoreontologies.org/ont00000571> a owl:Class ;
    rdfs:label "Article of Solid Waste"@en ;
    rdfs:subClassOf <https://www.commoncoreontologies.org/ont00000980> ;
    skos:definition "A Portion of Waste Material that has a low liquid content."@en .

<https://www.commoncoreontologies.org/ont00000572> a owl:Class ;
    rdfs:label "Sound Production"@en ;
    rdfs:subClassOf <https://www.commoncoreontologies.org/ont00000765> ;
    skos:definition "A Wave Production Process that produces a Sound Wave."@en .

<https://www.commoncoreontologies.org/ont00000573> a owl:Class ;
    rdfs:label "Act of Religious Training Acquisition"@en ;
    rdfs:subClassOf <https://www.commoncoreontologies.org/ont00000687> ;
    skos:definition "An Act of Training Acquisition performed by an Agent by acquiring knowledge of the tenets and/or practices of a religion from an Agent or communication medium that realizes a capacity derived from its affiliation with a Religious Organization."@en .

<https://www.commoncoreontologies.org/ont00000576> a owl:Class ;
    rdfs:label "Scalp"@en ;
    rdfs:subClassOf <https://www.commoncoreontologies.org/ont00000084> ;
    skos:definition "A Bodily Component that consists of the skin covering the top of the head of a human or other animal."@en .

<https://www.commoncoreontologies.org/ont00000577> a owl:Class ;
    rdfs:label "Power Rectifier"@en ;
    rdfs:subClassOf <https://www.commoncoreontologies.org/ont00000995> ;
    skos:definition "A Material Artifact that is designed to convert alternating current (AC) to direct current (DC)."@en .

<https://www.commoncoreontologies.org/ont00000578> a owl:Class ;
    rdfs:label "Sloped"@en ;
    rdfs:subClassOf <https://www.commoncoreontologies.org/ont00001059> ;
    skos:definition "A Shape Quality inhering in a bearer in virtue of the bearer having a horizontal border which is not level."@en .

<https://www.commoncoreontologies.org/ont00000579> a owl:Class ;
    rdfs:label "Thin"@en ;
    rdfs:subClassOf <https://www.commoncoreontologies.org/ont00001059> ;
    skos:definition "A Shape Quality inhering in a bearer in virtue of the bearer having a width or depth which is significantly smaller in proportion to its length or height."@en .

<https://www.commoncoreontologies.org/ont00000580> a owl:Class ;
    rdfs:label "Sine Waveform"@en ;
    rdfs:subClassOf <https://www.commoncoreontologies.org/ont00001286> ;
    skos:definition "A Waveform that is characterized by a smooth curved shape due to the continuous non-linear transitions between minimum and maximum Amplitudes of the Wave Cycle."@en .

<https://www.commoncoreontologies.org/ont00000583> a owl:Class ;
    rdfs:label "Motel"@en ;
    rdfs:subClassOf <https://www.commoncoreontologies.org/ont00000180> ;
    skos:definition "A Hotel that is designed to accommodate motor vehicles along with their occupants."@en .

<https://www.commoncoreontologies.org/ont00000584> a owl:Class ;
    rdfs:label "Act of Position Change"@en ;
    rdfs:subClassOf <https://www.commoncoreontologies.org/ont00000357> ;
    skos:definition "An Act of Motion in which the position (i.e. the orientation, alignment, or arrangement) of some Object or of one or more of an Object's parts is changed by some Agent."@en .

<https://www.commoncoreontologies.org/ont00000585> a owl:Class ;
    rdfs:label "Sawtooth Waveform"@en ;
    rdfs:subClassOf <https://www.commoncoreontologies.org/ont00001286> ;
    skos:definition "A Waveform that is characterized by a sawtooth shape due to the continuous linear transition from minimum to maximum Amplitudes followed by a near-instantaneous transition from the maximum to minimum Amplitudes of the Wave Cycle."@en .

<https://www.commoncoreontologies.org/ont00000586> a owl:Class ;
    rdfs:label "Controllable Pitch Propeller"@en ;
    rdfs:subClassOf <https://www.commoncoreontologies.org/ont00000238> ;
    skos:definition "A Propeller whose blades are designed to be alterable by rotating the blades about their vertical axis by means of mechanical or hydraulic arrangement."@en .

<https://www.commoncoreontologies.org/ont00000587> a owl:Class ;
    rdfs:label "Ally Role"@en ;
    rdfs:subClassOf <https://www.commoncoreontologies.org/ont00000392> ;
    skos:definition "An Allegiance Role that inheres in an Agent in virtue of that Agent's commitment to perform Acts that support the Objectives of a particular Agent or Group of Agents."@en .

<https://www.commoncoreontologies.org/ont00000589> a owl:Class ;
    rdfs:label "Julian Date Fraction"@en ;
    rdfs:subClassOf <https://www.commoncoreontologies.org/ont00000973> ;
    skos:definition "A Decimal Time of Day Identifier that designates an approximate Temporal Instant that is part of some Julian Day."@en .

<https://www.commoncoreontologies.org/ont00000590> a owl:Class ;
    rdfs:label "Convex Shape"@en ;
    rdfs:subClassOf <https://www.commoncoreontologies.org/ont00001059> ;
    skos:definition "A Shape Quality that inheres in a bearer in virtue of the bearer not having a cavity, such that no line connecting a pair of points on the surface of the bearer will lie outside."@en .

<https://www.commoncoreontologies.org/ont00000591> a owl:Class ;
    rdfs:label "Artifact Location"@en ;
    rdfs:subClassOf <http://purl.obolibrary.org/obo/BFO_0000029> ;
    skos:definition "A Site that is the location of some Material Artifact."@en .

<https://www.commoncoreontologies.org/ont00000592> a owl:Class ;
    rdfs:label "Veracity Measurement Information Content Entity"@en ;
    rdfs:subClassOf <https://www.commoncoreontologies.org/ont00001163> ;
    skos:definition "A Measurement Information Content Entity that is a measurement of the extent to which a description conforms to the reality it describes."@en .

<https://www.commoncoreontologies.org/ont00000594> a owl:Class ;
    rdfs:label "Ignition Process"@en ;
    rdfs:subClassOf <https://www.commoncoreontologies.org/ont00000007> ;
    skos:definition "A Natural Process that initiates a Combustion process."@en .

<https://www.commoncoreontologies.org/ont00000595> a owl:Class ;
    rdfs:label "Act of Cargo Transportation"@en ;
    rdfs:subClassOf <https://www.commoncoreontologies.org/ont00000065> ;
    skos:definition "An Act of Location Change wherein some Payload is moved from one location to another."@en .

<https://www.commoncoreontologies.org/ont00000597> a owl:Class ;
    rdfs:label "Material Copy of a Instrument Display Panel"@en ;
    rdfs:subClassOf <https://www.commoncoreontologies.org/ont00000798> ;
    skos:definition "An Information Bearing Artifact that is designed to carry information about some Material Artifact that is derived by the instrumentation Sensors of that Material Artifact."@en .

<https://www.commoncoreontologies.org/ont00000599> a owl:Class ;
    rdfs:label "Interpersonal Relationship Role"@en ;
    rdfs:subClassOf <http://purl.obolibrary.org/obo/BFO_0000023> ;
    skos:definition "A Role that inheres in a Person in virtue of the obligations, expectations, or social norms that govern that Person's Intentional Acts within the context of a relationship with another Person."@en .

<https://www.commoncoreontologies.org/ont00000600> a owl:Class ;
    rdfs:label "Legal Artifact Function"@en ;
    rdfs:subClassOf <https://www.commoncoreontologies.org/ont00001301> ;
    skos:definition "A Service Artifact Function that is realized in processes of giving legal advice to clients drafting legal documents for clients and representing clients in legal negotiations and court proceedings such as lawsuits."@en .

<https://www.commoncoreontologies.org/ont00000603> a owl:Class ;
    rdfs:label "Navigation Artifact Function"@en ;
    rdfs:subClassOf <https://www.commoncoreontologies.org/ont00000323> ;
    skos:definition "An Artifact Function that is realized during events in which a Material Artifact is used to determine the precise location of itself or another object and plan a route to a specified destination."@en .

<https://www.commoncoreontologies.org/ont00000604> a owl:Class ;
    rdfs:label "Maximum Ordinal Measurement Information Content Entity"@en ;
    rdfs:subClassOf <https://www.commoncoreontologies.org/ont00001010> ;
    skos:definition "An Ordinal Measurement Information Content Entity that is a measurement of some entity in virtue of it being the largest or having the greatest amount relative to a nominally described set of like entities."@en .

<https://www.commoncoreontologies.org/ont00000606> a owl:Class ;
    rdfs:label "Truck"@en ;
    rdfs:subClassOf <https://www.commoncoreontologies.org/ont00000053> ;
    skos:definition "A Ground Motor Vehicle that is designed to be used to transport cargo."@en .

<https://www.commoncoreontologies.org/ont00000607> a owl:Class ;
    rdfs:label "Thickness"@en ;
    rdfs:subClassOf <https://www.commoncoreontologies.org/ont00000892> ;
    skos:definition "A Depth that inheres in a bearer in virtue of it extending inward through an object."@en .

<https://www.commoncoreontologies.org/ont00000612> a owl:Class ;
    rdfs:label "Act of Weapon Use"@en ;
    rdfs:subClassOf <https://www.commoncoreontologies.org/ont00000566> ;
    skos:definition "An Act of Artifact Employment in which some Agent uses some Weapon."@en .

<https://www.commoncoreontologies.org/ont00000613> a owl:Class ;
    rdfs:label "Loss of Role"@en ;
    rdfs:subClassOf <https://www.commoncoreontologies.org/ont00000250> ;
    skos:definition "A Loss of Realizable Entity in which some Independent Continuant ceases to be the bearer of some Role."@en .

<https://www.commoncoreontologies.org/ont00000614> a owl:Class ;
    rdfs:label "Mass"@en ;
    rdfs:subClassOf <http://purl.obolibrary.org/obo/BFO_0000019> ;
    skos:definition "A Quality that inheres in a bearer in virtue of the amount of matter in that bearer."@en .

<https://www.commoncoreontologies.org/ont00000615> a owl:Class ;
    rdfs:label "Act of Encounter"@en ;
    rdfs:subClassOf <https://www.commoncoreontologies.org/ont00000433> ;
    skos:definition "An Act of Association wherein two or more Persons meet in a casual or unplanned manner."@en .

<https://www.commoncoreontologies.org/ont00000616> a owl:Class ;
    rdfs:label "Religion"@en ;
    rdfs:subClassOf <https://www.commoncoreontologies.org/ont00000958> ;
    skos:definition "An Information Content Entity that consists of a collection of claims about the meaning or origin of existence or about the existence or nature of one or more deities, an afterlife, or spiritual or sacred entities, and which is accepted as true by an Agent or Group of Agents."@en .

<https://www.commoncoreontologies.org/ont00000617> a owl:Class ;
    rdfs:label "Infrared Camera"@en ;
    rdfs:subClassOf <https://www.commoncoreontologies.org/ont00000199> ;
    skos:definition "A Camera that is designed to form and record an image generated from infrared radiation."@en .

<https://www.commoncoreontologies.org/ont00000621> a owl:Class ;
    rdfs:label "Inverse Sawtooth Waveform"@en ;
    rdfs:subClassOf <https://www.commoncoreontologies.org/ont00001286> ;
    skos:definition "A Waveform that is characterized by a sawtooth shape due to the continuous linear transition from maximum to minimum Amplitudes followed by a near-instantaneous transition from the minimum to maximum Amplitudes of the Wave Cycle."@en .

<https://www.commoncoreontologies.org/ont00000622> a owl:Class ;
    rdfs:label "Stasis of Fully Mission Capable"@en ;
    rdfs:subClassOf <https://www.commoncoreontologies.org/ont00001132> ;
    skos:definition "A Stasis of Mission Capability during which the participating Continuant is capable of performing all of its primary functions for the specified Mission."@en .

<https://www.commoncoreontologies.org/ont00000623> a owl:Class ;
    rdfs:label "Impact Shielding Artifact Function"@en ;
    rdfs:subClassOf <https://www.commoncoreontologies.org/ont00000323> ;
    skos:definition "An Artifact Function that is realized during events in which a Material Artifact reduces the damage caused to the shielded object by an impact with another object."@en .

<https://www.commoncoreontologies.org/ont00000624> a owl:Class ;
    rdfs:label "Material Copy of a Report"@en ;
    rdfs:subClassOf <https://www.commoncoreontologies.org/ont00001298> ;
    skos:definition "A Material Copy of a Document that is designed to carry some specific Information Content Entity that conveys an account of some event, situation, or the result of some observation or inquiry."@en .

<https://www.commoncoreontologies.org/ont00000625> a owl:Class ;
    rdfs:label "Nozzle Throat"@en ;
    rdfs:subClassOf <https://www.commoncoreontologies.org/ont00000256> ;
    skos:definition "A Fluid Control Artifact that consists of the narrowest portion of a Nozzle that is designed to converge the flow of fluid in order to increase the Velocity of the flow."@en .

<https://www.commoncoreontologies.org/ont00000626> a owl:Class ;
    rdfs:label "Predictive Information Content Entity"@en ;
    rdfs:subClassOf <https://www.commoncoreontologies.org/ont00000853> ;
    skos:definition "A Descriptive Information Content Entity that describes an uncertain future event."@en .

<https://www.commoncoreontologies.org/ont00000627> a owl:Class ;
    rdfs:label "Infrastructure Element"@en ;
    rdfs:subClassOf <http://purl.obolibrary.org/obo/BFO_0000040> ;
    skos:definition "A Material Entity that bears an Infrastructure Role."@en .

<https://www.commoncoreontologies.org/ont00000629> a owl:Class ;
    rdfs:label "Deception Artifact Function"@en ;
    rdfs:subClassOf <https://www.commoncoreontologies.org/ont00000323> ;
    skos:definition "An Artifact Function that is realized in processes which misinform or mislead some other entity."@en .

<https://www.commoncoreontologies.org/ont00000630> a owl:Class ;
    rdfs:label "Universal Time Reference System"@en ;
    rdfs:subClassOf <https://www.commoncoreontologies.org/ont00000124> ;
    skos:definition "A Solar Time Reference System that is based on the average speed of the Earth's rotation and which uses the prime meridian at 0° longitude as a reference point."@en .

<https://www.commoncoreontologies.org/ont00000631> a owl:Class ;
    rdfs:label "Material Territory of a Country"@en ;
    rdfs:subClassOf <https://www.commoncoreontologies.org/ont00000662> ;
    skos:definition "The portions of lithosphere, hydrosphere, or atmosphere that together exactly occupy a The Domain of a Country."@en .

<https://www.commoncoreontologies.org/ont00000632> a owl:Class ;
    rdfs:label "Magnetism"@en ;
    rdfs:subClassOf <http://purl.obolibrary.org/obo/BFO_0000016> ;
    skos:definition "A Disposition that is realized when its bearer exerts a magnetic force on another entity."@en .

<https://www.commoncoreontologies.org/ont00000633> a owl:Class ;
    rdfs:label "Weight"@en ;
    rdfs:subClassOf <http://purl.obolibrary.org/obo/BFO_0000019> ;
    skos:definition "A Quality that inheres in some material entity with a mass in virtue of its location in some gravitational field."@en .

<https://www.commoncoreontologies.org/ont00000635> a owl:Class ;
    rdfs:label "Refraction Artifact Function"@en ;
    rdfs:subClassOf <https://www.commoncoreontologies.org/ont00000323> ;
    skos:definition "An Artifact Function that is realized by a Material Artifact participating in a refraction event in which the Material Artifact causes a change in direction of wave propagation due to a change in its transmission medium."@en .

<https://www.commoncoreontologies.org/ont00000636> a owl:Class ;
    rdfs:label "Act of Appraisal"@en ;
    rdfs:subClassOf <https://www.commoncoreontologies.org/ont00000345> ;
    skos:definition "An Act of Measuring that involves evaluating, assessing, estimating, or judging the nature, value, importance, condition, or quality of something or someone."@en .

<https://www.commoncoreontologies.org/ont00000637> a owl:Class ;
    rdfs:label "Portion of Gaseous Propellant"@en ;
    rdfs:subClassOf <https://www.commoncoreontologies.org/ont00000593> ;
    skos:definition "A Portion of Propellant that is stored in a gaseous state."@en .

<https://www.commoncoreontologies.org/ont00000640> a owl:Class ;
    rdfs:label "Material Copy of a Email Message"@en ;
    rdfs:subClassOf <https://www.commoncoreontologies.org/ont00001002> ;
    skos:definition "A Material Copy of a Message that is transmitted to the recipient's Email Box."@en .

<https://www.commoncoreontologies.org/ont00000643> a owl:Class ;
    rdfs:label "Low Frequency"@en ;
    rdfs:subClassOf <https://www.commoncoreontologies.org/ont00000150> ;
    skos:definition "A Radio Frequency that is between 30 and 300 kHz."@en .

<https://www.commoncoreontologies.org/ont00000644> a owl:Class ;
    rdfs:label "Oscillation Process"@en ;
    rdfs:subClassOf <https://www.commoncoreontologies.org/ont00000004> ;
    skos:definition "A Change in which the dependent entity alternates between two or more stases."@en .

<https://www.commoncoreontologies.org/ont00000645> a owl:Class ;
    rdfs:label "Permanent Resident"@en ;
    rdfs:subClassOf <https://www.commoncoreontologies.org/ont00001262> ;
    skos:definition "A person with a Permanent Resident Role."@en .

<https://www.commoncoreontologies.org/ont00000647> a owl:Class ;
    rdfs:label "Organization Member"@en ;
    rdfs:subClassOf <https://www.commoncoreontologies.org/ont00001262> ;
    skos:definition "A Person who is affiliated with some Organization by being a member of that Organization."@en .

<https://www.commoncoreontologies.org/ont00000648> a owl:Class ;
    rdfs:label "Color Brightness"@en ;
    rdfs:subClassOf <https://www.commoncoreontologies.org/ont00000784> ;
    skos:definition "An Optical Property that inheres in a bearer in virtue of its capacity to reflect or radiate light."@en .

<https://www.commoncoreontologies.org/ont00000650> a owl:Class ;
    rdfs:label "Ground Moving Target Indication Artifact Function"@en ;
    rdfs:subClassOf <https://www.commoncoreontologies.org/ont00000214> ;
    skos:definition "A Moving Target Indication Artifact Function that inheres in Material Artifacts that are designed to identify and track entities moving on or near the ground."@en .

<https://www.commoncoreontologies.org/ont00000651> a owl:Class ;
    rdfs:label "Containing Artifact Function"@en ;
    rdfs:subClassOf <https://www.commoncoreontologies.org/ont00000323> ;
    skos:definition "An Artifact Function that is realized in a process in which one entity contains another."@en .

<https://www.commoncoreontologies.org/ont00000652> a owl:Class ;
    rdfs:label "Decoy"@en ;
    rdfs:subClassOf <https://www.commoncoreontologies.org/ont00000995> ;
    skos:definition "A Material Artifact that is designed to distract or conceal what an individual or group might be looking for."@en .

<https://www.commoncoreontologies.org/ont00000653> a owl:Class ;
    rdfs:label "Algorithm"@en ;
    rdfs:subClassOf <https://www.commoncoreontologies.org/ont00000965> ;
    skos:definition "A Prescriptive Information Content Entity that prescribes some Process and contains a finite sequence of unambiguous instructions in order to achieve some Objective."@en .

<https://www.commoncoreontologies.org/ont00000654> a owl:Class ;
    rdfs:label "Act of Terrorism"@en ;
    rdfs:subClassOf <https://www.commoncoreontologies.org/ont00001147> ;
    skos:definition "An Act of Violence which creates fear and which is prescribed by religious, political or ideological objectives, and which deliberately target or disregard the safety of civilians and are committed by members of non-government organizations."@en .

<https://www.commoncoreontologies.org/ont00000656> a owl:Class ;
    rdfs:label "Radiological Weapon"@en ;
    rdfs:subClassOf <https://www.commoncoreontologies.org/ont00000445> ;
    skos:definition "A Weapon that is designed to inflict harm, damage, or incapacity by means of releasing radioactive material."@en .

<https://www.commoncoreontologies.org/ont00000657> a owl:Class ;
    rdfs:label "Distance Measurement Artifact Function"@en ;
    rdfs:subClassOf <https://www.commoncoreontologies.org/ont00001100> ;
    skos:definition "A Measurement Artifact Function that is realized during events in which a Material Artifact is used to measure the spatial Distance to a specified object or class of objects."@en .

<https://www.commoncoreontologies.org/ont00000658> a owl:Class ;
    rdfs:label "Missile Launcher"@en ;
    rdfs:subClassOf <https://www.commoncoreontologies.org/ont00001051> ;
    skos:definition "A Projectile Launcher that is designed to launch one or more Precision-Guided Missiles."@en .

<https://www.commoncoreontologies.org/ont00000659> a owl:Class ;
    rdfs:label "Measurement Unit of Torque"@en ;
    rdfs:subClassOf <https://www.commoncoreontologies.org/ont00000120> ;
    skos:definition "A Measurement Unit that is used as a standard for measurement of the rate of change of angular momentum of an object."@en .

<https://www.commoncoreontologies.org/ont00000661> a owl:Class ;
    rdfs:label "Government Artifact Function"@en ;
    rdfs:subClassOf <https://www.commoncoreontologies.org/ont00001301> ;
    skos:definition "A Service Artifact Function that is realized in processes in which public policy is administered and the actions of its members are directed."@en .

<https://www.commoncoreontologies.org/ont00000664> a owl:Class ;
    rdfs:label "Radio Relay Station"@en ;
    rdfs:subClassOf <https://www.commoncoreontologies.org/ont00000531> ;
    skos:definition "A Communications Facility that is designed to support the receiving and re-transmitting of radio signals."@en .

<https://www.commoncoreontologies.org/ont00000665> a owl:Class ;
    rdfs:label "Cleaning Artifact Function"@en ;
    rdfs:subClassOf <https://www.commoncoreontologies.org/ont00000323> ;
    skos:definition "An Artifact Function that is realized in processes in which some Material Artifact is used to remove foreign objects from another object."@en .

<https://www.commoncoreontologies.org/ont00000666> a owl:Class ;
    rdfs:label "Neutral Person"@en ;
    rdfs:subClassOf <https://www.commoncoreontologies.org/ont00001262> ;
    skos:definition "A Person who is the bearer of some Neutral Role."@en .

<https://www.commoncoreontologies.org/ont00000667> a owl:Class ;
    rdfs:label "Combat Outpost"@en ;
    rdfs:subClassOf <https://www.commoncoreontologies.org/ont00001052> ;
    skos:definition "A Military Facility that is designed to support the conduction of combat operations of limited scope or size."@en .

<https://www.commoncoreontologies.org/ont00000668> a owl:Class ;
    rdfs:label "Battery Terminal"@en ;
    rdfs:subClassOf <https://www.commoncoreontologies.org/ont00000995> ;
    skos:definition "A Material Artifact that is designed to connect a load or charger to a single or multiple-cell Battery."@en .

<https://www.commoncoreontologies.org/ont00000669> a owl:Class ;
    rdfs:label "Distance Measurement Information Content Entity"@en ;
    rdfs:subClassOf <https://www.commoncoreontologies.org/ont00001022> ;
    skos:definition "A Ratio Measurement Information Content Entity that is a measurement of a One-Dimensional Extent inhering in some Site that is externally connected to two Independent Continuants."@en .

<https://www.commoncoreontologies.org/ont00000670> a owl:Class ;
    rdfs:label "Distribution Port"@en ;
    rdfs:subClassOf <https://www.commoncoreontologies.org/ont00001258> ;
    skos:definition "A Port that is designed with the cargo handling equipment necessary for the loading and unloading of Watercraft"@en .

<https://www.commoncoreontologies.org/ont00000671> a owl:Class ;
    rdfs:label "Anti-Bacterial Artifact Function"@en ;
    rdfs:subClassOf <https://www.commoncoreontologies.org/ont00000415> ;
    skos:definition "An Anti-Microbial Artifact Function that is realized in a process which causes harm to, or the death of, some bacterium."@en .

<https://www.commoncoreontologies.org/ont00000672> a owl:Class ;
    rdfs:label "Super Low Frequency"@en ;
    rdfs:subClassOf <https://www.commoncoreontologies.org/ont00000150> ;
    skos:definition "A Radio Frequency that is between 30 and 300 Hz."@en .

<https://www.commoncoreontologies.org/ont00000673> a owl:Class ;
    rdfs:label "Prosthetic Foot"@en ;
    rdfs:subClassOf <https://www.commoncoreontologies.org/ont00000715> ;
    skos:definition "A Prosthesis that is designed to replace a missing foot."@en .

<https://www.commoncoreontologies.org/ont00000678> a owl:Class ;
    rdfs:label "Voltage Regulating Artifact Function"@en ;
    rdfs:subClassOf <https://www.commoncoreontologies.org/ont00000098> ;
    skos:definition "An Artifact Function that is realized by processes in which some Material Artifact is used to cause a change in the voltage magnitude between the sending and receiving end of an electrical component."@en .

<https://www.commoncoreontologies.org/ont00000679> a owl:Class ;
    rdfs:label "Attitude Control Artifact Function"@en ;
    rdfs:subClassOf <https://www.commoncoreontologies.org/ont00000323> ;
    skos:definition "An Artifact Function that is realized by a Material Artifact participating in an attitude control process."@en .

<https://www.commoncoreontologies.org/ont00000680> a owl:Class ;
    rdfs:label "Medical Depot"@en ;
    rdfs:subClassOf <https://www.commoncoreontologies.org/ont00000881> ;
    skos:definition "A Storage Facility that is designed to store medical supplies."@en .

<https://www.commoncoreontologies.org/ont00000681> a owl:Class ;
    rdfs:label "External Navigation Lighting System"@en ;
    rdfs:subClassOf <https://www.commoncoreontologies.org/ont00000236> ;
    skos:definition "A Lighting System that is designed to be attached to some Vehicle and to emit colored light in order to signal that Vehicle's position, heading, and status."@en .

<https://www.commoncoreontologies.org/ont00000682> a owl:Class ;
    rdfs:label "Mirror"@en ;
    rdfs:subClassOf <https://www.commoncoreontologies.org/ont00000136> ;
    skos:definition "An Optical Instrument that is designed to reflect light that has a wavelength within a given range and is incident on its relflecting surface such that the reflected light maintains most of the characteristics of the original light."@en .

<https://www.commoncoreontologies.org/ont00000683> a owl:Class ;
    rdfs:label "Diminutive Name"@en ;
    rdfs:subClassOf <https://www.commoncoreontologies.org/ont00000605> ;
    skos:definition "An Abbreviated Name that is a familiar form of a Proper Name."@en .

<https://www.commoncoreontologies.org/ont00000684> a owl:Class ;
    rdfs:label "Act of Contract Formation"@en ;
    rdfs:subClassOf <https://www.commoncoreontologies.org/ont00000821> ;
    skos:definition "An Act of Promising having a lawful object entered into voluntarily by two or more agents with legal capacity, each of whom intends to create one or more legal obligations between them."@en .

<https://www.commoncoreontologies.org/ont00000685> a owl:Class ;
    rdfs:label "Government Domain Border"@en ;
    rdfs:subClassOf <https://www.commoncoreontologies.org/ont00000207> ;
    skos:definition "A Geospatial Boundary that is a boundary of some Government Domain."@en .

<https://www.commoncoreontologies.org/ont00000688> a owl:Class ;
    rdfs:label "Turbofan Air-Breathing Jet Engine"@en ;
    rdfs:subClassOf <https://www.commoncoreontologies.org/ont00000294> ;
    skos:definition "An Air-Breathing Jet Engine that uses a Turbofan, which consists of a Turbine and a Fan."@en .

<https://www.commoncoreontologies.org/ont00000689> a owl:Class ;
    rdfs:label "Switch Artifact Function"@en ;
    rdfs:subClassOf <https://www.commoncoreontologies.org/ont00000323> ;
    skos:definition "An Artifact Function that is realized in a process of breaking an electric circuit by interrupting the current or diverting it from one conductor to another."@en .

<https://www.commoncoreontologies.org/ont00000691> a owl:Class ;
    rdfs:label "Fuel Tank"@en ;
    rdfs:subClassOf <https://www.commoncoreontologies.org/ont00000020> ;
    skos:definition "A Container that is designed to store a Portion of Fuel."@en .

<https://www.commoncoreontologies.org/ont00000692> a owl:Class ;
    rdfs:label "Probability Measurement Information Content Entity"@en ;
    rdfs:subClassOf <https://www.commoncoreontologies.org/ont00001163> ;
    skos:definition "A Measurement Information Content Entity that is a measurement of the likelihood that a Process or Process Aggregate occurs."@en .

<https://www.commoncoreontologies.org/ont00000693> a owl:Class ;
    rdfs:label "Mass Specification"@en ;
    rdfs:subClassOf <https://www.commoncoreontologies.org/ont00000575> ;
    skos:definition "A Quality Specification that prescribes the Amount of Mass that a Material Entity should have."@en .

<https://www.commoncoreontologies.org/ont00000694> a owl:Class ;
    rdfs:label "Nozzle Mouth"@en ;
    rdfs:subClassOf <https://www.commoncoreontologies.org/ont00000256> ;
    skos:definition "A Fluid Control Artifact that consists of the portion of a Nozzle at the end that is designed to be where the flow of fluid exits the Nozzle."@en .

<https://www.commoncoreontologies.org/ont00000695> a owl:Class ;
    rdfs:label "Radiolucent"@en ;
    rdfs:subClassOf <https://www.commoncoreontologies.org/ont00000620> ;
    skos:definition "A Radiopacity that inheres in a bearer in virtue of its capacity to permit most X-rays to pass through it."@en .

<https://www.commoncoreontologies.org/ont00000697> a owl:Class ;
    rdfs:label "Enemy Person"@en ;
    rdfs:subClassOf <https://www.commoncoreontologies.org/ont00001262> ;
    skos:definition "A Person who is the bearer of some Enemy Role."@en .

<https://www.commoncoreontologies.org/ont00000698> a owl:Class ;
    rdfs:label "Convergent-Divergent Nozzle"@en ;
    rdfs:subClassOf <https://www.commoncoreontologies.org/ont00000252> ;
    skos:definition "A Nozzle that consists of a tube with an asymmetric hourglass shape that is designed to accelerate hot pressurized gas by converting the heat energy of the gas flow into kinetic energy as it passes through the Nozzle Throat to generate increased Exhaust Velocity of the gas as it exits the Nozzle."@en .

<https://www.commoncoreontologies.org/ont00000699> a owl:Class ;
    rdfs:label "Afternoon"@en ;
    rdfs:subClassOf <http://purl.obolibrary.org/obo/BFO_0000202> ;
    skos:definition "A Temporal Interval that consists of the temporal regions between when the sun is at its apex (approximately 12:00pm) and when it sets (approximately 6:00pm)."@en .

<https://www.commoncoreontologies.org/ont00000700> a owl:Class ;
    rdfs:label "Computer Network"@en ;
    rdfs:subClassOf <https://www.commoncoreontologies.org/ont00000998> ;
    skos:definition "A Telecommunication Network that is designed to allow the exchange of data between two or more computers connected to the network."@en .

<https://www.commoncoreontologies.org/ont00000701> a owl:Class ;
    rdfs:label "Wire Receiver"@en ;
    rdfs:subClassOf <https://www.commoncoreontologies.org/ont00001145> ;
    skos:definition "A Radio Receiver that uses a Wire Antenna to intercept radio signals."@en .

<https://www.commoncoreontologies.org/ont00000703> a owl:Class ;
    rdfs:label "Material Copy of a System Clock"@en ;
    rdfs:subClassOf <https://www.commoncoreontologies.org/ont00000159> ;
    skos:definition "A Material Copy of a Timekeeping Instrument that is part of a computer and is designed to issue a steady high-frequency signal that is used to synchronize all of the computer's internal components."@en .

<https://www.commoncoreontologies.org/ont00000704> a owl:Class ;
    rdfs:label "Constructed Tunnel"@en ;
    rdfs:subClassOf <https://www.commoncoreontologies.org/ont00000254> ;
    skos:definition "A Transportation Artifact that is designed to be substantially enclosed, have access constrained to portals, and to enable travel through surrounding soil, earth, or rock formation."@en .

<https://www.commoncoreontologies.org/ont00000705> a owl:Class ;
    rdfs:label "Power Transmission Line"@en ;
    rdfs:subClassOf <https://www.commoncoreontologies.org/ont00000677> ;
    skos:definition "A Product Transport Facility that is designed to transmit electricity over distance via a system of above ground wires including their supports."@en .

<https://www.commoncoreontologies.org/ont00000706> a owl:Class ;
    rdfs:label "Terminal Board"@en ;
    rdfs:subClassOf <https://www.commoncoreontologies.org/ont00000995> ;
    skos:definition "A Material Artifact that is designed to join electrical terminations and create an electrical circuit by means of a block which connects individual wires without a splice or physically joining the ends."@en .

<https://www.commoncoreontologies.org/ont00000707> a owl:Class ;
    rdfs:label "Measurement Unit of Angle"@en ;
    rdfs:subClassOf <https://www.commoncoreontologies.org/ont00000120> ;
    skos:definition "A Measurement Unit that is used as a standard for measurement of the angle between two lines or planes in relation to a vertex."@en .

<https://www.commoncoreontologies.org/ont00000708> a owl:Class ;
    rdfs:label "Water Tower"@en ;
    rdfs:subClassOf <https://www.commoncoreontologies.org/ont00000881> ;
    skos:definition "A Facility that is the bearer of functions realized in processes of storing water in an elevated container."@en .

<https://www.commoncoreontologies.org/ont00000709> a owl:Class ;
    rdfs:label "Visual Prosthesis"@en ;
    rdfs:subClassOf <https://www.commoncoreontologies.org/ont00001248> ;
    skos:definition "An Artificial Eye that is designed to replace a missing eye, which performs the function of an eye."@en .

<https://www.commoncoreontologies.org/ont00000710> a owl:Class ;
    rdfs:label "Command Post Facility"@en ;
    rdfs:subClassOf <https://www.commoncoreontologies.org/ont00001052> ;
    skos:definition "A Military Facility that is designed to support the command and control of Military Operations or Forces."@en .

<https://www.commoncoreontologies.org/ont00000711> a owl:Class ;
    rdfs:label "Semi-automatic Pistol"@en ;
    rdfs:subClassOf <https://www.commoncoreontologies.org/ont00000156> ;
    skos:definition "A Hand Gun that has a single fixed firing chamber machined into the rear of the barrel and an ammunition magazine capable of holding multiple Cartridges such that the Hand Gun is designed to automatically reload each time it is fired and to fire a Bullet with each successive pull of the trigger until the stored ammunition is depleted."@en .

<https://www.commoncoreontologies.org/ont00000714> a owl:Class ;
    rdfs:label "Horn Antenna"@en ;
    rdfs:subClassOf <https://www.commoncoreontologies.org/ont00001192> ;
    skos:definition "A Radio Antenna that consists of a flaring metal waveguide shaped like a horn to direct radio waves in a beam and can be used on its own or as a feeder for larger antenna structures, such as Parabolic Antennas."@en .

<https://www.commoncoreontologies.org/ont00000717> a owl:Class ;
    rdfs:label "Fossil Fuel Power Plant"@en ;
    rdfs:subClassOf <https://www.commoncoreontologies.org/ont00001076> ;
    skos:definition "An Electric Power Station that is designed to convert fossil fuels (e.g. coal, natural gas, or petroleum) into electrical energy."@en .

<https://www.commoncoreontologies.org/ont00000718> a owl:Class ;
    rdfs:label "Village"@en ;
    rdfs:subClassOf <https://www.commoncoreontologies.org/ont00000460> ;
    skos:definition "A Local Administrative Region in which a human population permanently resides that is typically larger than the population of a hamlet but smaller than that of a Town."@en .

<https://www.commoncoreontologies.org/ont00000720> a owl:Class ;
    rdfs:label "Cryogenic Storage Dewar"@en ;
    rdfs:subClassOf <https://www.commoncoreontologies.org/ont00000020> ;
    skos:definition "A Container that is designed to store a Portion of Cryogenic Material (such as liquid helium or liquid oxygen) and which consists of, minimally, walls that are constructed from two or more layers that are separated by a high vacuum to provide thermal insulation between the interior and exterior of the dewar."@en .

<https://www.commoncoreontologies.org/ont00000721> a owl:Class ;
    rdfs:label "Polarizing Prism"@en ;
    rdfs:subClassOf <https://www.commoncoreontologies.org/ont00000804> ;
    skos:definition "A Prism designed to split a beam of light entering the Prism into components of varying polarization."@en .

<https://www.commoncoreontologies.org/ont00000722> a owl:Class ;
    rdfs:label "Sea Level"@en ;
    rdfs:subClassOf <http://purl.obolibrary.org/obo/BFO_0000146> ;
    skos:definition "A Fiat Surface that divides the spheroid composed of Earth and its atmosphere at some point that corresponds to the mean level of calm water in the Earth’s oceans."@en .

<https://www.commoncoreontologies.org/ont00000724> a owl:Class ;
    rdfs:label "Parabolic Antenna"@en ;
    rdfs:subClassOf <https://www.commoncoreontologies.org/ont00001192> ;
    skos:definition "A Radio Antenna that uses a parabolic reflector to direct or receive radio waves and has a very high gain."@en .

<https://www.commoncoreontologies.org/ont00000725> a owl:Class ;
    rdfs:label "Wedding"@en ;
    rdfs:subClassOf <https://www.commoncoreontologies.org/ont00000455> ;
    skos:definition "An Act of Ceremony in which two Persons are united in Marriage or a similar institution."@en .

<https://www.commoncoreontologies.org/ont00000728> a owl:Class ;
    rdfs:label "Submillimeter Wavelength Radio Telescope"@en ;
    rdfs:subClassOf <https://www.commoncoreontologies.org/ont00000215> ;
    skos:definition "A Radio Telescope that is designed to aid in the observation of spatially distant Objects by means of collecting and focusing radio waves from the submillimeter waveband (i.e. microwaves) to form an enhanced image of the Object."@en .

<https://www.commoncoreontologies.org/ont00000729> a owl:Class ;
    rdfs:label "Spherical Coordinate System"@en ;
    rdfs:subClassOf <https://www.commoncoreontologies.org/ont00000275> ;
    skos:definition "A Spatial Reference System for three-dimensional spatial regions that identifies each point using an ordered triple of numerical coordinates that consist of the radial distance of the point of interest from a fixed origin, its polar angle measured from a fixed zenith direction, and the azimuth angle of its orthogonal projection measured from a fixed direction on a reference plane that passes through the origin and is orthogonal to the zenith."@en .

<https://www.commoncoreontologies.org/ont00000730> a owl:Class ;
    rdfs:label "Hydraulic Power Transfer Unit"@en ;
    rdfs:subClassOf <https://www.commoncoreontologies.org/ont00000995> ;
    skos:definition "A Material Artifact that is designed to transfer hydraulic power from one of an Aircraft's hydraulic systems to another in the event that a system has failed or been turned off."@en .

<https://www.commoncoreontologies.org/ont00000731> a owl:Class ;
    rdfs:label "Deviation Measurement Information Content Entity"@en ;
    rdfs:subClassOf <https://www.commoncoreontologies.org/ont00001163> ;
    skos:definition "A Measurement Information Content Entity that is a measurement of the extent to which an entity conforms to how it is expected or supposed to be."@en .

<https://www.commoncoreontologies.org/ont00000733> a owl:Class ;
    rdfs:label "Spherical"@en ;
    rdfs:subClassOf <https://www.commoncoreontologies.org/ont00001360> ;
    skos:definition "A Three Dimensional Shape inhering in a bearer in virtue of all of its cross sections being round."@en .

<https://www.commoncoreontologies.org/ont00000734> a owl:Class ;
    rdfs:label "Explosive Land Mine"@en ;
    rdfs:subClassOf <https://www.commoncoreontologies.org/ont00002066> ;
    skos:definition "An Explosive Mine that is designed to be concealed under or on the ground."@en .

<https://www.commoncoreontologies.org/ont00000735> a owl:Class ;
    rdfs:label "Geospatial Region Bounding Box Identifier List"@en ;
    rdfs:subClassOf <https://www.commoncoreontologies.org/ont00000406> ;
    skos:definition "A Measurement Unit of Geocoordinate that is comprised of 4 pairs of coordinates, one for each of the 4 defining points (North, West, South, East) of a Geospatial Region Bounding Box."@en .

<https://www.commoncoreontologies.org/ont00000737> a owl:Class ;
    rdfs:label "Forward Operations Base"@en ;
    rdfs:subClassOf <https://www.commoncoreontologies.org/ont00000483> ;
    skos:definition "A Military Base that is located relatively close to an offensive Area of Operations, is supported by the Base of Operations, and is designed to support local strategic objectives and tactical operations."@en .

<https://www.commoncoreontologies.org/ont00000738> a owl:Class ;
    rdfs:label "Length"@en ;
    rdfs:subClassOf <https://www.commoncoreontologies.org/ont00001367> ;
    skos:definition "A One Dimensional Extent that inheres in a bearer in virtue of the bearer's greatest extent in one direction."@en .

<https://www.commoncoreontologies.org/ont00000739> a owl:Class ;
    rdfs:label "Act of Sojourn"@en ;
    rdfs:subClassOf <https://www.commoncoreontologies.org/ont00000676> ;
    skos:definition "An Act of Inhabitancy in which a Person lives in a dwelling temporarily, often during stages of an Act of Travel."@en .

<https://www.commoncoreontologies.org/ont00000740> a owl:Class ;
    rdfs:label "Resource"@en ;
    rdfs:subClassOf <http://purl.obolibrary.org/obo/BFO_0000002> ;
    skos:definition "A Continuant that is owned by, in the possession of, or is otherwise controlled by an Agent such that it could be used by that Agent."@en .

<https://www.commoncoreontologies.org/ont00000741> a owl:Class ;
    rdfs:label "Act of Targeting"@en ;
    rdfs:subClassOf <https://www.commoncoreontologies.org/ont00000228> ;
    skos:definition "A Planned Act wherein some Agent maintains one or more entities as the objects of potential action given some operational requirement."@en .

<https://www.commoncoreontologies.org/ont00000743> a owl:Class ;
    rdfs:label "Material Copy of a Chart"@en ;
    rdfs:subClassOf <https://www.commoncoreontologies.org/ont00000702> ;
    skos:definition "A Material Copy of an Image that is designed to carry some Representational Information Content Entity that is prescribed by some canonical visual format."@en .

<https://www.commoncoreontologies.org/ont00000744> a owl:Class ;
    rdfs:label "Act of Social Group Membership"@en ;
    rdfs:subClassOf <https://www.commoncoreontologies.org/ont00000433> ;
    skos:definition "An Act of Association wherein a Person belongs to some Social Group."@en .

<https://www.commoncoreontologies.org/ont00000747> a owl:Class ;
    rdfs:label "Canal"@en ;
    rdfs:subClassOf <https://www.commoncoreontologies.org/ont00000549> ;
    skos:definition "A Water Transportation Artifact that is an artificial Hydrographic Feature designed to convey water or enable Watercraft to travel inland."@en .

<https://www.commoncoreontologies.org/ont00000748> a owl:Class ;
    rdfs:label "Bullet"@en ;
    rdfs:subClassOf <https://www.commoncoreontologies.org/ont00001150> ;
    skos:definition "A Portion of Ammunition that is designed to be projected by a Firearm, Sling, Slingshot, or Air Gun, but which does not (typically) contain explosives."@en .

<https://www.commoncoreontologies.org/ont00000749> a owl:Class ;
    rdfs:label "Julian Day Number"@en ;
    rdfs:subClassOf <https://www.commoncoreontologies.org/ont00000894> ;
    skos:definition "A Decimal Date Identifier that designates some Julian Day by using a number to indicate the sequential ordering of the Day since the Julian Date epoch."@en .

<https://www.commoncoreontologies.org/ont00000750> a owl:Class ;
    rdfs:label "Text Messaging"@en ;
    rdfs:subClassOf <https://www.commoncoreontologies.org/ont00000517> ;
    skos:definition "An Act of Communication by Media involving the exchange of brief written messages between fixed-line phone or mobile phone and fixed or portable devices over a network."@en .

<https://www.commoncoreontologies.org/ont00000751> a owl:Class ;
    rdfs:label "Action Permission"@en ;
    rdfs:subClassOf <https://www.commoncoreontologies.org/ont00001324> ;
    skos:definition "A Process Regulation that permits some Process."@en .

<https://www.commoncoreontologies.org/ont00000753> a owl:Class ;
    rdfs:label "Ultra Low Frequency"@en ;
    rdfs:subClassOf <https://www.commoncoreontologies.org/ont00000150> ;
    skos:definition "A Radio Frequency that is between 300 Hz and 3 kHz."@en .

<https://www.commoncoreontologies.org/ont00000755> a owl:Class ;
    rdfs:label "Zenith"@en ;
    rdfs:subClassOf <http://purl.obolibrary.org/obo/BFO_0000026> ;
    skos:definition "A One-Dimensional Spatial Region that extends from a given location upward along the local vertical direction pointing in the direction opposite the apparent Gravitational Force at that location."@en .

<https://www.commoncoreontologies.org/ont00000756> a owl:Class ;
    rdfs:label "Material Copy of a Database"@en ;
    rdfs:subClassOf <https://www.commoncoreontologies.org/ont00000798> ;
    skos:definition "An Information Bearing Artifact that is designed to carry some set of specific Information Content Entities and to be rapidly searchable and retrievable."@en .

<https://www.commoncoreontologies.org/ont00000757> a owl:Class ;
    rdfs:label "Synagogue"@en ;
    rdfs:subClassOf <https://www.commoncoreontologies.org/ont00000052> ;
    skos:definition "A Religious Facility that is designed for Judaic worship and prayer."@en .

<https://www.commoncoreontologies.org/ont00000758> a owl:Class ;
    rdfs:label "Component Role"@en ;
    rdfs:subClassOf <http://purl.obolibrary.org/obo/BFO_0000023> ;
    skos:definition "A Role that inheres in an entity having a discrete structure in virtue of that entity being part of a system considered at a particular level of analysis."@en .

<https://www.commoncoreontologies.org/ont00000759> a owl:Class ;
    rdfs:label "Color Saturation"@en ;
    rdfs:subClassOf <https://www.commoncoreontologies.org/ont00000784> ;
    skos:definition "An Optical Property that inheres in a bearer in virtue of its capacity to reflect high intensity light distributed across fewer wavelengths, typically considered on a continuum of purity."@en .

<https://www.commoncoreontologies.org/ont00000760> a owl:Class ;
    rdfs:label "Surface Wave Profile"@en ;
    rdfs:subClassOf <https://www.commoncoreontologies.org/ont00000752> ;
    skos:definition "A Wave Process Profile in which the Wave Process propogates along the surface of a medium and which involves both transverse and longitudinal wave profiles such that the motion of the displacement of participating particles is circular or elliptical."@en .

<https://www.commoncoreontologies.org/ont00000761> a owl:Class ;
    rdfs:label "Pier"@en ;
    rdfs:subClassOf <https://www.commoncoreontologies.org/ont00000226> ;
    skos:definition "A Transportation Facility that is designed to partially enclose a harbor and form a landing place for Watercraft."@en .

<https://www.commoncoreontologies.org/ont00000762> a owl:Class ;
    rdfs:label "Fungicide Artifact Function"@en ;
    rdfs:subClassOf <https://www.commoncoreontologies.org/ont00000415> ;
    skos:definition "An Anti-Microbial Artifact Function that is realized in a process which causes harm to, or the death of, some fungus or fungal spore."@en .

<https://www.commoncoreontologies.org/ont00000764> a owl:Class ;
    rdfs:label "Optical Focusing Artifact Function"@en ;
    rdfs:subClassOf <https://www.commoncoreontologies.org/ont00000504> ;
    skos:definition "An Optical Processing Artifact Function that is realized by a Material Artifact participating in a light focusing event in which the Material Artifact causes the light beam to converge on a target spatial point."@en .

<https://www.commoncoreontologies.org/ont00000766> a owl:Class ;
    rdfs:label "Hardness"@en ;
    rdfs:subClassOf <http://purl.obolibrary.org/obo/BFO_0000019> ;
    skos:definition "A Quality that inheres in a bearer in virtue of the degree to which it can be turned, bowed, or twisted without breaking."@en .

<https://www.commoncoreontologies.org/ont00000767> a owl:Class ;
    rdfs:label "Lubrication System"@en ;
    rdfs:subClassOf <https://www.commoncoreontologies.org/ont00000995> ;
    skos:definition "A Material Artifact that is designed to contain, transfer, and regulate the flow of lubricant to multiple locations in a Material Artifact."@en .

<https://www.commoncoreontologies.org/ont00000768> a owl:Class ;
    rdfs:label "Amount"@en ;
    rdfs:subClassOf <http://purl.obolibrary.org/obo/BFO_0000019> ;
    skos:definition "A Quality that inheres in a bearer in virtue of the total, aggregate or sum of a number of discrete items or material the entity contains as parts."@en .

<https://www.commoncoreontologies.org/ont00000769> a owl:Class ;
    rdfs:label "Act of Requesting"@en ;
    rdfs:subClassOf <https://www.commoncoreontologies.org/ont00000133> ;
    skos:definition "An Act of Directive Communication performed by asking for something."@en .

<https://www.commoncoreontologies.org/ont00000770> a owl:Class ;
    rdfs:label "Measurement Unit of Density"@en ;
    rdfs:subClassOf <https://www.commoncoreontologies.org/ont00000120> ;
    skos:definition "A Measurement Unit that is used as a standard for measurement of the mass of an object per unit of its total volume."@en .

<https://www.commoncoreontologies.org/ont00000772> a owl:Class ;
    rdfs:label "Impulsive Force"@en ;
    rdfs:subClassOf <http://purl.obolibrary.org/obo/BFO_0000144> ;
    skos:definition "A Process Profile that is the integral of a Force that is applied to a portion of matter over a period of time."@en .

<https://www.commoncoreontologies.org/ont00000773> a owl:Class ;
    rdfs:label "Curvilinear Motion"@en ;
    rdfs:subClassOf <https://www.commoncoreontologies.org/ont00000789> ;
    skos:definition "A Translational Motion process in which an Object moves along a curved path."@en .

<https://www.commoncoreontologies.org/ont00000775> a owl:Class ;
    rdfs:label "Locomotive"@en ;
    rdfs:subClassOf <https://www.commoncoreontologies.org/ont00000796> ;
    skos:definition "A Rail Transport Vehicle that is designed to provide the motive power for a Train."@en .

<https://www.commoncoreontologies.org/ont00000776> a owl:Class ;
    rdfs:label "Signal Detection Artifact Function"@en ;
    rdfs:subClassOf <https://www.commoncoreontologies.org/ont00000323> ;
    skos:definition "An Artifact Function that is realized in the process of discerning between information-bearing patterns and random patterns, or noise, that distract from the information."@en .

<https://www.commoncoreontologies.org/ont00000777> a owl:Class ;
    rdfs:label "Hydraulic Motor"@en ;
    rdfs:subClassOf <https://www.commoncoreontologies.org/ont00001221> ;
    skos:definition "A Physically Powered Engine that converts hydraulic pressure and flow into torque and angular displacement."@en .

<https://www.commoncoreontologies.org/ont00000778> a owl:Class ;
    rdfs:label "Chemical Depot"@en ;
    rdfs:subClassOf <https://www.commoncoreontologies.org/ont00000881> ;
    skos:definition "A Storage Facility that is designed to store chemicals."@en .

<https://www.commoncoreontologies.org/ont00000779> a owl:Class ;
    rdfs:label "Portion of Cryosphere"@en ;
    rdfs:subClassOf <http://purl.obolibrary.org/obo/BFO_0000024> ;
    skos:definition "A fiat object part of the frozen part of a natural satellite's hydosphere"@en .

<https://www.commoncoreontologies.org/ont00000780> a owl:Class ;
    rdfs:label "Ethnicity"@en ;
    rdfs:subClassOf <http://purl.obolibrary.org/obo/BFO_0000019> ;
    skos:definition "A Quality that inheres in its bearers by virtue of a common heritage, often consisting of a common language, a common culture (often including a shared religion) and an ideology that stresses common ancestry or endogamy."@en .

<https://www.commoncoreontologies.org/ont00000783> a owl:Class ;
    rdfs:label "Stasis of Non-Mission Capable Maintenance"@en ;
    rdfs:subClassOf <https://www.commoncoreontologies.org/ont00000557> ;
    skos:definition "A Stasis of Non-Mission Capable during which the participating Continuant is not capable of performing its primary functions for the specified Mission due to participating in an Act Of Maintenance."@en .

<https://www.commoncoreontologies.org/ont00000785> a owl:Class ;
    rdfs:label "Radio Repeater"@en ;
    rdfs:subClassOf <https://www.commoncoreontologies.org/ont00001320> ;
    skos:definition "A Radio Transceiver that is designed to receive a radio signal, amplify it, and retransmit it (often on another frequency)."@en .

<https://www.commoncoreontologies.org/ont00000786> a owl:Class ;
    rdfs:label "Increase of Role"@en ;
    rdfs:subClassOf <https://www.commoncoreontologies.org/ont00000611> ;
    skos:definition "An Increase of Realizable Entity in which some Independent Continuant has an increase of some Role that it bears."@en .

<https://www.commoncoreontologies.org/ont00000787> a owl:Class ;
    rdfs:label "Altitude"@en ;
    rdfs:subClassOf <https://www.commoncoreontologies.org/ont00000967> ;
    skos:definition "A Height that inheres in a Site that externally connects an Independent Continuant to either the surface of the Earth or the Earth's mean Sea Level."@en .

<https://www.commoncoreontologies.org/ont00000788> a owl:Class ;
    rdfs:label "Turbine Steam Engine"@en ;
    rdfs:subClassOf <https://www.commoncoreontologies.org/ont00000634> ;
    skos:definition "A Steam Engine that is designed to extract thermal energy from pressurized steam and use it to do mechanical work on a rotating output shaft."@en .

<https://www.commoncoreontologies.org/ont00000790> a owl:Class ;
    rdfs:label "Direct Current Power Source"@en ;
    rdfs:subClassOf <https://www.commoncoreontologies.org/ont00001049> ;
    skos:definition "An Electrical Power Source that is designed to transfer electrical power in the form of direct current."@en .

<https://www.commoncoreontologies.org/ont00000792> a owl:Class ;
    rdfs:label "Catadioptric Optical Telescope"@en ;
    rdfs:subClassOf <https://www.commoncoreontologies.org/ont00001009> ;
    skos:definition "An Optical Telescope that is designed to aid in the observation of spatially distant Objects by means of collecting and focusing visible light through the use of a combination of Lenses and Mirrors to form an enhanced image of the Object."@en .

<https://www.commoncoreontologies.org/ont00000793> a owl:Class ;
    rdfs:label "Fuel Ventilation System"@en ;
    rdfs:subClassOf <https://www.commoncoreontologies.org/ont00000256> ;
    skos:definition "A Fluid Control Artifact that is designed to allow air into the Fuel Tank to take the place of burned fuel."@en .

<https://www.commoncoreontologies.org/ont00000794> a owl:Class ;
    rdfs:label "Geospatial Ellipse"@en ;
    rdfs:subClassOf <https://www.commoncoreontologies.org/ont00000207> ;
    skos:definition "A One-Dimensional Geospatial Boundary that is formed by following a symmetric arc between four vertices which are connected to the center point of the ellipse via a straight line."@en .

<https://www.commoncoreontologies.org/ont00000797> a owl:Class ;
    rdfs:label "Hazel"@en ;
    rdfs:subClassOf <https://www.commoncoreontologies.org/ont00000378> ;
    skos:definition "A Color that is a combination of Brown and Green, typically associated with eye color."@en .

<https://www.commoncoreontologies.org/ont00000801> a owl:Class ;
    rdfs:label "y-Axis"@en ;
    rdfs:subClassOf <https://www.commoncoreontologies.org/ont00000161> ;
    skos:definition "A Coordinate System Axis designated by the variable 'y'."@en .

<https://www.commoncoreontologies.org/ont00000802> a owl:Class ;
    rdfs:label "Stage"@en ;
    rdfs:subClassOf <https://www.commoncoreontologies.org/ont00000641> ;
    skos:definition "An Entertainment Facility that is designed to provide a space upon which entertaining performances or productions can occur."@en .

<https://www.commoncoreontologies.org/ont00000803> a owl:Class ;
    rdfs:label "Round"@en ;
    rdfs:subClassOf <https://www.commoncoreontologies.org/ont00001059> ;
    skos:definition "A Shape Quality that inheres in a bearer in virtue of every point along its circumference being equidistant from the center."@en .

<https://www.commoncoreontologies.org/ont00000805> a owl:Class ;
    rdfs:label "Coiled"@en ;
    rdfs:subClassOf <https://www.commoncoreontologies.org/ont00001059> ;
    skos:definition "A Shape Quality inhering in a bearer in virtue of the bearer being wound in concentric rings or spirals."@en .

<https://www.commoncoreontologies.org/ont00000806> a owl:Class ;
    rdfs:label "Power Tool"@en ;
    rdfs:subClassOf <https://www.commoncoreontologies.org/ont00000581> ;
    skos:definition "A Tool that is designed to be actuated by a Power Source and mechanism other than or in addition to manual labor."@en .

<https://www.commoncoreontologies.org/ont00000807> a owl:Class ;
    rdfs:label "Compression Ignition Engine"@en ;
    rdfs:subClassOf <https://www.commoncoreontologies.org/ont00000394> ;
    skos:definition "An Internal Combustion Engine that is designed to operate by igniting a portion of Fuel and Oxidizer mixture using heat generated via compression of the mixture."@en .

<https://www.commoncoreontologies.org/ont00000808> a owl:Class ;
    rdfs:label "Reactant Artifact Function"@en ;
    rdfs:subClassOf <https://www.commoncoreontologies.org/ont00000791> ;
    skos:definition "A Chemical Reaction Artifact Function that is realized in a process in which a substance or compound is added to a system in order to bring about a chemical reaction and is consumed in the course of the reaction."@en .

<https://www.commoncoreontologies.org/ont00000809> a owl:Class ;
    rdfs:label "Submersible Artifact Function"@en ;
    rdfs:subClassOf <https://www.commoncoreontologies.org/ont00000323> ;
    skos:definition "An Artifact Function that is realized in processes of operating while submerged in water."@en .

<https://www.commoncoreontologies.org/ont00000810> a owl:Class ;
    rdfs:label "Multi-Week Temporal Interval"@en ;
    rdfs:subClassOf <http://purl.obolibrary.org/obo/BFO_0000038> ;
    skos:definition "A one-dimensional temporal region that is measured in Weeks and spans at least one Week."@en .

<https://www.commoncoreontologies.org/ont00000811> a owl:Class ;
    rdfs:label "Radio Wave Conversion Artifact Function"@en ;
    rdfs:subClassOf <https://www.commoncoreontologies.org/ont00000323> ;
    skos:definition "An Artifact Function that is realized by a Material Artifact being used to convert electric power into radio waves or radio waves into electric power."@en .

<https://www.commoncoreontologies.org/ont00000812> a owl:Class ;
    rdfs:label "Electromagnetic Pulse"@en ;
    rdfs:subClassOf <https://www.commoncoreontologies.org/ont00000951> ;
    skos:definition "An Electromagnetic Wave Process that consists of a short high-energy burst of electromagnetic energy."@en .

<https://www.commoncoreontologies.org/ont00000813> a owl:Class ;
    rdfs:label "Portion of Nuclear Fuel"@en ;
    rdfs:subClassOf <https://www.commoncoreontologies.org/ont00000457> ;
    skos:definition "A Portion of Material that is designed to be used in a nuclear fission process to produce energy."@en .

<https://www.commoncoreontologies.org/ont00000814> a owl:Class ;
    rdfs:label "Water Treatment Facility"@en ;
    rdfs:subClassOf <https://www.commoncoreontologies.org/ont00000192> ;
    skos:definition "A Facility that is designed for making water more acceptable for a specific end-use."@en .

<https://www.commoncoreontologies.org/ont00000815> a owl:Class ;
    rdfs:label "Folded"@en ;
    rdfs:subClassOf <https://www.commoncoreontologies.org/ont00001059> ;
    skos:definition "A Shape Quality inhering in a bearer in virtue of one part of the bearer being layered over another connected part."@en .

<https://www.commoncoreontologies.org/ont00000816> a owl:Class ;
    rdfs:label "Portion of Liquid Nitrogen"@en ;
    rdfs:subClassOf <https://www.commoncoreontologies.org/ont00000255> ;
    skos:definition "A Portion of Cryogenic Material that is composed (almost) entirely of liquid nitrogen."@en .

<https://www.commoncoreontologies.org/ont00000818> a owl:Class ;
    rdfs:label "Orange"@en ;
    rdfs:subClassOf <https://www.commoncoreontologies.org/ont00000378> ;
    skos:definition "A Color that is between Red and Yellow with a wavelength in the visible spectrum typically between 590 to 635 nanometers."@en .

<https://www.commoncoreontologies.org/ont00000820> a owl:Class ;
    rdfs:label "Stasis of Function"@en ;
    rdfs:subClassOf <https://www.commoncoreontologies.org/ont00000246> ;
    skos:definition "A Stasis of Realizable Entity in which some Independent Continuant bears some Function that remains unchanged during a Temporal Interval."@en .

<https://www.commoncoreontologies.org/ont00000822> a owl:Class ;
    rdfs:label "Very Low Frequency"@en ;
    rdfs:subClassOf <https://www.commoncoreontologies.org/ont00000150> ;
    skos:definition "A Radio Frequency that is between 3 and 30 kHz."@en .

<https://www.commoncoreontologies.org/ont00000823> a owl:Class ;
    rdfs:label "Optical Communication Artifact Function"@en ;
    rdfs:subClassOf <https://www.commoncoreontologies.org/ont00001148> ;
    skos:definition "An Electromagnetic Communication Artifact Function that is realized in a process that conveys meaningful signs by means of visible light."@en .

<https://www.commoncoreontologies.org/ont00000824> a owl:Class ;
    rdfs:label "Stasis of Role"@en ;
    rdfs:subClassOf <https://www.commoncoreontologies.org/ont00000246> ;
    skos:definition "A Stasis of Realizable Entity in which some Independent Continuant bears some Role that remains unchanged during a Temporal Interval."@en .

<https://www.commoncoreontologies.org/ont00000826> a owl:Class ;
    rdfs:label "Refractivity"@en ;
    rdfs:subClassOf <https://www.commoncoreontologies.org/ont00001137> ;
    skos:definition "A Radiation Reflectivity that inheres in a bearer in virtue of the capacity of that bearer to change the direction of a propagating wave when passing through it."@en .

<https://www.commoncoreontologies.org/ont00000830> a owl:Class ;
    rdfs:label "Speed"@en ;
    rdfs:subClassOf <http://purl.obolibrary.org/obo/BFO_0000144> ;
    skos:definition "A Process Profile that is characterized by the magnitude of an object's motion with respect to a frame of reference during some time period."@en .

<https://www.commoncoreontologies.org/ont00000833> a owl:Class ;
    rdfs:label "Julian Date Identifier"@en ;
    rdfs:subClassOf <https://www.commoncoreontologies.org/ont00000973> ;
    skos:definition "A Decimal Time of Day Identifier that designates a Julian Date and is composed of both a Julian Day Number and a Julian Date Fraction."@en .

<https://www.commoncoreontologies.org/ont00000834> a owl:Class ;
    rdfs:label "Mid Infrared Light Frequency"@en ;
    rdfs:subClassOf <https://www.commoncoreontologies.org/ont00001337> ;
    skos:definition "An Infrared Light Frequency that is between 20 and 214 terahertz."@en .

<https://www.commoncoreontologies.org/ont00000835> a owl:Class ;
    rdfs:label "Body Shape"@en ;
    rdfs:subClassOf <https://www.commoncoreontologies.org/ont00001059> ;
    skos:definition "A Shape Quality inhering in a Person's body by virtue of the body's general outline or figure."@en .

<https://www.commoncoreontologies.org/ont00000839> a owl:Class ;
    rdfs:label "Act of Donating"@en ;
    rdfs:subClassOf <https://www.commoncoreontologies.org/ont00000836> ;
    skos:definition "An Act of Financial Instrument Use wherein a Financial Instrument is tranfered by an Agent (the Donor) to another Agent (the Recipient) without return consideration."@en .

<https://www.commoncoreontologies.org/ont00000840> a owl:Class ;
    rdfs:label "Bicycle"@en ;
    rdfs:subClassOf <https://www.commoncoreontologies.org/ont00000618> ;
    skos:definition "A Ground Vehicle that consists of two wheels, one in front of the other, attached to a frame along with handlebars and pedals such that it is designed to receive its motive power from pedaling."@en .

<https://www.commoncoreontologies.org/ont00000841> a owl:Class ;
    rdfs:label "Explosive Artifact Function"@en ;
    rdfs:subClassOf <https://www.commoncoreontologies.org/ont00001153> ;
    skos:definition "A Damaging Artifact Function that is realized in a process in which the structural integrity of an entity is impaired because of the rapid increase in volume and release of energy in an extreme manner."@en .

<https://www.commoncoreontologies.org/ont00000842> a owl:Class ;
    rdfs:label "Sub-Bass Frequency"@en ;
    rdfs:subClassOf <https://www.commoncoreontologies.org/ont00000530> ;
    skos:definition "A Sonic Frequency that is between 20 and 60 Hz."@en .

<https://www.commoncoreontologies.org/ont00000843> a owl:Class ;
    rdfs:label "Solar Panel"@en ;
    rdfs:subClassOf <https://www.commoncoreontologies.org/ont00001049> ;
    skos:definition "An Electrical Power Source that consists in part of one or more photovoltaic (i.e. solar) cells that convert light energy (photons) directly into electricity by means of the photovoltaic effect."@en .

<https://www.commoncoreontologies.org/ont00000844> a owl:Class ;
    rdfs:label "Measurement Unit of Temperature"@en ;
    rdfs:subClassOf <https://www.commoncoreontologies.org/ont00000120> ;
    skos:definition "A Measurement Unit that is used as a standard for measurement of the thermal energy in an object."@en .

<https://www.commoncoreontologies.org/ont00000845> a owl:Class ;
    rdfs:label "Proportional Ratio Measurement Information Content Entity"@en ;
    rdfs:subClassOf <https://www.commoncoreontologies.org/ont00001022> ;
    skos:definition "A Ratio Measurement Information Content Entity that is a measurement of a portion of a whole (described by the numerator) compared against that whole (described by the denominator) where the whole is a nominally described set of like entities."@en .

<https://www.commoncoreontologies.org/ont00000846> a owl:Class ;
    rdfs:label "Hydroelectric Power Plant"@en ;
    rdfs:subClassOf <https://www.commoncoreontologies.org/ont00001076> ;
    skos:definition "An Electric Power Station that is designed to convert hydropower into electrical power."@en .

<https://www.commoncoreontologies.org/ont00000849> a owl:Class ;
    rdfs:label "Heating System"@en ;
    rdfs:subClassOf <https://www.commoncoreontologies.org/ont00000453> ;
    skos:definition "An Environment Control System that is designed to heat the air or objects in a Site."@en .

<https://www.commoncoreontologies.org/ont00000851> a owl:Class ;
    rdfs:label "Light Machine Gun"@en ;
    rdfs:subClassOf <https://www.commoncoreontologies.org/ont00001104> ;
    skos:definition "A Long Gun that is designed to fire bullets in quick succession from an ammunition belt or magazine and to be employed by an individual soldier, with or without assistance, and typically weighing 9-22 lbs."@en .

<https://www.commoncoreontologies.org/ont00000852> a owl:Class ;
    rdfs:label "Measurement Unit of Work"@en ;
    rdfs:subClassOf <https://www.commoncoreontologies.org/ont00000120> ;
    skos:definition "A Measurement Unit that is used as a standard for measurement of displacements of points to which Forces have been applied."@en .

<https://www.commoncoreontologies.org/ont00000855> a owl:Class ;
    rdfs:label "Effect of Location Change"@en ;
    rdfs:subClassOf <https://www.commoncoreontologies.org/ont00000660> ;
    skos:definition "An Effect caused by some Act of Location Change and which results in an Object being located in a different place."@en .

<https://www.commoncoreontologies.org/ont00000856> a owl:Class ;
    rdfs:label "Artifact History"@en ;
    rdfs:subClassOf <http://purl.obolibrary.org/obo/BFO_0000182> ;
    skos:definition "A History of a Material Artifact."@en .

<https://www.commoncoreontologies.org/ont00000857> a owl:Class ;
    rdfs:label "Ultra High Frequency Communication Instrument"@en ;
    rdfs:subClassOf <https://www.commoncoreontologies.org/ont00000903> ;
    skos:definition "A Radio Communication Instrument that is designed to participate in some process that has process part some Ultra High Frequency."@en .

<https://www.commoncoreontologies.org/ont00000858> a owl:Class ;
    rdfs:label "Improvised Explosive Device"@en ;
    rdfs:subClassOf <https://www.commoncoreontologies.org/ont00000552> ;
    skos:definition "An Explosive Weapon that is designed to be used in non-conventional military action."@en .

<https://www.commoncoreontologies.org/ont00000859> a owl:Class ;
    rdfs:label "Television Broadcast"@en ;
    rdfs:subClassOf <https://www.commoncoreontologies.org/ont00000517> ;
    skos:definition "An Act of Communciation by Media that is transmitted to an audience through a television network."@en .

<https://www.commoncoreontologies.org/ont00000860> a owl:Class ;
    rdfs:label "Allied Person"@en ;
    rdfs:subClassOf <https://www.commoncoreontologies.org/ont00001262> ;
    skos:definition "A Person who is the bearer of some Ally Role."@en .

<https://www.commoncoreontologies.org/ont00000861> a owl:Class ;
    rdfs:label "Split"@en ;
    rdfs:subClassOf <https://www.commoncoreontologies.org/ont00001059> ;
    skos:definition "A Shape Quality inhering in a bearer in virtue of the bearer having a linear opening, or having been divided into parts."@en .

<https://www.commoncoreontologies.org/ont00000863> a owl:Class ;
    rdfs:label "Act of Confessing"@en ;
    rdfs:subClassOf <https://www.commoncoreontologies.org/ont00000379> ;
    skos:definition "An Act of Representative Communication in which a person makes an admission of misdeeds or faults."@en .

<https://www.commoncoreontologies.org/ont00000864> a owl:Class ;
    rdfs:label "Public Safety Artifact Function"@en ;
    rdfs:subClassOf <https://www.commoncoreontologies.org/ont00001301> ;
    skos:definition "A Service Artifact Function that is realized in processes of preventing and responding to events that could endanger the safety of the general public from significant danger, injury/harm, or damage, such as crimes or disasters (natural or man-made)."@en .

<https://www.commoncoreontologies.org/ont00000866> a owl:Class ;
    rdfs:label "Radio Broadcast"@en ;
    rdfs:subClassOf <https://www.commoncoreontologies.org/ont00000517> ;
    skos:definition "An Act of Communciation by Media that is transmitted to an audience through a radio network."@en .

<https://www.commoncoreontologies.org/ont00000867> a owl:Class ;
    rdfs:label "Pipeline"@en ;
    rdfs:subClassOf <https://www.commoncoreontologies.org/ont00000677> ;
    skos:definition "A Product Transport Facility that is designed to transport goods or materials through a pipe."@en .

<https://www.commoncoreontologies.org/ont00000868> a owl:Class ;
    rdfs:label "Rocket Pod"@en ;
    rdfs:subClassOf <https://www.commoncoreontologies.org/ont00001173> ;
    skos:definition "A Rocket Launcher that is designed to contain several Unguided Rockets held in individual tubes and to be used by Aircraft or Helicopters for close air support."@en .

<https://www.commoncoreontologies.org/ont00000869> a owl:Class ;
    rdfs:label "Optical Camera"@en ;
    rdfs:subClassOf <https://www.commoncoreontologies.org/ont00000199> ;
    skos:definition "A Camera that is designed to form and record an image generated from visible light."@en .

<https://www.commoncoreontologies.org/ont00000871> a owl:Class ;
    rdfs:label "Plant"@en ;
    rdfs:subClassOf <https://www.commoncoreontologies.org/ont00000551> ;
    skos:definition "An Organism that is multicellular, eukaryotic, autotrophic, and has cells that contain chloroplasts and walls made of cellulose."@en .

<https://www.commoncoreontologies.org/ont00000872> a owl:Class ;
    rdfs:label "Brown"@en ;
    rdfs:subClassOf <https://www.commoncoreontologies.org/ont00000378> ;
    skos:definition "A Color that consists of dark orange and red, and of very low intensity."@en .

<https://www.commoncoreontologies.org/ont00000873> a owl:Class ;
    rdfs:label "Physiographic Feature"@en ;
    rdfs:subClassOf <https://www.commoncoreontologies.org/ont00001081> ;
    skos:definition "A Geographic Feature that is a geomorphological unit characterized by its surface form and location in the landscape."@en .

<https://www.commoncoreontologies.org/ont00000874> a owl:Class ;
    rdfs:label "Material Copy of a Video"@en ;
    rdfs:subClassOf <https://www.commoncoreontologies.org/ont00000798> ;
    skos:definition "An Information Bearing Artifact that is designed to carry some specific Information Content Entity in the form of a sequence of representations that are presented sufficiently rapidly to create the appearance of motion and continuity."@en .

<https://www.commoncoreontologies.org/ont00000875> a owl:Class ;
    rdfs:label "Act of Personal Communication"@en ;
    rdfs:subClassOf <https://www.commoncoreontologies.org/ont00000402> ;
    skos:definition "An Act of Communication having a small audience."@en .

<https://www.commoncoreontologies.org/ont00000877> a owl:Class ;
    rdfs:label "Brake Control System"@en ;
    rdfs:subClassOf <https://www.commoncoreontologies.org/ont00000723> ;
    skos:definition "A Vehicle Control System that is designed to control the process of braking with the aim of preventing rolling, skidding, and hydroplaning."@en .

<https://www.commoncoreontologies.org/ont00000878> a owl:Class ;
    rdfs:label "Identification Friend or Foe Transponder"@en ;
    rdfs:subClassOf <https://www.commoncoreontologies.org/ont00000325> ;
    skos:definition "A Radio Transponder that is designed to automatically transmit a predefined signal in response to receiving an appropriate interrogation signal such that the entity it is located on can be positively identified as friendly."@en .

<https://www.commoncoreontologies.org/ont00000879> a owl:Class ;
    rdfs:label "Act of Religious Group Affiliation"@en ;
    rdfs:subClassOf <https://www.commoncoreontologies.org/ont00000433> ;
    skos:definition "An Act of Association wherein some Person belongs to some Religious Demonination or sub-Denomination."@en .

<https://www.commoncoreontologies.org/ont00000880> a owl:Class ;
    rdfs:label "Religious Artifact Function"@en ;
    rdfs:subClassOf <https://www.commoncoreontologies.org/ont00001301> ;
    skos:definition "A Service Artifact Function that is realized in processes related to worship and prayer."@en .

<https://www.commoncoreontologies.org/ont00000882> a owl:Class ;
    rdfs:label "Wind Farm"@en ;
    rdfs:subClassOf <https://www.commoncoreontologies.org/ont00001076> ;
    skos:definition "An Electric Power Station that is designed to convert the wind's kinetic energy into electrical power by means of wind turbines."@en .

<https://www.commoncoreontologies.org/ont00000883> a owl:Class ;
    rdfs:label "Act of Inviting"@en ;
    rdfs:subClassOf <https://www.commoncoreontologies.org/ont00001162> ;
    skos:definition "An Act of Commissive Communication performed by requesting the presence or participation of the audience, and which may include offering an incentive or inducement."@en .

<https://www.commoncoreontologies.org/ont00000884> a owl:Class ;
    rdfs:label "Act of Loaning"@en ;
    rdfs:subClassOf <https://www.commoncoreontologies.org/ont00000836> ;
    skos:definition "An Act of Financial Instrument Use wherein a Financial Instrument is given by an Agent (the Creditor) to another Agent (the Debtor) in order to receive Repayments from the Debtor which are of greater Financial Value."@en .

<https://www.commoncoreontologies.org/ont00000885> a owl:Class ;
    rdfs:label "Wavy"@en ;
    rdfs:subClassOf <https://www.commoncoreontologies.org/ont00001059> ;
    skos:definition "A Shape Quality inhering in a bearer in virtue of it having a sinuous or rippled border."@en .

<https://www.commoncoreontologies.org/ont00000886> a owl:Class ;
    rdfs:label "Wired Communication Reception Artifact Function"@en ;
    rdfs:subClassOf <https://www.commoncoreontologies.org/ont00000422> ;
    skos:definition "A Communication Reception Artifact Function that is realized during events in which a Material Artifact receives information transmitted from another Material Artifact, where the transmission of information occurs via a direct connection using an electrical conductor."@en .

<https://www.commoncoreontologies.org/ont00000887> a owl:Class ;
    rdfs:label "City"@en ;
    rdfs:subClassOf <https://www.commoncoreontologies.org/ont00000460> ;
    skos:definition "A Local Administrative Region in which a relatively large human population permanently resides; is designated as a city based on a particular administrative, legal, or historical status; and which delimits a local Government that typically oversees the provision of systems for sanitation, utilities, land usage, housing, and transportation."@en .

<https://www.commoncoreontologies.org/ont00000888> a owl:Class ;
    rdfs:label "High Frequency Communication Instrument"@en ;
    rdfs:subClassOf <https://www.commoncoreontologies.org/ont00000903> ;
    skos:definition "A Radio Communication Instrument that is designed to participate in some process that has process part some High Frequency."@en .

<https://www.commoncoreontologies.org/ont00000889> a owl:Class ;
    rdfs:label "Visible Observation"@en ;
    rdfs:subClassOf <https://www.commoncoreontologies.org/ont00000037> ;
    skos:definition "An Act of Observation that involves visual perception."@en .

<https://www.commoncoreontologies.org/ont00000895> a owl:Class ;
    rdfs:label "Married"@en ;
    rdfs:subClassOf <https://www.commoncoreontologies.org/ont00000335> ;
    skos:definition "A Stasis of Generically Dependent Continuant that consists of a socially, culturally, or ritually recognized union or legal contract between spouses that establishes rights and obligations between them, between them and their children, and between them and their in-laws."@en .

<https://www.commoncoreontologies.org/ont00000896> a owl:Class ;
    rdfs:label "Mean Point Estimate Information Content Entity"@en ;
    rdfs:subClassOf <https://www.commoncoreontologies.org/ont00000745> ;
    skos:definition "A Point Estimate Information Content Entity that is a measurement of a set of values and is equal to the sum of all the values in the set divided by the total number of values in the set."@en .

<https://www.commoncoreontologies.org/ont00000897> a owl:Class ;
    rdfs:label "Portion of Oxidizer"@en ;
    rdfs:subClassOf <https://www.commoncoreontologies.org/ont00000457> ;
    skos:definition "A Portion of Material that is disposed to steal electrons from other substances (i.e. to oxidize other substances) as a participant in a reduction-oxidation process."@en .

<https://www.commoncoreontologies.org/ont00000898> a owl:Class ;
    rdfs:label "Geopolitical Power Role"@en ;
    rdfs:subClassOf <http://purl.obolibrary.org/obo/BFO_0000023> ;
    skos:definition "A Role had by an Organization, that is perceived by an International Community as capable of performing influential acts in that community, and which would be realized in performing such acts."@en .

<https://www.commoncoreontologies.org/ont00000900> a owl:Class ;
    rdfs:label "Radio Communication Relay Artifact Function"@en ;
    rdfs:subClassOf <https://www.commoncoreontologies.org/ont00001169> ;
    skos:definition "A Communication Relay Artifact Function that is realized during events in which a Material Artifact is used to first receive and then transmit information without the use of wires from one Material Artifact to another for the purpose of communiction."@en .

<https://www.commoncoreontologies.org/ont00000901> a owl:Class ;
    rdfs:label "Decontamination Facility"@en ;
    rdfs:subClassOf <https://www.commoncoreontologies.org/ont00001375> ;
    skos:definition "A Washing Facility that is designed to wash personnel or equipment after (potential) contamination by radioactive, biological, or chemical material."@en .

<https://www.commoncoreontologies.org/ont00000902> a owl:Class ;
    rdfs:label "Act of Facility Use"@en ;
    rdfs:subClassOf <https://www.commoncoreontologies.org/ont00000566> ;
    skos:definition "An Act of Artifact Employment in which an Agent makes use of some Facility."@en .

<https://www.commoncoreontologies.org/ont00000904> a owl:Class ;
    rdfs:label "Vehicle Track"@en ;
    rdfs:subClassOf <https://www.commoncoreontologies.org/ont00000205> ;
    skos:definition "An Object Track for a Vehicle during some motion."@en .

<https://www.commoncoreontologies.org/ont00000905> a owl:Class ;
    rdfs:label "Post Office"@en ;
    rdfs:subClassOf <https://www.commoncoreontologies.org/ont00000655> ;
    skos:definition "A Mailing Facility that is designed for serving customers of the national postal system."@en .

<https://www.commoncoreontologies.org/ont00000906> a owl:Class ;
    rdfs:label "Email Box"@en ;
    rdfs:subClassOf <https://www.commoncoreontologies.org/ont00000690> ;
    skos:definition "A Telecommunication Instrument that is designed to be the delivery destination of Email Messages that are addressed to the corresponding Email Address."@en .

<https://www.commoncoreontologies.org/ont00000909> a owl:Class ;
    rdfs:label "Emergency AC/DC Power Source"@en ;
    rdfs:subClassOf <https://www.commoncoreontologies.org/ont00001049> ;
    skos:definition "An Electrical Power Source that is designed to provide electrical power in an emergency situation by means of both alternating current and direct current."@en .

<https://www.commoncoreontologies.org/ont00000910> a owl:Class ;
    rdfs:label "Amplitude"@en ;
    rdfs:subClassOf <http://purl.obolibrary.org/obo/BFO_0000144> ;
    skos:definition "A Process Profile of an Oscillation Process that is the absolute value of the maximum displacement from a zero, equilibrium, or mean value during one cycle of the Oscillation Process."@en .

<https://www.commoncoreontologies.org/ont00000911> a owl:Class ;
    rdfs:label "Semi-Major Axis"@en ;
    rdfs:subClassOf <http://purl.obolibrary.org/obo/BFO_0000026> ;
    skos:definition "A One-Dimensional Spatial Region that is equal to half the length of the Major Axis of an Ellipse."@en .

<https://www.commoncoreontologies.org/ont00000912> a owl:Class ;
    rdfs:label "Pyramidal"@en ;
    rdfs:subClassOf <https://www.commoncoreontologies.org/ont00001360> ;
    skos:definition "A Three Dimensional Shape that inheres in a bearer in virtue of it having a polygonal base with vertices that all connect to the same apex to form triangular faces."@en .

<https://www.commoncoreontologies.org/ont00000913> a owl:Class ;
    rdfs:label "Maroon"@en ;
    rdfs:subClassOf <https://www.commoncoreontologies.org/ont00000378> ;
    skos:definition "A Color consisting of purple and brown hue."@en .

<https://www.commoncoreontologies.org/ont00000915> a owl:Class ;
    rdfs:label "Acronym"@en ;
    rdfs:subClassOf <https://www.commoncoreontologies.org/ont00000605> ;
    skos:definition "An Abbreviated Name that combines the initial letters of a Designative Name and which is pronounced as a word."@en .

<https://www.commoncoreontologies.org/ont00000916> a owl:Class ;
    rdfs:label "Lunar Calendar System"@en ;
    rdfs:subClassOf <https://www.commoncoreontologies.org/ont00000891> ;
    skos:definition "A Calendar System that is designed to organize and identify dates based on the cycles of the Moon's phases."@en .

<https://www.commoncoreontologies.org/ont00000917> a owl:Class ;
    rdfs:label "Permanent Resident Role"@en ;
    rdfs:subClassOf <http://purl.obolibrary.org/obo/BFO_0000023> ;
    skos:definition "A role inhering in a Person by virtue of that Person being recognized as having legal resident status in a Government Domain in which that person is not a citizen but where they have the right to reside on a permanent basis."@en .

<https://www.commoncoreontologies.org/ont00000919> a owl:Class ;
    rdfs:label "Parts List"@en ;
    rdfs:subClassOf <https://www.commoncoreontologies.org/ont00000575> ;
    skos:definition "A Quality Specification that prescribes the Amount of some type of Material Artifact that are part of or located on another Material Artifact."@en .

<https://www.commoncoreontologies.org/ont00000920> a owl:Class ;
    rdfs:label "Death"@en ;
    rdfs:subClassOf <https://www.commoncoreontologies.org/ont00000007> ;
    skos:definition "A Natural Process in which all biological functions that sustain a living organism cease."@en .

<https://www.commoncoreontologies.org/ont00000922> a owl:Class ;
    rdfs:label "Act of Arrival"@en ;
    rdfs:subClassOf <https://www.commoncoreontologies.org/ont00000065> ;
    skos:definition "An Act of Location Change that consists of the participating entity reaching its destination such that the larger Act of Location Change is completed."@en .

<https://www.commoncoreontologies.org/ont00000924> a owl:Class ;
    rdfs:label "Beginning of Life Stasis"@en ;
    rdfs:subClassOf <https://www.commoncoreontologies.org/ont00001191> ;
    skos:definition "A Operational Stasis that holds during a Temporal Interval when a Material Artifact is first put into operational use such that its designed set of Artifact Functions is capable of operating at or near their designed peak performance levels."@en .

<https://www.commoncoreontologies.org/ont00000925> a owl:Class ;
    rdfs:label "Act of Military Training Acquisition"@en ;
    rdfs:subClassOf <https://www.commoncoreontologies.org/ont00000687> ;
    skos:definition "An Act of Training Acquisition performed by an Agent by acquiring knowledge of the tactics, techniques, and/or strategies of Military Operations from an Agent or communication medium that realizes a capacity derived from its affiliation with a Military Organization."@en .

<https://www.commoncoreontologies.org/ont00000926> a owl:Class ;
    rdfs:label "Act of Apologizing"@en ;
    rdfs:subClassOf <https://www.commoncoreontologies.org/ont00000123> ;
    skos:definition "An Act of Expressive Communication performed by acknowledging and expressing regret for a fault, shortcoming, or failure."@en .

<https://www.commoncoreontologies.org/ont00000927> a owl:Class ;
    rdfs:label "Bass Frequency"@en ;
    rdfs:subClassOf <https://www.commoncoreontologies.org/ont00000530> ;
    skos:definition "A Sonic Frequency that is between 60 and 250 Hz."@en .

<https://www.commoncoreontologies.org/ont00000929> a owl:Class ;
    rdfs:label "Part Role"@en ;
    rdfs:subClassOf <http://purl.obolibrary.org/obo/BFO_0000023> ;
    skos:definition "A Role that inheres in an entity in virtue of it being part of some other entity without being subject to further subdivision or disassembly without destruction of its designated use."@en .

<https://www.commoncoreontologies.org/ont00000930> a owl:Class ;
    rdfs:label "Nickel-metal Hydride Electric Battery"@en ;
    rdfs:subClassOf <https://www.commoncoreontologies.org/ont00001105> ;
    skos:definition "A Secondary Cell Electric Battery that has a metal-hydride anode and nickel oxide hydroxide cathode."@en .

<https://www.commoncoreontologies.org/ont00000932> a owl:Class ;
    rdfs:label "Computing Artifact Function"@en ;
    rdfs:subClassOf <https://www.commoncoreontologies.org/ont00000323> ;
    skos:definition "An Artifact Function that is realized by a Material Artifact participating in a computation process."@en .

<https://www.commoncoreontologies.org/ont00000933> a owl:Class ;
    rdfs:label "Landline Telephone"@en ;
    rdfs:subClassOf <https://www.commoncoreontologies.org/ont00000907> ;
    skos:definition "A Telephone that is connected to a Telephone Network through a pair of wires."@en .

<https://www.commoncoreontologies.org/ont00000934> a owl:Class ;
    rdfs:label "Constituent State"@en ;
    rdfs:subClassOf <https://www.commoncoreontologies.org/ont00000126> ;
    skos:definition "A First-Order Administrative Region that is part of a Country and delimits a centralized regional Government that holds constitutionally-defined administrative jurisdiction over the defined geographic territory that bounds the State."@en .

<https://www.commoncoreontologies.org/ont00000935> a owl:Class ;
    rdfs:label "Act of Legal Instrument Use"@en ;
    rdfs:subClassOf <https://www.commoncoreontologies.org/ont00000566> ;
    skos:definition "An Act of Artifact Employment in which some Agent uses some Legal Instrument."@en .

<https://www.commoncoreontologies.org/ont00000937> a owl:Class ;
    rdfs:label "Inhibiting Motion Artifact Function"@en ;
    rdfs:subClassOf <https://www.commoncoreontologies.org/ont00000323> ;
    skos:definition "An Artifact Function that is realized by processes in which some Material Artifact is used to inhibit the motion of some object."@en .

<https://www.commoncoreontologies.org/ont00000938> a owl:Class ;
    rdfs:label "Financial Artifact Function"@en ;
    rdfs:subClassOf <https://www.commoncoreontologies.org/ont00001301> ;
    skos:definition "A Service Artifact Function that is realized in processes of managing money."@en .

<https://www.commoncoreontologies.org/ont00000939> a owl:Class ;
    rdfs:label "Geospatial Line"@en ;
    rdfs:subClassOf <https://www.commoncoreontologies.org/ont00000817> ;
    skos:definition "A Geospatial Line String that has only two vertices."@en .

<https://www.commoncoreontologies.org/ont00000940> a owl:Class ;
    rdfs:label "Measurement Unit of Momentum"@en ;
    rdfs:subClassOf <https://www.commoncoreontologies.org/ont00000120> ;
    skos:definition "A Measurement Unit that is used as a standard for measurement of the Momentum of a portion of matter that is in Motion."@en .

<https://www.commoncoreontologies.org/ont00000941> a owl:Class ;
    rdfs:label "Phosphorescence"@en ;
    rdfs:subClassOf <https://www.commoncoreontologies.org/ont00001126> ;
    skos:definition "A Luminescent Property that inheres in a bearer in virtue of that bearer's capacity to emit visible light after absorbing shorter wavelength radiation, and to continue emitting after the absorbing process has ceased."@en .

<https://www.commoncoreontologies.org/ont00000942> a owl:Class ;
    rdfs:label "Sniper Rifle"@en ;
    rdfs:subClassOf <https://www.commoncoreontologies.org/ont00000204> ;
    skos:definition "A Rifle that is designed to be highly accurate for long-range precision tactical shooting."@en .

<https://www.commoncoreontologies.org/ont00000943> a owl:Class ;
    rdfs:label "Ocular Prosthesis"@en ;
    rdfs:subClassOf <https://www.commoncoreontologies.org/ont00001248> ;
    skos:definition "An Artificial Eye that is designed to replace a missing eye, but which does not function as an eye."@en .

<https://www.commoncoreontologies.org/ont00000944> a owl:Class ;
    rdfs:label "Thermal Imaging Artifact Function"@en ;
    rdfs:subClassOf <https://www.commoncoreontologies.org/ont00000601> ;
    skos:definition "An Imaging Artifact Function that is realized during events in which a Material Artifact is used to create a visual representation of an entity using radiation from the far infrared region of the electromagnetic spectrum that the entity emits"@en .

<https://www.commoncoreontologies.org/ont00000945> a owl:Class ;
    rdfs:label "X-ray Telescope"@en ;
    rdfs:subClassOf <https://www.commoncoreontologies.org/ont00000547> ;
    skos:definition "A Telescope that is designed to aid in the observation of spatially distant Objects by means of collecting and focusing X-rays to form an enhanced image of the Object."@en .

<https://www.commoncoreontologies.org/ont00000947> a owl:Class ;
    rdfs:label "Temperature Measurement Artifact Function"@en ;
    rdfs:subClassOf <https://www.commoncoreontologies.org/ont00001100> ;
    skos:definition "A Measurement Artifact Function that is realized during events in which a Material Artifact is used to measure the Temperature of a specified object or class of objects."@en .

<https://www.commoncoreontologies.org/ont00000948> a owl:Class ;
    rdfs:label "Act of Religious Worship"@en ;
    rdfs:subClassOf <https://www.commoncoreontologies.org/ont00000455> ;
    skos:definition "An Act of Ceremony wherein there occurs acts of religious devotion usually directed towards a deity."@en .

<https://www.commoncoreontologies.org/ont00000949> a owl:Class ;
    rdfs:label "Act of Consumption"@en ;
    rdfs:subClassOf <https://www.commoncoreontologies.org/ont00000228> ;
    skos:definition "A Planned Act in which a resource is ingested or used up."@en .

<https://www.commoncoreontologies.org/ont00000950> a owl:Class ;
    rdfs:label "Act of Maintenance"@en ;
    rdfs:subClassOf <https://www.commoncoreontologies.org/ont00000970> ;
    skos:definition "An Act of Artifact Modification in which a Material Artifact is modified in order to preserve or restore one or more of its designed Qualities or Functions."@en .

<https://www.commoncoreontologies.org/ont00000952> a owl:Class ;
    rdfs:label "Electric Motor"@en ;
    rdfs:subClassOf <https://www.commoncoreontologies.org/ont00000210> ;
    skos:definition "An Engine that is designed to convert electrical energy into mechanical energy."@en .

<https://www.commoncoreontologies.org/ont00000953> a owl:Class ;
    rdfs:label "Pitch"@en ;
    rdfs:subClassOf <https://www.commoncoreontologies.org/ont00000862> ;
    skos:definition "A Sound Process Profile that is characterized by the frequency of translated sound waves, typically on a continuum from low to high."@en .

<https://www.commoncoreontologies.org/ont00000954> a owl:Class ;
    rdfs:label "Telecommunication Infrastructure"@en ;
    rdfs:subClassOf <https://www.commoncoreontologies.org/ont00000870> ;
    skos:definition "An Infrastructure System that is designed to support the use of Telecommunication Instruments to communicate."@en .

<https://www.commoncoreontologies.org/ont00000955> a owl:Class ;
    rdfs:label "Angular Momentum"@en ;
    rdfs:subClassOf <https://www.commoncoreontologies.org/ont00000278> ;
    skos:definition "A Momentum that is the product of an object's moment of inertia and its Angular Velocity."@en .

<https://www.commoncoreontologies.org/ont00000956> a owl:Class ;
    rdfs:label "Highway Interchange"@en ;
    rdfs:subClassOf <https://www.commoncoreontologies.org/ont00001086> ;
    skos:definition "A Road Junction that is designed to enable Ground Vehicles to exit one or more Highways and enter another Highway without directly crossing any other traffic stream."@en .

<https://www.commoncoreontologies.org/ont00000957> a owl:Class ;
    rdfs:label "Reservoir"@en ;
    rdfs:subClassOf <https://www.commoncoreontologies.org/ont00000881> ;
    skos:definition "A Storage Facility that is designed to store water in a man-made open enclosure or area."@en .

<https://www.commoncoreontologies.org/ont00000959> a owl:Class ;
    rdfs:label "Measurement Unit of Frequency"@en ;
    rdfs:subClassOf <https://www.commoncoreontologies.org/ont00000120> ;
    skos:definition "A Measurement Unit that is used as a standard for measurement of the number of times an event repeats per unit of time."@en .

<https://www.commoncoreontologies.org/ont00000960> a owl:Class ;
    rdfs:label "Fixed Line Network Telephone Call"@en ;
    rdfs:subClassOf <https://www.commoncoreontologies.org/ont00001190> ;
    skos:definition "A Telephone Call transmitted over a telephone network where the telephones are wired into a single telephone exchange."@en .

<https://www.commoncoreontologies.org/ont00000962> a owl:Class ;
    rdfs:label "Portion of Liquid Propellant"@en ;
    rdfs:subClassOf <https://www.commoncoreontologies.org/ont00000593> ;
    skos:definition "A Portion of Propellant that is stored in a liquid state."@en .

<https://www.commoncoreontologies.org/ont00000963> a owl:Class ;
    rdfs:label "Fuel Transfer System"@en ;
    rdfs:subClassOf <https://www.commoncoreontologies.org/ont00000256> ;
    skos:definition "A Fluid Control Artifact that is designed to facilitate the transfer of some Portion of Fuel from the Fuel Tank for use in some Engine."@en .

<https://www.commoncoreontologies.org/ont00000964> a owl:Class ;
    rdfs:label "Medium Frequency"@en ;
    rdfs:subClassOf <https://www.commoncoreontologies.org/ont00000150> ;
    skos:definition "A Radio Frequency that is between 300 kHz and 3 MHz."@en .

<https://www.commoncoreontologies.org/ont00000968> a owl:Class ;
    rdfs:label "Assault Rifle"@en ;
    rdfs:subClassOf <https://www.commoncoreontologies.org/ont00000204> ;
    skos:definition "A Rifle that is designed to have selective-fire functionality and use an intermediate Cartridge and a detachable magazine."@en .

<https://www.commoncoreontologies.org/ont00000969> a owl:Class ;
    rdfs:label "Measurement Unit of Speed"@en ;
    rdfs:subClassOf <https://www.commoncoreontologies.org/ont00000120> ;
    skos:definition "A Measurement Unit that is used as a standard for measurement of the rates at which objects traverse distance."@en .

<https://www.commoncoreontologies.org/ont00000974> a owl:Class ;
    rdfs:label "Plan"@en ;
    rdfs:subClassOf <https://www.commoncoreontologies.org/ont00000965> ;
    skos:definition "A Prescriptive Information Content Entity that prescribes some set of intended Intentional Acts through which some Agent expects to achieve some Objective."@en .

<https://www.commoncoreontologies.org/ont00000975> a owl:Class ;
    rdfs:label "Cyan"@en ;
    rdfs:subClassOf <https://www.commoncoreontologies.org/ont00000378> ;
    skos:definition "A Color that is between Green and Blue with a wavelength in the visible spectrum typically between 490 and 520 nanometers."@en .

<https://www.commoncoreontologies.org/ont00000976> a owl:Class ;
    rdfs:label "Political Orientation"@en ;
    rdfs:subClassOf <https://www.commoncoreontologies.org/ont00000696> ;
    skos:definition "An Ideology that characterizes the political thinking of an Agent or Group of Agents, usually with respect to the political environment within a particular nation."@en .

<https://www.commoncoreontologies.org/ont00000977> a owl:Class ;
    rdfs:label "Act of Publishing Mass Media Documentary"@en ;
    rdfs:subClassOf <https://www.commoncoreontologies.org/ont00000588> ;
    skos:definition "An Act of Mass Media Communication involving the preparation and public issuance of information that provides a factual record or report."@en .

<https://www.commoncoreontologies.org/ont00000978> a owl:Class ;
    rdfs:label "Cause"@en ;
    rdfs:subClassOf <http://purl.obolibrary.org/obo/BFO_0000015> ;
    skos:definition "A Process that is the cause of or one of the causes of some other Process."@en .

<https://www.commoncoreontologies.org/ont00000979> a owl:Class ;
    rdfs:label "Closure"@en ;
    rdfs:subClassOf <http://purl.obolibrary.org/obo/BFO_0000019> ;
    skos:definition "A Quality that inheres in a bearer in virtue of the degree to which that bearer affords passage or sightline through it via an opening, aperture, orifice, or vent."@en .

<https://www.commoncoreontologies.org/ont00000981> a owl:Class ;
    rdfs:label "Act of Portion of Material Consumption"@en ;
    rdfs:subClassOf <https://www.commoncoreontologies.org/ont00000566> ;
    skos:definition "An Act of Artifact Employment in which a Portion of Material is expended."@en .

<https://www.commoncoreontologies.org/ont00000982> a owl:Class ;
    rdfs:label "Decrease of Function"@en ;
    rdfs:subClassOf <https://www.commoncoreontologies.org/ont00000543> ;
    skos:definition "A Decrease of Disposition in which some Independent Continuant has a decrease of some Function that it bears."@en .

<https://www.commoncoreontologies.org/ont00000983> a owl:Class ;
    rdfs:label "Shear Wave Process"@en ;
    rdfs:subClassOf <https://www.commoncoreontologies.org/ont00001028> ;
    skos:definition "A Mechanical Wave that has a Transverse Wave Profile."@en .

<https://www.commoncoreontologies.org/ont00000984> a owl:Class ;
    rdfs:label "Occupation Role"@en ;
    rdfs:subClassOf <http://purl.obolibrary.org/obo/BFO_0000023> ;
    skos:definition "A Role that inheres in an Agent in virtue of the responsibilities that Agent is expected to fulfill within the context of some Act of Employment."@en .

<https://www.commoncoreontologies.org/ont00000985> a owl:Class ;
    rdfs:label "Thermal Insulation Artifact Function"@en ;
    rdfs:subClassOf <https://www.commoncoreontologies.org/ont00001350> ;
    skos:definition "A Thermal Control Artifact Function that is realized during events in which a Material Artifact prevents or reduces the transfer of heat between objects that are in thermal contact or in range of radiative influence."@en .

<https://www.commoncoreontologies.org/ont00000986> a owl:Class ;
    rdfs:label "Scar"@en ;
    rdfs:subClassOf <https://www.commoncoreontologies.org/ont00000084> ;
    skos:definition "A Bodily Component that consists of a portion of fibrous connective tissue on skin or within body tissue and which was formed due to an injury that has not healed completely."@en .

<https://www.commoncoreontologies.org/ont00000987> a owl:Class ;
    rdfs:label "Citizen Role"@en ;
    rdfs:subClassOf <http://purl.obolibrary.org/obo/BFO_0000023> ;
    skos:definition "A Role that inheres in a Person by virtue of that Person being legally recognized as a member of a particular state, with associated rights and obligations."@en .

<https://www.commoncoreontologies.org/ont00000988> a owl:Class ;
    rdfs:label "Reflective Prism"@en ;
    rdfs:subClassOf <https://www.commoncoreontologies.org/ont00000804> ;
    skos:definition "A Prism designed to reflect light in order to flip, invert, rotate, deviate, or displace a beam of light entering the Prism."@en .

<https://www.commoncoreontologies.org/ont00000989> a owl:Class ;
    rdfs:label "Super High Frequency"@en ;
    rdfs:subClassOf <https://www.commoncoreontologies.org/ont00000732> ;
    skos:definition "A Microwave Frequency that is between 3 and 30 GHz."@en .

<https://www.commoncoreontologies.org/ont00000990> a owl:Class ;
    rdfs:label "Nickname"@en ;
    rdfs:subClassOf <https://www.commoncoreontologies.org/ont00000003> ;
    skos:definition "A Designative Name that is a familiar or humorous substitute for an entity's Proper Name."@en .

<https://www.commoncoreontologies.org/ont00000991> a owl:Class ;
    rdfs:label "Bent"@en ;
    rdfs:subClassOf <https://www.commoncoreontologies.org/ont00001059> ;
    skos:definition "A Shape Quality inhering in a bearer in virtue of the bearer having one or more angles along its border."@en .

<https://www.commoncoreontologies.org/ont00000992> a owl:Class ;
    rdfs:label "Second"@en ;
    rdfs:subClassOf <http://purl.obolibrary.org/obo/BFO_0000202> ;
    skos:definition "A Temporal Interval that is equal to the duration of 9,192,631,770 periods of the radiation corresponding to the transition between the two hyperfine levels of the ground state of the cesium 133 atom."@en .

<https://www.commoncoreontologies.org/ont00000993> a owl:Class ;
    rdfs:label "Power Rectifying Artifact Function"@en ;
    rdfs:subClassOf <https://www.commoncoreontologies.org/ont00000961> ;
    skos:definition "A Current Conversion Artifact Function that is realized by processes in which some Material Artifact is used to convert alternating current (AC) to direct current (DC)."@en .

<https://www.commoncoreontologies.org/ont00000994> a owl:Class ;
    rdfs:label "Electrical Power Production Artifact Function"@en ;
    rdfs:subClassOf <https://www.commoncoreontologies.org/ont00000098> ;
    skos:definition "An Electrical Artifact Function that is realized during events in which a Material Artifact is used to generate electrical power."@en .

<https://www.commoncoreontologies.org/ont00000996> a owl:Class ;
    rdfs:label "Ramjet Engine"@en ;
    rdfs:subClassOf <https://www.commoncoreontologies.org/ont00000294> ;
    skos:definition "An Air-Breathing Jet Engine that uses the forward motion of the Engine to compress incoming air (without the use of an axial compressor) and decelerate it to subsonic speeds before adding the fuel and constantly combusting the mixture then expelling the exhaust out through the rear Propelling Nozzle to generate Thrust."@en .

<https://www.commoncoreontologies.org/ont00000999> a owl:Class ;
    rdfs:label "Defunct Stasis"@en ;
    rdfs:subClassOf <https://www.commoncoreontologies.org/ont00001213> ;
    owl:disjointWith <https://www.commoncoreontologies.org/ont00001191> ;
    skos:definition "A Stasis of Artifact Operationality that holds during a Temporal Interval when a Material Artifact no longer maintains its designed set of Artifact Functions (or at least no longer maintains its primary functions)."@en .

<https://www.commoncoreontologies.org/ont00001000> a owl:Class ;
    rdfs:label "Spray Nozzle"@en ;
    rdfs:subClassOf <https://www.commoncoreontologies.org/ont00000252> ;
    skos:definition "A Nozzle that is designed to facilitate a conversion of the flow of a portion of liquid into a dynamic collection of drops dispersed in a portion of gas."@en .

<https://www.commoncoreontologies.org/ont00001001> a owl:Class ;
    rdfs:label "Drooping"@en ;
    rdfs:subClassOf <https://www.commoncoreontologies.org/ont00001059> ;
    skos:definition "A Shape Quality inhering in a bearer in virtue of the bearer having a border that hangs downwards."@en .

<https://www.commoncoreontologies.org/ont00001003> a owl:Class ;
    rdfs:label "Cartridge"@en ;
    rdfs:subClassOf <https://www.commoncoreontologies.org/ont00001150> ;
    skos:definition "A Portion of Ammunition that is designed to package a Bullet, a propellant substance, and a primer within a case that is designed to fit within the firing chamber of a Firearm."@en .

<https://www.commoncoreontologies.org/ont00001004> a owl:Class ;
    rdfs:label "Measurement Unit of Electromagnetic Force"@en ;
    rdfs:subClassOf <https://www.commoncoreontologies.org/ont00000120> ;
    skos:definition "A Measurement Unit that is used as a standard for measurement of the electromagnetic force between electrically charged entities."@en .

<https://www.commoncoreontologies.org/ont00001005> a owl:Class ;
    rdfs:label "Turbojet Air-Breathing Jet Engine"@en ;
    rdfs:subClassOf <https://www.commoncoreontologies.org/ont00000294> ;
    skos:definition "An Air-Breathing Jet Engine that uses a Turbojet, which consists of a Turbine with a Propelling Nozzle."@en .

<https://www.commoncoreontologies.org/ont00001006> a owl:Class ;
    rdfs:label "Operator Role"@en ;
    rdfs:subClassOf <http://purl.obolibrary.org/obo/BFO_0000023> ;
    skos:definition "A Role that inheres in an Agent by virtue of that Agent's responsibilities to operate or control some Material Artifact."@en .

<https://www.commoncoreontologies.org/ont00001007> a owl:Class ;
    rdfs:label "Passenger Train Car"@en ;
    rdfs:subClassOf <https://www.commoncoreontologies.org/ont00000928> ;
    skos:definition "A Train Car that is designed to transport passengers."@en .

<https://www.commoncoreontologies.org/ont00001008> a owl:Class ;
    rdfs:label "Biological Weapon"@en ;
    rdfs:subClassOf <https://www.commoncoreontologies.org/ont00000445> ;
    skos:definition "A Weapon that is designed to inflict harm, incapacity, or death by means of releasing disease-producing agents—such as bacteria, viruses, or fungi."@en .

<https://www.commoncoreontologies.org/ont00001011> a owl:Class ;
    rdfs:label "Automobile"@en ;
    rdfs:subClassOf <https://www.commoncoreontologies.org/ont00000053> ;
    skos:definition "A Ground Motor Vehicle that is designed to transport a small number of passengers while traveling on four tired wheels."@en .

<https://www.commoncoreontologies.org/ont00001013> a owl:Class ;
    rdfs:label "Heating Artifact Function"@en ;
    rdfs:subClassOf <https://www.commoncoreontologies.org/ont00000323> ;
    skos:definition "An Artifact Function that is realized in a process in which the thermal energy of a system increases."@en .

<https://www.commoncoreontologies.org/ont00001015> a owl:Class ;
    rdfs:label "Controlled-Access Highway"@en ;
    rdfs:subClassOf <https://www.commoncoreontologies.org/ont00000646> ;
    skos:definition "A Highway that is designed for high-speed vehicular traffic, with traffic flow and ingress/egress regulated."@en .

<https://www.commoncoreontologies.org/ont00001016> a owl:Class ;
    rdfs:label "Portion of Lithosphere"@en ;
    rdfs:subClassOf <http://purl.obolibrary.org/obo/BFO_0000024> ;
    skos:definition "A fiat object part of the rigid, outermost rocky shell of a natural satellite."@en .

<https://www.commoncoreontologies.org/ont00001018> a owl:Class ;
    rdfs:label "Equipment Cooling System"@en ;
    rdfs:subClassOf <https://www.commoncoreontologies.org/ont00000350> ;
    skos:definition "A Cooling System that is designed to cool some piece of equipment."@en .

<https://www.commoncoreontologies.org/ont00001019> a owl:Class ;
    rdfs:label "Steering Control System"@en ;
    rdfs:subClassOf <https://www.commoncoreontologies.org/ont00000723> ;
    skos:definition "A Vehicle Control System that is designed to control the direction some Vehicle is traveling."@en .

<https://www.commoncoreontologies.org/ont00001020> a owl:Class ;
    rdfs:label "Portion of Gaseous Fuel"@en ;
    rdfs:subClassOf <https://www.commoncoreontologies.org/ont00000838> ;
    skos:definition "A Portion of Fuel that is stored in a gaseous state."@en .

<https://www.commoncoreontologies.org/ont00001021> a owl:Class ;
    rdfs:label "Act of Denying"@en ;
    rdfs:subClassOf <https://www.commoncoreontologies.org/ont00000379> ;
    skos:definition "An Act of Representative Communication performed by either asserting that something is not true or real or refusing to satisfy a request or desire."@en .

<https://www.commoncoreontologies.org/ont00001023> a owl:Class ;
    rdfs:label "Calendar Week"@en ;
    rdfs:subClassOf <https://www.commoncoreontologies.org/ont00000619> ;
    skos:definition "A Week that begins and ends concurrently with the Days specified by a Calendar System to be the first and last Days of the Week."@en .

<https://www.commoncoreontologies.org/ont00001024> a owl:Class ;
    rdfs:label "Spark Ignition Engine"@en ;
    rdfs:subClassOf <https://www.commoncoreontologies.org/ont00000394> ;
    skos:definition "An Internal Combustion Engine that is designed to operate by generating a spark to ignite a portion of Fuel and Oxidizer mixture."@en .

<https://www.commoncoreontologies.org/ont00001025> a owl:Class ;
    rdfs:label "Electric Generator"@en ;
    rdfs:subClassOf <https://www.commoncoreontologies.org/ont00001049> ;
    skos:definition "An Electrical Power Source that is designed to convert mechanical energy to electrical energy for use in an external circuit."@en .

<https://www.commoncoreontologies.org/ont00001026> a owl:Class ;
    rdfs:label "Pointing Orientation"@en ;
    rdfs:subClassOf <https://www.commoncoreontologies.org/ont00000119> ;
    skos:definition "A Spatial Orientation of a Material Entity in which one or more of its designated components are oriented toward a specified direction."@en .

<https://www.commoncoreontologies.org/ont00001027> a owl:Class ;
    rdfs:label "Trim Tab"@en ;
    rdfs:subClassOf <https://www.commoncoreontologies.org/ont00000095> ;
    skos:definition "A Control Surface that is designed to counteract hydro-, aerodynamic, or other forces in order to stabilize the Vehicle it is part of in the desired Attitude."@en .

<https://www.commoncoreontologies.org/ont00001030> a owl:Class ;
    rdfs:label "Train"@en ;
    rdfs:subClassOf <https://www.commoncoreontologies.org/ont00000796> ;
    skos:definition "A Rail Transport Vehicle that consists of a series of connected Train Cars or Railcars."@en .

<https://www.commoncoreontologies.org/ont00001031> a owl:Class ;
    rdfs:label "Act of Volunteering"@en ;
    rdfs:subClassOf <https://www.commoncoreontologies.org/ont00001162> ;
    skos:definition "An Act of Commissive Communication performed by voluntarily undertaking or expressing a willingness to undertake a service."@en .

<https://www.commoncoreontologies.org/ont00001032> a owl:Class ;
    rdfs:label "Act of Assignment"@en ;
    rdfs:subClassOf <https://www.commoncoreontologies.org/ont00001374> ;
    skos:definition "An Act of Declarative Communication in which rights held by one party (the assignor) are transferred to another party (the assignee) with regard to a particular entity as specified by the details of the assignment, which is often prescribed by a contract."@en .

<https://www.commoncoreontologies.org/ont00001034> a owl:Class ;
    rdfs:label "Full Motion Video Camera"@en ;
    rdfs:subClassOf <https://www.commoncoreontologies.org/ont00000774> ;
    skos:definition "A Video Camera that is designed to capture and record images of sufficiently high quality and in rapid enough succession that the resulting video supports smooth playback."@en .

<https://www.commoncoreontologies.org/ont00001035> a owl:Class ;
    rdfs:label "Pitch Axis"@en ;
    rdfs:subClassOf <https://www.commoncoreontologies.org/ont00000387> ;
    skos:definition "An Axis of Rotation that passes through the center of an object's Mass and is perpendicular both to the direction of the object's motion and to the object's Yaw Axis."@en .

<https://www.commoncoreontologies.org/ont00001037> a owl:Class ;
    rdfs:label "Constructed Feature"@en ;
    rdfs:subClassOf <https://www.commoncoreontologies.org/ont00001197> ;
    skos:definition "An Anthropogenic Feature that has been constructed by deliberate human effort."@en .

<https://www.commoncoreontologies.org/ont00001038> a owl:Class ;
    rdfs:label "Nickel Cadmium Electric Battery"@en ;
    rdfs:subClassOf <https://www.commoncoreontologies.org/ont00001105> ;
    skos:definition "A Secondary Cell Electric Battery that has a cadmium anode and nickel oxide hydroxide cathode."@en .

<https://www.commoncoreontologies.org/ont00001039> a owl:Class ;
    rdfs:label "Act of Repayment"@en ;
    rdfs:subClassOf <https://www.commoncoreontologies.org/ont00000836> ;
    skos:definition "An Act of Financial Instrument Use wherein a Financial Instrument is transferred by an Agent (the Debtor) to another Agent (the Creditor) to decrease the amount the Debtor owes to the Creditor from an earlier Act of Loaning."@en .

<https://www.commoncoreontologies.org/ont00001040> a owl:Class ;
    rdfs:label "Nadir"@en ;
    rdfs:subClassOf <http://purl.obolibrary.org/obo/BFO_0000026> ;
    skos:definition "A One-Dimensional Spatial Region that extends from a given location downward along the local vertical direction pointing in the direction of the apparent Gravitational Force at that location."@en .

<https://www.commoncoreontologies.org/ont00001041> a owl:Class ;
    rdfs:label "Sequence Position Ordinality"@en ;
    rdfs:subClassOf <https://www.commoncoreontologies.org/ont00001010> ;
    skos:definition "An Ordinal Measurement Information Content Entity that is about the position of some entity in some ordered sequence."@en .

<https://www.commoncoreontologies.org/ont00001043> a owl:Class ;
    rdfs:label "Aircraft"@en ;
    rdfs:subClassOf <https://www.commoncoreontologies.org/ont00000713> ;
    skos:definition "A Vehicle that is designed to convey passengers, cargo, or equipment from one location to another by air travel."@en .

<https://www.commoncoreontologies.org/ont00001044> a owl:Class ;
    rdfs:label "Nuclear Radiation Detection Artifact Function"@en ;
    rdfs:subClassOf <https://www.commoncoreontologies.org/ont00000323> ;
    skos:definition "An Artifact Function that is realized during events in which a Material Artifact is used to detect the presence of nuclear radiation particles."@en .

<https://www.commoncoreontologies.org/ont00001045> a owl:Class ;
    rdfs:label "Artifact Model"@en ;
    rdfs:subClassOf <https://www.commoncoreontologies.org/ont00000319> ;
    skos:definition "A Prescriptive Information Content Entity that prescribes a common set of Functions and Qualities to inhere in a set of artifact instances."@en .

<https://www.commoncoreontologies.org/ont00001053> a owl:Class ;
    rdfs:label "Act of Collision"@en ;
    rdfs:subClassOf <https://www.commoncoreontologies.org/ont00000065> ;
    skos:definition "An Act of Location Change involving the movement of one object such that it collides with another object."@en .

<https://www.commoncoreontologies.org/ont00001054> a owl:Class ;
    rdfs:label "Helical Antenna"@en ;
    rdfs:subClassOf <https://www.commoncoreontologies.org/ont00000499> ;
    skos:definition "A Wire Antenna that consists of a conducting wire wound in the form of a helix that is typically mounted over a ground plane with a feed line connected between the bottom of the helix and the ground plane."@en .

<https://www.commoncoreontologies.org/ont00001055> a owl:Class ;
    rdfs:label "Branched"@en ;
    rdfs:subClassOf <https://www.commoncoreontologies.org/ont00001059> ;
    skos:definition "A Shape Quality inhering in a bearer in virtue of the bearer having subdivisions or offshoots."@en .

<https://www.commoncoreontologies.org/ont00001056> a owl:Class ;
    rdfs:label "Visible Light Frequency"@en ;
    rdfs:subClassOf <https://www.commoncoreontologies.org/ont00000754> ;
    skos:definition "An Electromagnetic Radiation Frequency of some Electromagnetic Wave that is between 400 and 800 terahertz."@en .

<https://www.commoncoreontologies.org/ont00001057> a owl:Class ;
    rdfs:label "Act of Issuing Mass Media Press Release"@en ;
    rdfs:subClassOf <https://www.commoncoreontologies.org/ont00000588> ;
    skos:definition "An Act of Mass Media Communication involving sending forth, distributing, or putting into circulation an official statement issued to one or more members of the media for the purpose of announcing newsworthy information."@en .

<https://www.commoncoreontologies.org/ont00001058> a owl:Class ;
    rdfs:label "Hour"@en ;
    rdfs:subClassOf <http://purl.obolibrary.org/obo/BFO_0000202> ;
    skos:definition "A Temporal Interval that is equal to sixty consecutive Minutes."@en .

<https://www.commoncoreontologies.org/ont00001060> a owl:Class ;
    rdfs:label "Fuel System"@en ;
    rdfs:subClassOf <https://www.commoncoreontologies.org/ont00000995> ;
    skos:definition "A Material Artifact that is designed to pump, manage, and deliver some Portion of Fuel to the Propulsion System and Auxiliary Power Unit of some Vehicle."@en .

<https://www.commoncoreontologies.org/ont00001061> a owl:Class ;
    rdfs:label "Motorcycle"@en ;
    rdfs:subClassOf <https://www.commoncoreontologies.org/ont00000053> ;
    skos:definition "A Ground Motor Vehicle that is designed to transport a very small number of passengers (usually 1 or 2) while traveling on two or three tired wheels."@en .

<https://www.commoncoreontologies.org/ont00001062> a owl:Class ;
    rdfs:label "International Community"@en ;
    rdfs:subClassOf <https://www.commoncoreontologies.org/ont00000300> ;
    skos:definition "A maximal Group of Geopolitical Organizations engaged in geopolitics with one another."@en .

<https://www.commoncoreontologies.org/ont00001063> a owl:Class ;
    rdfs:label "Straight"@en ;
    rdfs:subClassOf <https://www.commoncoreontologies.org/ont00001059> ;
    skos:definition "A Shape Quality inhering in a bearer in virtue of the bearer not having curves, bends, or angles along its borders."@en .

<https://www.commoncoreontologies.org/ont00001064> a owl:Class ;
    rdfs:label "Material Copy of a Barcode"@en ;
    rdfs:subClassOf <https://www.commoncoreontologies.org/ont00000798> ;
    skos:definition "An Information Bearing Artifact that is designed to carry one or more geometric shapes that concretize some Prescriptive Information Content Entity."@en .

<https://www.commoncoreontologies.org/ont00001065> a owl:Class ;
    rdfs:label "Two Dimensional Extent"@en ;
    rdfs:subClassOf <https://www.commoncoreontologies.org/ont00001202> ;
    skos:definition "A Size Quality that inheres in a bearer in virtue of the bearer's extension in two dimensions."@en .

<https://www.commoncoreontologies.org/ont00001067> a owl:Class ;
    rdfs:label "Laser"@en ;
    rdfs:subClassOf <https://www.commoncoreontologies.org/ont00000995> ;
    skos:definition "A Material Artifact that is designed to emit light coherently through a process of optical amplification based on the stimulated emission of electromagnetic radiation."@en .

<https://www.commoncoreontologies.org/ont00001068> a owl:Class ;
    rdfs:label "Gain of Quality"@en ;
    rdfs:subClassOf <https://www.commoncoreontologies.org/ont00000395> ;
    skos:definition "A Gain of Specifically Dependent Continuant in which an Independent Continuant becomes the bearer of some Quality."@en .

<https://www.commoncoreontologies.org/ont00001070> a owl:Class ;
    rdfs:label "Fluid Control Artifact Function"@en ;
    rdfs:subClassOf <https://www.commoncoreontologies.org/ont00000323> ;
    skos:definition "An Artifact Function that is realized in processes in which some Material Artifact is used to control the direction or flow of some fluid."@en .

<https://www.commoncoreontologies.org/ont00001071> a owl:Class ;
    rdfs:label "Payload Capacity"@en ;
    rdfs:subClassOf <https://www.commoncoreontologies.org/ont00000323> ;
    skos:definition "An Artifact Function that inheres in a Vehicle that is designed to transport Payload, and which is typically characterized by the maximum Weight, Mass, or Volume of Payload that the Vehicle can transport."@en .

<https://www.commoncoreontologies.org/ont00001072> a owl:Class ;
    rdfs:label "FM Radio Broadcast Frequency"@en ;
    rdfs:subClassOf <https://www.commoncoreontologies.org/ont00000169> ;
    skos:definition "A Very High Frequency that is between 88 and 108 MHz."@en .

<https://www.commoncoreontologies.org/ont00001073> a owl:Class ;
    rdfs:label "Financial Value of Property"@en ;
    rdfs:subClassOf <https://www.commoncoreontologies.org/ont00000608> ;
    skos:definition "Financial Value that inheres in an material entity that is the object of an Act of Ownership."@en .

<https://www.commoncoreontologies.org/ont00001074> a owl:Class ;
    rdfs:label "Act of Educational Training Acquisition"@en ;
    rdfs:subClassOf <https://www.commoncoreontologies.org/ont00000687> ;
    skos:definition "An Act of Training Acquisition performed by an Agent by acquiring knowledge of a curriculum from an Agent or communication medium that realizes a capacity derived from its affiliation with some Educational Organization."@en .

<https://www.commoncoreontologies.org/ont00001077> a owl:Class ;
    rdfs:label "Heavy Machine Gun"@en ;
    rdfs:subClassOf <https://www.commoncoreontologies.org/ont00000848> ;
    skos:definition "A Mounted Gun that is designed to fire ammunition greater than .50 caliber or 12.7mm ammunition in quick succession from an ammunition belt, and which typically weighs more than 30lbs."@en .

<https://www.commoncoreontologies.org/ont00001079> a owl:Class ;
    rdfs:label "Blond"@en ;
    rdfs:subClassOf <https://www.commoncoreontologies.org/ont00000378> ;
    skos:definition "A Color that ranges from nearly white to a light greyish yellow"@en .

<https://www.commoncoreontologies.org/ont00001080> a owl:Class ;
    rdfs:label "Far Infrared Light Frequency"@en ;
    rdfs:subClassOf <https://www.commoncoreontologies.org/ont00001337> ;
    skos:definition "An Infrared Light Frequency that is between 300 gigahertz and 20 terahertz."@en .

<https://www.commoncoreontologies.org/ont00001082> a owl:Class ;
    rdfs:label "Patch Receiver"@en ;
    rdfs:subClassOf <https://www.commoncoreontologies.org/ont00001145> ;
    skos:definition "A Radio Receiver that uses a Patch Antenna to intercept radio signals."@en .

<https://www.commoncoreontologies.org/ont00001083> a owl:Class ;
    rdfs:label "Air-Breathing Combustion Engine"@en ;
    rdfs:subClassOf <https://www.commoncoreontologies.org/ont00000056> ;
    skos:definition "A Reaction Engine that functions by drawing a continuous stream of air into and through the Engine where it is compressed, mixed with a Portion of Fuel, ignited, and then expelled as exhaust gas."@en .

<https://www.commoncoreontologies.org/ont00001085> a owl:Class ;
    rdfs:label "Reflection Artifact Function"@en ;
    rdfs:subClassOf <https://www.commoncoreontologies.org/ont00000323> ;
    skos:definition "An Artifact Function that is realized by a Material Artifact participating in a reflection event in which the Material Artifact causes a change in a wavefront at an interface between the reflecting medium and the transmission medium such that the wavefront returns into the transmission medium."@en .

<https://www.commoncoreontologies.org/ont00001087> a owl:Class ;
    rdfs:label "Orientation Observation Artifact Function"@en ;
    rdfs:subClassOf <https://www.commoncoreontologies.org/ont00001306> ;
    skos:definition "An Observation Artifact Function that is realized during events in which a Material Artifact is used to collect information about the Orientation of a specified object or class of objects."@en .

<https://www.commoncoreontologies.org/ont00001088> a owl:Class ;
    rdfs:label "Decade"@en ;
    rdfs:subClassOf <http://purl.obolibrary.org/obo/BFO_0000202> ;
    skos:definition "A Temporal Interval that is equal to a period of ten consecutive Years."@en .

<https://www.commoncoreontologies.org/ont00001089> a owl:Class ;
    rdfs:label "Petrochemical Refinery"@en ;
    rdfs:subClassOf <https://www.commoncoreontologies.org/ont00001283> ;
    skos:definition "A Refinery that is designed for refining crude oil, intermediate petroleum products, or synthetic petroleum into products of value."@en .

<https://www.commoncoreontologies.org/ont00001090> a owl:Class ;
    rdfs:label "Measurement Unit of Pressure"@en ;
    rdfs:subClassOf <https://www.commoncoreontologies.org/ont00000120> ;
    skos:definition "A Measurement Unit that is used as a standard for measurement of Force applied perpendicular to a surface per unit area."@en .

<https://www.commoncoreontologies.org/ont00001091> a owl:Class ;
    rdfs:label "Fort"@en ;
    rdfs:subClassOf <https://www.commoncoreontologies.org/ont00001052> ;
    skos:definition "A Military Facility that is designed to support the defense of or solidification of rule over some Geospatial Region and its inhabitants."@en .

<https://www.commoncoreontologies.org/ont00001092> a owl:Class ;
    rdfs:label "Electrical Power Storage Artifact Function"@en ;
    rdfs:subClassOf <https://www.commoncoreontologies.org/ont00000098> ;
    skos:definition "An Electrical Artifact Function that is realized during events in which a Material Artifact is used to store electrical power to be released at a later time."@en .

<https://www.commoncoreontologies.org/ont00001093> a owl:Class ;
    rdfs:label "Coin"@en ;
    rdfs:subClassOf <https://www.commoncoreontologies.org/ont00000475> ;
    skos:definition "A Portion of Cash that consists of a flat, portable, round pieces of metal designed to bear some specified Financial Value."@en .

<https://www.commoncoreontologies.org/ont00001094> a owl:Class ;
    rdfs:label "Act of Espionage"@en ;
    rdfs:subClassOf <https://www.commoncoreontologies.org/ont00001251> ;
    skos:definition "An Act of Intelligence Gathering involving the obtaining of information that is considered secret or confidential without the permission of the holder of the information."@en .

<https://www.commoncoreontologies.org/ont00001095> a owl:Class ;
    rdfs:label "Cellular Telecommunication Network"@en ;
    rdfs:subClassOf <https://www.commoncoreontologies.org/ont00000363> ;
    skos:definition "A Wireless Telecommunication Network where the last link between the network and the end user is wireless and is distributed over service areas called cells."@en .

<https://www.commoncoreontologies.org/ont00001096> a owl:Class ;
    rdfs:label "Submachine Gun"@en ;
    rdfs:subClassOf <https://www.commoncoreontologies.org/ont00001104> ;
    skos:definition "An Long Gun that is designed to be have automatic-fire functionality, fire pistol-caliber ammunition that is magazine-fed, and which is usually smaller than other automatic firearms."@en .

<https://www.commoncoreontologies.org/ont00001097> a owl:Class ;
    rdfs:label "Common Stock"@en ;
    rdfs:subClassOf <https://www.commoncoreontologies.org/ont00001278> ;
    skos:definition "Stock that entitles its holder to voting on corporate decisions."@en .

<https://www.commoncoreontologies.org/ont00001098> a owl:Class ;
    rdfs:label "Hospital"@en ;
    rdfs:subClassOf <https://www.commoncoreontologies.org/ont00000055> ;
    skos:definition "A Healthcare Facility that is designed to provide patient treatment with specialized staff and equipment."@en .

<https://www.commoncoreontologies.org/ont00001099> a owl:Class ;
    rdfs:label "Bridge"@en ;
    rdfs:subClassOf <https://www.commoncoreontologies.org/ont00001326> ;
    skos:definition "A Land Transportation Artifact that is designed to span physical obstacles without closing the way underneath to enable Persons or Ground Vehicles to pass over the obstacles."@en .

<https://www.commoncoreontologies.org/ont00001103> a owl:Class ;
    rdfs:label "Artifact Model Name"@en ;
    rdfs:subClassOf <https://www.commoncoreontologies.org/ont00000686> ;
    skos:definition "A Designative Information Content Entity that designates some Material Artifact Model."@en .

<https://www.commoncoreontologies.org/ont00001106> a owl:Class ;
    rdfs:label "Roll Axis"@en ;
    rdfs:subClassOf <https://www.commoncoreontologies.org/ont00000387> ;
    skos:definition "An Axis of Rotation that passes through the center of an object's Mass from the front to the back of the object as defined by the direction of the object's motion."@en .

<https://www.commoncoreontologies.org/ont00001107> a owl:Class ;
    rdfs:label "Landfill"@en ;
    rdfs:subClassOf <https://www.commoncoreontologies.org/ont00001315> ;
    skos:definition "A Waste Management Facility that is designed for disposing of waste by burial."@en .

<https://www.commoncoreontologies.org/ont00001108> a owl:Class ;
    rdfs:label "Ultra High Frequency"@en ;
    rdfs:subClassOf <https://www.commoncoreontologies.org/ont00000732> ;
    skos:definition "A Microwave Frequency that is between 300 MHz and 3 GHz."@en .

<https://www.commoncoreontologies.org/ont00001109> a owl:Class ;
    rdfs:label "Counter-Clockwise Rotational Motion"@en ;
    rdfs:subClassOf <https://www.commoncoreontologies.org/ont00000368> ;
    skos:definition "A Rotational Motion in which the direction of rotation is toward the left as seen relative to the designated side of the plane of rotation."@en .

<https://www.commoncoreontologies.org/ont00001110> a owl:Class ;
    rdfs:label "Evening"@en ;
    rdfs:subClassOf <http://purl.obolibrary.org/obo/BFO_0000202> ;
    skos:definition "A Temporal Interval that consists of the temporal regions between when the sun sets (approximately 6:00pm) and when people typically retire to sleep (approximately 9:00pm)."@en .

<https://www.commoncoreontologies.org/ont00001111> a owl:Class ;
    rdfs:label "Low Midrange Frequency"@en ;
    rdfs:subClassOf <https://www.commoncoreontologies.org/ont00000530> ;
    skos:definition "A Sonic Frequency that is between 250 and 500 Hz."@en .

<https://www.commoncoreontologies.org/ont00001112> a owl:Class ;
    rdfs:label "Proper Acceleration"@en ;
    rdfs:subClassOf <https://www.commoncoreontologies.org/ont00000712> ;
    skos:definition "An Acceleration of an object relative to a free-fall, or inertial, observer who is momentarily at rest relative to the object being measured (hence, gravity does not cause Proper Acceleration)."@en .

<https://www.commoncoreontologies.org/ont00001113> a owl:Class ;
    rdfs:label "Magenta"@en ;
    rdfs:subClassOf <https://www.commoncoreontologies.org/ont00000378> ;
    skos:definition "A Color consisting of red and blue hues."@en .

<https://www.commoncoreontologies.org/ont00001114> a owl:Class ;
    rdfs:label "Division of Delimiting Domain"@en ;
    rdfs:subClassOf <https://www.commoncoreontologies.org/ont00000472> ;
    owl:disjointWith <https://www.commoncoreontologies.org/ont00001203> ;
    skos:definition "A Geospatial Region that is a fiat division of a Delimiting Domain and not a Delimiting Domain."@en .

<https://www.commoncoreontologies.org/ont00001115> a owl:Class ;
    rdfs:label "Private Network Telephone Call"@en ;
    rdfs:subClassOf <https://www.commoncoreontologies.org/ont00001190> ;
    skos:definition "A Telephone Call transmitted over a network where a closed group of telephones are connected primarily to each other and use a gateway to reach the outside world, usually used inside companies and call centers (a.k.a. private branch exchange (PBX))."@en .

<https://www.commoncoreontologies.org/ont00001116> a owl:Class ;
    rdfs:label "Reference Time"@en ;
    rdfs:subClassOf <http://purl.obolibrary.org/obo/BFO_0000203> ;
    skos:definition "A Temporal Instant specified as the origin for which other Temporal Regions are measured or identified."@en .

<https://www.commoncoreontologies.org/ont00001117> a owl:Class ;
    rdfs:label "Propelling Nozzle"@en ;
    rdfs:subClassOf <https://www.commoncoreontologies.org/ont00000252> ;
    skos:definition "A Nozzle that is used to convert a propulsion Engine into a Jet Engine and functions by using its narrowest part, the throat, to increase Pressure within the Engine by constricting flow, usually until the flow chokes, then expanding the exhaust stream to, or near to, atmospheric pressure, while forming it into a high speed jet to propel the Vehicle."@en .

<https://www.commoncoreontologies.org/ont00001118> a owl:Class ;
    rdfs:label "Surface Tension"@en ;
    rdfs:subClassOf <http://purl.obolibrary.org/obo/BFO_0000016> ;
    skos:definition "A Disposition that inheres in a liquid and is realized when the cohesive forces of the molecules in the bearer at the surface are greater than the adhesive forces of the molecules in the surrounding air."@en .

<https://www.commoncoreontologies.org/ont00001119> a owl:Class ;
    rdfs:label "Material Copy of a Form Document"@en ;
    rdfs:subClassOf <https://www.commoncoreontologies.org/ont00001298> ;
    skos:definition "A Material Copy of a Document that has one or more Material Copy of a Document Field as parts in which to write or select prescribed content."@en .

<https://www.commoncoreontologies.org/ont00001120> a owl:Class ;
    rdfs:label "Act of Religious Training Instruction"@en ;
    rdfs:subClassOf <https://www.commoncoreontologies.org/ont00001075> ;
    skos:definition "An Act of Training Instruction performed by an Agent who realizes a capacity derived from the Agent's affiliation with some Religious Organization by imparting knowledge of the tenets and/or practices of a religion to an Agent either directly or indirectly through some communication medium."@en .

<https://www.commoncoreontologies.org/ont00001121> a owl:Class ;
    rdfs:label "Scramjet Engine"@en ;
    rdfs:subClassOf <https://www.commoncoreontologies.org/ont00000294> ;
    skos:definition "An Air-Breathing Jet Engine that uses the forward motion of the Engine to compress incoming air at supersonic speeds before adding the fuel and constantly combusting the mixture then expelling the exhaust out through the rear Propelling Nozzle to generate Thrust."@en .

<https://www.commoncoreontologies.org/ont00001122> a owl:Class ;
    rdfs:label "Radio Interference"@en ;
    rdfs:subClassOf <https://www.commoncoreontologies.org/ont00000007> ;
    skos:definition "A Natural Process in which a radio signal is disrupted, whether unintentionally or as the result of an Act of Radio Jamming, Act of Radio Spoofing, or similar Planned Act."@en .

<https://www.commoncoreontologies.org/ont00001125> a owl:Class ;
    rdfs:label "Set of Eyes"@en ;
    rdfs:subClassOf <https://www.commoncoreontologies.org/ont00000084> ;
    skos:definition "A Bodily Component that consists of two or more Eyes that are part of a single Agent."@en .

<https://www.commoncoreontologies.org/ont00001127> a owl:Class ;
    rdfs:label "Loss of Quality"@en ;
    rdfs:subClassOf <https://www.commoncoreontologies.org/ont00000865> ;
    skos:definition "A Loss of Specifically Dependent Continuant in which some Independent Continuant ceases to be the bearer of some Quality."@en .

<https://www.commoncoreontologies.org/ont00001128> a owl:Class ;
    rdfs:label "Act of Residing"@en ;
    rdfs:subClassOf <https://www.commoncoreontologies.org/ont00000676> ;
    skos:definition "An Act of Inhabitancy in which a Person lives in a dwelling permanently or for an extended period of time."@en .

<https://www.commoncoreontologies.org/ont00001129> a owl:Class ;
    rdfs:label "Pressurization Control Artifact Function"@en ;
    rdfs:subClassOf <https://www.commoncoreontologies.org/ont00000113> ;
    skos:definition "A Ventilation Control Artifact Function that is realized by processes in which some Material Artifact is used to control the partial pressure of air in some space."@en .

<https://www.commoncoreontologies.org/ont00001134> a owl:Class ;
    rdfs:label "Vehicle Frame"@en ;
    rdfs:subClassOf <https://www.commoncoreontologies.org/ont00000995> ;
    skos:definition "A Material Artifact that is designed to be the main supporting structure of some Vehicle."@en .

<https://www.commoncoreontologies.org/ont00001135> a owl:Class ;
    rdfs:label "Portion of Liquid Fuel"@en ;
    rdfs:subClassOf <https://www.commoncoreontologies.org/ont00000838> ;
    skos:definition "A Portion of Fuel that is stored in a liquid state."@en .

<https://www.commoncoreontologies.org/ont00001136> a owl:Class ;
    rdfs:label "Ultrasonic Frequency"@en ;
    rdfs:subClassOf <https://www.commoncoreontologies.org/ont00000008> ;
    skos:definition "A Sound Frequency that is greater than 20 kHz."@en .

<https://www.commoncoreontologies.org/ont00001138> a owl:Class ;
    rdfs:label "Beverage Antenna"@en ;
    rdfs:subClassOf <https://www.commoncoreontologies.org/ont00000499> ;
    skos:definition "A Wire Antenna that consists of a horizontal wire one-half to two wavelengths long that is suspended above the ground with one end attached to the receiver feedline and the other grounded and which is typically used in the low and medium frequency radio bands."@en .

<https://www.commoncoreontologies.org/ont00001140> a owl:Class ;
    rdfs:label "Flywheel"@en ;
    rdfs:subClassOf <https://www.commoncoreontologies.org/ont00000995> ;
    skos:definition "A Material Artifact that is designed to store rotational energy such that it has a significant moment of inertia which enables it to resist changes in rotational speed."@en .

<https://www.commoncoreontologies.org/ont00001141> a owl:Class ;
    rdfs:label "Infrastructure Role"@en ;
    rdfs:subClassOf <http://purl.obolibrary.org/obo/BFO_0000023> ;
    skos:definition "A Role that inheres in the bearer of a Disposition and has been assigned to an Infrastructure System such that the realization of that Disposition is sometimes part of the functioning of the Infrastructure System."@en .

<https://www.commoncoreontologies.org/ont00001142> a owl:Class ;
    rdfs:label "Violet"@en ;
    rdfs:subClassOf <https://www.commoncoreontologies.org/ont00000378> ;
    skos:definition "A Color that is lower than Blue with a wavelength in the visible spectrum typically between 400 and 450 nanometers."@en .

<https://www.commoncoreontologies.org/ont00001143> a owl:Class ;
    rdfs:label "Facsimile Transmission"@en ;
    rdfs:subClassOf <https://www.commoncoreontologies.org/ont00000517> ;
    skos:definition "An Act of Communication by Media in which the Information Content Entity that inheres in a Document is transmitted over a Telephone Network."@en .

<https://www.commoncoreontologies.org/ont00001144> a owl:Class ;
    rdfs:label "Act of Entertainment"@en ;
    rdfs:subClassOf <https://www.commoncoreontologies.org/ont00000228> ;
    skos:definition "A Planned Act consisting of any activity which provides a diversion or permits people to amuse themselves."@en .

<https://www.commoncoreontologies.org/ont00001146> a owl:Class ;
    rdfs:label "Sidereal Time Reference System"@en ;
    rdfs:subClassOf <https://www.commoncoreontologies.org/ont00001328> ;
    skos:definition "A Temporal Reference System that is based on Earth's rate of rotation measured relative to one or more fixed Stars (rather than the Sun)."@en .

<https://www.commoncoreontologies.org/ont00001149> a owl:Class ;
    rdfs:label "Data Range Interval Estimate Information Content Entity"@en ;
    rdfs:subClassOf <https://www.commoncoreontologies.org/ont00001101> ;
    skos:definition "A Ratio Measurement Information Content Entity that is a measurement of a set of values and is equal to the absolute difference between the largest value and the smallest value in the set."@en .

<https://www.commoncoreontologies.org/ont00001151> a owl:Class ;
    rdfs:label "Portion of Paper"@en ;
    rdfs:subClassOf <https://www.commoncoreontologies.org/ont00000893> ;
    skos:definition "An Information Medium Artifact that is designed to bear some Information Content Entity by means of pressing together moist fibres of cellulose pulp derived from wood, rags, or grasses, and drying them into flexible sheets."@en .

<https://www.commoncoreontologies.org/ont00001154> a owl:Class ;
    rdfs:label "Multi-Second Temporal Interval"@en ;
    rdfs:subClassOf <http://purl.obolibrary.org/obo/BFO_0000038> ;
    skos:definition "A one-dimensional temporal region that is measured in Seconds and spans at least one Second."@en .

<https://www.commoncoreontologies.org/ont00001155> a owl:Class ;
    rdfs:label "Full Motion Video Imaging Artifact Function"@en ;
    rdfs:subClassOf <https://www.commoncoreontologies.org/ont00000601> ;
    skos:definition "An Imaging Artifact Function that inheres in Material Artifacts that are designed to produce video of entities that is of high enough quality to make the represented motion appear continuous to human viewers."@en .

<https://www.commoncoreontologies.org/ont00001156> a owl:Class ;
    rdfs:label "Material Copy of a Information Line"@en ;
    rdfs:subClassOf <https://www.commoncoreontologies.org/ont00000798> ;
    skos:definition "An Information Bearing Artifact that consists of a single line or row of some larger Information Bearing Artifact of which it is a part."@en .

<https://www.commoncoreontologies.org/ont00001157> a owl:Class ;
    rdfs:label "Hydraulic Power Source"@en ;
    rdfs:subClassOf <https://www.commoncoreontologies.org/ont00000288> ;
    skos:definition "A Power Source that is designed to generate, control, or transmit power by means of pressurized liquid."@en .

<https://www.commoncoreontologies.org/ont00001158> a owl:Class ;
    rdfs:label "Act of Data Transformation"@en ;
    rdfs:subClassOf <https://www.commoncoreontologies.org/ont00000366> ;
    skos:definition "An Act of Information Processing in which an algorithm is executed to act upon one or more input Information Content Entities into one or more output Information Content Entities."@en .

<https://www.commoncoreontologies.org/ont00001160> a owl:Class ;
    rdfs:label "Solvent Artifact Function"@en ;
    rdfs:subClassOf <https://www.commoncoreontologies.org/ont00000791> ;
    skos:definition "A Chemical Reaction Artifact Function that is realized in the dissolving of other substances (namely, solutes) without change in the former's chemical structure."@en .

<https://www.commoncoreontologies.org/ont00001161> a owl:Class ;
    rdfs:label "Counterfeit Legal Instrument"@en ;
    rdfs:subClassOf <https://www.commoncoreontologies.org/ont00000719> ;
    skos:definition "A Counterfeit Instrument that is designed to be a fake replica of some genuine Legal Instrument."@en .

<https://www.commoncoreontologies.org/ont00001164> a owl:Class ;
    rdfs:label "County"@en ;
    rdfs:subClassOf <https://www.commoncoreontologies.org/ont00001152> ;
    skos:definition "A Government Domain that is part of either a First-Order or Second-Order Administrative Region."@en .

<https://www.commoncoreontologies.org/ont00001165> a owl:Class ;
    rdfs:label "Terrorist Training Camp"@en ;
    rdfs:subClassOf <https://www.commoncoreontologies.org/ont00000332> ;
    skos:definition "A Training Camp designed to teach students methods of terrorism."@en .

<https://www.commoncoreontologies.org/ont00001166> a owl:Class ;
    rdfs:label "Multi-Minute Temporal Interval"@en ;
    rdfs:subClassOf <http://purl.obolibrary.org/obo/BFO_0000038> ;
    skos:definition "A one-dimensional temporal region that is measured in Minutes and spans at least one Minute."@en .

<https://www.commoncoreontologies.org/ont00001167> a owl:Class ;
    rdfs:label "Midrange Frequency"@en ;
    rdfs:subClassOf <https://www.commoncoreontologies.org/ont00000530> ;
    skos:definition "A Sonic Frequency that is between 500 Hz and 2 kHz."@en .

<https://www.commoncoreontologies.org/ont00001168> a owl:Class ;
    rdfs:label "Reaction Mass"@en ;
    rdfs:subClassOf <http://purl.obolibrary.org/obo/BFO_0000040> ;
    skos:definition "A Material Entity against which a Propulsion System operates in order to produce Acceleration."@en .

<https://www.commoncoreontologies.org/ont00001170> a owl:Class ;
    rdfs:label "Hard X-ray Frequency"@en ;
    rdfs:subClassOf <https://www.commoncoreontologies.org/ont00000490> ;
    skos:definition "An X-Ray Frequency that is between 3 and 30 exahertz."@en .

<https://www.commoncoreontologies.org/ont00001171> a owl:Class ;
    rdfs:label "Wireless Network Telephone Call"@en ;
    rdfs:subClassOf <https://www.commoncoreontologies.org/ont00001190> ;
    skos:definition "A Telephone Call transmitted over a network where the telephones are mobile and can move anywhere within the coverage area."@en .

<https://www.commoncoreontologies.org/ont00001172> a owl:Class ;
    rdfs:label "Portion of Gelatinous Propellant"@en ;
    rdfs:subClassOf <https://www.commoncoreontologies.org/ont00000593> ;
    skos:definition "A Portion of Propellant that is stored in a gelatinous state."@en .

<https://www.commoncoreontologies.org/ont00001174> a owl:Class ;
    rdfs:label "Electromagnetic Shielding Artifact Function"@en ;
    rdfs:subClassOf <https://www.commoncoreontologies.org/ont00000323> ;
    skos:definition "An Artifact Function that is realized in a process in which an electromagnetic field is blocked by barriers made of conductive or magnetic materials."@en .

<https://www.commoncoreontologies.org/ont00001177> a owl:Class ;
    rdfs:label "Roll Orientation"@en ;
    rdfs:subClassOf <https://www.commoncoreontologies.org/ont00000119> ;
    skos:definition "A Spatial Orientation of an Object relative to its Roll Axis."@en .

<https://www.commoncoreontologies.org/ont00001178> a owl:Class ;
    rdfs:label "Railway Crossing"@en ;
    rdfs:subClassOf <https://www.commoncoreontologies.org/ont00001326> ;
    skos:definition "A Land Transportation Artifact that is designed to enable Persons or Ground Vehicles to cross a Railway when traveling along a road or path that is perpendicular to and at the same elevation as the Railway at the point where they overlap."@en .

<https://www.commoncoreontologies.org/ont00001179> a owl:Class ;
    rdfs:label "Digital Storage Device"@en ;
    rdfs:subClassOf <https://www.commoncoreontologies.org/ont00000893> ;
    skos:definition "An Information Medium Artifact that is designed to bear some Information Content Entity by means of recording that information in digital (binary) format."@en .

<https://www.commoncoreontologies.org/ont00001181> a owl:Class ;
    rdfs:label "Triple Inertial Navigation System"@en ;
    rdfs:subClassOf <https://www.commoncoreontologies.org/ont00000287> ;
    skos:definition "An Inertial Navigation System that is designed to use three redundant computers to continuously calculate via dead reckoning the position, orientation, and velocity of a moving object without the need for external references, in such a way that eliminates the need for a navigator."@en .

<https://www.commoncoreontologies.org/ont00001182> a owl:Class ;
    rdfs:label "Phase Angle"@en ;
    rdfs:subClassOf <http://purl.obolibrary.org/obo/BFO_0000145> ;
    skos:definition "A Relational Quality that is the angle between the light incident onto an observed Object and the light reflected from the Object."@en .

<https://www.commoncoreontologies.org/ont00001183> a owl:Class ;
    rdfs:label "Social Network"@en ;
    rdfs:subClassOf <https://www.commoncoreontologies.org/ont00000300> ;
    skos:definition "A Group of Agents that are connected in dyadic relations by similar personal or career interests, activities, backgrounds, or real-life connections."@en .

<https://www.commoncoreontologies.org/ont00001184> a owl:Class ;
    rdfs:label "Spinning Motion"@en ;
    rdfs:subClassOf <https://www.commoncoreontologies.org/ont00000368> ;
    skos:definition "A Rotational Motion of an Object around an Axis of Rotation that passes through the Object's Center of Mass."@en .

<https://www.commoncoreontologies.org/ont00001185> a owl:Class ;
    rdfs:label "Rocket"@en ;
    rdfs:subClassOf <https://www.commoncoreontologies.org/ont00000713> ;
    skos:definition "A Vehicle that is designed to travel through air or space and which obtains Thrust from a Rocket Engine."@en .

<https://www.commoncoreontologies.org/ont00001186> a owl:Class ;
    rdfs:label "Color Hue"@en ;
    rdfs:subClassOf <https://www.commoncoreontologies.org/ont00000784> ;
    skos:definition "An Optical Property that inheres in a bearer in virtue of its capacity to reflect a dominant wavelength of the visible light spectrum, which is typically divided up into 6 to 8 ranges."@en .

<https://www.commoncoreontologies.org/ont00001188> a owl:Class ;
    rdfs:label "Denture"@en ;
    rdfs:subClassOf <https://www.commoncoreontologies.org/ont00000715> ;
    skos:definition "A Prosthesis that is designed to replace missing teeth."@en .

<https://www.commoncoreontologies.org/ont00001189> a owl:Class ;
    rdfs:label "Blue"@en ;
    rdfs:subClassOf <https://www.commoncoreontologies.org/ont00000378> ;
    skos:definition "A Color that is between Cyan and Violet with a wavelength in the visible spectrum typically between 450 to 490 nanometers."@en .

<https://www.commoncoreontologies.org/ont00001193> a owl:Class ;
    rdfs:label "Fatigability"@en ;
    rdfs:subClassOf <http://purl.obolibrary.org/obo/BFO_0000017> ;
    skos:definition "A Realizable Entity that is realized when its bearer loses strength and tires quickly."@en .

<https://www.commoncoreontologies.org/ont00001194> a owl:Class ;
    rdfs:label "Gain of Role"@en ;
    rdfs:subClassOf <https://www.commoncoreontologies.org/ont00000642> ;
    skos:definition "A Gain of Realizable Entity in which some Independent Continuant becomes bearer of some Role."@en .

<https://www.commoncoreontologies.org/ont00001195> a owl:Class ;
    rdfs:label "Geospatial Error Region"@en ;
    rdfs:subClassOf <https://www.commoncoreontologies.org/ont00000207> ;
    skos:definition "A One-Dimensional Geospatial Boundary that bounds some Geospatial Region according to probability estimations for locating some object within it."@en .

<https://www.commoncoreontologies.org/ont00001196> a owl:Class ;
    rdfs:label "Act of Artifact Assembly"@en ;
    rdfs:subClassOf <https://www.commoncoreontologies.org/ont00000908> ;
    skos:definition "An Act of Material Artifact Processing wherein a new Material Artifact are created by fitting component parts together."@en .

<https://www.commoncoreontologies.org/ont00001198> a owl:Class ;
    rdfs:label "Railcar"@en ;
    rdfs:subClassOf <https://www.commoncoreontologies.org/ont00000796> ;
    skos:definition "A Rail Transport Vehicle that consists of a single self-propelled Vehicle that is not a Train, is designed to transport passengers, and which may also be designed to connect to other Railcars to form a Train."@en .

<https://www.commoncoreontologies.org/ont00001199> a owl:Class ;
    rdfs:label "Protruding"@en ;
    rdfs:subClassOf <https://www.commoncoreontologies.org/ont00001059> ;
    skos:definition "A Shape Quality inhering in a part of an object in virtue of the part extending out above or beyond the surface of the object."@en .

<https://www.commoncoreontologies.org/ont00001200> a owl:Class ;
    rdfs:label "Structural Support Artifact Function"@en ;
    rdfs:subClassOf <https://www.commoncoreontologies.org/ont00000323> ;
    skos:definition "An Artifact Function that is realized by a Material Artifact providing physical support to another object."@en .

<https://www.commoncoreontologies.org/ont00001201> a owl:Class ;
    rdfs:label "Trail"@en ;
    rdfs:subClassOf <https://www.commoncoreontologies.org/ont00001326> ;
    skos:definition "A Land Transportation Artifact that is designed to enable transport through rough country, such as a forest or moor."@en .

<https://www.commoncoreontologies.org/ont00001204> a owl:Class ;
    rdfs:label "Night"@en ;
    rdfs:subClassOf <http://purl.obolibrary.org/obo/BFO_0000202> ;
    skos:definition "A Temporal Interval that consists of the temporal regions between when people typically retire to sleep (approximately 9:00pm) and when the sun dawns (approximately 6:00am)."@en .

<https://www.commoncoreontologies.org/ont00001205> a owl:Class ;
    rdfs:label "Priority Scale"@en ;
    rdfs:subClassOf <https://www.commoncoreontologies.org/ont00000398> ;
    skos:definition "A Reference System that is designed to be used to rank or identify the importance of entities of the specified type."@en .

<https://www.commoncoreontologies.org/ont00001206> a owl:Class ;
    rdfs:label "Multi-Year Temporal Interval"@en ;
    rdfs:subClassOf <http://purl.obolibrary.org/obo/BFO_0000038> ;
    skos:definition "A one-dimensional temporal region that is measured in Years and spans at least one Year."@en .

<https://www.commoncoreontologies.org/ont00001208> a owl:Class ;
    rdfs:label "High Frequency"@en ;
    rdfs:subClassOf <https://www.commoncoreontologies.org/ont00000150> ;
    skos:definition "A Radio Frequency that is between 3 and 30 MHz."@en .

<https://www.commoncoreontologies.org/ont00001210> a owl:Class ;
    rdfs:label "Retail Artifact Function"@en ;
    rdfs:subClassOf <https://www.commoncoreontologies.org/ont00001301> ;
    skos:definition "A Service Artifact Function that is realized in processes of selling goods or merchandise in small or individual lots for direct consumption by persons or organizations."@en .

<https://www.commoncoreontologies.org/ont00001211> a owl:Class ;
    rdfs:label "Lifting Artifact Function"@en ;
    rdfs:subClassOf <https://www.commoncoreontologies.org/ont00000323> ;
    skos:definition "An Artifact Function that is realized by processes in which some Material Artifact is used to lift some object."@en .

<https://www.commoncoreontologies.org/ont00001212> a owl:Class ;
    rdfs:label "Female Sex"@en ;
    rdfs:subClassOf <https://www.commoncoreontologies.org/ont00001033> ;
    skos:definition "A Biological Sex inhering in an individual that only produces gametes that can be fertilized by male gametes."@en .

<https://www.commoncoreontologies.org/ont00001215> a owl:Class ;
    rdfs:label "Funeral"@en ;
    rdfs:subClassOf <https://www.commoncoreontologies.org/ont00000455> ;
    skos:definition "An Act of Ceremony in which the Life of a Person who has died is celebrated, sanctified, or remembered."@en .

<https://www.commoncoreontologies.org/ont00001216> a owl:Class ;
    rdfs:label "Periscope"@en ;
    rdfs:subClassOf <https://www.commoncoreontologies.org/ont00000136> ;
    skos:definition "An Optical Instrument that is designed to enable observation of an object that is located over, around, or through another object, obstacle, or condition that prevents direct line-of-sight observation from the observer's current position."@en .

<https://www.commoncoreontologies.org/ont00001217> a owl:Class ;
    rdfs:label "Medium Machine Gun"@en ;
    rdfs:subClassOf <https://www.commoncoreontologies.org/ont00000848> ;
    skos:definition "A Mounted Gun that is designed to fire full-power rifle Cartridges (less than .50 caliber or 12.7mm) in quick succession from an ammunition belt, and which typically weighs 22-30 lbs."@en .

<https://www.commoncoreontologies.org/ont00001219> a owl:Class ;
    rdfs:label "Delta-v"@en ;
    rdfs:subClassOf <http://purl.obolibrary.org/obo/BFO_0000144> ;
    skos:definition "A Process Profile that is the total change in Velocity of an object's Motion."@en .

<https://www.commoncoreontologies.org/ont00001220> a owl:Class ;
    rdfs:label "Opaque"@en ;
    rdfs:subClassOf <https://www.commoncoreontologies.org/ont00001384> ;
    skos:definition "An Opacity that inheres in a bearer in virtue of that bearer's incapacity to transmit electromagnetic radiation of a given frequency through the bearer such that the bearer reflects, scatters, or absorbs all electromagnetic radiation of that frequency."@en .

<https://www.commoncoreontologies.org/ont00001222> a owl:Class ;
    rdfs:label "Solar Panel System"@en ;
    rdfs:subClassOf <https://www.commoncoreontologies.org/ont00001049> ;
    skos:definition "An Electrical Power Source that consists in part of one or more Solar Panels, a power inverter, electrical wiring between the components, a mounting and support structure, and may also include a battery and/or a solar tracking system and is the bearer of functions realized in processes of deriving, transferring, and storing electrical energy derived from light energy."@en .

<https://www.commoncoreontologies.org/ont00001223> a owl:Class ;
    rdfs:label "Dish Receiver"@en ;
    rdfs:subClassOf <https://www.commoncoreontologies.org/ont00001145> ;
    skos:definition "A Radio Receiver that uses a Parabolic (or Dish) Antenna to intercept radio signals."@en .

<https://www.commoncoreontologies.org/ont00001224> a owl:Class ;
    rdfs:label "Process Requirement"@en ;
    rdfs:subClassOf <https://www.commoncoreontologies.org/ont00001324> ;
    skos:definition "A Process Regulation that requires some Process."@en .

<https://www.commoncoreontologies.org/ont00001225> a owl:Class ;
    rdfs:label "Yellow"@en ;
    rdfs:subClassOf <https://www.commoncoreontologies.org/ont00000378> ;
    skos:definition "A Color that is between Orange and Green with a wavelength in the visible spectrum typically between 560 to 590 nanometers."@en .

<https://www.commoncoreontologies.org/ont00001227> a owl:Class ;
    rdfs:label "Longitudinal Wave Profile"@en ;
    rdfs:subClassOf <https://www.commoncoreontologies.org/ont00000752> ;
    skos:definition "A Wave Process Profile in which the displacement of participating particles is parallel to the direction of the Wave Process' propogation such that the particles alternate between participating in processes of compression and rarefaction as they participate in individual Wave Processes."@en .

<https://www.commoncoreontologies.org/ont00001228> a owl:Class ;
    rdfs:label "Material Copy of a Journal Article"@en ;
    rdfs:subClassOf <https://www.commoncoreontologies.org/ont00001298> ;
    skos:definition "A Material Copy of a Document that is designed to carry a specific brief composition on a specific topic as part of a Journal Issue."@en .

<https://www.commoncoreontologies.org/ont00001229> a owl:Class ;
    rdfs:label "Alkaline Electric Battery"@en ;
    rdfs:subClassOf <https://www.commoncoreontologies.org/ont00001050> ;
    skos:definition "A Primary Cell Electric Battery that has a Zinc anode and Manganese (IV) oxide cathode."@en .

<https://www.commoncoreontologies.org/ont00001230> a owl:Class ;
    rdfs:label "Rhombic Antenna"@en ;
    rdfs:subClassOf <https://www.commoncoreontologies.org/ont00000499> ;
    skos:definition "A Wire Antenna that consists of one to three parallel wires suspended above the ground by poles or towers at each vertex in a rhombic shape with each of the four sides being the same length (typically at least one wavelength or longer)."@en .

<https://www.commoncoreontologies.org/ont00001231> a owl:Class ;
    rdfs:label "Brilliance Frequency"@en ;
    rdfs:subClassOf <https://www.commoncoreontologies.org/ont00000530> ;
    skos:definition "A Sonic Frequency that is between 6 and 20 kHz."@en .

<https://www.commoncoreontologies.org/ont00001233> a owl:Class ;
    rdfs:label "Crushing Artifact Function"@en ;
    rdfs:subClassOf <https://www.commoncoreontologies.org/ont00001153> ;
    skos:definition "A Damaging Artifact Function that is realized in a process in which the structural integrity of an entity is impaired because of significant pressure."@en .

<https://www.commoncoreontologies.org/ont00001234> a owl:Class ;
    rdfs:label "Neutralization Artifact Function"@en ;
    rdfs:subClassOf <https://www.commoncoreontologies.org/ont00000791> ;
    skos:definition "A Chemical Reaction Artifact Function that is realized in a process in which an acid and a base react quantitatively with each other."@en .

<https://www.commoncoreontologies.org/ont00001235> a owl:Class ;
    rdfs:label "Military Time Zone Identifier"@en ;
    rdfs:subClassOf <https://www.commoncoreontologies.org/ont00000829> ;
    skos:definition "A Time Zone Identifier that designates a spatial region where the local time is calculated according to the specified offset from Zulu time, which has no offset from Coordinated Universal Time."@en .

<https://www.commoncoreontologies.org/ont00001236> a owl:Class ;
    rdfs:label "Act of Suicide"@en ;
    rdfs:subClassOf <https://www.commoncoreontologies.org/ont00001147> ;
    skos:definition "An Act of Violence in which some Agent intentionally and voluntarily causes their own death."@en .

<https://www.commoncoreontologies.org/ont00001237> a owl:Class ;
    rdfs:label "Birth"@en ;
    rdfs:subClassOf <https://www.commoncoreontologies.org/ont00000007> ;
    skos:definition "A Process of bringing forth offspring."@en .

<https://www.commoncoreontologies.org/ont00001238> a owl:Class ;
    rdfs:label "Initialism"@en ;
    rdfs:subClassOf <https://www.commoncoreontologies.org/ont00000605> ;
    skos:definition "An Abbreviated Name that consists of the initial letters of some words (or syllables) in a Designative Name, and in which each letter is pronounced separately."@en .

<https://www.commoncoreontologies.org/ont00001239> a owl:Class ;
    rdfs:label "Group of Organizations"@en ;
    rdfs:subClassOf <https://www.commoncoreontologies.org/ont00000300> ;
    skos:definition "A Group of Agents that has only Organizations as member parts."@en .

<https://www.commoncoreontologies.org/ont00001240> a owl:Class ;
    rdfs:label "Radio Communication Artifact Function"@en ;
    rdfs:subClassOf <https://www.commoncoreontologies.org/ont00001148> ;
    skos:definition "An Electromagnetic Communication Artifact Function that is realized in a process that conveys meaningful signs by means of radio waves."@en .

<https://www.commoncoreontologies.org/ont00001241> a owl:Class ;
    rdfs:label "Sensor Function"@en ;
    rdfs:subClassOf <http://purl.obolibrary.org/obo/BFO_0000034> ;
    skos:definition "A Function that is realized in processes wherein an attribute of its bearer is a proxy for some aspect of its sensing environment."@en .

<https://www.commoncoreontologies.org/ont00001242> a owl:Class ;
    rdfs:label "Actuator"@en ;
    rdfs:subClassOf <https://www.commoncoreontologies.org/ont00000736> ;
    skos:definition "A Transducer that is designed to convert some control signal into mechanical motion."@en .

<https://www.commoncoreontologies.org/ont00001243> a owl:Class ;
    rdfs:label "Material Copy of a Document Field"@en ;
    rdfs:subClassOf <https://www.commoncoreontologies.org/ont00000798> ;
    skos:definition "An Information Bearing Entity that is a part of some document into which carriers of prescribed information can be written or selected."@en .

<https://www.commoncoreontologies.org/ont00001244> a owl:Class ;
    rdfs:label "Act of Issuing Mass Media Article"@en ;
    rdfs:subClassOf <https://www.commoncoreontologies.org/ont00000588> ;
    skos:definition "An Act of Mass Media Communication involving sending forth, distributing, or putting into circulation a non-fictional essay, especially one included with others in a newspaper, magazine, or journal."@en .

<https://www.commoncoreontologies.org/ont00001246> a owl:Class ;
    rdfs:label "Under Active Control"@en ;
    rdfs:subClassOf <https://www.commoncoreontologies.org/ont00000847> ;
    skos:definition "An Active Stasis during which a Material Artifact participates in an Act of Artifact Employment."@en .

<https://www.commoncoreontologies.org/ont00001247> a owl:Class ;
    rdfs:label "Telecommunication Endpoint"@en ;
    rdfs:subClassOf <https://www.commoncoreontologies.org/ont00000918> ;
    skos:definition "A Telecommunication Network Node that connects a Telecommunication Terminal to a Telecommunication Network."@en .

<https://www.commoncoreontologies.org/ont00001249> a owl:Class ;
    rdfs:label "Cabin Pressurization Control System"@en ;
    rdfs:subClassOf <https://www.commoncoreontologies.org/ont00000453> ;
    skos:definition "An Environment Control System that is designed to control the process in which conditioned air is pumped into the Cabin of some Aircraft or Spacecraft in order to create a safe and comfortable environment for passengers and crew flying at high altitudes."@en .

<https://www.commoncoreontologies.org/ont00001250> a owl:Class ;
    rdfs:label "Interior Lighting System"@en ;
    rdfs:subClassOf <https://www.commoncoreontologies.org/ont00000236> ;
    skos:definition "A Lighting System that is designed to emit light within the interior of some area."@en .

<https://www.commoncoreontologies.org/ont00001252> a owl:Class ;
    rdfs:label "Propulsion Artifact Function"@en ;
    rdfs:subClassOf <https://www.commoncoreontologies.org/ont00000448> ;
    skos:definition "A Motion Artifact Function that is realized in a process in which the bearer of the function creates force leading to an entity's movement."@en .

<https://www.commoncoreontologies.org/ont00001253> a owl:Class ;
    rdfs:label "Fuel Artifact Function"@en ;
    rdfs:subClassOf <https://www.commoncoreontologies.org/ont00000323> ;
    skos:definition "An Artifact Function that is realized in processes in which a Portion of Fuel is reacted with other substances in order to release chemical or nuclear energy to be used for heat or for work."@en .

<https://www.commoncoreontologies.org/ont00001254> a owl:Class ;
    rdfs:label "Revolver"@en ;
    rdfs:subClassOf <https://www.commoncoreontologies.org/ont00000156> ;
    skos:definition "A Hand Gun having a number of firing chambers in a revolving cylinder, where each chamber in the cylinder can be loaded with a single Cartridge."@en .

<https://www.commoncoreontologies.org/ont00001255> a owl:Class ;
    rdfs:label "Insecticide Artifact Function"@en ;
    rdfs:subClassOf <https://www.commoncoreontologies.org/ont00000828> ;
    skos:definition "A Pesticide Artifact Function that is realized in a process that causes harm to, or the death of, an insect."@en .

<https://www.commoncoreontologies.org/ont00001256> a owl:Class ;
    rdfs:label "Reliability Measurement Information Content Entity"@en ;
    rdfs:subClassOf <https://www.commoncoreontologies.org/ont00001163> ;
    skos:definition "A Measurement Information Content Entity that is a measurement of the extent to which an entity can consistently produce an outcome."@en .

<https://www.commoncoreontologies.org/ont00001257> a owl:Class ;
    rdfs:label "Nuclear Storage Depot"@en ;
    rdfs:subClassOf <https://www.commoncoreontologies.org/ont00000881> ;
    skos:definition "A Storage Facility that is designed to store nuclear material."@en .

<https://www.commoncoreontologies.org/ont00001259> a owl:Class ;
    rdfs:label "Portion of Atmosphere"@en ;
    rdfs:subClassOf <http://purl.obolibrary.org/obo/BFO_0000024> ;
    skos:definition "A fiat object part of the layer of gas or layers of gases that envelop a natural satellite."@en .

<https://www.commoncoreontologies.org/ont00001261> a owl:Class ;
    rdfs:label "Act of Identifying"@en ;
    rdfs:subClassOf <https://www.commoncoreontologies.org/ont00000379> ;
    skos:definition "An Act of Representative Communication performed by asserting who or what a particular person or thing is."@en .

<https://www.commoncoreontologies.org/ont00001263> a owl:Class ;
    rdfs:label "Act of Issuing Mass Media Documentary"@en ;
    rdfs:subClassOf <https://www.commoncoreontologies.org/ont00000588> ;
    skos:definition "An Act of Mass Media Communication involving sending forth, distributing, or putting into circulation information that provides a factual record or report."@en .

<https://www.commoncoreontologies.org/ont00001265> a owl:Class ;
    rdfs:label "Public Address System"@en ;
    rdfs:subClassOf <https://www.commoncoreontologies.org/ont00001036> ;
    skos:definition "A Communication System that is designed to allow a Person to speak to a large audience."@en .

<https://www.commoncoreontologies.org/ont00001266> a owl:Class ;
    rdfs:label "Act of Vocational Training Instruction"@en ;
    rdfs:subClassOf <https://www.commoncoreontologies.org/ont00001075> ;
    skos:definition "An Act of Training Instruction performed by an Agent who realizes a capacity derived from the Agent's affiliation with a Vocational School, Technical School, Trade Organization, or Industry Educational Program Provider by imparting skills required for a specific occupation in industry, agriculture or trade to an Agent either directly or indirectly through some communication medium."@en .

<https://www.commoncoreontologies.org/ont00001267> a owl:Class ;
    rdfs:label "Act of Propaganda"@en ;
    rdfs:subClassOf <https://www.commoncoreontologies.org/ont00000971> ;
    skos:definition "An Act of Deceptive Communication Propaganda intended to influence the attitude of a mass audience toward some cause or position by presenting facts selectively (thus possibly lying by omission) or by using loaded messages to produce an emotional rather than rational response to the information presented."@en .

<https://www.commoncoreontologies.org/ont00001269> a owl:Class ;
    rdfs:label "Act of Warning"@en ;
    rdfs:subClassOf <https://www.commoncoreontologies.org/ont00000133> ;
    skos:definition "An Act of Directive Communication performed by indicating a possible or impending danger, problem, or other unpleasant situation."@en .

<https://www.commoncoreontologies.org/ont00001270> a owl:Class ;
    rdfs:label "Howitzer"@en ;
    rdfs:subClassOf <https://www.commoncoreontologies.org/ont00000268> ;
    skos:definition "A Cannon that is designed to have a relatively short barrel and to use relatively small propellant charges to propel projectiles in relatively high trajectories with a steep angle of descent."@en .

<https://www.commoncoreontologies.org/ont00001271> a owl:Class ;
    rdfs:label "Wired Communication Relay Artifact Function"@en ;
    rdfs:subClassOf <https://www.commoncoreontologies.org/ont00001169> ;
    skos:definition "A Communication Relay Artifact Function that is realized during events in which a Material Artifact is used to first receive and then transmit information by means of wires from one Material Artifact to another for the purpose of communiction."@en .

<https://www.commoncoreontologies.org/ont00001274> a owl:Class ;
    rdfs:label "Infrasonic Frequency"@en ;
    rdfs:subClassOf <https://www.commoncoreontologies.org/ont00000008> ;
    skos:definition "A Sound Frequency that is below 20 Hz."@en .

<https://www.commoncoreontologies.org/ont00001275> a owl:Class ;
    rdfs:label "Nominal Speed Artifact Function"@en ;
    rdfs:subClassOf <https://www.commoncoreontologies.org/ont00001353> ;
    skos:definition "A Speed Artifact Function that is realized in some process in which the Artifact bearing the Artifact Function attains a speed that does not exceed some specified tolerance of that Material Artifact."@en .

<https://www.commoncoreontologies.org/ont00001276> a owl:Class ;
    rdfs:label "Carrier Air Wing"@en ;
    rdfs:subClassOf <https://www.commoncoreontologies.org/ont00000426> ;
    skos:definition "A Military Force that is trained and equipped to conduct air operations while embarked on an aircraft carrier."@en .

<https://www.commoncoreontologies.org/ont00001277> a owl:Class ;
    rdfs:label "Red"@en ;
    rdfs:subClassOf <https://www.commoncoreontologies.org/ont00000378> ;
    skos:definition "A Color that is above Orange with a wavelength in the visible spectrum typically between 635 to 700 nanometers."@en .

<https://www.commoncoreontologies.org/ont00001279> a owl:Class ;
    rdfs:label "Vibration Motion"@en ;
    rdfs:subClassOf <https://www.commoncoreontologies.org/ont00001133> ;
    skos:definition "A Motion wherein some participant repetitively deviates from a central location to two surrounding locations."@en .

<https://www.commoncoreontologies.org/ont00001280> a owl:Class ;
    rdfs:label "Flat"@en ;
    rdfs:subClassOf <https://www.commoncoreontologies.org/ont00001059> ;
    skos:definition "A Shape Quality inhering in a bearer in virtue of the bearer having a horizontal border without a significant deviation."@en .

<https://www.commoncoreontologies.org/ont00001282> a owl:Class ;
    rdfs:label "Hydraulic Valve"@en ;
    rdfs:subClassOf <https://www.commoncoreontologies.org/ont00000598> ;
    skos:definition "A Valve that is designed to regulate, direct, or control the flow of a liquid by opening, closing, or partially obstructing various passageways."@en .

<https://www.commoncoreontologies.org/ont00001284> a owl:Class ;
    rdfs:label "Crew"@en ;
    rdfs:subClassOf <https://www.commoncoreontologies.org/ont00000914> ;
    skos:definition "A Group of Persons that bear Roles realized by the operation of the specified Vehicle."@en .

<https://www.commoncoreontologies.org/ont00001285> a owl:Class ;
    rdfs:label "Revolving Motion"@en ;
    rdfs:subClassOf <https://www.commoncoreontologies.org/ont00000368> ;
    skos:definition "A Rotational Motion of an Object around an Axis of Rotation that is located externally to the Site occupied by the Object."@en .

<https://www.commoncoreontologies.org/ont00001287> a owl:Class ;
    rdfs:label "Maintenance Facility"@en ;
    rdfs:subClassOf <https://www.commoncoreontologies.org/ont00000192> ;
    skos:definition "A Facility that is designed to be used to perform actions to maintain or improve the state of some property or equipment."@en .

<https://www.commoncoreontologies.org/ont00001288> a owl:Class ;
    rdfs:label "Round Shot"@en ;
    rdfs:subClassOf <https://www.commoncoreontologies.org/ont00001150> ;
    skos:definition "A Portion of Ammunition that is designed to be a solid projectile without explosive charge and to be fired from a cannon."@en .

<https://www.commoncoreontologies.org/ont00001290> a owl:Class ;
    rdfs:label "Measurement Unit of Length"@en ;
    rdfs:subClassOf <https://www.commoncoreontologies.org/ont00000120> ;
    skos:definition "A Measurement Unit that is used as a standard for measurement of one-dimensional regions or Geospatial Regions."@en .

<https://www.commoncoreontologies.org/ont00001291> a owl:Class ;
    rdfs:label "Radiation Absorptivity"@en ;
    rdfs:subClassOf <https://www.commoncoreontologies.org/ont00000628> ;
    skos:definition "A Disposition to Interact with Electromagnetic Radiation that inheres in a bearer in virtue of the capacity of that bearer to absorb electromagnetic radiation of a given frequency."@en .

<https://www.commoncoreontologies.org/ont00001292> a owl:Class ;
    rdfs:label "Bus"@en ;
    rdfs:subClassOf <https://www.commoncoreontologies.org/ont00000053> ;
    skos:definition "A Ground Motor Vehicle that is designed to transport a large number of people and to travel on six or more tired wheels."@en .

<https://www.commoncoreontologies.org/ont00001294> a owl:Class ;
    rdfs:label "Three Dimensional Extent"@en ;
    rdfs:subClassOf <https://www.commoncoreontologies.org/ont00001202> ;
    skos:definition "A Size Quality that inheres in a bearer in virtue of the bearer's extension in three dimensions."@en .

<https://www.commoncoreontologies.org/ont00001295> a owl:Class ;
    rdfs:label "Financial Facility"@en ;
    rdfs:subClassOf <https://www.commoncoreontologies.org/ont00000192> ;
    skos:definition "A Facility that is designed to support the management of money."@en .

<https://www.commoncoreontologies.org/ont00001296> a owl:Class ;
    rdfs:label "Pitch Orientation"@en ;
    rdfs:subClassOf <https://www.commoncoreontologies.org/ont00000119> ;
    skos:definition "A Spatial Orientation of an Object relative to its Pitch Axis."@en .

<https://www.commoncoreontologies.org/ont00001297> a owl:Class ;
    rdfs:label "Military Headquarters Facility"@en ;
    rdfs:subClassOf <https://www.commoncoreontologies.org/ont00001052> ;
    skos:definition "A Military Facility that is designed for military administration and coordination."@en .

<https://www.commoncoreontologies.org/ont00001299> a owl:Class ;
    rdfs:label "Wetting Agent Artifact Function"@en ;
    rdfs:subClassOf <https://www.commoncoreontologies.org/ont00000344> ;
    skos:definition "A Surfactant Artifact Function that is realized in a process that reduces the water repellent tendency of a substance thereby allowing it to become wet."@en .

<https://www.commoncoreontologies.org/ont00001300> a owl:Class ;
    rdfs:label "Patch Antenna"@en ;
    rdfs:subClassOf <https://www.commoncoreontologies.org/ont00001192> ;
    skos:definition "A Radio Antenna that consists of a flat rectangular sheet (or patch) of metal mounted over a larger sheet of metal called a ground plane which is typically contained inside a plastic radome for protection and is small enough that it can be mounted on a flat surface."@en .

<https://www.commoncoreontologies.org/ont00001302> a owl:Class ;
    rdfs:label "Civil Organization"@en ;
    rdfs:subClassOf <https://www.commoncoreontologies.org/ont00001180> ;
    skos:definition "An Organization that is not commercial or military and is the bearer of a Civilian Role."@en .

<https://www.commoncoreontologies.org/ont00001303> a owl:Class ;
    rdfs:label "Position Observation Artifact Function"@en ;
    rdfs:subClassOf <https://www.commoncoreontologies.org/ont00001306> ;
    skos:definition "An Observation Artifact Function that is realized during events in which a Material Artifact is used to collect information about the position of a specified object or class of objects."@en .

<https://www.commoncoreontologies.org/ont00001304> a owl:Class ;
    rdfs:label "Dimension Specification"@en ;
    rdfs:subClassOf <https://www.commoncoreontologies.org/ont00000575> ;
    skos:definition "An Quality Specification that prescribes some Size Quality."@en .

<https://www.commoncoreontologies.org/ont00001305> a owl:Class ;
    rdfs:label "Loss of Function"@en ;
    rdfs:subClassOf <https://www.commoncoreontologies.org/ont00001066> ;
    skos:definition "A Loss of Disposition in which some Independent Continuant ceases to be the bearer of some Function."@en .

<https://www.commoncoreontologies.org/ont00001307> a owl:Class ;
    rdfs:label "Measurement Unit of Mass Flow Rate"@en ;
    rdfs:subClassOf <https://www.commoncoreontologies.org/ont00000061> ;
    skos:definition "A Measurement Unit of Flow that is used as a standard for measurement of the rate at which the Mass of a substance passes per unit time."@en .

<https://www.commoncoreontologies.org/ont00001308> a owl:Class ;
    rdfs:label "Sewage Treatment Facility"@en ;
    rdfs:subClassOf <https://www.commoncoreontologies.org/ont00001315> ;
    skos:definition "A Waste Management Facility that is designed for removing contaminants from wastewater, especially sewage."@en .

<https://www.commoncoreontologies.org/ont00001309> a owl:Class ;
    rdfs:label "Lot Number"@en ;
    rdfs:subClassOf <https://www.commoncoreontologies.org/ont00000077> ;
    skos:definition "A Code Identifier that designates a particular quantity or lot of material from a single manufacturer."@en .

<https://www.commoncoreontologies.org/ont00001310> a owl:Class ;
    rdfs:label "Covering Artifact Function"@en ;
    rdfs:subClassOf <https://www.commoncoreontologies.org/ont00000323> ;
    skos:definition "An Artifact Function that is realized in a process in which an entity is covered."@en .

<https://www.commoncoreontologies.org/ont00001311> a owl:Class ;
    rdfs:label "Aircraft Manufacturing Facility"@en ;
    rdfs:subClassOf <https://www.commoncoreontologies.org/ont00000782> ;
    skos:definition "A Factory that is designed to manufacture Aircraft."@en .

<https://www.commoncoreontologies.org/ont00001312> a owl:Class ;
    rdfs:label "Paramilitary Force"@en ;
    rdfs:subClassOf <https://www.commoncoreontologies.org/ont00000274> ;
    skos:definition "An Armed Force whose organizational structure, training, subculture, and (often) function are similar to those of a professional Military, and which is not included as part of a Government's formal Armed Forces."@en .

<https://www.commoncoreontologies.org/ont00001313> a owl:Class ;
    rdfs:label "Article of Clothing"@en ;
    rdfs:subClassOf <https://www.commoncoreontologies.org/ont00000995> ;
    skos:definition "A Material Artifact that is designed to cover some portion of a body."@en .

<https://www.commoncoreontologies.org/ont00001314> a owl:Class ;
    rdfs:label "Legal System Act"@en ;
    rdfs:subClassOf <https://www.commoncoreontologies.org/ont00000228> ;
    skos:definition "A Planned Act performed by an Agent that realizes their role within the context of a legal system of some jurisdiction."@en .

<https://www.commoncoreontologies.org/ont00001316> a owl:Class ;
    rdfs:label "Gimbal"@en ;
    rdfs:subClassOf <https://www.commoncoreontologies.org/ont00001042> ;
    skos:definition "An Equipment Mount that consists of a pivoted support that allows a Material Artifact to Rotate about one or more Axes."@en .

<https://www.commoncoreontologies.org/ont00001317> a owl:Class ;
    rdfs:label "Measurement Unit of Volume"@en ;
    rdfs:subClassOf <https://www.commoncoreontologies.org/ont00000120> ;
    skos:definition "A Measurement Unit that is used as a standard for measurement of sites or three-dimensional spatial regions."@en .

<https://www.commoncoreontologies.org/ont00001318> a owl:Class ;
    rdfs:label "Yaw Orientation"@en ;
    rdfs:subClassOf <https://www.commoncoreontologies.org/ont00000119> ;
    skos:definition "A Spatial Orientation of an Object relative to its Yaw Axis."@en .

<https://www.commoncoreontologies.org/ont00001319> a owl:Class ;
    rdfs:label "Tank"@en ;
    rdfs:subClassOf <https://www.commoncoreontologies.org/ont00000427> ;
    skos:definition "An Armored Fighting Vehicle that is designed to carry heavy firepower, have a powerful Engine, and travel on one or more continuous tracks such that it is suitable for front-line combat and can provide operational maneuverability as well as tactical offensive and defensive capabilities."@en .

<https://www.commoncoreontologies.org/ont00001321> a owl:Class ;
    rdfs:label "Lead Acid Electric Battery"@en ;
    rdfs:subClassOf <https://www.commoncoreontologies.org/ont00001105> ;
    skos:definition "A Secondary Cell Electric Battery that has a lead anode and lead oxide cathode."@en .

<https://www.commoncoreontologies.org/ont00001322> a owl:Class ;
    rdfs:label "Decrease of Generically Dependent Continuant"@en ;
    rdfs:subClassOf <https://www.commoncoreontologies.org/ont00000726> ;
    skos:definition "A Decrease of Dependent Continuant in which some Independent Continuant has a decrease in the level of a Generically Dependent Continuant that it bears."@en .

<https://www.commoncoreontologies.org/ont00001323> a owl:Class ;
    rdfs:label "Bearing Artifact Function"@en ;
    rdfs:subClassOf <https://www.commoncoreontologies.org/ont00000323> ;
    skos:definition "An Artifact Function that is realized in processes in which the Material Artifact constrains relative motion to only the desired motion, and reduces friction between moving parts."@en .

<https://www.commoncoreontologies.org/ont00001325> a owl:Class ;
    rdfs:label "Act of Renting"@en ;
    rdfs:subClassOf <https://www.commoncoreontologies.org/ont00001334> ;
    skos:definition "An Act of Purchasing wherein a Financial Instrument is used by an Agent (the Renter) as a payment to acquire temporary possession or use of a good or property that is owned or controlled by another Agent (the Seller)."@en .

<https://www.commoncoreontologies.org/ont00001329> a owl:Class ;
    rdfs:label "Education Artifact Function"@en ;
    rdfs:subClassOf <https://www.commoncoreontologies.org/ont00001301> ;
    skos:definition "A Service Artifact Function that is realized in processes of transmiting accumulated knowledge skills and values from one generation to another."@en .

<https://www.commoncoreontologies.org/ont00001330> a owl:Class ;
    rdfs:label "Telemetry Process"@en ;
    rdfs:subClassOf <https://www.commoncoreontologies.org/ont00000110> ;
    skos:definition "A Mechanical Process that is highly automated and in which measurements are made or other data is collected and transmitted to receiving equipment to facilitate the monitoring of environmental conditions or equipment parameters at a remote or inaccessible location."@en .

<https://www.commoncoreontologies.org/ont00001331> a owl:Class ;
    rdfs:label "Legal Name"@en ;
    rdfs:subClassOf <https://www.commoncoreontologies.org/ont00001014> ;
    skos:definition "A Proper Name that is an official name for the designated entity as determined by a Government or court of law."@en .

<https://www.commoncoreontologies.org/ont00001332> a owl:Class ;
    rdfs:label "Extreme Ultraviolet Light Frequency"@en ;
    rdfs:subClassOf <https://www.commoncoreontologies.org/ont00000610> ;
    skos:definition "An Ultraviolet Light Frequency that is between 3 and 30 petahertz."@en .

<https://www.commoncoreontologies.org/ont00001333> a owl:Class ;
    rdfs:label "Rosy"@en ;
    rdfs:subClassOf <https://www.commoncoreontologies.org/ont00000378> ;
    skos:definition "A Color consisting of red hue and yellow hue and high brightness."@en .

<https://www.commoncoreontologies.org/ont00001336> a owl:Class ;
    rdfs:label "Act of Ownership"@en ;
    rdfs:subClassOf <https://www.commoncoreontologies.org/ont00001232> ;
    skos:definition "An Act of Possession that includes an agent having certain rights and duties over the property owned."@en .

<https://www.commoncoreontologies.org/ont00001338> a owl:Class ;
    rdfs:label "Timbre"@en ;
    rdfs:subClassOf <https://www.commoncoreontologies.org/ont00000862> ;
    skos:definition "A Sound Process Profile that is characterized by the variation, spectrum, or envelope of translated sound waves, typically on a continuum from dull or dark to bright."@en .

<https://www.commoncoreontologies.org/ont00001339> a owl:Class ;
    rdfs:label "Act of Walking"@en ;
    rdfs:subClassOf <https://www.commoncoreontologies.org/ont00000890> ;
    skos:definition "An Act of Travel that proceeds by foot."@en .

<https://www.commoncoreontologies.org/ont00001340> a owl:Class ;
    rdfs:label "Calendar Date Identifier"@en ;
    rdfs:subClassOf <https://www.commoncoreontologies.org/ont00000529> ;
    skos:definition "A Date Identifier that designates some Day by using a combination of Day, Week, Month, or Year Identifiers formatted according to an implementation of a Calendar System."@en .

<https://www.commoncoreontologies.org/ont00001342> a owl:Class ;
    rdfs:label "Infantry Fighting Vehicle"@en ;
    rdfs:subClassOf <https://www.commoncoreontologies.org/ont00000427> ;
    skos:definition "An Armored Fighting Vehicle that is designed to carry infantry into battle and to provide fire support for them."@en .

<https://www.commoncoreontologies.org/ont00001343> a owl:Class ;
    rdfs:label "Circuit Breaker"@en ;
    rdfs:subClassOf <https://www.commoncoreontologies.org/ont00000995> ;
    skos:definition "A Material Artifact that is designed to protect an electrical circuit from damage caused by excess current from an overload or short circuit."@en .

<https://www.commoncoreontologies.org/ont00001344> a owl:Class ;
    rdfs:label "Biological Depot"@en ;
    rdfs:subClassOf <https://www.commoncoreontologies.org/ont00000881> ;
    skos:definition "A Storage Facility that is designed to store biological agents."@en .

<https://www.commoncoreontologies.org/ont00001345> a owl:Class ;
    rdfs:label "Measurement Unit of Impulse"@en ;
    rdfs:subClassOf <https://www.commoncoreontologies.org/ont00000120> ;
    skos:definition "A Measurement Unit that is used as a standard for measurement of the integral of a Force applied to a portion of matter over a temporal interval."@en .

<https://www.commoncoreontologies.org/ont00001347> a owl:Class ;
    rdfs:label "Behavior"@en ;
    rdfs:subClassOf <https://www.commoncoreontologies.org/ont00000005> ;
    skos:definition "An Act in which an Independent Continuant participates as an Agent in response to external or internal stimuli and following some pattern which is dependent upon some combination of that Independent Continuant's internal state and external conditions."@en .

<https://www.commoncoreontologies.org/ont00001348> a owl:Class ;
    rdfs:label "Three-Dimensional Position"@en ;
    rdfs:subClassOf <http://purl.obolibrary.org/obo/BFO_0000028> ;
    skos:definition "A Three-Dimensional Spatial Region that encompasses the (minimal) spatial region in which some object is located at a particular time."@en .

<https://www.commoncoreontologies.org/ont00001349> a owl:Class ;
    rdfs:label "Grey"@en ;
    rdfs:subClassOf <https://www.commoncoreontologies.org/ont00000378> ;
    skos:definition "A Color between white and black colors."@en .

<https://www.commoncoreontologies.org/ont00001351> a owl:Class ;
    rdfs:label "Cartesian Coordinate System"@en ;
    rdfs:subClassOf <https://www.commoncoreontologies.org/ont00000275> ;
    skos:definition "A Spatial Reference System that identifies each point in a spatial region of n-dimensions using an ordered n-tuple of numerical coordinates that are the signed (i.e. positive or negative) distances measured in the same unit of length from the zero point where the fixed perpendicular Coordinate System Axes meet."@en .

<https://www.commoncoreontologies.org/ont00001352> a owl:Class ;
    rdfs:label "Greenwich Mean Time Zone Identifier"@en ;
    rdfs:subClassOf <https://www.commoncoreontologies.org/ont00000829> ;
    skos:definition "A Time Zone Identifier that designates a spatial region where the local time is calculated according to the specified offset from Greenwich Mean Time."@en .

<https://www.commoncoreontologies.org/ont00001354> a owl:Class ;
    rdfs:label "Vermilion"@en ;
    rdfs:subClassOf <https://www.commoncoreontologies.org/ont00000378> ;
    skos:definition "A Color consisting of red and orange hue with a slight amount of gray."@en .

<https://www.commoncoreontologies.org/ont00001355> a owl:Class ;
    rdfs:label "Freight Train Car"@en ;
    rdfs:subClassOf <https://www.commoncoreontologies.org/ont00000928> ;
    skos:definition "A Train Car that is designed to transport cargo."@en .

<https://www.commoncoreontologies.org/ont00001357> a owl:Class ;
    rdfs:label "Measurement Unit of Time"@en ;
    rdfs:subClassOf <https://www.commoncoreontologies.org/ont00000120> ;
    skos:definition "A Measurement Unit that is used as a standard for measurement of temporal regions."@en .

<https://www.commoncoreontologies.org/ont00001358> a owl:Class ;
    rdfs:label "School"@en ;
    rdfs:subClassOf <https://www.commoncoreontologies.org/ont00000270> ;
    skos:definition "An Education Facility that is designed to provide learning space and environments for teaching of students under the direction of teachers."@en .

<https://www.commoncoreontologies.org/ont00001359> a owl:Class ;
    rdfs:label "Act of Manufacturing"@en ;
    rdfs:subClassOf <https://www.commoncoreontologies.org/ont00000908> ;
    skos:definition "An Act of Material Artifact Processing wherein Material Artifacts are mass produced in a Facility for the purpose of being sold or distributed to consumers."@en .

<https://www.commoncoreontologies.org/ont00001361> a owl:Class ;
    rdfs:label "Healing Artifact Function"@en ;
    rdfs:subClassOf <https://www.commoncoreontologies.org/ont00000323> ;
    skos:definition "An Artifact Function that is realized in a process in which health is restored to an unbalanced, diseased, or damaged organism."@en .

<https://www.commoncoreontologies.org/ont00001362> a owl:Class ;
    rdfs:label "Gas Processing Facility"@en ;
    rdfs:subClassOf <https://www.commoncoreontologies.org/ont00001283> ;
    skos:definition "A Refinery that is designed for refining natural gas into products of value."@en .

<https://www.commoncoreontologies.org/ont00001363> a owl:Class ;
    rdfs:label "Male Sex"@en ;
    rdfs:subClassOf <https://www.commoncoreontologies.org/ont00001033> ;
    skos:definition "A Biological Sex inhering in an individual whose sex organs contain only male gametes."@en .

<https://www.commoncoreontologies.org/ont00001365> a owl:Class ;
    rdfs:label "Maximum Speed Artifact Function"@en ;
    rdfs:subClassOf <https://www.commoncoreontologies.org/ont00001353> ;
    skos:definition "A Speed Artifact Function that is realized in some process in which the Material Artifact bearing the Artifact Function attains the highest speed at which that Material Artifact is designed to operate."@en .

<https://www.commoncoreontologies.org/ont00001366> a owl:Class ;
    rdfs:label "Powering Artifact Function"@en ;
    rdfs:subClassOf <https://www.commoncoreontologies.org/ont00000323> ;
    skos:definition "An Artifact Function that is realized by processes in which some Material Artifact is used to supply power to some Material Artifact."@en .

<https://www.commoncoreontologies.org/ont00001368> a owl:Class ;
    rdfs:label "Motion Observation Artifact Function"@en ;
    rdfs:subClassOf <https://www.commoncoreontologies.org/ont00001306> ;
    skos:definition "An Observation Artifact Function that is realized during events in which a Material Artifact is used to collect information about the Motion of a specified object or class of objects."@en .

<https://www.commoncoreontologies.org/ont00001371> a owl:Class ;
    rdfs:label "Electromagnetic Induction Artifact Function"@en ;
    rdfs:subClassOf <https://www.commoncoreontologies.org/ont00000323> ;
    skos:definition "An Artifact Function that is realized by processes in which some Material Artifact that is used to produce electromotive force across an electrical conductor due to its dynamic interaction with a magnetic field."@en .

<https://www.commoncoreontologies.org/ont00001372> a owl:Class ;
    rdfs:label "Fertilizer Artifact Function"@en ;
    rdfs:subClassOf <https://www.commoncoreontologies.org/ont00000437> ;
    skos:definition "An Enhancing Artifact Function that is realized in processes of supplying soilds or plant tissues with one or more plant nutrients essential to growth."@en .

<https://www.commoncoreontologies.org/ont00001373> a owl:Class ;
    rdfs:label "Bow"@en ;
    rdfs:subClassOf <https://www.commoncoreontologies.org/ont00001051> ;
    skos:definition "A Projectile Launcher that is designed to launch Arrows."@en .

<https://www.commoncoreontologies.org/ont00001376> a owl:Class ;
    rdfs:label "Torque"@en ;
    rdfs:subClassOf <https://www.commoncoreontologies.org/ont00000570> ;
    skos:definition "A Force that is applied to an object in a direction that would tend to cause the object to rotate around an Axis of Rotation and is the rate of change of an object's Angular Momentum."@en .

<https://www.commoncoreontologies.org/ont00001377> a owl:Class ;
    rdfs:label "Gold Color"@en ;
    rdfs:subClassOf <https://www.commoncoreontologies.org/ont00000378> ;
    skos:definition "A Color that resembles a yellow-orange Hue with the added feature of having a metallic shine."@en .

<https://www.commoncoreontologies.org/ont00001378> a owl:Class ;
