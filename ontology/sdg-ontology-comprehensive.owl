                </owl:intersectionOf>
            </owl:Class>
        </owl:equivalentClass>
        <obo:IAO_0000115>An EnergyEfficientAppliance is an independent continuant that has a component that is an EnergySavingComponent.</obo:IAO_0000115>
        <rdfs:comment>An EnergyEfficientAppliance is an independent continuant that has a component that is an EnergySavingComponent.</rdfs:comment>
        <rdfs:label>energy efficient appliance</rdfs:label>
        <rdfs:label>has component</rdfs:label>
    </owl:Class>
    


