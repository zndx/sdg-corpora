                    <rdf:Description rdf:about="https://signals.zndx.org/sdg#voice"/>
                </owl:oneOf>
            </owl:Class>
        </owl:equivalentClass>
    </owl:Class>
    


    <!-- https://signals.zndx.org/sdg#DataInput -->

    <owl:Class rdf:about="https://signals.zndx.org/sdg#DataInput">
        <owl:disjointWith rdf:resource="https://signals.zndx.org/sdg#InvestmentChoiceDecision"/>
    </owl:Class>
    


    <!-- https://signals.zndx.org/sdg#DataPackage -->

    <owl:Class rdf:about="https://signals.zndx.org/sdg#DataPackage">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/BFO_0000040"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://signals.zndx.org/sdg#processedBy"/>
