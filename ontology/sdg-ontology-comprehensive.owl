                <owl:onProperty rdf:resource="https://signals.zndx.org/sdg#processingPeriodStart"/>
                <owl:someValuesFrom rdf:resource="http://www.w3.org/2001/XMLSchema#dateTime"/>
            </owl:Restriction>
        </rdfs:subClassOf>
