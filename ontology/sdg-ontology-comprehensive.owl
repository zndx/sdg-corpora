                    <rdf:Description rdf:about="https://www.commoncoreontologies.org/ont00000958"/>
                    <owl:Restriction>
                        <owl:onProperty rdf:resource="https://signals.zndx.org/sdg#applies_to"/>
                        <owl:someValuesFrom rdf:resource="https://signals.zndx.org/sdg#TelemarketerSalesAdministratorRole"/>
                    </owl:Restriction>
                    <owl:Restriction>
                        <owl:onProperty rdf:resource="https://signals.zndx.org/sdg#measures"/>
                        <owl:someValuesFrom rdf:resource="https://signals.zndx.org/sdg#CallVolumeMetric"/>
                    </owl:Restriction>
