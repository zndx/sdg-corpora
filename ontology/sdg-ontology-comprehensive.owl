                        <owl:onProperty rdf:resource="https://signals.zndx.org/sdg#utilizesProcedure"/>
                        <owl:someValuesFrom rdf:resource="https://signals.zndx.org/sdg#AutohemotherapyProcedure"/>
                    </owl:Restriction>
                </owl:intersectionOf>
            </owl:Class>
        </owl:equivalentClass>
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/BFO_0000015"/>
