                        <owl:someValuesFrom rdf:resource="https://signals.zndx.org/sdg#ExpeditionEquipment"/>
                    </owl:Restriction>
                </owl:intersectionOf>
            </owl:Class>
        </owl:equivalentClass>
        <obo:IAO_0000115>An ArcticExpedition is a process that involves at least one ExpeditionParticipant and utilizes at least one ExpeditionEquipment.</obo:IAO_0000115>
