                <owl:someValuesFrom rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <owl:disjointWith rdf:resource="https://signals.zndx.org/sdg#TopWorkplaceAward"/>
        <obo:IAO_0000115>A SafeguardMeasure is a DirectiveICE that mitigates an AbuseEvent and applies to a gTLDProgram.</obo:IAO_0000115>
        <rdfs:comment>A SafeguardMeasure is a DirectiveICE that mitigates an AbuseEvent and applies to a gTLDProgram.</rdfs:comment>
        <rdfs:label>safeguard measure</rdfs:label>
    </owl:Class>
    


