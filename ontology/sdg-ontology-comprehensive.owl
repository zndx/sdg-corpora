                <owl:someValuesFrom rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <obo:IAO_0000115>A TelemarketingKPIConstraint is an InformationContentEntity that applies to some TelemarketerSalesAdministratorRole, measures some CallVolumeMetric, and specifies a minimumCallsPerHour of type xsd:decimal.</obo:IAO_0000115>
        <rdfs:comment>A TelemarketingKPIConstraint is an InformationContentEntity that applies to some TelemarketerSalesAdministratorRole, measures some CallVolumeMetric, and specifies a minimumCallsPerHour of type xsd:decimal.</rdfs:comment>
        <rdfs:label>telemarketing k p i constraint</rdfs:label>
    </owl:Class>
    


