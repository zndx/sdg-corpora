    <!-- https://signals.zndx.org/sdg#AdoptionApplicationForm -->

    <owl:Class rdf:about="https://signals.zndx.org/sdg#AdoptionApplicationForm">
        <owl:equivalentClass>
            <owl:Class>
                <owl:intersectionOf rdf:parseType="Collection">
                    <rdf:Description rdf:about="https://www.commoncoreontologies.org/ont00000958"/>
                    <owl:Restriction>
                        <owl:onProperty rdf:resource="https://signals.zndx.org/sdg#documentsParticipant"/>
                        <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/BFO_0000015"/>
                    </owl:Restriction>
                    <owl:Restriction>
                        <owl:onProperty rdf:resource="https://signals.zndx.org/sdg#documentsProcess"/>
                        <owl:someValuesFrom rdf:resource="https://signals.zndx.org/sdg#AdultAdoptionProcess"/>
                    </owl:Restriction>
                    <owl:Restriction>
                        <owl:onProperty rdf:resource="https://signals.zndx.org/sdg#formVersion__cat"/>
                        <owl:someValuesFrom rdf:resource="http://www.w3.org/2001/XMLSchema#decimal"/>
                    </owl:Restriction>
                </owl:intersectionOf>
            </owl:Class>
        </owl:equivalentClass>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://signals.zndx.org/sdg#hasEncoding"/>
                <owl:someValuesFrom rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://signals.zndx.org/sdg#hasLabelText"/>
                <owl:someValuesFrom rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <owl:disjointWith rdf:resource="https://signals.zndx.org/sdg#BusinessPlan"/>
        <obo:IAO_0000115>An adoption application form is a document that records an adult adoption process, a participant process, and a version number.</obo:IAO_0000115>
