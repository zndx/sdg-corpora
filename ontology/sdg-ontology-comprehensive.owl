                    </owl:Class>
                </owl:allValuesFrom>
            </owl:Restriction>
        </rdfs:subClassOf>
        <obo:IAO_0000115>An {IncidentEscalationProcess} is realized only in a {SupervisoryReview} or an {ExternalAuditReview} — no other realization channel exists.</obo:IAO_0000115>
