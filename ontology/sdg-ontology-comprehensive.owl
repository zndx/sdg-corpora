    <!-- https://signals.zndx.org/sdg#StorageAllocation -->

    <owl:Class rdf:about="https://signals.zndx.org/sdg#StorageAllocation">
        <owl:equivalentClass>
            <owl:Class>
                <owl:intersectionOf rdf:parseType="Collection">
                    <rdf:Description rdf:about="https://www.commoncoreontologies.org/ont00000853"/>
                    <owl:Restriction>
                        <owl:onProperty rdf:resource="https://signals.zndx.org/sdg#allocatesTo"/>
                        <owl:qualifiedCardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">1</owl:qualifiedCardinality>
                        <owl:onClass rdf:resource="https://signals.zndx.org/sdg#Student"/>
                    </owl:Restriction>
                    <owl:Restriction>
                        <owl:onProperty rdf:resource="https://signals.zndx.org/sdg#providesResource"/>
                        <owl:qualifiedCardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">1</owl:qualifiedCardinality>
                        <owl:onClass rdf:resource="https://signals.zndx.org/sdg#CloudStorageVolume"/>
                    </owl:Restriction>
                </owl:intersectionOf>
            </owl:Class>
        </owl:equivalentClass>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://signals.zndx.org/sdg#hasConfidence"/>
                <owl:someValuesFrom rdf:resource="http://www.w3.org/2001/XMLSchema#decimal"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://signals.zndx.org/sdg#hasDimensionKind"/>
                <owl:someValuesFrom rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <obo:IAO_0000115>A StorageAllocation is a descriptive information content entity that allocates to exactly one Student and provides exactly one CloudStorageVolume.</obo:IAO_0000115>
        <rdfs:comment>A StorageAllocation is a descriptive information content entity that allocates to exactly one Student and provides exactly one CloudStorageVolume.</rdfs:comment>
        <rdfs:label>storage allocation</rdfs:label>
    </owl:Class>
    


