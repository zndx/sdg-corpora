    <!-- https://signals.zndx.org/sdg#HypothesisTest -->

    <owl:Class rdf:about="https://signals.zndx.org/sdg#HypothesisTest">
        <owl:equivalentClass>
            <owl:Class>
                <owl:intersectionOf rdf:parseType="Collection">
                    <rdf:Description rdf:about="http://purl.obolibrary.org/obo/BFO_0000015"/>
                    <owl:Restriction>
