    <!-- https://signals.zndx.org/sdg#SafeguardMeasure -->

    <owl:Class rdf:about="https://signals.zndx.org/sdg#SafeguardMeasure">
        <owl:equivalentClass>
            <owl:Class>
                <owl:intersectionOf rdf:parseType="Collection">
                    <rdf:Description rdf:about="https://www.commoncoreontologies.org/ont00000133"/>
                    <owl:Restriction>
                        <owl:onProperty rdf:resource="https://signals.zndx.org/sdg#appliesToProgram"/>
                        <owl:someValuesFrom rdf:resource="https://signals.zndx.org/sdg#gTLDProgram"/>
                    </owl:Restriction>
                    <owl:Restriction>
                        <owl:onProperty rdf:resource="https://signals.zndx.org/sdg#mitigates"/>
                        <owl:someValuesFrom rdf:resource="https://signals.zndx.org/sdg#AbuseEvent"/>
                    </owl:Restriction>
                </owl:intersectionOf>
            </owl:Class>
        </owl:equivalentClass>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://signals.zndx.org/sdg#hasEffectiveDate"/>
                <owl:someValuesFrom rdf:resource="http://www.w3.org/2001/XMLSchema#date"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
