                        <owl:onProperty rdf:resource="https://signals.zndx.org/sdg#minimumCallsPerHour"/>
                        <owl:someValuesFrom rdf:resource="http://www.w3.org/2001/XMLSchema#decimal"/>
                    </owl:Restriction>
