                        <owl:onProperty rdf:resource="https://signals.zndx.org/sdg#targets"/>
                        <owl:someValuesFrom rdf:resource="https://signals.zndx.org/sdg#StudentTalentCultivation"/>
                    </owl:Restriction>
                </owl:intersectionOf>
            </owl:Class>
        </owl:equivalentClass>
        <obo:IAO_0000115>An academic curriculum program is a process that delivers some interdisciplinary education and targets some student talent cultivation.</obo:IAO_0000115>
        <rdfs:comment>An academic curriculum program is a process that delivers some interdisciplinary education and targets some student talent cultivation.</rdfs:comment>
        <rdfs:label>academic curriculum program</rdfs:label>
        <rdfs:label>delivers</rdfs:label>
        <rdfs:label>targets</rdfs:label>
    </owl:Class>
    


    <!-- https://signals.zndx.org/sdg#AcademicDegree -->

    <owl:Class rdf:about="https://signals.zndx.org/sdg#AcademicDegree">
        <owl:equivalentClass>
            <owl:Class>
                <owl:intersectionOf rdf:parseType="Collection">
                    <rdf:Description rdf:about="http://purl.obolibrary.org/obo/BFO_0000031"/>
                    <owl:Restriction>
                        <owl:onProperty rdf:resource="https://signals.zndx.org/sdg#conferredBy"/>
                        <owl:someValuesFrom rdf:resource="https://signals.zndx.org/sdg#HigherEducationInstitution"/>
                    </owl:Restriction>
                    <owl:Restriction>
                        <owl:onProperty rdf:resource="https://signals.zndx.org/sdg#signifiesCompletionOf"/>
                        <owl:someValuesFrom rdf:resource="https://signals.zndx.org/sdg#AcademicCurriculumProgram"/>
                    </owl:Restriction>
                </owl:intersectionOf>
            </owl:Class>
        </owl:equivalentClass>
        <obo:IAO_0000115>An academic degree is a generically dependent continuant that signifies the completion of an academic curriculum program and is conferred by a higher education institution.</obo:IAO_0000115>
