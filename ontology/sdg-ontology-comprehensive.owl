                <owl:someValuesFrom rdf:resource="http://www.w3.org/2001/XMLSchema#dateTime"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <obo:IAO_0000115>A clinical process representing a single administration of ozone/oxygen autohemotherapy to a patient.</obo:IAO_0000115>
        <obo:IAO_0000115>An OzoneTherapySession is a process that administers an OzoneOxygenMixture and utilizes an AutohemotherapyProcedure.</obo:IAO_0000115>
        <rdfs:comment>An OzoneTherapySession is a process that administers an OzoneOxygenMixture and utilizes an AutohemotherapyProcedure.</rdfs:comment>
        <rdfs:label>Ozone Therapy Session</rdfs:label>
        <rdfs:label>ozone therapy session</rdfs:label>
    </owl:Class>
    


