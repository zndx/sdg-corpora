        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://signals.zndx.org/sdg#timestamp"/>
                <owl:someValuesFrom rdf:resource="http://www.w3.org/2001/XMLSchema#dateTime"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <obo:IAO_0000115>A discrete unit of data transmitted across the Internet, encapsulated and encrypted within a VPN tunnel to prevent industrial espionage.</obo:IAO_0000115>
        <rdfs:label>Encrypted Data Packet</rdfs:label>
    </owl:Class>
    


    <!-- https://signals.zndx.org/sdg#DataProcessingConsent -->

    <owl:Class rdf:about="https://signals.zndx.org/sdg#DataProcessingConsent">
