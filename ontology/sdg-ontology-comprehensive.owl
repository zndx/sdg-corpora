    <!-- https://signals.zndx.org/sdg#DdosMitigationProcess -->

    <owl:Class rdf:about="https://signals.zndx.org/sdg#DdosMitigationProcess">
        <owl:equivalentClass>
            <owl:Class>
                <owl:intersectionOf rdf:parseType="Collection">
                    <rdf:Description rdf:about="http://purl.obolibrary.org/obo/BFO_0000015"/>
                    <owl:Restriction>
                        <owl:onProperty rdf:resource="https://signals.zndx.org/sdg#hasProtectedInfrastructure"/>
                        <owl:someValuesFrom rdf:resource="https://signals.zndx.org/sdg#NetworkInfrastructure"/>
                    </owl:Restriction>
                    <owl:Restriction>
                        <owl:onProperty rdf:resource="https://signals.zndx.org/sdg#hasTriggeringAttack"/>
                        <owl:someValuesFrom rdf:resource="https://signals.zndx.org/sdg#DdosAttackEvent"/>
                    </owl:Restriction>
                    <owl:Restriction>
                        <owl:onProperty rdf:resource="https://signals.zndx.org/sdg#mitigates"/>
                        <owl:someValuesFrom rdf:resource="https://signals.zndx.org/sdg#DdosAttackEvent"/>
                    </owl:Restriction>
                </owl:intersectionOf>
            </owl:Class>
        </owl:equivalentClass>
        <obo:IAO_0000115>A DdosMitigationProcess is a Process that hasTriggeringAttack some DdosAttackEvent and hasProtectedInfrastructure some NetworkInfrastructure.</obo:IAO_0000115>
        <rdfs:comment>A DdosMitigationProcess is a Process that hasTriggeringAttack some DdosAttackEvent and hasProtectedInfrastructure some NetworkInfrastructure.</rdfs:comment>
        <rdfs:label>ddos mitigation process</rdfs:label>
