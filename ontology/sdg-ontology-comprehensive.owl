        <rdfs:label>Data Processing Record</rdfs:label>
    </owl:Class>
    


    <!-- https://signals.zndx.org/sdg#DataProcessor -->

    <owl:Class rdf:about="https://signals.zndx.org/sdg#DataProcessor">
