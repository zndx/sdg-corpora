<https://signals.zndx.org/sdg#AIEngineShape>
    a sh:NodeShape ;
    sh:targetClass <https://signals.zndx.org/sdg#AIEngine> ;
    sh:property [
        sh:path <https://signals.zndx.org/sdg#engineId> ;
        sh:datatype xsd:string ;
    ] ;
    sh:property [
        sh:path <https://signals.zndx.org/sdg#engineName> ;
        sh:datatype xsd:string ;
    ] ;
    sh:property [
        sh:path <https://signals.zndx.org/sdg#processingEfficiency> ;
        sh:datatype xsd:decimal ;
    ] ;
    sh:property [
        sh:path <https://signals.zndx.org/sdg#supportedLanguages> ;
        sh:datatype xsd:string ;
        sh:in ("english" "japanese" "chinese" "korean") ;
    ] ;
    sh:property [
        sh:path <https://signals.zndx.org/sdg#trainingData> ;
        sh:datatype xsd:string ;
    ] ;
    sh:property [
        sh:path <https://signals.zndx.org/sdg#usedBy> ;
        sh:class <https://signals.zndx.org/sdg#LegalTechSolutionLab> ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
    ] ;
    sh:property [
        sh:path <https://signals.zndx.org/sdg#usedIn> ;
        sh:class <https://signals.zndx.org/sdg#InvestigationCase> ;
        sh:minCount 1 ;
    ] ;
    sh:property [
        sh:path <https://signals.zndx.org/sdg#version> ;
        sh:datatype xsd:string ;
    ] .

