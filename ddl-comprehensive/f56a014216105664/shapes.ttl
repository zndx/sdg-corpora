        sh:in ("StatusKind__pending" "StatusKind__in_progress" "StatusKind__complete" "StatusKind__failed") ;
    ] ;
    sh:property [
        sh:path <https://signals.zndx.org/sdg#zoningDistrict> ;
        sh:datatype xsd:string ;
        sh:in ("garden_city" "ZoningDistrictKind__residential" "ZoningDistrictKind__commercial" "green_belt" "industrial") ;
    ] .

