@prefix skos: <http://www.w3.org/2004/02/skos/core#> .
@prefix sdg:  <https://signals360.example.org/sdg#> .

<https://signals360.example.org/sdg/scheme> a skos:ConceptScheme ;
    skos:prefLabel "SDG column-type vocabulary (ontology-derived)" .

<https://signals360.example.org/sdg#SDG_PROCESS> a skos:Concept ;
    skos:prefLabel "Process" ;
    skos:notation "1" ;
    skos:altLabel "PROC" ;
    skos:definition "A BFO process (occurrent): an entity that unfolds in time, e.g. an observation, a program execution, a governance activity." ;
    skos:inScheme <https://signals360.example.org/sdg/scheme> .

<https://signals360.example.org/sdg#SDG_INDEPENDENT_CONTINUANT> a skos:Concept ;
    skos:prefLabel "Independent Continuant" ;
    skos:notation "2" ;
    skos:altLabel "INDCONT" ;
    skos:definition "A BFO independent continuant: a bearer of qualities that persists through time." ;
    skos:inScheme <https://signals360.example.org/sdg/scheme> .

<https://signals360.example.org/sdg#SDG_ARTIFACT> a skos:Concept ;
    skos:prefLabel "Artifact" ;
    skos:notation "2.1" ;
    skos:altLabel "ARTIFACT" ;
    skos:definition "A CCO artifact: an object intentionally made to realize a function (instruments, systems, datasets-as-objects)." ;
    skos:broader <https://signals360.example.org/sdg#SDG_INDEPENDENT_CONTINUANT> ;
    skos:inScheme <https://signals360.example.org/sdg/scheme> .

<https://signals360.example.org/sdg#SDG_ICE> a skos:Concept ;
    skos:prefLabel "Information Content Entity" ;
    skos:notation "3" ;
    skos:altLabel "ICE" ;
    skos:definition "A CCO information content entity: a generically dependent continuant that is about, or carries information concerning, some entity." ;
    skos:inScheme <https://signals360.example.org/sdg/scheme> .

<https://signals360.example.org/sdg#SDG_ICE_DESCRIPTIVE> a skos:Concept ;
    skos:prefLabel "Descriptive Information Content Entity" ;
    skos:notation "3.1" ;
    skos:altLabel "DESCICE" ;
    skos:definition "An ICE that describes an entity or state of affairs (measurements, records, observations)." ;
    skos:broader <https://signals360.example.org/sdg#SDG_ICE> ;
    skos:inScheme <https://signals360.example.org/sdg/scheme> .

<https://signals360.example.org/sdg#SDG_ICE_DIRECTIVE> a skos:Concept ;
    skos:prefLabel "Directive Information Content Entity" ;
    skos:notation "3.2" ;
    skos:altLabel "DIRICE" ;
    skos:definition "An ICE that prescribes or directs (plans, rules, requirements, policies)." ;
    skos:broader <https://signals360.example.org/sdg#SDG_ICE> ;
    skos:inScheme <https://signals360.example.org/sdg/scheme> .

<https://signals360.example.org/sdg#SDG_ICE_DESIGNATIVE> a skos:Concept ;
    skos:prefLabel "Designative Information Content Entity" ;
    skos:notation "3.3" ;
    skos:altLabel "DESIGICE" ;
    skos:definition "An ICE that designates or names an entity (identifiers, codes, keys)." ;
    skos:broader <https://signals360.example.org/sdg#SDG_ICE> ;
    skos:inScheme <https://signals360.example.org/sdg/scheme> .

<https://signals360.example.org/sdg#SDG_GENERIC> a skos:Concept ;
    skos:prefLabel "Generic Entity" ;
    skos:notation "0" ;
    skos:altLabel "GENERIC" ;
    skos:definition "Foundational / domain-agnostic axiom patterns without a specific BFO/CCO anchor." ;
    skos:inScheme <https://signals360.example.org/sdg/scheme> .

<https://signals360.example.org/sdg#SDG_GENERIC_SUBCLASS_BASIC> a skos:Concept ;
    skos:prefLabel "Subclass Basic" ;
    skos:notation "0.1" ;
    skos:altLabel "SUBCLASS_BASIC" ;
    skos:definition "{X} is a {Y} — Class: {X:Class} SubClassOf: {Y:Class}" ;
    skos:broader <https://signals360.example.org/sdg#SDG_GENERIC> ;
    skos:inScheme <https://signals360.example.org/sdg/scheme> .

<https://signals360.example.org/sdg#SDG_ARTIFACT_SUBCLASS_TO_ARTIFACT> a skos:Concept ;
    skos:prefLabel "Subclass To Artifact" ;
    skos:notation "2.1.1" ;
    skos:altLabel "SUBCLASS_TO_ARTIFACT" ;
    skos:definition "{X} is an artifact — Class: {X:Class} SubClassOf: cco:Artifact" ;
    skos:broader <https://signals360.example.org/sdg#SDG_ARTIFACT> ;
    skos:inScheme <https://signals360.example.org/sdg/scheme> .

<https://signals360.example.org/sdg#SDG_INDEPENDENT_CONTINUANT_SUBCLASS_TO_INDEPENDENT_CONTINUANT> a skos:Concept ;
    skos:prefLabel "Subclass To Independent Continuant" ;
    skos:notation "2.1" ;
    skos:altLabel "SUBCLASS_TO_INDEPENDENT_CONTINUANT" ;
    skos:definition "{X} is an independent continuant — Class: {X:Class} SubClassOf: bfo:0000004" ;
    skos:broader <https://signals360.example.org/sdg#SDG_INDEPENDENT_CONTINUANT> ;
    skos:inScheme <https://signals360.example.org/sdg/scheme> .

<https://signals360.example.org/sdg#SDG_ICE_SUBCLASS_TO_INFORMATION_CONTENT_ENTITY> a skos:Concept ;
    skos:prefLabel "Subclass To Information Content Entity" ;
    skos:notation "3.1" ;
    skos:altLabel "SUBCLASS_TO_INFORMATION_CONTENT_ENTITY" ;
    skos:definition "{X} is an information content entity — Class: {X:Class} SubClassOf: cco:InformationContentEntity" ;
    skos:broader <https://signals360.example.org/sdg#SDG_ICE> ;
    skos:inScheme <https://signals360.example.org/sdg/scheme> .

<https://signals360.example.org/sdg#SDG_ICE_SUBCLASS_TO_DESIGNATIVE_ICE> a skos:Concept ;
    skos:prefLabel "Subclass To Designative Ice" ;
    skos:notation "3.2" ;
    skos:altLabel "SUBCLASS_TO_DESIGNATIVE_ICE" ;
    skos:definition "{X} is a designative information content entity — Class: {X:Class} SubClassOf: cco:DesignativeICE" ;
    skos:broader <https://signals360.example.org/sdg#SDG_ICE> ;
    skos:inScheme <https://signals360.example.org/sdg/scheme> .

<https://signals360.example.org/sdg#SDG_ICE_SUBCLASS_TO_DESCRIPTIVE_ICE> a skos:Concept ;
    skos:prefLabel "Subclass To Descriptive Ice" ;
    skos:notation "3.3" ;
    skos:altLabel "SUBCLASS_TO_DESCRIPTIVE_ICE" ;
    skos:definition "{X} is a descriptive information content entity — Class: {X:Class} SubClassOf: cco:DescriptiveICE" ;
    skos:broader <https://signals360.example.org/sdg#SDG_ICE> ;
    skos:inScheme <https://signals360.example.org/sdg/scheme> .

<https://signals360.example.org/sdg#SDG_ICE_SUBCLASS_TO_DIRECTIVE_ICE> a skos:Concept ;
    skos:prefLabel "Subclass To Directive Ice" ;
    skos:notation "3.4" ;
    skos:altLabel "SUBCLASS_TO_DIRECTIVE_ICE" ;
    skos:definition "{X} is a directive information content entity — Class: {X:Class} SubClassOf: cco:DirectiveICE" ;
    skos:broader <https://signals360.example.org/sdg#SDG_ICE> ;
    skos:inScheme <https://signals360.example.org/sdg/scheme> .

<https://signals360.example.org/sdg#SDG_PROCESS_SUBCLASS_TO_PROCESS> a skos:Concept ;
    skos:prefLabel "Subclass To Process" ;
    skos:notation "1.1" ;
    skos:altLabel "SUBCLASS_TO_PROCESS" ;
    skos:definition "{X} is a process — Class: {X:Class} SubClassOf: bfo:0000015" ;
    skos:broader <https://signals360.example.org/sdg#SDG_PROCESS> ;
    skos:inScheme <https://signals360.example.org/sdg/scheme> .

<https://signals360.example.org/sdg#SDG_GENERIC_EXISTENTIAL_GENERIC> a skos:Concept ;
    skos:prefLabel "Existential Generic" ;
    skos:notation "0.2" ;
    skos:altLabel "EXISTENTIAL_GENERIC" ;
    skos:definition "{X} is something that {p} {Y} — Class: {X:Class} SubClassOf: {p:ObjectProperty} some {Y:Class}" ;
    skos:broader <https://signals360.example.org/sdg#SDG_GENERIC> ;
    skos:inScheme <https://signals360.example.org/sdg/scheme> .

<https://signals360.example.org/sdg#SDG_ARTIFACT_ARTIFACT_WITH_EXISTENTIAL> a skos:Concept ;
    skos:prefLabel "Artifact With Existential" ;
    skos:notation "2.1.2" ;
    skos:altLabel "ARTIFACT_WITH_EXISTENTIAL" ;
    skos:definition "{X} is an artifact that {p} {Y} — Class: {X:Class} SubClassOf: cco:Artifact, {p:ObjectProperty} some {Y:Class}" ;
    skos:broader <https://signals360.example.org/sdg#SDG_ARTIFACT> ;
    skos:inScheme <https://signals360.example.org/sdg/scheme> .

<https://signals360.example.org/sdg#SDG_ICE_ICE_WITH_EXISTENTIAL> a skos:Concept ;
    skos:prefLabel "Ice With Existential" ;
    skos:notation "3.5" ;
    skos:altLabel "ICE_WITH_EXISTENTIAL" ;
    skos:definition "{X} is an information content entity that {p} {Y} — Class: {X:Class} SubClassOf: cco:InformationContentEntity, {p:ObjectProperty} some {Y:Class}" ;
    skos:broader <https://signals360.example.org/sdg#SDG_ICE> ;
    skos:inScheme <https://signals360.example.org/sdg/scheme> .

<https://signals360.example.org/sdg#SDG_PROCESS_PROCESS_WITH_PARTICIPANT> a skos:Concept ;
    skos:prefLabel "Process With Participant" ;
    skos:notation "1.2" ;
    skos:altLabel "PROCESS_WITH_PARTICIPANT" ;
    skos:definition "{X} is a process that {p} {Y} — Class: {X:Class} SubClassOf: bfo:0000015, {p:ObjectProperty} some {Y:Class}" ;
    skos:broader <https://signals360.example.org/sdg#SDG_PROCESS> ;
    skos:inScheme <https://signals360.example.org/sdg/scheme> .

<https://signals360.example.org/sdg#SDG_GENERIC_EXISTENTIAL_WITH_PART_OF> a skos:Concept ;
    skos:prefLabel "Existential With Part Of" ;
    skos:notation "0.3" ;
    skos:altLabel "EXISTENTIAL_WITH_PART_OF" ;
    skos:definition "{X} is something that part of {Y} — Class: {X:Class} SubClassOf: bfo:0000050 some {Y:Class}" ;
    skos:broader <https://signals360.example.org/sdg#SDG_GENERIC> ;
    skos:inScheme <https://signals360.example.org/sdg/scheme> .

<https://signals360.example.org/sdg#SDG_GENERIC_EXISTENTIAL_WITH_HAS_PART> a skos:Concept ;
    skos:prefLabel "Existential With Has Part" ;
    skos:notation "0.4" ;
    skos:altLabel "EXISTENTIAL_WITH_HAS_PART" ;
    skos:definition "{X} is something that has part {Y} — Class: {X:Class} SubClassOf: bfo:0000051 some {Y:Class}" ;
    skos:broader <https://signals360.example.org/sdg#SDG_GENERIC> ;
    skos:inScheme <https://signals360.example.org/sdg/scheme> .

<https://signals360.example.org/sdg#SDG_GENERIC_EXISTENTIAL_TWO_CLAUSES> a skos:Concept ;
    skos:prefLabel "Existential Two Clauses" ;
    skos:notation "0.5" ;
    skos:altLabel "EXISTENTIAL_TWO_CLAUSES" ;
    skos:definition "{X} is something that {p} {Y} — Class: {X:Class} SubClassOf: {p:ObjectProperty} some {Y:Class}, {q:ObjectProperty} some {Z:Class}" ;
    skos:broader <https://signals360.example.org/sdg#SDG_GENERIC> ;
    skos:inScheme <https://signals360.example.org/sdg/scheme> .

<https://signals360.example.org/sdg#SDG_ARTIFACT_EXISTENTIAL_ANCHORED_TO_ARTIFACT_VIA_PART> a skos:Concept ;
    skos:prefLabel "Existential Anchored To Artifact Via Part" ;
    skos:notation "2.1.3" ;
    skos:altLabel "EXISTENTIAL_ANCHORED_TO_ARTIFACT_VIA_PART" ;
    skos:definition "{X} is something that part of artifact — Class: {X:Class} SubClassOf: bfo:0000050 some cco:Artifact" ;
    skos:broader <https://signals360.example.org/sdg#SDG_ARTIFACT> ;
    skos:inScheme <https://signals360.example.org/sdg/scheme> .

<https://signals360.example.org/sdg#SDG_GENERIC_UNIVERSAL_GENERIC> a skos:Concept ;
    skos:prefLabel "Universal Generic" ;
    skos:notation "0.6" ;
    skos:altLabel "UNIVERSAL_GENERIC" ;
    skos:definition "{X} is something that {p} {Y} — Class: {X:Class} SubClassOf: {p:ObjectProperty} only {Y:Class}" ;
    skos:broader <https://signals360.example.org/sdg#SDG_GENERIC> ;
    skos:inScheme <https://signals360.example.org/sdg/scheme> .

<https://signals360.example.org/sdg#SDG_ARTIFACT_ARTIFACT_WITH_UNIVERSAL> a skos:Concept ;
    skos:prefLabel "Artifact With Universal" ;
    skos:notation "2.1.4" ;
    skos:altLabel "ARTIFACT_WITH_UNIVERSAL" ;
    skos:definition "{X} is an artifact that {p} {Y} — Class: {X:Class} SubClassOf: cco:Artifact, {p:ObjectProperty} only {Y:Class}" ;
    skos:broader <https://signals360.example.org/sdg#SDG_ARTIFACT> ;
    skos:inScheme <https://signals360.example.org/sdg/scheme> .

<https://signals360.example.org/sdg#SDG_ICE_DIRECTIVE_DIRECTIVE_ONLY_GOVERNS> a skos:Concept ;
    skos:prefLabel "Directive Only Governs" ;
    skos:notation "3.2.1" ;
    skos:altLabel "DIRECTIVE_ONLY_GOVERNS" ;
    skos:definition "{X} is a directive information content entity that {p} {Y} — Class: {X:Class} SubClassOf: cco:DirectiveICE, {p:ObjectProperty} only {Y:Class}" ;
    skos:broader <https://signals360.example.org/sdg#SDG_ICE_DIRECTIVE> ;
    skos:inScheme <https://signals360.example.org/sdg/scheme> .

<https://signals360.example.org/sdg#SDG_GENERIC_UNIVERSAL_COMBINED_WITH_EXISTENTIAL> a skos:Concept ;
    skos:prefLabel "Universal Combined With Existential" ;
    skos:notation "0.7" ;
    skos:altLabel "UNIVERSAL_COMBINED_WITH_EXISTENTIAL" ;
    skos:definition "{X} is something that {p} {Y} — Class: {X:Class} SubClassOf: {p:ObjectProperty} some {Y:Class}, {p:ObjectProperty} only {Y:Class}" ;
    skos:broader <https://signals360.example.org/sdg#SDG_GENERIC> ;
    skos:inScheme <https://signals360.example.org/sdg/scheme> .

<https://signals360.example.org/sdg#SDG_GENERIC_CARDINALITY_MIN_ONE_GENERIC> a skos:Concept ;
    skos:prefLabel "Cardinality Min One Generic" ;
    skos:notation "0.8" ;
    skos:altLabel "CARDINALITY_MIN_ONE_GENERIC" ;
    skos:definition "Class: {X:Class} SubClassOf: {p:ObjectProperty} min 1 {Y:Class}" ;
    skos:broader <https://signals360.example.org/sdg#SDG_GENERIC> ;
    skos:inScheme <https://signals360.example.org/sdg/scheme> .

<https://signals360.example.org/sdg#SDG_GENERIC_CARDINALITY_MAX_ONE_GENERIC> a skos:Concept ;
    skos:prefLabel "Cardinality Max One Generic" ;
    skos:notation "0.9" ;
    skos:altLabel "CARDINALITY_MAX_ONE_GENERIC" ;
    skos:definition "Class: {X:Class} SubClassOf: {p:ObjectProperty} max 1 {Y:Class}" ;
    skos:broader <https://signals360.example.org/sdg#SDG_GENERIC> ;
    skos:inScheme <https://signals360.example.org/sdg/scheme> .

<https://signals360.example.org/sdg#SDG_GENERIC_CARDINALITY_EXACTLY_ONE_GENERIC> a skos:Concept ;
    skos:prefLabel "Cardinality Exactly One Generic" ;
    skos:notation "0.10" ;
    skos:altLabel "CARDINALITY_EXACTLY_ONE_GENERIC" ;
    skos:definition "Class: {X:Class} SubClassOf: {p:ObjectProperty} exactly 1 {Y:Class}" ;
    skos:broader <https://signals360.example.org/sdg#SDG_GENERIC> ;
    skos:inScheme <https://signals360.example.org/sdg/scheme> .

<https://signals360.example.org/sdg#SDG_GENERIC_CARDINALITY_MIN_TWO_GENERIC> a skos:Concept ;
    skos:prefLabel "Cardinality Min Two Generic" ;
    skos:notation "0.11" ;
    skos:altLabel "CARDINALITY_MIN_TWO_GENERIC" ;
    skos:definition "Class: {X:Class} SubClassOf: {p:ObjectProperty} min 2 {Y:Class}" ;
    skos:broader <https://signals360.example.org/sdg#SDG_GENERIC> ;
    skos:inScheme <https://signals360.example.org/sdg/scheme> .

<https://signals360.example.org/sdg#SDG_GENERIC_CARDINALITY_MAX_THREE_GENERIC> a skos:Concept ;
    skos:prefLabel "Cardinality Max Three Generic" ;
    skos:notation "0.12" ;
    skos:altLabel "CARDINALITY_MAX_THREE_GENERIC" ;
    skos:definition "Class: {X:Class} SubClassOf: {p:ObjectProperty} max 3 {Y:Class}" ;
    skos:broader <https://signals360.example.org/sdg#SDG_GENERIC> ;
    skos:inScheme <https://signals360.example.org/sdg/scheme> .

<https://signals360.example.org/sdg#SDG_ARTIFACT_ARTIFACT_MIN_ONE_ID> a skos:Concept ;
    skos:prefLabel "Artifact Min One Id" ;
    skos:notation "2.1.5" ;
    skos:altLabel "ARTIFACT_MIN_ONE_ID" ;
    skos:definition "{X} is an artifact — Class: {X:Class} SubClassOf: cco:Artifact, {p:ObjectProperty} min 1 cco:DesignativeICE" ;
    skos:broader <https://signals360.example.org/sdg#SDG_ARTIFACT> ;
    skos:inScheme <https://signals360.example.org/sdg/scheme> .

<https://signals360.example.org/sdg#SDG_ICE_ICE_EXACTLY_ONE_SUBJECT> a skos:Concept ;
    skos:prefLabel "Ice Exactly One Subject" ;
    skos:notation "3.6" ;
    skos:altLabel "ICE_EXACTLY_ONE_SUBJECT" ;
    skos:definition "{X} is an information content entity — Class: {X:Class} SubClassOf: cco:InformationContentEntity, {p:ObjectProperty} exactly 1 {Y:Class}" ;
    skos:broader <https://signals360.example.org/sdg#SDG_ICE> ;
    skos:inScheme <https://signals360.example.org/sdg/scheme> .

<https://signals360.example.org/sdg#SDG_GENERIC_EQUIV_INTERSECT_BASIC> a skos:Concept ;
    skos:prefLabel "Equiv Intersect Basic" ;
    skos:notation "0.13" ;
    skos:altLabel "EQUIV_INTERSECT_BASIC" ;
    skos:definition "{X} is equivalent to {Y} and {Z} — Class: {X:Class} EquivalentTo: {Y:Class} and {Z:Class}" ;
    skos:broader <https://signals360.example.org/sdg#SDG_GENERIC> ;
    skos:inScheme <https://signals360.example.org/sdg/scheme> .

<https://signals360.example.org/sdg#SDG_GENERIC_EQUIV_INTERSECT_THREE> a skos:Concept ;
    skos:prefLabel "Equiv Intersect Three" ;
    skos:notation "0.14" ;
    skos:altLabel "EQUIV_INTERSECT_THREE" ;
    skos:definition "{X} is equivalent to {W} and {Y} and {Z} — Class: {X:Class} EquivalentTo: {Y:Class} and {Z:Class} and {W:Class}" ;
    skos:broader <https://signals360.example.org/sdg#SDG_GENERIC> ;
    skos:inScheme <https://signals360.example.org/sdg/scheme> .

<https://signals360.example.org/sdg#SDG_ARTIFACT_EQUIV_INTERSECT_ANCHORED_ARTIFACT> a skos:Concept ;
    skos:prefLabel "Equiv Intersect Anchored Artifact" ;
    skos:notation "2.1.6" ;
    skos:altLabel "EQUIV_INTERSECT_ANCHORED_ARTIFACT" ;
    skos:definition "{X} is equivalent to {Y} and artifact — Class: {X:Class} EquivalentTo: cco:Artifact and {Y:Class}" ;
    skos:broader <https://signals360.example.org/sdg#SDG_ARTIFACT> ;
    skos:inScheme <https://signals360.example.org/sdg/scheme> .

<https://signals360.example.org/sdg#SDG_GENERIC_EQUIV_INTERSECT_WITH_RESTRICTION> a skos:Concept ;
    skos:prefLabel "Equiv Intersect With Restriction" ;
    skos:notation "0.15" ;
    skos:altLabel "EQUIV_INTERSECT_WITH_RESTRICTION" ;
    skos:definition "{X} is equivalent to {Y} that {p} {Z} — Class: {X:Class} EquivalentTo: {Y:Class} and ({p:ObjectProperty} some {Z:Class})" ;
    skos:broader <https://signals360.example.org/sdg#SDG_GENERIC> ;
    skos:inScheme <https://signals360.example.org/sdg/scheme> .

<https://signals360.example.org/sdg#SDG_ARTIFACT_EQUIV_INTERSECT_ARTIFACT_WITH_PART> a skos:Concept ;
    skos:prefLabel "Equiv Intersect Artifact With Part" ;
    skos:notation "2.1.7" ;
    skos:altLabel "EQUIV_INTERSECT_ARTIFACT_WITH_PART" ;
    skos:definition "Class: {X:Class} EquivalentTo: cco:Artifact and (bfo:0000051 some {Y:Class})" ;
    skos:broader <https://signals360.example.org/sdg#SDG_ARTIFACT> ;
    skos:inScheme <https://signals360.example.org/sdg/scheme> .

<https://signals360.example.org/sdg#SDG_GENERIC_EQUIV_INTERSECT_WITH_TWO_RESTRICTIONS> a skos:Concept ;
    skos:prefLabel "Equiv Intersect With Two Restrictions" ;
    skos:notation "0.16" ;
    skos:altLabel "EQUIV_INTERSECT_WITH_TWO_RESTRICTIONS" ;
    skos:definition "{X} is equivalent to {Y} that {p} {Z} and {q} {W} — Class: {X:Class} EquivalentTo: {Y:Class} and ({p:ObjectProperty} some {Z:Class}) and ({q:ObjectProperty} only {W:Class})" ;
    skos:broader <https://signals360.example.org/sdg#SDG_GENERIC> ;
    skos:inScheme <https://signals360.example.org/sdg/scheme> .

<https://signals360.example.org/sdg#SDG_GENERIC_EQUIV_UNION_BASIC> a skos:Concept ;
    skos:prefLabel "Equiv Union Basic" ;
    skos:notation "0.17" ;
    skos:altLabel "EQUIV_UNION_BASIC" ;
    skos:definition "{X} is equivalent to {Y} or {Z} — Class: {X:Class} EquivalentTo: {Y:Class} or {Z:Class}" ;
    skos:broader <https://signals360.example.org/sdg#SDG_GENERIC> ;
    skos:inScheme <https://signals360.example.org/sdg/scheme> .

<https://signals360.example.org/sdg#SDG_GENERIC_EQUIV_UNION_THREE> a skos:Concept ;
    skos:prefLabel "Equiv Union Three" ;
    skos:notation "0.18" ;
    skos:altLabel "EQUIV_UNION_THREE" ;
    skos:definition "{X} is equivalent to {W} or {Y} or {Z} — Class: {X:Class} EquivalentTo: {Y:Class} or {Z:Class} or {W:Class}" ;
    skos:broader <https://signals360.example.org/sdg#SDG_GENERIC> ;
    skos:inScheme <https://signals360.example.org/sdg/scheme> .

<https://signals360.example.org/sdg#SDG_ICE_EQUIV_UNION_ICE_BRANCHES> a skos:Concept ;
    skos:prefLabel "Equiv Union Ice Branches" ;
    skos:notation "3.7" ;
    skos:altLabel "EQUIV_UNION_ICE_BRANCHES" ;
    skos:definition "{X} is equivalent to descriptive information content entity or designative information content entity or directive information content entity — Class: {X:Class} EquivalentTo: cco:DesignativeICE or cco:DescriptiveICE or cco:DirectiveICE" ;
    skos:broader <https://signals360.example.org/sdg#SDG_ICE> ;
    skos:inScheme <https://signals360.example.org/sdg/scheme> .

<https://signals360.example.org/sdg#SDG_GENERIC_SUBCLASS_NOT_BASIC> a skos:Concept ;
